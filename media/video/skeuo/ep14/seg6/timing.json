 "captions": [
  {
   "text": "具体到每个角色",
   "start": 1.55,
   "end": 3.072,
   "id": "c0"
  },
  {
   "text": "今天就能做的一件事",
   "start": 3.231,
   "end": 4.623,
   "id": "c1"
  },
  {
   "text": "写电路的人",
   "start": 4.89,
   "end": 6.06,
   "id": "c2"
  },
  {
   "text": "给每条约束",
   "start": 6.159,
   "end": 6.807,
   "id": "c3"
  },
  {
   "text": "写一个恶意输入的测试",
   "start": 6.827,
   "end": 8.934,
   "id": "c4"
  },
  {
   "text": "写结算合约的人",
   "start": 9.19,
   "end": 10.792,
   "id": "c5"
  },
  {
   "text": "列出证明里的每个公开输入",
   "start": 10.899,
   "end": 13.173,
   "id": "c6"
  },
  {
   "text": "看有没有字段只被读取",
   "start": 13.425,
   "end": 15.681,
   "id": "c7"
  },
  {
   "text": "没有被证明",
   "start": 15.711,
   "end": 16.624,
   "id": "c8"
  },
  {
   "text": "运营 L2 或桥的人",
   "start": 16.85,
   "end": 17.869,
   "id": "c9"
  },
  {
   "text": "验证器和电路的升级要走时间锁",
   "start": 18.055,
   "end": 21.945,
   "id": "c10"
  },
  {
   "text": "紧急权限要公开",
   "start": 22.053,
   "end": 23.408,
   "id": "c11"
  },
  {
   "text": "普通用户",
   "start": 23.71,
   "end": 24.572,
   "id": "c12"
  },
  {
   "text": "在 L2 上放大额资产前",
   "start": 24.865,
   "end": 27.253,
   "id": "c13"
  },
  {
   "text": "先在 L2BEAT 上查它的 Stage",
   "start": 27.444,
   "end": 30.198,
   "id": "c14"
  },
  {
   "text": "协议宣布弃用",
   "start": 30.218,
   "end": 31.108,
   "id": "c15"
  },
  {
   "text": "及时取回资产",
   "start": 31.307,
   "end": 32.746,
   "id": "c16"
  },
  {
   "text": "使用隐私或 ZK 协议前",
   "start": 32.97,
   "end": 35.224,
   "id": "c17"
  },
  {
   "text": "确认它有公开的电路审计和赏金计划",
   "start": 35.284,
   "end": 38.625,
   "id": "c18"
  },
  {
   "text": "回到开头的问题",
   "start": 38.87,
   "end": 40.232,
   "id": "c19"
  },
  {
   "text": "只修验证器合约",
   "start": 40.598,
   "end": 42.186,
   "id": "c20"
  },
  {
   "text": "能堵住这个洞吗",
   "start": 42.38,
   "end": 43.552,
   "id": "c21"
  },
  {
   "text": "不能",
   "start": 44.191,
   "end": 44.708,
   "id": "c22"
  },
  {
   "text": "验证器确认的",
   "start": 44.939,
   "end": 46.331,
   "id": "c23"
  },
  {
   "text": "是证明对这些公开输入成立",
   "start": 46.39,
   "end": 48.63,
   "id": "c24"
  },
  {
   "text": "漏洞在业务合约",
   "start": 48.87,
   "end": 50.389,
   "id": "c25"
  },
  {
   "text": "结算几笔交易的边界",
   "start": 50.82,
   "end": 52.367,
   "id": "c26"
  },
  {
   "text": "没有和证明绑定",
   "start": 52.415,
   "end": 53.698,
   "id": "c27"
  },
  {
   "text": "这个答案的前提 是电路",
   "start": 53.97,
   "end": 56.1,
   "id": "c28"
  },
  {
   "text": "设置和验证器都没有出错",
   "start": 56.245,
   "end": 58.751,
   "id": "c29"
  },
  {
   "text": "任何一环出错",
   "start": 59.247,
   "end": 60.475,
   "id": "c30"
  },
  {
   "text": "有效的证明也会说谎",
   "start": 60.682,
   "end": 62.566,
   "id": "c31"
  },
  {
   "text": "证明对了",
   "start": 62.928,
   "end": 63.884,
   "id": "c32"
  },
  {
   "text": "不等于电路对了",
   "start": 64.097,
   "end": 65.557,
   "id": "c33"
  },
  {
   "text": "也不等于钱算对了",
   "start": 65.79,
   "end": 67.903,
   "id": "c34"
  },
  {
   "text": "下一集讲账户抽象与新钱包的安全",
   "start": 68.17,
   "end": 71.993,
   "id": "c35"
  }
 ]
}