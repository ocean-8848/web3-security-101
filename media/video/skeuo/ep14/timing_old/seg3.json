 "captions": [
  {
   "text": "电路最常见的漏洞",
   "start": 1.644,
   "end": 3.216,
   "id": "c0"
  },
  {
   "text": "叫约束不足",
   "start": 3.312,
   "end": 4.603,
   "id": "c1"
  },
  {
   "text": "某个值被算出来了",
   "start": 4.99,
   "end": 6.481,
   "id": "c2"
  },
  {
   "text": "却没有被约束",
   "start": 6.665,
   "end": 7.721,
   "id": "c3"
  },
  {
   "text": "在 Circom 语言里",
   "start": 7.99,
   "end": 9.547,
   "id": "c4"
  },
  {
   "text": "有一种写法只赋值 不约束",
   "start": 9.712,
   "end": 12.381,
   "id": "c5"
  },
  {
   "text": "另一种写法",
   "start": 12.606,
   "end": 13.526,
   "id": "c6"
  },
  {
   "text": "赋值的同时加上约束",
   "start": 13.7,
   "end": 15.71,
   "id": "c7"
  },
  {
   "text": "只用了前一种写法的信号",
   "start": 15.97,
   "end": 18.107,
   "id": "c8"
  },
  {
   "text": "恶意证明者可以填任何值",
   "start": 18.304,
   "end": 20.697,
   "id": "c9"
  },
  {
   "text": "看一个玩具例子",
   "start": 21.085,
   "end": 22.327,
   "id": "c10"
  },
  {
   "text": "账户余额是 20",
   "start": 22.873,
   "end": 24.5,
   "id": "c11"
  },
  {
   "text": "有人要提款 25",
   "start": 24.735,
   "end": 26.43,
   "id": "c12"
  },
  {
   "text": "电路要求",
   "start": 26.65,
   "end": 27.61,
   "id": "c13"
  },
  {
   "text": "新余额拆成 5 个二进制位",
   "start": 27.642,
   "end": 29.874,
   "id": "c14"
  },
  {
   "text": "每一位只能是 0 或 1",
   "start": 30.142,
   "end": 32.206,
   "id": "c15"
  },
  {
   "text": "只去掉最高位的这一条",
   "start": 32.47,
   "end": 34.523,
   "id": "c16"
  },
  {
   "text": "恶意证明者就把最高位填成 30",
   "start": 35.053,
   "end": 37.984,
   "id": "c17"
  },
  {
   "text": "电路里的数",
   "start": 38.303,
   "end": 39.271,
   "id": "c18"
  },
  {
   "text": "算到一个上限就绕回去",
   "start": 39.317,
   "end": 41.379,
   "id": "c19"
  },
  {
   "text": "填 30 之后",
   "start": 41.523,
   "end": 42.533,
   "id": "c20"
  },
  {
   "text": "等式照样成立",
   "start": 42.647,
   "end": 44.081,
   "id": "c21"
  },
  {
   "text": "余额检查被绕过",
   "start": 44.449,
   "end": 45.85,
   "id": "c22"
  },
  {
   "text": "提款 25 通过了验证",
   "start": 45.999,
   "end": 47.907,
   "id": "c23"
  },
  {
   "text": "反过来 约束写得太严",
   "start": 48.17,
   "end": 50.401,
   "id": "c24"
  },
  {
   "text": "叫过度约束",
   "start": 50.454,
   "end": 51.682,
   "id": "c25"
  },
  {
   "text": "合法的输入也无法生成证明",
   "start": 51.91,
   "end": 54.281,
   "id": "c26"
  },
  {
   "text": "结果是拒绝服务",
   "start": 54.709,
   "end": 56.231,
   "id": "c27"
  },
  {
   "text": "资金可能被锁住",
   "start": 56.657,
   "end": 58.09,
   "id": "c28"
  },
  {
   "text": "真实的例子在 2019 年",
   "start": 58.471,
   "end": 60.783,
   "id": "c29"
  },
  {
   "text": "按 Trail of Bits 的介绍",
   "start": 61.165,
   "end": 62.877,
   "id": "c30"
  },
  {
   "text": "Tornado Cash 用的一个哈希实现里",
   "start": 63.199,
   "end": 66.046,
   "id": "c31"
  },
  {
   "text": "有一个输出只被赋值",
   "start": 66.219,
   "end": 68.06,
   "id": "c32"
  },
  {
   "text": "没有被约束",
   "start": 68.211,
   "end": 69.1,
   "id": "c33"
  },
  {
   "text": "攻击者本可以伪造 Merkle 根",
   "start": 69.37,
   "end": 71.798,
   "id": "c34"
  },
  {
   "text": "取走别人的资金",
   "start": 71.853,
   "end": 73.192,
   "id": "c35"
  },
  {
   "text": "团队发现后",
   "start": 73.532,
   "end": 74.363,
   "id": "c36"
  },
  {
   "text": "抢先利用这个漏洞",
   "start": 74.502,
   "end": 75.851,
   "id": "c37"
  },
  {
   "text": "把资金转走保护起来 再修复",
   "start": 76.032,
   "end": 78.232,
   "id": "c38"
  },
  {
   "text": "没有资金被盗",
   "start": 78.624,
   "end": 79.663,
   "id": "c39"
  },
  {
   "text": "同类问题很多",
   "start": 80.045,
   "end": 81.256,
   "id": "c40"
  },
  {
   "text": "0xPARC 维护的公开漏洞清单里",
   "start": 81.656,
   "end": 84.692,
   "id": "c41"
  },
  {
   "text": "收录了大量这样的例子",
   "start": 84.779,
   "end": 86.459,
   "id": "c42"
  },
  {
   "text": "防御有三条",
   "start": 86.73,
   "end": 88.015,
   "id": "c43"
  },
  {
   "text": "用静态分析工具",
   "start": 88.31,
   "end": 89.834,
   "id": "c44"
  },
  {
   "text": "找出没有约束的信号",
   "start": 90.043,
   "end": 91.757,
   "id": "c45"
  },
  {
   "text": "关键电路",
   "start": 92.065,
   "end": 92.949,
   "id": "c46"
  },
  {
   "text": "做形式化验证",
   "start": 93.082,
   "end": 94.4,
   "id": "c47"
  },
  {
   "text": "每条约束写正反两种测试",
   "start": 94.765,
   "end": 97.241,
   "id": "c48"
  },
  {
   "text": "恶意的输入也要测",
   "start": 97.783,
   "end": 99.318,
   "id": "c49"
  }
 ]
}