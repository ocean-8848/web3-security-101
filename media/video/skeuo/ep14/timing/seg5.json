 "captions": [
  {
   "text": "回到开头的 Aztec Connect",
   "start": 1.648,
   "end": 3.782,
   "id": "c0"
  },
  {
   "text": "它已经弃用",
   "start": 4.772,
   "end": 5.727,
   "id": "c1"
  },
  {
   "text": "管理员密钥已经放弃",
   "start": 5.914,
   "end": 7.525,
   "id": "c2"
  },
  {
   "text": "合约里却仍然有钱",
   "start": 7.748,
   "end": 9.418,
   "id": "c3"
  },
  {
   "text": "证明按 32 笔交易一组校验",
   "start": 10.416,
   "end": 13.062,
   "id": "c4"
  },
  {
   "text": "L1 上的结算",
   "start": 14.044,
   "end": 15.249,
   "id": "c5"
  },
  {
   "text": "只处理到一个字段写的笔数",
   "start": 15.282,
   "end": 17.083,
   "id": "c6"
  },
  {
   "text": "这个字段",
   "start": 18.08,
   "end": 19.011,
   "id": "c7"
  },
  {
   "text": "没有和证明绑定",
   "start": 19.175,
   "end": 20.512,
   "id": "c8"
  },
  {
   "text": "由攻击者填写",
   "start": 20.58,
   "end": 21.869,
   "id": "c9"
  },
  {
   "text": "攻击者把它设成 1",
   "start": 22.86,
   "end": 24.577,
   "id": "c10"
  },
  {
   "text": "伪造的存款不被记账",
   "start": 24.941,
   "end": 26.765,
   "id": "c11"
  },
  {
   "text": "证明仍然有效",
   "start": 26.845,
   "end": 28.134,
   "id": "c12"
  },
  {
   "text": "按 rekt.news",
   "start": 29.128,
   "end": 30.31,
   "id": "c13"
  },
  {
   "text": "SlowMist 和 Halborn 的分析",
   "start": 30.33,
   "end": 32.44,
   "id": "c14"
  },
  {
   "text": "第一名攻击者取走约 219 万美元",
   "start": 32.675,
   "end": 35.512,
   "id": "c15"
  },
  {
   "text": "第二名又取走约 8.8 万美元",
   "start": 35.616,
   "end": 38.131,
   "id": "c16"
  },
  {
   "text": "安全研究者的结论是",
   "start": 39.116,
   "end": 40.738,
   "id": "c17"
  },
  {
   "text": "问题在证明和结算之间的绑定",
   "start": 40.961,
   "end": 43.25,
   "id": "c18"
  },
  {
   "text": "所以结算要用证明里的全部公开输入",
   "start": 44.232,
   "end": 47.104,
   "id": "c19"
  },
  {
   "text": "数量 索引 长度",
   "start": 47.479,
   "end": 49.828,
   "id": "c20"
  },
  {
   "text": "也必须被证明覆盖",
   "start": 49.848,
   "end": 51.28,
   "id": "c21"
  },
  {
   "text": "已经弃用的合约",
   "start": 52.276,
   "end": 53.588,
   "id": "c22"
  },
  {
   "text": "要么彻底停用",
   "start": 53.728,
   "end": 54.934,
   "id": "c23"
  },
  {
   "text": "要么继续放在监控和赏金范围里",
   "start": 55.073,
   "end": 57.815,
   "id": "c24"
  },
  {
   "text": "同样的问题",
   "start": 58.784,
   "end": 59.764,
   "id": "c25"
  },
  {
   "text": "放大到整条 L2",
   "start": 59.784,
   "end": 61.43,
   "id": "c26"
  },
  {
   "text": "欺诈证明的 Rollup",
   "start": 62.412,
   "end": 64.189,
   "id": "c27"
  },
  {
   "text": "假设挑战期里至少有一个诚实的挑战者",
   "start": 64.388,
   "end": 67.367,
   "id": "c28"
  },
  {
   "text": "提款要等几天",
   "start": 67.435,
   "end": 68.629,
   "id": "c29"
  },
  {
   "text": "有效性证明的 Rollup",
   "start": 69.616,
   "end": 71.428,
   "id": "c30"
  },
  {
   "text": "假设证明系统可靠",
   "start": 71.592,
   "end": 73.226,
   "id": "c31"
  },
  {
   "text": "电路正确",
   "start": 73.33,
   "end": 74.309,
   "id": "c32"
  },
  {
   "text": "提款通常几小时",
   "start": 74.366,
   "end": 75.952,
   "id": "c33"
  },
  {
   "text": "两种证明系统",
   "start": 76.94,
   "end": 78.217,
   "id": "c34"
  },
  {
   "text": "都能被运营方切换或暂停",
   "start": 78.309,
   "end": 80.633,
   "id": "c35"
  },
  {
   "text": "链也能回滚",
   "start": 80.666,
   "end": 81.705,
   "id": "c36"
  },
  {
   "text": "2024 年 8 月",
   "start": 82.704,
   "end": 83.945,
   "id": "c37"
  },
  {
   "text": "OP Mainnet 的故障证明在审计中发现漏洞",
   "start": 84.132,
   "end": 87.624,
   "id": "c38"
  },
  {
   "text": "守护者把它切回许可模式",
   "start": 87.739,
   "end": 89.897,
   "id": "c39"
  },
  {
   "text": "2025 年 9 月",
   "start": 90.892,
   "end": 92.157,
   "id": "c40"
  },
  {
   "text": "Starknet 的证明层发现状态不一致",
   "start": 92.177,
   "end": 94.966,
   "id": "c41"
  },
  {
   "text": "拒绝出证明",
   "start": 95.094,
   "end": 96.205,
   "id": "c42"
  },
  {
   "text": "链回滚约 1.5 小时",
   "start": 96.225,
   "end": 98.121,
   "id": "c43"
  },
  {
   "text": "L2BEAT 的 Stages 框架",
   "start": 99.104,
   "end": 101.0,
   "id": "c44"
  },
  {
   "text": "按去掉运营方之后剩下多少保障",
   "start": 101.235,
   "end": 103.893,
   "id": "c45"
  },
  {
   "text": "给 L2 分级",
   "start": 103.913,
   "end": 105.047,
   "id": "c46"
  },
  {
   "text": "Stage 越低",
   "start": 106.044,
   "end": 107.059,
   "id": "c47"
  },
  {
   "text": "安全越依赖运营方和多签",
   "start": 107.246,
   "end": 109.464,
   "id": "c48"
  }
 ]
}