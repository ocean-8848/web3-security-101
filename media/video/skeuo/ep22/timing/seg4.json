 ],
 "captions": [
  {
   "text": "再看另一条路 找上门",
   "start": 1.648,
   "end": 3.734,
   "id": "c0"
  },
  {
   "text": "这部分涉及人身伤害",
   "start": 4.724,
   "end": 6.656,
   "id": "c1"
  },
  {
   "text": "我们只讲公开报道的事实",
   "start": 6.89,
   "end": 8.786,
   "id": "c2"
  },
  {
   "text": "不讲受害人的个人细节",
   "start": 8.843,
   "end": 10.632,
   "id": "c3"
  },
  {
   "text": "研究者 Jameson Lopp",
   "start": 11.616,
   "end": 13.405,
   "id": "c4"
  },
  {
   "text": "在 GitHub 上维护一份公开清单",
   "start": 13.425,
   "end": 16.036,
   "id": "c5"
  },
  {
   "text": "专门记录针对持币人的实体攻击",
   "start": 17.02,
   "end": 19.773,
   "id": "c6"
  },
  {
   "text": "按这份清单",
   "start": 20.768,
   "end": 21.866,
   "id": "c7"
  },
  {
   "text": "2023 年 74 起",
   "start": 22.077,
   "end": 23.807,
   "id": "c8"
  },
  {
   "text": "2024 年 106 起",
   "start": 23.97,
   "end": 25.866,
   "id": "c9"
  },
  {
   "text": "2025 年 170 起",
   "start": 26.053,
   "end": 27.819,
   "id": "c10"
  },
  {
   "text": "2026 年截至 10 月底",
   "start": 28.788,
   "end": 30.648,
   "id": "c11"
  },
  {
   "text": "已有 147 起",
   "start": 30.704,
   "end": 32.112,
   "id": "c12"
  },
  {
   "text": "其中法国 52 起",
   "start": 32.216,
   "end": 34.089,
   "id": "c13"
  },
  {
   "text": "各机构的统计口径不同",
   "start": 35.056,
   "end": 36.928,
   "id": "c14"
  },
  {
   "text": "数字不能直接比较",
   "start": 37.091,
   "end": 38.749,
   "id": "c15"
  },
  {
   "text": "Lopp 本人认为",
   "start": 39.74,
   "end": 40.993,
   "id": "c16"
  },
  {
   "text": "真实数量被低估了",
   "start": 41.132,
   "end": 42.648,
   "id": "c17"
  },
  {
   "text": "2025 年 1 月",
   "start": 43.608,
   "end": 44.825,
   "id": "c18"
  },
  {
   "text": "Ledger 的一位联合创始人",
   "start": 44.941,
   "end": 47.04,
   "id": "c19"
  },
  {
   "text": "和伴侣在家中被劫持",
   "start": 47.06,
   "end": 48.837,
   "id": "c20"
  },
  {
   "text": "绑匪向 Ledger 方面索要加密货币赎金",
   "start": 49.804,
   "end": 52.95,
   "id": "c21"
  },
  {
   "text": "法国宪兵特种部队救出了两人",
   "start": 53.042,
   "end": 55.605,
   "id": "c22"
  },
  {
   "text": "涉嫌主谋 6 月在摩洛哥落网",
   "start": 56.576,
   "end": 58.817,
   "id": "c23"
  },
  {
   "text": "2026 年 5 月被当地法院判处 25 年",
   "start": 59.004,
   "end": 62.388,
   "id": "c24"
  },
  {
   "text": "同年 5 月初",
   "start": 63.372,
   "end": 64.458,
   "id": "c25"
  },
  {
   "text": "一名加密企业家的父亲",
   "start": 64.657,
   "end": 66.34,
   "id": "c26"
  },
  {
   "text": "在巴黎街头被绑走",
   "start": 66.36,
   "end": 67.875,
   "id": "c27"
  },
  {
   "text": "警方突袭解救",
   "start": 68.848,
   "end": 70.244,
   "id": "c28"
  },
  {
   "text": "没有支付赎金",
   "start": 70.276,
   "end": 71.541,
   "id": "c29"
  },
  {
   "text": "5 月 13 日",
   "start": 72.524,
   "end": 73.539,
   "id": "c30"
  },
  {
   "text": "交易所 Paymium 的 CEO",
   "start": 73.631,
   "end": 75.194,
   "id": "c31"
  },
  {
   "text": "女儿和外孙在巴黎街头",
   "start": 75.214,
   "end": 77.17,
   "id": "c32"
  },
  {
   "text": "遭遇绑架未遂",
   "start": 77.19,
   "end": 78.336,
   "id": "c33"
  },
  {
   "text": "检方之后起诉了 25 人",
   "start": 79.32,
   "end": 81.561,
   "id": "c34"
  },
  {
   "text": "认为和 5 月初的绑架有关联",
   "start": 81.724,
   "end": 83.99,
   "id": "c35"
  },
  {
   "text": "法国内政部长会见业界",
   "start": 84.988,
   "end": 86.92,
   "id": "c36"
  },
  {
   "text": "宣布了安全简报",
   "start": 86.94,
   "end": 88.312,
   "id": "c37"
  },
  {
   "text": "紧急呼叫优先响应",
   "start": 88.464,
   "end": 90.17,
   "id": "c38"
  },
  {
   "text": "住宅安防检查等措施",
   "start": 90.226,
   "end": 92.027,
   "id": "c39"
  },
  {
   "text": "这几起案件里",
   "start": 93.008,
   "end": 94.273,
   "id": "c40"
  },
  {
   "text": "目标不只是持币人本人",
   "start": 94.389,
   "end": 96.225,
   "id": "c41"
  },
  {
   "text": "还有家属",
   "start": 96.436,
   "end": 97.32,
   "id": "c42"
  },
  {
   "text": "公开报道还显示",
   "start": 98.316,
   "end": 99.712,
   "id": "c43"
  },
  {
   "text": "部分团伙把执行环节",
   "start": 99.97,
   "end": 101.843,
   "id": "c44"
  },
  {
   "text": "外包给临时招募的人",
   "start": 101.982,
   "end": 103.486,
   "id": "c45"
  },
  {
   "text": "同在 2025 年 5 月",
   "start": 104.464,
   "end": 106.05,
   "id": "c46"
  },
  {
   "text": "纽约检方指控两名加密投资者",
   "start": 106.142,
   "end": 108.598,
   "id": "c47"
  },
  {
   "text": "把一名男子诱到曼哈顿的一处住宅",
   "start": 108.785,
   "end": 111.348,
   "id": "c48"
  },
  {
   "text": "囚禁 17 天",
   "start": 112.34,
   "end": 113.51,
   "id": "c49"
  },
  {
   "text": "逼他交出比特币密码",
   "start": 113.625,
   "end": 115.224,
   "id": "c50"
  },
  {
   "text": "两名被告不认罪",
   "start": 116.208,
   "end": 117.616,
   "id": "c51"
  },
  {
   "text": "公开报道里",
   "start": 117.815,
   "end": 118.806,
   "id": "c52"
  },
  {
   "text": "还没有查到判决",
   "start": 118.874,
   "end": 120.151,
   "id": "c53"
  },
  {
   "text": "施暴者 也可能是熟人",
   "start": 121.132,
   "end": 123.278,
   "id": "c54"
  },
  {
   "text": "或者同一个圈子里的人",
   "start": 123.417,
   "end": 124.825,
   "id": "c55"
  }
 ]
}