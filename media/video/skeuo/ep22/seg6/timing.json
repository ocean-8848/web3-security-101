 "captions": [
  {
   "text": "普通用户",
   "start": 1.55,
   "end": 2.593,
   "id": "c0"
  },
  {
   "text": "可以从这几件事做起",
   "start": 2.809,
   "end": 4.647,
   "id": "c1"
  },
  {
   "text": "交易所和邮箱",
   "start": 4.89,
   "end": 6.309,
   "id": "c2"
  },
  {
   "text": "用硬件密钥或验证器 App",
   "start": 6.531,
   "end": 8.888,
   "id": "c3"
  },
  {
   "text": "关掉短信验证",
   "start": 9.054,
   "end": 10.253,
   "id": "c4"
  },
  {
   "text": "向运营商申请号码转移锁",
   "start": 10.47,
   "end": 13.207,
   "id": "c5"
  },
  {
   "text": "关注的项目方账号",
   "start": 13.49,
   "end": 14.91,
   "id": "c6"
  },
  {
   "text": "突然发限时空投",
   "start": 14.987,
   "end": 16.416,
   "id": "c7"
  },
  {
   "text": "紧急迁移",
   "start": 16.436,
   "end": 17.349,
   "id": "c8"
  },
  {
   "text": "先去别的官方渠道核实",
   "start": 17.479,
   "end": 19.03,
   "id": "c9"
  },
  {
   "text": "和陌生网友线下见面",
   "start": 19.31,
   "end": 21.103,
   "id": "c10"
  },
  {
   "text": "选公共场所",
   "start": 21.232,
   "end": 22.504,
   "id": "c11"
  },
  {
   "text": "让别人知道你的行程",
   "start": 22.679,
   "end": 24.303,
   "id": "c12"
  },
  {
   "text": "遭遇胁迫时",
   "start": 24.57,
   "end": 25.749,
   "id": "c13"
  },
  {
   "text": "人身安全第一",
   "start": 25.98,
   "end": 27.269,
   "id": "c14"
  },
  {
   "text": "事后立即报警",
   "start": 27.453,
   "end": 28.772,
   "id": "c15"
  },
  {
   "text": "如果你是多签签名人",
   "start": 29.126,
   "end": 30.897,
   "id": "c16"
  },
  {
   "text": "今天就查一遍",
   "start": 31.108,
   "end": 32.264,
   "id": "c17"
  },
  {
   "text": "你的手机号能不能单独重置哪个账号",
   "start": 32.57,
   "end": 35.434,
   "id": "c18"
  },
  {
   "text": "如果你管理官方账号",
   "start": 35.824,
   "end": 37.455,
   "id": "c19"
  },
  {
   "text": "今天就把它的多因素认证",
   "start": 37.589,
   "end": 39.534,
   "id": "c20"
  },
  {
   "text": "换成硬件密钥",
   "start": 39.566,
   "end": 40.698,
   "id": "c21"
  },
  {
   "text": "如果你负责团队",
   "start": 41.085,
   "end": 42.416,
   "id": "c22"
  },
  {
   "text": "列一份关键人员名单",
   "start": 42.584,
   "end": 44.342,
   "id": "c23"
  },
  {
   "text": "给每个人配上号码锁和硬件密钥",
   "start": 44.522,
   "end": 47.351,
   "id": "c24"
  },
  {
   "text": "回到开头的题",
   "start": 47.61,
   "end": 48.882,
   "id": "c25"
  },
  {
   "text": "答案是没有",
   "start": 49.11,
   "end": 50.455,
   "id": "c26"
  },
  {
   "text": "SEC 承认",
   "start": 50.869,
   "end": 51.733,
   "id": "c27"
  },
  {
   "text": "此前曾请 X 关闭这个账号的多因素认证",
   "start": 51.937,
   "end": 55.621,
   "id": "c28"
  },
  {
   "text": "攻击者对绑定的手机号做了 SIM 卡劫持",
   "start": 55.89,
   "end": 59.819,
   "id": "c29"
  },
  {
   "text": "再用重置码登录",
   "start": 59.928,
   "end": 61.175,
   "id": "c30"
  },
  {
   "text": "负责换卡的人",
   "start": 61.47,
   "end": 62.895,
   "id": "c31"
  },
  {
   "text": "2025 年被判 14 个月",
   "start": 63.105,
   "end": 65.394,
   "id": "c32"
  },
  {
   "text": "监管机构的账号也会失守",
   "start": 65.69,
   "end": 67.979,
   "id": "c33"
  },
  {
   "text": "只要一条短信",
   "start": 68.161,
   "end": 69.409,
   "id": "c34"
  },
  {
   "text": "就能单独完成恢复",
   "start": 69.509,
   "end": 71.049,
   "id": "c35"
  },
  {
   "text": "攻击从链上走到线下",
   "start": 71.369,
   "end": 73.495,
   "id": "c36"
  },
  {
   "text": "防线就要让一张卡",
   "start": 73.792,
   "end": 75.854,
   "id": "c37"
  },
  {
   "text": "一次胁迫",
   "start": 76.025,
   "end": 77.006,
   "id": "c38"
  },
  {
   "text": "都不够拿走一切",
   "start": 77.108,
   "end": 78.763,
   "id": "c39"
  },
  {
   "text": "下一集讲托管",
   "start": 79.01,
   "end": 80.83,
   "id": "c40"
  },
  {
   "text": "充提与合规安全",
