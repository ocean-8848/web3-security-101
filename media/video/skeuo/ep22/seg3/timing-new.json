 "captions": [
  {
   "text": "先看账号这条路",
   "start": 1.648,
   "end": 3.127,
   "id": "c0"
  },
  {
   "text": "SIM 卡劫持",
   "start": 3.171,
   "end": 4.425,
   "id": "c1"
  },
  {
   "text": "攻击者让运营商",
   "start": 5.42,
   "end": 6.935,
   "id": "c2"
  },
  {
   "text": "把受害者的手机号",
   "start": 6.991,
   "end": 8.292,
   "id": "c3"
  },
  {
   "text": "转到自己的 SIM 卡上",
   "start": 8.312,
   "end": 9.923,
   "id": "c4"
  },
  {
   "text": "常见的手法",
   "start": 10.896,
   "end": 12.054,
   "id": "c5"
  },
  {
   "text": "是出示伪造证件",
   "start": 12.074,
   "end": 13.661,
   "id": "c6"
  },
  {
   "text": "或者贿赂",
   "start": 13.741,
   "end": 14.637,
   "id": "c7"
  },
  {
   "text": "欺骗客服",
   "start": 14.681,
   "end": 15.78,
   "id": "c8"
  },
  {
   "text": "号码到手",
   "start": 16.756,
   "end": 17.711,
   "id": "c9"
  },
  {
   "text": "他在交易所 邮箱",
   "start": 17.815,
   "end": 19.568,
   "id": "c10"
  },
  {
   "text": "社交账号上",
   "start": 19.708,
   "end": 20.938,
   "id": "c11"
  },
  {
   "text": "点忘记密码",
   "start": 20.958,
   "end": 21.985,
   "id": "c12"
  },
  {
   "text": "短信验证码",
   "start": 22.976,
   "end": 24.17,
   "id": "c13"
  },
  {
   "text": "发到了他的新卡上",
   "start": 24.19,
   "end": 25.574,
   "id": "c14"
  },
  {
   "text": "这一步能成功",
   "start": 26.556,
   "end": 27.714,
   "id": "c15"
  },
  {
   "text": "是因为账号允许短信验证码",
   "start": 27.734,
   "end": 29.987,
   "id": "c16"
  },
  {
   "text": "作为唯一的恢复方式",
   "start": 30.091,
   "end": 31.678,
   "id": "c17"
  },
  {
   "text": "再想一种情况",
   "start": 32.656,
   "end": 33.826,
   "id": "c18"
  },
  {
   "text": "账号开了验证器 App",
   "start": 33.906,
   "end": 35.647,
   "id": "c19"
  },
  {
   "text": "但忘记密码时",
   "start": 35.846,
   "end": 37.005,
   "id": "c20"
  },
  {
   "text": "仍然可以用短信",
   "start": 37.025,
   "end": 38.242,
   "id": "c21"
  },
  {
   "text": "只要短信能单独完成恢复",
   "start": 39.236,
   "end": 41.358,
   "id": "c22"
  },
  {
   "text": "验证器就被绕过了",
   "start": 41.533,
   "end": 42.989,
   "id": "c23"
  },
  {
   "text": "第二因素有多强",
   "start": 43.968,
   "end": 45.423,
   "id": "c24"
  },
  {
   "text": "取决于恢复流程里最弱的一环",
   "start": 45.503,
   "end": 47.769,
   "id": "c25"
  },
  {
   "text": "社交账号被劫持",
   "start": 48.748,
   "end": 50.56,
   "id": "c26"
  },
  {
   "text": "入口不止换卡",
   "start": 50.652,
   "end": 52.049,
   "id": "c27"
  },
  {
   "text": "还有弱密码被暴力破解",
   "start": 53.048,
   "end": 54.944,
   "id": "c28"
  },
  {
