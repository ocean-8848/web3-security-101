 "captions": [
  {
   "text": "先看链路最外面的一环 域名",
   "start": 1.648,
   "end": 4.413,
   "id": "c0"
  },
  {
   "text": "浏览器先问 DNS",
   "start": 5.396,
   "end": 7.304,
   "id": "c1"
  },
  {
   "text": "这个域名指向哪台服务器",
   "start": 7.36,
   "end": 9.268,
   "id": "c2"
  },
  {
   "text": "攻击者控制域名注册商的账号",
   "start": 10.248,
   "end": 12.572,
   "id": "c3"
  },
  {
   "text": "或者攻破注册商本身",
   "start": 12.652,
   "end": 14.465,
   "id": "c4"
  },
  {
   "text": "再把解析记录",
   "start": 15.46,
   "end": 16.713,
   "id": "c5"
  },
  {
   "text": "指向自己的服务器",
   "start": 16.733,
   "end": 18.082,
   "id": "c6"
  },
  {
   "text": "你访问正确的域名",
   "start": 19.064,
   "end": 20.626,
   "id": "c7"
  },
  {
   "text": "打开的却是克隆页面",
   "start": 20.683,
   "end": 22.531,
   "id": "c8"
  },
  {
   "text": "回到开头的题",
   "start": 23.532,
   "end": 24.809,
   "id": "c9"
  },
  {
   "text": "不能证明",
   "start": 24.877,
   "end": 25.821,
   "id": "c10"
  },
  {
   "text": "控制了解析的人",
   "start": 26.8,
   "end": 28.161,
   "id": "c11"
  },
  {
   "text": "可以用常见的域名验证方式",
   "start": 28.181,
   "end": 30.303,
   "id": "c12"
  },
  {
   "text": "申请到有效证书",
   "start": 30.323,
   "end": 31.958,
   "id": "c13"
  },
  {
   "text": "锁标志只说明",
   "start": 32.948,
   "end": 34.344,
   "id": "c14"
  },
  {
   "text": "浏览器连上了域名此刻指向的服务器",
