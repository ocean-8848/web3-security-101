  {
   "id": "seg3-00",
   "text": "先看链路最外面的一环，域名。",
   "spoken": "先看链路最外面的一环，域名。",
   "src": "/Users/k/Workon/Learning/web3/web3-security-101/media/video/skeuo/ep20/audio/lines/seg3-00.mp3",
   "start": 1.6,
