   "start": 44.033,
   "end": 46.262,
   "id": "c19"
  },
  {
   "text": "又一次把 Curve 的域名委派",
   "start": 47.264,
   "end": 49.16,
   "id": "c20"
  },
  {
   "text": "改到自己的服务器",
   "start": 49.18,
   "end": 50.338,
   "id": "c21"
  },
  {
   "text": "Curve 把用户引导到新域名",
   "start": 51.324,
   "end": 53.541,
   "id": "c22"
  },
  {
   "text": "并公开批评注册商响应迟缓",
   "start": 53.609,
   "end": 55.779,
   "id": "c23"
  },
  {
   "text": "同一家注册商出两次事",
   "start": 56.776,
   "end": 58.588,
   "id": "c24"
  },
  {
   "text": "说明换个强密码不够",
   "start": 58.728,
   "end": 60.243,
   "id": "c25"
  },
  {
   "text": "注册商本身就是风险",
   "start": 60.478,
   "end": 62.053,
   "id": "c26"
  },
  {
   "text": "2024 年 7 月",
   "start": 63.02,
   "end": 64.297,
   "id": "c27"
  },
  {
   "text": "Google Domains 的域名业务",
   "start": 64.448,
   "end": 66.142,
   "id": "c28"
  },
  {
   "text": "迁到 Squarespace",
   "start": 66.162,
   "end": 67.773,
   "id": "c29"
  },
  {
   "text": "之后",
   "start": 68.76,
   "end": 69.418,
   "id": "c30"
  },
  {
   "text": "Compound 等多个 DeFi",
   "start": 69.688,
   "end": 71.061,
   "id": "c31"
  },
  {
   "text": "项目的域名被劫持",
   "start": 71.081,
   "end": 72.68,
   "id": "c32"
  },
  {
   "text": "指向盗币页面",
   "start": 72.7,
   "end": 73.87,
   "id": "c33"
  },
  {
   "text": "研究者认为",
   "start": 74.86,
   "end": 75.899,
   "id": "c34"
  },
  {
   "text": "这和迁移期间多因素认证失效有关",
   "start": 76.086,
   "end": 79.065,
   "id": "c35"
  },
  {
   "text": "官方没有公布根因",
   "start": 79.217,
   "end": 80.637,
   "id": "c36"
  },
  {
   "text": "Celer 靠域名监控",
   "start": 81.632,
   "end": 83.421,
   "id": "c37"
  },
  {
   "text": "拦下了劫持尝试",
   "start": 83.477,
   "end": 84.802,
   "id": "c38"
  },
  {
   "text": "所以域名这一环",
   "start": 85.788,
   "end": 87.589,
   "id": "c39"
  },
  {
   "text": "要开注册商锁和注册局锁",
   "start": 87.657,
   "end": 90.136,
   "id": "c40"
  },
  {
   "text": "注册商账号用硬件密钥登录",
   "start": 91.12,
   "end": 93.659,
   "id": "c41"
  },
  {
   "text": "只给少数人权限",
   "start": 93.715,
   "end": 95.063,
   "id": "c42"
  },
  {
   "text": "开启 DNSSEC",
   "start": 96.044,
   "end": 97.559,
   "id": "c43"
  },
  {
   "text": "监控解析记录",
   "start": 97.663,
   "end": 98.892,
   "id": "c44"
  },
  {
   "text": "委派和证书的变化",
   "start": 98.972,
   "end": 100.797,
   "id": "c45"
  },
  {
   "text": "换服务商的当天",
   "start": 101.784,
   "end": 103.168,
   "id": "c46"
  },
  {
   "text": "重新核查账号和多因素认证",
   "start": 103.248,
   "end": 105.692,
   "id": "c47"
  },
  {
   "text": "再提前公布一个备用域名",
   "start": 106.684,
   "end": 108.616,
   "id": "c48"
  }
