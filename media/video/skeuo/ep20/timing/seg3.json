   "start": 85.74,
   "dur": 5.112,
   "speechStart": 85.838,
   "speechEnd": 90.016
  },
  {
   "id": "seg3-18",
   "text": "注册商账号用硬件密钥登录，只给少数人权限。",
   "spoken": "注册商账号用硬件密钥登录，只给少数人权限。",
