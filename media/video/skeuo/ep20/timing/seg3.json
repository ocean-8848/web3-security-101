   "speechStart": 1.698,
   "speechEnd": 4.293
  },
  {
   "id": "seg3-01",
   "text": "浏览器先问 DNS，这个域名指向哪台服务器。",
   "spoken": "浏览器先问 DNS，这个域名指向哪台服务器。",
   "src": "/Users/k/Workon/Learning/web3/web3-security-101/media/video/skeuo/ep20/audio/lines/seg3-01.mp3",
   "start": 5.348,
   "dur": 4.632,
   "speechStart": 5.446,
   "speechEnd": 9.148
  },
  {
   "id": "seg3-02",
   "text": "攻击者控制域名注册商的账号，或者攻破注册商本身。",
   "spoken": "攻击者控制域名注册商的账号，或者攻破注册商本身。",
   "src": "/Users/k/Workon/Learning/web3/web3-security-101/media/video/skeuo/ep20/audio/lines/seg3-02.mp3",
   "start": 10.2,
   "dur": 4.992,
   "speechStart": 10.298,
   "speechEnd": 14.345
  },
  {
   "id": "seg3-03",
   "text": "再把解析记录，指向自己的服务器。",
   "spoken": "再把解析记录，指向自己的服务器。",
   "src": "/Users/k/Workon/Learning/web3/web3-security-101/media/video/skeuo/ep20/audio/lines/seg3-03.mp3",
   "start": 15.412,
   "dur": 3.384,
   "speechStart": 15.51,
   "speechEnd": 17.962
  },
  {
   "id": "seg3-04",
   "text": "你访问正确的域名，打开的却是克隆页面。",
   "spoken": "你访问正确的域名，打开的却是克隆页面。",
   "src": "/Users/k/Workon/Learning/web3/web3-security-101/media/video/skeuo/ep20/audio/lines/seg3-04.mp3",
   "start": 19.016,
   "dur": 4.248,
   "speechStart": 19.114,
   "speechEnd": 22.411
  },
  {
   "id": "seg3-05",
   "text": "回到开头的题，不能证明。",
   "spoken": "回到开头的题，不能证明。",
   "src": "/Users/k/Workon/Learning/web3/web3-security-101/media/video/skeuo/ep20/audio/lines/seg3-05.mp3",
   "start": 23.484,
   "dur": 3.048,
   "speechStart": 23.582,
   "speechEnd": 25.701
  },
  {
   "id": "seg3-06",
   "text": "控制了解析的人，可以用常见的域名验证方式，申请到有效证书。",
   "spoken": "控制了解析的人，可以用常见的域名验证方式，申请到有效证书。",
   "src": "/Users/k/Workon/Learning/web3/web3-security-101/media/video/skeuo/ep20/audio/lines/seg3-06.mp3",
   "start": 26.752,
   "dur": 5.928,
   "speechStart": 26.85,
   "speechEnd": 31.838
  },
  {
   "id": "seg3-07",
   "text": "锁标志只说明，浏览器连上了域名此刻指向的服务器。",
   "spoken": "锁标志只说明，浏览器连上了域名此刻指向的服务器。",
   "src": "/Users/k/Workon/Learning/web3/web3-security-101/media/video/skeuo/ep20/audio/lines/seg3-07.mp3",
   "start": 32.9,
   "dur": 5.352,
   "speechStart": 32.998,
   "speechEnd": 37.402
  },
  {
   "id": "seg3-08",
   "text": "地址栏这一层的检查，在这里全部失效。",
   "spoken": "地址栏这一层的检查，在这里全部失效。",
   "src": "/Users/k/Workon/Learning/web3/web3-security-101/media/video/skeuo/ep20/audio/lines/seg3-08.mp3",
   "start": 38.472,
   "dur": 3.912,
   "speechStart": 38.57,
   "speechEnd": 41.546
  },
  {
   "id": "seg3-09",
   "text": "2025 年 5 月，攻击者进入同一家注册商的系统。",
   "spoken": "2025 年 5 月，攻击者进入同一家注册商的系统。",
   "src": "/Users/k/Workon/Learning/web3/web3-security-101/media/video/skeuo/ep20/audio/lines/seg3-09.mp3",
   "start": 42.604,
   "dur": 4.392,
   "speechStart": 42.702,
   "speechEnd": 46.142
  },
  {
   "id": "seg3-10",
   "text": "又一次把 Curve 的域名委派，改到自己的服务器。",
   "spoken": "又一次把 Curve 的域名委派，改到自己的服务器。",
   "src": "/Users/k/Workon/Learning/web3/web3-security-101/media/video/skeuo/ep20/audio/lines/seg3-10.mp3",
   "start": 47.216,
   "dur": 3.84,
   "speechStart": 47.314,
   "speechEnd": 50.218
  },
  {
   "id": "seg3-11",
   "text": "Curve 把用户引导到新域名，并公开批评注册商响应迟缓。",
   "spoken": "Curve 把用户引导到新域名，并公开批评注册商响应迟缓。",
   "src": "/Users/k/Workon/Learning/web3/web3-security-101/media/video/skeuo/ep20/audio/lines/seg3-11.mp3",
   "start": 51.276,
   "dur": 5.232,
   "speechStart": 51.374,
   "speechEnd": 55.659
  },
  {
   "id": "seg3-12",
   "text": "同一家注册商出两次事，说明换个强密码不够，注册商本身就是风险。",
   "spoken": "同一家注册商出两次事，说明换个强密码不够，注册商本身就是风险。",
   "src": "/Users/k/Workon/Learning/web3/web3-security-101/media/video/skeuo/ep20/audio/lines/seg3-12.mp3",
   "start": 56.728,
   "dur": 6.024,
   "speechStart": 56.826,
   "speechEnd": 61.933
  },
  {
   "id": "seg3-13",
   "text": "2024 年 7 月，Google Domains 的域名业务，迁到 Squarespace。",
   "spoken": "2024 年 7 月，Google Domains 的域名业务，迁到 Squarespace。",
   "src": "/Users/k/Workon/Learning/web3/web3-security-101/media/video/skeuo/ep20/audio/lines/seg3-13.mp3",
   "start": 62.972,
   "dur": 5.52,
   "speechStart": 63.07,
   "speechEnd": 67.653
  },
  {
   "id": "seg3-14",
   "text": "之后，Compound 等多个 DeFi 项目的域名被劫持，指向盗币页面。",
   "spoken": "之后，Compound 等多个 DeFi 项目的域名被劫持，指向盗币页面。",
   "src": "/Users/k/Workon/Learning/web3/web3-security-101/media/video/skeuo/ep20/audio/lines/seg3-14.mp3",
   "start": 68.712,
