 "captions": [
  {
   "text": "2022 年 8 月",
   "start": 1.652,
   "end": 3.139,
   "id": "c0"
  },
  {
   "text": "一名用户打开 Curve 的官网",
   "start": 3.357,
   "end": 5.446,
   "id": "c1"
  },
  {
   "text": "他输入的域名",
   "start": 5.69,
   "end": 6.884,
   "id": "c2"
  },
  {
   "text": "一个字母都没错",
   "start": 7.105,
   "end": 8.239,
   "id": "c3"
  },
  {
   "text": "地址栏旁边",
   "start": 8.561,
   "end": 9.563,
   "id": "c4"
  },
  {
   "text": "HTTPS 的锁标志也在",
   "start": 9.584,
   "end": 11.553,
   "id": "c5"
  },
  {
   "text": "浏览器没有任何警告",
   "start": 12.061,
   "end": 13.705,
   "id": "c6"
  },
  {
   "text": "页面请他授权",
   "start": 14.062,
   "end": 15.357,
   "id": "c7"
  },
  {
   "text": "他签了名",
   "start": 15.404,
   "end": 16.193,
   "id": "c8"
  },
  {
   "text": "签完之后",
   "start": 16.43,
   "end": 17.264,
   "id": "c9"
  },
  {
   "text": "他的代币被转走",
   "start": 17.6,
   "end": 19.067,
   "id": "c10"
  },
  {
   "text": "这一次 用户合计损失约 57 万美元",
   "start": 19.388,
   "end": 24.364,
   "id": "c11"
  },
  {
   "text": "Curve 的合约没有任何变化",
   "start": 24.63,
   "end": 26.424,
   "id": "c12"
  },
  {
   "text": "审计过的代码也没出错",
   "start": 26.554,
   "end": 28.238,
   "id": "c13"
  },
  {
   "text": "链上的一切都和昨天一样",
   "start": 28.381,
   "end": 30.091,
   "id": "c14"
  },
  {
   "text": "变的是页面",
   "start": 30.468,
   "end": 31.735,
   "id": "c15"
  },
  {
   "text": "那天 这个域名被解析到一个克隆的前端",
   "start": 31.95,
   "end": 35.618,
   "id": "c16"
  },
  {
   "text": "攻击者没碰合约",
   "start": 36.254,
   "end": 37.784,
   "id": "c17"
  },
  {
   "text": "他换掉的是页面",
   "start": 38.012,
   "end": 39.583,
   "id": "c18"
  },
  {
   "text": "先猜一道题",
   "start": 39.85,
   "end": 40.895,
   "id": "c19"
  },
  {
   "text": "域名是对的",
   "start": 41.203,
   "end": 42.188,
   "id": "c20"
  },
  {
   "text": "锁标志也在",
   "start": 42.391,
   "end": 43.574,
   "id": "c21"
  },
  {
   "text": "这能证明",
   "start": 43.855,
   "end": 44.875,
   "id": "c22"
  },
  {
   "text": "你看到的页面是真的吗",
   "start": 45.045,
   "end": 46.785,
   "id": "c23"
  },
  {
   "text": "先记住这个问题",
   "start": 47.29,
   "end": 48.451,
   "id": "c24"
  }
 ]
