 "captions": [
  {
   "text": "先看链路最外面的一环 域名",
   "start": 1.55,
   "end": 4.34,
   "id": "c0"
  },
  {
   "text": "浏览器先问 DNS",
   "start": 4.661,
   "end": 5.231,
   "id": "c1"
  },
  {
   "text": "这个域名指向哪台服务器",
   "start": 5.251,
   "end": 8.156,
   "id": "c2"
  },
  {
   "text": "攻击者控制域名注册商的账号",
   "start": 8.39,
   "end": 10.861,
   "id": "c3"
  },
  {
   "text": "或者攻破注册商本身",
   "start": 11.081,
   "end": 13.221,
   "id": "c4"
  },
  {
   "text": "再把解析记录",
   "start": 13.49,
   "end": 14.765,
   "id": "c5"
  },
  {
   "text": "指向自己的服务器",
   "start": 14.874,
   "end": 16.231,
   "id": "c6"
  },
  {
   "text": "你访问正确的域名",
   "start": 16.51,
   "end": 18.017,
   "id": "c7"
  },
  {
   "text": "打开的却是克隆页面",
   "start": 18.212,
   "end": 20.097,
   "id": "c8"
  },
  {
   "text": "回到开头的题",
   "start": 20.33,
   "end": 21.483,
   "id": "c9"
  },
  {
   "text": "不能证明",
   "start": 21.685,
   "end": 22.413,
   "id": "c10"
  },
  {
   "text": "控制了解析的人",
   "start": 22.725,
   "end": 24.125,
   "id": "c11"
  },
  {
   "text": "可以用常见的域名验证方式",
   "start": 24.376,
   "end": 26.792,
   "id": "c12"
  },
  {
   "text": "申请到有效证书",
   "start": 26.853,
   "end": 28.289,
   "id": "c13"
  },
  {
   "text": "锁标志只说明",
   "start": 28.624,
   "end": 30.315,
   "id": "c14"
  },
  {
   "text": "浏览器连上了域名此刻指向的服务器",
   "start": 30.366,
   "end": 34.001,
   "id": "c15"
  },
  {
   "text": "地址栏这一层的检查",
   "start": 34.37,
   "end": 36.071,
   "id": "c16"
  },
  {
   "text": "在这里全部失效",
   "start": 36.176,
   "end": 37.731,
   "id": "c17"
  },
  {
   "text": "2025 年 5 月",
   "start": 38.112,
   "end": 39.614,
   "id": "c18"
  },
  {
   "text": "攻击者进入同一家注册商的系统",
   "start": 39.838,
   "end": 42.914,
   "id": "c19"
  },
  {
   "text": "又一次把 Curve 的域名委派",
   "start": 43.11,
   "end": 44.941,
   "id": "c20"
  },
  {
   "text": "改到自己的服务器",
   "start": 44.961,
   "end": 46.596,
   "id": "c21"
  },
  {
   "text": "Curve 把用户引导到新域名",
   "start": 46.958,
   "end": 49.305,
   "id": "c22"
  },
  {
   "text": "并公开批评注册商响应迟缓",
   "start": 49.563,
   "end": 52.134,
   "id": "c23"
  },
  {
   "text": "同一家注册商出两次事",
   "start": 52.35,
   "end": 54.626,
   "id": "c24"
  },
  {
   "text": "说明换个强密码不够",
   "start": 54.912,
   "end": 56.71,
   "id": "c25"
  },
  {
   "text": "注册商本身就是风险",
   "start": 56.928,
   "end": 58.828,
   "id": "c26"
  },
  {
   "text": "2024 年 7 月",
   "start": 59.05,
   "end": 60.361,
   "id": "c27"
  },
  {
   "text": "Google Domains 的域名业务",
   "start": 60.434,
   "end": 61.964,
   "id": "c28"
  },
  {
   "text": "迁到 Squarespace",
   "start": 61.984,
   "end": 63.267,
   "id": "c29"
  },
  {
   "text": "之后",
   "start": 63.51,
   "end": 64.022,
   "id": "c30"
  },
  {
   "text": "Compound 等多个 DeFi",
   "start": 64.164,
   "end": 65.845,
   "id": "c31"
  },
  {
   "text": "项目的域名被劫持",
   "start": 65.865,
   "end": 67.727,
   "id": "c32"
  },
  {
   "text": "指向盗币页面",
   "start": 67.906,
   "end": 69.168,
   "id": "c33"
  },
  {
   "text": "研究者认为",
   "start": 69.506,
   "end": 70.38,
   "id": "c34"
  },
  {
   "text": "这和迁移期间多因素认证失效有关",
   "start": 70.632,
   "end": 73.574,
   "id": "c35"
  },
  {
   "text": "官方没有公布根因",
   "start": 73.703,
   "end": 75.115,
   "id": "c36"
  },
  {
   "text": "Celer 靠域名监控",
   "start": 75.39,
   "end": 76.94,
   "id": "c37"
  },
  {
   "text": "拦下了劫持尝试",
   "start": 76.96,
   "end": 78.32,
   "id": "c38"
  },
  {
   "text": "所以域名这一环",
   "start": 78.57,
   "end": 80.258,
   "id": "c39"
  },
  {
   "text": "要开注册商锁和注册局锁",
   "start": 80.338,
   "end": 83.024,
   "id": "c40"
  },
  {
   "text": "注册商账号用硬件密钥登录",
   "start": 83.19,
   "end": 85.612,
   "id": "c41"
  },
