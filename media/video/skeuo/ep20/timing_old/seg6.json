 "captions": [
  {
   "text": "如果你是普通用户",
   "start": 1.642,
   "end": 3.147,
   "id": "c0"
  },
  {
   "text": "先记住几条",
   "start": 3.232,
   "end": 4.204,
   "id": "c1"
  },
  {
   "text": "收藏官方网址",
   "start": 4.587,
   "end": 6.018,
   "id": "c2"
  },
  {
   "text": "从收藏夹进入",
   "start": 6.192,
   "end": 7.512,
   "id": "c3"
  },
  {
   "text": "不点搜索广告和私信链接",
   "start": 7.756,
   "end": 9.869,
   "id": "c4"
  },
  {
   "text": "即使域名正确",
   "start": 10.242,
   "end": 11.634,
   "id": "c5"
  },
  {
   "text": "签名前也要解码",
   "start": 11.852,
   "end": 13.384,
   "id": "c6"
  },
  {
   "text": "看清你在签什么",
   "start": 13.582,
   "end": 15.01,
   "id": "c7"
  },
  {
   "text": "项目方公告前端异常",
   "start": 15.25,
   "end": 17.2,
   "id": "c8"
  },
  {
   "text": "立刻停止交互",
   "start": 17.22,
   "end": 18.369,
   "id": "c9"
  },
  {
   "text": "撤销近期的授权",
   "start": 18.389,
   "end": 19.872,
   "id": "c10"
  },
  {
   "text": "熟悉的网站突然要你重新授权",
   "start": 20.11,
   "end": 22.896,
   "id": "c11"
  },
  {
   "text": "迁移资产",
   "start": 22.99,
   "end": 23.97,
   "id": "c12"
  },
  {
   "text": "验证钱包",
   "start": 24.065,
   "end": 24.863,
   "id": "c13"
  },
  {
   "text": "先停下来核实",
   "start": 25.058,
   "end": 26.323,
   "id": "c14"
  },
  {
   "text": "如果你负责前端",
   "start": 26.668,
   "end": 28.105,
   "id": "c15"
  },
  {
   "text": "今天就问一个问题",
   "start": 28.317,
   "end": 29.704,
   "id": "c16"
  },
  {
   "text": "今晚有人替换了一个脚本文件",
   "start": 29.99,
   "end": 32.295,
   "id": "c17"
  },
  {
   "text": "谁会在多久之后发现",
   "start": 32.487,
   "end": 34.549,
   "id": "c18"
  },
  {
   "text": "如果你是多签签名人",
   "start": 35.231,
   "end": 37.037,
   "id": "c19"
  },
  {
   "text": "确认自己有一条不经过这个前端的核对路径",
   "start": 37.161,
   "end": 40.396,
   "id": "c20"
  },
  {
   "text": "回到开头的问题",
   "start": 40.63,
   "end": 41.981,
   "id": "c21"
  },
  {
   "text": "域名是对的 锁也在",
   "start": 42.302,
   "end": 44.378,
   "id": "c22"
  },
  {
   "text": "不能证明页面是真的",
   "start": 44.611,
   "end": 46.236,
   "id": "c23"
  },
  {
   "text": "它只说明你连上了域名此刻指向的服务器",
   "start": 46.602,
   "end": 50.331,
   "id": "c24"
  },
  {
   "text": "而那台服务器",
   "start": 50.515,
   "end": 51.601,
   "id": "c25"
  },
  {
   "text": "可能已经换了主人",
   "start": 51.707,
   "end": 53.242,
   "id": "c26"
  },
  {
   "text": "审计管得住合约",
   "start": 53.53,
   "end": 55.235,
   "id": "c27"
  },
  {
   "text": "管不住页面",
   "start": 55.313,
   "end": 56.246,
   "id": "c28"
  },
  {
   "text": "签名之前",
   "start": 56.509,
   "end": 57.311,
   "id": "c29"
  },
  {
   "text": "独立核对你在签什么",
   "start": 57.508,
   "end": 59.223,
   "id": "c30"
  },
  {
   "text": "下一集讲社会工程与内部人",
   "start": 59.51,
   "end": 62.271,
   "id": "c31"
  }
 ]
