 "captions": [
  {
   "text": "最后 每个人今天就能做一件事",
   "start": 1.648,
   "end": 4.151,
   "id": "c0"
  },
  {
   "text": "写合约的人",
   "start": 5.132,
   "end": 6.135,
   "id": "c1"
  },
  {
   "text": "搜一遍代码里的 tx.origin",
   "start": 6.155,
   "end": 8.873,
   "id": "c2"
  },
  {
   "text": "确认没有一处拿它做权限判断",
   "start": 9.036,
   "end": 11.456,
   "id": "c3"
  },
  {
   "text": "审计的人",
   "start": 12.456,
   "end": 13.352,
   "id": "c4"
  },
  {
   "text": "找出每一处 delegatecall 问一句",
   "start": 13.372,
   "end": 16.007,
   "id": "c5"
  },
  {
   "text": "目标地址由谁决定",
   "start": 16.039,
   "end": 17.661,
   "id": "c6"
  },
  {
   "text": "做升级的人",
   "start": 18.932,
   "end": 19.971,
   "id": "c7"
  },
  {
   "text": "不看工具",
   "start": 19.991,
   "end": 20.875,
   "id": "c8"
  },
  {
   "text": "写出合约前三个存储槽的内容",
   "start": 21.051,
   "end": 23.661,
   "id": "c9"
  },
  {
   "text": "再和工具对一遍",
   "start": 23.694,
   "end": 24.935,
   "id": "c10"
  },
  {
   "text": "回到开头的问题",
   "start": 25.92,
   "end": 27.304,
   "id": "c11"
  },
  {
   "text": "管理员没丢私钥",
   "start": 27.679,
   "end": 29.147,
   "id": "c12"
  },
  {
   "text": "金库为什么认了攻击者",
   "start": 29.358,
   "end": 30.968,
   "id": "c13"
  },
  {
   "text": "因为金库问错了问题",
   "start": 32.252,
   "end": 33.803,
   "id": "c14"
  },
  {
   "text": "它问的是",
   "start": 34.178,
   "end": 35.098,
   "id": "c15"
  },
  {
   "text": "这笔交易是谁发起的",
   "start": 35.249,
   "end": 37.193,
   "id": "c16"
  },
  {
   "text": "它该问的是",
   "start": 37.547,
   "end": 38.61,
   "id": "c17"
  },
  {
   "text": "谁在直接调用我",
   "start": 38.797,
   "end": 40.133,
   "id": "c18"
  },
  {
   "text": "这个答案的前提",
   "start": 41.112,
   "end": 42.484,
   "id": "c19"
  },
  {
   "text": "是权限只认直接调用者",
   "start": 42.54,
   "end": 45.21,
   "id": "c20"
  },
  {
   "text": "至于对方是人还是合约",
   "start": 45.562,
   "end": 47.684,
   "id": "c21"
  },
  {
   "text": "EIP-7702 之后",
   "start": 47.931,
   "end": 49.803,
   "id": "c22"
  },
  {
   "text": "已经没法靠简单比较来判断",
   "start": 49.954,
   "end": 51.946,
   "id": "c23"
  },
  {
   "text": "下一集讲重入 最古老",
   "start": 52.924,
   "end": 55.166,
   "id": "c24"
  },
  {
   "text": "也最常复发的合约漏洞",
   "start": 55.186,
   "end": 57.046,
   "id": "c25"
  }
 ]
