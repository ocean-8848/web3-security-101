 "captions": [
  {
   "text": "最后 每个人今天就能做一件事",
   "start": 1.55,
   "end": 4.459,
   "id": "c0"
  },
  {
   "text": "写合约的人",
   "start": 4.73,
   "end": 5.732,
   "id": "c1"
  },
  {
   "text": "搜一遍代码里的 tx.origin",
   "start": 5.752,
   "end": 8.372,
   "id": "c2"
  },
  {
   "text": "确认没有一处拿它做权限判断",
   "start": 8.528,
   "end": 10.869,
   "id": "c3"
  },
  {
   "text": "审计的人",
   "start": 11.11,
   "end": 11.957,
   "id": "c4"
  },
  {
   "text": "找出每一处 delegatecall 问一句",
   "start": 11.977,
   "end": 14.511,
   "id": "c5"
  },
  {
   "text": "目标地址由谁决定",
   "start": 14.719,
   "end": 16.438,
   "id": "c6"
  },
  {
   "text": "做升级的人",
   "start": 16.97,
   "end": 18.1,
   "id": "c7"
  },
  {
   "text": "不看工具",
   "start": 18.12,
   "end": 18.98,
   "id": "c8"
  },
  {
   "text": "写出合约前三个存储槽的内容",
   "start": 19.132,
   "end": 21.832,
   "id": "c9"
  },
  {
   "text": "再和工具对一遍",
   "start": 21.852,
   "end": 23.223,
   "id": "c10"
  },
  {
   "text": "回到开头的问题",
   "start": 23.51,
   "end": 24.86,
   "id": "c11"
  },
  {
   "text": "管理员没丢私钥",
   "start": 25.188,
   "end": 26.732,
   "id": "c12"
  },
  {
   "text": "金库为什么认了攻击者",
   "start": 26.951,
   "end": 28.944,
   "id": "c13"
  },
  {
   "text": "因为金库问错了问题",
   "start": 29.45,
   "end": 31.704,
   "id": "c14"
  },
  {
   "text": "它问的是",
   "start": 32.004,
   "end": 32.753,
   "id": "c15"
  },
  {
   "text": "这笔交易是谁发起的",
   "start": 32.882,
   "end": 34.796,
   "id": "c16"
  },
  {
   "text": "它该问的是",
   "start": 35.046,
   "end": 35.903,
   "id": "c17"
  },
  {
   "text": "谁在直接调用我",
   "start": 36.098,
   "end": 37.843,
   "id": "c18"
  },
  {
   "text": "这个答案的前提",
   "start": 38.171,
   "end": 40.102,
   "id": "c19"
  },
  {
   "text": "是权限只认直接调用者",
   "start": 40.122,
   "end": 42.439,
   "id": "c20"
  },
  {
   "text": "至于对方是人还是合约",
   "start": 42.459,
   "end": 44.353,
   "id": "c21"
  },
  {
   "text": "EIP-7702 之后",
   "start": 44.385,
   "end": 46.12,
   "id": "c22"
  },
  {
   "text": "已经没法靠简单比较来判断",
   "start": 46.255,
   "end": 48.637,
   "id": "c23"
  },
  {
   "text": "下一集讲重入 最古老",
   "start": 48.85,
   "end": 50.963,
   "id": "c24"
  },
  {
   "text": "也最常复发的合约漏洞",
   "start": 50.983,
   "end": 53.768,
   "id": "c25"
  }
 ]
}