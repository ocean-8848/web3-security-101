 "captions": [
  {
   "text": "回到开头的冷钱包",
   "start": 1.55,
   "end": 3.059,
   "id": "c0"
  },
  {
   "text": "六把钥匙里",
   "start": 3.383,
   "end": 4.365,
   "id": "c1"
  },
  {
   "text": "WazirX 持五把",
   "start": 4.558,
   "end": 6.276,
   "id": "c2"
  },
  {
   "text": "Liminal 持一把",
   "start": 6.477,
   "end": 7.63,
   "id": "c3"
  },
  {
   "text": "签名人在 Liminal 界面上看到的交易",
   "start": 7.91,
   "end": 10.73,
   "id": "c4"
  },
  {
   "text": "和实际签下的不一样",
   "start": 10.927,
   "end": 12.652,
   "id": "c5"
  },
  {
   "text": "实际签下的",
   "start": 12.93,
   "end": 14.083,
   "id": "c6"
  },
  {
   "text": "是一次合约升级",
   "start": 14.119,
   "end": 15.66,
   "id": "c7"
  },
  {
   "text": "钱包控制权被转走",
   "start": 16.024,
   "end": 17.81,
   "id": "c8"
  },
  {
   "text": "接手的是一个恶意合约",
   "start": 18.2,
   "end": 20.175,
   "id": "c9"
  },
  {
   "text": "它提前 8 天就部署好",
   "start": 20.404,
   "end": 22.134,
   "id": "c10"
  },
  {
   "text": "WazirX 称",
   "start": 22.425,
   "end": 23.423,
   "id": "c11"
  },
  {
   "text": "问题出在 Liminal 界面显示的数据",
   "start": 23.651,
   "end": 26.235,
   "id": "c12"
  },
  {
   "text": "Liminal 称",
   "start": 26.564,
   "end": 27.322,
   "id": "c13"
  },
  {
   "text": "自己的基础设施没有被攻破",
   "start": 27.342,
   "end": 29.596,
   "id": "c14"
  },
  {
   "text": "是受害方的 3 台机器被注入恶意载荷",
   "start": 29.716,
   "end": 33.243,
   "id": "c15"
  },
  {
   "text": "这一争议",
   "start": 33.585,
   "end": 34.324,
   "id": "c16"
  },
  {
   "text": "没有见到最终的独立报告",
   "start": 34.44,
   "end": 36.669,
   "id": "c17"
  },
  {
   "text": "多签只保证",
   "start": 37.012,
   "end": 37.969,
   "id": "c18"
  },
  {
   "text": "足够多的人同意某个哈希",
   "start": 38.001,
   "end": 40.233,
   "id": "c19"
  },
  {
   "text": "它不管这个哈希",
   "start": 40.49,
   "end": 41.896,
   "id": "c20"
  },
  {
   "text": "代表的是哪一笔交易",
   "start": 42.003,
   "end": 43.76,
   "id": "c21"
  },
  {
   "text": "签名人看到的和实际签的不一样",
   "start": 44.08,
   "end": 46.894,
   "id": "c22"
  },
  {
   "text": "每把钥匙都会正常工作",
   "start": 47.11,
   "end": 49.122,
   "id": "c23"
  },
  {
   "text": "防线在签名人自己这一侧",
   "start": 49.41,
   "end": 51.596,
   "id": "c24"
  },
  {
   "text": "每个签名人",
   "start": 51.971,
   "end": 52.881,
   "id": "c25"
  },
  {
   "text": "在自己的设备上",
   "start": 52.901,
   "end": 54.155,
   "id": "c26"
  },
  {
   "text": "用另一套代码",
   "start": 54.367,
   "end": 55.569,
   "id": "c27"
  },
  {
   "text": "独立算一遍交易哈希",
   "start": 55.662,
   "end": 57.239,
   "id": "c28"
  },
  {
   "text": "再在硬件钱包屏幕上",
   "start": 57.45,
   "end": 59.309,
   "id": "c29"
  },
  {
   "text": "核对收款地址 金额",
   "start": 59.481,
   "end": 61.565,
   "id": "c30"
  },
  {
   "text": "数据和操作类型",
   "start": 61.688,
   "end": 63.481,
   "id": "c31"
  },
  {
   "text": "设备把交易解析成人能读懂的字段再签",
   "start": 63.75,
   "end": 67.57,
   "id": "c32"
  },
  {
   "text": "这叫清晰签名",
   "start": 67.722,
   "end": 69.149,
   "id": "c33"
  },
  {
   "text": "例行转账",
   "start": 69.505,
   "end": 70.346,
   "id": "c34"
  },
  {
   "text": "操作类型应该是 CALL",
   "start": 70.562,
   "end": 72.205,
   "id": "c35"
  },
  {
   "text": "如果是 DELEGATECALL",
   "start": 72.531,
   "end": 74.057,
   "id": "c36"
  },
  {
   "text": "就是让多签合约执行外部代码 不签",
   "start": 74.293,
   "end": 77.45,
   "id": "c37"
  },
  {
   "text": "大额交易",
   "start": 77.785,
   "end": 78.705,
   "id": "c38"
  },
  {
   "text": "再用电话或当面",
   "start": 78.755,
   "end": 80.31,
   "id": "c39"
  },
  {
   "text": "确认发起人身份",
   "start": 80.385,
   "end": 81.83,
   "id": "c40"
  },
  {
   "text": "签名人不能共用一台电脑",
   "start": 82.07,
   "end": 84.477,
   "id": "c41"
  },
  {
   "text": "一个浏览器",
   "start": 84.597,
   "end": 85.475,
   "id": "c42"
  },
  {
   "text": "一个前端",
   "start": 85.567,
   "end": 86.353,
   "id": "c43"
  },
  {
   "text": "共用就是单点",
   "start": 86.766,
   "end": 88.201,
   "id": "c44"
  },
  {
   "text": "局限是 如果所有人用同一个解码工具",
   "start": 88.45,
   "end": 92.017,
   "id": "c45"
  },
  {
   "text": "这个工具就是新的单点",
   "start": 92.167,
   "end": 94.163,
   "id": "c46"
  }
 ]
}