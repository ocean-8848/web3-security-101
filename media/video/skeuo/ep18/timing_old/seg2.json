 "captions": [
  {
   "text": "先给准确的说法",
   "start": 1.55,
   "end": 2.807,
   "id": "c0"
  },
  {
   "text": "私钥是一个 256 位的随机数",
   "start": 3.05,
   "end": 6.098,
   "id": "c1"
  },
  {
   "text": "用来给交易签名",
   "start": 6.294,
   "end": 7.832,
   "id": "c2"
  },
  {
   "text": "谁能让私钥签一笔交易",
   "start": 8.07,
   "end": 10.252,
   "id": "c3"
  },
  {
   "text": "谁就拥有这笔资产",
   "start": 10.43,
   "end": 12.118,
   "id": "c4"
  },
  {
   "text": "助记词是 12 或 24 个单词",
   "start": 12.37,
   "end": 15.53,
   "id": "c5"
  },
  {
   "text": "可以推导出一组私钥",
   "start": 15.649,
   "end": 17.389,
   "id": "c6"
  },
  {
   "text": "放私钥的方法",
   "start": 17.63,
   "end": 18.923,
   "id": "c7"
  },
  {
   "text": "常见的有五种",
   "start": 18.987,
   "end": 20.385,
   "id": "c8"
  },
  {
   "text": "第一种 助记词软件钱包",
   "start": 20.65,
   "end": 22.823,
   "id": "c9"
  },
  {
   "text": "私钥在手机",
   "start": 22.972,
   "end": 24.384,
   "id": "c10"
  },
  {
   "text": "电脑或浏览器扩展里",
   "start": 24.404,
   "end": 26.301,
   "id": "c11"
  },
  {
   "text": "设备被攻破",
   "start": 26.55,
   "end": 27.902,
   "id": "c12"
  },
  {
   "text": "钱就没了",
   "start": 28.021,
   "end": 28.96,
   "id": "c13"
  },
  {
   "text": "第二种 硬件钱包",
   "start": 29.263,
   "end": 30.913,
   "id": "c14"
  },
  {
   "text": "私钥在一块独立芯片里",
   "start": 31.168,
   "end": 33.335,
   "id": "c15"
  },
  {
   "text": "不离开设备",
   "start": 33.48,
   "end": 34.394,
   "id": "c16"
  },
  {
   "text": "它只负责签名 签之前",
   "start": 34.67,
   "end": 37.221,
   "id": "c17"
  },
  {
   "text": "人要看清签的是什么",
   "start": 37.283,
   "end": 38.943,
   "id": "c18"
  },
  {
   "text": "第三种 多签",
   "start": 39.21,
   "end": 40.735,
   "id": "c19"
  },
  {
   "text": "比如 Safe",
   "start": 40.96,
   "end": 41.397,
   "id": "c20"
  },
  {
   "text": "几个独立私钥加一个链上合约",
   "start": 41.417,
   "end": 44.903,
   "id": "c21"
  },
  {
   "text": "签名数达到门槛",
   "start": 45.19,
   "end": 46.644,
   "id": "c22"
  },
  {
   "text": "交易才执行",
   "start": 46.684,
   "end": 47.754,
   "id": "c23"
  },
  {
   "text": "第四种 MPC 门限签名",
   "start": 48.05,
   "end": 50.841,
   "id": "c24"
  },
  {
   "text": "私钥被切成几个分片",
   "start": 51.051,
   "end": 52.872,
   "id": "c25"
  },
  {
   "text": "几方各自计算",
   "start": 53.244,
   "end": 54.683,
   "id": "c26"
  },
  {
   "text": "合成一个普通签名",
   "start": 54.965,
   "end": 56.62,
   "id": "c27"
  },
  {
   "text": "完整私钥从不出现",
   "start": 56.823,
   "end": 58.533,
   "id": "c28"
  },
  {
   "text": "第五种 HSM",
   "start": 58.81,
   "end": 60.514,
   "id": "c29"
  },
  {
   "text": "私钥锁在专用硬件里",
   "start": 60.692,
   "end": 62.654,
   "id": "c30"
  },
  {
   "text": "不能导出",
   "start": 62.7,
   "end": 63.463,
   "id": "c31"
  },
  {
   "text": "它只按指令签名",
   "start": 63.67,
   "end": 65.37,
   "id": "c32"
  },
  {
   "text": "不判断指令对不对",
   "start": 65.508,
   "end": 66.912,
   "id": "c33"
  },
  {
   "text": "签名人看不懂签的内容就签 叫盲签",
   "start": 67.17,
   "end": 70.846,
   "id": "c34"
  },
  {
   "text": "软件钱包和 HSM",
   "start": 71.164,
   "end": 73.375,
   "id": "c35"
  },
  {
   "text": "盲签风险最高",
   "start": 73.576,
   "end": 74.89,
   "id": "c36"
  },
  {
   "text": "多签的门槛写在链上",
   "start": 75.229,
   "end": 76.93,
   "id": "c37"
  },
  {
   "text": "谁都能查",
   "start": 76.95,
   "end": 77.861,
   "id": "c38"
  },
  {
   "text": "MPC 在链上只是一个普通地址",
   "start": 78.104,
   "end": 80.684,
   "id": "c39"
  },
  {
   "text": "打个比方",
   "start": 81.046,
   "end": 81.712,
   "id": "c40"
  },
  {
   "text": "私钥是保险柜的钥匙",
   "start": 82.259,
   "end": 84.362,
   "id": "c41"
  },
  {
   "text": "多签像一个柜子三把锁",
   "start": 84.706,
   "end": 87.283,
   "id": "c42"
  },
  {
   "text": "要两把一起开",
   "start": 87.465,
   "end": 89.169,
   "id": "c43"
  },
  {
   "text": "可如果锁的主人看同一块屏幕",
   "start": 89.39,
   "end": 92.131,
   "id": "c44"
  },
  {
   "text": "三把锁就退化成一把",
   "start": 92.309,
   "end": 94.254,
   "id": "c45"
  },
  {
   "text": "比喻不成立的地方是",
   "start": 94.49,
   "end": 96.091,
   "id": "c46"
  },
  {
   "text": "真实的钥匙被复制",
   "start": 96.365,
   "end": 98.005,
   "id": "c47"
  },
  {
   "text": "会留下痕迹",
   "start": 98.239,
   "end": 99.283,
   "id": "c48"
  },
  {
   "text": "私钥被复制",
   "start": 99.59,
   "end": 100.81,
   "id": "c49"
  },
  {
   "text": "不留任何痕迹",
   "start": 100.944,
   "end": 102.096,
   "id": "c50"
  },
  {
   "text": "直到资产被转走",
   "start": 102.509,
   "end": 103.493,
   "id": "c51"
  },
  {
   "text": "你才知道",
   "start": 103.513,
   "end": 104.555,
   "id": "c52"
  },
  {
   "text": "所以方案的强度",
   "start": 104.85,
   "end": 106.432,
   "id": "c53"
  },
  {
   "text": "取决于最容易被攻破的那个环节",
   "start": 106.495,
   "end": 108.982,
   "id": "c54"
  },
  {
   "text": "一台设备",
   "start": 109.323,
   "end": 110.296,
   "id": "c55"
  },
  {
   "text": "一行日志",
   "start": 110.473,
   "end": 111.366,
   "id": "c56"
  },
  {
   "text": "一个签名人的眼睛",
   "start": 111.552,
   "end": 113.654,
   "id": "c57"
  }
 ]
}