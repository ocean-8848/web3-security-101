 "captions": [
  {
   "text": "交易所每天都要给用户提币",
   "start": 1.55,
   "end": 4.008,
   "id": "c0"
  },
  {
   "text": "不能每一笔都等人工签名",
   "start": 4.181,
   "end": 6.39,
   "id": "c1"
  },
  {
   "text": "常见做法",
   "start": 6.748,
   "end": 7.635,
   "id": "c2"
  },
  {
   "text": "是分成热 温",
   "start": 7.665,
   "end": 9.671,
   "id": "c3"
  },
  {
   "text": "冷三层钱包",
   "start": 9.776,
   "end": 11.28,
   "id": "c4"
  },
  {
   "text": "冷钱包放大部分资产",
   "start": 11.609,
   "end": 13.607,
   "id": "c5"
  },
  {
   "text": "用多签或 MPC",
   "start": 13.806,
   "end": 15.564,
   "id": "c6"
  },
  {
   "text": "每个签名人用硬件钱包",
   "start": 15.774,
   "end": 17.939,
   "id": "c7"
  },
  {
   "text": "温钱包负责中转",
   "start": 18.21,
   "end": 19.912,
   "id": "c8"
  },
  {
   "text": "靠审批加时间窗口",
   "start": 19.996,
   "end": 22.007,
   "id": "c9"
  },
  {
   "text": "热钱包自动给用户提币",
   "start": 22.27,
   "end": 25.315,
   "id": "c10"
  },
  {
   "text": "用 HSM 或 MPC",
   "start": 25.404,
   "end": 26.421,
   "id": "c11"
  },
  {
   "text": "热钱包只放一小部分",
   "start": 26.745,
   "end": 28.508,
   "id": "c12"
  },
  {
   "text": "按每天的提币需求设水位",
   "start": 28.69,
   "end": 30.894,
   "id": "c13"
  },
  {
   "text": "热钱包失守",
   "start": 31.203,
   "end": 32.382,
   "id": "c14"
  },
  {
   "text": "损失有上限",
   "start": 32.507,
   "end": 33.92,
   "id": "c15"
  },
  {
   "text": "冷到温 温到热",
   "start": 34.21,
   "end": 36.104,
   "id": "c16"
  },
  {
   "text": "每一跳都要限额和审批",
   "start": 36.17,
   "end": 39.241,
   "id": "c17"
  },
  {
   "text": "再猜一道题",
   "start": 39.55,
   "end": 40.483,
   "id": "c18"
  },
  {
   "text": "HSM 的私钥不能导出",
   "start": 40.823,
   "end": 43.173,
   "id": "c19"
  },
  {
   "text": "攻击者控制了能给 HSM 发指令的服务器",
   "start": 43.441,
   "end": 46.909,
   "id": "c20"
  },
  {
   "text": "HSM 会拒绝吗",
   "start": 47.094,
   "end": 48.563,
   "id": "c21"
  },
  {
   "text": "不会",
   "start": 49.225,
   "end": 49.679,
   "id": "c22"
  },
  {
   "text": "HSM 只保证私钥不出设备",
   "start": 50.01,
   "end": 53.087,
   "id": "c23"
  },
  {
   "text": "它按收到的指令签名",
   "start": 53.254,
   "end": 55.28,
   "id": "c24"
  },
  {
   "text": "所以热钱包的安全",
   "start": 55.661,
   "end": 57.352,
   "id": "c25"
  },
  {
   "text": "在签名请求进入 HSM 之前",
   "start": 57.433,
   "end": 60.698,
   "id": "c26"
  },
  {
   "text": "那里要有一个独立的风控引擎",
   "start": 61.006,
   "end": 63.48,
   "id": "c27"
  },
  {
   "text": "检查白名单 限额",
   "start": 63.639,
   "end": 65.766,
   "id": "c28"
  },
  {
   "text": "速率和异常",
   "start": 65.786,
   "end": 67.151,
   "id": "c29"
  },
  {
   "text": "检查要按待签的原始字节判断",
   "start": 67.37,
   "end": 69.954,
   "id": "c30"
  },
  {
   "text": "不看界面怎么写",
   "start": 70.015,
   "end": 71.267,
   "id": "c31"
  },
  {
   "text": "一笔大额转出",
   "start": 71.604,
   "end": 73.041,
   "id": "c32"
  },
  {
   "text": "审批也要按顺序走",
   "start": 73.132,
   "end": 74.732,
   "id": "c33"
  },
  {
   "text": "发起人提交交易",
   "start": 75.01,
   "end": 76.589,
   "id": "c34"
  },
  {
   "text": "写明用途",
   "start": 76.609,
   "end": 77.648,
   "id": "c35"
  },
  {
   "text": "系统自动检查白名单 限额",
   "start": 77.87,
   "end": 80.392,
   "id": "c36"
  },
  {
   "text": "以及操作类型是不是 CALL",
   "start": 80.57,
   "end": 82.37,
   "id": "c37"
  },
  {
   "text": "签名人各自解码核对",
   "start": 82.65,
   "end": 84.68,
   "id": "c38"
  },
  {
   "text": "大额再用电话或当面确认",
   "start": 84.803,
   "end": 87.352,
   "id": "c39"
  },
  {
   "text": "执行之后",
   "start": 87.685,
   "end": 88.437,
   "id": "c40"
  },
  {
   "text": "监控系统把链上结果和审批记录比对",
   "start": 88.76,
   "end": 92.054,
   "id": "c41"
  }
 ]
}