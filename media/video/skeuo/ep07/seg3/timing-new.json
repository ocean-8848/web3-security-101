 "captions": [
  {
   "text": "第二类风险",
   "start": 1.648,
   "end": 2.615,
   "id": "c0"
  },
  {
   "text": "来自代币本身",
   "start": 2.767,
   "end": 3.984,
   "id": "c1"
  },
  {
   "text": "ERC-20 只规定了接口",
   "start": 4.964,
   "end": 7.05,
   "id": "c2"
  },
  {
   "text": "没有规定行为",
   "start": 7.083,
   "end": 8.181,
   "id": "c3"
  },
  {
   "text": "常见的非标准行为 有八种",
   "start": 9.168,
   "end": 11.695,
   "id": "c4"
  },
  {
   "text": "一 transfer 不返回值",
   "start": 12.676,
   "end": 15.048,
   "id": "c5"
  },
  {
   "text": "比如以太坊上的 USDT",
   "start": 15.068,
   "end": 17.31,
   "id": "c6"
  },
  {
   "text": "用 SafeERC20 兼容",
   "start": 17.685,
   "end": 19.796,
   "id": "c7"
  },
  {
   "text": "二 transfer 成功了",
   "start": 20.768,
   "end": 22.688,
   "id": "c8"
  },
  {
   "text": "却返回 false",
   "start": 22.708,
   "end": 23.866,
   "id": "c9"
  },
  {
   "text": "这是 TRON 上的 USDT",
   "start": 24.23,
   "end": 26.4,
   "id": "c10"
  },
  {
   "text": "三 转账收税",
   "start": 27.396,
   "end": 29.208,
   "id": "c11"
  },
  {
   "text": "到账的钱",
   "start": 29.584,
   "end": 30.587,
   "id": "c12"
  },
  {
   "text": "比转出的少",
   "start": 30.715,
   "end": 31.73,
   "id": "c13"
  },
  {
   "text": "四 余额自动变化",
   "start": 32.704,
   "end": 34.79,
   "id": "c14"
  },
  {
   "text": "比如 stETH",
   "start": 34.858,
   "end": 36.564,
   "id": "c15"
  },
  {
   "text": "缓存的余额会失效",
   "start": 36.939,
   "end": 38.55,
   "id": "c16"
  },
  {
   "text": "要用份额记账",
   "start": 38.606,
   "end": 39.812,
   "id": "c17"
  },
  {
   "text": "五 黑名单和冻结",
   "start": 40.796,
   "end": 42.942,
   "id": "c18"
  },
  {
   "text": "六 可暂停",
   "start": 43.92,
   "end": 45.506,
   "id": "c19"
  },
  {
   "text": "七 转账钩子",
   "start": 46.492,
   "end": 48.269,
   "id": "c20"
  },
  {
   "text": "比如 ERC-777",
   "start": 48.396,
   "end": 50.221,
   "id": "c21"
  },
  {
   "text": "会带来重入",
   "start": 50.254,
   "end": 51.269,
   "id": "c22"
  },
  {
   "text": "八 可升级",
   "start": 52.256,
   "end": 53.747,
   "id": "c23"
  },
  {
   "text": "行为以后可能改变",
   "start": 54.122,
   "end": 55.745,
   "id": "c24"
  },
  {
   "text": "细看第二种",
   "start": 56.748,
   "end": 57.918,
   "id": "c25"
  },
  {
   "text": "OpenZeppelin 在 2026 年",
   "start": 58.281,
   "end": 60.297,
   "id": "c26"
  },
  {
   "text": "审计了 Across 协议的 TRON 部署",
   "start": 60.317,
   "end": 62.88,
   "id": "c27"
  },
  {
   "text": "TRON 上的 USDT",
   "start": 63.88,
   "end": 65.847,
   "id": "c28"
  },
  {
   "text": "转账成功时",
   "start": 65.915,
   "end": 67.074,
   "id": "c29"
  },
  {
   "text": "也返回 false",
   "start": 67.094,
   "end": 68.24,
   "id": "c30"
  },
  {
   "text": "于是",
   "start": 69.212,
   "end": 69.894,
   "id": "c31"
  },
  {
   "text": "用 safeTransfer 推送 USDT 的代码",
   "start": 70.045,
   "end": 73.001,
   "id": "c32"
  },
  {
   "text": "在 TRON 上一律回滚",
   "start": 73.021,
   "end": 74.584,
   "id": "c33"
  },
  {
   "text": "存款走拉取方向的 transferFrom",
   "start": 75.576,
   "end": 78.079,
   "id": "c34"
  },
  {
   "text": "不受影响",
   "start": 78.123,
   "end": 78.912,
   "id": "c35"
  },
  {
   "text": "症状就是",
   "start": 79.9,
   "end": 80.939,
   "id": "c36"
  },
  {
   "text": "存款正常",
   "start": 80.983,
   "end": 82.261,
   "id": "c37"
  },
  {
   "text": "提款全部失败",
   "start": 82.281,
   "end": 83.712,
   "id": "c38"
  },
  {
   "text": "修复是不读返回值",
   "start": 84.704,
   "end": 86.445,
   "id": "c39"
  },
  {
   "text": "只看接收方的余额涨了多少",
   "start": 86.537,
   "end": 88.612,
   "id": "c40"
  },
  {
   "text": "涨的正好等于金额",
   "start": 89.604,
   "end": 91.274,
   "id": "c41"
  },
  {
   "text": "才算到账",
   "start": 91.425,
   "end": 92.321,
   "id": "c42"
  },
  {
   "text": "这个方案假设不收手续费",
   "start": 93.304,
   "end": 95.616,
   "id": "c43"
  },
  {
   "text": "而 Tether 保留了开启它的能力",
   "start": 95.992,
   "end": 98.269,
   "id": "c44"
  },
  {
   "text": "再看第三种",
   "start": 99.26,
   "end": 100.453,
   "id": "c45"
  },
  {
   "text": "收税代币",
   "start": 100.474,
   "end": 101.513,
   "id": "c46"
  },
  {
   "text": "协议按参数记账",
   "start": 102.504,
   "end": 104.007,
   "id": "c47"
  },
  {
   "text": "用户说存 100",
   "start": 104.206,
   "end": 105.519,
   "id": "c48"
  },
  {
   "text": "账上就记 100",
   "start": 105.551,
   "end": 107.019,
   "id": "c49"
  },
  {
   "text": "可代币扣了税",
   "start": 108.004,
   "end": 109.126,
   "id": "c50"
  },
  {
   "text": "金库实际只收到 98",
   "start": 109.266,
   "end": 111.102,
   "id": "c51"
  },
  {
   "text": "账面比实收多出 2 枚",
   "start": 112.088,
   "end": 114.162,
   "id": "c52"
  },
  {
   "text": "这个差额",
   "start": 114.526,
   "end": 115.624,
   "id": "c53"
  },
  {
   "text": "由其他用户承担",
   "start": 115.68,
   "end": 116.934,
   "id": "c54"
  },
  {
   "text": "所有用户都这样存取",
   "start": 117.924,
   "end": 119.629,
   "id": "c55"
  },
  {
   "text": "协议就会资不抵债",
   "start": 119.781,
   "end": 121.332,
   "id": "c56"
  },
  {
   "text": "修复是按实收记账",
   "start": 122.32,
   "end": 123.942,
   "id": "c57"
  },
  {
   "text": "转账前后",
   "start": 124.165,
   "end": 125.192,
   "id": "c58"
  },
  {
   "text": "各读一次余额",
   "start": 125.284,
   "end": 126.407,
   "id": "c59"
  },
  {
   "text": "只记增量",
   "start": 126.427,
   "end": 127.406,
   "id": "c60"
  },
  {
   "text": "这一步要配合重入锁",
   "start": 128.396,
   "end": 130.101,
   "id": "c61"
  },
  {
   "text": "防止回调干扰前后两次读数",
   "start": 130.3,
   "end": 132.518,
   "id": "c62"
  },
  {
   "text": "没有一个库",
   "start": 133.512,
   "end": 134.634,
   "id": "c63"
  },
  {
   "text": "能防住所有怪代币",
   "start": 134.762,
   "end": 136.301,
   "id": "c64"
  },
  {
   "text": "审计时 先问项目方",
   "start": 137.284,
   "end": 139.489,
   "id": "c65"
  },
  {
   "text": "你们支持哪些代币",
   "start": 139.653,
   "end": 141.215,
   "id": "c66"
  },
  {
   "text": "不支持的类型",
   "start": 142.488,
   "end": 143.705,
   "id": "c67"
  },
  {
   "text": "比如收税和变基",
   "start": 143.773,
   "end": 145.205,
   "id": "c68"
  },
  {
   "text": "要显式拒绝",
   "start": 145.238,
   "end": 146.324,
   "id": "c69"
  }
 ]
