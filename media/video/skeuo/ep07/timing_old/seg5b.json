 "captions": [
  {
   "text": "最后 每个人今天就能做一件事",
   "start": 1.55,
   "end": 4.357,
   "id": "c0"
  },
  {
   "text": "写合约的人",
   "start": 4.57,
   "end": 5.616,
   "id": "c1"
  },
  {
   "text": "检查每一个低级 call 的返回值",
   "start": 5.682,
   "end": 7.874,
   "id": "c2"
  },
  {
   "text": "并确认目标有代码",
   "start": 8.077,
   "end": 9.654,
   "id": "c3"
  },
  {
   "text": "接代币的人",
   "start": 10.005,
   "end": 10.988,
   "id": "c4"
  },
  {
   "text": "按实收记账",
   "start": 11.008,
   "end": 12.035,
   "id": "c5"
  },
  {
   "text": "部署到 TRON",
   "start": 12.193,
   "end": 13.173,
   "id": "c6"
  },
  {
   "text": "单独处理 USDT 推送",
   "start": 13.215,
   "end": 14.976,
   "id": "c7"
  },
  {
   "text": "审计的人",
   "start": 15.25,
   "end": 16.164,
   "id": "c8"
  },
  {
   "text": "找出每个推送资金的循环 问",
   "start": 16.184,
   "end": 18.452,
   "id": "c9"
  },
  {
   "text": "有人拒收会怎样",
   "start": 18.472,
   "end": 20.592,
   "id": "c10"
  },
  {
   "text": "普通用户",
   "start": 21.11,
   "end": 22.08,
   "id": "c11"
  },
  {
   "text": "只授权需要的数额",
   "start": 22.139,
   "end": 23.848,
   "id": "c12"
  },
  {
   "text": "用完就撤销",
   "start": 24.066,
   "end": 25.194,
   "id": "c13"
  },
  {
   "text": "收到陌生代币",
   "start": 25.49,
   "end": 26.924,
   "id": "c14"
  },
  {
   "text": "不要去卖",
   "start": 26.97,
   "end": 27.718,
   "id": "c15"
  },
  {
   "text": "也不要去领",
   "start": 27.835,
   "end": 28.947,
   "id": "c16"
  },
  {
   "text": "在 TRON 上转 USDT",
   "start": 29.23,
   "end": 31.442,
   "id": "c17"
  },
  {
   "text": "确认状态是成功",
   "start": 31.573,
   "end": 32.967,
   "id": "c18"
  },
  {
   "text": "不只是已广播",
   "start": 33.164,
   "end": 34.436,
   "id": "c19"
  },
  {
   "text": "回到开头",
   "start": 34.65,
   "end": 35.447,
   "id": "c20"
  },
  {
   "text": "没有收到钱",
   "start": 35.928,
   "end": 37.048,
   "id": "c21"
  },
  {
   "text": "桥为什么记下了一笔存款",
   "start": 37.115,
   "end": 39.47,
   "id": "c22"
  },
  {
   "text": "因为它把成功加空返回",
   "start": 40.127,
   "end": 42.276,
   "id": "c23"
  },
  {
   "text": "当成了到账",
   "start": 42.49,
   "end": 43.026,
   "id": "c24"
  },
  {
   "text": "又没有问对方存不存在",
   "start": 43.046,
   "end": 45.432,
   "id": "c25"
  },
  {
   "text": "外部调用的返回",
   "start": 45.69,
   "end": 47.148,
   "id": "c26"
  },
  {
   "text": "只是对方的说法",
   "start": 47.321,
   "end": 48.513,
   "id": "c27"
  },
  {
   "text": "要证明钱到了",
   "start": 48.88,
   "end": 50.204,
   "id": "c28"
  },
  {
   "text": "就看余额的变化",
   "start": 50.304,
   "end": 51.624,
   "id": "c29"
  },
  {
   "text": "前提是 你清楚这个代币会不会收税",
   "start": 51.844,
   "end": 55.039,
   "id": "c30"
  },
  {
   "text": "对方未必按标准出牌",
   "start": 55.429,
   "end": 57.306,
   "id": "c31"
  },
  {
   "text": "你的合约要自己核对",
   "start": 57.52,
   "end": 59.132,
   "id": "c32"
  },
  {
   "text": "下一集讲预言机与闪电贷",
   "start": 59.39,
   "end": 62.06,
   "id": "c33"
  }
 ]
