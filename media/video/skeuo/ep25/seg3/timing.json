 "captions": [
  {
   "text": "从早到晚",
   "start": 1.55,
   "end": 2.712,
   "id": "c0"
  },
  {
   "text": "能拦钱的地方排成一列",
   "start": 2.889,
   "end": 4.808,
   "id": "c1"
  },
  {
   "text": "最靠前的",
   "start": 5.145,
   "end": 6.198,
   "id": "c2"
  },
  {
   "text": "是协议自己的暂停和延迟提款",
   "start": 6.316,
   "end": 9.691,
   "id": "c3"
  },
  {
   "text": "条件是合约里事先设计了暂停或延迟机制",
   "start": 9.91,
   "end": 14.028,
   "id": "c4"
  },
  {
   "text": "而且有人值守",
   "start": 14.202,
   "end": 15.676,
   "id": "c5"
  },
  {
   "text": "Bybit 被盗后",
   "start": 16.062,
   "end": 17.081,
   "id": "c6"
  },
  {
   "text": "mETH Protocol 靠 8 小时的提款延迟",
   "start": 17.189,
   "end": 20.463,
   "id": "c7"
  },
  {
   "text": "暂停了合约",
   "start": 20.483,
   "end": 22.135,
   "id": "c8"
  },
  {
   "text": "追回约 4300 万美元的 cmETH",
   "start": 22.155,
   "end": 24.994,
   "id": "c9"
  },
  {
   "text": "这是那次事件里",
   "start": 25.325,
   "end": 26.432,
   "id": "c10"
  },
  {
   "text": "追回最多的单项",
   "start": 26.496,
   "end": 27.805,
   "id": "c11"
  },
  {
   "text": "第二道 是稳定币发行方冻结",
   "start": 28.184,
   "end": 30.951,
   "id": "c12"
  },
  {
   "text": "Tether",
   "start": 31.19,
   "end": 31.791,
   "id": "c13"
  },
  {
   "text": "Circle 这类发行方",
   "start": 31.944,
   "end": 33.311,
   "id": "c14"
  },
  {
   "text": "可以在合约层面冻结一个地址",
   "start": 33.634,
   "end": 35.921,
   "id": "c15"
  },
  {
   "text": "2024 年 9 月",
   "start": 36.21,
   "end": 37.562,
   "id": "c16"
  },
  {
   "text": "Tether",
   "start": 37.799,
   "end": 38.297,
   "id": "c17"
  },
  {
   "text": "TRON 和 TRM 联合成立了 T3 金融犯罪部门",
   "start": 38.326,
   "end": 42.356,
   "id": "c18"
  },
  {
   "text": "2026 年 5 月",
   "start": 42.775,
   "end": 44.148,
   "id": "c19"
  },
  {
   "text": "T3 自报累计冻结 4.5 亿美元以上",
   "start": 44.363,
   "end": 47.428,
   "id": "c20"
  },
  {
   "text": "可这条路 有门槛 有时延",
   "start": 47.788,
   "end": 50.682,
   "id": "c21"
  },
  {
   "text": "也可能被撤销",
   "start": 50.838,
   "end": 51.957,
   "id": "c22"
  },
  {
   "text": "门槛是 通常要有执法请求或法院命令",
   "start": 52.329,
   "end": 56.497,
   "id": "c23"
  },
  {
   "text": "撤销的例子",
   "start": 56.77,
   "end": 57.93,
   "id": "c24"
  },
  {
   "text": "是 2025 年 5 月的 LIBRA 案",
   "start": 57.989,
   "end": 60.435,
   "id": "c25"
  },
  {
   "text": "Circle 依据纽约南区法院的临时限制令",
   "start": 60.67,
   "end": 64.844,
   "id": "c26"
  },
  {
   "text": "冻结了约 5760 万美元 USDC",
   "start": 64.864,
   "end": 67.851,
   "id": "c27"
  },
  {
   "text": "8 月 法官解除了冻结",
   "start": 68.192,
   "end": 70.488,
   "id": "c28"
  },
  {
   "text": "理由是原告没有证明不可弥补的损害",
   "start": 70.664,
   "end": 73.852,
   "id": "c29"
  },
  {
   "text": "时延的例子",
   "start": 74.07,
   "end": 75.197,
   "id": "c30"
  },
  {
   "text": "是 2026 年 4 月的 Drift 被盗事件",
   "start": 75.352,
   "end": 78.467,
   "id": "c31"
  },
  {
   "text": "链上调查者 ZachXBT",
   "start": 78.782,
   "end": 80.616,
   "id": "c32"
  },
  {
   "text": "公开批评 Circle 延迟了约 6 小时",
   "start": 80.636,
   "end": 84.007,
   "id": "c33"
  },
  {
   "text": "期间约 2.32 亿美元经跨链协议转走",
   "start": 84.229,
   "end": 87.951,
   "id": "c34"
  },
  {
   "text": "这是个人指控",
   "start": 88.284,
   "end": 89.298,
   "id": "c35"
  },
  {
   "text": "未见 Circle 回应",
   "start": 89.411,
   "end": 90.44,
   "id": "c36"
  },
  {
   "text": "美国 GENIUS 法案在 2025 年 7 月成为法律",
   "start": 90.823,
   "end": 94.652,
   "id": "c37"
  },
  {
   "text": "要求支付型稳定币发行方",
   "start": 94.789,
   "end": 96.888,
   "id": "c38"
  },
  {
   "text": "有能力执行冻结 扣押",
   "start": 96.981,
   "end": 99.526,
   "id": "c39"
  },
  {
   "text": "阻止转账这类合法命令",
   "start": 99.636,
   "end": 101.695,
   "id": "c40"
  },
  {
   "text": "第三道 是交易所冻结",
   "start": 101.91,
   "end": 104.257,
   "id": "c41"
  },
  {
   "text": "条件是交易所收到可信的地址清单",
   "start": 104.53,
   "end": 108.028,
   "id": "c42"
  },
  {
   "text": "或者风控名单命中",
   "start": 108.175,
   "end": 109.884,
   "id": "c43"
  },
  {
   "text": "时效在小时级",
   "start": 110.047,
   "end": 111.623,
   "id": "c44"
  },
  {
   "text": "局限也很明显",
   "start": 111.87,
   "end": 113.358,
   "id": "c45"
  },
  {
   "text": "攻击者会避开合规交易所",
   "start": 113.597,
   "end": 116.201,
   "id": "c46"
  }
 ]
}