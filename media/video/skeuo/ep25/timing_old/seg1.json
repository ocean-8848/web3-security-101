 "captions": [
  {
   "text": "2026 年 10 月",
   "start": 1.649,
   "end": 3.216,
   "id": "c0"
  },
  {
   "text": "Binance 遭遇了一次大规模盗窃",
   "start": 3.493,
   "end": 6.22,
   "id": "c1"
  },
  {
   "text": "被盗资金",
   "start": 6.586,
   "end": 7.476,
   "id": "c2"
  },
  {
   "text": "经过主要的清扫交易",
   "start": 7.831,
   "end": 9.486,
   "id": "c3"
  },
  {
   "text": "转了出去",
   "start": 9.513,
   "end": 10.247,
   "id": "c4"
  },
  {
   "text": "37 分钟后",
   "start": 10.55,
   "end": 11.984,
   "id": "c5"
  },
  {
   "text": "Tether 冻结了 9.711 亿 USDT",
   "start": 12.239,
   "end": 16.068,
   "id": "c6"
  },
  {
   "text": "又过了 3 分钟",
   "start": 16.382,
   "end": 18.423,
   "id": "c7"
  },
  {
   "text": "Circle 冻结了 8.23 亿 USDC",
   "start": 18.492,
   "end": 21.207,
   "id": "c8"
  },
  {
   "text": "听起来很快",
   "start": 21.47,
   "end": 22.723,
   "id": "c9"
  },
  {
   "text": "可还是慢了一步",
   "start": 23.129,
   "end": 24.449,
   "id": "c10"
  },
  {
   "text": "Elliptic 估计",
   "start": 24.823,
   "end": 25.958,
   "id": "c11"
  },
  {
   "text": "冻结生效之前",
   "start": 26.221,
   "end": 28.147,
   "id": "c12"
  },
  {
   "text": "约 7.86 亿美元的稳定币",
   "start": 28.32,
   "end": 30.633,
   "id": "c13"
  },
  {
   "text": "已经被换成了 ETH 和 TRX",
   "start": 30.914,
   "end": 34.059,
   "id": "c14"
  },
  {
   "text": "换成这两种币",
   "start": 34.31,
   "end": 35.636,
   "id": "c15"
  },
  {
   "text": "发行方就管不到了",
   "start": 35.841,
   "end": 37.339,
   "id": "c16"
  },
  {
   "text": "TRM 统计",
   "start": 37.57,
   "end": 38.681,
   "id": "c17"
  },
  {
   "text": "事发后约 4 小时",
   "start": 38.73,
   "end": 40.285,
   "id": "c18"
  },
  {
   "text": "各方累计冻结约 27 亿美元",
   "start": 40.359,
   "end": 42.979,
   "id": "c19"
  },
  {
   "text": "就算这样",
   "start": 43.23,
   "end": 44.101,
   "id": "c20"
  },
  {
   "text": "冻结也只覆盖了约 44% 的损失",
   "start": 44.141,
   "end": 47.194,
   "id": "c21"
  },
  {
   "text": "先猜一道题",
   "start": 47.45,
   "end": 48.421,
   "id": "c22"
  },
  {
   "text": "被盗的资产里",
   "start": 48.807,
   "end": 51.658,
   "id": "c23"
  },
  {
   "text": "有 USDT 和 USDC",
   "start": 51.755,
   "end": 53.783,
   "id": "c24"
  },
  {
   "text": "也有 BTC",
   "start": 53.803,
   "end": 55.451,
   "id": "c25"
  },
  {
   "text": "XRP 和 SOL",
   "start": 55.505,
   "end": 56.726,
   "id": "c26"
  },
  {
   "text": "发行方冻结",
   "start": 56.93,
   "end": 58.322,
   "id": "c27"
  },
  {
   "text": "能管到其中哪几种",
   "start": 59.015,
   "end": 60.558,
   "id": "c28"
  },
  {
   "text": "带着这个问题",
   "start": 61.203,
   "end": 62.161,
   "id": "c29"
  },
  {
   "text": "我们看看",
   "start": 62.459,
   "end": 63.067,
   "id": "c30"
  },
  {
   "text": "钱被转走之后",
   "start": 63.312,
   "end": 64.674,
   "id": "c31"
  },
  {
   "text": "到底能拦住多少",
   "start": 64.868,
   "end": 66.49,
   "id": "c32"
  }
 ]
}