 ],
 "captions": [
  {
   "text": "先给一句准确的说法",
   "start": 1.648,
   "end": 3.246,
   "id": "c0"
  },
  {
   "text": "追回的窗口",
   "start": 4.244,
   "end": 5.366,
   "id": "c1"
  },
  {
   "text": "以小时计",
   "start": 5.529,
   "end": 6.449,
   "id": "c2"
  },
  {
   "text": "头几个小时里",
   "start": 7.416,
   "end": 8.645,
   "id": "c3"
  },
  {
   "text": "被盗的钱",
   "start": 8.856,
   "end": 9.741,
   "id": "c4"
  },
  {
   "text": "还是可冻结的稳定币",
   "start": 9.761,
   "end": 11.336,
   "id": "c5"
  },
  {
   "text": "是交易所里的充值",
   "start": 11.511,
   "end": 12.99,
   "id": "c6"
  },
  {
   "text": "或者是链上可以暂停的合约份额",
   "start": 13.058,
   "end": 15.347,
   "id": "c7"
  },
  {
   "text": "几个小时之后",
   "start": 16.324,
   "end": 17.482,
   "id": "c8"
  },
  {
   "text": "它会变成跨链后的原生币",
   "start": 17.597,
   "end": 19.435,
   "id": "c9"
  },
  {
   "text": "混币器里的存款",
   "start": 19.455,
   "end": 20.815,
   "id": "c10"
  },
  {
   "text": "或者场外交易的现金",
   "start": 20.895,
   "end": 22.422,
   "id": "c11"
  },
  {
   "text": "这里有两个动作",
   "start": 23.408,
   "end": 24.566,
   "id": "c12"
  },
  {
   "text": "资金追踪",
   "start": 25.548,
   "end": 26.623,
   "id": "c13"
  },
  {
   "text": "是沿着链上交易",
   "start": 26.643,
   "end": 28.04,
   "id": "c14"
  },
  {
   "text": "跟踪钱的去向",
   "start": 28.06,
   "end": 29.265,
   "id": "c15"
  },
  {
   "text": "冻结 是由发行方",
   "start": 30.256,
   "end": 32.187,
   "id": "c16"
  },
  {
   "text": "交易所或链上机制",
   "start": 32.363,
   "end": 34.318,
   "id": "c17"
  },
  {
   "text": "阻止某个地址转出资产",
   "start": 34.398,
   "end": 36.438,
   "id": "c18"
  },
  {
   "text": "打个比方",
   "start": 37.436,
   "end": 38.332,
   "id": "c19"
  },
  {
   "text": "抢劫发生后",
   "start": 38.388,
   "end": 39.498,
   "id": "c20"
  },
  {
   "text": "警方在城市的每个出口设卡",
   "start": 39.614,
   "end": 41.641,
   "id": "c21"
  },
  {
   "text": "出口就是稳定币发行方 交易所",
   "start": 42.624,
   "end": 45.746,
   "id": "c22"
  },
  {
   "text": "跨链桥和混币器",
   "start": 45.838,
   "end": 47.591,
   "id": "c23"
  },
  {
   "text": "设卡越早",
   "start": 48.58,
   "end": 49.678,
   "id": "c24"
  },
  {
   "text": "拦住的车越多",
   "start": 49.794,
   "end": 50.916,
   "id": "c25"
  },
  {
   "text": "劫匪一旦开上国道",
   "start": 51.896,
   "end": 53.47,
   "id": "c26"
  },
  {
   "text": "换了车牌",
   "start": 53.681,
   "end": 54.649,
   "id": "c27"
  },
  {
   "text": "再拦就很难了",
   "start": 54.669,
   "end": 55.875,
   "id": "c28"
  },
  {
   "text": "这个比方有一处不成立",
   "start": 56.844,
   "end": 58.799,
   "id": "c29"
  },
  {
   "text": "链上的出口",
   "start": 59.776,
   "end": 60.862,
   "id": "c30"
  },
  {
   "text": "大多不归任何警察管",
   "start": 60.918,
   "end": 62.672,
   "id": "c31"
  },
  {
   "text": "去中心化的跨链桥",
   "start": 63.644,
   "end": 65.266,
   "id": "c32"
  },
  {
   "text": "混币器和交易所",
   "start": 65.286,
   "end": 67.016,
   "id": "c33"
  },
  {
   "text": "没有义务配合",
   "start": 67.036,
   "end": 68.254,
   "id": "c34"
  },
  {
   "text": "能拦住的",
   "start": 69.24,
   "end": 70.231,
   "id": "c35"
  },
  {
   "text": "主要是有中心化运营方的那部分出口",
   "start": 70.311,
   "end": 72.898,
   "id": "c36"
  },
  {
   "text": "攻击者也清楚这一点",
   "start": 73.9,
   "end": 75.439,
   "id": "c37"
  },
  {
   "text": "所以路线很固定",
   "start": 75.59,
   "end": 77.272,
   "id": "c38"
  },
  {
   "text": "第一步 把稳定币换掉",
   "start": 78.248,
   "end": 80.156,
   "id": "c39"
  },
  {
   "text": "躲开发行方冻结",
   "start": 80.271,
   "end": 81.751,
   "id": "c40"
  },
  {
   "text": "第二步 分散到大量地址",
   "start": 82.74,
   "end": 85.1,
   "id": "c41"
  },
  {
   "text": "抬高追踪成本",
   "start": 85.204,
   "end": 86.564,
   "id": "c42"
  },
  {
   "text": "第三步 跨链",
   "start": 87.544,
   "end": 89.047,
   "id": "c43"
  },
  {
   "text": "或者进混币器",
   "start": 89.198,
   "end": 90.535,
   "id": "c44"
  },
  {
   "text": "切断链上的关联",
   "start": 90.71,
   "end": 92.118,
   "id": "c45"
  },
  {
   "text": "最后 通过场外交易",
   "start": 93.116,
   "end": 95.321,
   "id": "c46"
  },
  {
   "text": "或者小额分批进交易所",
   "start": 95.413,
   "end": 97.227,
   "id": "c47"
  },
  {
   "text": "换成现金",
   "start": 97.247,
   "end": 98.298,
   "id": "c48"
  },
  {
   "text": "实在走不掉 他就等",
   "start": 99.288,
   "end": 101.291,
   "id": "c49"
  },
  {
   "text": "等关注度下降",
   "start": 101.407,
   "end": 102.6,
   "id": "c50"
  },
  {
   "text": "2025 年 Bybit 被盗之后",
   "start": 103.588,
   "end": 105.674,
   "id": "c51"
  },
  {
   "text": "约 72% 的资金经 THORChain",
   "start": 105.802,
   "end": 108.52,
   "id": "c52"
  },
  {
   "text": "换成了 BTC",
   "start": 108.54,
   "end": 109.912,
   "id": "c53"
  },
  {
   "text": "约 16% 经兑换服务 eXch 兑换",
   "start": 109.933,
   "end": 112.96,
   "id": "c54"
  },
  {
   "text": "拦截点越靠前",
   "start": 113.96,
   "end": 115.332,
   "id": "c55"
  },
  {
   "text": "成功率越高",
   "start": 115.352,
   "end": 116.57,
   "id": "c56"
  }
 ]
