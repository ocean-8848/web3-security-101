   "speechStart": 1.698,
   "speechEnd": 5.269
  },
  {
   "id": "seg1-01",
   "text": "被盗资金，经过主要的清扫交易，转了出去。",
   "spoken": "被盗资金，经过主要的清扫交易，转了出去。",
   "src": "/Users/k/Workon/Learning/web3/web3-security-101/media/video/skeuo/ep25/audio/lines/seg1-01.mp3",
   "start": 6.332,
   "dur": 4.608,
   "speechStart": 6.43,
   "speechEnd": 10.108
  },
  {
   "id": "seg1-02",
   "text": "37 分钟后，Tether 冻结了 9.711 亿 USDT。",
   "spoken": "37 分钟后，Tether 冻结了 9.711 亿 USDT。",
   "src": "/Users/k/Workon/Learning/web3/web3-security-101/media/video/skeuo/ep25/audio/lines/seg1-02.mp3",
   "start": 11.16,
   "dur": 5.424,
   "speechStart": 11.258,
   "speechEnd": 15.758
  },
  {
   "id": "seg1-03",
   "text": "又过了 3 分钟，Circle 冻结了 8.23 亿 USDC。",
   "spoken": "又过了 3 分钟，Circle 冻结了 8.23 亿 USDC。",
