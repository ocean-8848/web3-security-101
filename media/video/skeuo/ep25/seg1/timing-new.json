   "start": 37.196,
   "dur": 5.808,
   "speechStart": 37.294,
   "speechEnd": 42.163
  },
  {
   "id": "seg1-08",
   "text": "就算这样，冻结也只覆盖了约 44% 的损失。",
   "spoken": "就算这样，冻结也只覆盖了约 44% 的损失。",
