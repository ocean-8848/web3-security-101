 "captions": [
  {
   "text": "2022 年 8 月 1 日",
   "start": 1.648,
   "end": 3.234,
   "id": "c0"
  },
  {
   "text": "跨链桥 Nomad 被提走约 1.9 亿美元",
   "start": 3.302,
   "end": 6.211,
   "id": "c1"
  },
  {
   "text": "按事发时估值",
   "start": 6.231,
   "end": 7.603,
   "id": "c2"
  },
  {
   "text": "起因 是此前的一次升级",
   "start": 8.588,
   "end": 10.829,
   "id": "c3"
  },
  {
   "text": "这次升级调用了初始化函数",
   "start": 11.808,
   "end": 14.18,
   "id": "c4"
  },
  {
   "text": "把可信的消息根",
   "start": 14.379,
   "end": 15.633,
   "id": "c5"
  },
  {
   "text": "设成了全零",
   "start": 15.653,
   "end": 16.811,
   "id": "c6"
  },
  {
   "text": "桥合约收到一条消息",
   "start": 17.788,
   "end": 19.493,
   "id": "c7"
  },
  {
   "text": "先查它对应的根",
   "start": 19.716,
   "end": 21.018,
   "id": "c8"
  },
  {
   "text": "再看这个根是否可信",
   "start": 21.038,
   "end": 22.648,
   "id": "c9"
  },
  {
   "text": "先猜一道题",
   "start": 23.648,
   "end": 24.972,
   "id": "c10"
  },
  {
   "text": "一条从没被证明过的消息",
   "start": 25.956,
   "end": 27.899,
   "id": "c11"
  },
  {
   "text": "查到的根是什么",
   "start": 28.063,
   "end": 29.269,
   "id": "c12"
  },
  {
   "text": "它能通过吗",
   "start": 29.632,
   "end": 30.707,
   "id": "c13"
  },
  {
   "text": "它查到的是默认值 全零",
   "start": 31.976,
   "end": 34.443,
   "id": "c14"
  },
  {
   "text": "而全零 刚刚被这次升级",
   "start": 35.412,
   "end": 37.796,
   "id": "c15"
  },
  {
   "text": "标记成了可信",
   "start": 37.864,
   "end": 38.986,
   "id": "c16"
  },
  {
   "text": "所以 任何消息都被视为已经证明",
   "start": 39.976,
   "end": 43.11,
   "id": "c17"
  },
  {
   "text": "按 Immunefi 的复盘",
   "start": 44.108,
   "end": 45.671,
   "id": "c18"
  },
  {
   "text": "和 The Block 的报道",
   "start": 45.691,
   "end": 46.92,
   "id": "c19"
  },
  {
   "text": "第一笔提款成功后",
   "start": 47.072,
   "end": 48.444,
   "id": "c20"
  },
  {
   "text": "数百个地址复制了这笔交易",
   "start": 48.477,
   "end": 50.457,
   "id": "c21"
  },
  {
   "text": "只换掉收款地址",
   "start": 50.477,
   "end": 51.909,
   "id": "c22"
  },
  {
   "text": "升级的代码",
   "start": 52.896,
   "end": 54.066,
   "id": "c23"
  },
  {
   "text": "可以没有错",
   "start": 54.169,
   "end": 55.006,
   "id": "c24"
  },
  {
   "text": "错的 是升级时传进去的参数",
   "start": 55.996,
   "end": 58.749,
   "id": "c25"
  },
  {
   "text": "能升级的合约",
   "start": 59.744,
   "end": 61.08,
   "id": "c26"
  },
  {
   "text": "是怎么搭起来的",
   "start": 61.148,
   "end": 62.259,
   "id": "c27"
  },
  {
   "text": "谁能换掉它的代码",
   "start": 62.622,
   "end": 64.066,
   "id": "c28"
  }
 ]
}