 "captions": [
  {
   "text": "普通合约用构造函数设置主人",
   "start": 1.55,
   "end": 4.23,
   "id": "c0"
  },
  {
   "text": "代理合约不行",
   "start": 4.374,
   "end": 5.545,
   "id": "c1"
  },
  {
   "text": "构造函数只在实现合约自己的存储里运行",
   "start": 5.77,
   "end": 9.445,
   "id": "c2"
  },
  {
   "text": "写不进代理",
   "start": 9.607,
   "end": 10.707,
   "id": "c3"
  },
  {
   "text": "所以可升级合约用一个初始化函数代替",
   "start": 11.042,
   "end": 14.331,
   "id": "c4"
  },
  {
   "text": "部署以后再调用一次",
   "start": 14.473,
   "end": 16.17,
   "id": "c5"
  },
  {
   "text": "这一次调用",
   "start": 16.549,
   "end": 17.605,
   "id": "c6"
  },
  {
   "text": "就是风险所在",
   "start": 17.64,
   "end": 18.813,
   "id": "c7"
  },
  {
   "text": "第一种情况",
   "start": 19.164,
   "end": 20.004,
   "id": "c8"
  },
  {
   "text": "部署代理和初始化",
   "start": 20.139,
   "end": 21.725,
   "id": "c9"
  },
  {
   "text": "分成了两笔交易",
   "start": 21.976,
   "end": 23.328,
   "id": "c10"
  },
  {
   "text": "中间有空隙",
   "start": 23.706,
   "end": 24.91,
   "id": "c11"
  },
  {
   "text": "别人可以抢先初始化",
   "start": 25.229,
   "end": 26.964,
   "id": "c12"
  },
  {
   "text": "成为主人",
   "start": 26.984,
   "end": 27.888,
   "id": "c13"
  },
  {
   "text": "修复是在同一笔交易里完成",
   "start": 28.105,
   "end": 30.561,
   "id": "c14"
  },
  {
   "text": "第二种 初始化函数可以重复调用",
   "start": 30.884,
   "end": 34.628,
   "id": "c15"
  },
  {
   "text": "任何人都能重置主人",
   "start": 35.081,
   "end": 36.842,
   "id": "c16"
  },
  {
   "text": "修复是加上只能调用一次的修饰器",
   "start": 37.14,
   "end": 40.126,
   "id": "c17"
  },
  {
   "text": "第三种 代理初始化了",
   "start": 40.461,
   "end": 42.252,
   "id": "c18"
  },
  {
   "text": "实现合约本身没有",
   "start": 42.283,
   "end": 43.969,
   "id": "c19"
  },
  {
   "text": "代理的初始化",
   "start": 44.282,
   "end": 45.402,
   "id": "c20"
  },
  {
   "text": "写在代理的存储里",
   "start": 45.422,
   "end": 47.081,
   "id": "c21"
  },
  {
   "text": "实现合约自己的存储",
   "start": 47.187,
   "end": 48.874,
   "id": "c22"
  },
  {
   "text": "还是空的",
   "start": 48.899,
   "end": 49.674,
   "id": "c23"
  },
  {
   "text": "先猜一道题",
   "start": 49.93,
   "end": 50.927,
   "id": "c24"
  },
  {
   "text": "别人能直接调用实现合约的初始化函数吗",
   "start": 51.573,
   "end": 55.176,
   "id": "c25"
  },
  {
   "text": "能",
   "start": 55.71,
   "end": 56.259,
   "id": "c26"
  },
  {
   "text": "他会成为实现合约的主人",
   "start": 56.51,
   "end": 58.834,
   "id": "c27"
  },
  {
   "text": "如果实现合约里有 delegatecall",
   "start": 59.227,
   "end": 61.52,
   "id": "c28"
  },
  {
   "text": "或者自毁的路径",
   "start": 61.54,
   "end": 62.951,
   "id": "c29"
  },
  {
   "text": "所有指向它的代理",
   "start": 63.085,
   "end": 64.614,
   "id": "c30"
  },
  {
   "text": "都可能失效",
   "start": 64.634,
   "end": 65.548,
   "id": "c31"
  },
  {
   "text": "2021 年 9 月",
   "start": 65.937,
   "end": 67.234,
   "id": "c32"
  },
  {
   "text": "OpenZeppelin 发布安全公告",
   "start": 67.471,
   "end": 69.449,
   "id": "c33"
  },
  {
   "text": "它的 UUPS 实现",
   "start": 69.61,
   "end": 70.984,
   "id": "c34"
  },
  {
   "text": "有几个版本存在这个问题",
   "start": 71.19,
   "end": 73.039,
   "id": "c35"
  },
  {
   "text": "随后发布了修复版本",
   "start": 73.197,
   "end": 74.845,
   "id": "c36"
  },
  {
   "text": "修复是在实现合约的构造函数里",
   "start": 75.09,
   "end": 78.433,
   "id": "c37"
  },
  {
   "text": "禁用初始化",
   "start": 78.511,
   "end": 79.484,
   "id": "c38"
  },
  {
   "text": "这样谁都不能再初始化它",
   "start": 79.504,
   "end": 81.787,
   "id": "c39"
  },
  {
   "text": "回到开头的 Nomad",
   "start": 82.03,
   "end": 83.35,
   "id": "c40"
  },
  {
   "text": "它的问题",
   "start": 83.71,
   "end": 84.515,
   "id": "c41"
  },
  {
   "text": "出在升级时的初始化参数",
   "start": 84.535,
   "end": 86.613,
   "id": "c42"
  },
  {
   "text": "合约用一张表",
   "start": 86.89,
   "end": 88.439,
   "id": "c43"
  },
  {
   "text": "记录每个根什么时候被确认",
   "start": 88.568,
   "end": 90.543,
   "id": "c44"
  },
  {
   "text": "升级把全零这个根",
   "start": 90.81,
   "end": 92.956,
   "id": "c45"
  },
  {
   "text": "标记成了已确认",
   "start": 93.16,
   "end": 94.57,
   "id": "c46"
  },
  {
   "text": "而没被证明过的消息",
   "start": 94.971,
   "end": 96.679,
   "id": "c47"
  },
  {
   "text": "查到的根",
   "start": 96.783,
   "end": 97.68,
   "id": "c48"
  },
  {
   "text": "默认也是全零",
   "start": 97.824,
   "end": 99.272,
   "id": "c49"
  },
  {
   "text": "默认值和合法值",
   "start": 99.582,
   "end": 101.178,
   "id": "c50"
  },
  {
   "text": "撞在了一起",
   "start": 101.198,
   "end": 102.205,
   "id": "c51"
  },
  {
   "text": "教训有三条",
   "start": 102.43,
   "end": 103.703,
   "id": "c52"
  },
  {
   "text": "初始化参数",
   "start": 103.957,
   "end": 105.035,
   "id": "c53"
  },
  {
   "text": "和代码一样需要审计",
   "start": 105.149,
   "end": 106.88,
   "id": "c54"
  },
  {
   "text": "零值不能带有业务含义",
   "start": 107.13,
   "end": 109.348,
   "id": "c55"
  },
  {
   "text": "默认值必须和合法值区分开",
   "start": 109.585,
   "end": 112.203,
   "id": "c56"
  },
  {
   "text": "升级以后要跑回归测试",
   "start": 112.47,
   "end": 114.485,
   "id": "c57"
  },
  {
   "text": "覆盖这一条",
   "start": 114.684,
   "end": 115.674,
   "id": "c58"
  },
  {
   "text": "未授权的消息必须被拒绝",
   "start": 115.89,
   "end": 118.412,
   "id": "c59"
  }
 ]
}