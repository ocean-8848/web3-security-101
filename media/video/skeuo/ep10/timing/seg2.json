   "text": "用户的每次调用",
   "start": 10.44,
   "end": 11.931,
   "id": "c5"
  },
  {
   "text": "都先到它这里",
   "start": 12.047,
   "end": 13.17,
   "id": "c6"
  },
  {
   "text": "实现合约",
   "start": 14.164,
   "end": 15.322,
   "id": "c7"
  },
  {
   "text": "只提供代码",
   "start": 15.402,
   "end": 16.476,
   "id": "c8"
  },
  {
   "text": "代理用 delegatecall 把调用转给实现",
   "start": 17.456,
   "end": 19.864,
   "id": "c9"
  },
  {
   "text": "借用实现的代码",
   "start": 20.063,
   "end": 21.34,
   "id": "c10"
  },
  {
   "text": "读写的却是代理自己的存储",
   "start": 21.36,
   "end": 23.173,
   "id": "c11"
  },
  {
   "text": "升级 就是让代理指向一个新的实现",
   "start": 24.156,
   "end": 26.98,
   "id": "c12"
  },
  {
   "text": "数据和资金原地不动",
   "start": 27.976,
   "end": 29.657,
   "id": "c13"
  },
  {
   "text": "只换代码",
   "start": 29.845,
   "end": 30.824,
   "id": "c14"
  },
  {
   "text": "所以 谁能换实现",
   "start": 31.82,
   "end": 33.871,
   "id": "c15"
  },
  {
   "text": "谁就拥有代理里的全部资金",
   "start": 33.939,
   "end": 36.073,
   "id": "c16"
  },
  {
   "text": "打个比方",
   "start": 37.056,
   "end": 38.011,
   "id": "c17"
  },
  {
   "text": "代理是一台售货机的机身",
   "start": 38.375,
   "end": 40.247,
   "id": "c18"
  },
  {
   "text": "货和钱都在里面",
   "start": 40.339,
   "end": 41.58,
   "id": "c19"
  },
  {
   "text": "实现是维修门后面的机芯",
   "start": 42.58,
   "end": 44.642,
   "id": "c20"
  },
  {
   "text": "决定按下按钮以后",
   "start": 44.758,
   "end": 46.214,
   "id": "c21"
  },
  {
   "text": "机器怎么动",
   "start": 46.234,
   "end": 47.131,
   "id": "c22"
  },
  {
   "text": "升级 就是打开维修门",
   "start": 48.104,
   "end": 50.143,
   "id": "c23"
  },
  {
   "text": "换一块新机芯",
   "start": 50.235,
   "end": 51.428,
   "id": "c24"
  },
  {
   "text": "比喻在这里不成立",
   "start": 52.404,
   "end": 53.8,
   "id": "c25"
  },
  {
   "text": "真实的机器换机芯要花时间",
   "start": 53.987,
   "end": 56.419,
   "id": "c26"
  },
  {
   "text": "链上如果没有时间锁",
   "start": 56.794,
   "end": 58.44,
   "id": "c27"
  },
  {
   "text": "换实现只要一笔交易",
   "start": 58.496,
   "end": 60.357,
   "id": "c28"
  },
  {
   "text": "常见的代理有三种",
   "start": 61.336,
   "end": 62.839,
   "id": "c29"
  },
  {
   "text": "区别在于",
   "start": 62.943,
   "end": 63.935,
   "id": "c30"
  },
  {
   "text": "升级的开关放在哪里",
   "start": 63.955,
   "end": 65.613,
   "id": "c31"
  },
  {
   "text": "第一种 透明代理",
   "start": 66.596,
   "end": 68.242,
   "id": "c32"
  },
  {
   "text": "升级函数在代理里",
   "start": 68.617,
   "end": 70.263,
   "id": "c33"
  },
  {
   "text": "由管理员调用",
   "start": 70.296,
   "end": 71.549,
   "id": "c34"
  },
  {
   "text": "管理员调用代理时不转发",
   "start": 72.528,
   "end": 74.412,
   "id": "c35"
  },
  {
   "text": "其他人的调用只转发",
   "start": 74.575,
   "end": 76.162,
   "id": "c36"
  },
  {
   "text": "两边的函数就不会混淆",
   "start": 76.254,
   "end": 78.233,
   "id": "c37"
  },
  {
   "text": "第二种 UUPS",
   "start": 79.228,
   "end": 81.16,
   "id": "c38"
  },
  {
   "text": "代理只做转发",
   "start": 81.523,
   "end": 82.895,
   "id": "c39"
  },
  {
   "text": "升级函数写在实现合约里",
   "start": 82.987,
   "end": 85.264,
   "id": "c40"
  },
  {
   "text": "风险是 新实现如果忘了带上升级函数",
   "start": 86.24,
   "end": 89.588,
   "id": "c41"
  },
  {
   "text": "这个合约就再也不能升级",
   "start": 89.787,
   "end": 91.791,
   "id": "c42"
  },
  {
   "text": "第三种 信标代理",
   "start": 92.772,
   "end": 94.561,
   "id": "c43"
  },
  {
   "text": "很多代理共用一个信标",
   "start": 94.936,
   "end": 96.737,
   "id": "c44"
  },
  {
   "text": "信标里存着实现的地址",
   "start": 96.805,
   "end": 98.761,
   "id": "c45"
  },
  {
   "text": "它适合大量相同的合约",
   "start": 99.76,
   "end": 101.727,
   "id": "c46"
  },
  {
   "text": "比如每个用户一个金库",
   "start": 101.76,
   "end": 103.763,
   "id": "c47"
  },
  {
   "text": "改一次信标",
   "start": 104.138,
   "end": 105.058,
   "id": "c48"
  },
  {
   "text": "所有代理一起换",
   "start": 105.114,
   "end": 106.296,
   "id": "c49"
  },
  {
   "text": "三种模式都依赖 delegatecall",
   "start": 107.276,
   "end": 109.588,
   "id": "c50"
  },
  {
   "text": "所以都有同一个风险",
   "start": 109.68,
   "end": 111.184,
   "id": "c51"
  },
  {
   "text": "存储冲突",
   "start": 111.204,
   "end": 112.184,
   "id": "c52"
  }
 ]
}