 "captions": [
  {
   "text": "最后 每个人今天就能做一件事",
   "start": 1.648,
   "end": 4.151,
   "id": "c0"
  },
  {
   "text": "写合约的人",
   "start": 5.132,
   "end": 6.183,
   "id": "c1"
  },
  {
   "text": "在实现合约的构造函数里禁用初始化",
   "start": 6.203,
   "end": 9.135,
   "id": "c2"
  },
  {
   "text": "把部署和初始化放进同一笔交易",
   "start": 9.322,
   "end": 11.683,
   "id": "c3"
  },
  {
   "text": "审计的人",
   "start": 12.672,
   "end": 13.651,
   "id": "c4"
  },
  {
   "text": "把新旧存储布局交给工具比对",
   "start": 13.684,
   "end": 16.389,
   "id": "c5"
  },
  {
   "text": "再解码升级交易的初始化参数",
   "start": 16.529,
   "end": 18.83,
   "id": "c6"
  },
  {
   "text": "看有没有零值",
   "start": 18.85,
   "end": 20.08,
   "id": "c7"
  },
  {
   "text": "普通用户",
   "start": 21.076,
   "end": 22.031,
   "id": "c8"
  },
  {
   "text": "存款前查一查",
   "start": 22.088,
   "end": 23.436,
   "id": "c9"
  },
  {
   "text": "这个协议能不能升级",
   "start": 23.552,
   "end": 25.186,
   "id": "c10"
  },
  {
   "text": "由谁升级",
   "start": 25.254,
   "end": 26.305,
   "id": "c11"
  },
  {
   "text": "有没有时间锁",
   "start": 26.385,
   "end": 27.508,
   "id": "c12"
  },
  {
   "text": "能无延迟升级的协议",
   "start": 28.472,
   "end": 30.106,
   "id": "c13"
  },
  {
   "text": "等于你把资金交给了升级权限的持有人",
   "start": 30.269,
   "end": 33.296,
   "id": "c14"
  },
  {
   "text": "同一个协议在不同的链上",
   "start": 34.284,
   "end": 36.108,
   "id": "c15"
  },
  {
   "text": "升级权限要分别核对",
   "start": 36.236,
   "end": 38.132,
   "id": "c16"
  },
  {
   "text": "回到开头",
   "start": 39.112,
   "end": 40.067,
   "id": "c17"
  },
  {
   "text": "升级的代码没有错",
   "start": 40.443,
   "end": 41.946,
   "id": "c18"
  },
  {
   "text": "为什么钱还是被提走了",
   "start": 42.121,
   "end": 44.291,
   "id": "c19"
  },
  {
   "text": "因为升级换掉的不只是代码",
   "start": 45.54,
   "end": 48.019,
   "id": "c20"
  },
  {
   "text": "初始化参数写进了存储",
   "start": 48.394,
   "end": 50.707,
   "id": "c21"
  },
  {
   "text": "把全零变成了可信",
   "start": 50.823,
   "end": 52.326,
   "id": "c22"
  },
  {
   "text": "这在默认值和合法值无法区分时成立",
   "start": 53.32,
   "end": 56.418,
   "id": "c23"
  },
  {
   "text": "零值没有业务含义",
   "start": 56.793,
   "end": 58.38,
   "id": "c24"
  },
  {
   "text": "这一步就拦得住",
   "start": 58.567,
   "end": 59.88,
   "id": "c25"
  },
  {
   "text": "代理存着钱",
