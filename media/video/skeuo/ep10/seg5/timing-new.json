 "captions": [
  {
   "text": "谁能换实现",
   "start": 1.648,
   "end": 2.901,
   "id": "c0"
  },
  {
   "text": "谁就拥有全部资金",
   "start": 2.957,
   "end": 4.71,
   "id": "c1"
  },
  {
   "text": "所以升级权限",
   "start": 5.708,
   "end": 7.175,
   "id": "c2"
  },
  {
   "text": "要按最高等级来保护",
   "start": 7.327,
   "end": 9.33,
   "id": "c3"
  },
  {
   "text": "透明代理的权限",
   "start": 10.32,
   "end": 11.716,
   "id": "c4"
  },
  {
   "text": "在代理的管理员槽位",
   "start": 11.748,
   "end": 13.347,
   "id": "c5"
  },
  {
   "text": "UUPS 在实现合约的授权函数里",
   "start": 13.722,
   "end": 16.725,
   "id": "c6"
  },
  {
   "text": "信标在信标的拥有者手里",
   "start": 17.091,
   "end": 19.225,
   "id": "c7"
  },
  {
   "text": "无论在哪",
   "start": 20.212,
   "end": 21.132,
   "id": "c8"
  },
  {
   "text": "都应该经过多签和时间锁",
   "start": 21.224,
   "end": 23.286,
   "id": "c9"
  },
  {
   "text": "时间锁让升级先排队 再公开",
   "start": 24.272,
   "end": 27.311,
   "id": "c10"
  },
  {
   "text": "给社区留出复核的时间",
   "start": 27.391,
   "end": 29.287,
   "id": "c11"
  },
  {
   "text": "但时间锁有另一面",
   "start": 30.276,
   "end": 31.886,
   "id": "c12"
  },
  {
   "text": "2021 年 9 月",
   "start": 32.872,
   "end": 34.089,
   "id": "c13"
  },
  {
   "text": "Compound 第 62 号提案升级了奖励逻辑",
   "start": 34.193,
   "end": 37.042,
   "id": "c14"
  },
  {
   "text": "里面有错误",
   "start": 37.122,
   "end": 38.03,
   "id": "c15"
  },
  {
   "text": "部分用户可以超额领取 COMP",
   "start": 38.098,
   "end": 40.137,
   "id": "c16"
  },
  {
   "text": "按 The Block 报道",
   "start": 41.132,
   "end": 42.397,
   "id": "c17"
  },
  {
   "text": "最坏情况约 28 万枚",
   "start": 42.608,
   "end": 44.373,
   "id": "c18"
  },
  {
   "text": "约 8000 万美元",
   "start": 44.417,
   "end": 45.623,
   "id": "c19"
  },
  {
   "text": "协议没有能停止分发的紧急开关",
   "start": 46.608,
   "end": 49.135,
   "id": "c20"
  },
  {
   "text": "任何修复",
   "start": 49.51,
   "end": 50.537,
   "id": "c21"
  },
  {
   "text": "都要走约 7 天的治理流程",
   "start": 50.57,
   "end": 52.716,
   "id": "c22"
  },
  {
   "text": "时间锁挡住了恶意升级",
   "start": 53.716,
   "end": 55.624,
   "id": "c23"
  },
  {
   "text": "也挡住了紧急修复",
   "start": 55.644,
   "end": 57.159,
   "id": "c24"
  },
  {
   "text": "所以暂停权和升级权要分开设计",
   "start": 58.16,
   "end": 61.52,
   "id": "c25"
  },
  {
   "text": "暂停可以快",
   "start": 61.707,
   "end": 62.735,
   "id": "c26"
  },
  {
   "text": "升级必须慢",
   "start": 62.755,
   "end": 63.937,
   "id": "c27"
  },
  {
   "text": "再往下一层",
   "start": 64.908,
   "end": 66.03,
   "id": "c28"
  },
  {
   "text": "链本身也可能被升级",
   "start": 66.158,
   "end": 67.792,
   "id": "c29"
  },
  {
   "text": "比如 Mantle",
