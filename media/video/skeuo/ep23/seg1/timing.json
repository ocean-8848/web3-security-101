 "captions": [
  {
   "text": "2026 年 10 月 29 日",
   "start": 1.55,
   "end": 3.807,
   "id": "c0"
  },
  {
   "text": "Binance 的热钱包",
   "start": 4.041,
   "end": 5.465,
   "id": "c1"
  },
  {
   "text": "开始大额转出",
   "start": 5.497,
   "end": 6.893,
   "id": "c2"
  },
  {
   "text": "先是 XRP",
   "start": 7.13,
   "end": 8.005,
   "id": "c3"
  },
  {
   "text": "再是比特币",
   "start": 8.026,
   "end": 10.39,
   "id": "c4"
  },
  {
   "text": "然后是以太坊",
   "start": 10.641,
   "end": 11.964,
   "id": "c5"
  },
  {
   "text": "一条链接着一条链",
   "start": 12.324,
   "end": 14.092,
   "id": "c6"
  },
  {
   "text": "资产往外流",
   "start": 14.331,
   "end": 15.55,
   "id": "c7"
  },
  {
   "text": "交易所发现之后",
   "start": 15.81,
   "end": 17.007,
   "id": "c8"
  },
  {
   "text": "暂停了提现",
   "start": 17.145,
   "end": 18.071,
   "id": "c9"
  },
  {
   "text": "可按项目方的初步报告",
   "start": 18.35,
   "end": 20.48,
   "id": "c10"
  },
  {
   "text": "暂停提现",
   "start": 20.753,
   "end": 21.717,
   "id": "c11"
  },
  {
   "text": "没有挡住全部的未授权转账",
   "start": 21.737,
   "end": 24.225,
   "id": "c12"
  },
  {
   "text": "最后一笔",
   "start": 24.584,
   "end": 25.433,
   "id": "c13"
  },
  {
   "text": "到世界协调时 23 点 56 分 才转完",
   "start": 25.519,
   "end": 29.68,
   "id": "c14"
  },
  {
   "text": "项目方的口径是",
   "start": 29.99,
   "end": 32.551,
   "id": "c15"
  },
  {
   "text": "约 63.4 亿美元",
   "start": 32.736,
   "end": 35.013,
   "id": "c16"
  },
  {
   "text": "这是有记录以来",
   "start": 35.344,
   "end": 36.559,
   "id": "c17"
  },
  {
   "text": "最大的一起加密资产盗窃案",
   "start": 36.72,
   "end": 39.245,
   "id": "c18"
  },
  {
   "text": "更反常的是",
   "start": 39.648,
   "end": 40.771,
   "id": "c19"
  },
  {
   "text": "Binance 称",
   "start": 41.004,
   "end": 41.758,
   "id": "c20"
  },
  {
   "text": "没有发现私钥泄露的证据",
   "start": 41.778,
   "end": 43.899,
   "id": "c21"
  },
  {
   "text": "没有私钥",
   "start": 44.266,
   "end": 45.144,
   "id": "c22"
  },
  {
   "text": "钱是怎么签出去的",
   "start": 45.344,
   "end": 47.014,
   "id": "c23"
  },
  {
   "text": "先猜一道题",
   "start": 47.55,
   "end": 48.55,
   "id": "c24"
  },
  {
   "text": "提现已经暂停",
   "start": 48.81,
   "end": 50.313,
   "id": "c25"
  },
  {
   "text": "热钱包服务也关掉了",
   "start": 50.535,
   "end": 52.248,
   "id": "c26"
  },
  {
   "text": "以太坊热钱包上",
   "start": 52.567,
   "end": 54.89,
   "id": "c27"
  },
  {
   "text": "还留着一个恶意的 EIP-7702 委托",
   "start": 55.012,
   "end": 58.22,
   "id": "c28"
  },
  {
   "text": "这时候 新转进这个地址的钱 安全吗",
   "start": 58.53,
   "end": 62.107,
   "id": "c29"
  },
  {
   "text": "带着这个问题",
   "start": 62.724,
   "end": 63.685,
   "id": "c30"
  },
  {
   "text": "我们看看交易所的两张面孔",
   "start": 64.009,
   "end": 66.785,
   "id": "c31"
  }
 ]
}