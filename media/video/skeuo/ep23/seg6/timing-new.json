 "captions": [
  {
   "text": "回到开头的题",
   "start": 1.648,
   "end": 3.044,
   "id": "c0"
  },
  {
   "text": "答案是不安全",
   "start": 4.028,
   "end": 5.555,
   "id": "c1"
  },
  {
   "text": "委托写在账户的链上代码里",
   "start": 6.528,
   "end": 8.614,
   "id": "c2"
  },
  {
   "text": "独立于链下的提现系统",
   "start": 8.682,
   "end": 10.531,
   "id": "c3"
  },
  {
   "text": "在新的授权覆盖或者清零它之前",
   "start": 11.524,
   "end": 14.17,
   "id": "c4"
  },
  {
   "text": "委托合约照样可以被调用",
   "start": 14.405,
   "end": 16.515,
   "id": "c5"
  },
  {
   "text": "Binance 在 10 月 30 日 0 点 10 分",
   "start": 17.504,
   "end": 19.948,
   "id": "c6"
  },
  {
   "text": "才把委托清零",
   "start": 19.968,
   "end": 21.114,
   "id": "c7"
  },
  {
   "text": "恶意委托在链上",
   "start": 22.116,
   "end": 23.369,
   "id": "c8"
  },
  {
   "text": "存活了约 3 小时 50 分",
   "start": 23.437,
   "end": 25.238,
   "id": "c9"
  },
  {
   "text": "暂停提现",
   "start": 26.224,
   "end": 27.239,
   "id": "c10"
  },
  {
   "text": "不等于撤销权限",
   "start": 27.355,
   "end": 28.858,
   "id": "c11"
  },
  {
   "text": "交易所今天就能做三件事",
   "start": 29.852,
   "end": 31.914,
   "id": "c12"
  },
  {
   "text": "提前写好紧急撤销流程并且演练",
   "start": 32.904,
   "end": 35.847,
   "id": "c13"
  },
  {
   "text": "把链上授权也算进去",
   "start": 35.999,
   "end": 37.621,
   "id": "c14"
  },
  {
   "text": "热钱包设余额上限",
   "start": 38.62,
   "end": 40.385,
   "id": "c15"
  },
  {
   "text": "每条链单独熔断",
   "start": 40.536,
   "end": 42.04,
   "id": "c16"
  },
  {
   "text": "签名策略覆盖全部交易类型",
   "start": 43.04,
   "end": 45.543,
   "id": "c17"
  },
  {
   "text": "包括 EIP-7702 授权",
   "start": 45.635,
   "end": 48.4,
   "id": "c18"
  },
  {
   "text": "普通用户也有几件事",
   "start": 49.38,
   "end": 51.252,
   "id": "c19"
  },
  {
   "text": "充值前 确认交易所支持的代币合约地址和网络",
   "start": 52.24,
   "end": 56.398,
   "id": "c20"
  },
  {
   "text": "开启提币白名单和新地址冷却期",
   "start": 57.38,
   "end": 60.228,
   "id": "c21"
  },
  {
   "text": "提币地址从地址簿里选",
   "start": 60.463,
   "end": 62.811,
   "id": "c22"
  },
  {
   "text": "来源不明的资金不要充进去",
   "start": 63.792,
   "end": 65.795,
   "id": "c23"
  },
  {
   "text": "交易所要你补资料",
   "start": 66.006,
   "end": 67.284,
   "id": "c24"
  },
  {
   "text": "只在官方 App 里处理",
   "start": 67.304,
   "end": 68.735,
   "id": "c25"
  },
  {
   "text": "保管者要让签名只为真实的订单服务",
   "start": 69.724,
   "end": 73.048,
   "id": "c26"
  },
  {
   "text": "检查站要拦住赃款",
   "start": 73.283,
   "end": 75.06,
   "id": "c27"
  },
  {
   "text": "也别误伤普通人",
   "start": 75.2,
   "end": 76.525,
   "id": "c28"
  },
  {
   "text": "下一集讲数据与隐私安全",
   "start": 77.504,
   "end": 79.721,
   "id": "c29"
  }
 ]
