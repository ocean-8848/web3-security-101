  {
   "id": "seg6-00",
   "text": "回到开头的题。",
   "spoken": "回到开头的题。",
   "src": "/Users/k/Workon/Learning/web3/web3-security-101/media/video/skeuo/ep23/audio/lines/seg6-00.mp3",
