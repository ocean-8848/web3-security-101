   "text": "独立于链下的提现系统",
   "start": 7.721,
   "end": 9.777,
   "id": "c3"
  },
  {
   "text": "在新的授权覆盖或者清零它之前",
   "start": 10.05,
   "end": 12.91,
   "id": "c4"
  },
  {
   "text": "委托合约照样可以被调用",
   "start": 13.04,
   "end": 15.077,
   "id": "c5"
  },
  {
   "text": "Binance 在 10 月 30 日 0 点 10 分",
   "start": 15.411,
   "end": 19.178,
   "id": "c6"
  },
  {
   "text": "才把委托清零",
   "start": 19.377,
   "end": 20.882,
   "id": "c7"
  },
  {
   "text": "恶意委托在链上",
   "start": 21.225,
   "end": 22.649,
   "id": "c8"
  },
  {
   "text": "存活了约 3 小时 50 分",
   "start": 22.724,
   "end": 24.679,
   "id": "c9"
  },
  {
   "text": "暂停提现",
   "start": 24.95,
   "end": 25.998,
   "id": "c10"
  },
  {
   "text": "不等于撤销权限",
   "start": 26.026,
   "end": 27.467,
   "id": "c11"
  },
  {
   "text": "交易所今天就能做三件事",
   "start": 27.73,
   "end": 29.864,
   "id": "c12"
  },
  {
   "text": "提前写好紧急撤销流程并且演练",
   "start": 30.11,
   "end": 32.93,
   "id": "c13"
  },
  {
   "text": "把链上授权也算进去",
   "start": 33.174,
   "end": 34.927,
   "id": "c14"
  },
  {
   "text": "热钱包设余额上限",
   "start": 35.21,
   "end": 36.969,
   "id": "c15"
  },
  {
   "text": "每条链单独熔断",
   "start": 37.101,
   "end": 38.753,
   "id": "c16"
  },
  {
   "text": "签名策略覆盖全部交易类型",
   "start": 39.03,
   "end": 42.163,
   "id": "c17"
  },
  {
   "text": "包括 EIP-7702 授权",
   "start": 42.183,
   "end": 44.375,
   "id": "c18"
  },
  {
   "text": "普通用户也有几件事",
   "start": 44.61,
   "end": 46.429,
   "id": "c19"
  },
  {
   "text": "充值前 确认交易所支持的代币合约地址和网络",
   "start": 46.766,
   "end": 50.984,
   "id": "c20"
  },
  {
   "text": "开启提币白名单和新地址冷却期",
   "start": 51.305,
   "end": 54.48,
   "id": "c21"
  },
  {
   "text": "提币地址从地址簿里选",
   "start": 54.736,
   "end": 56.91,
   "id": "c22"
  },
  {
   "text": "来源不明的资金不要充进去",
   "start": 57.21,
   "end": 59.315,
   "id": "c23"
  },
  {
   "text": "交易所要你补资料",
   "start": 59.469,
   "end": 60.923,
   "id": "c24"
  },
  {
   "text": "只在官方 App 里处理",
   "start": 60.987,
   "end": 62.716,
   "id": "c25"
  },
  {
   "text": "保管者要让签名只为真实的订单服务",
   "start": 63.106,
   "end": 66.417,
   "id": "c26"
  },
  {
   "text": "检查站要拦住赃款",
   "start": 66.653,
   "end": 68.611,
   "id": "c27"
  },
  {
   "text": "也别误伤普通人",
   "start": 68.675,
   "end": 70.185,
   "id": "c28"
  },
  {
   "text": "下一集讲数据与隐私安全",
   "start": 70.43,
   "end": 73.15,
   "id": "c29"
  }
 ]
}