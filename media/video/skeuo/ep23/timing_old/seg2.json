 "captions": [
  {
   "text": "先给准确的说法",
   "start": 1.55,
   "end": 2.807,
   "id": "c0"
  },
  {
   "text": "交易所同时扮演两个角色",
   "start": 3.05,
   "end": 5.45,
   "id": "c1"
  },
  {
   "text": "一个是保管者",
   "start": 5.766,
   "end": 7.339,
   "id": "c2"
  },
  {
   "text": "替用户保管私钥和资产",
   "start": 7.524,
   "end": 9.771,
   "id": "c3"
  },
  {
   "text": "这叫托管",
   "start": 9.973,
   "end": 11.106,
   "id": "c4"
  },
  {
   "text": "另一个是检查站",
   "start": 11.421,
   "end": 12.902,
   "id": "c5"
  },
  {
   "text": "链上的资金",
   "start": 13.196,
   "end": 14.138,
   "id": "c6"
  },
  {
   "text": "从这里进出法币世界",
   "start": 14.158,
   "end": 16.009,
   "id": "c7"
  },
  {
   "text": "保管者失误",
   "start": 16.27,
   "end": 17.563,
   "id": "c8"
  },
  {
   "text": "用户丢钱",
   "start": 17.772,
   "end": 18.735,
   "id": "c9"
  },
  {
   "text": "检查站失误",
   "start": 18.97,
   "end": 20.106,
   "id": "c10"
  },
  {
   "text": "赃款被洗白",
   "start": 20.305,
   "end": 21.535,
   "id": "c11"
  },
  {
   "text": "交易所自己也要承担法律责任",
   "start": 21.78,
   "end": 24.257,
   "id": "c12"
  },
  {
   "text": "打个比方",
   "start": 24.565,
   "end": 25.265,
   "id": "c13"
  },
  {
   "text": "交易所像一座机场",
   "start": 25.481,
   "end": 27.329,
   "id": "c14"
  },
  {
   "text": "金库是冷钱包 要防盗",
   "start": 27.665,
   "end": 29.884,
   "id": "c15"
  },
  {
   "text": "登机口是提币 要验票",
   "start": 30.285,
   "end": 32.53,
   "id": "c16"
  },
  {
   "text": "入境口是充值",
   "start": 33.112,
   "end": 34.575,
   "id": "c17"
  },
  {
   "text": "要验真伪",
   "start": 34.699,
   "end": 35.602,
   "id": "c18"
  },
  {
   "text": "安检是反洗钱",
   "start": 35.944,
   "end": 37.52,
   "id": "c19"
  },
  {
   "text": "边检是制裁筛查",
   "start": 37.758,
   "end": 39.667,
   "id": "c20"
  },
  {
   "text": "拦住名单上的人",
   "start": 39.865,
   "end": 41.237,
   "id": "c21"
  },
  {
   "text": "比喻在这里不成立",
   "start": 41.608,
   "end": 43.032,
   "id": "c22"
  },
  {
   "text": "机场的旅客",
   "start": 43.269,
   "end": 44.107,
   "id": "c23"
  },
  {
   "text": "走了就走了",
   "start": 44.127,
   "end": 45.194,
   "id": "c24"
  },
  {
   "text": "链上的资金流向永久公开",
   "start": 45.49,
   "end": 47.619,
   "id": "c25"
  },
  {
   "text": "执法机构几年以后",
   "start": 48.02,
   "end": 49.484,
   "id": "c26"
  },
  {
   "text": "还能回头追查每一笔",
   "start": 49.563,
   "end": 51.163,
   "id": "c27"
  },
  {
   "text": "先看保管者这一面",
   "start": 51.39,
   "end": 53.089,
