 "captions": [
  {
   "text": "先看充值这一头",
   "start": 1.55,
   "end": 2.949,
   "id": "c0"
  },
  {
   "text": "假充值 是交易所把一笔不该算数的转账",
   "start": 3.21,
   "end": 7.247,
   "id": "c1"
  },
  {
   "text": "记成了用户的充值",
   "start": 7.471,
   "end": 9.24,
   "id": "c2"
  },
  {
   "text": "失败的 伪造的",
   "start": 9.51,
   "end": 11.255,
   "id": "c3"
  },
  {
   "text": "到账金额不对的 都算",
   "start": 11.382,
   "end": 13.155,
   "id": "c4"
  },
  {
   "text": "第一种 交易失败了",
   "start": 13.509,
   "end": 15.128,
   "id": "c5"
  },
  {
   "text": "却已经上链",
   "start": 15.216,
   "end": 16.508,
   "id": "c6"
  },
  {
   "text": "扫描服务只看交易存不存在",
   "start": 16.75,
   "end": 19.237,
   "id": "c7"
  },
  {
   "text": "不看执行状态",
   "start": 19.568,
   "end": 20.686,
   "id": "c8"
  },
  {
   "text": "2019 年 3 月",
   "start": 21.061,
   "end": 22.199,
   "id": "c9"
  },
  {
   "text": "SlowMist 披露了 EOS 上的这类手法",
   "start": 22.332,
   "end": 25.447,
   "id": "c10"
  },
  {
   "text": "TRON 和以太坊也要防",
   "start": 25.656,
   "end": 27.872,
   "id": "c11"
  },
  {
   "text": "第二种 无效交易被入账",
   "start": 28.243,
   "end": 30.695,
   "id": "c12"
  },
  {
   "text": "2018 年 6 月",
   "start": 31.038,
   "end": 32.328,
   "id": "c13"
  },
  {
   "text": "SlowMist 预警",
   "start": 32.484,
   "end": 33.813,
   "id": "c14"
  },
  {
   "text": "部分交易所没有校验 Omni-USDT",
   "start": 34.031,
   "end": 36.506,
   "id": "c15"
  },
  {
   "text": "交易的 valid 字段",
   "start": 36.526,
   "end": 38.129,
   "id": "c16"
  },
  {
   "text": "第三种 部分支付",
   "start": 38.35,
   "end": 40.165,
   "id": "c17"
  },
  {
   "text": "这是 XRP 的一个特性",
   "start": 40.726,
   "end": 42.391,
   "id": "c18"
  },
  {
   "text": "一笔支付写的请求金额",
   "start": 42.747,
   "end": 44.566,
   "id": "c19"
  },
  {
   "text": "可以远大于实际到账的金额",
   "start": 44.783,
   "end": 47.248,
   "id": "c20"
  },
  {
   "text": "2024 年 1 月",
   "start": 47.51,
   "end": 48.77,
   "id": "c21"
  },
  {
   "text": "有人向 Bitfinex 发起了一笔部分支付",
   "start": 48.907,
   "end": 51.949,
   "id": "c22"
  },
  {
   "text": "名义金额约 150 亿美元",
   "start": 52.302,
   "end": 55.568,
   "id": "c23"
  },
  {
   "text": "实际到账约 0.001 美元",
   "start": 55.769,
   "end": 59.017,
   "id": "c24"
  },
  {
   "text": "Bitfinex 按实际到账金额入账",
   "start": 59.332,
   "end": 62.095,
   "id": "c25"
  },
  {
   "text": "攻击没有成功",
   "start": 62.295,
   "end": 63.426,
   "id": "c26"
  },
  {
   "text": "第四种 假代币",
   "start": 63.69,
   "end": 65.403,
   "id": "c27"
  },
  {
   "text": "名字和符号都能照抄",
   "start": 65.757,
   "end": 67.629,
   "id": "c28"
  },
  {
   "text": "第五种 伪造的转账事件",
   "start": 67.91,
   "end": 70.195,
   "id": "c29"
  },
  {
   "text": "系统只看 Transfer 事件",
   "start": 70.492,
   "end": 72.213,
   "id": "c30"
  },
  {
   "text": "不看它来自哪个合约",
   "start": 72.345,
   "end": 73.939,
   "id": "c31"
  },
  {
   "text": "第六种 确认数不够就入账",
   "start": 74.304,
   "end": 76.691,
   "id": "c32"
  },
  {
   "text": "之后区块回滚",
   "start": 76.88,
   "end": 78.36,
   "id": "c33"
  },
  {
   "text": "这笔充值也跟着消失",
   "start": 78.471,
   "end": 80.225,
   "id": "c34"
  },
  {
   "text": "这些形态",
   "start": 80.606,
   "end": 81.408,
   "id": "c35"
  },
  {
   "text": "可以归成一条原则",
   "start": 81.522,
   "end": 83.283,
   "id": "c36"
  },
  {
   "text": "以链上执行结果和实际到账金额为准",
   "start": 83.53,
   "end": 86.733,
   "id": "c37"
  },
  {
   "text": "入账之前",
   "start": 87.047,
   "end": 87.955,
   "id": "c38"
  },
  {
   "text": "过四道检查",
   "start": 88.112,
   "end": 89.252,
   "id": "c39"
  },
  {
   "text": "执行成功了吗",
   "start": 89.584,
   "end": 90.505,
   "id": "c40"
  },
  {
   "text": "代币合约地址",
   "start": 90.848,
   "end": 91.761,
   "id": "c41"
  },
  {
   "text": "在白名单里吗",
   "start": 91.781,
   "end": 92.883,
   "id": "c42"
  },
  {
   "text": "实际到账多少",
   "start": 93.13,
   "end": 94.512,
   "id": "c43"
  },
  {
   "text": "确认数够了吗",
   "start": 94.79,
   "end": 95.763,
   "id": "c44"
  },
  {
   "text": "最后 用第二个独立节点再复核一遍",
   "start": 95.97,
   "end": 99.279,
   "id": "c45"
  },
  {
   "text": "只靠一个节点",
   "start": 99.55,
   "end": 100.801,
   "id": "c46"
  },
  {
   "text": "节点被篡改或者不同步",
   "start": 101.012,
   "end": 103.155,
   "id": "c47"
  },
  {
   "text": "也会记错账",
   "start": 103.264,
   "end": 104.329,
   "id": "c48"
  },
  {
   "text": "每接入一条新链",
   "start": 104.669,
   "end": 106.026,
   "id": "c49"
  },
  {
   "text": "都要按这条链的交易模型",
   "start": 106.063,
   "end": 108.094,
   "id": "c50"
  },
  {
   "text": "从头设计入账校验",
   "start": 108.204,
   "end": 109.951,
   "id": "c51"
  },
  {
   "text": "不能照搬以太坊的逻辑",
   "start": 110.122,
   "end": 111.991,
   "id": "c52"
  }
 ]
}