   "start": 56.436,
   "dur": 6.552,
   "speechStart": 56.534,
   "speechEnd": 62.153
  },
  {
   "id": "seg4-12",
   "text": "其中一台上，存着容器部署令牌。",
   "spoken": "其中一台上，存着容器部署令牌。",
