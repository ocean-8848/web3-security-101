 "captions": [
  {
   "text": "再看提币这一头",
   "start": 1.648,
   "end": 3.08,
   "id": "c0"
  },
  {
   "text": "最要紧的是签名服务",
   "start": 3.171,
   "end": 5.365,
   "id": "c1"
  },
  {
   "text": "签名服务只认请求的格式对不对",
   "start": 6.356,
   "end": 8.859,
   "id": "c2"
  },
  {
   "text": "攻击者如果能伪造上游数据",
   "start": 9.84,
   "end": 12.105,
   "id": "c3"
  },
  {
   "text": "它就会按正常流程",
   "start": 12.28,
   "end": 13.855,
   "id": "c4"
  },
  {
   "text": "签出攻击交易",
   "start": 13.875,
   "end": 15.141,
   "id": "c5"
  },
  {
   "text": "2026 年 9 月",
   "start": 16.132,
   "end": 17.444,
   "id": "c6"
  },
  {
   "text": "Bitget 被盗约 3.875 亿美元",
   "start": 17.513,
   "end": 20.135,
   "id": "c7"
  },
  {
   "text": "公开报道称",
   "start": 21.128,
   "end": 22.25,
   "id": "c8"
  },
  {
   "text": "攻击者利用第三方安全产品的零日漏洞",
   "start": 22.449,
   "end": 25.417,
   "id": "c9"
  },
  {
   "text": "拿到了内部高权限凭证",
   "start": 25.473,
   "end": 27.381,
   "id": "c10"
  },
  {
   "text": "再向钱包后台",
   "start": 28.38,
   "end": 29.741,
   "id": "c11"
  },
  {
   "text": "插入伪造的提现指令",
   "start": 29.761,
   "end": 31.573,
   "id": "c12"
  },
  {
   "text": "项目方称",
   "start": 32.56,
   "end": 33.575,
   "id": "c13"
  },
  {
   "text": "已经排除了私钥泄露",
   "start": 33.631,
   "end": 35.146,
   "id": "c14"
  },
  {
   "text": "一个月后",
   "start": 36.14,
   "end": 37.0,
   "id": "c15"
  },
  {
   "text": "Binance 出事",
   "start": 37.152,
   "end": 38.322,
   "id": "c16"
  },
  {
   "text": "按它的初步报告",
   "start": 38.342,
   "end": 39.62,
   "id": "c17"
  },
  {
   "text": "路径是这样的",
   "start": 39.64,
   "end": 40.691,
   "id": "c18"
  },
  {
   "text": "6 月 一名工程师下载了被篡改的 Homebrew",
   "start": 41.664,
   "end": 45.679,
   "id": "c19"
  },
  {
   "text": "那一次已被发现并处置",
   "start": 46.66,
   "end": 48.33,
   "id": "c20"
  },
  {
   "text": "报告没有确认之后一直有访问",
   "start": 48.541,
   "end": 50.734,
   "id": "c21"
  },
  {
   "text": "9 月 另一名工程师运行了一份假的面试作业",
   "start": 51.728,
   "end": 55.493,
   "id": "c22"
  },
  {
   "text": "10 月 20 日",
   "start": 56.484,
   "end": 57.618,
   "id": "c23"
  },
  {
   "text": "攻击者经过这台电脑和内部 AI 工具",
   "start": 57.829,
   "end": 60.606,
   "id": "c24"
  },
  {
   "text": "又控制了另外两台电脑",
   "start": 60.626,
   "end": 62.273,
   "id": "c25"
  },
  {
   "text": "其中一台上",
   "start": 63.256,
   "end": 64.414,
   "id": "c26"
  },
  {
   "text": "存着容器部署令牌",
   "start": 64.458,
   "end": 66.104,
   "id": "c27"
  },
  {
   "text": "10 月 29 日",
   "start": 67.1,
   "end": 68.341,
   "id": "c28"
  },
  {
   "text": "攻击者用它部署容器",
   "start": 68.516,
   "end": 70.258,
   "id": "c29"
  },
  {
   "text": "运行恶意脚本",
   "start": 70.373,
   "end": 71.662,
   "id": "c30"
  },
  {
   "text": "访问内部签名服务",
   "start": 71.802,
   "end": 73.436,
   "id": "c31"
  },
  {
   "text": "攻击者不需要私钥",
   "start": 74.424,
   "end": 75.844,
   "id": "c32"
  },
  {
   "text": "它让签名服务替它签",
   "start": 75.936,
   "end": 77.57,
   "id": "c33"
  },
  {
   "text": "以太坊上",
   "start": 78.556,
   "end": 79.464,
   "id": "c34"
  },
  {
   "text": "签出的是 EIP-7702 委托",
   "start": 79.556,
   "end": 82.44,
   "id": "c35"
  },
  {
   "text": "把热钱包账户的代码",
   "start": 82.508,
   "end": 83.976,
   "id": "c36"
  },
  {
   "text": "指向攻击者的合约",
   "start": 83.996,
   "end": 85.392,
   "id": "c37"
  },
  {
   "text": "其他链上",
   "start": 86.384,
   "end": 87.447,
   "id": "c38"
  },
  {
   "text": "就是普通的签名转账",
   "start": 87.467,
   "end": 89.185,
   "id": "c39"
  },
  {
   "text": "决定性的一环",
   "start": 90.18,
   "end": 91.433,
   "id": "c40"
  },
  {
   "text": "是开发终端上的长期部署令牌",
   "start": 91.453,
   "end": 93.945,
   "id": "c41"
  },
  {
   "text": "它把一台电脑失陷",
   "start": 94.936,
   "end": 96.403,
   "id": "c42"
  },
  {
   "text": "变成了生产环境失陷",
   "start": 96.459,
   "end": 98.225,
   "id": "c43"
  },
  {
   "text": "签名流程本身被驱动了",
   "start": 99.212,
   "end": 101.191,
   "id": "c44"
  },
  {
   "text": "冷热隔离和私钥保护",
   "start": 101.295,
   "end": 103.143,
   "id": "c45"
  },
  {
   "text": "都挡不住",
   "start": 103.295,
   "end": 104.036,
   "id": "c46"
  },
  {
   "text": "防线有三条",
   "start": 105.024,
   "end": 106.384,
   "id": "c47"
  },
  {
   "text": "签名服务独立核对",
   "start": 107.356,
   "end": 108.954,
   "id": "c48"
  },
  {
   "text": "目标地址和金额",
   "start": 109.07,
   "end": 110.537,
   "id": "c49"
  },
  {
   "text": "必须对得上账本里的提现订单",
   "start": 110.558,
   "end": 112.645,
   "id": "c50"
  },
  {
   "text": "部署令牌要短期有效",
   "start": 113.624,
   "end": 115.746,
   "id": "c51"
  },
  {
   "text": "绑定设备",
   "start": 115.945,
   "end": 116.901,
   "id": "c52"
  },
  {
   "text": "还要第二个人批准",
   "start": 116.921,
   "end": 118.198,
   "id": "c53"
  },
  {
   "text": "风控引擎和签名服务",
   "start": 119.172,
   "end": 121.223,
   "id": "c54"
  },
  {
   "text": "由不同的团队维护",
   "start": 121.303,
   "end": 122.687,
   "id": "c55"
  },
  {
   "text": "两起事件",
   "start": 123.688,
   "end": 124.727,
   "id": "c56"
  },
  {
   "text": "都还没有最终的第三方调查报告",
   "start": 124.747,
   "end": 127.31,
   "id": "c57"
  }
 ]
