   "speechStart": 1.698,
   "speechEnd": 5.245
  },
  {
   "id": "seg4-01",
   "text": "签名服务只认请求的格式对不对。",
   "spoken": "签名服务只认请求的格式对不对。",
   "src": "/Users/k/Workon/Learning/web3/web3-security-101/media/video/skeuo/ep23/audio/lines/seg4-01.mp3",
   "start": 6.308,
   "dur": 3.264,
   "speechStart": 6.406,
   "speechEnd": 8.739
  },
  {
   "id": "seg4-02",
   "text": "攻击者如果能伪造上游数据，它就会按正常流程，签出攻击交易。",
   "spoken": "攻击者如果能伪造上游数据，它就会按正常流程，签出攻击交易。",
