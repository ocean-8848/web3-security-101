   "start": 36.092,
   "dur": 5.304,
   "speechStart": 36.19,
   "speechEnd": 40.571
  },
  {
   "id": "seg4-08",
   "text": "6 月，一名工程师下载了被篡改的 Homebrew。",
   "spoken": "6 月，一名工程师下载了被篡改的 Homebrew。",
   "src": "/Users/k/Workon/Learning/web3/web3-security-101/media/video/skeuo/ep23/audio/lines/seg4-08.mp3",
   "start": 41.616,
   "dur": 4.776,
   "speechStart": 41.714,
   "speechEnd": 45.559
  },
  {
   "id": "seg4-09",
