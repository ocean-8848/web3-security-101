   "start": 16.084,
   "dur": 4.776,
   "speechStart": 16.182,
   "speechEnd": 20.015
  },
  {
   "id": "seg4-04",
   "text": "公开报道称，攻击者利用第三方安全产品的零日漏洞，拿到了内部高权限凭证。",
   "spoken": "公开报道称，攻击者利用第三方安全产品的零日漏洞，拿到了内部高权限凭证。",
   "src": "/Users/k/Workon/Learning/web3/web3-security-101/media/video/skeuo/ep23/audio/lines/seg4-04.mp3",
   "start": 21.08,
   "dur": 7.032,
   "speechStart": 21.178,
   "speechEnd": 27.261
  },
  {
   "id": "seg4-05",
   "text": "再向钱包后台，插入伪造的提现指令。",
   "spoken": "再向钱包后台，插入伪造的提现指令。",
