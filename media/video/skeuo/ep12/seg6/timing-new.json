 "captions": [
  {
   "text": "每个人 今天能做一件事",
   "start": 1.648,
   "end": 3.77,
   "id": "c0"
  },
  {
   "text": "写桥的人 把源链 目标链",
   "start": 4.748,
   "end": 7.251,
   "id": "c1"
  },
  {
   "text": "两侧合约和序号",
   "start": 7.426,
   "end": 9.013,
   "id": "c2"
  },
  {
   "text": "全部写进消息哈希",
   "start": 9.033,
   "end": 10.56,
   "id": "c3"
  },
  {
   "text": "审计的人",
   "start": 11.544,
   "end": 12.488,
   "id": "c4"
  },
  {
   "text": "列出签名人和运营商",
   "start": 12.508,
   "end": 14.38,
   "id": "c5"
  },
  {
   "text": "算一算攻破几个独立组织",
   "start": 14.508,
   "end": 16.345,
   "id": "c6"
  },
  {
   "text": "就能放行一条伪造消息",
   "start": 16.365,
   "end": 18.095,
   "id": "c7"
  },
  {
   "text": "普通用户",
   "start": 19.084,
   "end": 20.111,
   "id": "c8"
  },
  {
   "text": "跨链前先看这座桥靠什么验证",
   "start": 20.286,
   "end": 22.944,
   "id": "c9"
  },
  {
   "text": "L2BEAT 会列出风险",
   "start": 23.319,
   "end": 25.525,
   "id": "c10"
  },
  {
   "text": "只用官方入口",
   "start": 26.528,
   "end": 27.983,
   "id": "c11"
  },
  {
   "text": "跨链后核对收到的代币合约地址",
   "start": 28.359,
   "end": 31.005,
   "id": "c12"
  },
  {
   "text": "不要长期拿着映射代币",
   "start": 31.132,
   "end": 32.838,
   "id": "c13"
  },
  {
   "text": "回到开头的问题",
   "start": 33.828,
   "end": 35.212,
   "id": "c14"
  },
  {
   "text": "9 个验证者",
   "start": 35.587,
   "end": 36.733,
   "id": "c15"
  },
  {
   "text": "最少要攻破几个组织",
   "start": 36.849,
   "end": 38.412,
   "id": "c16"
  },
  {
   "text": "两个",
   "start": 39.68,
   "end": 40.433,
   "id": "c17"
  },
  {
   "text": "门限是 9 个里要 5 个",
   "start": 40.796,
   "end": 42.454,
   "id": "c18"
  },
  {
   "text": "可签名人并不独立",
   "start": 42.582,
   "end": 43.966,
   "id": "c19"
  },
  {
   "text": "这个答案成立的前提",
   "start": 44.964,
   "end": 46.634,
   "id": "c20"
  },
  {
   "text": "是那项本应撤销的授权仍在生效",
   "start": 46.666,
   "end": 49.431,
   "id": "c21"
  },
  {
   "text": "跨链桥的安全",
   "start": 50.416,
   "end": 51.633,
   "id": "c22"
  },
  {
   "text": "就看 B 链凭什么相信",
   "start": 51.749,
   "end": 53.609,
   "id": "c23"
  },
  {
   "text": "证明机制被骗",
   "start": 53.985,
   "end": 55.274,
   "id": "c24"
  },
  {
   "text": "桥上的钱就会被骗走",
   "start": 55.425,
   "end": 57.381,
   "id": "c25"
  },
  {
   "text": "下一集讲非 EVM 生态的安全",
   "start": 58.364,
