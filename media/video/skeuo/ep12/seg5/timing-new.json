   "end": 6.121,
   "id": "c2"
  },
  {
   "text": "门限要高于三分之二",
   "start": 6.496,
   "end": 8.428,
   "id": "c3"
  },
  {
   "text": "签名人在组织",
   "start": 9.432,
   "end": 10.804,
   "id": "c4"
  },
  {
   "text": "地域和基础设施上都要独立",
   "start": 10.932,
   "end": 13.197,
   "id": "c5"
  },
  {
   "text": "并且定期核对签名权清单",
   "start": 13.396,
   "end": 15.602,
   "id": "c6"
  },
  {
   "text": "再看消息",
   "start": 16.588,
   "end": 17.543,
   "id": "c7"
  },
  {
   "text": "消息里要写明源链 源合约 目标链",
   "start": 17.919,
   "end": 21.172,
   "id": "c8"
  },
  {
   "text": "目标合约和序号",
   "start": 21.3,
   "end": 22.803,
   "id": "c9"
  },
  {
   "text": "目标侧逐项核对",
   "start": 22.859,
   "end": 24.22,
   "id": "c10"
  },
  {
   "text": "处理过的消息要打上标记",
   "start": 25.208,
   "end": 27.473,
   "id": "c11"
  },
  {
   "text": "防止重放",
   "start": 27.624,
   "end": 28.616,
   "id": "c12"
  },
  {
   "text": "证明验证代码要有独立审计和测试向量",
   "start": 29.604,
   "end": 33.476,
   "id": "c13"
  },
  {
   "text": "零值 空数组",
   "start": 33.851,
   "end": 35.724,
   "id": "c14"
  },
  {
   "text": "没初始化的根",
   "start": 35.78,
   "end": 36.985,
   "id": "c15"
  },
  {
   "text": "都不能当作有效证明",
   "start": 37.113,
   "end": 38.64,
   "id": "c16"
  },
  {
   "text": "Merkle 树的叶子和中间节点",
   "start": 39.64,
   "end": 41.893,
   "id": "c17"
  },
  {
   "text": "要用不同的哈希前缀",
   "start": 41.913,
   "end": 43.643,
   "id": "c18"
  },
  {
   "text": "执行消息时",
   "start": 44.636,
   "end": 45.794,
   "id": "c19"
  },
  {
   "text": "目标地址和函数走白名单",
   "start": 45.957,
   "end": 48.198,
   "id": "c20"
  },
  {
   "text": "不许碰特权合约",
   "start": 48.374,
   "end": 49.829,
   "id": "c21"
  },
  {
   "text": "然后是限额",
   "start": 50.808,
   "end": 51.859,
   "id": "c22"
  },
  {
   "text": "单笔和单位时间的提款都有上限",
   "start": 52.234,
   "end": 54.785,
   "id": "c23"
  },
  {
   "text": "超过就进延迟队列",
   "start": 54.936,
   "end": 56.511,
   "id": "c24"
  },
  {
   "text": "监控两侧的总量",
   "start": 57.484,
   "end": 59.011,
   "id": "c25"
  },
  {
   "text": "A 链锁定的",
   "start": 59.386,
   "end": 60.639,
   "id": "c26"
  },
  {
   "text": "要不少于 B 链铸造的",
   "start": 60.66,
   "end": 62.246,
   "id": "c27"
  },
  {
   "text": "对不上 就自动暂停",
   "start": 62.612,
   "end": 64.699,
   "id": "c28"
  },
  {
   "text": "最后是升级",
   "start": 65.696,
   "end": 66.83,
   "id": "c29"
  },
  {
   "text": "桥合约升级必须经过时间锁",
   "start": 67.205,
   "end": 69.649,
   "id": "c30"
  },
  {
   "text": "初始化参数必须审计",
   "start": 69.705,
   "end": 71.554,
   "id": "c31"
  },
  {
   "text": "同样的问题",
   "start": 72.54,
   "end": 73.627,
   "id": "c32"
  },
  {
   "text": "也出现在交易所的充值系统里",
   "start": 73.647,
   "end": 76.043,
   "id": "c33"
  },
  {
   "text": "交易所相信链上发生了一笔转账",
   "start": 77.032,
   "end": 79.642,
   "id": "c34"
  },
  {
   "text": "然后在内部账本上记账",
   "start": 79.829,
   "end": 81.571,
   "id": "c35"
  },
  {
   "text": "这也是一座桥",
   "start": 81.946,
   "end": 83.199,
   "id": "c36"
  },
  {
   "text": "假币合约会发出同名的转账事件",
   "start": 84.188,
   "end": 87.203,
   "id": "c37"
  },
  {
   "text": "所以要核对代币合约地址",
   "start": 87.578,
   "end": 89.998,
   "id": "c38"
  },
  {
   "text": "不看名称和符号",
   "start": 90.102,
   "end": 91.593,
   "id": "c39"
  },
  {
   "text": "在 TRON 上",
   "start": 92.592,
   "end": 93.524,
   "id": "c40"
  },
  {
   "text": "转账失败的交易",
   "start": 93.627,
   "end": 94.964,
   "id": "c41"
  },
  {
   "text": "比如能量不足",
   "start": 95.056,
   "end": 96.309,
   "id": "c42"
  },
  {
   "text": "仍然会上链",
   "start": 96.401,
   "end": 97.5,
   "id": "c43"
  },
  {
   "text": "也有交易哈希",
   "start": 97.556,
   "end": 98.631,
   "id": "c44"
  },
  {
   "text": "只看交易存在就入账",
   "start": 99.628,
   "end": 101.44,
   "id": "c45"
  },
  {
   "text": "就会出现假充值",
   "start": 101.461,
   "end": 103.024,
   "id": "c46"
  },
  {
   "text": "要先确认回执状态是成功",
   "start": 103.399,
   "end": 105.724,
   "id": "c47"
  },
  {
   "text": "再看事件",
   "start": 105.851,
   "end": 106.688,
   "id": "c48"
  },
  {
   "text": "同一笔交易",
   "start": 107.672,
   "end": 108.663,
   "id": "c49"
  },
  {
   "text": "用交易哈希加日志序号做幂等键",
   "start": 108.767,
   "end": 111.58,
   "id": "c50"
  },
  {
   "text": "防止重复入账",
   "start": 111.648,
   "end": 113.044,
   "id": "c51"
  },
  {
   "text": "入账前等够确认数",
   "start": 114.036,
   "end": 115.729,
   "id": "c52"
  },
  {
   "text": "防止源链重组把这笔交易抹掉",
   "start": 115.881,
   "end": 118.289,
   "id": "c53"
  }
 ]
}