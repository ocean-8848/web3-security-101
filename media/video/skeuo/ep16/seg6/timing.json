 "captions": [
  {
   "text": "按角色 各做一件事",
   "start": 1.644,
   "end": 3.635,
   "id": "c0"
  },
  {
   "text": "交易所 每条链单独定入账条件",
   "start": 3.93,
   "end": 7.242,
   "id": "c1"
  },
  {
   "text": "以太坊看 finalized 标签",
   "start": 7.52,
   "end": 9.675,
   "id": "c2"
  },
  {
   "text": "PoW 小链按租算力的成本定确认数",
   "start": 9.708,
   "end": 13.557,
   "id": "c3"
  },
  {
   "text": "区分两种状态",
   "start": 13.81,
   "end": 15.212,
   "id": "c4"
  },
  {
   "text": "继续出块但不最终确定",
   "start": 15.489,
   "end": 17.635,
   "id": "c5"
  },
  {
   "text": "和完全停止",
   "start": 17.795,
   "end": 19.143,
   "id": "c6"
  },
  {
   "text": "最终性延迟或出块间隔超过阈值",
   "start": 19.39,
   "end": 22.669,
   "id": "c7"
  },
  {
   "text": "自动暂停充提",
   "start": 22.9,
   "end": 24.163,
   "id": "c8"
  },
  {
   "text": "恢复后逐笔对账",
   "start": 24.321,
   "end": 25.65,
   "id": "c9"
  },
  {
   "text": "运营节点的",
   "start": 25.93,
   "end": 27.076,
   "id": "c10"
  },
  {
   "text": "至少运行两种客户端",
   "start": 27.15,
   "end": 28.941,
   "id": "c11"
  },
  {
   "text": "交叉核对",
   "start": 28.961,
   "end": 29.866,
   "id": "c12"
  },
  {
   "text": "普通用户",
   "start": 30.15,
   "end": 31.065,
   "id": "c13"
  },
  {
   "text": "交易所显示等待确认时 耐心等",
   "start": 31.329,
   "end": 34.176,
   "id": "c14"
  },
  {
   "text": "链停摆时",
   "start": 34.541,
   "end": 35.546,
   "id": "c15"
  },
  {
   "text": "不要反复提交交易",
   "start": 35.7,
   "end": 37.16,
   "id": "c16"
  },
  {
   "text": "恢复后先查状态",
   "start": 37.357,
   "end": 38.768,
   "id": "c17"
  },
  {
   "text": "回到开头的问题",
   "start": 39.07,
   "end": 40.392,
   "id": "c18"
  },
  {
   "text": "同样的 bug 出在超过三分之一的客户端上",
   "start": 40.665,
   "end": 43.884,
   "id": "c19"
  },
  {
   "text": "检查点不再最终确定",
   "start": 44.171,
   "end": 46.047,
   "id": "c20"
  },
  {
   "text": "链照样出块",
   "start": 46.401,
   "end": 47.515,
   "id": "c21"
  },
  {
   "text": "N 个区块的条件照样满足",
   "start": 47.607,
   "end": 49.604,
   "id": "c22"
  },
  {
   "text": "系统继续入账",
   "start": 49.624,
   "end": 51.071,
   "id": "c23"
  },
  {
   "text": "只有看 finalized 标签",
   "start": 51.428,
   "end": 53.25,
   "id": "c24"
  },
  {
   "text": "监控最终性延迟的系统",
   "start": 53.39,
   "end": 55.252,
   "id": "c25"
  },
  {
   "text": "才会停下",
   "start": 55.272,
   "end": 56.064,
   "id": "c26"
  },
  {
   "text": "已确认只是一个赌注",
   "start": 56.445,
   "end": 58.157,
   "id": "c27"
  },
  {
   "text": "先问攻击者控制了什么",
   "start": 58.265,
   "end": 60.063,
   "id": "c28"
  },
  {
   "text": "再定防线",
   "start": 60.267,
   "end": 61.108,
   "id": "c29"
  },
  {
   "text": "下一集讲节点",
   "start": 61.37,
   "end": 63.092,
   "id": "c30"
  },
  {
   "text": "RPC 与验证者基础设施的安全",
   "start": 63.17,
   "end": 66.079,
   "id": "c31"
  }
 ]
