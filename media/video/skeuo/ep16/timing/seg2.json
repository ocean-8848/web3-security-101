   "dur": 3.456,
   "speechStart": 63.05,
   "speechEnd": 65.573
  },
  {
   "id": "seg2-15",
   "text": "身份和连接、算力、单个区块的时机。",
   "spoken": "身份和连接、算力、单个区块的时机。",
   "src": "/Users/k/Workon/Learning/web3/web3-security-101/media/video/skeuo/ep16/audio/lines/seg2-15.mp3",
   "start": 66.628,
   "dur": 4.2,
   "speechStart": 66.726,
   "speechEnd": 69.988
  },
  {
   "id": "seg2-16",
   "text": "权益或旧私钥、别人的动机，以及让链停下的份额。",
   "spoken": "权益或旧私钥、别人的动机，以及让链停下的份额。",
