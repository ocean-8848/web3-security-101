 "captions": [
  {
   "text": "先给准确的说法",
   "start": 1.648,
   "end": 3.103,
   "id": "c0"
  },
  {
   "text": "共识 是网络里的节点",
   "start": 4.1,
   "end": 6.234,
   "id": "c1"
  },
  {
   "text": "就哪条链是正确的",
   "start": 6.326,
   "end": 7.758,
   "id": "c2"
  },
  {
   "text": "达成一致的机制",
   "start": 7.778,
   "end": 9.115,
   "id": "c3"
  },
  {
   "text": "重组 是节点放弃已经接受的几个区块",
   "start": 10.104,
   "end": 13.464,
   "id": "c4"
  },
  {
   "text": "改为接受另一条链",
   "start": 13.496,
   "end": 14.964,
   "id": "c5"
  },
  {
   "text": "已经确认的交易",
   "start": 15.94,
   "end": 17.265,
   "id": "c6"
  },
  {
   "text": "会在重组里消失",
   "start": 17.285,
   "end": 18.717,
   "id": "c7"
  },
  {
   "text": "所以交易所说的已确认",
   "start": 19.712,
   "end": 21.905,
   "id": "c8"
  },
  {
   "text": "只是对这条链安全假设的一个赌注",
   "start": 21.985,
   "end": 24.263,
   "id": "c9"
  },
  {
   "text": "打个比方",
   "start": 25.26,
   "end": 26.215,
   "id": "c10"
  },
  {
   "text": "一个城市的公证处",
   "start": 27.352,
   "end": 28.879,
   "id": "c11"
  },
  {
   "text": "靠多数公证员签字",
   "start": 28.911,
   "end": 30.974,
   "id": "c12"
  },
  {
   "text": "确认房产交易",
   "start": 31.078,
   "end": 32.391,
   "id": "c13"
  },
  {
   "text": "如果有人临时雇来半数以上的公证员",
   "start": 33.38,
   "end": 35.954,
   "id": "c14"
  },
  {
   "text": "他可以让一份盖过章的合同作废",
   "start": 36.936,
   "end": 39.153,
   "id": "c15"
  },
  {
   "text": "再把同一套房卖给另一个人",
   "start": 39.328,
   "end": 41.439,
   "id": "c16"
  },
  {
   "text": "这就是双花",
   "start": 42.436,
   "end": 43.582,
   "id": "c17"
  },
  {
   "text": "同一笔资产被花两次",
   "start": 43.662,
   "end": 45.677,
   "id": "c18"
  },
  {
   "text": "比喻不成立的地方是",
   "start": 46.664,
   "end": 48.226,
   "id": "c19"
  },
  {
   "text": "现实里雇公证员要花很多年",
   "start": 48.414,
   "end": 51.095,
   "id": "c20"
  },
  {
   "text": "在小算力的 PoW 链上",
   "start": 52.068,
   "end": 53.607,
   "id": "c21"
  },
  {
   "text": "算力可以按小时租",
   "start": 53.699,
   "end": 55.309,
   "id": "c22"
  },
  {
   "text": "很多人把所有共识攻击",
   "start": 56.296,
   "end": 58.061,
   "id": "c23"
  },
  {
   "text": "都叫 51% 攻击",
   "start": 58.081,
   "end": 59.704,
   "id": "c24"
  },
  {
   "text": "这会选错防线",
   "start": 60.692,
   "end": 62.004,
   "id": "c25"
  },
  {
   "text": "更好的问法是",
   "start": 63.0,
   "end": 64.193,
   "id": "c26"
  },
  {
   "text": "攻击者控制了什么",
   "start": 64.357,
   "end": 65.693,
   "id": "c27"
  },
  {
   "text": "身份和连接 算力",
   "start": 66.676,
   "end": 68.81,
   "id": "c28"
  },
  {
   "text": "单个区块的时机",
   "start": 68.83,
   "end": 70.108,
   "id": "c29"
  },
  {
   "text": "权益或旧私钥",
   "start": 71.096,
   "end": 72.516,
   "id": "c30"
  },
  {
   "text": "别人的动机",
   "start": 72.584,
   "end": 73.528,
   "id": "c31"
  },
  {
   "text": "以及让链停下的份额",
   "start": 73.619,
   "end": 75.087,
   "id": "c32"
  },
  {
   "text": "控制的资源不同",
   "start": 76.068,
   "end": 77.511,
   "id": "c33"
  },
  {
   "text": "防线就不同",
   "start": 77.663,
   "end": 78.785,
   "id": "c34"
  }
 ]
