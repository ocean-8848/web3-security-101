 "captions": [
  {
   "text": "再看以太坊这样的 PoS 链",
   "start": 1.55,
   "end": 3.946,
   "id": "c0"
  },
  {
   "text": "它要求三分之二的质押投票",
   "start": 4.17,
   "end": 6.722,
   "id": "c1"
  },
  {
   "text": "才能让一个检查点最终确定",
   "start": 6.742,
   "end": 8.998,
   "id": "c2"
  },
  {
   "text": "最终确定以后",
   "start": 9.27,
   "end": 10.374,
   "id": "c3"
  },
  {
   "text": "区块不能回滚",
   "start": 10.526,
   "end": 11.85,
   "id": "c4"
  },
  {
   "text": "除非三分之一的质押被罚没",
   "start": 11.984,
   "end": 14.17,
   "id": "c5"
  },
  {
   "text": "bug 让大量验证者掉线",
   "start": 14.551,
   "end": 16.477,
   "id": "c6"
  },
  {
   "text": "链继续出块",
   "start": 16.617,
   "end": 17.686,
   "id": "c7"
  },
  {
   "text": "但检查点不再最终确定",
   "start": 17.92,
   "end": 19.979,
   "id": "c8"
  },
  {
   "text": "某个客户端占比超过三分之一",
   "start": 20.371,
   "end": 22.609,
   "id": "c9"
  },
  {
   "text": "它的 bug 就能让最终性停下",
   "start": 22.789,
   "end": 25.039,
   "id": "c10"
  },
  {
   "text": "超过三分之二",
   "start": 25.29,
   "end": 26.807,
   "id": "c11"
  },
  {
   "text": "它的 bug 可能把错误的链最终确定",
   "start": 27.056,
   "end": 30.194,
   "id": "c12"
  },
  {
   "text": "所以客户端多样性",
   "start": 30.47,
   "end": 32.19,
   "id": "c13"
  },
  {
   "text": "也是共识安全的一部分",
   "start": 32.268,
   "end": 34.055,
   "id": "c14"
  },
  {
   "text": "2023 年 5 月",
   "start": 34.397,
   "end": 35.568,
   "id": "c15"
  },
  {
   "text": "Prysm 和 Teku 处理旧投票时负载过高",
   "start": 35.793,
   "end": 39.336,
   "id": "c16"
  },
  {
   "text": "主网先后约 25 分钟和约 1 小时",
   "start": 39.722,
   "end": 43.013,
   "id": "c17"
  },
  {
   "text": "没有最终确定",
   "start": 43.033,
   "end": 44.076,
   "id": "c18"
  },
  {
   "text": "Lighthouse 没受影响",
   "start": 44.432,
   "end": 45.782,
   "id": "c19"
  },
  {
   "text": "这次没有资金损失",
   "start": 46.016,
   "end": 47.46,
   "id": "c20"
  },
  {
   "text": "按攻击者的质押份额看",
   "start": 47.849,
   "end": 49.865,
   "id": "c21"
  },
  {
   "text": "有四条线",
   "start": 50.125,
   "end": 50.926,
   "id": "c22"
  },
  {
   "text": "约 33%",
   "start": 51.263,
   "end": 52.484,
   "id": "c23"
  },
  {
   "text": "能阻止最终性",
   "start": 52.987,
   "end": 54.295,
   "id": "c24"
  },
  {
   "text": "代价是不活跃惩罚",
   "start": 54.536,
   "end": 56.285,
   "id": "c25"
  },
  {
   "text": "逐步削减他的质押",
   "start": 56.673,
   "end": 58.077,
   "id": "c26"
  },
  {
   "text": "约 34%",
   "start": 58.444,
   "end": 59.781,
   "id": "c27"
  },
  {
   "text": "在能控制消息时序时",
   "start": 60.467,
   "end": 62.262,
   "id": "c28"
  },
  {
   "text": "造成双重最终性",
   "start": 62.461,
   "end": 64.116,
   "id": "c29"
  },
  {
   "text": "会被最大比例罚没",
   "start": 64.269,
   "end": 65.683,
   "id": "c30"
  },
  {
   "text": "约 51%",
   "start": 66.023,
   "end": 67.281,
   "id": "c31"
  },
  {
   "text": "能主导分叉选择",
   "start": 67.35,
   "end": 68.916,
   "id": "c32"
  },
  {
   "text": "审查交易",
   "start": 69.009,
   "end": 69.873,
   "id": "c33"
  },
  {
   "text": "做短程重组",
   "start": 69.991,
   "end": 71.276,
   "id": "c34"
  },
  {
   "text": "约 66%",
   "start": 71.611,
   "end": 72.743,
   "id": "c35"
  },
  {
   "text": "能在没有诚实方配合时",
   "start": 73.359,
   "end": 75.245,
   "id": "c36"
  },
  {
   "text": "最终确定自己的链",
   "start": 75.384,
   "end": 77.152,
   "id": "c37"
  },
  {
   "text": "只能靠社会层恢复",
   "start": 77.318,
   "end": 79.112,
   "id": "c38"
  },
  {
   "text": "另一种攻击",
   "start": 79.503,
   "end": 80.524,
   "id": "c39"
  },
  {
   "text": "用的是旧私钥",
   "start": 80.623,
   "end": 81.912,
   "id": "c40"
  },
  {
   "text": "已经退出的验证者",
   "start": 82.289,
   "end": 83.855,
   "id": "c41"
  },
  {
   "text": "取回了质押",
   "start": 83.949,
   "end": 85.004,
   "id": "c42"
  },
  {
   "text": "不会再被罚没",
   "start": 85.238,
   "end": 86.396,
   "id": "c43"
  },
  {
   "text": "攻击者买下他们的旧私钥",
   "start": 86.745,
   "end": 88.881,
   "id": "c44"
  },
  {
   "text": "从很久以前分叉",
   "start": 89.211,
   "end": 90.968,
   "id": "c45"
  },
  {
   "text": "改写一段历史",
   "start": 91.248,
   "end": 92.597,
   "id": "c46"
  },
  {
   "text": "一直在线的节点不会接受",
   "start": 92.963,
   "end": 94.977,
   "id": "c47"
  },
  {
   "text": "它不回滚已经最终确定的区块",
   "start": 95.29,
   "end": 97.932,
   "id": "c48"
  },
  {
   "text": "刚安装的新节点",
   "start": 98.308,
   "end": 99.73,
   "id": "c49"
  },
  {
   "text": "要从一个可信的近期检查点开始同步",
   "start": 99.91,
   "end": 103.111,
   "id": "c50"
  },
  {
   "text": "这叫弱主观性",
   "start": 103.39,
   "end": 104.923,
   "id": "c51"
  },
  {
   "text": "检查点的来源",
   "start": 105.168,
   "end": 106.312,
   "id": "c52"
  },
  {
   "text": "就是新节点的信任入口",
   "start": 106.332,
   "end": 108.513,
   "id": "c53"
  },
  {
   "text": "所以检查点要取自至少两个独立来源",
   "start": 108.81,
   "end": 112.522,
   "id": "c54"
  },
  {
   "text": "再做比对",
   "start": 112.542,
   "end": 113.333,
   "id": "c55"
  }
 ]
