 "captions": [
  {
   "text": "再看以太坊这样的 PoS 链",
   "start": 1.648,
   "end": 3.508,
   "id": "c0"
  },
  {
   "text": "它要求三分之二的质押投票",
   "start": 4.484,
   "end": 6.606,
   "id": "c1"
  },
  {
   "text": "才能让一个检查点最终确定",
   "start": 6.71,
   "end": 8.915,
   "id": "c2"
  },
  {
   "text": "最终确定以后",
   "start": 9.912,
   "end": 11.129,
   "id": "c3"
  },
  {
   "text": "区块不能回滚",
   "start": 11.174,
   "end": 12.427,
   "id": "c4"
  },
  {
   "text": "除非三分之一的质押被罚没",
   "start": 12.507,
   "end": 14.498,
   "id": "c5"
  },
  {
   "text": "bug 让大量验证者掉线",
   "start": 15.46,
   "end": 17.439,
   "id": "c6"
  },
  {
   "text": "链继续出块",
   "start": 17.555,
   "end": 18.665,
   "id": "c7"
  },
  {
   "text": "但检查点不再最终确定",
   "start": 18.781,
   "end": 20.534,
   "id": "c8"
  },
  {
   "text": "某个客户端占比超过三分之一",
   "start": 21.512,
   "end": 23.967,
   "id": "c9"
  },
  {
   "text": "它的 bug 就能让最终性停下",
   "start": 24.226,
   "end": 26.432,
   "id": "c10"
  },
  {
   "text": "超过三分之二",
   "start": 27.42,
   "end": 28.554,
   "id": "c11"
  },
  {
   "text": "它的 bug 可能把错误的链最终确定",
   "start": 28.729,
   "end": 31.352,
   "id": "c12"
  },
  {
   "text": "所以客户端多样性",
   "start": 32.344,
   "end": 34.288,
   "id": "c13"
  },
  {
   "text": "也是共识安全的一部分",
   "start": 34.308,
   "end": 35.954,
   "id": "c14"
  },
  {
   "text": "2023 年 5 月",
   "start": 36.956,
   "end": 38.245,
   "id": "c15"
  },
  {
   "text": "Prysm 和 Teku 处理旧投票时负载过高",
   "start": 38.36,
   "end": 42.185,
   "id": "c16"
  },
  {
   "text": "主网先后约 25 分钟和约 1 小时",
   "start": 43.176,
   "end": 46.096,
   "id": "c17"
  },
  {
   "text": "没有最终确定",
   "start": 46.116,
   "end": 47.179,
   "id": "c18"
  },
  {
   "text": "Lighthouse 没受影响",
   "start": 48.172,
   "end": 49.901,
   "id": "c19"
  },
  {
   "text": "这次没有资金损失",
   "start": 49.993,
   "end": 51.437,
   "id": "c20"
  },
  {
   "text": "按攻击者的质押份额看",
   "start": 52.424,
   "end": 54.248,
   "id": "c21"
  },
  {
   "text": "有四条线",
   "start": 54.436,
   "end": 55.415,
   "id": "c22"
  },
  {
   "text": "约 33%",
   "start": 56.388,
   "end": 57.76,
   "id": "c23"
  },
  {
   "text": "能阻止最终性",
   "start": 57.888,
   "end": 59.284,
   "id": "c24"
  },
  {
   "text": "代价是不活跃惩罚",
   "start": 59.423,
   "end": 61.01,
   "id": "c25"
  },
  {
   "text": "逐步削减他的质押",
   "start": 61.09,
   "end": 62.641,
   "id": "c26"
  },
  {
   "text": "约 34%",
   "start": 63.64,
   "end": 64.964,
   "id": "c27"
  },
  {
   "text": "在能控制消息时序时",
   "start": 65.056,
   "end": 66.75,
   "id": "c28"
  },
  {
   "text": "造成双重最终性",
   "start": 66.771,
   "end": 68.31,
   "id": "c29"
  },
  {
   "text": "会被最大比例罚没",
   "start": 68.342,
   "end": 69.738,
   "id": "c30"
  },
  {
   "text": "约 51%",
   "start": 70.7,
   "end": 71.905,
   "id": "c31"
  },
  {
   "text": "能主导分叉选择",
   "start": 72.069,
   "end": 73.548,
   "id": "c32"
  },
  {
   "text": "审查交易",
   "start": 73.64,
   "end": 74.643,
   "id": "c33"
  },
  {
   "text": "做短程重组",
   "start": 74.759,
   "end": 75.929,
   "id": "c34"
  },
  {
   "text": "约 66%",
   "start": 76.896,
   "end": 78.149,
   "id": "c35"
  },
  {
   "text": "能在没有诚实方配合时",
   "start": 78.372,
   "end": 80.149,
   "id": "c36"
  },
  {
   "text": "最终确定自己的链",
   "start": 80.217,
   "end": 81.578,
   "id": "c37"
  },
  {
   "text": "只能靠社会层恢复",
   "start": 81.61,
   "end": 83.089,
   "id": "c38"
  },
  {
   "text": "另一种攻击",
   "start": 84.076,
   "end": 85.15,
   "id": "c39"
  },
  {
   "text": "用的是旧私钥",
   "start": 85.278,
   "end": 86.412,
   "id": "c40"
  },
  {
   "text": "已经退出的验证者",
   "start": 87.392,
   "end": 88.931,
   "id": "c41"
  },
  {
   "text": "取回了质押",
   "start": 89.011,
   "end": 90.097,
   "id": "c42"
  },
  {
   "text": "不会再被罚没",
   "start": 90.261,
   "end": 91.371,
   "id": "c43"
  },
  {
   "text": "攻击者买下他们的旧私钥",
   "start": 92.34,
   "end": 94.248,
   "id": "c44"
  },
  {
   "text": "从很久以前分叉",
   "start": 94.352,
   "end": 95.771,
   "id": "c45"
  },
  {
   "text": "改写一段历史",
   "start": 95.828,
   "end": 96.974,
   "id": "c46"
  },
  {
   "text": "一直在线的节点不会接受",
   "start": 97.96,
   "end": 99.772,
   "id": "c47"
  },
  {
   "text": "它不回滚已经最终确定的区块",
   "start": 99.995,
   "end": 102.427,
   "id": "c48"
  },
  {
   "text": "刚安装的新节点",
   "start": 103.412,
   "end": 104.736,
   "id": "c49"
  },
  {
   "text": "要从一个可信的近期检查点开始同步",
   "start": 104.852,
   "end": 107.796,
   "id": "c50"
  },
  {
   "text": "这叫弱主观性",
   "start": 108.792,
   "end": 110.176,
   "id": "c51"
  },
  {
   "text": "检查点的来源",
   "start": 110.256,
   "end": 111.45,
   "id": "c52"
  },
  {
   "text": "就是新节点的信任入口",
   "start": 111.47,
   "end": 113.438,
   "id": "c53"
  },
  {
   "text": "所以检查点要取自至少两个独立来源",
   "start": 114.436,
   "end": 117.963,
   "id": "c54"
  },
  {
   "text": "再做比对",
   "start": 118.007,
   "end": 118.891,
   "id": "c55"
  }
 ]
}