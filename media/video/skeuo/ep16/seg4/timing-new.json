   "start": 87.344,
   "dur": 4.728,
   "speechStart": 87.442,
   "speechEnd": 91.251
  },
  {
   "id": "seg4-17",
   "text": "攻击者买下他们的旧私钥，从很久以前分叉，改写一段历史。",
   "spoken": "攻击者买下他们的旧私钥，从很久以前分岔，改写一段历史。",
   "src": "/Users/k/Workon/Learning/web3/web3-security-101/media/video/skeuo/ep16/audio/lines/seg4-17.mp3",
   "start": 92.292,
   "dur": 5.4,
   "speechStart": 92.39,
   "speechEnd": 96.854
  },
  {
   "id": "seg4-18",
   "text": "一直在线的节点不会接受，它不回滚已经最终确定的区块。",
   "spoken": "一直在线的节点不会接受，它不回滚已经最终确定的区块。",
