 "captions": [
  {
   "text": "2025 年 12 月 4 日",
   "start": 1.652,
   "end": 3.854,
   "id": "c0"
  },
  {
   "text": "以太坊主网刚完成 Fusaka 升级",
   "start": 3.979,
   "end": 6.893,
   "id": "c1"
  },
  {
   "text": "上线约 5 小时后",
   "start": 7.13,
   "end": 8.759,
   "id": "c2"
  },
  {
   "text": "Prysm 客户端的一个 bug 在主网触发",
   "start": 8.962,
   "end": 11.726,
   "id": "c3"
  },
  {
   "text": "全网投票参与率",
   "start": 11.99,
   "end": 13.581,
   "id": "c4"
  },
  {
   "text": "跌到约 75%",
   "start": 13.735,
   "end": 15.451,
   "id": "c5"
  },
  {
   "text": "18.5% 的 slot 没有出块",
   "start": 15.825,
   "end": 18.319,
   "id": "c6"
  },
  {
   "text": "验证者少拿约 382 ETH 奖励",
   "start": 18.69,
   "end": 22.653,
   "id": "c7"
  },
  {
   "text": "链一直在出块",
   "start": 22.89,
   "end": 24.483,
   "id": "c8"
  },
  {
   "text": "参与率也仍然高于三分之二",
   "start": 24.724,
   "end": 27.353,
   "id": "c9"
  },
  {
   "text": "先猜一道题",
   "start": 27.59,
   "end": 28.54,
   "id": "c10"
  },
  {
   "text": "如果同样的 bug",
   "start": 28.863,
   "end": 30.346,
   "id": "c11"
  },
  {
   "text": "出在占比超过三分之一的客户端上",
   "start": 30.687,
   "end": 33.675,
   "id": "c12"
  },
  {
   "text": "只按 N 个区块入账的交易所",
   "start": 33.968,
   "end": 36.427,
   "id": "c13"
  },
  {
   "text": "会看到什么",
   "start": 36.478,
   "end": 37.334,
   "id": "c14"
  },
  {
   "text": "先记住这个问题",
   "start": 37.89,
   "end": 39.051,
   "id": "c15"
  },
  {
   "text": "链本身出问题时",
   "start": 39.401,
   "end": 41.047,
   "id": "c16"
  },
  {
   "text": "第一步不是看区块数",
   "start": 41.241,
   "end": 43.09,
   "id": "c17"
  },
  {
   "text": "而是先问",
   "start": 43.464,
   "end": 44.219,
   "id": "c18"
  },
  {
   "text": "攻击者或者故障",
   "start": 44.405,
   "end": 46.321,
   "id": "c19"
  },
  {
   "text": "控制了什么",
   "start": 46.471,
   "end": 47.466,
   "id": "c20"
  }
 ]
}