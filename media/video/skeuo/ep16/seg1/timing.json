 "lines": [
  {
   "id": "seg1-00",
   "text": "2025 年 12 月 4 日，以太坊主网刚完成 Fusaka 升级。",
   "spoken": "2025 年 12 月 4 日，以太坊主网刚完成 Fusaka 升级。",
   "src": "/Users/k/Workon/Learning/web3/web3-security-101/media/video/skeuo/ep16/audio/lines/seg1-00.wav",
   "start": 1.6,
   "dur": 5.36,
   "speechStart": 1.702,
   "speechEnd": 6.773
  },
  {
   "id": "seg1-01",
   "text": "上线约 5 小时后，Prysm 客户端的一个 bug 在主网触发。",
   "spoken": "上线约 5 小时后，Prysm 客户端的一个 bug 在主网触发。",
   "src": "/Users/k/Workon/Learning/web3/web3-security-101/media/video/skeuo/ep16/audio/lines/seg1-01.wav",
   "start": 7.18,
   "dur": 4.64,
   "speechStart": 7.18,
   "speechEnd": 11.606
  },
  {
   "id": "seg1-02",
   "text": "全网投票参与率，跌到约 75%。",
   "spoken": "全网投票参与率，跌到约百分之 75。",
   "src": "/Users/k/Workon/Learning/web3/web3-security-101/media/video/skeuo/ep16/audio/lines/seg1-02.wav",
   "start": 12.04,
   "dur": 3.52,
   "speechStart": 12.04,
   "speechEnd": 15.331
  },
  {
   "id": "seg1-03",
   "text": "18.5% 的 slot 没有出块。",
   "spoken": "百分之 18.5 的 slot 没有出块。",
   "src": "/Users/k/Workon/Learning/web3/web3-security-101/media/video/skeuo/ep16/audio/lines/seg1-03.wav",
   "start": 15.78,
   "dur": 2.64,
   "speechStart": 15.875,
   "speechEnd": 18.199
  },
  {
   "id": "seg1-04",
   "text": "验证者少拿约 382 ETH 奖励。",
   "spoken": "验证者少拿约 382 ETH 奖励。",
   "src": "/Users/k/Workon/Learning/web3/web3-security-101/media/video/skeuo/ep16/audio/lines/seg1-04.wav",
   "start": 18.64,
   "dur": 4.08,
   "speechStart": 18.74,
   "speechEnd": 22.533
  },
  {
   "id": "seg1-05",
   "text": "链一直在出块，参与率也仍然高于三分之二。",
   "spoken": "链一直在出块，参与率也仍然高于三分之二。",
   "src": "/Users/k/Workon/Learning/web3/web3-security-101/media/video/skeuo/ep16/audio/lines/seg1-05.wav",
   "start": 22.94,
   "dur": 4.48,
   "speechStart": 22.94,
   "speechEnd": 27.233
  },
  {
   "id": "seg1-06",
   "text": "先猜一道题。",
   "spoken": "先猜一道题。",
   "src": "/Users/k/Workon/Learning/web3/web3-security-101/media/video/skeuo/ep16/audio/lines/seg1-06.wav",
   "start": 27.64,
   "dur": 0.96,
   "speechStart": 27.64,
   "speechEnd": 28.42
  },
  {
   "id": "seg1-07",
   "text": "如果同样的 bug，出在占比超过三分之一的客户端上。",
   "spoken": "如果同样的 bug，出在占比超过三分之一的客户端上。",
   "src": "/Users/k/Workon/Learning/web3/web3-security-101/media/video/skeuo/ep16/audio/lines/seg1-07.wav",
   "start": 28.82,
   "dur": 4.88,
   "speechStart": 28.913,
   "speechEnd": 33.555
  },
  {
   "id": "seg1-08",
   "text": "只按 N 个区块入账的交易所，会看到什么？",
   "spoken": "只按 N 个区块入账的交易所，会看到什么？",
   "src": "/Users/k/Workon/Learning/web3/web3-security-101/media/video/skeuo/ep16/audio/lines/seg1-08.wav",
   "start": 33.92,
   "dur": 3.52,
   "speechStart": 34.018,
   "speechEnd": 37.214
  },
  {
   "id": "seg1-09",
   "text": "先记住这个问题。",
   "spoken": "先记住这个问题。",
   "src": "/Users/k/Workon/Learning/web3/web3-security-101/media/video/skeuo/ep16/audio/lines/seg1-09.wav",
   "start": 37.94,
   "dur": 1.2,
   "speechStart": 37.94,
   "speechEnd": 38.931
  },
  {
   "id": "seg1-10",
   "text": "链本身出问题时，第一步不是看区块数。",
   "spoken": "链本身出问题时，第一步不是看区块数。",
   "src": "/Users/k/Workon/Learning/web3/web3-security-101/media/video/skeuo/ep16/audio/lines/seg1-10.wav",
   "start": 39.36,
   "dur": 3.84,
   "speechStart": 39.451,
   "speechEnd": 42.97
  },
  {
   "id": "seg1-11",
   "text": "而是先问，攻击者或者故障，控制了什么。",
   "spoken": "而是先问，攻击者或者故障，控制了什么。",
   "src": "/Users/k/Workon/Learning/web3/web3-security-101/media/video/skeuo/ep16/audio/lines/seg1-11.wav",
   "start": 43.42,
   "dur": 4.08,
