 "captions": [
  {
   "text": "入口这么多",
   "start": 1.648,
   "end": 2.961,
   "id": "c0"
  },
  {
   "text": "怎么系统地去想",
   "start": 3.052,
   "end": 4.211,
   "id": "c1"
  },
  {
   "text": "办法是威胁建模",
   "start": 4.562,
   "end": 6.577,
   "id": "c2"
  },
  {
   "text": "威胁建模",
   "start": 7.58,
   "end": 8.666,
   "id": "c3"
  },
  {
   "text": "就是在写代码之前",
   "start": 8.699,
   "end": 10.119,
   "id": "c4"
  },
  {
   "text": "列出攻击者能控制的输入",
   "start": 10.139,
   "end": 12.0,
   "id": "c5"
  },
  {
   "text": "能触发的路径",
   "start": 12.163,
   "end": 13.416,
   "id": "c6"
  },
  {
   "text": "想得到的结果",
   "start": 13.437,
   "end": 14.595,
   "id": "c7"
  },
  {
   "text": "核心只有一个问题",
   "start": 15.576,
   "end": 16.984,
   "id": "c8"
  },
  {
   "text": "攻击者能控制什么",
   "start": 17.207,
   "end": 18.591,
   "id": "c9"
  },
  {
   "text": "对任何合约",
   "start": 19.868,
   "end": 20.966,
   "id": "c10"
  },
  {
   "text": "都先默认攻击者能做到这些事",
   "start": 21.058,
   "end": 23.43,
   "id": "c11"
  },
  {
   "text": "用任意参数",
   "start": 24.408,
   "end": 25.709,
   "id": "c12"
  },
  {
   "text": "调用任意一个公开函数",
   "start": 25.789,
   "end": 27.661,
   "id": "c13"
  },
  {
   "text": "部署自己的合约",
   "start": 28.66,
   "end": 29.877,
   "id": "c14"
  },
  {
   "text": "让你的合约去调用它",
   "start": 29.969,
   "end": 31.651,
   "id": "c15"
  },
  {
   "text": "比如恶意代币",
   "start": 31.755,
   "end": 32.853,
   "id": "c16"
  },
  {
   "text": "恶意回调",
   "start": 32.886,
   "end": 33.746,
   "id": "c17"
  },
  {
   "text": "在一笔交易里",
   "start": 34.736,
   "end": 35.882,
   "id": "c18"
  },
  {
   "text": "借到巨额资金",
   "start": 35.974,
   "end": 37.31,
   "id": "c19"
  },
  {
   "text": "看到内存池里还没确认的交易",
   "start": 38.292,
   "end": 40.724,
   "id": "c20"
  },
  {
   "text": "在它前后插入自己的交易",
   "start": 40.899,
   "end": 42.712,
   "id": "c21"
  },
  {
   "text": "不经过你的函数",
   "start": 43.696,
   "end": 44.949,
   "id": "c22"
  },
  {
   "text": "直接往你的合约里转入代币",
   "start": 45.148,
   "end": 47.33,
   "id": "c23"
  },
  {
   "text": "读取你合约的全部存储",
   "start": 48.308,
   "end": 49.989,
   "id": "c24"
  },
  {
   "text": "包括标成 private 的变量",
   "start": 50.046,
   "end": 51.835,
   "id": "c25"
  },
  {
   "text": "在另一条链或另一个合约上",
   "start": 52.824,
   "end": 54.887,
   "id": "c26"
  },
  {
   "text": "重放你签过的消息",
