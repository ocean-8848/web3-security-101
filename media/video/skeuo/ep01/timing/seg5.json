   "start": 58.563,
   "end": 60.959,
   "id": "c29"
  },
  {
   "text": "攻击者读得到吗",
   "start": 61.123,
   "end": 62.412,
   "id": "c30"
  },
  {
   "text": "读得到",
   "start": 63.648,
   "end": 64.472,
   "id": "c31"
  },
  {
   "text": "private 只限制别的合约来调用这个变量",
   "start": 64.836,
   "end": 67.839,
   "id": "c32"
  },
  {
   "text": "不隐藏链上数据",
   "start": 67.86,
   "end": 69.053,
   "id": "c33"
  },
  {
   "text": "反过来 攻击者通常做不到三件事",
   "start": 70.036,
   "end": 73.087,
   "id": "c34"
  },
  {
   "text": "伪造别人的签名",
   "start": 74.072,
   "end": 75.468,
   "id": "c35"
  },
  {
   "text": "除非私钥泄露",
   "start": 75.488,
   "end": 76.766,
   "id": "c36"
  },
  {
   "text": "或者验签写错了",
   "start": 76.786,
   "end": 78.027,
   "id": "c37"
  },
  {
   "text": "修改已经确认的区块",
   "start": 78.996,
   "end": 80.63,
   "id": "c38"
  },
  {
   "text": "除非链的共识被攻破",
   "start": 80.758,
   "end": 82.416,
   "id": "c39"
  },
  {
   "text": "让合约以为调用者是别人",
   "start": 83.416,
   "end": 85.502,
   "id": "c40"
  },
  {
   "text": "除非你的代码用错了身份判断的方式",
   "start": 85.749,
   "end": 88.383,
   "id": "c41"
  },
  {
   "text": "有了这张能力清单",
   "start": 89.372,
   "end": 90.863,
   "id": "c42"
  },
  {
   "text": "建模分六步",
   "start": 91.003,
   "end": 92.149,
   "id": "c43"
  },
  {
   "text": "第一 列出合约持有的资产",
   "start": 93.12,
   "end": 95.54,
   "id": "c44"
  },
  {
   "text": "比如用户存进来的 USDT",
   "start": 95.596,
   "end": 98.111,
   "id": "c45"
  },
  {
   "text": "协议手续费",
   "start": 98.132,
   "end": 99.159,
   "id": "c46"
  },
  {
   "text": "第二 列出每个会改变资产的函数",
   "start": 100.156,
   "end": 103.147,
   "id": "c47"
  },
  {
   "text": "标上谁能调用",
   "start": 103.275,
   "end": 104.599,
   "id": "c48"
  },
  {
   "text": "第三 写出不变量",
   "start": 105.584,
   "end": 107.587,
   "id": "c49"
  },
  {
   "text": "也就是任何操作之后",
   "start": 107.738,
   "end": 109.373,
   "id": "c50"
  },
  {
   "text": "都必须成立的式子",
   "start": 109.393,
   "end": 110.777,
   "id": "c51"
  },
  {
   "text": "比如 合约里的 USDT 余额",
   "start": 111.756,
   "end": 114.557,
   "id": "c52"
  },
  {
   "text": "不少于所有用户存款之和",
   "start": 114.577,
   "end": 116.545,
   "id": "c53"
  },
  {
   "text": "第四 对每个函数问",
   "start": 117.52,
   "end": 119.511,
   "id": "c54"
  },
  {
   "text": "攻击者控制哪些输入",
   "start": 119.686,
   "end": 121.368,
   "id": "c55"
  },
  {
   "text": "有哪些外部调用",
   "start": 121.732,
   "end": 123.14,
   "id": "c56"
  },
  {
   "text": "调用之前",
   "start": 123.517,
   "end": 124.532,
   "id": "c57"
  },
  {
   "text": "状态更新了没有",
   "start": 124.72,
   "end": 125.89,
   "id": "c58"
  },
  {
   "text": "第五 对每个外部数据问 价格 余额",
   "start": 127.164,
   "end": 131.06,
   "id": "c59"
  },
  {
   "text": "签名从哪里来",
   "start": 131.211,
   "end": 132.786,
   "id": "c60"
  },
  {
   "text": "一笔交易里能不能被操纵",
   "start": 133.137,
   "end": 135.331,
   "id": "c61"
  },
  {
   "text": "第六 对每个特权角色问",
   "start": 136.568,
   "end": 138.928,
   "id": "c62"
  },
  {
   "text": "私钥在谁手里",
   "start": 138.972,
   "end": 140.357,
   "id": "c63"
  },
  {
   "text": "被盗了最多损失多少",
   "start": 140.72,
   "end": 142.342,
   "id": "c64"
  },
  {
   "text": "有没有时间锁",
   "start": 142.72,
   "end": 143.985,
   "id": "c65"
  },
  {
   "text": "不变量是整个安全工作的锚点",
   "start": 145.252,
   "end": 147.469,
   "id": "c66"
  },
  {
   "text": "所有测试",
   "start": 147.844,
   "end": 148.931,
   "id": "c67"
  },
  {
   "text": "最后都在验证它",
   "start": 148.975,
   "end": 150.288,
   "id": "c68"
  },
  {
   "text": "这个方法也有局限",
   "start": 151.256,
   "end": 152.926,
   "id": "c69"
  },
  {
   "text": "威胁建模靠人的想象力",
   "start": 153.301,
   "end": 155.173,
   "id": "c70"
  },
  {
   "text": "经济攻击常常超出单个合约",
   "start": 156.156,
   "end": 158.576,
   "id": "c71"
  },
  {
   "text": "要把整个协议和外部市场放在一起建模",
   "start": 158.751,
   "end": 161.861,
   "id": "c72"
  }
 ]
}