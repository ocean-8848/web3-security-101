 "captions": [
  {
   "text": "六大类里",
   "start": 1.648,
   "end": 2.591,
   "id": "c0"
  },
  {
   "text": "钱到底丢在哪儿",
   "start": 2.79,
   "end": 4.46,
   "id": "c1"
  },
  {
   "text": "我们看损失的变化",
   "start": 4.824,
   "end": 6.291,
   "id": "c2"
  },
  {
   "text": "先说口径",
   "start": 7.292,
   "end": 8.271,
   "id": "c3"
  },
  {
   "text": "下面的数字来自公开报道和安全公司的年度统计",
   "start": 8.646,
   "end": 12.59,
   "id": "c4"
  },
  {
   "text": "按事发时的美元估值",
   "start": 12.789,
   "end": 14.591,
   "id": "c5"
  },
  {
   "text": "都是约数",
   "start": 14.611,
   "end": 15.447,
   "id": "c6"
  },
  {
   "text": "2016 年",
   "start": 16.44,
   "end": 17.443,
   "id": "c7"
  },
  {
   "text": "The DAO 因为重入",
   "start": 17.523,
   "end": 18.764,
   "id": "c8"
  },
  {
   "text": "损失约 6000 万美元",
   "start": 18.821,
   "end": 20.622,
   "id": "c9"
  },
  {
   "text": "那几年多是重入",
   "start": 21.604,
   "end": 23.19,
   "id": "c10"
  },
  {
   "text": "溢出这类代码漏洞",
   "start": 23.389,
   "end": 24.785,
   "id": "c11"
  },
  {
   "text": "编译器和库成熟以后",
   "start": 25.161,
   "end": 26.938,
   "id": "c12"
  },
  {
   "text": "这类漏洞少了",
   "start": 27.03,
   "end": 28.212,
   "id": "c13"
  },
  {
   "text": "2022 年",
   "start": 29.192,
   "end": 30.207,
   "id": "c14"
  },
  {
   "text": "Ronin 跨链桥损失约 6.2 亿美元",
   "start": 30.346,
   "end": 33.076,
   "id": "c15"
  },
  {
   "text": "原因是验证者私钥",
   "start": 33.096,
   "end": 34.85,
   "id": "c16"
  },
  {
   "text": "2024 年",
   "start": 35.844,
   "end": 36.835,
   "id": "c17"
  },
  {
   "text": "DMM Bitcoin 损失约 3.05 亿美元",
   "start": 36.975,
   "end": 39.871,
   "id": "c18"
  },
  {
   "text": "入口是假招聘",
   "start": 40.246,
   "end": 41.702,
   "id": "c19"
  },
  {
   "text": "落点是供应商的终端",
   "start": 41.841,
   "end": 43.595,
   "id": "c20"
  },
  {
   "text": "2025 年",
   "start": 44.584,
   "end": 45.528,
   "id": "c21"
  },
  {
   "text": "就是开头的 Bybit",
   "start": 45.548,
   "end": 47.063,
   "id": "c22"
  },
  {
   "text": "约 15 亿美元",
   "start": 47.143,
   "end": 48.421,
   "id": "c23"
  },
  {
   "text": "出在前端和签名界面",
   "start": 48.441,
   "end": 50.361,
   "id": "c24"
  },
  {
   "text": "2026 年 10 月",
   "start": 51.356,
   "end": 52.68,
   "id": "c25"
  },
  {
   "text": "Binance 热钱包损失约 63.4 亿美元",
   "start": 52.737,
   "end": 55.966,
   "id": "c26"
  },
  {
   "text": "这是项目方的口径",
   "start": 56.341,
   "end": 57.809,
   "id": "c27"
  },
  {
   "text": "按这个口径",
   "start": 58.8,
   "end": 59.862,
   "id": "c28"
  },
  {
   "text": "它超过此前任何单起事故的 4 倍",
   "start": 60.097,
   "end": 62.624,
   "id": "c29"
  },
  {
   "text": "趋势很清楚",
