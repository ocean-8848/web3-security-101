 "captions": [
  {
   "text": "2025 年 11 月",
   "start": 1.648,
   "end": 3.008,
   "id": "c0"
  },
  {
   "text": "Balancer V2 的稳定池",
   "start": 3.112,
   "end": 4.759,
   "id": "c1"
  },
  {
   "text": "被人取走了资金",
   "start": 4.779,
   "end": 5.925,
   "id": "c2"
  },
  {
   "text": "官方复盘估算",
   "start": 6.908,
   "end": 8.185,
   "id": "c3"
  },
  {
   "text": "用户资金被盗约 9480 万美元",
   "start": 8.372,
   "end": 11.482,
   "id": "c4"
  },
  {
   "text": "根因 被定位在一处取整错误",
   "start": 12.48,
   "end": 15.292,
   "id": "c5"
  },
  {
   "text": "单次交换的误差很小",
   "start": 16.276,
   "end": 18.041,
   "id": "c6"
  },
  {
   "text": "攻击者把大量小额交换",
   "start": 19.016,
   "end": 20.959,
   "id": "c7"
  },
  {
   "text": "串进一笔批量交换",
   "start": 21.016,
   "end": 22.555,
   "id": "c8"
  },
  {
   "text": "每一步的误差",
   "start": 23.556,
   "end": 24.809,
   "id": "c9"
  },
  {
   "text": "都朝对自己有利的方向累积",
   "start": 24.877,
   "end": 26.761,
   "id": "c10"
  },
  {
   "text": "先猜一道题",
   "start": 27.76,
   "end": 29.084,
   "id": "c11"
  },
  {
   "text": "金库里 每份额值 1.5 个最小资产单位",
   "start": 29.448,
   "end": 32.749,
   "id": "c12"
  },
  {
   "text": "铸造 1 份额时",
   "start": 33.74,
   "end": 34.981,
   "id": "c13"
  },
  {
   "text": "合约把应收的 1.5 向下取整",
   "start": 35.121,
   "end": 37.219,
   "id": "c14"
  },
  {
   "text": "只收 1 个单位",
   "start": 37.311,
   "end": 38.35,
   "id": "c15"
  },
  {
   "text": "重复 1000 次",
   "start": 39.336,
   "end": 40.458,
   "id": "c16"
  },
  {
   "text": "调用者多拿了多少",
   "start": 40.633,
   "end": 41.97,
   "id": "c17"
  },
  {
   "text": "大约 500 个单位",
   "start": 43.244,
   "end": 44.568,
   "id": "c18"
  },
  {
   "text": "这些差额",
   "start": 44.944,
   "end": 46.114,
   "id": "c19"
  },
  {
   "text": "来自其他持有人",
   "start": 46.17,
   "end": 47.352,
   "id": "c20"
  },
  {
   "text": "EVM 只有整数",
   "start": 48.336,
   "end": 49.851,
   "id": "c21"
  },
  {
   "text": "每一次除法",
   "start": 50.226,
   "end": 51.372,
   "id": "c22"
  },
  {
   "text": "都会丢掉余数",
   "start": 51.548,
   "end": 52.634,
   "id": "c23"
  },
  {
   "text": "丢掉的余数归谁",
   "start": 53.62,
   "end": 55.099,
   "id": "c24"
  },
  {
   "text": "决定了谁能从协议里",
   "start": 55.262,
   "end": 57.313,
   "id": "c25"
  },
  {
   "text": "慢慢抠出钱",
   "start": 57.37,
   "end": 58.635,
   "id": "c26"
  },
  {
   "text": "这一集讲三件事",
   "start": 59.624,
   "end": 61.127,
   "id": "c27"
  },
  {
   "text": "数学缺陷",
   "start": 61.147,
   "end": 62.341,
   "id": "c28"
  },
  {
   "text": "舍入方向",
   "start": 62.433,
   "end": 63.508,
   "id": "c29"
  },
  {
   "text": "金库通胀",
   "start": 63.528,
   "end": 64.532,
   "id": "c30"
  }
 ]
