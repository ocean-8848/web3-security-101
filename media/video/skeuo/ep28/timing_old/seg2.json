 "captions": [
  {
   "text": "先给一句准确的说法",
   "start": 1.55,
   "end": 3.268,
   "id": "c0"
  },
  {
   "text": "大多数事故不是新漏洞",
   "start": 3.623,
   "end": 5.536,
   "id": "c1"
  },
  {
   "text": "而是旧漏洞在新环境里复发",
   "start": 5.851,
   "end": 8.177,
   "id": "c2"
  },
  {
   "text": "新环境可以是一条新链",
   "start": 8.484,
   "end": 10.688,
   "id": "c3"
  },
  {
   "text": "一个分叉",
   "start": 10.846,
   "end": 11.598,
   "id": "c4"
  },
  {
   "text": "一个新版本",
   "start": 11.971,
   "end": 12.978,
   "id": "c5"
  },
  {
   "text": "或者一种新的组合方式",
   "start": 13.099,
   "end": 14.888,
   "id": "c6"
  },
  {
   "text": "打个比方",
   "start": 15.268,
   "end": 15.938,
   "id": "c7"
  },
  {
   "text": "航空业把每一起事故",
   "start": 16.02,
   "end": 17.993,
   "id": "c8"
  },
  {
   "text": "都写成公开报告",
   "start": 18.065,
   "end": 19.616,
   "id": "c9"
  },
  {
   "text": "所以今天的飞行员",
   "start": 19.87,
   "end": 21.427,
   "id": "c10"
  },
  {
   "text": "不会再犯 1970 年代的错误",
   "start": 21.584,
   "end": 23.844,
   "id": "c11"
  },
  {
   "text": "链上安全也有自己的事故报告",
   "start": 24.182,
   "end": 26.532,
   "id": "c12"
  },
  {
   "text": "项目复盘",
   "start": 26.659,
   "end": 27.604,
   "id": "c13"
  },
  {
   "text": "安全公司分析",
   "start": 27.876,
   "end": 28.996,
   "id": "c14"
  },
  {
   "text": "还有链上数据",
   "start": 29.288,
   "end": 30.303,
   "id": "c15"
  },
  {
   "text": "读事故报告",
   "start": 30.647,
   "end": 31.602,
   "id": "c16"
  },
  {
   "text": "是成本最低的安全训练",
   "start": 31.748,
   "end": 33.586,
   "id": "c17"
  },
  {
   "text": "这个比方有一处不成立",
   "start": 33.903,
   "end": 35.574,
   "id": "c18"
  },
  {
   "text": "航空事故由独立机构调查",
   "start": 35.87,
   "end": 38.208,
   "id": "c19"
  },
  {
   "text": "结论有权威性",
   "start": 38.372,
   "end": 39.664,
   "id": "c20"
  },
  {
   "text": "链上事故的复盘",
   "start": 40.026,
   "end": 41.352,
   "id": "c21"
  },
  {
   "text": "多数由项目方或安全公司发布",
   "start": 41.478,
   "end": 44.087,
   "id": "c22"
  },
  {
   "text": "细节可能不完整",
   "start": 44.31,
   "end": 45.812,
   "id": "c23"
  },
  {
   "text": "归因也可能有争议",
   "start": 45.952,
   "end": 47.58,
   "id": "c24"
  },
  {
   "text": "所以读复盘时",
   "start": 47.905,
   "end": 49.474,
   "id": "c25"
  },
  {
   "text": "只采信多方公开资料一致的事实",
   "start": 49.596,
   "end": 52.352,
   "id": "c26"
  },
  {
   "text": "在这座档案馆里",
   "start": 52.59,
   "end": 54.098,
   "id": "c27"
  },
  {
   "text": "每一起事故按两个标签归档",
   "start": 54.292,
   "end": 57.365,
   "id": "c28"
  },
  {
   "text": "根因类别和链",
   "start": 57.498,
   "end": 58.798,
   "id": "c29"
  },
  {
   "text": "以太坊和多链",
   "start": 59.148,
   "end": 60.49,
   "id": "c30"
  },
  {
   "text": "BNB Chain",
   "start": 60.723,
   "end": 61.588,
   "id": "c31"
  },
  {
   "text": "TRON",
   "start": 61.761,
   "end": 62.228,
   "id": "c32"
  },
  {
   "text": "Mantle",
   "start": 62.363,
   "end": 62.944,
   "id": "c33"
  },
  {
   "text": "各有一面展墙",
   "start": 63.047,
   "end": 64.298,
   "id": "c34"
  },
  {
   "text": "还有两面",
   "start": 64.55,
   "end": 65.447,
   "id": "c35"
  },
  {
   "text": "一面放代码之外的事故",
   "start": 65.901,
   "end": 67.689,
   "id": "c36"
  },
  {
   "text": "一面放 NFT 与 GameFi",
   "start": 67.978,
   "end": 69.932,
   "id": "c37"
  },
  {
   "text": "金额都是事发时的美元估值",
   "start": 70.21,
   "end": 72.931,
   "id": "c38"
  },
  {
   "text": "只能看作约数",
   "start": 73.209,
   "end": 74.548,
   "id": "c39"
  },
  {
   "text": "没有摆上展墙的",
   "start": 74.933,
   "end": 76.118,
   "id": "c40"
  },
  {
   "text": "不代表没有发生",
   "start": 76.254,
   "end": 77.531,
   "id": "c41"
  },
  {
   "text": "六十多起事故摆在一起",
   "start": 77.863,
   "end": 79.669,
   "id": "c42"
  },
  {
   "text": "反复出现的",
   "start": 79.808,
   "end": 80.817,
   "id": "c43"
  },
  {
   "text": "其实只有八种模式",
   "start": 81.08,
   "end": 82.731,
   "id": "c44"
  },
  {
   "text": "前五种藏在代码和版本里 后三种",
   "start": 82.95,
   "end": 86.545,
   "id": "c45"
  },
  {
   "text": "出在签名",
   "start": 86.616,
   "end": 87.779,
   "id": "c46"
  },
  {
   "text": "密钥和人身上",
   "start": 87.799,
   "end": 89.206,
   "id": "c47"
  }
 ]
