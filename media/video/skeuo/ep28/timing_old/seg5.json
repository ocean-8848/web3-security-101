 "captions": [
  {
   "text": "第七种 少数几把钥匙",
   "start": 1.55,
   "end": 3.745,
   "id": "c0"
  },
  {
   "text": "控制了全部资产",
   "start": 3.856,
   "end": 5.395,
   "id": "c1"
  },
  {
   "text": "2022 年 3 月的 Ronin",
   "start": 5.61,
   "end": 7.669,
   "id": "c2"
  },
  {
   "text": "9 个验证者里",
   "start": 7.857,
   "end": 8.958,
   "id": "c3"
  },
  {
   "text": "5 个被控制",
   "start": 8.987,
   "end": 9.957,
   "id": "c4"
  },
  {
   "text": "损失约 6.2 亿美元",
   "start": 10.12,
   "end": 11.967,
   "id": "c5"
  },
  {
   "text": "2023 年 7 月的 Multichain",
   "start": 12.23,
   "end": 14.356,
   "id": "c6"
  },
  {
   "text": "MPC 节点全部放在 CEO 的个人云账户里",
   "start": 14.376,
   "end": 18.05,
   "id": "c7"
  },
  {
   "text": "这一次 损失约 1.26 亿美元",
   "start": 18.388,
   "end": 21.651,
   "id": "c8"
  },
  {
   "text": "2026 年 4 月的 Drift",
   "start": 21.87,
   "end": 23.943,
   "id": "c9"
  },
  {
   "text": "五个人里两人签名就能放行",
   "start": 23.996,
   "end": 26.431,
   "id": "c10"
  },
  {
   "text": "没有时间锁",
   "start": 26.729,
   "end": 27.659,
   "id": "c11"
  },
  {
   "text": "损失约 2.85 亿美元",
   "start": 27.971,
   "end": 30.34,
   "id": "c12"
  },
  {
   "text": "识别信号是",
   "start": 30.57,
   "end": 31.566,
   "id": "c13"
  },
  {
   "text": "签名人少",
   "start": 31.586,
   "end": 32.611,
   "id": "c14"
  },
  {
   "text": "没有时间锁",
   "start": 32.646,
   "end": 33.584,
   "id": "c15"
  },
  {
   "text": "防御是提高门槛",
   "start": 33.83,
   "end": 35.574,
   "id": "c16"
  },
  {
   "text": "让签名人真正彼此独立",
   "start": 35.831,
   "end": 38.034,
   "id": "c17"
  },
  {
   "text": "再加时间锁和速率限制",
   "start": 38.311,
   "end": 40.56,
   "id": "c18"
  },
  {
   "text": "延迟有多大用",
   "start": 40.863,
   "end": 42.198,
   "id": "c19"
  },
  {
   "text": "看一个反例",
   "start": 42.402,
   "end": 43.33,
   "id": "c20"
  },
  {
   "text": "2025 年 2 月",
   "start": 43.735,
   "end": 46.054,
   "id": "c21"
  },
  {
   "text": "Mantle 上的 mETH 协议",
   "start": 46.096,
   "end": 47.415,
   "id": "c22"
  },
  {
   "text": "靠 8 小时提款延迟和暂停权限",
   "start": 47.578,
   "end": 51.254,
   "id": "c23"
  },
  {
   "text": "追回了 15000 个 cmETH",
   "start": 51.369,
   "end": 54.669,
   "id": "c24"
  },
  {
   "text": "约 4300 万美元",
   "start": 54.704,
   "end": 56.661,
   "id": "c25"
  },
  {
   "text": "第八种 人是入口",
   "start": 56.97,
   "end": 59.451,
   "id": "c26"
  },
  {
   "text": "2024 年 5 月的 DMM Bitcoin",
   "start": 59.776,
   "end": 62.63,
   "id": "c27"
  },
  {
   "text": "一道假招聘测试题",
   "start": 62.65,
   "end": 65.198,
   "id": "c28"
  },
  {
   "text": "控制了供应商员工的终端",
   "start": 65.473,
   "end": 67.783,
   "id": "c29"
  },
  {
   "text": "这一次 损失约 3.05 亿美元",
   "start": 68.147,
   "end": 71.251,
   "id": "c30"
  },
  {
   "text": "同年 10 月的 Radiant Capital",
