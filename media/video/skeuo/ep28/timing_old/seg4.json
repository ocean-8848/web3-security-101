 "captions": [
  {
   "text": "第四种 新增的函数",
   "start": 1.55,
   "end": 3.848,
   "id": "c0"
  },
  {
   "text": "绕过了原有的检查",
   "start": 3.931,
   "end": 5.676,
   "id": "c1"
  },
  {
   "text": "2023 年 3 月",
   "start": 6.02,
   "end": 7.182,
   "id": "c2"
  },
  {
   "text": "Euler Finance 损失约 1.97 亿美元",
   "start": 7.359,
   "end": 10.605,
   "id": "c3"
  },
  {
   "text": "大部分后来归还",
   "start": 10.803,
   "end": 12.213,
   "id": "c4"
  },
  {
   "text": "根因是新加的捐赠函数",
   "start": 12.567,
   "end": 14.894,
   "id": "c5"
  },
  {
   "text": "没有做健康检查",
   "start": 15.013,
   "end": 16.378,
   "id": "c6"
  },
  {
   "text": "别的入口都检查了",
   "start": 16.61,
   "end": 18.183,
   "id": "c7"
  },
  {
   "text": "偏偏新入口漏掉了",
   "start": 18.429,
   "end": 20.004,
   "id": "c8"
  },
  {
   "text": "识别信号是",
   "start": 20.27,
   "end": 21.337,
   "id": "c9"
  },
  {
   "text": "新增了一个能改余额或债务的入口",
   "start": 21.465,
   "end": 24.487,
   "id": "c10"
  },
  {
   "text": "防御是统一的操作后检查",
   "start": 24.73,
   "end": 27.034,
   "id": "c11"
  },
  {
   "text": "所有入口都要经过",
   "start": 27.272,
   "end": 28.774,
   "id": "c12"
  },
  {
   "text": "再用不变量测试兜底",
   "start": 29.011,
   "end": 30.769,
   "id": "c13"
  },
  {
   "text": "第五种 改动过的分叉和新版本",
   "start": 31.03,
   "end": 33.766,
   "id": "c14"
  },
  {
   "text": "没有重新审计",
   "start": 33.898,
   "end": 35.132,
   "id": "c15"
  },
  {
   "text": "2021 年 4 月的 Uranium Finance",
   "start": 35.516,
   "end": 38.375,
   "id": "c16"
  },
  {
   "text": "分叉了 Uniswap V2",
   "start": 38.68,
   "end": 40.522,
   "id": "c17"
  },
  {
   "text": "改手续费时",
   "start": 40.83,
   "end": 41.915,
   "id": "c18"
  },
  {
   "text": "漏改了一个常数",
   "start": 42.036,
   "end": 43.348,
   "id": "c19"
  },
  {
   "text": "恒定乘积的检查就此失效",
   "start": 43.925,
   "end": 46.319,
   "id": "c20"
  },
  {
   "text": "损失约 5000 万美元",
   "start": 46.431,
   "end": 48.827,
   "id": "c21"
  },
  {
   "text": "识别信号只有一句话",
   "start": 49.13,
   "end": 50.965,
   "id": "c22"
  },
  {
   "text": "只改了一行",
   "start": 51.218,
   "end": 52.112,
   "id": "c23"
  },
  {
   "text": "防御是改动即重审",
   "start": 52.39,
   "end": 54.426,
   "id": "c24"
  },
  {
   "text": "对差异做审计",
   "start": 54.589,
   "end": 56.037,
   "id": "c25"
  },
  {
   "text": "第六种 签名人看不懂自己签的是什么",
   "start": 56.382,
   "end": 59.871,
   "id": "c26"
  },
  {
   "text": "2024 年 7 月的 WazirX",
   "start": 60.215,
   "end": 62.898,
   "id": "c27"
  },
  {
   "text": "签名人看到的",
   "start": 63.289,
   "end": 64.657,
   "id": "c28"
  },
  {
   "text": "和签下的不一致",
   "start": 64.677,
   "end": 66.2,
   "id": "c29"
  },
  {
   "text": "损失约 2.3 亿美元",
   "start": 66.381,
   "end": 68.671,
   "id": "c30"
  },
  {
   "text": "2025 年 2 月的 Bybit",
   "start": 68.995,
   "end": 70.828,
   "id": "c31"
  },
  {
   "text": "多签前端的脚本被精准篡改",
   "start": 70.921,
   "end": 73.418,
   "id": "c32"
  },
  {
   "text": "只对目标地址生效",
   "start": 73.648,
   "end": 75.14,
   "id": "c33"
  },
  {
   "text": "签名人盲签了一笔 delegatecall",
   "start": 75.52,
   "end": 77.985,
   "id": "c34"
  },
  {
   "text": "按 FBI 口径",
   "start": 78.069,
   "end": 79.296,
   "id": "c35"
  },
  {
   "text": "损失约 15 亿美元",
   "start": 79.368,
   "end": 81.012,
   "id": "c36"
  },
  {
   "text": "TRON 上的权限诈骗也是这一种",
   "start": 81.25,
   "end": 83.659,
   "id": "c37"
  },
  {
   "text": "用户签下的",
   "start": 83.921,
   "end": 84.899,
   "id": "c38"
  },
  {
   "text": "是交出自己账户的权限",
   "start": 84.919,
   "end": 86.706,
   "id": "c39"
  },
  {
   "text": "识别信号是",
   "start": 86.99,
   "end": 88.088,
   "id": "c40"
  },
  {
   "text": "签名界面只显示哈希或摘要",
   "start": 88.335,
   "end": 91.104,
   "id": "c41"
  },
  {
   "text": "防御是独立解码",
   "start": 91.37,
   "end": 93.136,
   "id": "c42"
  },
  {
   "text": "在硬件钱包上核对",
   "start": 93.156,
   "end": 94.692,
   "id": "c43"
  },
  {
   "text": "delegatecall",
   "start": 94.898,
   "end": 95.744,
   "id": "c44"
  },
  {
   "text": "只许指向白名单里的合约",
   "start": 95.764,
   "end": 97.823,
   "id": "c45"
  }
 ]
