 "captions": [
  {
   "text": "2016 年 6 月",
   "start": 1.55,
   "end": 2.92,
   "id": "c0"
  },
  {
   "text": "以太坊上的 The DAO 被攻击",
   "start": 3.152,
   "end": 5.08,
   "id": "c1"
  },
  {
   "text": "损失约 6000 万美元",
   "start": 5.276,
   "end": 7.039,
   "id": "c2"
  },
  {
   "text": "根因只有一句 先转账",
   "start": 7.389,
   "end": 9.894,
   "id": "c3"
  },
  {
   "text": "后更新余额",
   "start": 9.915,
   "end": 11.133,
   "id": "c4"
  },
  {
   "text": "钱已经转出去",
   "start": 11.444,
   "end": 12.718,
   "id": "c5"
  },
  {
   "text": "账上的余额还没减",
   "start": 12.78,
   "end": 14.471,
   "id": "c6"
  },
  {
   "text": "对方合约在收款的回调里",
   "start": 14.69,
   "end": 16.798,
   "id": "c7"
  },
  {
   "text": "马上回来",
   "start": 16.911,
   "end": 17.644,
   "id": "c8"
  },
  {
   "text": "再取一次",
   "start": 17.664,
   "end": 18.51,
   "id": "c9"
  },
  {
   "text": "七年后 2023 年 7 月",
   "start": 18.75,
   "end": 21.057,
   "id": "c10"
  },
  {
   "text": "Curve 被攻击",
   "start": 21.286,
   "end": 22.351,
   "id": "c11"
  },
  {
   "text": "损失约 7000 万美元",
   "start": 22.595,
   "end": 24.316,
   "id": "c12"
  },
  {
   "text": "这一次 合约里写了重入锁",
   "start": 24.668,
   "end": 28.337,
   "id": "c13"
  },
  {
   "text": "可是 Vyper 编译器",
   "start": 28.63,
   "end": 30.0,
   "id": "c14"
  },
  {
   "text": "把这把锁实现错了",
   "start": 30.02,
   "end": 31.411,
   "id": "c15"
  },
  {
   "text": "又过了一年多",
   "start": 31.741,
   "end": 32.991,
   "id": "c16"
  },
  {
   "text": "2024 年 9 月",
   "start": 33.373,
   "end": 34.96,
   "id": "c17"
  },
  {
   "text": "Penpie 损失约 2700 万美元",
   "start": 35.267,
   "end": 37.871,
   "id": "c18"
  },
  {
   "text": "它的领奖函数",
   "start": 38.11,
   "end": 39.627,
   "id": "c19"
  },
  {
   "text": "没有加锁",
   "start": 39.703,
   "end": 40.686,
   "id": "c20"
  },
  {
   "text": "三个名字",
   "start": 40.97,
   "end": 42.232,
   "id": "c21"
  },
  {
   "text": "三种写法",
   "start": 42.27,
   "end": 43.379,
   "id": "c22"
  },
  {
   "text": "其实是同一个错误 先交互 后记账",
   "start": 43.959,
   "end": 47.864,
   "id": "c23"
  },
  {
   "text": "一个早就修过的漏洞",
   "start": 48.15,
   "end": 50.478,
   "id": "c24"
  },
  {
   "text": "为什么会换个名字",
   "start": 50.526,
   "end": 52.376,
   "id": "c25"
  },
  {
   "text": "一再回来",
   "start": 52.396,
   "end": 53.31,
   "id": "c26"
  },
  {
   "text": "读旧事故",
   "start": 53.949,
   "end": 54.897,
   "id": "c27"
  },
  {
   "text": "能不能让我们提前认出下一起",
   "start": 55.093,
   "end": 57.654,
   "id": "c28"
  },
  {
   "text": "带着这两个问题",
   "start": 58.19,
   "end": 59.524,
   "id": "c29"
  },
  {
   "text": "我们走进一座事故档案馆",
   "start": 59.757,
   "end": 62.181,
   "id": "c30"
  }
 ]
}