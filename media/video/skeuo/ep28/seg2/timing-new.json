 "captions": [
  {
   "text": "先给一句准确的说法",
   "start": 1.648,
   "end": 3.246,
   "id": "c0"
  },
  {
   "text": "大多数事故不是新漏洞",
   "start": 4.244,
   "end": 6.295,
   "id": "c1"
  },
  {
   "text": "而是旧漏洞在新环境里复发",
   "start": 6.434,
   "end": 9.068,
   "id": "c2"
  },
  {
   "text": "新环境可以是一条新链",
   "start": 10.056,
   "end": 12.118,
   "id": "c3"
  },
  {
   "text": "一个分叉",
   "start": 12.187,
   "end": 13.107,
   "id": "c4"
  },
  {
   "text": "一个新版本",
   "start": 13.222,
   "end": 14.309,
   "id": "c5"
  },
  {
   "text": "或者一种新的组合方式",
   "start": 14.365,
   "end": 15.952,
   "id": "c6"
  },
  {
   "text": "打个比方",
   "start": 16.948,
   "end": 17.903,
   "id": "c7"
  },
  {
   "text": "航空业把每一起事故",
   "start": 18.09,
   "end": 19.773,
   "id": "c8"
  },
  {
   "text": "都写成公开报告",
   "start": 19.793,
   "end": 21.118,
   "id": "c9"
  },
  {
   "text": "所以今天的飞行员",
   "start": 22.112,
   "end": 24.127,
   "id": "c10"
  },
  {
   "text": "不会再犯 1970 年代的错误",
   "start": 24.207,
   "end": 26.222,
   "id": "c11"
  },
  {
   "text": "链上安全也有自己的事故报告",
   "start": 27.204,
   "end": 29.707,
   "id": "c12"
  },
  {
   "text": "项目复盘",
   "start": 29.727,
   "end": 30.826,
   "id": "c13"
  },
  {
   "text": "安全公司分析",
   "start": 30.966,
   "end": 32.231,
   "id": "c14"
  },
  {
   "text": "还有链上数据",
   "start": 32.251,
   "end": 33.409,
   "id": "c15"
  },
  {
   "text": "读事故报告",
   "start": 34.408,
   "end": 35.4,
   "id": "c16"
  },
  {
   "text": "是成本最低的安全训练",
   "start": 35.42,
   "end": 37.197,
   "id": "c17"
  },
  {
   "text": "这个比方有一处不成立",
   "start": 38.18,
   "end": 40.135,
   "id": "c18"
  },
  {
   "text": "航空事故由独立机构调查",
   "start": 41.112,
   "end": 43.603,
   "id": "c19"
  },
  {
   "text": "结论有权威性",
   "start": 43.695,
   "end": 44.996,
   "id": "c20"
  },
  {
   "text": "链上事故的复盘",
   "start": 45.988,
   "end": 47.467,
   "id": "c21"
  },
  {
   "text": "多数由项目方或安全公司发布",
   "start": 47.511,
   "end": 49.658,
   "id": "c22"
  },
  {
   "text": "细节可能不完整",
   "start": 50.648,
   "end": 51.972,
   "id": "c23"
  },
  {
   "text": "归因也可能有争议",
   "start": 52.124,
   "end": 53.484,
   "id": "c24"
  },
  {
   "text": "所以读复盘时",
   "start": 54.468,
   "end": 55.852,
   "id": "c25"
  },
  {
   "text": "只采信多方公开资料一致的事实",
   "start": 55.872,
   "end": 58.495,
   "id": "c26"
  },
  {
   "text": "在这座档案馆里",
   "start": 59.488,
   "end": 60.729,
   "id": "c27"
  },
  {
   "text": "每一起事故按两个标签归档",
   "start": 60.892,
   "end": 63.229,
   "id": "c28"
  },
  {
   "text": "根因类别和链",
   "start": 63.321,
   "end": 64.527,
   "id": "c29"
  },
  {
   "text": "以太坊和多链",
   "start": 65.516,
   "end": 66.864,
   "id": "c30"
  },
