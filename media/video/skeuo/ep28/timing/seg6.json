 "captions": [
  {
   "text": "认出模式之后",
   "start": 1.648,
   "end": 2.877,
   "id": "c0"
  },
  {
   "text": "还要会写复盘",
   "start": 2.957,
   "end": 4.187,
   "id": "c1"
  },
  {
   "text": "先写一句话摘要",
   "start": 5.156,
   "end": 6.433,
   "id": "c2"
  },
  {
   "text": "损失多少",
   "start": 6.548,
   "end": 7.528,
   "id": "c3"
  },
  {
   "text": "是否追回",
   "start": 7.62,
   "end": 8.695,
   "id": "c4"
  },
  {
   "text": "再写时间线",
   "start": 9.696,
   "end": 10.77,
   "id": "c5"
  },
  {
   "text": "漏洞在哪个版本引入",
   "start": 10.934,
   "end": 12.485,
   "id": "c6"
  },
  {
   "text": "攻击交易",
   "start": 12.612,
   "end": 13.508,
   "id": "c7"
  },
  {
   "text": "发现与响应",
   "start": 13.553,
   "end": 14.58,
   "id": "c8"
  },
  {
   "text": "根因分两层",
   "start": 15.58,
   "end": 16.892,
   "id": "c9"
  },
  {
   "text": "直接原因是代码哪一行",
   "start": 16.984,
   "end": 19.012,
   "id": "c10"
  },
  {
   "text": "根本原因是流程哪一环缺失",
   "start": 19.127,
   "end": 21.642,
   "id": "c11"
  },
  {
   "text": "最后写 哪个关口本可以拦住它",
   "start": 22.64,
   "end": 25.536,
   "id": "c12"
  },
  {
   "text": "被打破的不变量",
   "start": 25.592,
   "end": 26.751,
   "id": "c13"
  },
  {
   "text": "还有防御清单",
   "start": 26.771,
   "end": 27.929,
   "id": "c14"
  },
  {
   "text": "练习时 每周选一起",
   "start": 28.908,
   "end": 31.113,
   "id": "c15"
  },
  {
   "text": "只看交易哈希",
   "start": 31.181,
   "end": 32.363,
   "id": "c16"
  },
  {
   "text": "用调用树找根因",
   "start": 32.503,
   "end": 33.863,
   "id": "c17"
  },
  {
   "text": "再对照复盘",
   "start": 33.92,
   "end": 34.971,
   "id": "c18"
  },
  {
   "text": "找出自己漏掉的步骤",
   "start": 34.991,
   "end": 36.411,
   "id": "c19"
  },
  {
   "text": "事件库只是线索",
   "start": 37.408,
   "end": 39.006,
   "id": "c20"
  },
  {
   "text": "金额和根因要回到一手资料核对",
   "start": 39.229,
   "end": 41.768,
   "id": "c21"
  },
  {
   "text": "复现只在本地或分叉环境里做",
   "start": 41.955,
   "end": 44.625,
   "id": "c22"
  },
  {
   "text": "今天就能做一件事",
   "start": 45.596,
   "end": 47.075,
   "id": "c23"
  },
  {
   "text": "写代码的人",
   "start": 48.048,
   "end": 49.122,
   "id": "c24"
  },
  {
   "text": "拿八个识别信号",
   "start": 49.202,
   "end": 50.599,
   "id": "c25"
  },
  {
   "text": "查一遍自己最近的改动",
   "start": 50.714,
   "end": 52.253,
   "id": "c26"
  },
  {
   "text": "管资产的人",
   "start": 53.236,
   "end": 54.358,
   "id": "c27"
  },
  {
   "text": "数一数控制资金的钥匙有几把",
   "start": 54.426,
   "end": 56.62,
   "id": "c28"
  },
  {
   "text": "有没有时间锁",
