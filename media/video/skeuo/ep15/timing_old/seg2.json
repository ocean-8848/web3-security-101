 "captions": [
  {
   "text": "先给准确的说法",
   "start": 1.55,
   "end": 2.807,
   "id": "c0"
  },
  {
   "text": "账户抽象",
   "start": 3.149,
   "end": 4.105,
   "id": "c1"
  },
  {
   "text": "是让合约代码来决定",
   "start": 4.125,
   "end": 6.115,
   "id": "c2"
  },
  {
   "text": "账户怎么验证",
   "start": 6.216,
   "end": 7.571,
   "id": "c3"
  },
  {
   "text": "怎么执行",
   "start": 7.606,
   "end": 8.571,
   "id": "c4"
  },
  {
   "text": "协议不再写死",
   "start": 8.87,
   "end": 10.49,
   "id": "c5"
  },
  {
   "text": "一把私钥签一笔交易",
   "start": 10.741,
   "end": 12.653,
   "id": "c6"
  },
  {
   "text": "打个比方",
   "start": 13.03,
   "end": 13.688,
   "id": "c7"
  },
  {
   "text": "以前去银行",
   "start": 14.042,
   "end": 15.199,
   "id": "c8"
  },
  {
   "text": "每笔转账都要本人签字",
   "start": 15.368,
   "end": 17.561,
   "id": "c9"
  },
  {
   "text": "现在你可以签一份授权书",
   "start": 17.85,
   "end": 20.092,
   "id": "c10"
  },
  {
   "text": "允许助理每天替你付 100 元以内的账单",
   "start": 20.227,
   "end": 23.609,
   "id": "c11"
  },
  {
   "text": "授权书让生活方便很多",
   "start": 24.006,
   "end": 26.016,
   "id": "c12"
  },
  {
   "text": "可如果签的是",
   "start": 26.29,
   "end": 27.896,
   "id": "c13"
  },
  {
   "text": "允许持有人处理我全部财产",
   "start": 28.154,
   "end": 30.767,
   "id": "c14"
  },
  {
   "text": "后果比签错一笔转账严重得多",
   "start": 31.014,
   "end": 33.954,
   "id": "c15"
  },
  {
   "text": "比喻不成立的地方是",
   "start": 34.292,
   "end": 35.772,
   "id": "c16"
  },
  {
   "text": "纸质授权书要公证",
   "start": 36.048,
   "end": 37.83,
   "id": "c17"
  },
  {
   "text": "也能去银行撤销",
   "start": 38.072,
   "end": 39.511,
   "id": "c18"
  },
  {
   "text": "链上的委托签名立刻生效",
   "start": 39.867,
   "end": 41.906,
   "id": "c19"
  },
  {
   "text": "有时在多条链上同时生效",
   "start": 42.144,
   "end": 44.454,
   "id": "c20"
  },
  {
   "text": "新流程里有哪些角色",
   "start": 44.71,
   "end": 47.541,
   "id": "c21"
  },
  {
   "text": "先看 ERC-4337",
   "start": 47.561,
   "end": 49.288,
   "id": "c22"
  },
  {
   "text": "用户不直接发交易",
   "start": 49.57,
   "end": 51.315,
   "id": "c23"
  },
  {
   "text": "而是提交一个用户操作",
   "start": 51.393,
   "end": 53.186,
   "id": "c24"
  },
  {
   "text": "UserOperation",
   "start": 53.287,
   "end": 54.42,
   "id": "c25"
  },
  {
   "text": "Bundler 是打包者",
   "start": 54.778,
   "end": 56.152,
   "id": "c26"
  },
  {
   "text": "把很多个用户操作",
   "start": 56.36,
   "end": 57.951,
   "id": "c27"
  },
  {
   "text": "打包成一笔链上交易",
   "start": 57.971,
   "end": 59.721,
   "id": "c28"
  },
  {
   "text": "EntryPoint 是统一的入口合约",
   "start": 60.116,
   "end": 62.55,
   "id": "c29"
  },
  {
   "text": "它先验证 再执行",
   "start": 62.983,
   "end": 64.756,
   "id": "c30"
  },
  {
   "text": "第一步 问智能账户",
   "start": 65.131,
   "end": 67.106,
   "id": "c31"
  },
  {
   "text": "签名对不对",
   "start": 67.377,
   "end": 68.429,
   "id": "c32"
  },
  {
   "text": "第二步 问 Paymaster",
   "start": 68.782,
   "end": 70.507,
   "id": "c33"
  },
  {
   "text": "愿不愿意替用户付 Gas",
   "start": 70.629,
   "end": 72.574,
   "id": "c34"
  },
  {
   "text": "两步都通过",
   "start": 72.923,
   "end": 74.064,
   "id": "c35"
  },
  {
   "text": "才执行用户要做的调用",
   "start": 74.372,
   "end": 76.302,
   "id": "c36"
  },
  {
   "text": "最后结算 Gas",
   "start": 76.335,
   "end": 77.517,
   "id": "c37"
  },
  {
   "text": "验证和执行",
   "start": 77.77,
   "end": 79.287,
   "id": "c38"
  },
  {
   "text": "被拆成了两步",
   "start": 79.382,
   "end": 80.59,
   "id": "c39"
  },
  {
   "text": "每一步的边界",
   "start": 80.963,
   "end": 82.068,
   "id": "c40"
  },
  {
   "text": "都可能出错",
   "start": 82.136,
   "end": 83.093,
   "id": "c41"
  }
 ]
