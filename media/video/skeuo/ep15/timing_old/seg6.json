 "captions": [
  {
   "text": "按角色 各做一件事",
   "start": 1.645,
   "end": 3.575,
   "id": "c0"
  },
  {
   "text": "写智能账户的",
   "start": 3.94,
   "end": 5.114,
   "id": "c1"
  },
  {
   "text": "签名覆盖链 ID 和入口合约地址",
   "start": 5.304,
   "end": 8.207,
   "id": "c2"
  },
  {
   "text": "管理操作防跨链重放",
   "start": 8.404,
   "end": 10.233,
   "id": "c3"
  },
  {
   "text": "做钱包的",
   "start": 10.47,
   "end": 11.376,
   "id": "c4"
  },
  {
   "text": "只委托给自己审计过的实现",
   "start": 11.796,
   "end": 13.693,
   "id": "c5"
  },
  {
   "text": "批量逐项解码",
   "start": 13.847,
   "end": 15.201,
   "id": "c6"
  },
  {
   "text": "写合约的",
   "start": 15.49,
   "end": 16.512,
   "id": "c7"
  },
  {
   "text": "别再用交易发起者",
   "start": 16.54,
   "end": 18.123,
   "id": "c8"
  },
  {
   "text": "判断对方是普通地址",
   "start": 18.197,
   "end": 19.81,
   "id": "c9"
  },
  {
   "text": "托管方 不需要委托的热钱包",
   "start": 20.11,
   "end": 22.982,
   "id": "c10"
  },
  {
   "text": "一律拒签这类授权",
   "start": 23.135,
   "end": 24.742,
   "id": "c11"
  },
  {
   "text": "自有地址的代码一变",
   "start": 25.018,
   "end": 26.467,
   "id": "c12"
  },
  {
   "text": "立刻告警",
   "start": 26.586,
   "end": 27.395,
   "id": "c13"
  },
  {
   "text": "普通用户",
   "start": 27.61,
   "end": 28.524,
   "id": "c14"
  },
  {
   "text": "网站请你升级成智能账户 拒绝",
   "start": 28.751,
   "end": 31.713,
   "id": "c15"
  },
  {
   "text": "看不懂批量里的任何一步 不签",
   "start": 32.043,
   "end": 34.511,
   "id": "c16"
  },
  {
   "text": "用完的会话密钥和 Permit2 旧授权",
   "start": 34.79,
   "end": 37.984,
   "id": "c17"
  },
  {
   "text": "记得撤销",
   "start": 38.085,
   "end": 38.827,
   "id": "c18"
  },
  {
   "text": "回到开头的问题",
   "start": 39.09,
   "end": 40.464,
   "id": "c19"
  },
  {
   "text": "服务关了",
   "start": 40.699,
   "end": 41.496,
   "id": "c20"
  },
  {
   "text": "委托不会自动失效",
   "start": 41.591,
   "end": 43.301,
   "id": "c21"
  },
  {
   "text": "委托是写在地址上的链上状态",
   "start": 43.55,
   "end": 46.447,
   "id": "c22"
  },
  {
   "text": "要靠一笔新的授权清零",
   "start": 46.699,
   "end": 48.734,
   "id": "c23"
  },
  {
   "text": "那次事件里",
   "start": 48.97,
   "end": 50.024,
   "id": "c24"
  },
  {
   "text": "约 3 小时 50 分后",
   "start": 50.184,
