 "captions": [
  {
   "text": "账户变成合约",
   "start": 1.648,
   "end": 2.984,
   "id": "c0"
  },
  {
   "text": "登录和授权的方式也变了",
   "start": 3.088,
   "end": 5.068,
   "id": "c1"
  },
  {
   "text": "Passkey 用设备的安全芯片保存私钥",
   "start": 6.044,
   "end": 8.773,
   "id": "c2"
  },
  {
   "text": "用指纹或面容解锁",
   "start": 8.794,
   "end": 10.547,
   "id": "c3"
  },
  {
   "text": "它能挡住钓鱼网站偷密码",
   "start": 11.544,
   "end": 13.702,
   "id": "c4"
  },
  {
   "text": "挡不住恶意前端和恶意浏览器扩展",
   "start": 13.865,
   "end": 16.666,
   "id": "c5"
  },
  {
   "text": "你解锁以后",
   "start": 17.668,
   "end": 18.826,
   "id": "c6"
  },
  {
   "text": "它们照样能请你签攻击者构造的操作",
   "start": 19.108,
   "end": 21.564,
   "id": "c7"
  },
  {
   "text": "社交恢复",
   "start": 22.544,
   "end": 23.606,
   "id": "c8"
  },
  {
   "text": "由几位守护人一起恢复账户",
   "start": 23.686,
   "end": 26.083,
   "id": "c9"
  },
  {
   "text": "守护人不独立",
   "start": 27.06,
   "end": 28.349,
   "id": "c10"
  },
  {
   "text": "或者账号被盗",
   "start": 28.429,
   "end": 29.634,
   "id": "c11"
  },
  {
   "text": "恢复就成了入口",
   "start": 29.691,
   "end": 30.908,
   "id": "c12"
  },
  {
   "text": "Session Key 是会话密钥",
   "start": 31.888,
   "end": 33.772,
   "id": "c13"
  },
  {
   "text": "主密钥授权的一把临时密钥",
   "start": 33.947,
   "end": 35.915,
   "id": "c14"
  },
  {
   "text": "它的范围要限定四件事",
   "start": 36.908,
   "end": 38.816,
   "id": "c15"
  },
  {
   "text": "哪个合约",
   "start": 38.967,
   "end": 39.911,
   "id": "c16"
  },
  {
   "text": "哪个函数",
   "start": 39.955,
   "end": 40.899,
   "id": "c17"
  },
  {
   "text": "累计额度 有效期",
   "start": 40.955,
   "end": 42.863,
   "id": "c18"
  },
  {
   "text": "2025 年 2 月",
   "start": 43.848,
   "end": 45.113,
   "id": "c19"
  },
  {
   "text": "链游 Cardex 让所有用户",
   "start": 45.181,
   "end": 47.339,
   "id": "c20"
  },
  {
   "text": "共用同一把会话密钥",
   "start": 47.383,
   "end": 48.994,
   "id": "c21"
  },
  {
   "text": "这把密钥的私钥",
   "start": 49.972,
   "end": 51.225,
   "id": "c22"
  },
  {
   "text": "就写在前端代码里",
   "start": 51.245,
   "end": 52.832,
   "id": "c23"
  },
  {
   "text": "约 9000 个钱包受影响",
   "start": 53.816,
   "end": 55.545,
   "id": "c24"
  },
  {
   "text": "损失约 40 万美元",
   "start": 55.685,
   "end": 57.605,
   "id": "c25"
  },
  {
   "text": "权限只限于游戏合约",
   "start": 58.596,
   "end": 60.373,
   "id": "c26"
  },
  {
   "text": "用户的代币和 NFT 没有受影响",
   "start": 60.441,
   "end": 63.337,
   "id": "c27"
  },
  {
   "text": "范围限制起了作用",
   "start": 64.312,
   "end": 65.755,
   "id": "c28"
  },
  {
   "text": "意图 是用户只说目标",
   "start": 66.74,
   "end": 68.791,
   "id": "c29"
  },
  {
   "text": "由 Solver 去找成交路径",
   "start": 68.811,
   "end": 70.814,
   "id": "c30"
  },
  {
   "text": "比如 用 1 ETH 换至少 3000 USDC",
   "start": 71.808,
   "end": 75.418,
   "id": "c31"
  },
  {
   "text": "用户的风险",
   "start": 76.42,
   "end": 77.471,
   "id": "c32"
  },
  {
   "text": "是条件写得太宽",
   "start": 77.491,
   "end": 78.875,
   "id": "c33"
  },
  {
   "text": "最低成交量太低",
   "start": 78.955,
   "end": 80.411,
   "id": "c34"
  },
  {
   "text": "期限拖得太久",
   "start": 80.515,
   "end": 81.78,
   "id": "c35"
  },
  {
   "text": "协议的风险",
   "start": 82.736,
   "end": 83.692,
   "id": "c36"
  },
  {
   "text": "在 Solver 和结算合约之间的信任",
   "start": 83.712,
   "end": 86.096,
   "id": "c37"
  },
  {
   "text": "2023 年 2 月",
   "start": 87.084,
   "end": 88.337,
   "id": "c38"
  },
  {
   "text": "CoW Swap 新加入了一个 Solver",
   "start": 88.357,
   "end": 91.111,
   "id": "c39"
  },
  {
   "text": "它把结算合约里的 DAI",
   "start": 92.104,
   "end": 93.678,
   "id": "c40"
  },
  {
   "text": "无限授权给一个有漏洞的合约",
   "start": 93.723,
   "end": 96.155,
   "id": "c41"
  },
  {
   "text": "结算合约里约一周的手续费被取走",
   "start": 97.148,
   "end": 99.71,
   "id": "c42"
  },
  {
   "text": "约 16.6 万美元",
   "start": 99.802,
   "end": 101.246,
   "id": "c43"
  },
  {
   "text": "CoW DAO 罚没了这个 Solver",
   "start": 102.24,
   "end": 104.065,
   "id": "c44"
  },
  {
   "text": "的保证金来赔偿",
   "start": 104.085,
   "end": 105.529,
   "id": "c45"
  },
  {
   "text": "2025 年 3 月",
   "start": 106.516,
   "end": 107.758,
   "id": "c46"
  },
  {
   "text": "一些第三方 Resolver",
   "start": 107.778,
   "end": 109.471,
   "id": "c47"
  },
  {
   "text": "仍在用 1inch 已经弃用的",
   "start": 109.647,
   "end": 111.46,
   "id": "c48"
  },
  {
   "text": "Fusion v1 结算合约",
   "start": 111.48,
   "end": 113.174,
   "id": "c49"
  },
  {
   "text": "它们只凭调用者是结算合约",
   "start": 114.152,
   "end": 116.596,
   "id": "c50"
  },
  {
   "text": "就信任转发来的数据",
   "start": 116.616,
   "end": 118.131,
   "id": "c51"
  },
  {
   "text": "攻击者借此伪造订单",
   "start": 119.124,
   "end": 120.913,
   "id": "c52"
  },
  {
   "text": "约 500 万美元",
   "start": 121.076,
   "end": 122.246,
   "id": "c53"
  },
  {
   "text": "大部分经谈判退回",
   "start": 122.362,
   "end": 123.948,
   "id": "c54"
  },
  {
   "text": "Permit2 是 Uniswap",
   "start": 124.936,
   "end": 126.808,
   "id": "c55"
  },
  {
   "text": "部署的统一授权合约",
   "start": 126.828,
   "end": 128.534,
   "id": "c56"
  },
  {
   "text": "只要你把某个代币无限授权给它",
   "start": 129.524,
   "end": 131.801,
   "id": "c57"
  },
  {
   "text": "之后一个链下签名",
   "start": 131.976,
   "end": 134.015,
   "id": "c58"
  },
  {
   "text": "就能转走这个代币",
   "start": 134.107,
   "end": 135.408,
   "id": "c59"
  },
  {
   "text": "2024 年 10 月",
   "start": 136.392,
   "end": 137.693,
   "id": "c60"
  },
  {
   "text": "一名 PEPE 持有者签了 Permit2 钓鱼签名",
   "start": 137.832,
   "end": 141.3,
   "id": "c61"
  },
  {
   "text": "损失约 140 万美元",
   "start": 141.344,
   "end": 143.288,
   "id": "c62"
  },
  {
   "text": "没有发现 Permit2 合约本身被攻破",
   "start": 144.268,
   "end": 147.247,
   "id": "c63"
  },
  {
   "text": "风险来自无限授权加上链下签名",
   "start": 147.387,
   "end": 150.378,
   "id": "c64"
  }
