 "captions": [
  {
   "text": "按角色 各做一件事",
   "start": 1.648,
   "end": 3.591,
   "id": "c0"
  },
  {
   "text": "写智能账户的",
   "start": 4.58,
   "end": 5.773,
   "id": "c1"
  },
  {
   "text": "签名覆盖链 ID 和入口合约地址",
   "start": 5.889,
   "end": 8.69,
   "id": "c2"
  },
  {
   "text": "管理操作防跨链重放",
   "start": 8.865,
   "end": 10.607,
   "id": "c3"
  },
  {
   "text": "做钱包的",
   "start": 11.592,
   "end": 12.619,
   "id": "c4"
  },
  {
   "text": "只委托给自己审计过的实现",
   "start": 12.663,
   "end": 14.726,
   "id": "c5"
  },
  {
   "text": "批量逐项解码",
   "start": 14.758,
   "end": 16.166,
   "id": "c6"
  },
  {
   "text": "写合约的",
   "start": 17.164,
   "end": 18.096,
   "id": "c7"
  },
  {
   "text": "别再用交易发起者",
   "start": 18.14,
   "end": 19.488,
   "id": "c8"
  },
  {
   "text": "判断对方是普通地址",
   "start": 19.664,
   "end": 21.453,
   "id": "c9"
  },
  {
   "text": "托管方 不需要委托的热钱包",
   "start": 22.448,
   "end": 24.808,
   "id": "c10"
  },
  {
   "text": "一律拒签这类授权",
   "start": 24.852,
   "end": 26.427,
   "id": "c11"
  },
  {
   "text": "自有地址的代码一变",
   "start": 26.46,
   "end": 27.844,
   "id": "c12"
  },
  {
   "text": "立刻告警",
   "start": 27.876,
   "end": 28.725,
   "id": "c13"
  },
  {
   "text": "普通用户",
   "start": 29.724,
   "end": 30.679,
   "id": "c14"
  },
  {
   "text": "网站请你升级成智能账户 拒绝",
   "start": 30.938,
   "end": 33.953,
   "id": "c15"
  },
  {
   "text": "看不懂批量里的任何一步 不签",
   "start": 34.116,
   "end": 36.513,
   "id": "c16"
  },
  {
   "text": "用完的会话密钥和 Permit2 旧授权",
   "start": 37.48,
   "end": 40.471,
   "id": "c17"
  },
  {
   "text": "记得撤销",
   "start": 40.492,
   "end": 41.34,
   "id": "c18"
  },
  {
   "text": "回到开头的问题",
   "start": 42.332,
   "end": 43.68,
   "id": "c19"
  },
  {
   "text": "服务关了",
   "start": 43.736,
   "end": 44.692,
   "id": "c20"
  },
  {
   "text": "委托不会自动失效",
   "start": 44.867,
   "end": 46.287,
   "id": "c21"
  },
  {
   "text": "委托是写在地址上的链上状态",
   "start": 47.28,
   "end": 49.723,
   "id": "c22"
  },
  {
   "text": "要靠一笔新的授权清零",
   "start": 49.851,
   "end": 51.854,
   "id": "c23"
  },
  {
   "text": "那次事件里",
   "start": 52.852,
   "end": 53.938,
   "id": "c24"
  },
  {
   "text": "约 3 小时 50 分后",
   "start": 54.09,
   "end": 55.533,
   "id": "c25"
  },
  {
   "text": "委托才被清零",
   "start": 55.649,
   "end": 56.784,
   "id": "c26"
  },
  {
   "text": "停掉链下服务",
   "start": 57.776,
   "end": 59.041,
   "id": "c27"
  },
  {
   "text": "无法撤销链上的委托",
   "start": 59.121,
   "end": 60.684,
   "id": "c28"
  },
  {
   "text": "账户变成了合约",
   "start": 61.668,
   "end": 63.064,
   "id": "c29"
  },
  {
   "text": "签名就是在授权代码 签之前",
   "start": 63.144,
   "end": 65.886,
   "id": "c30"
  },
  {
   "text": "先看清它允许什么",
   "start": 65.906,
   "end": 67.314,
   "id": "c31"
  },
  {
   "text": "下一集讲共识层与链本身的安全",
   "start": 68.296,
   "end": 70.894,
   "id": "c32"
  }
