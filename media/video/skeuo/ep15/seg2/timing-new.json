 "captions": [
  {
   "text": "先给准确的说法",
   "start": 1.648,
   "end": 3.103,
   "id": "c0"
  },
  {
   "text": "账户抽象",
   "start": 4.1,
   "end": 5.222,
   "id": "c1"
  },
  {
   "text": "是让合约代码来决定",
   "start": 5.254,
   "end": 7.151,
   "id": "c2"
  },
  {
   "text": "账户怎么验证",
   "start": 7.29,
   "end": 8.46,
   "id": "c3"
  },
  {
   "text": "怎么执行",
   "start": 8.54,
   "end": 9.472,
   "id": "c4"
  },
  {
   "text": "协议不再写死",
   "start": 10.464,
   "end": 11.729,
   "id": "c5"
  },
  {
   "text": "一把私钥签一笔交易",
   "start": 11.868,
   "end": 13.3,
   "id": "c6"
  },
  {
   "text": "打个比方",
   "start": 14.284,
   "end": 15.239,
   "id": "c7"
  },
  {
   "text": "以前去银行",
   "start": 16.376,
   "end": 17.51,
   "id": "c8"
  },
  {
   "text": "每笔转账都要本人签字",
   "start": 17.602,
   "end": 19.581,
   "id": "c9"
  },
  {
   "text": "现在你可以签一份授权书",
   "start": 20.58,
   "end": 22.333,
   "id": "c10"
  },
  {
   "text": "允许助理每天替你付 100 元以内的账单",
   "start": 22.508,
   "end": 25.143,
   "id": "c11"
  },
  {
   "text": "授权书让生活方便很多",
   "start": 26.128,
   "end": 28.167,
   "id": "c12"
  },
  {
   "text": "可如果签的是",
   "start": 29.156,
   "end": 30.29,
   "id": "c13"
  },
  {
   "text": "允许持有人处理我全部财产",
   "start": 30.537,
   "end": 32.564,
   "id": "c14"
  },
  {
   "text": "后果比签错一笔转账严重得多",
   "start": 32.787,
   "end": 34.873,
   "id": "c15"
  },
  {
   "text": "比喻不成立的地方是",
   "start": 35.856,
   "end": 37.442,
   "id": "c16"
  },
  {
   "text": "纸质授权书要公证",
   "start": 37.534,
   "end": 39.097,
   "id": "c17"
  },
  {
   "text": "也能去银行撤销",
   "start": 39.177,
   "end": 40.49,
   "id": "c18"
  },
  {
   "text": "链上的委托签名立刻生效",
   "start": 41.476,
   "end": 43.527,
   "id": "c19"
  },
  {
   "text": "有时在多条链上同时生效",
   "start": 43.714,
   "end": 46.015,
   "id": "c20"
  },
  {
   "text": "新流程里有哪些角色",
   "start": 47.0,
   "end": 49.074,
   "id": "c21"
  },
  {
   "text": "先看 ERC-4337",
   "start": 49.45,
   "end": 51.548,
   "id": "c22"
  },
  {
   "text": "用户不直接发交易",
   "start": 52.524,
   "end": 54.039,
   "id": "c23"
  },
  {
   "text": "而是提交一个用户操作",
   "start": 54.131,
   "end": 55.706,
   "id": "c24"
  },
  {
   "text": "UserOperation",
   "start": 55.738,
   "end": 56.956,
   "id": "c25"
  },
  {
   "text": "Bundler 是打包者",
   "start": 57.952,
   "end": 59.181,
   "id": "c26"
  },
  {
   "text": "把很多个用户操作",
   "start": 59.237,
   "end": 60.503,
   "id": "c27"
  },
  {
   "text": "打包成一笔链上交易",
   "start": 60.523,
   "end": 62.122,
   "id": "c28"
  },
  {
   "text": "EntryPoint 是统一的入口合约",
   "start": 63.116,
   "end": 65.512,
   "id": "c29"
  },
  {
   "text": "它先验证 再执行",
   "start": 65.556,
   "end": 67.309,
   "id": "c30"
  },
  {
   "text": "第一步 问智能账户",
   "start": 68.28,
   "end": 70.14,
   "id": "c31"
  },
  {
   "text": "签名对不对",
   "start": 70.208,
   "end": 71.259,
   "id": "c32"
  },
  {
   "text": "第二步 问 Paymaster",
   "start": 72.244,
   "end": 74.318,
   "id": "c33"
  },
  {
   "text": "愿不愿意替用户付 Gas",
   "start": 74.517,
   "end": 76.461,
   "id": "c34"
  },
  {
   "text": "两步都通过",
   "start": 77.432,
   "end": 78.459,
   "id": "c35"
  },
  {
   "text": "才执行用户要做的调用",
   "start": 78.479,
   "end": 80.435,
   "id": "c36"
  },
  {
   "text": "最后结算 Gas",
   "start": 80.455,
   "end": 81.768,
   "id": "c37"
  },
  {
   "text": "验证和执行",
   "start": 82.74,
   "end": 84.041,
   "id": "c38"
  },
  {
   "text": "被拆成了两步",
   "start": 84.109,
   "end": 85.231,
   "id": "c39"
  },
  {
   "text": "每一步的边界",
   "start": 86.2,
   "end": 87.429,
   "id": "c40"
  },
  {
   "text": "都可能出错",
   "start": 87.533,
   "end": 88.524,
   "id": "c41"
  }
 ]
