 "captions": [
  {
   "text": "重入的入口",
   "start": 1.55,
   "end": 2.701,
   "id": "c0"
  },
  {
   "text": "不只是转 ETH",
   "start": 2.756,
   "end": 4.424,
   "id": "c1"
  },
  {
   "text": "2020 年 4 月的 imBTC",
   "start": 4.822,
   "end": 7.544,
   "id": "c2"
  },
  {
   "text": "是一种 ERC-777 代币",
   "start": 7.792,
   "end": 9.224,
   "id": "c3"
  },
  {
   "text": "转账时 会回调持有人注册的钩子",
   "start": 9.244,
   "end": 13.658,
   "id": "c4"
  },
  {
   "text": "借贷协议 Lendf.Me 的存款函数",
   "start": 14.0,
   "end": 17.51,
   "id": "c5"
  },
  {
   "text": "返回时用旧值写回余额",
   "start": 17.916,
   "end": 20.553,
   "id": "c6"
  },
  {
   "text": "抵押记录因此虚高",
   "start": 20.94,
   "end": 22.503,
   "id": "c7"
  },
  {
   "text": "攻击者借走约 2500 万美元的资产",
   "start": 22.863,
   "end": 26.262,
   "id": "c8"
  },
  {
   "text": "按事发时估值",
   "start": 26.392,
   "end": 27.689,
   "id": "c9"
  },
  {
   "text": "据 The Block 报道",
   "start": 28.404,
   "end": 29.614,
   "id": "c10"
  },
  {
   "text": "资金后来已归还",
   "start": 29.784,
   "end": 31.427,
   "id": "c11"
  },
  {
   "text": "在 BNB Chain 上",
   "start": 31.8,
   "end": 33.168,
   "id": "c12"
  },
  {
   "text": "很多项目分叉自以太坊协议",
   "start": 33.319,
   "end": 35.575,
   "id": "c13"
  },
  {
   "text": "原协议只接受白名单代币",
   "start": 35.945,
   "end": 38.314,
   "id": "c14"
  },
  {
   "text": "分叉项目放开成任意代币都能上架",
   "start": 38.47,
   "end": 41.675,
   "id": "c15"
  },
  {
   "text": "却没给存款函数加锁",
   "start": 42.049,
   "end": 44.027,
   "id": "c16"
  },
  {
   "text": "攻击者上架一个自己部署的代币",
   "start": 44.31,
   "end": 46.951,
   "id": "c17"
  },
  {
   "text": "在转账函数里回调存款",
   "start": 47.15,
   "end": 49.457,
   "id": "c18"
  },
  {
   "text": "同一笔资产被记了两次",
   "start": 49.657,
   "end": 51.69,
   "id": "c19"
  },
  {
   "text": "允许任意代币",
   "start": 52.061,
   "end": 53.392,
   "id": "c20"
  },
  {
   "text": "就等于允许任意回调",
   "start": 53.573,
   "end": 55.664,
   "id": "c21"
  },
  {
   "text": "上架流程本身",
   "start": 55.899,
   "end": 57.262,
   "id": "c22"
  },
  {
   "text": "就是安全边界",
   "start": 57.282,
   "end": 58.486,
   "id": "c23"
  },
  {
   "text": "2024 年 9 月的 Penpie 也类似",
   "start": 58.847,
   "end": 61.323,
   "id": "c24"
  },
  {
   "text": "损失约 2700 万美元",
   "start": 61.506,
   "end": 63.684,
   "id": "c25"
  },
  {
   "text": "攻击者无许可创建市场",
   "start": 63.93,
   "end": 66.124,
   "id": "c26"
  },
  {
   "text": "市场用了恶意代币",
   "start": 66.225,
   "end": 67.75,
   "id": "c27"
  },
  {
   "text": "批量领取奖励的函数没有锁",
   "start": 67.99,
   "end": 70.129,
   "id": "c28"
  },
  {
   "text": "攻击者在回调里存入资产",
   "start": 70.434,
   "end": 72.708,
   "id": "c29"
  },
  {
   "text": "把存款变成了奖励",
   "start": 72.786,
   "end": 74.566,
   "id": "c30"
  },
  {
   "text": "所以审计的第一步",
   "start": 74.86,
   "end": 77.225,
   "id": "c31"
  },
  {
   "text": "是列出所有外部调用",
   "start": 77.245,
   "end": 78.589,
   "id": "c32"
  },
  {
   "text": "代币转账",
   "start": 78.934,
   "end": 79.808,
   "id": "c33"
  },
  {
   "text": "NFT 安全转账 回调",
   "start": 80.009,
   "end": 82.392,
   "id": "c34"
  },
  {
   "text": "低级 call",
   "start": 82.564,
   "end": 83.23,
   "id": "c35"
  },
  {
   "text": "一个都不漏",
   "start": 83.483,
   "end": 84.311,
   "id": "c36"
  },
  {
   "text": "然后对每一处问两句",
   "start": 84.688,
   "end": 86.281,
   "id": "c37"
  },
  {
   "text": "调用之前",
   "start": 86.661,
   "end": 87.696,
   "id": "c38"
  },
  {
   "text": "相关状态都更新到最终值了吗",
   "start": 87.716,
   "end": 90.464,
   "id": "c39"
  },
  {
   "text": "读写同一状态的入口",
   "start": 91.085,
   "end": 93.02,
   "id": "c40"
  },
  {
   "text": "共用同一把锁吗",
   "start": 93.206,
   "end": 94.639,
   "id": "c41"
  }
 ]
