 "captions": [
  {
   "text": "2016 年 6 月",
   "start": 1.642,
   "end": 2.944,
   "id": "c0"
  },
  {
   "text": "以太坊上的 The DAO",
   "start": 3.117,
   "end": 4.651,
   "id": "c1"
  },
  {
   "text": "被提走了约 360 万 ETH",
   "start": 4.828,
   "end": 7.64,
   "id": "c2"
  },
  {
   "text": "按事发时的价格",
   "start": 7.85,
   "end": 9.575,
   "id": "c3"
  },
  {
   "text": "约 6000 万美元",
   "start": 9.745,
   "end": 11.764,
   "id": "c4"
  },
  {
   "text": "合约没有被破解",
   "start": 11.99,
   "end": 14.157,
   "id": "c5"
  },
  {
   "text": "它只是把两行代码的顺序 写反了",
   "start": 14.37,
   "end": 17.716,
   "id": "c6"
  },
  {
   "text": "先猜一道题",
   "start": 17.95,
   "end": 18.921,
   "id": "c7"
  },
  {
   "text": "一个银行合约",
   "start": 19.305,
   "end": 20.674,
   "id": "c8"
  },
  {
   "text": "金库里有 10 个 ETH",
   "start": 21.184,
   "end": 23.309,
   "id": "c9"
  },
  {
   "text": "你在里面的余额 是 1 个",
   "start": 23.45,
   "end": 25.858,
   "id": "c10"
  },
  {
   "text": "你只调用一次取款函数",
   "start": 26.243,
   "end": 28.253,
   "id": "c11"
  },
  {
   "text": "最多能取走多少",
   "start": 28.392,
   "end": 29.879,
   "id": "c12"
  },
  {
   "text": "答案是 全部 10 个",
   "start": 30.505,
   "end": 32.97,
   "id": "c13"
  },
  {
   "text": "前提有两个",
   "start": 33.27,
   "end": 34.417,
   "id": "c14"
  },
  {
   "text": "银行先转账 后清零",
   "start": 34.572,
   "end": 36.845,
   "id": "c15"
  },
  {
   "text": "而你 是一个合约",
   "start": 37.151,
   "end": 39.065,
   "id": "c16"
  },
  {
   "text": "你每收到一笔钱",
   "start": 39.424,
   "end": 40.617,
   "id": "c17"
  },
  {
   "text": "就在收款的那一刻",
   "start": 40.889,
   "end": 42.171,
   "id": "c18"
  },
  {
   "text": "再调用一次取款",
   "start": 42.314,
   "end": 43.661,
   "id": "c19"
  },
  {
   "text": "账本清零",
   "start": 43.95,
   "end": 45.072,
   "id": "c20"
  },
  {
   "text": "要等到所有嵌套调用都返回之后",
   "start": 45.165,
   "end": 47.877,
   "id": "c21"
  },
  {
   "text": "这就是重入",
   "start": 48.263,
   "end": 49.764,
   "id": "c22"
  },
  {
   "text": "最古老 也最常复发的合约漏洞",
   "start": 49.96,
   "end": 52.983,
   "id": "c23"
  },
  {
   "text": "这一集讲三件事",
   "start": 53.368,
   "end": 55.066,
   "id": "c24"
  },
  {
   "text": "控制权在哪里交出去",
   "start": 55.326,
   "end": 57.359,
   "id": "c25"
  },
  {
   "text": "重入有哪几种",
   "start": 57.6,
   "end": 59.3,
   "id": "c26"
  },
  {
   "text": "怎样把顺序写对",
   "start": 59.509,
   "end": 61.101,
   "id": "c27"
  }
 ]
}