 "captions": [
  {
   "text": "2016 年 6 月",
   "start": 1.648,
   "end": 2.901,
   "id": "c0"
  },
  {
   "text": "以太坊上的 The DAO",
   "start": 2.921,
   "end": 4.246,
   "id": "c1"
  },
  {
   "text": "被提走了约 360 万 ETH",
   "start": 4.279,
   "end": 6.199,
   "id": "c2"
  },
  {
   "text": "按事发时的价格",
   "start": 7.172,
   "end": 8.639,
   "id": "c3"
  },
  {
   "text": "约 6000 万美元",
   "start": 8.731,
   "end": 10.104,
   "id": "c4"
  },
  {
   "text": "合约没有被破解",
   "start": 11.088,
   "end": 12.436,
   "id": "c5"
  },
  {
   "text": "它只是把两行代码的顺序 写反了",
   "start": 13.42,
   "end": 16.578,
   "id": "c6"
  },
  {
   "text": "先猜一道题",
   "start": 17.552,
   "end": 18.876,
   "id": "c7"
  },
  {
   "text": "一个银行合约",
   "start": 19.86,
   "end": 20.947,
   "id": "c8"
  },
  {
   "text": "金库里有 10 个 ETH",
   "start": 20.967,
   "end": 22.506,
   "id": "c9"
  },
  {
   "text": "你在里面的余额 是 1 个",
   "start": 22.869,
   "end": 25.027,
   "id": "c10"
  },
  {
   "text": "你只调用一次取款函数",
   "start": 26.008,
   "end": 27.844,
   "id": "c11"
  },
  {
   "text": "最多能取走多少",
   "start": 28.031,
   "end": 29.309,
   "id": "c12"
  },
  {
   "text": "答案是 全部 10 个",
   "start": 30.588,
   "end": 32.4,
   "id": "c13"
  },
  {
   "text": "前提有两个",
   "start": 33.376,
   "end": 34.462,
   "id": "c14"
  },
  {
   "text": "银行先转账 后清零",
   "start": 34.626,
   "end": 36.772,
   "id": "c15"
  },
  {
   "text": "而你 是一个合约",
   "start": 37.135,
   "end": 38.924,
   "id": "c16"
  },
  {
   "text": "你每收到一笔钱",
   "start": 39.908,
   "end": 41.244,
   "id": "c17"
  },
  {
   "text": "就在收款的那一刻",
   "start": 41.289,
   "end": 42.625,
   "id": "c18"
  },
  {
   "text": "再调用一次取款",
   "start": 42.765,
   "end": 43.97,
   "id": "c19"
  },
  {
   "text": "账本清零",
   "start": 44.952,
   "end": 46.062,
   "id": "c20"
  },
  {
   "text": "要等到所有嵌套调用都返回之后",
   "start": 46.202,
   "end": 48.931,
   "id": "c21"
  },
  {
   "text": "这就是重入",
   "start": 49.924,
   "end": 50.939,
   "id": "c22"
  },
  {
   "text": "最古老 也最常复发的合约漏洞",
   "start": 51.314,
   "end": 54.008,
   "id": "c23"
  },
  {
   "text": "这一集讲三件事",
   "start": 54.992,
   "end": 56.435,
   "id": "c24"
  },
  {
   "text": "控制权在哪里交出去",
   "start": 56.67,
   "end": 58.4,
   "id": "c25"
  },
  {
   "text": "重入有哪几种",
   "start": 58.492,
   "end": 59.733,
   "id": "c26"
  },
  {
   "text": "怎样把顺序写对",
   "start": 59.754,
   "end": 61.043,
   "id": "c27"
  }
 ]
}