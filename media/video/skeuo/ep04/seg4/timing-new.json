 "captions": [
  {
   "text": "怎么防",
   "start": 1.648,
   "end": 2.341,
   "id": "c0"
  },
  {
   "text": "首选 是 CEI 模式",
   "start": 2.693,
   "end": 5.149,
   "id": "c1"
  },
  {
   "text": "CEI 是三个词 检查",
   "start": 6.14,
   "end": 8.524,
   "id": "c2"
  },
  {
   "text": "修改状态",
   "start": 8.592,
   "end": 9.607,
   "id": "c3"
  },
  {
   "text": "外部交互",
   "start": 9.687,
   "end": 10.572,
   "id": "c4"
  },
  {
   "text": "函数按这个顺序写",
   "start": 10.947,
   "end": 12.652,
   "id": "c5"
  },
  {
   "text": "取款函数只改一处 把清零",
   "start": 13.656,
   "end": 16.54,
   "id": "c6"
  },
  {
   "text": "挪到转账之前",
   "start": 16.56,
   "end": 17.933,
   "id": "c7"
  },
  {
   "text": "这样重入进来时",
   "start": 18.916,
   "end": 20.3,
   "id": "c8"
  },
  {
   "text": "读到的余额是 0",
   "start": 20.416,
   "end": 21.669,
   "id": "c9"
  },
  {
   "text": "require 直接回滚",
   "start": 21.785,
   "end": 23.49,
   "id": "c10"
  },
  {
   "text": "交出控制权放在最后",
   "start": 24.488,
   "end": 26.146,
   "id": "c11"
  },
  {
   "text": "此时账本已经一致",
   "start": 26.238,
   "end": 27.872,
   "id": "c12"
  },
  {
   "text": "第二道防线",
   "start": 28.86,
   "end": 29.875,
   "id": "c13"
  },
  {
   "text": "是重入锁",
   "start": 29.991,
   "end": 30.922,
   "id": "c14"
  },
  {
   "text": "执行期间",
   "start": 31.912,
   "end": 32.903,
   "id": "c15"
  },
  {
   "text": "再次进入任何一个加锁的函数",
   "start": 32.995,
   "end": 35.165,
   "id": "c16"
  },
  {
   "text": "都会回滚",
   "start": 35.209,
   "end": 36.117,
   "id": "c17"
  },
  {
   "text": "但锁有边界",
   "start": 37.1,
   "end": 38.281,
   "id": "c18"
  },
  {
   "text": "它只保护加了锁的函数",
   "start": 38.657,
   "end": 40.327,
   "id": "c19"
  },
  {
   "text": "不防只读重入",
   "start": 40.419,
   "end": 41.66,
   "id": "c20"
  },
  {
   "text": "跨合约还要共享同一把锁",
   "start": 41.847,
   "end": 44.398,
   "id": "c21"
  },
  {
   "text": "0.8.24 起",
   "start": 45.36,
   "end": 46.84,
   "id": "c22"
  },
  {
   "text": "可以用瞬态存储做锁",
   "start": 46.86,
   "end": 48.578,
   "id": "c23"
  },
  {
   "text": "gas 更低",
   "start": 48.598,
   "end": 49.565,
   "id": "c24"
  },
  {
   "text": "但目标链必须支持 EIP-1153",
   "start": 50.548,
   "end": 54.122,
   "id": "c25"
  },
  {
   "text": "部署前要确认",
   "start": 54.238,
   "end": 55.48,
   "id": "c26"
  },
  {
   "text": "还有一种思路",
   "start": 56.48,
   "end": 57.614,
   "id": "c27"
  },
  {
   "text": "叫拉取式支付",
   "start": 57.73,
   "end": 58.983,
   "id": "c28"
  },
  {
   "text": "合约只记账",
   "start": 59.358,
   "end": 60.504,
   "id": "c29"
  },
  {
   "text": "由收款人自己来取",
   "start": 60.572,
   "end": 62.064,
   "id": "c30"
  },
  {
   "text": "合约不主动推送",
   "start": 63.06,
   "end": 64.456,
   "id": "c31"
  },
  {
   "text": "代价是用户要多走一步",
   "start": 64.56,
   "end": 66.718,
   "id": "c32"
  },
  {
   "text": "CEI 也有局限",
   "start": 67.696,
   "end": 69.27,
   "id": "c33"
  },
  {
   "text": "复杂函数里",
   "start": 69.646,
   "end": 70.816,
   "id": "c34"
  },
  {
   "text": "很难做到所有交互都在最后",
   "start": 70.979,
   "end": 73.113,
   "id": "c35"
  },
  {
   "text": "所以要做纵深防御 分四条",
   "start": 74.108,
   "end": 76.766,
   "id": "c36"
  },
  {
   "text": "一 把 CEI 当作默认写法",
   "start": 77.736,
   "end": 80.215,
   "id": "c37"
  },
  {
   "text": "二 所有修改共享状态的外部入口",
   "start": 81.196,
   "end": 84.378,
   "id": "c38"
  },
  {
   "text": "加同一把锁",
   "start": 84.41,
   "end": 85.616,
   "id": "c39"
  },
  {
   "text": "三 不在 view 函数里给出中间状态的关键价格",
   "start": 86.576,
   "end": 90.781,
   "id": "c40"
  },
  {
   "text": "必须给出",
   "start": 91.157,
   "end": 92.125,
   "id": "c41"
  },
  {
   "text": "就提供锁状态查询",
   "start": 92.145,
   "end": 93.743,
   "id": "c42"
  },
  {
   "text": "四 用不变量测试守住一件事",
   "start": 94.74,
   "end": 97.826,
   "id": "c43"
  },
  {
   "text": "任何调用序列之后",
   "start": 97.966,
   "end": 99.481,
   "id": "c44"
  },
  {
   "text": "合约余额都不少于用户余额之和",
   "start": 99.609,
   "end": 102.433,
   "id": "c45"
  },
  {
   "text": "修复还要用代码验证",
   "start": 103.408,
   "end": 105.268,
   "id": "c46"
  },
  {
   "text": "同一个攻击测试",
   "start": 105.643,
   "end": 106.968,
   "id": "c47"
  },
  {
   "text": "在漏洞版上要能提走资金",
   "start": 107.024,
   "end": 109.266,
   "id": "c48"
  },
  {
   "text": "在修复版上要回滚",
   "start": 109.334,
   "end": 110.837,
   "id": "c49"
  },
  {
   "text": "只跑通修复版",
   "start": 111.812,
   "end": 113.089,
   "id": "c50"
  },
  {
   "text": "无法证明测试真的覆盖了漏洞",
   "start": 113.252,
   "end": 115.648,
   "id": "c51"
  },
  {
   "text": "最后 锁写对了",
   "start": 116.64,
   "end": 118.417,
   "id": "c52"
  },
  {
   "text": "也不一定生效",
   "start": 118.449,
   "end": 119.476,
   "id": "c53"
  },
  {
   "text": "2023 年 7 月",
   "start": 120.46,
   "end": 121.761,
   "id": "c54"
  },
  {
   "text": "Curve 的一些池子",
   "start": 121.829,
   "end": 123.189,
   "id": "c55"
  },
  {
   "text": "源码里写了重入锁",
   "start": 123.222,
   "end": 124.796,
   "id": "c56"
  },
  {
   "text": "但 Vyper 编译器的三个版本",
   "start": 125.768,
   "end": 127.747,
   "id": "c57"
  },
  {
   "text": "生成的锁不正确",
   "start": 127.803,
   "end": 129.164,
   "id": "c58"
  },
  {
   "text": "不同函数用了不同的锁槽",
   "start": 129.184,
   "end": 131.259,
   "id": "c59"
  },
  {
   "text": "攻击者对使用原生 ETH 的池子",
   "start": 132.228,
   "end": 134.505,
   "id": "c60"
  },
  {
   "text": "发起跨函数重入",
   "start": 134.561,
   "end": 136.16,
   "id": "c61"
  },
  {
   "text": "按多方公开复盘",
   "start": 137.128,
   "end": 138.702,
   "id": "c62"
  },
  {
   "text": "损失约 7000 万美元",
   "start": 138.818,
   "end": 140.702,
   "id": "c63"
  },
  {
   "text": "教训是 源码正确",
   "start": 141.692,
   "end": 143.659,
   "id": "c64"
  },
  {
   "text": "不等于字节码正确",
   "start": 143.823,
   "end": 145.29,
   "id": "c65"
  },
  {
   "text": "审计范围要包括编译器版本",
   "start": 145.665,
   "end": 148.169,
   "id": "c66"
  }
 ]
}