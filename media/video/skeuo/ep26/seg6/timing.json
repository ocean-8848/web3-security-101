 "captions": [
  {
   "text": "回到持有钱包的智能体",
   "start": 1.55,
   "end": 3.746,
   "id": "c0"
  },
  {
   "text": "防线不能放在模型里",
   "start": 4.104,
   "end": 5.976,
   "id": "c1"
  },
  {
   "text": "模型理解指令的方式不可靠",
   "start": 6.213,
   "end": 8.291,
   "id": "c2"
  },
  {
   "text": "要在钱包这一层",
   "start": 8.55,
   "end": 9.988,
   "id": "c3"
  },
  {
   "text": "用代码限制它",
   "start": 10.08,
   "end": 11.304,
   "id": "c4"
  },
  {
   "text": "第一 额度",
   "start": 11.663,
   "end": 12.855,
   "id": "c5"
  },
  {
   "text": "单笔和单日上限写在钱包工具或合约里",
   "start": 13.122,
   "end": 17.184,
   "id": "c6"
  },
  {
   "text": "超额要人工确认",
   "start": 17.424,
   "end": 19.096,
   "id": "c7"
  },
  {
   "text": "第二 白名单",
   "start": 19.494,
   "end": 20.663,
   "id": "c8"
  },
  {
   "text": "只允许向预设的地址和合约转账或授权",
   "start": 20.998,
   "end": 24.788,
   "id": "c9"
  },
  {
   "text": "第三 权限隔离",
   "start": 25.05,
   "end": 26.903,
   "id": "c10"
  },
  {
   "text": "智能体用独立的低额度钱包",
   "start": 27.113,
   "end": 29.528,
   "id": "c11"
  },
  {
   "text": "主资产不交给它",
   "start": 29.712,
   "end": 31.228,
   "id": "c12"
  },
  {
   "text": "第四 人工确认 新地址 授权",
   "start": 31.608,
   "end": 35.22,
   "id": "c13"
  },
  {
   "text": "大额操作走人工审批",
   "start": 35.372,
   "end": 37.427,
   "id": "c14"
  },
  {
   "text": "界面显示解码后的交易",
   "start": 37.68,
   "end": 39.743,
   "id": "c15"
  },
  {
   "text": "第五 输入隔离",
   "start": 40.05,
   "end": 41.715,
   "id": "c16"
  },
  {
   "text": "一个模型的输出",
   "start": 42.275,
   "end": 43.494,
   "id": "c17"
  },
  {
   "text": "不能直接成为另一个智能体的指令",
   "start": 43.56,
   "end": 45.998,
   "id": "c18"
  },
  {
   "text": "记忆写入要校验来源",
   "start": 46.27,
   "end": 48.392,
   "id": "c19"
  },
  {
   "text": "转账前从链上读取余额",
   "start": 48.951,
   "end": 51.439,
   "id": "c20"
  },
  {
   "text": "运维面板按特权系统加固",
   "start": 51.717,
   "end": 54.348,
   "id": "c21"
  },
  {
   "text": "给外部内容打上不可信标记 有用 但不够",
   "start": 54.65,
   "end": 58.73,
   "id": "c22"
  },
  {
   "text": "模型仍可能照做",
   "start": 59.095,
   "end": 60.553,
   "id": "c23"
  },
  {
   "text": "团队里 AI 写的代码和配置",
   "start": 60.79,
   "end": 63.21,
   "id": "c24"
  },
  {
   "text": "和人写的一样 走审查",
   "start": 63.405,
   "end": 65.693,
   "id": "c25"
  },
  {
   "text": "测试和审计",
   "start": 65.728,
   "end": 67.024,
   "id": "c26"
  },
  {
   "text": "作为用户",
   "start": 67.25,
   "end": 68.135,
   "id": "c27"
  },
  {
   "text": "不要把主钱包交给任何 AI 机器人 要用",
   "start": 68.36,
   "end": 72.045,
   "id": "c28"
  },
  {
   "text": "就给它一个只放少量资金的独立钱包",
   "start": 72.236,
   "end": 75.588,
   "id": "c29"
  },
  {
   "text": "回到开头的问题",
   "start": 75.87,
   "end": 77.242,
   "id": "c30"
  },
  {
   "text": "写在提示词里的规则",
   "start": 77.45,
   "end": 79.264,
   "id": "c31"
  },
  {
   "text": "会被说服绕过",
   "start": 79.415,
   "end": 81.047,
   "id": "c32"
  },
  {
   "text": "写在合约里的规则不会",
   "start": 81.27,
   "end": 83.365,
   "id": "c33"
  },
  {
   "text": "合约按代码拒绝这笔转账",
   "start": 83.507,
   "end": 85.959,
   "id": "c34"
  },
  {
   "text": "模型说什么都没用",
   "start": 86.114,
   "end": 87.479,
   "id": "c35"
  },
  {
   "text": "安全边界",
   "start": 87.826,
   "end": 88.955,
   "id": "c36"
  },
  {
   "text": "要放在模型之外",
   "start": 89.017,
   "end": 90.442,
   "id": "c37"
  },
  {
   "text": "下一集讲审计",
   "start": 90.75,
   "end": 92.639,
   "id": "c38"
  },
  {
   "text": "测试与开发流程",
   "start": 92.805,
   "end": 94.815,
   "id": "c39"
  }
 ]
}