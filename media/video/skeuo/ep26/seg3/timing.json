 "captions": [
  {
   "text": "一个持有钱包的智能体",
   "start": 1.55,
   "end": 3.551,
   "id": "c0"
  },
  {
   "text": "大致是这样工作的",
   "start": 3.65,
   "end": 5.183,
   "id": "c1"
  },
  {
   "text": "用户消息 网页",
   "start": 5.45,
   "end": 7.147,
   "id": "c2"
  },
  {
   "text": "长期记忆",
   "start": 7.304,
   "end": 8.219,
   "id": "c3"
  },
  {
   "text": "工具说明",
   "start": 8.376,
   "end": 9.235,
   "id": "c4"
  },
  {
   "text": "都会送进模型",
   "start": 9.421,
   "end": 10.601,
   "id": "c5"
  },
  {
   "text": "模型决定调用哪个工具",
   "start": 10.967,
   "end": 13.103,
   "id": "c6"
  },
  {
   "text": "比如钱包的转账和授权",
   "start": 13.608,
   "end": 15.702,
   "id": "c7"
  },
  {
   "text": "模型读到的每一种内容",
   "start": 16.064,
   "end": 18.029,
   "id": "c8"
  },
  {
   "text": "都是输入",
   "start": 18.071,
   "end": 18.879,
   "id": "c9"
  },
  {
   "text": "任何一种输入能影响它调用钱包",
   "start": 19.243,
   "end": 22.034,
   "id": "c10"
  },
  {
   "text": "就是一条攻击路径",
   "start": 22.217,
   "end": 23.759,
   "id": "c11"
  },
  {
   "text": "第一条 提示注入",
   "start": 24.112,
   "end": 25.855,
   "id": "c12"
  },
  {
   "text": "2026 年 5 月",
   "start": 26.253,
   "end": 27.631,
   "id": "c13"
  },
  {
   "text": "攻击者先往一个钱包里送了一枚会员 NFT",
   "start": 27.951,
   "end": 32.149,
   "id": "c14"
  },
  {
   "text": "借此提升了权限",
   "start": 32.451,
   "end": 34.045,
   "id": "c15"
  },
  {
   "text": "再诱导 Grok 回复一条转账指令",
   "start": 34.37,
   "end": 37.169,
   "id": "c16"
  },
  {
   "text": "Bankr 照着执行了",
   "start": 37.349,
   "end": 38.813,
   "id": "c17"
  },
  {
   "text": "一道屏蔽模型之间指令的防护",
   "start": 39.168,
   "end": 41.745,
   "id": "c18"
  },
  {
   "text": "在代码重写时被删掉了",
   "start": 42.059,
   "end": 44.223,
   "id": "c19"
  },
  {
   "text": "约 15 万到 20 万美元被转走",
   "start": 44.49,
   "end": 47.527,
   "id": "c20"
  },
  {
   "text": "约 80% 已经归还",
   "start": 47.665,
   "end": 49.946,
   "id": "c21"
  },
  {
   "text": "第二条 记忆注入",
   "start": 50.244,
   "end": 51.957,
   "id": "c22"
  },
  {
   "text": "攻击者在智能体能读到的地方",
   "start": 52.21,
   "end": 54.939,
   "id": "c23"
  },
  {
   "text": "写进一段伪造的历史记录",
   "start": 55.138,
   "end": 57.292,
   "id": "c24"
  },
  {
   "text": "智能体把它存进长期记忆",
   "start": 57.643,
   "end": 60.397,
   "id": "c25"
  },
  {
   "text": "之后的会话里",
   "start": 60.417,
   "end": 61.098,
   "id": "c26"
  },
  {
   "text": "当成事实来用",
   "start": 61.199,
   "end": 62.394,
   "id": "c27"
  },
  {
   "text": "没有任何新的恶意提示",
   "start": 62.741,
   "end": 64.766,
   "id": "c28"
  },
  {
   "text": "它也会执行未授权的转账",
   "start": 64.908,
   "end": 67.171,
   "id": "c29"
  },
  {
   "text": "普林斯顿和 Sentient 的研究者",
   "start": 67.529,
   "end": 70.0,
   "id": "c30"
  },
  {
   "text": "在 ElizaOS 智能体上证明了这一点",
   "start": 70.089,
   "end": 73.111,
   "id": "c31"
  },
  {
   "text": "第三条 工具和插件",
   "start": 73.33,
   "end": 75.404,
   "id": "c32"
  },
  {
   "text": "MCP 让模型连接外部工具",
   "start": 75.808,
   "end": 78.431,
   "id": "c33"
  },
  {
   "text": "工具说明",
   "start": 78.555,
   "end": 79.434,
   "id": "c34"
  },
  {
   "text": "用户看不到",
   "start": 79.529,
   "end": 80.391,
   "id": "c35"
  },
  {
   "text": "模型看得到",
   "start": 80.472,
   "end": 81.606,
   "id": "c36"
  },
  {
   "text": "2025 年 4 月",
   "start": 81.958,
   "end": 83.253,
   "id": "c37"
  },
  {
   "text": "Invariant Labs 演示",
   "start": 83.518,
   "end": 85.177,
   "id": "c38"
  },
  {
   "text": "恶意工具说明能诱导编程助手",
   "start": 85.435,
   "end": 88.104,
   "id": "c39"
  },
  {
   "text": "读取并外传 SSH 私钥",
   "start": 88.21,
   "end": 90.759,
   "id": "c40"
  },
  {
   "text": "PyPI 上还出现过一个钱包 MCP 包",
   "start": 91.124,
   "end": 94.239,
   "id": "c41"
  },
  {
   "text": "在多个版本里外传 Solana 私钥",
   "start": 94.372,
   "end": 96.69,
   "id": "c42"
  },
  {
   "text": "第四条 运维面板",
   "start": 96.93,
   "end": 98.846,
   "id": "c43"
  },
  {
   "text": "2025 年 3 月",
   "start": 99.256,
   "end": 101.479,
   "id": "c44"
  },
  {
   "text": "攻击者进入 AIXBT 的运维面板",
   "start": 101.499,
   "end": 103.421,
   "id": "c45"
  },
  {
   "text": "排进恶意回复",
   "start": 103.593,
   "end": 105.391,
   "id": "c46"
  },
  {
   "text": "触发打赏功能",
   "start": 105.411,
   "end": 106.781,
   "id": "c47"
  },
  {
   "text": "转走 55.5 ETH",
   "start": 106.801,
   "end": 108.396,
   "id": "c48"
  },
  {
   "text": "维护者称",
   "start": 108.745,
   "end": 109.493,
   "id": "c49"
  },
  {
   "text": "这不是在操纵 AI",
   "start": 109.776,
   "end": 111.364,
   "id": "c50"
  },
  {
   "text": "还有一种",
   "start": 111.59,
   "end": 112.428,
   "id": "c51"
  },
  {
   "text": "根本没人攻击",
   "start": 112.55,
   "end": 113.882,
   "id": "c52"
  },
  {
   "text": "2026 年 2 月",
   "start": 114.13,
   "end": 115.632,
   "id": "c53"
  },
  {
   "text": "交易智能体 Lobstar Wilde",
   "start": 115.968,
   "end": 118.14,
   "id": "c54"
  },
  {
   "text": "重建钱包状态出错",
   "start": 118.16,
   "end": 120.077,
   "id": "c55"
  },
  {
   "text": "把全部代币持仓转了出去",
   "start": 120.316,
   "end": 122.638,
   "id": "c56"
  },
  {
   "text": "约 25 万到 44 万美元的代币 据转述 是故障",
   "start": 122.91,
   "end": 127.273,
   "id": "c57"
  },
  {
   "text": "不是注入",
   "start": 127.329,
   "end": 127.973,
   "id": "c58"
  }
 ]
