 "captions": [
  {
   "text": "先给一句准确的说法",
   "start": 1.55,
   "end": 3.268,
   "id": "c0"
  },
  {
   "text": "AI 不是一类新漏洞",
   "start": 3.629,
   "end": 5.347,
   "id": "c1"
  },
  {
   "text": "它是一个放大器",
   "start": 5.672,
   "end": 6.994,
   "id": "c2"
  },
  {
   "text": "它让攻击者写钓鱼更快",
   "start": 7.363,
   "end": 9.61,
   "id": "c3"
  },
  {
   "text": "伪造视频更像",
   "start": 9.757,
   "end": 11.127,
   "id": "c4"
  },
  {
   "text": "找合约漏洞更便宜",
   "start": 11.315,
   "end": 13.102,
   "id": "c5"
  },
  {
   "text": "它也让防御者审计得更广",
   "start": 13.421,
   "end": 15.922,
   "id": "c6"
  },
  {
   "text": "监控得更快",
   "start": 15.953,
   "end": 17.073,
   "id": "c7"
  },
  {
   "text": "真正新的部分",
   "start": 17.488,
   "end": 18.788,
   "id": "c8"
  },
  {
   "text": "只有一个",
   "start": 18.942,
   "end": 19.784,
   "id": "c9"
  },
  {
   "text": "当 AI 智能体自己拿着钱包 说服它",
   "start": 20.01,
   "end": 23.359,
   "id": "c10"
  },
  {
   "text": "就成了转走资产的方法",
   "start": 23.471,
   "end": 25.376,
   "id": "c11"
  },
  {
   "text": "AI 智能体",
   "start": 25.686,
   "end": 26.714,
   "id": "c12"
  },
  {
   "text": "是能调用工具",
   "start": 26.744,
   "end": 28.229,
   "id": "c13"
  },
  {
   "text": "执行操作的大语言模型程序",
   "start": 28.288,
   "end": 30.658,
   "id": "c14"
  },
  {
   "text": "比如自动交易的机器人",
   "start": 31.031,
   "end": 32.963,
   "id": "c15"
  },
  {
   "text": "或者自动回复并打赏的机器人",
   "start": 33.114,
   "end": 35.809,
   "id": "c16"
  },
  {
   "text": "攻击它最直接的办法",
   "start": 36.03,
   "end": 37.672,
   "id": "c17"
  },
  {
   "text": "叫提示注入",
   "start": 37.802,
   "end": 38.956,
   "id": "c18"
  },
  {
   "text": "把指令藏在模型会读到的内容里",
   "start": 39.31,
   "end": 42.291,
   "id": "c19"
  },
  {
   "text": "让模型去执行攻击者的意图",
   "start": 42.638,
   "end": 45.18,
   "id": "c20"
  },
  {
   "text": "打个比方",
   "start": 45.525,
   "end": 46.192,
   "id": "c21"
  },
  {
   "text": "你雇了一个能干",
   "start": 46.699,
   "end": 48.231,
   "id": "c22"
  },
  {
   "text": "但极其听话的新助理",
   "start": 48.276,
   "end": 50.114,
   "id": "c23"
  },
  {
   "text": "还把公司的支付卡交给了他",
   "start": 50.286,
   "end": 52.375,
   "id": "c24"
  },
  {
   "text": "任何人走进办公室",
   "start": 52.704,
   "end": 54.177,
   "id": "c25"
  },
  {
   "text": "塞给他一张纸条",
   "start": 54.257,
   "end": 55.589,
   "id": "c26"
  },
  {
   "text": "写着老板说把钱转给我",
   "start": 55.664,
   "end": 57.865,
   "id": "c27"
  },
  {
   "text": "他都可能照做",
   "start": 57.958,
   "end": 59.155,
   "id": "c28"
  },
  {
   "text": "问题不在助理不够聪明",
   "start": 59.39,
   "end": 61.304,
   "id": "c29"
  },
  {
   "text": "而在你把支付卡",
   "start": 61.544,
   "end": 62.999,
   "id": "c30"
  },
  {
   "text": "交给了一个会被纸条说服的人",
   "start": 63.085,
   "end": 65.476,
   "id": "c31"
  },
  {
   "text": "这个比方有一处不成立",
   "start": 65.863,
   "end": 67.534,
   "id": "c32"
  },
  {
   "text": "真实的助理",
   "start": 67.83,
   "end": 68.849,
   "id": "c33"
  },
  {
   "text": "会记得谁是老板",
   "start": 69.04,
   "end": 70.401,
   "id": "c34"
  },
  {
   "text": "智能体的记忆",
   "start": 70.713,
   "end": 71.823,
   "id": "c35"
  },
  {
   "text": "本身也可能被人写进假内容",
   "start": 71.97,
   "end": 74.318,
   "id": "c36"
  },
