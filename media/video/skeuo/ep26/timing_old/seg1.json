 "captions": [
  {
   "text": "2024 年 11 月",
   "start": 1.55,
   "end": 3.268,
   "id": "c0"
  },
  {
   "text": "一个叫 Freysa 的 AI 智能体",
   "start": 3.544,
   "end": 5.8,
   "id": "c1"
  },
  {
   "text": "守着一笔奖池",
   "start": 5.967,
   "end": 7.349,
   "id": "c2"
  },
  {
   "text": "它只有一条规则",
   "start": 7.61,
   "end": 9.323,
   "id": "c3"
  },
  {
   "text": "绝不转账",
   "start": 9.512,
   "end": 10.623,
   "id": "c4"
  },
  {
   "text": "这是一场对抗游戏",
   "start": 10.967,
   "end": 12.744,
   "id": "c5"
  },
  {
   "text": "玩家的目标",
   "start": 12.967,
   "end": 14.026,
   "id": "c6"
  },
  {
   "text": "就是让它破例",
   "start": 14.304,
   "end": 15.505,
   "id": "c7"
  },
  {
   "text": "一名玩家伪造了一个新会话",
   "start": 15.901,
   "end": 18.043,
   "id": "c8"
  },
  {
   "text": "让它相信",
   "start": 18.442,
   "end": 19.462,
   "id": "c9"
  },
  {
   "text": "转账函数是用来收款的",
   "start": 19.499,
   "end": 21.694,
   "id": "c10"
  },
  {
   "text": "它照做了",
   "start": 21.93,
   "end": 22.992,
   "id": "c11"
  },
  {
   "text": "约 4.7 万美元的奖池被转走",
   "start": 23.178,
   "end": 25.858,
   "id": "c12"
  },
  {
   "text": "没有人破解代码",
   "start": 26.164,
   "end": 27.554,
   "id": "c13"
  },
  {
   "text": "也没有人偷私钥",
   "start": 27.682,
   "end": 29.251,
   "id": "c14"
  },
  {
   "text": "钱是被说服走的",
   "start": 29.585,
   "end": 31.097,
   "id": "c15"
  },
  {
   "text": "先猜一道题",
   "start": 31.31,
   "end": 32.281,
   "id": "c16"
  },
  {
   "text": "如果绝不转账这条规则",
   "start": 32.661,
   "end": 34.944,
   "id": "c17"
  },
  {
   "text": "写在提示词里",
   "start": 34.964,
   "end": 36.236,
   "id": "c18"
  },
  {
   "text": "同时也写在合约里",
   "start": 36.511,
   "end": 38.241,
   "id": "c19"
  },
  {
   "text": "玩家说服了模型",
   "start": 38.565,
   "end": 40.077,
   "id": "c20"
  },
  {
   "text": "钱还会被转走吗",
   "start": 40.202,
   "end": 41.838,
   "id": "c21"
  },
  {
   "text": "带着这个问题",
   "start": 42.505,
   "end": 44.178,
   "id": "c22"
  },
  {
   "text": "我们看看",
   "start": 44.381,
   "end": 44.767,
   "id": "c23"
  },
  {
   "text": "AI 给 Web3 安全带来了什么",
   "start": 44.787,
   "end": 47.134,
   "id": "c24"
  }
 ]
