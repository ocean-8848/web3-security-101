 "captions": [
  {
   "text": "先给准确的说法",
   "start": 1.55,
   "end": 2.807,
   "id": "c0"
  },
  {
   "text": "借贷协议靠一条不变量运转",
   "start": 3.05,
   "end": 5.626,
   "id": "c1"
  },
  {
   "text": "每个账户的抵押品",
   "start": 5.829,
   "end": 7.388,
   "id": "c2"
  },
  {
   "text": "打折以后",
   "start": 7.49,
   "end": 8.249,
   "id": "c3"
  },
  {
   "text": "要盖得住借款",
   "start": 8.32,
   "end": 9.582,
   "id": "c4"
  },
  {
   "text": "打折的比例",
   "start": 9.922,
   "end": 11.309,
   "id": "c5"
  },
  {
   "text": "叫清算阈值",
   "start": 11.329,
   "end": 12.446,
   "id": "c6"
  },
  {
   "text": "抵押品价值乘以清算阈值",
   "start": 12.786,
   "end": 15.148,
   "id": "c7"
  },
  {
   "text": "再除以借款",
   "start": 15.339,
   "end": 16.616,
   "id": "c8"
  },
  {
   "text": "就是健康因子",
   "start": 16.661,
   "end": 18.017,
   "id": "c9"
  },
  {
   "text": "健康因子大于 1",
   "start": 18.364,
   "end": 19.861,
   "id": "c10"
  },
  {
   "text": "账户安全",
   "start": 20.002,
   "end": 20.761,
   "id": "c11"
  },
  {
   "text": "小于 1 任何人都可以清算它",
   "start": 20.981,
   "end": 23.287,
   "id": "c12"
  },
  {
   "text": "清算 是第三方替账户偿还债务",
   "start": 23.624,
   "end": 26.843,
   "id": "c13"
  },
  {
   "text": "再以折扣拿走抵押品",
   "start": 27.057,
   "end": 29.131,
   "id": "c14"
  },
  {
   "text": "折扣 是给清算人的报酬",
   "start": 29.449,
   "end": 31.741,
   "id": "c15"
  },
  {
   "text": "回到 Euler",
   "start": 32.068,
   "end": 33.12,
   "id": "c16"
  },
  {
   "text": "按 Omniscia 和 BlockSec 的复盘",
   "start": 33.429,
   "end": 36.109,
   "id": "c17"
  },
  {
   "text": "捐赠以后",
   "start": 36.312,
   "end": 37.11,
   "id": "c18"
  },
  {
   "text": "账户已经资不抵债",
   "start": 37.247,
   "end": 38.839,
   "id": "c19"
  },
  {
   "text": "而 Euler 的清算折扣",
   "start": 39.07,
   "end": 41.038,
   "id": "c20"
  },
  {
   "text": "会随资不抵债的程度变大",
   "start": 41.164,
   "end": 43.384,
   "id": "c21"
  },
  {
   "text": "攻击者用另一个账户来清算它",
   "start": 43.781,
   "end": 46.093,
   "id": "c22"
  },
  {
   "text": "以很大的折扣拿走抵押品",
   "start": 46.294,
   "end": 48.358,
   "id": "c23"
  },
  {
   "text": "缺口越大",
   "start": 48.63,
   "end": 49.651,
   "id": "c24"
  },
  {
   "text": "折扣越大",
   "start": 49.751,
   "end": 50.655,
   "id": "c25"
  },
  {
   "text": "坏账 变成了利润",
   "start": 50.821,
   "end": 52.446,
   "id": "c26"
  },
  {
   "text": "整个协议也有一条不变量",
   "start": 52.788,
   "end": 54.736,
   "id": "c27"
  },
  {
   "text": "所有资产",
   "start": 54.952,
   "end": 55.821,
   "id": "c28"
  },
  {
   "text": "要盖得住所有存款人的债权",
   "start": 55.841,
   "end": 58.196,
   "id": "c29"
  },
  {
   "text": "盖不住的部分",
   "start": 58.43,
   "end": 59.446,
   "id": "c30"
  },
  {
   "text": "就是坏账",
   "start": 59.62,
   "end": 60.413,
   "id": "c31"
  },
  {
   "text": "坏账不一定来自攻击",
   "start": 60.65,
   "end": 62.618,
   "id": "c32"
  },
  {
   "text": "价格暴跌",
   "start": 62.96,
   "end": 63.898,
   "id": "c33"
  },
  {
   "text": "预言机延迟",
   "start": 64.112,
   "end": 65.21,
   "id": "c34"
  },
  {
   "text": "清算来不及",
   "start": 65.331,
   "end": 66.412,
   "id": "c35"
  },
  {
   "text": "都会留下坏账",
   "start": 66.546,
   "end": 67.571,
   "id": "c36"
  },
  {
   "text": "清算人是逐利的",
   "start": 67.81,
   "end": 69.528,
   "id": "c37"
  },
  {
   "text": "奖励覆盖不了 gas 和滑点",
   "start": 69.708,
   "end": 72.106,
   "id": "c38"
  },
  {
   "text": "就没人清算",
   "start": 72.126,
   "end": 73.15,
   "id": "c39"
  },
  {
   "text": "抵押品流动性不足",
   "start": 73.484,
   "end": 74.988,
   "id": "c40"
  },
  {
   "text": "清算人拿到手",
   "start": 75.446,
   "end": 76.716,
   "id": "c41"
  },
  {
   "text": "也卖不出好价钱",
   "start": 76.784,
   "end": 77.975,
   "id": "c42"
  },
  {
   "text": "再看一个例子",
   "start": 78.353,
   "end": 79.278,
   "id": "c43"
  },
  {
   "text": "2021 年 5 月",
   "start": 79.414,
   "end": 80.895,
   "id": "c44"
  },
  {
   "text": "BNB Chain 上的 Venus",
   "start": 81.099,
   "end": 82.921,
   "id": "c45"
  },
  {
   "text": "允许用户拿自己的治理代币 XVS 做抵押",
   "start": 83.014,
   "end": 87.079,
   "id": "c46"
  },
  {
   "text": "按 The Block 报道",
   "start": 87.45,
   "end": 88.636,
   "id": "c47"
  },
  {
   "text": "XVS 短时间里",
   "start": 88.813,
   "end": 90.6,
   "id": "c48"
  },
  {
   "text": "从约 76 美元涨到约 144 美元",
   "start": 90.682,
   "end": 94.191,
   "id": "c49"
  },
  {
   "text": "抵押能力跟着上涨",
   "start": 94.544,
   "end": 96.064,
   "id": "c50"
  },
  {
   "text": "有人借走了大量 BTC 和 ETH",
   "start": 96.338,
   "end": 99.337,
   "id": "c51"
  },
  {
   "text": "XVS 回落以后",
   "start": 99.649,
   "end": 100.582,
   "id": "c52"
  },
  {
   "text": "清算金额约 2 亿美元以上",
   "start": 100.602,
   "end": 104.08,
   "id": "c53"
  },
  {
   "text": "仍然留下约 9500 万美元以上的坏账",
   "start": 104.276,
   "end": 107.336,
   "id": "c54"
  },
  {
   "text": "项目方称",
   "start": 107.61,
   "end": 108.467,
   "id": "c55"
  },
  {
   "text": "价格可能被操纵",
   "start": 108.524,
   "end": 110.043,
   "id": "c56"
  },
  {
   "text": "这叫反身性",
   "start": 110.31,
   "end": 111.751,
   "id": "c57"
  },
  {
   "text": "价格上涨",
   "start": 112.046,
   "end": 113.056,
   "id": "c58"
  },
  {
   "text": "借款增加",
   "start": 113.171,
   "end": 114.116,
   "id": "c59"
  },
  {
   "text": "卖压增加",
   "start": 114.289,
   "end": 115.248,
   "id": "c60"
  },
  {
   "text": "价格下跌",
   "start": 115.509,
   "end": 116.451,
   "id": "c61"
  },
  {
   "text": "坏账出现",
   "start": 116.596,
   "end": 117.505,
   "id": "c62"
  },
  {
   "text": "所以 低流动性的抵押品",
   "start": 117.901,
   "end": 120.2,
   "id": "c63"
  },
  {
   "text": "要有供应上限和更低的抵押率",
   "start": 120.22,
   "end": 123.171,
   "id": "c64"
  }
 ]
}