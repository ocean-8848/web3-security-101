 "captions": [
  {
   "text": "先给准确的说法",
   "start": 1.648,
   "end": 3.103,
   "id": "c0"
  },
  {
   "text": "借贷协议靠一条不变量运转",
   "start": 4.1,
   "end": 6.472,
   "id": "c1"
  },
  {
   "text": "每个账户的抵押品",
   "start": 6.647,
   "end": 8.043,
   "id": "c2"
  },
  {
   "text": "打折以后",
   "start": 8.112,
   "end": 8.972,
   "id": "c3"
  },
  {
   "text": "要盖得住借款",
   "start": 9.04,
   "end": 10.115,
   "id": "c4"
  },
  {
   "text": "打折的比例",
   "start": 11.112,
   "end": 12.21,
   "id": "c5"
  },
  {
   "text": "叫清算阈值",
   "start": 12.35,
   "end": 13.686,
   "id": "c6"
  },
  {
   "text": "抵押品价值乘以清算阈值",
   "start": 14.668,
   "end": 17.183,
   "id": "c7"
  },
  {
   "text": "再除以借款",
   "start": 17.203,
   "end": 18.326,
   "id": "c8"
  },
  {
   "text": "就是健康因子",
   "start": 18.418,
   "end": 19.659,
   "id": "c9"
  },
  {
   "text": "健康因子大于 1",
   "start": 20.648,
   "end": 22.246,
   "id": "c10"
  },
  {
   "text": "账户安全",
   "start": 22.302,
   "end": 23.306,
   "id": "c11"
  },
  {
   "text": "小于 1 任何人都可以清算它",
   "start": 23.681,
   "end": 26.363,
   "id": "c12"
  },
  {
   "text": "清算 是第三方替账户偿还债务",
   "start": 27.348,
   "end": 30.422,
   "id": "c13"
  },
  {
   "text": "再以折扣拿走抵押品",
   "start": 30.467,
   "end": 32.137,
   "id": "c14"
  },
  {
   "text": "折扣 是给清算人的报酬",
   "start": 33.136,
   "end": 35.532,
   "id": "c15"
  },
  {
   "text": "回到 Euler",
   "start": 36.524,
   "end": 37.765,
   "id": "c16"
  },
  {
   "text": "按 Omniscia 和 BlockSec 的复盘",
   "start": 38.14,
   "end": 41.048,
   "id": "c17"
  },
  {
   "text": "捐赠以后",
   "start": 41.128,
   "end": 42.025,
   "id": "c18"
  },
  {
   "text": "账户已经资不抵债",
   "start": 42.045,
   "end": 43.548,
   "id": "c19"
  },
  {
   "text": "而 Euler 的清算折扣",
   "start": 44.544,
   "end": 46.143,
   "id": "c20"
  },
  {
   "text": "会随资不抵债的程度变大",
   "start": 46.163,
   "end": 48.083,
   "id": "c21"
  },
  {
   "text": "攻击者用另一个账户来清算它",
   "start": 49.084,
   "end": 51.254,
   "id": "c22"
  },
  {
   "text": "以很大的折扣拿走抵押品",
   "start": 51.441,
   "end": 53.551,
   "id": "c23"
  },
  {
   "text": "缺口越大",
   "start": 54.536,
   "end": 55.587,
   "id": "c24"
  },
  {
   "text": "折扣越大",
   "start": 55.75,
   "end": 56.777,
   "id": "c25"
  },
  {
   "text": "坏账 变成了利润",
   "start": 57.128,
   "end": 59.001,
   "id": "c26"
  },
  {
   "text": "整个协议也有一条不变量",
   "start": 59.988,
   "end": 61.955,
   "id": "c27"
  },
  {
   "text": "所有资产",
   "start": 62.107,
   "end": 63.17,
   "id": "c28"
  },
  {
   "text": "要盖得住所有存款人的债权",
   "start": 63.261,
   "end": 65.324,
   "id": "c29"
  },
  {
   "text": "盖不住的部分",
   "start": 66.304,
   "end": 67.557,
   "id": "c30"
  },
  {
   "text": "就是坏账",
   "start": 67.792,
   "end": 68.712,
   "id": "c31"
  },
  {
   "text": "坏账不一定来自攻击",
   "start": 69.692,
   "end": 71.243,
   "id": "c32"
  },
  {
   "text": "价格暴跌",
   "start": 72.24,
   "end": 73.219,
   "id": "c33"
  },
  {
   "text": "预言机延迟",
   "start": 73.347,
   "end": 74.517,
   "id": "c34"
  },
  {
   "text": "清算来不及",
   "start": 74.573,
   "end": 75.719,
   "id": "c35"
  },
  {
   "text": "都会留下坏账",
   "start": 75.835,
   "end": 76.933,
   "id": "c36"
  },
  {
   "text": "清算人是逐利的",
   "start": 77.932,
   "end": 79.399,
   "id": "c37"
  },
  {
   "text": "奖励覆盖不了 gas 和滑点",
   "start": 79.763,
   "end": 81.742,
   "id": "c38"
  },
  {
   "text": "就没人清算",
   "start": 81.774,
   "end": 82.742,
   "id": "c39"
  },
  {
   "text": "抵押品流动性不足",
   "start": 83.744,
   "end": 85.449,
   "id": "c40"
  },
  {
   "text": "清算人拿到手",
   "start": 85.648,
   "end": 86.937,
   "id": "c41"
  },
  {
   "text": "也卖不出好价钱",
   "start": 86.958,
   "end": 88.223,
   "id": "c42"
  },
  {
   "text": "再看一个例子",
   "start": 89.196,
   "end": 90.163,
   "id": "c43"
  },
  {
   "text": "2021 年 5 月",
   "start": 90.538,
   "end": 91.756,
   "id": "c44"
  },
  {
   "text": "BNB Chain 上的 Venus",
   "start": 91.86,
   "end": 93.578,
   "id": "c45"
  },
  {
   "text": "允许用户拿自己的治理代币 XVS 做抵押",
   "start": 93.658,
   "end": 96.78,
   "id": "c46"
  },
  {
   "text": "按 The Block 报道",
   "start": 97.744,
   "end": 99.021,
   "id": "c47"
  },
  {
   "text": "XVS 短时间里",
   "start": 99.16,
   "end": 100.699,
   "id": "c48"
  },
  {
   "text": "从约 76 美元涨到约 144 美元",
   "start": 100.732,
   "end": 103.771,
   "id": "c49"
  },
  {
   "text": "抵押能力跟着上涨",
   "start": 104.756,
   "end": 106.188,
   "id": "c50"
  },
  {
   "text": "有人借走了大量 BTC 和 ETH",
   "start": 106.232,
   "end": 108.664,
   "id": "c51"
  },
  {
   "text": "XVS 回落以后",
   "start": 109.656,
   "end": 111.195,
   "id": "c52"
  },
  {
   "text": "清算金额约 2 亿美元以上",
   "start": 111.37,
   "end": 113.385,
   "id": "c53"
  },
  {
   "text": "仍然留下约 9500 万美元以上的坏账",
   "start": 113.548,
   "end": 116.207,
   "id": "c54"
  },
  {
   "text": "项目方称",
   "start": 117.196,
   "end": 118.211,
   "id": "c55"
  },
  {
   "text": "价格可能被操纵",
   "start": 118.315,
   "end": 119.592,
   "id": "c56"
  },
  {
   "text": "这叫反身性",
   "start": 120.584,
   "end": 121.789,
   "id": "c57"
  },
  {
   "text": "价格上涨",
   "start": 122.165,
   "end": 123.073,
   "id": "c58"
  },
  {
   "text": "借款增加",
   "start": 123.105,
   "end": 124.156,
   "id": "c59"
  },
  {
   "text": "卖压增加",
   "start": 124.2,
   "end": 125.132,
   "id": "c60"
  },
  {
   "text": "价格下跌",
   "start": 125.296,
   "end": 126.239,
   "id": "c61"
  },
  {
   "text": "坏账出现",
   "start": 126.284,
   "end": 127.204,
   "id": "c62"
  },
  {
   "text": "所以 低流动性的抵押品",
   "start": 128.196,
   "end": 130.58,
   "id": "c63"
  },
  {
   "text": "要有供应上限和更低的抵押率",
   "start": 130.684,
   "end": 133.163,
   "id": "c64"
  }
 ]
