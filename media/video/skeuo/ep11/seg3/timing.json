 "captions": [
  {
   "text": "规则被组合利用",
   "start": 1.651,
   "end": 3.258,
   "id": "c0"
  },
  {
   "text": "不只发生在借贷里",
   "start": 3.34,
   "end": 5.01,
   "id": "c1"
  },
  {
   "text": "治理攻击",
   "start": 5.21,
   "end": 6.267,
   "id": "c2"
  },
  {
   "text": "是攻击者拿到足够的投票权",
   "start": 6.539,
   "end": 9.415,
   "id": "c3"
  },
  {
   "text": "通过恶意提案",
   "start": 9.601,
   "end": 11.022,
   "id": "c4"
  },
  {
   "text": "合法地转走协议资产",
   "start": 11.121,
   "end": 13.076,
   "id": "c5"
  },
  {
   "text": "2022 年 4 月",
   "start": 13.374,
   "end": 14.798,
   "id": "c6"
  },
  {
   "text": "以太坊上的 Beanstalk",
   "start": 15.006,
   "end": 16.729,
   "id": "c7"
  },
  {
   "text": "它的投票权",
   "start": 16.93,
   "end": 18.05,
   "id": "c8"
  },
  {
   "text": "按当前的存款计算",
   "start": 18.176,
   "end": 19.672,
   "id": "c9"
  },
  {
   "text": "它另有一条紧急通道",
   "start": 19.95,
   "end": 22.033,
   "id": "c10"
  },
  {
   "text": "按 CertiK 的分析",
   "start": 22.345,
   "end": 23.604,
   "id": "c11"
  },
  {
   "text": "提案满 1 天",
   "start": 23.786,
   "end": 24.776,
   "id": "c12"
  },
  {
   "text": "拿到三分之二的票",
   "start": 24.853,
   "end": 26.174,
   "id": "c13"
  },
  {
   "text": "就能立刻执行",
   "start": 26.213,
   "end": 27.223,
   "id": "c14"
  },
  {
   "text": "先猜一道题",
   "start": 27.51,
   "end": 28.488,
   "id": "c15"
  },
  {
   "text": "闪电贷必须在同一笔交易里归还",
   "start": 28.77,
   "end": 31.579,
   "id": "c16"
  },
  {
   "text": "用借来的代币",
   "start": 31.749,
   "end": 32.924,
   "id": "c17"
  },
  {
   "text": "能通过提案吗",
   "start": 32.999,
   "end": 34.034,
   "id": "c18"
  },
  {
   "text": "能",
   "start": 34.55,
   "end": 35.05,
   "id": "c19"
  },
  {
   "text": "借款 存入 投票 执行 还款",
   "start": 35.231,
   "end": 37.966,
   "id": "c20"
  },
  {
   "text": "全在同一笔交易里",
   "start": 37.986,
   "end": 40.654,
   "id": "c21"
  },
  {
   "text": "闪电贷的归还限制",
   "start": 40.93,
   "end": 42.728,
   "id": "c22"
  },
  {
   "text": "一步也没有挡住",
   "start": 42.795,
   "end": 44.055,
   "id": "c23"
  },
  {
   "text": "攻击者提前一天",
   "start": 44.362,
   "end": 45.008,
   "id": "c24"
  },
  {
   "text": "就提交了提案",
   "start": 45.028,
   "end": 46.848,
   "id": "c25"
  },
  {
   "text": "获利口径各方不同",
   "start": 47.13,
   "end": 48.759,
   "id": "c26"
  },
  {
   "text": "CertiK 称约 7600 万美元",
   "start": 48.918,
   "end": 51.448,
   "id": "c27"
  },
  {
   "text": "Beanstalk 称约 7700 万美元",
   "start": 51.634,
   "end": 54.235,
   "id": "c28"
  },
  {
   "text": "PeckShield 估约 8000 万美元",
   "start": 54.421,
   "end": 56.724,
   "id": "c29"
  },
  {
   "text": "修复有两步",
   "start": 56.95,
   "end": 58.234,
   "id": "c30"
  },
  {
   "text": "投票权用提案创建之前那个区块的快照",
   "start": 58.625,
   "end": 62.037,
   "id": "c31"
  },
  {
   "text": "借来的代币",
   "start": 62.602,
   "end": 63.585,
   "id": "c32"
  },
  {
   "text": "那时并不在你手里",
   "start": 63.672,
   "end": 65.085,
   "id": "c33"
  },
  {
   "text": "提案通过以后",
   "start": 65.31,
   "end": 66.408,
   "id": "c34"
  },
  {
   "text": "先过时间锁 再执行",
   "start": 66.669,
   "end": 68.425,
   "id": "c35"
  },
  {
   "text": "中间留出守护者否决的机会",
   "start": 68.761,
   "end": 71.19,
   "id": "c36"
  },
  {
   "text": "再加上法定人数",
   "start": 71.45,
   "end": 72.987,
   "id": "c37"
  },
  {
   "text": "并锁定提案内容",
   "start": 73.067,
   "end": 74.572,
   "id": "c38"
  },
  {
   "text": "内容一改",
   "start": 74.828,
   "end": 75.658,
   "id": "c39"
  },
  {
   "text": "重新计时",
   "start": 75.94,
   "end": 77.241,
   "id": "c40"
  },
  {
   "text": "奖励分发",
   "start": 77.603,
   "end": 78.546,
   "id": "c41"
  },
  {
   "text": "也有同样的问题",
   "start": 78.615,
   "end": 79.793,
   "id": "c42"
  },
  {
   "text": "如果奖励按存入那一刻的余额计算",
   "start": 80.143,
   "end": 82.952,
   "id": "c43"
  },
  {
   "text": "就能用闪电贷存入 领奖 取出",
   "start": 83.167,
   "end": 86.258,
   "id": "c44"
  },
  {
   "text": "修复是让奖励随时间累积",
   "start": 86.601,
   "end": 89.601,
   "id": "c45"
  },
  {
   "text": "存入以后有最短锁定期",
   "start": 89.805,
   "end": 91.913,
   "id": "c46"
  },
  {
   "text": "奖励的计算",
   "start": 92.17,
   "end": 93.229,
   "id": "c47"
  },
  {
   "text": "不能读一笔交易里就能改变的数据",
   "start": 93.319,
   "end": 95.892,
   "id": "c48"
  },
  {
   "text": "比如本区块的成交量",
   "start": 96.175,
   "end": 98.15,
   "id": "c49"
  },
  {
   "text": "或者池子的价格",
   "start": 98.215,
   "end": 99.568,
   "id": "c50"
  },
  {
   "text": "这几件事有个共同点",
   "start": 99.927,
   "end": 101.739,
   "id": "c51"
  },
  {
   "text": "攻击者借来的 是规模",
   "start": 101.91,
   "end": 103.902,
   "id": "c52"
  },
  {
   "text": "利用的 是时间",
   "start": 104.121,
   "end": 105.583,
   "id": "c53"
  }
 ]
}