 "captions": [
  {
   "text": "2023 年 3 月 13 日",
   "start": 1.55,
   "end": 3.769,
   "id": "c0"
  },
  {
   "text": "借贷协议 Euler Finance",
   "start": 4.099,
   "end": 6.299,
   "id": "c1"
  },
  {
   "text": "损失约 1.97 亿美元",
   "start": 6.404,
   "end": 8.59,
   "id": "c2"
  },
  {
   "text": "按事发时估值",
   "start": 8.758,
   "end": 9.926,
   "id": "c3"
  },
  {
   "text": "入口 是一个捐赠函数",
   "start": 10.262,
   "end": 12.575,
   "id": "c4"
  },
  {
   "text": "它让用户把自己的存款",
   "start": 12.87,
   "end": 15.074,
   "id": "c5"
  },
  {
   "text": "捐给协议的储备",
   "start": 15.158,
   "end": 16.636,
   "id": "c6"
  },
  {
   "text": "捐出去 账户的抵押品就少了",
   "start": 16.93,
   "end": 20.191,
   "id": "c7"
  },
  {
   "text": "但这个函数",
   "start": 20.43,
   "end": 21.654,
   "id": "c8"
  },
  {
   "text": "不检查账户是否仍然健康",
   "start": 21.858,
   "end": 24.184,
   "id": "c9"
  },
  {
   "text": "先猜一道题",
   "start": 24.41,
   "end": 25.381,
   "id": "c10"
  },
  {
   "text": "举个例子",
   "start": 25.67,
   "end": 26.378,
   "id": "c11"
  },
  {
   "text": "一个账户有 100 美元抵押品",
   "start": 26.883,
   "end": 29.967,
   "id": "c12"
  },
  {
   "text": "借了 90 美元",
   "start": 30.154,
   "end": 31.79,
   "id": "c13"
  },
  {
   "text": "它捐出 30 美元抵押品",
   "start": 32.05,
   "end": 34.678,
   "id": "c14"
  },
  {
   "text": "没人检查",
   "start": 34.724,
   "end": 36.773,
   "id": "c15"
  },
  {
   "text": "也没人偿还",
   "start": 36.915,
   "end": 38.228,
   "id": "c16"
  },
  {
   "text": "协议的缺口是多少",
   "start": 38.478,
   "end": 40.267,
   "id": "c17"
  },
  {
   "text": "缺口是 20 美元",
   "start": 40.79,
   "end": 43.422,
   "id": "c18"
  },
  {
   "text": "账户只剩 70 美元抵押品",
   "start": 43.749,
   "end": 47.331,
   "id": "c19"
  },
  {
   "text": "却欠着 90 美元",
   "start": 47.63,
   "end": 50.379,
   "id": "c20"
  },
  {
   "text": "这 20 美元成了坏账",
   "start": 50.685,
   "end": 53.334,
   "id": "c21"
  },
  {
   "text": "最后由存款人或保险基金承担",
   "start": 53.51,
   "end": 57.983,
   "id": "c22"
  },
  {
   "text": "每个函数单独看",
   "start": 58.25,
   "end": 59.723,
   "id": "c23"
  },
  {
   "text": "都没有错",
   "start": 59.743,
   "end": 60.488,
   "id": "c24"
  },
  {
   "text": "攻击者也没有利用代码 bug",
   "start": 60.88,
   "end": 63.207,
   "id": "c25"
  },
  {
   "text": "他只是按规则操作",
   "start": 63.497,
   "end": 65.465,
   "id": "c26"
  },
  {
   "text": "换了一种设计者没想到的组合",
   "start": 65.538,
   "end": 68.215,
   "id": "c27"
  },
  {
   "text": "规则本身",
   "start": 68.547,
   "end": 69.532,
   "id": "c28"
  },
  {
   "text": "怎么会让协议亏钱",
   "start": 69.599,
   "end": 71.017,
   "id": "c29"
  }
 ]
}