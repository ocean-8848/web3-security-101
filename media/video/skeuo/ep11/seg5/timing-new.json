 "captions": [
  {
   "text": "回头看这些事故",
   "start": 1.648,
   "end": 2.96,
   "id": "c0"
  },
  {
   "text": "攻击者大多没有找到代码 bug",
   "start": 3.017,
   "end": 5.091,
   "id": "c1"
  },
  {
   "text": "他们改变的",
   "start": 6.068,
   "end": 7.119,
   "id": "c2"
  },
  {
   "text": "是三样东西 顺序 规模 时间",
   "start": 7.139,
   "end": 10.845,
   "id": "c3"
  },
  {
   "text": "防御也按这三样来设计",
   "start": 11.808,
   "end": 14.287,
   "id": "c4"
  },
  {
   "text": "先说顺序",
   "start": 15.268,
   "end": 16.307,
   "id": "c5"
  },
  {
   "text": "任何会减少抵押品",
   "start": 16.682,
   "end": 18.388,
   "id": "c6"
  },
  {
   "text": "或者增加债务的路径",
   "start": 18.456,
   "end": 20.007,
   "id": "c7"
  },
  {
   "text": "都必须在结束时检查健康因子",
   "start": 20.027,
   "end": 22.685,
   "id": "c8"
  },
  {
   "text": "新增一个函数",
   "start": 23.672,
   "end": 24.913,
   "id": "c9"
  },
  {
   "text": "就要确认它走了这道检查",
   "start": 25.029,
   "end": 27.104,
   "id": "c10"
  },
  {
   "text": "Euler 缺的",
   "start": 27.479,
   "end": 28.399,
   "id": "c11"
  },
  {
   "text": "就是这一步",
   "start": 28.419,
   "end": 29.28,
   "id": "c12"
  },
  {
   "text": "再说规模",
   "start": 30.252,
   "end": 31.219,
   "id": "c13"
  },
  {
   "text": "低流动性抵押品要有供应上限",
   "start": 31.594,
   "end": 34.217,
   "id": "c14"
  },
  {
   "text": "自家代币做抵押",
   "start": 34.38,
   "end": 35.824,
   "id": "c15"
  },
  {
   "text": "要有额外限制",
   "start": 35.904,
   "end": 37.134,
   "id": "c16"
  },
  {
   "text": "清算奖励在极端行情下也要有吸引力",
   "start": 38.104,
   "end": 41.059,
   "id": "c17"
  },
  {
   "text": "清算折扣要有上限",
   "start": 41.199,
   "end": 42.964,
   "id": "c18"
  },
  {
   "text": "铸币要有单笔和每日的累计限额",
   "start": 43.964,
   "end": 46.634,
   "id": "c19"
  },
  {
   "text": "多人审批",
   "start": 46.654,
   "end": 47.622,
   "id": "c20"
  },
  {
   "text": "异常时熔断",
   "start": 47.69,
   "end": 48.824,
   "id": "c21"
  },
  {
   "text": "三个签名人里一人就够",
   "start": 49.824,
   "end": 52.065,
   "id": "c22"
  },
  {
   "text": "等于只有一个签名人",
   "start": 52.24,
   "end": 53.601,
   "id": "c23"
  },
  {
   "text": "抵押品估值",
   "start": 54.58,
   "end": 55.75,
   "id": "c24"
  },
  {
   "text": "不能只看一家交易所的订单簿",
   "start": 55.865,
   "end": 57.702,
   "id": "c25"
  },
  {
   "text": "最后是时间",
   "start": 58.688,
   "end": 59.822,
   "id": "c26"
  },
  {
   "text": "投票权用历史快照",
   "start": 60.197,
   "end": 61.843,
   "id": "c27"
  },
  {
   "text": "提案执行要过时间锁",
   "start": 61.947,
   "end": 63.819,
   "id": "c28"
  },
  {
   "text": "提款和赎回",
   "start": 64.788,
   "end": 66.053,
   "id": "c29"
  },
  {
   "text": "也可以设延迟",
   "start": 66.145,
   "end": 67.339,
   "id": "c30"
  },
  {
   "text": "2025 年 2 月 Bybit 被盗以后",
   "start": 68.32,
   "end": 70.787,
   "id": "c31"
  },
  {
   "text": "攻击者尝试赎回 cmETH",
   "start": 70.986,
   "end": 73.347,
   "id": "c32"
  },
  {
   "text": "按 The Block 报道",
   "start": 74.324,
   "end": 75.577,
   "id": "c33"
  },
  {
   "text": "mETH 协议有 8 小时的提款延迟",
   "start": 75.728,
   "end": 78.303,
   "id": "c34"
  },
  {
   "text": "团队趁这段时间暂停了合约",
   "start": 79.296,
   "end": 81.513,
   "id": "c35"
  },
  {
   "text": "追回 15000 枚 cmETH",
   "start": 81.605,
   "end": 83.918,
   "id": "c36"
  },
  {
   "text": "约 4300 万美元",
   "start": 83.974,
   "end": 85.561,
   "id": "c37"
  },
  {
   "text": "延迟把攻击者完成攻击的时间",
   "start": 86.548,
   "end": 88.801,
   "id": "c38"
  },
  {
   "text": "从一笔交易拉长到几个小时",
   "start": 88.869,
   "end": 91.206,
   "id": "c39"
  },
  {
   "text": "让监控和人工响应有机会介入",
   "start": 91.286,
   "end": 93.872,
   "id": "c40"
  },
  {
