   "speechStart": 1.698,
   "speechEnd": 3.495
  },
  {
   "id": "seg6-01",
   "text": "运营联盟链的人，写下每项安全假设依赖哪几家组织，不要只写成员可信。",
   "spoken": "运营联盟链的人，写下每项安全假设依赖哪几家组织，不要只写成员可信。",
   "src": "/Users/k/Workon/Learning/web3/web3-security-101/media/video/skeuo/ep30/audio/lines/seg6-01.mp3",
   "start": 4.556,
   "dur": 6.528,
   "speechStart": 4.654,
   "speechEnd": 10.237
  },
  {
   "id": "seg6-02",
   "text": "写链码的人，查一遍本地时间和随机数，再给低熵的私有数据加盐。",
   "spoken": "写链码的人，查一遍本地时间和随机数，再给低熵的私有数据加盐。",
   "src": "/Users/k/Workon/Learning/web3/web3-security-101/media/video/skeuo/ep30/audio/lines/seg6-02.mp3",
   "start": 11.304,
   "dur": 5.976,
   "speechStart": 11.402,
   "speechEnd": 16.425
  },
  {
   "id": "seg6-03",
   "text": "选框架的人，先核对它还有没有人维护。",
   "spoken": "选框架的人，先核对它还有没有人维护。",
   "src": "/Users/k/Workon/Learning/web3/web3-security-101/media/video/skeuo/ep30/audio/lines/seg6-03.mp3",
   "start": 17.5,
   "dur": 4.44,
   "speechStart": 17.598,
   "speechEnd": 21.098
  },
  {
   "id": "seg6-04",
   "text": "作为用户，听到上链了，不可篡改，先问三个问题。",
   "spoken": "作为用户，听到上链了，不可篡改，先问三个问题。",
   "src": "/Users/k/Workon/Learning/web3/web3-security-101/media/video/skeuo/ep30/audio/lines/seg6-04.mp3",
   "start": 22.16,
   "dur": 5.256,
   "speechStart": 22.258,
   "speechEnd": 26.567
  },
  {
   "id": "seg6-05",
   "text": "谁能写，谁能看，谁能改规则。",
   "spoken": "谁能写，谁能看，谁能改规则。",
   "src": "/Users/k/Workon/Learning/web3/web3-security-101/media/video/skeuo/ep30/audio/lines/seg6-05.mp3",
   "start": 27.636,
   "dur": 3.864,
   "speechStart": 27.734,
   "speechEnd": 30.662
  },
  {
   "id": "seg6-06",
   "text": "你的个人数据写进联盟链之前，问清怎么删除，怎么更正。",
   "spoken": "你的个人数据写进联盟链之前，问清怎么删除，怎么更正。",
   "src": "/Users/k/Workon/Learning/web3/web3-security-101/media/video/skeuo/ep30/audio/lines/seg6-06.mp3",
   "start": 31.72,
   "dur": 6.024,
   "speechStart": 31.818,
   "speechEnd": 36.901
  },
  {
   "id": "seg6-07",
   "text": "业务伙伴的联盟链，不等于公开可查，请对方拿出公链锚定或审计报告。",
   "spoken": "业务伙伴的联盟链，不等于公开可查，请对方拿出公链锚定或审计报告。",
   "src": "/Users/k/Workon/Learning/web3/web3-security-101/media/video/skeuo/ep30/audio/lines/seg6-07.mp3",
   "start": 37.964,
   "dur": 6.792,
   "speechStart": 38.062,
   "speechEnd": 43.907
  },
  {
   "id": "seg6-08",
   "text": "回到开头的问题。",
   "spoken": "回到开头的问题。",
   "src": "/Users/k/Workon/Learning/web3/web3-security-101/media/video/skeuo/ep30/audio/lines/seg6-08.mp3",
