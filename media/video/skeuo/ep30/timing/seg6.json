 "captions": [
  {
   "text": "最后 今天就能做的事",
   "start": 1.648,
   "end": 3.615,
   "id": "c0"
  },
  {
   "text": "运营联盟链的人",
   "start": 4.604,
   "end": 5.881,
   "id": "c1"
  },
  {
   "text": "写下每项安全假设依赖哪几家组织",
   "start": 5.973,
   "end": 8.928,
   "id": "c2"
  },
  {
   "text": "不要只写成员可信",
   "start": 8.973,
   "end": 10.357,
   "id": "c3"
  },
  {
   "text": "写链码的人",
   "start": 11.352,
   "end": 12.391,
   "id": "c4"
  },
  {
   "text": "查一遍本地时间和随机数",
   "start": 12.411,
   "end": 14.569,
   "id": "c5"
  },
  {
   "text": "再给低熵的私有数据加盐",
   "start": 14.59,
   "end": 16.545,
   "id": "c6"
  },
  {
   "text": "选框架的人",
   "start": 17.548,
   "end": 18.729,
   "id": "c7"
  },
  {
   "text": "先核对它还有没有人维护",
   "start": 18.845,
   "end": 21.218,
   "id": "c8"
  },
  {
   "text": "作为用户",
   "start": 22.208,
   "end": 23.163,
   "id": "c9"
  },
  {
   "text": "听到上链了",
   "start": 23.243,
   "end": 24.318,
   "id": "c10"
  },
  {
   "text": "不可篡改",
   "start": 24.374,
   "end": 25.33,
   "id": "c11"
  },
  {
   "text": "先问三个问题",
   "start": 25.529,
   "end": 26.687,
   "id": "c12"
  },
  {
   "text": "谁能写 谁能看",
   "start": 27.684,
   "end": 29.473,
   "id": "c13"
  },
  {
   "text": "谁能改规则",
   "start": 29.612,
   "end": 30.782,
   "id": "c14"
  },
  {
   "text": "你的个人数据写进联盟链之前",
   "start": 31.768,
   "end": 34.557,
   "id": "c15"
  },
  {
   "text": "问清怎么删除",
   "start": 34.851,
   "end": 36.128,
   "id": "c16"
  },
  {
   "text": "怎么更正",
   "start": 36.291,
   "end": 37.021,
   "id": "c17"
  },
  {
   "text": "业务伙伴的联盟链",
   "start": 38.012,
   "end": 39.372,
   "id": "c18"
  },
  {
   "text": "不等于公开可查",
   "start": 39.5,
   "end": 40.896,
   "id": "c19"
  },
  {
   "text": "请对方拿出公链锚定或审计报告",
   "start": 41.131,
   "end": 44.027,
   "id": "c20"
  },
  {
   "text": "回到开头的问题",
   "start": 45.024,
   "end": 46.408,
   "id": "c21"
  },
  {
   "text": "只让熟人进门的区块链",
   "start": 47.404,
   "end": 49.133,
   "id": "c22"
  },
  {
   "text": "风险在门里面",
   "start": 49.237,
   "end": 50.466,
   "id": "c23"
  },
  {
   "text": "在发证书的人",
   "start": 51.464,
   "end": 52.729,
   "id": "c24"
  },
  {
   "text": "拿管理员密钥的人",
   "start": 52.88,
   "end": 54.336,
   "id": "c25"
  },
  {
   "text": "达到门槛的几家成员",
   "start": 54.368,
   "end": 56.015,
   "id": "c26"
  },
  {
   "text": "还有没人维护的软件上",
   "start": 56.249,
   "end": 58.003,
   "id": "c27"
  },
  {
   "text": "门禁只回答了谁能进来",
   "start": 58.98,
   "end": 61.221,
   "id": "c28"
  },
  {
   "text": "安全还取决于进来的人能做什么",
   "start": 61.444,
   "end": 64.102,
   "id": "c29"
  },
  {
   "text": "规则本身有没有写对",
   "start": 64.218,
   "end": 65.769,
   "id": "c30"
  },
  {
   "text": "这个答案成立的前提",
   "start": 66.76,
   "end": 68.394,
   "id": "c31"
  },
  {
   "text": "是把每一个单点写下来",
   "start": 68.414,
   "end": 70.084,
   "id": "c32"
  },
  {
   "text": "分给不同的组织",
   "start": 70.236,
   "end": 71.585,
   "id": "c33"
  },
  {
   "text": "并且定期演练",
   "start": 71.605,
   "end": 72.811,
   "id": "c34"
  },
  {
   "text": "许可链没有消灭信任",
   "start": 73.796,
   "end": 75.525,
   "id": "c35"
  },
  {
   "text": "只是把信任交给了具体的机构和人",
   "start": 75.688,
   "end": 78.287,
   "id": "c36"
  },
  {
   "text": "这个系列就到这里",
   "start": 79.272,
   "end": 80.668,
   "id": "c37"
  }
 ]
