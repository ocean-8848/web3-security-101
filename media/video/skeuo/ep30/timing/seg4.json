 "captions": [
  {
   "text": "许可链最大的风险",
   "start": 1.648,
   "end": 3.246,
   "id": "c0"
  },
  {
   "text": "常常在流程里",
   "start": 3.41,
   "end": 4.77,
   "id": "c1"
  },
  {
   "text": "第一处 根 CA",
   "start": 5.756,
   "end": 7.414,
   "id": "c2"
  },
  {
   "text": "根私钥放在在线服务器上",
   "start": 8.4,
   "end": 10.32,
   "id": "c3"
  },
  {
   "text": "一旦被攻破",
   "start": 10.471,
   "end": 11.546,
   "id": "c4"
  },
  {
   "text": "攻击者就能签发任意身份",
   "start": 11.757,
   "end": 13.736,
   "id": "c5"
  },
  {
   "text": "控制是根 CA 离线",
   "start": 14.716,
   "end": 16.564,
   "id": "c6"
  },
  {
   "text": "私钥放进 HSM",
   "start": 16.644,
   "end": 18.278,
   "id": "c7"
  },
  {
   "text": "日常签发交给中间 CA",
   "start": 18.37,
   "end": 20.445,
   "id": "c8"
  },
  {
   "text": "节点和管理员的私钥",
   "start": 21.416,
   "end": 22.967,
   "id": "c9"
  },
  {
   "text": "也放进 HSM 或 KMS",
   "start": 22.987,
   "end": 25.562,
   "id": "c10"
  },
  {
   "text": "身份 CA 和 TLS CA",
   "start": 26.556,
   "end": 29.357,
   "id": "c11"
  },
  {
   "text": "也要分开",
   "start": 29.377,
   "end": 30.19,
   "id": "c12"
  },
  {
   "text": "第二处 管理员集中",
   "start": 31.192,
   "end": 33.04,
   "id": "c13"
  },
  {
   "text": "一家技术服务商",
   "start": 34.028,
   "end": 35.471,
   "id": "c14"
  },
  {
   "text": "替好几家组织拿着管理员证书",
   "start": 35.551,
   "end": 38.114,
   "id": "c15"
  },
  {
   "text": "它一出事",
   "start": 39.096,
   "end": 40.016,
   "id": "c16"
  },
  {
   "text": "好几家就同时失守",
   "start": 40.119,
   "end": 41.694,
   "id": "c17"
  },
  {
   "text": "控制是各家自持密钥",
   "start": 42.676,
   "end": 44.524,
   "id": "c18"
  },
  {
   "text": "服务商只拿受限的运维权限",
   "start": 44.688,
   "end": 46.905,
   "id": "c19"
  },
  {
   "text": "第三处 配置更新和成员退出",
   "start": 47.888,
   "end": 50.748,
   "id": "c20"
  },
  {
   "text": "改通道策略或成员名单",
   "start": 51.732,
   "end": 53.854,
   "id": "c21"
  },
  {
   "text": "要多家组织签名",
   "start": 54.077,
   "end": 55.58,
   "id": "c22"
  },
  {
   "text": "变更留痕",
   "start": 55.636,
   "end": 56.64,
   "id": "c23"
  },
  {
   "text": "成员退出时",
   "start": 57.64,
   "end": 58.917,
   "id": "c24"
  },
  {
   "text": "要吊销证书",
   "start": 58.961,
   "end": 60.179,
   "id": "c25"
  },
  {
   "text": "修改策略",
   "start": 60.223,
   "end": 61.238,
   "id": "c26"
  },
  {
   "text": "再评估它手里已经拿到的数据",
   "start": 61.402,
   "end": 63.595,
   "id": "c27"
  },
  {
   "text": "Fabric 文档提醒",
   "start": 64.58,
   "end": 66.0,
   "id": "c28"
  },
  {
   "text": "成员身份不会自动过期",
   "start": 66.044,
   "end": 67.964,
   "id": "c29"
  },
  {
   "text": "只能吊销",
   "start": 67.984,
   "end": 68.881,
   "id": "c30"
  },
  {
   "text": "所以吊销流程",
   "start": 69.864,
   "end": 71.319,
   "id": "c31"
  },
  {
   "text": "要提前演练",
   "start": 71.411,
   "end": 72.438,
   "id": "c32"
  },
  {
   "text": "第四处 成员共谋",
   "start": 73.42,
   "end": 75.435,
   "id": "c33"
  },
  {
   "text": "达到背书门槛的几家成员",
   "start": 76.424,
   "end": 78.689,
   "id": "c34"
  },
  {
   "text": "可以写入虚假的业务状态",
   "start": 78.745,
   "end": 80.867,
   "id": "c35"
  },
  {
   "text": "对策是外部锚定",
   "start": 81.852,
   "end": 83.224,
   "id": "c36"
  },
  {
   "text": "定期把账本摘要写到公链",
   "start": 83.435,
   "end": 85.498,
   "id": "c37"
  },
  {
   "text": "或者交给第三方保存",
   "start": 85.518,
   "end": 87.26,
   "id": "c38"
  },
  {
   "text": "它能证明历史没被改写",
   "start": 88.24,
   "end": 90.457,
   "id": "c39"
  },
  {
   "text": "却不能证明数据本身是真的",
   "start": 90.597,
   "end": 92.91,
   "id": "c40"
  },
  {
   "text": "最后 所有节点放在同一个云账户里",
   "start": 93.884,
   "end": 96.887,
   "id": "c41"
  },
  {
   "text": "也是单点",
   "start": 96.943,
   "end": 97.756,
   "id": "c42"
  },
  {
   "text": "要分账户 分地域",
   "start": 97.931,
   "end": 99.708,
   "id": "c43"
  },
  {
   "text": "分运营方",
   "start": 99.812,
   "end": 100.816,
   "id": "c44"
  }
 ]
