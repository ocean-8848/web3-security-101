 "captions": [
  {
   "text": "先看 Hyperledger Fabric",
   "start": 1.648,
   "end": 3.818,
   "id": "c0"
  },
  {
   "text": "它的一笔交易",
   "start": 4.82,
   "end": 5.966,
   "id": "c1"
  },
  {
   "text": "要过三道关 执行 排序 验证",
   "start": 6.082,
   "end": 9.74,
   "id": "c2"
  },
  {
   "text": "第一关 几家组织的背书节点",
   "start": 10.704,
   "end": 13.314,
   "id": "c3"
  },
  {
   "text": "模拟执行链码",
   "start": 13.394,
   "end": 14.719,
   "id": "c4"
  },
  {
   "text": "签下读写集",
   "start": 14.763,
   "end": 16.088,
   "id": "c5"
  },
  {
   "text": "第二关 排序服务只决定顺序",
   "start": 17.068,
   "end": 19.785,
   "id": "c6"
  },
  {
   "text": "不判断业务对不对",
   "start": 19.818,
   "end": 21.059,
   "id": "c7"
  },
  {
   "text": "第三关 记账节点不重新执行",
   "start": 22.04,
   "end": 24.936,
   "id": "c8"
  },
  {
   "text": "只核对背书策略和读集的版本",
   "start": 25.147,
   "end": 27.9,
   "id": "c9"
  },
  {
   "text": "被拒绝的交易仍然留在区块里",
   "start": 28.884,
   "end": 31.494,
   "id": "c10"
  },
  {
   "text": "只是标成无效",
   "start": 31.729,
   "end": 32.946,
   "id": "c11"
  },
  {
   "text": "背书策略规定",
   "start": 33.928,
   "end": 35.193,
   "id": "c12"
  },
  {
   "text": "一笔交易需要哪些组织签名",
   "start": 35.344,
   "end": 37.55,
   "id": "c13"
  },
  {
   "text": "默认要求通道成员的多数",
   "start": 38.54,
   "end": 40.65,
   "id": "c14"
  },
  {
   "text": "要是写成任一组织都行",
   "start": 41.64,
   "end": 43.881,
   "id": "c15"
  },
  {
   "text": "就等于让一家成员单独决定写入",
   "start": 44.068,
   "end": 46.631,
   "id": "c16"
  },
  {
   "text": "排序服务也要按威胁来选",
   "start": 47.62,
   "end": 49.79,
   "id": "c17"
  },
  {
   "text": "Raft 是崩溃容错",
   "start": 50.768,
   "end": 52.426,
   "id": "c18"
  },
  {
   "text": "5 个节点能容忍 2 个宕机",
   "start": 52.684,
   "end": 54.51,
   "id": "c19"
  },
  {
   "text": "却不防恶意节点",
   "start": 54.53,
   "end": 55.711,
   "id": "c20"
  },
  {
   "text": "一家运营方的排序节点被攻破",
   "start": 56.7,
   "end": 59.036,
   "id": "c21"
  },
  {
   "text": "它伪造不了背书",
   "start": 59.212,
   "end": 60.56,
   "id": "c22"
  },
  {
   "text": "却能决定顺序",
   "start": 60.592,
   "end": 61.834,
   "id": "c23"
  },
  {
   "text": "延迟或丢弃交易",
   "start": 61.854,
   "end": 63.465,
   "id": "c24"
  },
  {
   "text": "成员之间互不信任",
   "start": 64.456,
   "end": 65.924,
   "id": "c25"
  },
  {
   "text": "就选 BFT",
   "start": 65.944,
   "end": 67.138,
   "id": "c26"
  },
  {
   "text": "并把节点分给不同的运营方",
   "start": 67.158,
   "end": 69.078,
   "id": "c27"
  },
  {
   "text": "再看隐私",
   "start": 70.076,
   "end": 70.96,
   "id": "c28"
  },
  {
   "text": "私有数据集合",
   "start": 72.168,
   "end": 73.528,
   "id": "c29"
  },
  {
   "text": "只把原文发给部分组织",
   "start": 73.68,
   "end": 75.505,
   "id": "c30"
  },
  {
   "text": "账本上只留哈希",
   "start": 75.525,
   "end": 77.219,
   "id": "c31"
  },
  {
   "text": "假设集合里存着客户等级",
   "start": 78.196,
   "end": 80.556,
   "id": "c32"
  },
  {
   "text": "一共只有三档",
