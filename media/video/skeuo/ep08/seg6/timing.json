  },
  {
   "text": "列出所有价格来源",
   "start": 5.827,
   "end": 7.382,
   "id": "c2"
  },
  {
   "text": "标出哪些在一笔交易内可变",
   "start": 7.549,
   "end": 10.029,
   "id": "c3"
  },
  {
   "text": "用储备 余额",
   "start": 10.31,
   "end": 12.123,
   "id": "c4"
  },
  {
   "text": "份额价格来定价的地方",
   "start": 12.39,
   "end": 14.246,
   "id": "c5"
  },
  {
   "text": "全部换掉",
   "start": 14.489,
   "end": 15.351,
   "id": "c6"
  },
  {
   "text": "审计的人",
   "start": 15.57,
   "end": 16.43,
   "id": "c7"
  },
  {
   "text": "逐个检查预言机读取 正值 时效 上下限 精度",
   "start": 16.652,
   "end": 21.699,
   "id": "c8"
  },
  {
   "text": "L2 上 加上排序器状态",
   "start": 21.719,
   "end": 24.36,
   "id": "c9"
  },
  {
   "text": "再看低流动性抵押品",
   "start": 24.59,
   "end": 26.492,
   "id": "c10"
  },
  {
   "text": "有没有供应上限",
   "start": 26.7,
   "end": 28.204,
   "id": "c11"
  },
  {
   "text": "和更低的抵押率",
   "start": 28.364,
   "end": 29.947,
   "id": "c12"
  },
  {
   "text": "普通用户",
   "start": 30.265,
   "end": 31.128,
   "id": "c13"
  },
  {
   "text": "先看协议用什么价格源",
   "start": 31.328,
   "end": 33.53,
   "id": "c14"
  },
  {
   "text": "依赖单一 DEX 现货价的",
   "start": 33.732,
   "end": 35.614,
   "id": "c15"
  },
  {
   "text": "风险更高",
   "start": 35.634,
   "end": 36.625,
   "id": "c16"
  },
  {
   "text": "用低流动性代币做抵押",
   "start": 36.87,
   "end": 39.52,
   "id": "c17"
  },
  {
   "text": "保持更高的健康度",
   "start": 39.54,
   "end": 40.929,
   "id": "c18"
  },
  {
   "text": "极端行情里",
   "start": 41.185,
   "end": 42.303,
   "id": "c19"
  },
  {
   "text": "先降杠杆",
   "start": 42.389,
   "end": 43.545,
   "id": "c20"
  },
  {
   "text": "不要等清算",
   "start": 43.671,
   "end": 44.62,
   "id": "c21"
  },
  {
   "text": "回到开头",
   "start": 44.85,
   "end": 45.651,
   "id": "c22"
  },
  {
   "text": "一个大于 0",
   "start": 46.164,
   "end": 47.388,
   "id": "c23"
  },
  {
   "text": "刚刚更新的价格",
   "start": 47.417,
   "end": 48.711,
   "id": "c24"
  },
  {
   "text": "为什么还会错",
   "start": 48.925,
   "end": 49.97,
   "id": "c25"
  },
  {
   "text": "因为正值和时效",
   "start": 50.55,
   "end": 52.572,
   "id": "c26"
  },
  {
   "text": "只证明价格存在",
   "start": 52.796,
   "end": 54.511,
   "id": "c27"
  },
  {
   "text": "而且是新的",
   "start": 54.651,
   "end": 55.662,
   "id": "c28"
  },
  {
   "text": "不证明它对",
   "start": 55.876,
   "end": 57.009,
   "id": "c29"
  },
  {
   "text": "要拦住它",
   "start": 57.345,
   "end": 58.131,
   "id": "c30"
  },
  {
   "text": "需要合理的上下限",
   "start": 58.224,
   "end": 59.987,
   "id": "c31"
  },
  {
   "text": "或者和第二个价格源比较",
   "start": 60.237,
   "end": 62.371,
   "id": "c32"
  },
  {
   "text": "预言机配置的变更",
   "start": 62.684,
   "end": 64.146,
   "id": "c33"
  },
  {
   "text": "要和合约代码一样测试",
   "start": 64.349,
   "end": 66.211,
   "id": "c34"
  },
  {
   "text": "上线前 用真实喂价核对美元价格",
   "start": 66.565,
   "end": 69.62,
   "id": "c35"
  },
  {
   "text": "价格是合约看世界的窗口",
   "start": 69.85,
   "end": 72.507,
   "id": "c36"
  },
  {
   "text": "先确认 窗外是真的",
   "start": 72.712,
   "end": 74.698,
   "id": "c37"
  },
  {
   "text": "再按它放贷",
   "start": 74.949,
   "end": 76.328,
   "id": "c38"
  },
  {
   "text": "下一集讲 MEV 与签名安全",
   "start": 76.55,
   "end": 79.475,
   "id": "c39"
  }
 ]
}