 "captions": [
  {
   "text": "最后 每个人今天就能做一件事",
   "start": 1.648,
   "end": 4.151,
   "id": "c0"
  },
  {
   "text": "写合约的人",
   "start": 5.132,
   "end": 6.218,
   "id": "c1"
  },
  {
   "text": "列出所有价格来源",
   "start": 6.298,
   "end": 7.754,
   "id": "c2"
  },
  {
   "text": "标出哪些在一笔交易内可变",
   "start": 7.87,
   "end": 9.587,
   "id": "c3"
  },
  {
   "text": "用储备 余额",
   "start": 10.584,
   "end": 12.432,
   "id": "c4"
  },
  {
   "text": "份额价格来定价的地方",
   "start": 12.619,
   "end": 14.314,
   "id": "c5"
  },
  {
   "text": "全部换掉",
   "start": 14.334,
   "end": 15.373,
   "id": "c6"
  },
  {
   "text": "审计的人",
   "start": 16.348,
   "end": 17.339,
   "id": "c7"
  },
  {
   "text": "逐个检查预言机读取 正值 时效 上下限 精度",
   "start": 17.431,
   "end": 22.601,
   "id": "c8"
  },
  {
   "text": "L2 上 加上排序器状态",
   "start": 22.964,
   "end": 25.539,
   "id": "c9"
  },
  {
   "text": "再看低流动性抵押品",
   "start": 26.528,
   "end": 28.233,
   "id": "c10"
  },
  {
   "text": "有没有供应上限",
   "start": 28.385,
   "end": 29.674,
   "id": "c11"
  },
  {
   "text": "和更低的抵押率",
   "start": 29.694,
   "end": 30.948,
   "id": "c12"
  },
  {
   "text": "普通用户",
   "start": 31.932,
   "end": 32.947,
   "id": "c13"
  },
  {
   "text": "先看协议用什么价格源",
   "start": 33.003,
   "end": 35.006,
   "id": "c14"
  },
  {
   "text": "依赖单一 DEX 现货价的",
   "start": 35.382,
   "end": 37.516,
   "id": "c15"
  },
  {
   "text": "风险更高",
   "start": 37.536,
   "end": 38.635,
   "id": "c16"
  },
  {
   "text": "用低流动性代币做抵押",
   "start": 39.616,
   "end": 41.607,
   "id": "c17"
  },
  {
   "text": "保持更高的健康度",
   "start": 41.639,
   "end": 43.143,
   "id": "c18"
  },
  {
   "text": "极端行情里",
   "start": 43.518,
   "end": 44.652,
   "id": "c19"
  },
  {
   "text": "先降杠杆",
   "start": 44.732,
   "end": 45.795,
   "id": "c20"
  },
  {
   "text": "不要等清算",
   "start": 45.97,
   "end": 46.855,
   "id": "c21"
  },
  {
   "text": "回到开头",
   "start": 47.852,
   "end": 48.807,
   "id": "c22"
  },
  {
   "text": "一个大于 0",
   "start": 49.183,
   "end": 50.245,
   "id": "c23"
  },
  {
   "text": "刚刚更新的价格",
   "start": 50.361,
   "end": 51.662,
   "id": "c24"
  },
  {
   "text": "为什么还会错",
   "start": 51.766,
   "end": 52.817,
   "id": "c25"
  },
  {
   "text": "因为正值和时效",
   "start": 54.064,
   "end": 55.496,
   "id": "c26"
  },
  {
   "text": "只证明价格存在",
   "start": 55.599,
   "end": 57.079,
   "id": "c27"
  },
  {
   "text": "而且是新的",
   "start": 57.23,
   "end": 58.186,
   "id": "c28"
  },
  {
   "text": "不证明它对",
   "start": 58.549,
   "end": 59.636,
   "id": "c29"
  },
  {
   "text": "要拦住它",
   "start": 60.62,
   "end": 61.623,
   "id": "c30"
  },
  {
   "text": "需要合理的上下限",
   "start": 61.715,
   "end": 63.194,
   "id": "c31"
  },
  {
   "text": "或者和第二个价格源比较",
   "start": 63.298,
   "end": 65.016,
   "id": "c32"
  },
  {
   "text": "预言机配置的变更",
   "start": 66.0,
   "end": 67.515,
   "id": "c33"
  },
  {
   "text": "要和合约代码一样测试",
   "start": 67.571,
   "end": 69.265,
   "id": "c34"
  },
  {
   "text": "上线前 用真实喂价核对美元价格",
   "start": 69.64,
   "end": 73.393,
   "id": "c35"
  },
  {
   "text": "价格是合约看世界的窗口",
   "start": 74.38,
   "end": 76.526,
   "id": "c36"
  },
  {
   "text": "先确认 窗外是真的",
   "start": 76.901,
   "end": 78.904,
   "id": "c37"
  },
  {
   "text": "再按它放贷",
   "start": 78.984,
   "end": 80.0,
   "id": "c38"
  },
  {
   "text": "下一集讲 MEV 与签名安全",
   "start": 80.984,
   "end": 83.511,
   "id": "c39"
  }
