 "captions": [
  {
   "text": "换掉现货价",
   "start": 1.648,
   "end": 2.841,
   "id": "c0"
  },
  {
   "text": "有三类选择",
   "start": 2.945,
   "end": 4.103,
   "id": "c1"
  },
  {
   "text": "第一类 AMM 的时间加权平均价",
   "start": 5.084,
   "end": 7.885,
   "id": "c2"
  },
  {
   "text": "简称 TWAP",
   "start": 7.917,
   "end": 9.599,
   "id": "c3"
  },
  {
   "text": "它把一段时间里的价格",
   "start": 10.584,
   "end": 12.623,
   "id": "c4"
  },
  {
   "text": "按时间加权求平均",
   "start": 12.667,
   "end": 14.373,
   "id": "c5"
  },
  {
   "text": "一笔交易推高的价格",
   "start": 15.34,
   "end": 16.867,
   "id": "c6"
  },
  {
   "text": "在平均里只占一小段",
   "start": 16.887,
   "end": 18.771,
   "id": "c7"
  },
  {
   "text": "几乎不起作用",
   "start": 18.923,
   "end": 20.033,
   "id": "c8"
  },
  {
   "text": "代价是 窗口越长",
   "start": 21.032,
   "end": 23.178,
   "id": "c9"
  },
  {
   "text": "价格越滞后",
   "start": 23.246,
   "end": 24.344,
   "id": "c10"
  },
  {
   "text": "而低流动性的池子",
   "start": 25.332,
   "end": 26.906,
   "id": "c11"
  },
  {
   "text": "仍然可以被连续多个区块持续操纵",
   "start": 26.998,
   "end": 29.764,
   "id": "c12"
  },
  {
   "text": "在 PoS 下",
   "start": 30.76,
   "end": 31.894,
   "id": "c13"
  },
  {
   "text": "同一个提议者连续出块时",
   "start": 32.045,
   "end": 33.966,
   "id": "c14"
  },
  {
   "text": "这种操纵会更便宜",
   "start": 33.986,
   "end": 35.537,
   "id": "c15"
  },
  {
   "text": "2022 年 4 月的 Inverse Finance",
   "start": 36.524,
   "end": 39.218,
   "id": "c16"
  },
  {
   "text": "就是这样",
   "start": 39.238,
   "end": 39.944,
   "id": "c17"
  },
  {
   "text": "攻击者没有用闪电贷",
   "start": 40.944,
   "end": 42.578,
   "id": "c18"
  },
  {
   "text": "他投入自有资金",
   "start": 42.953,
   "end": 44.278,
   "id": "c19"
  },
  {
   "text": "持续推高浅池里的 INV 价格",
   "start": 44.31,
   "end": 46.599,
   "id": "c20"
  },
  {
   "text": "同时用垃圾交易抑制套利",
   "start": 47.596,
   "end": 49.718,
   "id": "c21"
  },
  {
   "text": "让 TWAP 输出虚高的价格",
   "start": 49.738,
   "end": 52.337,
   "id": "c22"
  },
  {
   "text": "按公开报道",
   "start": 53.336,
   "end": 54.458,
   "id": "c23"
  },
  {
   "text": "借走约 1560 万美元",
   "start": 54.621,
   "end": 57.029,
   "id": "c24"
  },
  {
   "text": "TWAP 挡得住一笔交易",
   "start": 58.02,
   "end": 60.344,
   "id": "c25"
  },
  {
   "text": "挡不住有资本的多区块操纵",
   "start": 60.52,
   "end": 62.559,
   "id": "c26"
  },
  {
   "text": "第二类 链下聚合预言机",
   "start": 63.544,
   "end": 65.678,
   "id": "c27"
  },
  {
   "text": "比如 Chainlink",
   "start": 65.746,
   "end": 67.13,
   "id": "c28"
  },
  {
   "text": "价格在链下聚合",
   "start": 68.108,
   "end": 69.587,
   "id": "c29"
  },
  {
   "text": "再写上链",
   "start": 69.739,
   "end": 70.563,
   "id": "c30"
  },
  {
   "text": "一笔交易改不动它",
   "start": 70.939,
   "end": 72.489,
   "id": "c31"
  },
  {
   "text": "它按心跳和偏离阈值更新",
   "start": 73.464,
   "end": 75.753,
   "id": "c32"
  },
  {
   "text": "心跳 是价格不变时",
   "start": 76.732,
   "end": 79.104,
   "id": "c33"
  },
  {
   "text": "也必须更新的最长间隔",
   "start": 79.124,
   "end": 81.033,
   "id": "c34"
  },
  {
   "text": "它的风险换了方向",
   "start": 82.016,
   "end": 83.424,
   "id": "c35"
  },
  {
   "text": "价格可能过时",
   "start": 83.635,
   "end": 84.959,
   "id": "c36"
  },
  {
   "text": "可能撞上上下限",
   "start": 85.087,
   "end": 86.412,
   "id": "c37"
  },
  {
   "text": "节点和喂价方也可能失效",
   "start": 86.468,
   "end": 88.638,
   "id": "c38"
  },
  {
   "text": "第三类 多源组合",
   "start": 89.628,
   "end": 91.464,
   "id": "c39"
  },
  {
   "text": "几个价格源互相比较",
   "start": 91.84,
   "end": 93.521,
   "id": "c40"
  },
  {
   "text": "偏离超过阈值就暂停",
   "start": 93.72,
   "end": 95.593,
   "id": "c41"
  },
  {
   "text": "它更稳 但实现复杂",
   "start": 96.592,
   "end": 98.857,
   "id": "c42"
  },
  {
   "text": "几个源意见不一时听谁的",
   "start": 99.232,
   "end": 101.104,
   "id": "c43"
  },
  {
   "text": "要提前想好",
   "start": 101.22,
   "end": 102.295,
   "id": "c44"
  },
  {
   "text": "顺带一句",
   "start": 103.292,
   "end": 104.319,
   "id": "c45"
  },
  {
   "text": "LP 代币也不能按储备乘现货价来定价",
   "start": 104.434,
   "end": 107.664,
   "id": "c46"
  },
  {
   "text": "要用外部预言机的价格和不变量",
   "start": 108.648,
   "end": 111.044,
   "id": "c47"
  },
  {
   "text": "反推出公平储备",
   "start": 111.112,
   "end": 112.497,
   "id": "c48"
  },
  {
   "text": "再算 LP 的价值",
   "start": 112.517,
   "end": 114.032,
   "id": "c49"
  },
  {
   "text": "没有完美的预言机",
   "start": 115.012,
   "end": 116.527,
   "id": "c50"
  },
  {
   "text": "工程上要回答两个问题",
   "start": 117.512,
   "end": 119.551,
   "id": "c51"
  },
  {
   "text": "价格错了 会怎样",
   "start": 120.54,
   "end": 122.424,
   "id": "c52"
  },
  {
   "text": "价格停了 会怎样",
   "start": 122.799,
   "end": 124.541,
   "id": "c53"
  }
 ]
}