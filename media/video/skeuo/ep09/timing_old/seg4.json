 "captions": [
  {
   "text": "再看另一半 签名",
   "start": 1.55,
   "end": 3.405,
   "id": "c0"
  },
  {
   "text": "很多操作不在链上发起",
   "start": 3.61,
   "end": 5.896,
   "id": "c1"
  },
  {
   "text": "而是在链下签名",
   "start": 6.014,
   "end": 7.403,
   "id": "c2"
  },
  {
   "text": "再交给合约验证",
   "start": 7.554,
   "end": 8.987,
   "id": "c3"
  },
  {
   "text": "免 gas 授权 permit 元交易",
   "start": 9.293,
   "end": 11.861,
   "id": "c4"
  },
  {
   "text": "订单簿挂单",
   "start": 12.045,
   "end": 13.181,
   "id": "c5"
  },
  {
   "text": "跨链桥验证者签名",
   "start": 13.331,
   "end": 15.345,
   "id": "c6"
  },
  {
   "text": "空投领取凭证",
   "start": 15.585,
   "end": 16.84,
   "id": "c7"
  },
  {
   "text": "都是这样",
   "start": 16.986,
   "end": 17.688,
   "id": "c8"
  },
  {
   "text": "问题是 一份签名",
   "start": 17.97,
   "end": 19.869,
   "id": "c9"
  },
  {
   "text": "能被用几次",
   "start": 19.946,
   "end": 20.919,
   "id": "c10"
  },
  {
   "text": "打个比方",
   "start": 21.528,
   "end": 22.183,
   "id": "c11"
  },
  {
   "text": "你签了一张支付 100 元的支票",
   "start": 22.349,
   "end": 25.147,
   "id": "c12"
  },
  {
   "text": "没写日期",
   "start": 25.508,
   "end": 26.426,
   "id": "c13"
  },
  {
   "text": "没写收款银行",
   "start": 26.736,
   "end": 28.192,
   "id": "c14"
  },
  {
   "text": "没写支票编号",
   "start": 28.285,
   "end": 29.398,
   "id": "c15"
  },
  {
   "text": "拿到它的人",
   "start": 29.63,
   "end": 30.683,
   "id": "c16"
  },
  {
   "text": "可以复印很多份",
   "start": 30.755,
   "end": 31.988,
   "id": "c17"
  },
  {
   "text": "去每一家银行各兑一次",
   "start": 32.243,
   "end": 34.203,
   "id": "c18"
  },
  {
   "text": "比喻在这里不完全成立",
   "start": 34.587,
   "end": 36.634,
   "id": "c19"
  },
  {
   "text": "银行会自己记下兑过的支票",
   "start": 36.896,
   "end": 39.34,
   "id": "c20"
  },
  {
   "text": "合约不会",
   "start": 39.525,
   "end": 40.453,
   "id": "c21"
  },
  {
   "text": "除非代码让它记",
   "start": 40.671,
   "end": 42.162,
   "id": "c22"
  },
  {
   "text": "一份安全的签名",
   "start": 42.47,
   "end": 43.82,
   "id": "c23"
  },
  {
   "text": "要绑定五个字段",
   "start": 43.97,
   "end": 45.464,
   "id": "c24"
  },
  {
   "text": "第一 nonce",
   "start": 45.823,
   "end": 47.132,
   "id": "c25"
  },
  {
   "text": "一次性编号",
   "start": 47.252,
   "end": 48.161,
   "id": "c26"
  },
  {
   "text": "缺了它 同一份签名可以在同一个合约反复提交",
   "start": 48.359,
   "end": 52.523,
   "id": "c27"
  },
  {
   "text": "第二 链 ID",
   "start": 52.849,
   "end": 54.094,
   "id": "c28"
  },
  {
   "text": "缺了它 签名在分叉链和多链部署上同样有效",
   "start": 54.172,
   "end": 58.11,
   "id": "c29"
  },
  {
   "text": "第三 合约地址",
   "start": 58.33,
   "end": 59.985,
   "id": "c30"
  },
  {
   "text": "缺了它 同一份代码部署两次",
   "start": 60.529,
   "end": 63.006,
   "id": "c31"
  },
  {
   "text": "签名在两个合约都有效",
   "start": 63.252,
   "end": 65.302,
   "id": "c32"
  },
  {
   "text": "第四 截止时间",
   "start": 65.684,
   "end": 67.254,
   "id": "c33"
  },
  {
   "text": "缺了它 签名永久有效",
   "start": 67.892,
   "end": 70.199,
   "id": "c34"
  },
  {
   "text": "你改主意以后",
   "start": 70.72,
   "end": 71.79,
   "id": "c35"
  },
  {
   "text": "它照样能被使用",
   "start": 71.984,
   "end": 73.334,
   "id": "c36"
  },
  {
   "text": "第五 函数意图",
   "start": 73.666,
   "end": 75.508,
   "id": "c37"
  },
  {
   "text": "也就是类型哈希",
   "start": 75.754,
   "end": 77.474,
   "id": "c38"
  },
  {
   "text": "缺了它 给 A 函数签的数据",
   "start": 77.717,
   "end": 80.123,
   "id": "c39"
  },
  {
   "text": "会被拿去调用 B 函数",
   "start": 80.311,
   "end": 82.03,
   "id": "c40"
  },
  {
   "text": "先猜一道题",
   "start": 82.27,
   "end": 83.248,
   "id": "c41"
  },
  {
   "text": "一张领取凭证",
   "start": 83.629,
   "end": 84.914,
   "id": "c42"
  },
  {
   "text": "绑定了 nonce",
   "start": 85.065,
   "end": 86.505,
   "id": "c43"
  },
  {
   "text": "没有绑定链 ID",
   "start": 86.548,
   "end": 87.891,
   "id": "c44"
  },
  {
   "text": "同一份合约",
   "start": 88.247,
   "end": 89.23,
   "id": "c45"
  },
  {
   "text": "用相同的地址",
   "start": 89.553,
   "end": 90.763,
   "id": "c46"
  },
  {
   "text": "部署在以太坊和 BNB Chain",
   "start": 90.867,
   "end": 93.275,
   "id": "c47"
  },
  {
   "text": "凭证在以太坊用过之后",
   "start": 93.57,
   "end": 95.576,
   "id": "c48"
  },
  {
   "text": "还能在 BNB Chain 领取吗",
   "start": 95.648,
   "end": 97.494,
   "id": "c49"
  },
  {
   "text": "能",
   "start": 97.99,
   "end": 98.493,
   "id": "c50"
  },
  {
   "text": "两条链上的 nonce 各自计数",
   "start": 98.864,
   "end": 101.049,
   "id": "c51"
  },
  {
   "text": "BNB Chain 上还是 0",
   "start": 101.601,
   "end": 103.217,
   "id": "c52"
  },
  {
   "text": "摘要里没有链 ID",
   "start": 103.588,
   "end": 105.022,
   "id": "c53"
  },
  {
   "text": "两条链算出的摘要完全相同",
   "start": 105.277,
   "end": 107.52,
   "id": "c54"
  },
  {
   "text": "解决办法是 EIP-712",
   "start": 107.79,
   "end": 110.18,
   "id": "c55"
  },
  {
   "text": "它把名称 版本 链 ID",
   "start": 110.41,
   "end": 113.47,
   "id": "c56"
  },
  {
   "text": "合约地址",
   "start": 113.639,
   "end": 114.57,
   "id": "c57"
  },
  {
   "text": "合成一个域分隔符",
   "start": 114.667,
   "end": 116.324,
   "id": "c58"
  },
  {
   "text": "再把消息的结构",
   "start": 116.55,
   "end": 118.137,
   "id": "c59"
  },
  {
   "text": "合成类型哈希",
   "start": 118.326,
   "end": 119.488,
   "id": "c60"
  },
  {
   "text": "用对 EIP-712",
   "start": 119.73,
   "end": 121.437,
   "id": "c61"
  },
  {
   "text": "后四个字段一次解决",
   "start": 121.519,
   "end": 123.305,
   "id": "c62"
  },
  {
   "text": "nonce 还要合约自己维护",
   "start": 123.594,
   "end": 125.636,
   "id": "c63"
  },
  {
   "text": "每用一次 加一",
   "start": 125.821,
   "end": 127.137,
   "id": "c64"
  }
 ]
}