 "captions": [
  {
   "text": "你在一个去中心化交易所",
   "start": 1.644,
   "end": 4.762,
   "id": "c0"
  },
  {
   "text": "用 10 个 ETH 换 USDC",
   "start": 4.821,
   "end": 6.762,
   "id": "c1"
  },
  {
   "text": "池子现价",
   "start": 7.05,
   "end": 8.023,
   "id": "c2"
  },
  {
   "text": "1 个 ETH 换 2000 USDC",
   "start": 8.276,
   "end": 11.225,
   "id": "c3"
  },
  {
   "text": "这是示例",
   "start": 11.501,
   "end": 12.156,
   "id": "c4"
  },
  {
   "text": "你把滑点设成 5",
   "start": 12.39,
   "end": 14.17,
   "id": "c5"
  },
  {
   "text": "意思是 最少拿到 19000 USDC",
   "start": 14.549,
   "end": 17.808,
   "id": "c6"
  },
  {
   "text": "少于这个数",
   "start": 17.977,
   "end": 18.97,
   "id": "c7"
  },
  {
   "text": "交易就回滚",
   "start": 19.057,
   "end": 20.324,
   "id": "c8"
  },
  {
   "text": "交易发出去",
   "start": 20.59,
   "end": 21.557,
   "id": "c9"
  },
  {
   "text": "先进入公开的内存池",
   "start": 21.712,
   "end": 23.474,
   "id": "c10"
  },
  {
   "text": "排队等着打包",
   "start": 23.548,
   "end": 24.689,
   "id": "c11"
  },
  {
   "text": "有人在打包之前",
   "start": 25.069,
   "end": 26.506,
   "id": "c12"
  },
  {
   "text": "读到了它",
   "start": 26.526,
   "end": 27.237,
   "id": "c13"
  },
  {
   "text": "他把你的交易",
   "start": 27.51,
   "end": 28.937,
   "id": "c14"
  },
  {
   "text": "夹在自己的两笔交易中间",
   "start": 29.1,
   "end": 31.477,
   "id": "c15"
  },
  {
   "text": "先猜一道题",
   "start": 31.73,
   "end": 32.701,
   "id": "c16"
  },
  {
   "text": "你最少收到多少",
   "start": 33.085,
   "end": 34.401,
   "id": "c17"
  },
  {
   "text": "他能让你收到更少吗",
   "start": 34.758,
   "end": 36.309,
   "id": "c18"
  },
  {
   "text": "你最少收到 19000",
   "start": 36.944,
   "end": 38.838,
   "id": "c19"
  },
  {
   "text": "他不能让你更少",
   "start": 39.265,
   "end": 40.474,
   "id": "c20"
  },
  {
   "text": "低于这个数",
   "start": 40.75,
   "end": 41.794,
   "id": "c21"
  },
  {
   "text": "你的交易回滚",
   "start": 42.071,
   "end": 43.28,
   "id": "c22"
  },
  {
   "text": "他也赚不到钱",
   "start": 43.3,
   "end": 44.454,
   "id": "c23"
  },
  {
   "text": "所以 他会把价格推到刚好够 19000 的位置",
   "start": 44.73,
   "end": 49.568,
   "id": "c24"
  },
  {
   "text": "你的交易没有失败",
   "start": 49.926,
   "end": 51.36,
   "id": "c25"
  },
  {
   "text": "它只是按你允许的最差价格 成交了",
   "start": 51.59,
   "end": 54.524,
   "id": "c26"
  },
  {
   "text": "滑点设 5",
   "start": 54.77,
   "end": 56.515,
   "id": "c27"
  },
  {
   "text": "就可能真的付 5",
   "start": 56.724,
   "end": 58.694,
   "id": "c28"
  },
  {
   "text": "交易在打包之前是公开的",
   "start": 58.99,
   "end": 61.342,
   "id": "c29"
  },
  {
   "text": "顺序由别人决定",
   "start": 61.552,
   "end": 63.107,
   "id": "c30"
  },
  {
   "text": "签名在用过之后仍然存在",
   "start": 63.37,
   "end": 65.617,
   "id": "c31"
  },
  {
   "text": "能不能再用",
   "start": 65.845,
   "end": 66.748,
   "id": "c32"
  },
  {
   "text": "取决于你签了什么",
   "start": 66.768,
   "end": 68.295,
   "id": "c33"
  }
 ]
