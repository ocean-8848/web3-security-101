 "captions": [
  {
   "text": "再看另一半 签名",
   "start": 1.648,
   "end": 3.532,
   "id": "c0"
  },
  {
   "text": "很多操作不在链上发起",
   "start": 4.508,
   "end": 6.38,
   "id": "c1"
  },
  {
   "text": "而是在链下签名",
   "start": 6.555,
   "end": 8.059,
   "id": "c2"
  },
  {
   "text": "再交给合约验证",
   "start": 8.079,
   "end": 9.309,
   "id": "c3"
  },
  {
   "text": "免 gas 授权 permit 元交易",
   "start": 10.296,
   "end": 13.168,
   "id": "c4"
  },
  {
   "text": "订单簿挂单",
   "start": 13.26,
   "end": 14.311,
   "id": "c5"
  },
  {
   "text": "跨链桥验证者签名",
   "start": 14.45,
   "end": 16.073,
   "id": "c6"
  },
  {
   "text": "空投领取凭证",
   "start": 16.117,
   "end": 17.418,
   "id": "c7"
  },
  {
   "text": "都是这样",
   "start": 17.45,
   "end": 18.263,
   "id": "c8"
  },
  {
   "text": "问题是 一份签名",
   "start": 19.252,
   "end": 21.314,
   "id": "c9"
  },
  {
   "text": "能被用几次",
   "start": 21.466,
   "end": 22.791,
   "id": "c10"
  },
  {
   "text": "打个比方",
   "start": 24.048,
   "end": 25.003,
   "id": "c11"
  },
  {
   "text": "你签了一张支付 100 元的支票",
   "start": 25.367,
   "end": 27.418,
   "id": "c12"
  },
  {
   "text": "没写日期",
   "start": 28.42,
   "end": 29.435,
   "id": "c13"
  },
  {
   "text": "没写收款银行",
   "start": 29.574,
   "end": 30.947,
   "id": "c14"
  },
  {
   "text": "没写支票编号",
   "start": 30.967,
   "end": 32.209,
   "id": "c15"
  },
  {
   "text": "拿到它的人",
   "start": 33.2,
   "end": 34.239,
   "id": "c16"
  },
  {
   "text": "可以复印很多份",
   "start": 34.295,
   "end": 35.524,
   "id": "c17"
  },
  {
   "text": "去每一家银行各兑一次",
   "start": 35.581,
   "end": 37.251,
   "id": "c18"
  },
  {
   "text": "比喻在这里不完全成立",
   "start": 38.244,
   "end": 39.997,
   "id": "c19"
  },
  {
   "text": "银行会自己记下兑过的支票",
   "start": 40.172,
   "end": 42.164,
   "id": "c20"
  },
  {
   "text": "合约不会",
   "start": 42.539,
   "end": 43.506,
   "id": "c21"
  },
  {
   "text": "除非代码让它记",
   "start": 43.634,
   "end": 44.899,
   "id": "c22"
  },
  {
   "text": "一份安全的签名",
   "start": 45.88,
   "end": 47.312,
   "id": "c23"
  },
  {
   "text": "要绑定五个字段",
   "start": 47.332,
   "end": 48.692,
   "id": "c24"
  },
  {
   "text": "第一 nonce",
   "start": 49.676,
   "end": 50.977,
   "id": "c25"
  },
  {
   "text": "一次性编号",
   "start": 51.033,
   "end": 52.0,
   "id": "c26"
  },
  {
   "text": "缺了它 同一份签名可以在同一个合约反复提交",
   "start": 52.376,
   "end": 56.391,
   "id": "c27"
  },
  {
   "text": "第二 链 ID",
   "start": 57.384,
   "end": 59.03,
   "id": "c28"
  },
  {
   "text": "缺了它 签名在分叉链和多链部署上同样有效",
   "start": 59.393,
   "end": 63.551,
   "id": "c29"
  },
  {
   "text": "第三 合约地址",
   "start": 64.54,
   "end": 66.519,
   "id": "c30"
  },
  {
   "text": "缺了它 同一份代码部署两次",
   "start": 66.894,
   "end": 69.469,
   "id": "c31"
  },
  {
   "text": "签名在两个合约都有效",
   "start": 69.585,
   "end": 71.314,
   "id": "c32"
  },
  {
   "text": "第四 截止时间",
   "start": 72.296,
   "end": 74.025,
   "id": "c33"
  },
  {
   "text": "缺了它 签名永久有效",
   "start": 74.4,
   "end": 76.749,
   "id": "c34"
  },
  {
   "text": "你改主意以后",
   "start": 77.127,
   "end": 78.451,
   "id": "c35"
  },
  {
   "text": "它照样能被使用",
   "start": 78.615,
   "end": 79.904,
   "id": "c36"
  },
  {
   "text": "第五 函数意图",
   "start": 80.892,
   "end": 82.8,
   "id": "c37"
  },
  {
   "text": "也就是类型哈希",
   "start": 82.82,
   "end": 84.193,
   "id": "c38"
  },
  {
   "text": "缺了它 给 A 函数签的数据",
   "start": 84.568,
   "end": 87.047,
   "id": "c39"
  },
  {
   "text": "会被拿去调用 B 函数",
   "start": 87.068,
   "end": 88.928,
   "id": "c40"
  },
  {
   "text": "先猜一道题",
   "start": 89.92,
   "end": 91.244,
   "id": "c41"
  },
  {
   "text": "一张领取凭证",
   "start": 92.228,
   "end": 93.552,
   "id": "c42"
  },
  {
   "text": "绑定了 nonce",
   "start": 93.585,
   "end": 94.683,
   "id": "c43"
  },
  {
   "text": "没有绑定链 ID",
   "start": 94.716,
   "end": 96.005,
   "id": "c44"
  },
  {
   "text": "同一份合约",
   "start": 96.984,
   "end": 97.94,
   "id": "c45"
  },
  {
   "text": "用相同的地址",
   "start": 97.96,
   "end": 99.189,
   "id": "c46"
  },
  {
   "text": "部署在以太坊和 BNB Chain",
   "start": 99.269,
   "end": 101.511,
   "id": "c47"
  },
  {
   "text": "凭证在以太坊用过之后",
   "start": 102.508,
   "end": 104.392,
   "id": "c48"
  },
  {
   "text": "还能在 BNB Chain 领取吗",
   "start": 104.412,
   "end": 106.523,
   "id": "c49"
  },
  {
   "text": "能",
   "start": 107.76,
   "end": 108.453,
   "id": "c50"
  },
  {
   "text": "两条链上的 nonce 各自计数",
   "start": 108.805,
   "end": 111.034,
   "id": "c51"
  },
  {
   "text": "BNB Chain 上还是 0",
   "start": 111.126,
   "end": 112.903,
   "id": "c52"
  },
  {
   "text": "摘要里没有链 ID",
   "start": 113.884,
   "end": 115.744,
   "id": "c53"
  },
  {
   "text": "两条链算出的摘要完全相同",
   "start": 115.943,
   "end": 118.494,
   "id": "c54"
  },
  {
   "text": "解决办法是 EIP-712",
   "start": 119.48,
   "end": 122.138,
   "id": "c55"
  },
  {
   "text": "它把名称 版本 链 ID",
   "start": 123.108,
   "end": 125.671,
   "id": "c56"
  },
  {
   "text": "合约地址",
   "start": 125.691,
   "end": 126.67,
   "id": "c57"
  },
  {
   "text": "合成一个域分隔符",
   "start": 126.762,
   "end": 128.135,
   "id": "c58"
  },
  {
   "text": "再把消息的结构",
   "start": 129.136,
   "end": 130.448,
   "id": "c59"
  },
  {
   "text": "合成类型哈希",
   "start": 130.469,
   "end": 131.841,
   "id": "c60"
  },
  {
   "text": "用对 EIP-712",
   "start": 132.836,
   "end": 135.184,
   "id": "c61"
  },
  {
   "text": "后四个字段一次解决",
   "start": 135.324,
   "end": 136.91,
   "id": "c62"
  },
  {
   "text": "nonce 还要合约自己维护",
   "start": 137.274,
   "end": 139.182,
   "id": "c63"
  },
  {
   "text": "每用一次 加一",
   "start": 139.226,
   "end": 140.789,
   "id": "c64"
  }
 ]
