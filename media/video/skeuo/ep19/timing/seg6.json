 "captions": [
  {
   "text": "如果你是普通用户",
   "start": 1.648,
   "end": 3.08,
   "id": "c0"
  },
  {
   "text": "先记住几条",
   "start": 3.195,
   "end": 4.306,
   "id": "c1"
  },
  {
   "text": "官方从不要求你签名领取空投",
   "start": 5.276,
   "end": 8.029,
   "id": "c2"
  },
  {
   "text": "或者签名验证钱包",
   "start": 8.085,
   "end": 9.743,
   "id": "c3"
  },
  {
   "text": "签名前看三样",
   "start": 10.728,
   "end": 12.112,
   "id": "c4"
  },
  {
   "text": "授权给谁",
   "start": 12.132,
   "end": 13.326,
   "id": "c5"
  },
  {
   "text": "授权多少",
   "start": 13.359,
   "end": 14.445,
   "id": "c6"
  },
  {
   "text": "到什么时候",
   "start": 14.525,
   "end": 15.386,
   "id": "c7"
  },
  {
   "text": "看不懂就不签",
   "start": 16.372,
   "end": 17.565,
   "id": "c8"
  },
  {
   "text": "不花 Gas",
   "start": 17.634,
   "end": 18.53,
   "id": "c9"
  },
  {
   "text": "不等于没有风险",
   "start": 18.598,
   "end": 19.696,
   "id": "c10"
  },
  {
   "text": "大额资产和日常交互",
   "start": 20.672,
   "end": 22.532,
   "id": "c11"
  },
  {
   "text": "用不同的钱包",
   "start": 22.564,
   "end": 23.746,
   "id": "c12"
  },
  {
   "text": "每个月撤销不用的授权",
   "start": 24.732,
   "end": 26.604,
   "id": "c13"
  },
  {
   "text": "买新币前",
   "start": 26.732,
   "end": 27.723,
   "id": "c14"
  },
  {
   "text": "先确认它能卖出去",
   "start": 27.767,
   "end": 29.437,
   "id": "c15"
  },
  {
   "text": "已经签下钓鱼签名",
   "start": 30.424,
   "end": 32.177,
   "id": "c16"
  },
  {
   "text": "就立刻撤销授权",
   "start": 32.197,
   "end": 33.879,
   "id": "c17"
  },
  {
   "text": "把剩余资产转到新地址",
   "start": 33.924,
   "end": 36.189,
   "id": "c18"
  },
  {
   "text": "如果你做钱包产品",
   "start": 37.172,
   "end": 38.615,
   "id": "c19"
  },
  {
   "text": "今天就查一件事",
   "start": 38.707,
   "end": 40.02,
   "id": "c20"
  },
  {
   "text": "签名请求能不能解码成可读字段",
   "start": 40.136,
   "end": 42.937,
   "id": "c21"
  },
  {
   "text": "如果你在交易所",
   "start": 43.92,
   "end": 45.125,
   "id": "c22"
  },
  {
   "text": "查一查提币时有没有比对首尾相同的历史地址",
   "start": 45.182,
   "end": 48.697,
   "id": "c23"
  },
  {
   "text": "回到开头的问题",
   "start": 49.684,
   "end": 51.068,
   "id": "c24"
  },
  {
   "text": "测试转账已经到账",
   "start": 52.064,
   "end": 53.662,
   "id": "c25"
  },
  {
   "text": "从记录里复制地址",
   "start": 53.814,
   "end": 55.448,
   "id": "c26"
  },
  {
   "text": "并不安全",
   "start": 55.468,
   "end": 56.341,
   "id": "c27"
  },
  {
   "text": "测试只证明那一刻的地址是对的",
   "start": 57.324,
   "end": 59.946,
   "id": "c28"
  },
  {
   "text": "证明不了你之后复制的是同一个",
   "start": 60.276,
   "end": 62.66,
   "id": "c29"
  },
  {
   "text": "地址要从地址簿",
   "start": 63.64,
   "end": 64.988,
   "id": "c30"
  },
  {
   "text": "或者收款方的安全渠道取",
   "start": 65.116,
   "end": 67.31,
   "id": "c31"
  },
  {
   "text": "再核对完整地址",
   "start": 67.354,
   "end": 68.869,
   "id": "c32"
  },
  {
   "text": "不只看首尾",
   "start": 68.925,
   "end": 70.024,
   "id": "c33"
  },
  {
   "text": "私钥完好无损",
   "start": 71.012,
   "end": 72.313,
   "id": "c34"
  },
  {
   "text": "资产也可能没了",
   "start": 72.44,
   "end": 73.67,
   "id": "c35"
  },
  {
   "text": "每次确认之前",
   "start": 73.845,
   "end": 75.123,
   "id": "c36"
  },
  {
   "text": "先看清你在签什么",
   "start": 75.143,
   "end": 76.479,
   "id": "c37"
  },
  {
