 "captions": [
  {
   "text": "知道了门怎么坏",
   "start": 1.648,
   "end": 2.937,
   "id": "c0"
  },
  {
   "text": "再看钥匙怎么分",
   "start": 3.16,
   "end": 4.318,
   "id": "c1"
  },
  {
   "text": "第一个原则",
   "start": 5.3,
   "end": 6.22,
   "id": "c2"
  },
  {
   "text": "最小权限",
   "start": 6.24,
   "end": 7.255,
   "id": "c3"
  },
  {
   "text": "把一个 owner 拆成几个角色",
   "start": 7.631,
   "end": 9.539,
   "id": "c4"
  },
  {
   "text": "每个角色只做一件事",
   "start": 9.571,
   "end": 11.217,
   "id": "c5"
  },
  {
   "text": "升级者 负责升级实现合约",
   "start": 12.192,
   "end": 14.754,
   "id": "c6"
  },
  {
   "text": "建议多签加时间锁",
   "start": 15.13,
   "end": 16.812,
   "id": "c7"
  },
  {
   "text": "延迟 48 小时以上",
   "start": 16.868,
   "end": 18.49,
   "id": "c8"
  },
  {
   "text": "参数管理员",
   "start": 19.492,
   "end": 20.65,
   "id": "c9"
  },
  {
   "text": "修改费率和抵押率",
   "start": 20.67,
   "end": 22.4,
   "id": "c10"
  },
  {
   "text": "建议多签加时间锁",
   "start": 22.775,
   "end": 24.421,
   "id": "c11"
  },
  {
   "text": "延迟 24 小时",
   "start": 24.465,
   "end": 26.028,
   "id": "c12"
  },
  {
   "text": "这两个数字只是示例",
   "start": 27.008,
   "end": 28.618,
   "id": "c13"
  },
  {
   "text": "不是标准",
   "start": 28.77,
   "end": 29.606,
   "id": "c14"
  },
  {
   "text": "暂停者 负责紧急暂停",
   "start": 30.588,
   "end": 32.924,
   "id": "c15"
  },
  {
   "text": "小型多签或监控机器人就够了",
   "start": 33.3,
   "end": 35.708,
   "id": "c16"
  },
  {
   "text": "不加延迟",
   "start": 35.728,
   "end": 36.672,
   "id": "c17"
  },
  {
   "text": "增发者 只授予特定的合约",
   "start": 37.672,
   "end": 40.02,
   "id": "c18"
  },
  {
   "text": "为什么暂停要快",
   "start": 41.012,
   "end": 42.36,
   "id": "c19"
  },
  {
   "text": "升级要慢",
   "start": 42.524,
   "end": 43.408,
   "id": "c20"
  },
  {
   "text": "暂停只能止损",
   "start": 44.656,
   "end": 46.087,
   "id": "c21"
  },
  {
   "text": "转不走资金",
   "start": 46.263,
   "end": 47.29,
   "id": "c22"
  },
  {
   "text": "升级可以做任何事",
   "start": 47.665,
   "end": 49.478,
   "id": "c23"
  },
  {
   "text": "第二个原则",
   "start": 50.468,
   "end": 51.411,
   "id": "c24"
  },
  {
   "text": "多签加时间锁",
   "start": 51.515,
   "end": 52.816,
   "id": "c25"
  },
  {
   "text": "提案者是一个多签",
   "start": 53.784,
   "end": 55.299,
   "id": "c26"
  },
  {
   "text": "比如五个人里三人签名",
   "start": 55.486,
   "end": 57.108,
   "id": "c27"
  },
  {
   "text": "才能把操作交给时间锁",
   "start": 57.129,
   "end": 58.835,
   "id": "c28"
  },
  {
   "text": "时间锁让操作公开排队",
   "start": 59.812,
   "end": 61.898,
   "id": "c29"
  },
  {
   "text": "比如 48 小时",
   "start": 61.978,
   "end": 63.374,
   "id": "c30"
  },
  {
   "text": "到期之后",
   "start": 63.75,
   "end": 64.741,
   "id": "c31"
  },
  {
   "text": "才能执行",
   "start": 64.833,
   "end": 65.789,
   "id": "c32"
  },
  {
   "text": "排队期间",
   "start": 66.776,
   "end": 67.696,
   "id": "c33"
  },
  {
   "text": "大家都看得到",
   "start": 67.799,
   "end": 68.803,
   "id": "c34"
  },
  {
   "text": "用户不同意",
   "start": 69.166,
   "end": 70.277,
   "id": "c35"
  },
  {
   "text": "可以在延迟期内撤出",
   "start": 70.297,
   "end": 71.919,
   "id": "c36"
  },
  {
   "text": "守护者发现恶意操作",
   "start": 72.9,
   "end": 74.712,
   "id": "c37"
  },
  {
   "text": "可以取消",
   "start": 74.733,
   "end": 75.593,
   "id": "c38"
  },
  {
   "text": "但不能发起",
   "start": 75.709,
   "end": 76.677,
   "id": "c39"
  },
  {
   "text": "权限是不对称的",
   "start": 77.052,
   "end": 78.46,
   "id": "c40"
  },
  {
   "text": "这套设计也有局限",
   "start": 79.432,
   "end": 81.125,
   "id": "c41"
  },
  {
   "text": "多签防的是单个私钥被盗",
   "start": 82.124,
   "end": 84.472,
   "id": "c42"
  },
  {
   "text": "如果所有签名人看到的",
   "start": 84.847,
   "end": 86.648,
   "id": "c43"
  },
