 "captions": [
  {
   "text": "先给准确的说法",
   "start": 1.55,
   "end": 2.807,
   "id": "c0"
  },
  {
   "text": "你的系统",
   "start": 3.05,
   "end": 3.884,
   "id": "c1"
  },
  {
   "text": "从来没有直接读过链",
   "start": 4.019,
   "end": 5.807,
   "id": "c2"
  },
  {
   "text": "它读的是某个节点",
   "start": 6.07,
   "end": 8.04,
   "id": "c3"
  },
  {
   "text": "某个 RPC 服务",
   "start": 8.199,
   "end": 9.558,
   "id": "c4"
  },
  {
   "text": "某个索引器",
   "start": 9.732,
   "end": 10.699,
   "id": "c5"
  },
  {
   "text": "告诉它的链",
   "start": 10.862,
   "end": 11.699,
   "id": "c6"
  },
  {
   "text": "数据从 P2P 网络进入节点",
   "start": 12.064,
   "end": 14.492,
   "id": "c7"
  },
  {
   "text": "经过 RPC",
   "start": 14.669,
   "end": 15.778,
   "id": "c8"
  },
  {
   "text": "再到索引器和你的系统",
   "start": 15.929,
   "end": 17.874,
   "id": "c9"
  },
  {
   "text": "每一层 都可能给出错误的数据",
   "start": 18.11,
   "end": 20.806,
   "id": "c10"
  },
  {
   "text": "第一层是节点客户端",
   "start": 21.152,
   "end": 23.161,
   "id": "c11"
  },
  {
   "text": "2020 年 11 月",
   "start": 23.535,
   "end": 25.026,
   "id": "c12"
  },
  {
   "text": "Infura 的节点运行旧版 Geth",
   "start": 25.326,
   "end": 27.801,
   "id": "c13"
  },
  {
   "text": "它遇到一个上游已经修复的共识 bug",
   "start": 28.05,
   "end": 31.523,
   "id": "c14"
  },
  {
   "text": "停在一条少数派分叉上",
   "start": 31.764,
   "end": 34.037,
   "id": "c15"
  },
  {
   "text": "依赖它的 MetaMask 等服务",
   "start": 34.27,
   "end": 35.993,
   "id": "c16"
  },
  {
   "text": "受到影响",
   "start": 36.013,
   "end": 37.345,
   "id": "c17"
  },
  {
   "text": "Binance",
   "start": 37.711,
   "end": 38.399,
   "id": "c18"
  },
  {
   "text": "Bithumb 等交易所",
   "start": 38.634,
   "end": 40.26,
   "id": "c19"
  },
  {
   "text": "暂停了 ETH 和 ERC-20 提币",
   "start": 40.317,
   "end": 43.283,
   "id": "c20"
  },
  {
   "text": "第二层是 RPC 服务",
   "start": 43.604,
   "end": 45.431,
   "id": "c21"
  },
  {
   "text": "它会宕机 限流",
   "start": 45.704,
   "end": 47.411,
   "id": "c22"
  },
  {
   "text": "返回过期数据",
   "start": 47.608,
   "end": 48.838,
   "id": "c23"
  },
  {
   "text": "第三层是索引器",
   "start": 49.09,
   "end": 51.022,
   "id": "c24"
  },
  {
   "text": "它会延迟",
   "start": 51.213,
   "end": 52.203,
   "id": "c25"
  },
  {
   "text": "也会解释错",
   "start": 52.311,
   "end": 53.34,
   "id": "c26"
  },
  {
   "text": "第四层是网络路由",
   "start": 53.55,
   "end": 55.449,
   "id": "c27"
  },
  {
   "text": "BGP 劫持",
   "start": 55.797,
   "end": 57.036,
   "id": "c28"
  },
  {
   "text": "是用错误的路由宣告",
   "start": 57.079,
   "end": 58.791,
   "id": "c29"
  },
  {
   "text": "把别人的流量引到自己的服务器",
   "start": 58.811,
   "end": 61.523,
   "id": "c30"
  },
  {
   "text": "2018 年",
   "start": 61.75,
   "end": 62.699,
   "id": "c31"
  },
  {
   "text": "MyEtherWallet",
   "start": 62.855,
   "end": 63.981,
   "id": "c32"
  },
  {
   "text": "的 DNS 被这样指向钓鱼站",
   "start": 64.001,
   "end": 66.326,
   "id": "c33"
  },
  {
   "text": "损失约 15 万美元",
   "start": 66.391,
   "end": 68.179,
   "id": "c34"
  },
  {
   "text": "2022 年",
   "start": 68.547,
   "end": 69.57,
   "id": "c35"
  },
  {
   "text": "KLAYswap 的 SDK 下载域名被劫持",
   "start": 69.658,
   "end": 73.587,
   "id": "c36"
  },
  {
   "text": "下发恶意脚本",
   "start": 73.87,
   "end": 75.19,
   "id": "c37"
  },
  {
   "text": "损失约 190 万美元",
   "start": 75.264,
   "end": 77.32,
   "id": "c38"
  },
  {
   "text": "同年",
   "start": 77.63,
   "end": 78.217,
   "id": "c39"
  },
  {
   "text": "Celer cBridge",
   "start": 78.292,
   "end": 79.263,
   "id": "c40"
  },
  {
   "text": "提供合约地址的子域被劫持",
   "start": 79.283,
   "end": 81.811,
   "id": "c41"
  },
  {
   "text": "损失约 24 万美元",
   "start": 82.007,
   "end": 83.72,
   "id": "c42"
  },
  {
   "text": "打个比方",
   "start": 84.11,
   "end": 84.768,
   "id": "c43"
  },
  {
   "text": "你隔着一扇窗看车流",
   "start": 85.122,
   "end": 86.957,
   "id": "c44"
  },
  {
   "text": "决定什么时候过马路",
   "start": 87.227,
   "end": 88.694,
   "id": "c45"
  },
  {
   "text": "这扇窗可能是一块屏幕",
   "start": 89.026,
   "end": 91.001,
   "id": "c46"
  },
  {
   "text": "屏幕可能延迟",
   "start": 91.216,
   "end": 92.557,
   "id": "c47"
  },
  {
   "text": "也可能有人在播录像",
   "start": 92.599,
   "end": 94.271,
   "id": "c48"
  },
  {
   "text": "比喻不成立的地方是",
   "start": 94.603,
   "end": 96.069,
   "id": "c49"
  },
  {
   "text": "真实的马路",
   "start": 96.451,
   "end": 97.431,
   "id": "c50"
  },
  {
   "text": "你可以换一扇窗再看一眼",
   "start": 97.5,
   "end": 99.582,
   "id": "c51"
  },
  {
   "text": "很多系统只接了一个 RPC",
   "start": 99.85,
   "end": 102.194,
   "id": "c52"
  },
  {
   "text": "从来没有第二扇窗",
   "start": 102.52,
   "end": 103.923,
   "id": "c53"
  }
 ]
