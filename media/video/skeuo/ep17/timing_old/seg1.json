 "captions": [
  {
   "text": "2026 年 4 月",
   "start": 1.652,
   "end": 3.536,
   "id": "c0"
  },
  {
   "text": "LayerZero 给 KelpDAO",
   "start": 3.781,
   "end": 5.396,
   "id": "c1"
  },
  {
   "text": "确认跨链消息的验证者",
   "start": 5.416,
   "end": 7.704,
   "id": "c2"
  },
  {
   "text": "放行了一条消息",
   "start": 7.868,
   "end": 9.076,
   "id": "c3"
  },
  {
   "text": "这条消息",
   "start": 9.384,
   "end": 10.226,
   "id": "c4"
  },
  {
   "text": "在源链上根本不存在",
   "start": 10.31,
   "end": 12.109,
   "id": "c5"
  },
  {
   "text": "验证者读链",
   "start": 12.482,
   "end": 13.669,
   "id": "c6"
  },
  {
   "text": "靠的是两个 RPC 节点",
   "start": 13.821,
   "end": 15.789,
   "id": "c7"
  },
  {
   "text": "攻击者控制了这两个节点",
   "start": 16.05,
   "end": 18.033,
   "id": "c8"
  },
  {
   "text": "替换了节点程序",
   "start": 18.274,
   "end": 19.667,
   "id": "c9"
  },
  {
   "text": "被替换的节点",
   "start": 20.053,
   "end": 21.494,
   "id": "c10"
  },
  {
   "text": "只对验证者返回伪造数据",
   "start": 21.611,
   "end": 23.923,
   "id": "c11"
  },
  {
   "text": "对别的 IP 来的查询",
   "start": 24.27,
   "end": 25.822,
   "id": "c12"
  },
  {
   "text": "它返回真实数据",
   "start": 26.158,
   "end": 27.484,
   "id": "c13"
  },
  {
   "text": "攻击者再用 DDoS",
   "start": 27.843,
   "end": 29.674,
   "id": "c14"
  },
  {
   "text": "打掉没被攻破的外部 RPC",
   "start": 29.742,
   "end": 32.095,
   "id": "c15"
  },
  {
   "text": "系统自动切换",
   "start": 32.464,
   "end": 33.911,
   "id": "c16"
  },
  {
   "text": "切到了被污染的节点上",
   "start": 34.165,
   "end": 36.295,
   "id": "c17"
  },
  {
   "text": "LayerZero 的声明写",
   "start": 36.605,
   "end": 38.187,
   "id": "c18"
  },
  {
   "text": "损失约 2.9 亿美元",
   "start": 38.339,
   "end": 40.826,
   "id": "c19"
  },
  {
   "text": "先猜一道题",
   "start": 41.05,
   "end": 42.021,
   "id": "c20"
  },
  {
   "text": "监控系统也查询了这两个节点",
   "start": 42.31,
   "end": 44.444,
   "id": "c21"
  },
  {
   "text": "结果一切正常",
   "start": 44.609,
   "end": 45.909,
   "id": "c22"
  },
  {
   "text": "它能发现这次攻击吗",
   "start": 46.13,
   "end": 47.789,
   "id": "c23"
  },
  {
   "text": "先记住这个问题",
   "start": 48.31,
   "end": 49.441,
   "id": "c24"
  }
 ]
