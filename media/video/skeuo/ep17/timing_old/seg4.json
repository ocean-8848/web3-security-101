 "captions": [
  {
   "text": "验证者这一端",
   "start": 1.55,
   "end": 2.932,
   "id": "c0"
  },
  {
   "text": "风险出在签名上",
   "start": 3.019,
   "end": 4.676,
   "id": "c1"
  },
  {
   "text": "罚没 是 PoS 验证者违反协议",
   "start": 4.89,
   "end": 7.601,
   "id": "c2"
  },
  {
   "text": "被扣除部分质押并强制退出",
   "start": 7.621,
   "end": 11.029,
   "id": "c3"
  },
  {
   "text": "最常见的原因是双签",
   "start": 11.27,
   "end": 13.612,
   "id": "c4"
  },
  {
   "text": "同一把密钥",
   "start": 13.985,
   "end": 14.933,
   "id": "c5"
  },
  {
   "text": "对同一个位置",
   "start": 15.101,
   "end": 16.313,
   "id": "c6"
  },
  {
   "text": "签了两个不同的消息",
   "start": 16.544,
   "end": 18.434,
   "id": "c7"
  },
  {
   "text": "凌晨 运维看到主机 A 失去响应",
   "start": 18.75,
   "end": 21.813,
   "id": "c8"
  },
  {
   "text": "就在备用机 B 上启动同一把密钥",
   "start": 22.349,
   "end": 25.004,
   "id": "c9"
  },
  {
   "text": "其实 A 没有停",
   "start": 25.29,
   "end": 27.005,
   "id": "c10"
  },
  {
   "text": "两台机器对同一个 slot 各签一票",
   "start": 27.189,
   "end": 29.883,
   "id": "c11"
  },
  {
   "text": "网络检测到双签",
   "start": 30.247,
   "end": 31.806,
   "id": "c12"
  },
  {
   "text": "验证者被罚没",
   "start": 31.854,
   "end": 33.131,
   "id": "c13"
  },
  {
   "text": "公开的罚没事件",
   "start": 33.5,
   "end": 34.989,
   "id": "c14"
  },
  {
   "text": "几乎都发生在故障切换或迁移时",
   "start": 35.211,
   "end": 38.68,
   "id": "c15"
  },
  {
   "text": "2021 年 2 月",
   "start": 38.91,
   "end": 41.093,
   "id": "c16"
  },
  {
   "text": "一家质押服务商重启出错",
   "start": 41.113,
   "end": 43.065,
   "id": "c17"
  },
  {
   "text": "75 个验证者被罚没",
   "start": 43.292,
   "end": 46.297,
   "id": "c18"
  },
  {
   "text": "约 18 ETH",
   "start": 46.317,
   "end": 47.575,
   "id": "c19"
  },
  {
   "text": "2023 年 10 月和 2025 年 9 月",
   "start": 47.85,
   "end": 51.553,
   "id": "c20"
  },
  {
   "text": "Lido 和 SSV 网络上",
   "start": 51.597,
   "end": 53.073,
   "id": "c21"
  },
  {
   "text": "也各有一批验证者被罚没",
   "start": 53.276,
   "end": 55.377,
   "id": "c22"
  },
  {
   "text": "防线在流程",
   "start": 55.67,
   "end": 57.597,
   "id": "c23"
  },
  {
   "text": "迁移前导出防罚没数据",
   "start": 57.617,
   "end": 58.93,
   "id": "c24"
  },
  {
   "text": "确认旧实例已经停止",
   "start": 59.039,
   "end": 61.054,
   "id": "c25"
  },
  {
   "text": "再等待至少 2 个 epoch",
   "start": 61.25,
   "end": 63.394,
   "id": "c26"
  },
  {
   "text": "并开启分身检测",
   "start": 63.51,
   "end": 65.037,
   "id": "c27"
  },
  {
   "text": "作为最后一道防线",
   "start": 65.229,
   "end": 66.7,
   "id": "c28"
  },
  {
   "text": "签名的另一个风险",
   "start": 67.08,
   "end": 68.58,
   "id": "c29"
  },
  {
   "text": "是看不见就签",
   "start": 68.638,
   "end": 70.109,
   "id": "c30"
  },
  {
   "text": "在 MEV-Boost 里",
   "start": 70.33,
   "end": 72.303,
   "id": "c31"
  },
  {
   "text": "relay 托管构建者组装的完整区块",
   "start": 72.547,
   "end": 75.535,
   "id": "c32"
  },
  {
   "text": "只给提议者区块头",
   "start": 75.699,
   "end": 77.363,
   "id": "c33"
  },
  {
   "text": "提议者签名区块头",
   "start": 77.59,
   "end": 79.415,
   "id": "c34"
  },
  {
   "text": "相信 relay 会发布完整区块并付款",
   "start": 79.645,
   "end": 82.7,
   "id": "c35"
  },
  {
   "text": "2023 年 4 月",
   "start": 83.033,
   "end": 84.463,
   "id": "c36"
  },
  {
   "text": "一个恶意提议者",
   "start": 84.795,
   "end": 86.549,
   "id": "c37"
  },
  {
   "text": "签了一个无效的区块头",
   "start": 86.62,
   "end": 89.015,
   "id": "c38"
  },
  {
   "text": "旧代码照样返回区块体",
   "start": 89.23,
   "end": 91.727,
   "id": "c39"
  },
  {
   "text": "他拆开三明治机器人的交易包",
   "start": 92.004,
   "end": 94.585,
   "id": "c40"
  },
  {
   "text": "获利约 2000 万美元",
   "start": 94.758,
   "end": 97.15,
   "id": "c41"
  },
  {
   "text": "修复后 relay 先广播区块",
   "start": 97.45,
   "end": 99.912,
   "id": "c42"
  },
  {
   "text": "再把区块交给提议者",
   "start": 100.165,
   "end": 101.978,
   "id": "c43"
  },
  {
   "text": "relay 是可信中间人",
   "start": 102.324,
   "end": 104.158,
   "id": "c44"
  },
  {
   "text": "验证者要评估自己用的 relay 和它的运营方",
   "start": 104.374,
   "end": 107.656,
   "id": "c45"
  },
  {
   "text": "这个市场也很集中",
   "start": 107.89,
   "end": 109.363,
   "id": "c46"
  },
  {
   "text": "2026 年 11 月的一个单日快照里",
   "start": 109.602,
   "end": 112.48,
   "id": "c47"
  },
  {
   "text": "前两大构建者约占 74% 的区块",
   "start": 112.672,
   "end": 116.073,
   "id": "c48"
  }
 ]
}