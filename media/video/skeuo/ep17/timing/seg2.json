   "start": 36.216,
   "end": 38.124,
   "id": "c16"
  },
  {
   "text": "受到影响",
   "start": 38.144,
   "end": 39.04,
   "id": "c17"
  },
  {
   "text": "Binance",
   "start": 40.036,
   "end": 40.872,
   "id": "c18"
  },
  {
   "text": "Bithumb 等交易所",
   "start": 40.917,
   "end": 42.206,
   "id": "c19"
  },
  {
   "text": "暂停了 ETH 和 ERC-20 提币",
   "start": 42.25,
   "end": 44.717,
   "id": "c20"
  },
  {
   "text": "第二层是 RPC 服务",
   "start": 45.704,
   "end": 47.874,
   "id": "c21"
  },
  {
   "text": "它会宕机 限流",
   "start": 47.93,
   "end": 49.6,
   "id": "c22"
  },
  {
   "text": "返回过期数据",
   "start": 49.632,
   "end": 50.874,
   "id": "c23"
  },
  {
   "text": "第三层是索引器",
   "start": 51.852,
   "end": 53.343,
   "id": "c24"
  },
  {
   "text": "它会延迟",
   "start": 53.387,
   "end": 54.415,
   "id": "c25"
  },
  {
   "text": "也会解释错",
   "start": 54.435,
   "end": 55.379,
   "id": "c26"
  },
  {
   "text": "第四层是网络路由",
   "start": 56.344,
   "end": 58.097,
   "id": "c27"
  },
  {
   "text": "BGP 劫持",
   "start": 59.084,
   "end": 60.326,
   "id": "c28"
  },
  {
   "text": "是用错误的路由宣告",
   "start": 60.346,
   "end": 62.004,
   "id": "c29"
  },
  {
   "text": "把别人的流量引到自己的服务器",
   "start": 62.084,
   "end": 64.313,
   "id": "c30"
  },
  {
   "text": "2018 年",
   "start": 65.304,
   "end": 66.236,
   "id": "c31"
  },
  {
   "text": "MyEtherWallet",
   "start": 66.28,
   "end": 67.057,
   "id": "c32"
  },
  {
   "text": "的 DNS 被这样指向钓鱼站",
   "start": 67.077,
   "end": 69.557,
   "id": "c33"
  },
  {
   "text": "损失约 15 万美元",
   "start": 69.637,
   "end": 71.438,
   "id": "c34"
  },
  {
   "text": "2022 年",
   "start": 72.436,
   "end": 73.415,
   "id": "c35"
  },
  {
   "text": "KLAYswap 的 SDK 下载域名被劫持",
   "start": 73.531,
   "end": 76.82,
   "id": "c36"
  },
  {
   "text": "下发恶意脚本",
   "start": 76.84,
   "end": 78.094,
   "id": "c37"
  },
  {
   "text": "损失约 190 万美元",
   "start": 78.138,
   "end": 80.106,
   "id": "c38"
  },
  {
   "text": "同年",
   "start": 81.104,
   "end": 81.786,
   "id": "c39"
  },
  {
   "text": "Celer cBridge",
   "start": 81.854,
   "end": 82.822,
   "id": "c40"
  },
  {
   "text": "提供合约地址的子域被劫持",
   "start": 82.842,
   "end": 85.012,
   "id": "c41"
  },
  {
   "text": "损失约 24 万美元",
   "start": 85.08,
   "end": 86.94,
   "id": "c42"
  },
  {
   "text": "打个比方",
   "start": 87.924,
   "end": 88.879,
   "id": "c43"
  },
  {
   "text": "你隔着一扇窗看车流",
   "start": 90.016,
   "end": 91.626,
   "id": "c44"
  },
  {
   "text": "决定什么时候过马路",
   "start": 91.885,
   "end": 93.114,
   "id": "c45"
  },
  {
   "text": "这扇窗可能是一块屏幕",
   "start": 94.1,
   "end": 95.972,
   "id": "c46"
  },
  {
   "text": "屏幕可能延迟",
   "start": 96.147,
   "end": 97.424,
   "id": "c47"
  },
  {
   "text": "也可能有人在播录像",
   "start": 97.469,
   "end": 99.234,
   "id": "c48"
  },
  {
   "text": "比喻不成立的地方是",
   "start": 100.224,
   "end": 101.751,
   "id": "c49"
  },
  {
   "text": "真实的马路",
   "start": 101.843,
   "end": 102.906,
   "id": "c50"
  },
  {
   "text": "你可以换一扇窗再看一眼",
   "start": 103.069,
   "end": 105.001,
   "id": "c51"
  },
  {
   "text": "很多系统只接了一个 RPC",
   "start": 105.988,
   "end": 108.503,
   "id": "c52"
  },
  {
   "text": "从来没有第二扇窗",
   "start": 108.595,
   "end": 110.074,
   "id": "c53"
  }
 ]
}