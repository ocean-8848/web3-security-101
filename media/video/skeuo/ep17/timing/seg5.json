 "captions": [
  {
   "text": "回到开头的节点",
   "start": 1.648,
   "end": 2.996,
   "id": "c0"
  },
  {
   "text": "它的关键",
   "start": 3.98,
   "end": 4.864,
   "id": "c1"
  },
  {
   "text": "是按来源区别对待",
   "start": 4.884,
   "end": 6.459,
   "id": "c2"
  },
  {
   "text": "你从别的 IP 去查",
   "start": 7.44,
   "end": 8.871,
   "id": "c3"
  },
  {
   "text": "它就给你真数据",
   "start": 8.928,
   "end": 10.121,
   "id": "c4"
  },
  {
   "text": "所以防线不是多看几次同一个节点",
   "start": 11.092,
   "end": 13.94,
   "id": "c5"
  },
  {
   "text": "而是比对不同运营方的数据源",
   "start": 14.127,
   "end": 16.202,
   "id": "c6"
  },
  {
   "text": "第一条 多源校验",
   "start": 17.192,
   "end": 18.909,
   "id": "c7"
  },
  {
   "text": "充值扫描和跨链放行",
   "start": 19.884,
   "end": 21.958,
   "id": "c8"
  },
  {
   "text": "至少用两个独立来源",
   "start": 21.979,
   "end": 23.649,
   "id": "c9"
  },
  {
   "text": "比如自建节点加一家第三方 RPC",
   "start": 23.693,
   "end": 27.03,
   "id": "c10"
  },
  {
   "text": "独立要按运营方算",
   "start": 28.024,
   "end": 29.467,
   "id": "c11"
  },
  {
   "text": "同一家服务商的两个节点",
   "start": 29.583,
   "end": 31.337,
   "id": "c12"
  },
  {
   "text": "只算一个",
   "start": 31.476,
   "end": 32.301,
   "id": "c13"
  },
  {
   "text": "第二条 不降级",
   "start": 33.284,
   "end": 34.87,
   "id": "c14"
  },
  {
   "text": "节点超时后",
   "start": 35.856,
   "end": 37.061,
   "id": "c15"
  },
  {
   "text": "法定数不自动下降",
   "start": 37.129,
   "end": 38.788,
   "id": "c16"
  },
  {
   "text": "达不到法定数就暂停",
   "start": 39.772,
   "end": 41.632,
   "id": "c17"
  },
  {
   "text": "人工确认",
   "start": 41.807,
   "end": 42.775,
   "id": "c18"
  },
  {
   "text": "开头的事件里",
   "start": 43.76,
   "end": 44.894,
   "id": "c19"
  },
  {
   "text": "干净的 RPC 被打掉",
   "start": 45.01,
   "end": 47.132,
   "id": "c20"
  },
  {
   "text": "系统自动切到剩下的节点",
   "start": 47.295,
   "end": 49.215,
   "id": "c21"
  },
  {
   "text": "这就是降级",
   "start": 49.26,
   "end": 50.215,
   "id": "c22"
  },
  {
   "text": "第三条 结果冲突就暂停入账",
   "start": 51.204,
   "end": 54.016,
   "id": "c23"
  },
  {
   "text": "不挑一个先用",
   "start": 54.156,
   "end": 55.195,
   "id": "c24"
  },
  {
   "text": "第四条 节点本身也要比对",
   "start": 56.176,
   "end": 58.619,
   "id": "c25"
  },
  {
   "text": "链头要和不同网络",
   "start": 59.612,
   "end": 61.198,
   "id": "c26"
  },
  {
   "text": "不同运营方的来源持续比对",
   "start": 61.35,
   "end": 63.389,
   "id": "c27"
  },
  {
   "text": "对等连接也要来自不同网络",
   "start": 63.516,
   "end": 65.639,
   "id": "c28"
  },
  {
   "text": "自建节点可以选少数派客户端",
   "start": 66.624,
   "end": 69.21,
   "id": "c29"
  },
  {
   "text": "或者两种客户端互相比对",
   "start": 69.374,
   "end": 71.27,
   "id": "c30"
  },
  {
   "text": "硬分叉前完成升级",
   "start": 71.397,
   "end": 73.151,
   "id": "c31"
  },
  {
   "text": "这几条 对被替换的节点",
   "start": 74.14,
   "end": 76.381,
   "id": "c32"
  },
  {
   "text": "被日蚀的节点",
   "start": 76.437,
   "end": 77.667,
   "id": "c33"
  },
  {
   "text": "停在错误分叉上的节点 都有效",
   "start": 77.818,
   "end": 80.405,
   "id": "c34"
  },
  {
   "text": "局限是 如果所有来源都接在同一个上游",
   "start": 81.392,
   "end": 85.002,
   "id": "c35"
  },
  {
   "text": "数量再多也没用",
   "start": 85.07,
   "end": 86.383,
   "id": "c36"
  }
 ]
}