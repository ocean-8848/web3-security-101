 "captions": [
  {
   "text": "下面是手册给出的一套示例架构",
   "start": 1.55,
   "end": 4.505,
   "id": "c0"
  },
  {
   "text": "它综合了公开事件的教训",
   "start": 4.737,
   "end": 6.871,
   "id": "c1"
  },
  {
   "text": "不是哪家交易所公布的方案",
   "start": 7.059,
   "end": 8.949,
   "id": "c2"
  },
  {
   "text": "账本 意图签发",
   "start": 9.301,
   "end": 11.12,
   "id": "c3"
  },
  {
   "text": "策略引擎 审批",
   "start": 11.35,
   "end": 13.307,
   "id": "c4"
  },
  {
   "text": "签名集群 广播 链上",
   "start": 13.625,
   "end": 16.388,
   "id": "c5"
  },
  {
   "text": "再加一套独立监控",
   "start": 16.747,
   "end": 18.386,
   "id": "c6"
  },
  {
   "text": "开发电脑到签名集群",
   "start": 18.63,
   "end": 20.865,
   "id": "c7"
  },
  {
   "text": "这条线是禁止的",
   "start": 20.885,
   "end": 22.294,
   "id": "c8"
  },
  {
   "text": "网络上根本不该有这条路由",
   "start": 22.556,
   "end": 24.667,
   "id": "c9"
  },
  {
   "text": "我们挑四个重点",
   "start": 25.029,
   "end": 26.459,
   "id": "c10"
  },
  {
   "text": "第一 账本绑定签名",
   "start": 26.68,
   "end": 28.926,
   "id": "c11"
  },
  {
   "text": "签名服务只为账本里存在",
   "start": 29.321,
   "end": 31.752,
   "id": "c12"
  },
  {
   "text": "状态正确",
   "start": 31.799,
   "end": 32.709,
   "id": "c13"
  },
  {
   "text": "金额一致的提现单签名",
   "start": 32.744,
   "end": 34.701,
   "id": "c14"
  },
  {
   "text": "同一张单",
   "start": 35.06,
   "end": 35.834,
   "id": "c15"
  },
  {
   "text": "只能签一次",
   "start": 35.854,
   "end": 36.854,
   "id": "c16"
  },
  {
   "text": "目标和金额",
   "start": 37.224,
   "end": 38.545,
   "id": "c17"
  },
  {
   "text": "要从原始交易里解析出来",
   "start": 38.795,
   "end": 40.964,
   "id": "c18"
  },
  {
   "text": "不读上游写的描述",
   "start": 41.196,
   "end": 42.665,
   "id": "c19"
  },
  {
   "text": "伪造的提现指令",
   "start": 42.904,
   "end": 44.31,
   "id": "c20"
  },
  {
   "text": "在这里对不上账",
   "start": 44.559,
   "end": 45.854,
   "id": "c21"
  },
  {
   "text": "第二 策略读的是原始待签字节",
   "start": 46.17,
   "end": 49.762,
   "id": "c22"
  },
  {
   "text": "而且默认拒绝",
   "start": 49.916,
   "end": 51.443,
   "id": "c23"
  },
  {
   "text": "没有明确规则的交易类型",
   "start": 51.648,
   "end": 53.92,
   "id": "c24"
  },
  {
   "text": "一律不签",
   "start": 54.028,
   "end": 54.962,
   "id": "c25"
  },
  {
   "text": "比如 Safe 多签",
   "start": 55.274,
   "end": 56.464,
   "id": "c26"
  },
  {
   "text": "operation 只允许等于 0",
   "start": 56.587,
   "end": 58.365,
   "id": "c27"
  },
  {
   "text": "要用 1 只能指向官方的批量调用合约",
   "start": 58.683,
   "end": 62.48,
   "id": "c28"
  },
  {
   "text": "链上还有 Guard 合约再拦一次",
   "start": 62.632,
   "end": 64.803,
   "id": "c29"
  },
  {
   "text": "Bybit 那笔 operation 等于 1 的交易",
   "start": 65.15,
   "end": 68.066,
   "id": "c30"
  },
  {
   "text": "在这里会被拒绝",
   "start": 68.304,
   "end": 69.74,
   "id": "c31"
  },
  {
   "text": "再比如热钱包",
   "start": 69.99,
   "end": 71.408,
   "id": "c32"
  },
  {
   "text": "EIP-7702 授权一律拒签",
   "start": 71.518,
   "end": 72.886,
   "id": "c33"
  },
  {
   "text": "策略如果覆盖了这一条",
   "start": 73.069,
   "end": 76.475,
   "id": "c34"
  },
  {
   "text": "Binance 那批委托就签不出来",
   "start": 76.74,
   "end": 79.071,
   "id": "c35"
  },
  {
   "text": "第三 分链熔断",
   "start": 79.33,
   "end": 81.207,
   "id": "c36"
  },
  {
   "text": "某条链流出异常",
   "start": 81.797,
   "end": 83.289,
   "id": "c37"
  },
  {
   "text": "就停这条链的广播",
   "start": 83.367,
   "end": 84.846,
   "id": "c38"
  },
  {
   "text": "发现账本里没有对应订单的流出",
   "start": 85.07,
   "end": 87.836,
   "id": "c39"
  },
  {
   "text": "所有链一起停",
   "start": 88.086,
   "end": 89.379,
   "id": "c40"
  },
  {
   "text": "熔断的开关",
   "start": 89.695,
   "end": 90.664,
   "id": "c41"
  },
  {
   "text": "不能依赖已经被攻击的系统",
   "start": 90.778,
   "end": 92.939,
   "id": "c42"
  },
  {
   "text": "第四 紧急撤销",
   "start": 93.21,
   "end": 94.825,
   "id": "c43"
  },
  {
   "text": "7702 委托",
   "start": 95.122,
   "end": 96.245,
   "id": "c44"
  },
  {
   "text": "要用一笔新的授权",
   "start": 96.433,
   "end": 97.953,
   "id": "c45"
  },
  {
   "text": "把委托地址设成零地址",
   "start": 98.172,
   "end": 100.26,
   "id": "c46"
  },
  {
   "text": "才能清掉",
   "start": 100.28,
   "end": 101.017,
   "id": "c47"
  },
  {
   "text": "MPC 钱包没有一把单独的私钥能立刻做这件事",
   "start": 101.366,
   "end": 105.234,
   "id": "c48"
  },
  {
   "text": "所以要有一条独立的撤销路径",
   "start": 105.452,
   "end": 107.882,
   "id": "c49"
  },
  {
   "text": "预先批准",
   "start": 108.126,
   "end": 109.078,
   "id": "c50"
  },
  {
   "text": "每季度演练",
   "start": 109.219,
   "end": 110.25,
   "id": "c51"
  },
  {
   "text": "记下用时",
   "start": 110.412,
   "end": 111.291,
   "id": "c52"
  },
  {
   "text": "最后查一下账户代码",
   "start": 111.664,
   "end": 113.418,
   "id": "c53"
  },
  {
   "text": "结果为空",
   "start": 113.438,
   "end": 114.364,
   "id": "c54"
  },
  {
   "text": "才算完成",
   "start": 114.456,
   "end": 115.264,
   "id": "c55"
  },
  {
   "text": "也要说清局限",
   "start": 115.648,
   "end": 116.805,
   "id": "c56"
  },
  {
   "text": "架构挡不住所有内部人作恶",
   "start": 117.59,
   "end": 120.168,
   "id": "c57"
  },
  {
   "text": "它做的 是把一个人作恶",
   "start": 120.463,
   "end": 122.78,
   "id": "c58"
  },
  {
   "text": "变成需要多人共谋",
   "start": 122.871,
   "end": 124.95,
   "id": "c59"
  }
 ]
