 "captions": [
  {
   "text": "2024 年以来的六起大额事件",
   "start": 1.648,
   "end": 3.818,
   "id": "c0"
  },
  {
   "text": "我们一个一个",
   "start": 3.933,
   "end": 5.294,
   "id": "c1"
  },
  {
   "text": "放到这条路上",
   "start": 5.374,
   "end": 6.365,
   "id": "c2"
  },
  {
   "text": "先看第二关",
   "start": 7.364,
   "end": 8.641,
   "id": "c3"
  },
  {
   "text": "2026 年 9 月",
   "start": 9.004,
   "end": 10.329,
   "id": "c4"
  },
  {
   "text": "Bitget 被转走约 3.9 亿美元",
   "start": 10.421,
   "end": 12.936,
   "id": "c5"
  },
  {
   "text": "项目方说",
   "start": 13.92,
   "end": 14.935,
   "id": "c6"
  },
  {
   "text": "一款第三方安全产品的零日漏洞",
   "start": 15.146,
   "end": 17.816,
   "id": "c7"
  },
  {
   "text": "泄露了内部凭证",
   "start": 17.86,
   "end": 19.256,
   "id": "c8"
  },
  {
   "text": "攻击者用定制工具",
   "start": 20.236,
   "end": 21.953,
   "id": "c9"
  },
  {
   "text": "伪造了提现指令",
   "start": 22.045,
   "end": 23.477,
   "id": "c10"
  },
  {
   "text": "项目方说",
   "start": 24.464,
   "end": 25.419,
   "id": "c11"
  },
  {
   "text": "私钥和冷钱包没有受影响",
   "start": 25.523,
   "end": 27.634,
   "id": "c12"
  },
  {
   "text": "那款产品的名字",
   "start": 27.997,
   "end": 29.274,
   "id": "c13"
  },
  {
   "text": "至今没有公开",
   "start": 29.378,
   "end": 30.596,
   "id": "c14"
  },
  {
   "text": "再看第四关",
   "start": 31.596,
   "end": 32.92,
   "id": "c15"
  },
  {
   "text": "2024 年 7 月",
   "start": 33.284,
   "end": 34.561,
   "id": "c16"
  },
  {
   "text": "WazirX 损失约 2.3 亿美元",
   "start": 34.641,
   "end": 37.156,
   "id": "c17"
  },
  {
   "text": "WazirX 说",
   "start": 38.152,
   "end": 39.322,
   "id": "c18"
  },
  {
   "text": "托管方 Liminal 界面上显示的",
   "start": 39.461,
   "end": 41.441,
   "id": "c19"
  },
  {
   "text": "和实际签的不一样",
   "start": 41.461,
   "end": 42.691,
   "id": "c20"
  },
  {
   "text": "Liminal 说",
   "start": 43.676,
   "end": 44.596,
   "id": "c21"
  },
  {
   "text": "自己没有被攻破",
   "start": 44.616,
   "end": 45.81,
   "id": "c22"
  },
  {
   "text": "双方说法冲突",
   "start": 46.173,
   "end": 47.629,
   "id": "c23"
  },
  {
   "text": "还没有最终的独立报告",
   "start": 47.661,
   "end": 49.569,
   "id": "c24"
  },
  {
   "text": "同样断在第四关的",
   "start": 50.568,
   "end": 52.155,
   "id": "c25"
  },
  {
   "text": "是开头讲的 Bybit",
   "start": 52.175,
   "end": 53.928,
   "id": "c26"
  },
  {
   "text": "Safe 说",
   "start": 54.916,
   "end": 55.871,
   "id": "c27"
  },
  {
   "text": "一名开发者的电脑先被攻破",
   "start": 56.154,
   "end": 58.181,
   "id": "c28"
  },
  {
   "text": "攻击者劫持了他的 AWS 会话令牌",
   "start": 58.225,
   "end": 61.657,
   "id": "c29"
  },
  {
   "text": "改掉了托管在 S3 上的前端代码",
   "start": 62.648,
   "end": 65.353,
   "id": "c30"
  },
  {
   "text": "篡改的代码",
   "start": 66.348,
   "end": 67.256,
   "id": "c31"
  },
  {
   "text": "只对 Bybit 的冷钱包生效",
   "start": 67.276,
   "end": 69.184,
   "id": "c32"
  },
  {
   "text": "交易完成大约 2 分钟后",
   "start": 69.56,
   "end": 71.372,
   "id": "c33"
  },
  {
   "text": "代码又被换了回来",
   "start": 71.56,
   "end": 72.92,
   "id": "c34"
  },
  {
   "text": "签名人看到的屏幕",
   "start": 73.912,
   "end": 75.415,
   "id": "c35"
  },
  {
   "text": "来自同一个被篡改的前端",
   "start": 75.543,
   "end": 77.367,
   "id": "c36"
  },
  {
   "text": "他们没有第二个地方可以核对",
   "start": 77.743,
   "end": 79.758,
   "id": "c37"
  },
  {
   "text": "第五关签名人自己",
   "start": 80.756,
   "end": 82.89,
   "id": "c38"
  },
  {
   "text": "2026 年 4 月",
   "start": 83.265,
   "end": 84.519,
   "id": "c39"
  },
  {
   "text": "Solana 上的 Drift",
   "start": 84.539,
   "end": 85.983,
   "id": "c40"
  },
  {
   "text": "损失约 2.85 亿美元",
   "start": 86.098,
   "end": 88.161,
   "id": "c41"
  },
  {
   "text": "第三方分析说",
   "start": 89.16,
   "end": 90.389,
   "id": "c42"
  },
  {
   "text": "安全委员会五个人里两人签名就能生效",
   "start": 90.552,
   "end": 93.675,
   "id": "c43"
  },
  {
   "text": "迁移后没有时间锁",
   "start": 93.731,
   "end": 95.282,
   "id": "c44"
  },
  {
   "text": "成员预先签了",
   "start": 96.244,
   "end": 97.664,
   "id": "c45"
  },
  {
   "text": "自己没完全看懂的交易",
   "start": 97.732,
   "end": 99.306,
   "id": "c46"
  },
  {
   "text": "Solana 的持久 nonce",
   "start": 100.304,
   "end": 101.783,
   "id": "c47"
  },
  {
   "text": "让这些签名不会自然过期",
   "start": 101.816,
   "end": 103.938,
   "id": "c48"
  },
  {
   "text": "攻击者可以等",
   "start": 104.313,
   "end": 105.459,
   "id": "c49"
  },
  {
   "text": "等到时机合适再提交",
   "start": 105.504,
   "end": 107.364,
   "id": "c50"
  },
  {
   "text": "再看那条支线数据源",
   "start": 108.348,
   "end": 110.589,
   "id": "c51"
  },
  {
   "text": "同在 2026 年 4 月",
   "start": 110.964,
   "end": 112.575,
   "id": "c52"
  },
  {
   "text": "KelpDAO 损失约 2.92 亿美元",
   "start": 112.69,
   "end": 115.265,
   "id": "c53"
  },
  {
   "text": "这座跨链桥只用了一个验证者",
   "start": 116.248,
   "end": 118.632,
   "id": "c54"
  },
  {
   "text": "LayerZero 说",
   "start": 119.612,
   "end": 120.793,
   "id": "c55"
  },
  {
   "text": "攻击者替换了它依赖的两个 RPC 节点",
   "start": 120.981,
   "end": 124.043,
   "id": "c56"
  },
  {
   "text": "再用 DDoS 打掉其他节点",
   "start": 124.135,
   "end": 126.139,
   "id": "c57"
  },
  {
   "text": "逼它切换过去",
   "start": 126.183,
   "end": 127.305,
   "id": "c58"
  },
  {
   "text": "恶意节点只对这个验证者撒谎",
   "start": 128.304,
   "end": 130.862,
   "id": "c59"
  },
  {
   "text": "验证者本身没被攻破",
   "start": 131.239,
   "end": 133.044,
   "id": "c60"
  },
  {
   "text": "它诚实地",
   "start": 133.328,
   "end": 134.275,
   "id": "c61"
  },
  {
   "text": "对假数据签了名",
   "start": 134.295,
   "end": 135.779,
   "id": "c62"
  },
  {
   "text": "责任怎么划分",
   "start": 136.756,
   "end": 137.973,
   "id": "c63"
  },
  {
   "text": "双方有争议",
   "start": 138.006,
   "end": 139.128,
   "id": "c64"
  },
  {
   "text": "已经进入诉讼",
   "start": 139.303,
   "end": 140.378,
   "id": "c65"
  }
 ]
}