 "captions": [
  {
   "text": "下面是手册给出的一套示例架构",
   "start": 1.648,
   "end": 4.353,
   "id": "c0"
  },
  {
   "text": "它综合了公开事件的教训",
   "start": 4.729,
   "end": 6.601,
   "id": "c1"
  },
  {
   "text": "不是哪家交易所公布的方案",
   "start": 6.752,
   "end": 8.506,
   "id": "c2"
  },
  {
   "text": "账本意图签发",
   "start": 9.5,
   "end": 11.301,
   "id": "c3"
  },
  {
   "text": "策略引擎审批",
   "start": 11.369,
   "end": 13.253,
   "id": "c4"
  },
  {
   "text": "签名集群广播链上",
   "start": 13.321,
   "end": 15.967,
   "id": "c5"
  },
  {
   "text": "再加一套独立监控",
   "start": 16.059,
   "end": 17.658,
   "id": "c6"
  },
  {
   "text": "开发电脑到签名集群",
   "start": 18.648,
   "end": 20.532,
   "id": "c7"
  },
  {
   "text": "这条线是禁止的",
   "start": 20.731,
   "end": 22.127,
   "id": "c8"
  },
  {
   "text": "网络上根本不该有这条路由",
   "start": 22.49,
   "end": 24.601,
   "id": "c9"
  },
  {
   "text": "我们挑四个重点",
   "start": 25.588,
   "end": 26.96,
   "id": "c10"
  },
  {
   "text": "第一账本绑定签名",
   "start": 27.335,
   "end": 29.612,
   "id": "c11"
  },
  {
   "text": "签名服务只为账本里存在",
   "start": 30.609,
   "end": 32.849,
   "id": "c12"
  },
  {
   "text": "状态正确",
   "start": 32.872,
   "end": 33.884,
   "id": "c13"
  },
  {
   "text": "金额一致的提现单签名",
   "start": 33.979,
   "end": 36.039,
   "id": "c14"
  },
  {
   "text": "同一张单",
   "start": 36.421,
   "end": 37.325,
   "id": "c15"
  },
  {
   "text": "只能签一次",
   "start": 37.504,
   "end": 38.529,
   "id": "c16"
  },
  {
   "text": "目标和金额",
   "start": 39.516,
   "end": 40.721,
   "id": "c17"
  },
  {
   "text": "要从原始交易里解析出来",
   "start": 40.778,
   "end": 42.697,
   "id": "c18"
  },
  {
   "text": "不读上游写的描述",
   "start": 42.813,
   "end": 44.233,
   "id": "c19"
  },
  {
   "text": "伪造的提现指令",
   "start": 44.608,
   "end": 46.005,
   "id": "c20"
  },
  {
   "text": "在这里对不上账",
   "start": 46.12,
   "end": 47.35,
   "id": "c21"
  },
  {
   "text": "第二策略读的是原始待签字节",
   "start": 48.328,
   "end": 51.379,
   "id": "c22"
  },
  {
   "text": "而且默认拒绝",
   "start": 51.482,
   "end": 52.855,
   "id": "c23"
  },
  {
   "text": "没有明确规则的交易类型",
   "start": 53.218,
   "end": 55.174,
   "id": "c24"
  },
  {
   "text": "一律不签",
   "start": 55.194,
   "end": 56.162,
   "id": "c25"
  },
  {
   "text": "比如 Safe 多签",
   "start": 57.14,
   "end": 58.762,
   "id": "c26"
  },
  {
   "text": "operation 只允许等于 0",
   "start": 58.878,
   "end": 61.083,
   "id": "c27"
  },
  {
   "text": "要用 1 只能指向官方的批量调用合约",
   "start": 62.065,
   "end": 65.161,
   "id": "c28"
  },
  {
   "text": "链上还有 Guard 合约再拦一次",
   "start": 65.22,
   "end": 67.593,
   "id": "c29"
  },
  {
   "text": "Bybit 那笔 operation 等于 1 的交易",
   "start": 68.596,
   "end": 71.23,
   "id": "c30"
  },
  {
   "text": "在这里会被拒绝",
   "start": 71.25,
   "end": 72.587,
   "id": "c31"
  },
  {
   "text": "再比如热钱包",
   "start": 73.568,
   "end": 74.833,
   "id": "c32"
  },
  {
   "text": "EIP-7702 授权一律拒签",
   "start": 74.96,
   "end": 77.749,
   "id": "c33"
  },
  {
   "text": "策略如果覆盖了这一条",
   "start": 78.125,
   "end": 79.819,
   "id": "c34"
  },
  {
   "text": "Binance 那批委托就签不出来",
   "start": 79.922,
   "end": 82.235,
   "id": "c35"
  },
  {
   "text": "第三分链熔断",
   "start": 83.22,
   "end": 85.044,
   "id": "c36"
  },
  {
   "text": "某条链流出异常",
   "start": 85.42,
   "end": 86.982,
   "id": "c37"
  },
  {
   "text": "就停这条链的广播",
   "start": 87.074,
   "end": 88.387,
   "id": "c38"
  },
  {
   "text": "发现账本里没有对应订单的流出",
   "start": 89.368,
   "end": 91.883,
   "id": "c39"
  },
  {
   "text": "所有链一起停",
   "start": 92.034,
   "end": 93.264,
   "id": "c40"
  },
  {
   "text": "熔断的开关",
   "start": 93.627,
   "end": 94.761,
   "id": "c41"
  },
  {
   "text": "不能依赖已经被攻击的系统",
   "start": 94.889,
   "end": 96.642,
   "id": "c42"
  },
  {
   "text": "第四紧急撤销",
   "start": 97.628,
   "end": 99.464,
   "id": "c43"
  },
  {
   "text": "7702 委托",
   "start": 99.84,
   "end": 101.426,
   "id": "c44"
  },
  {
   "text": "要用一笔新的授权",
   "start": 101.506,
   "end": 103.021,
   "id": "c45"
  },
  {
   "text": "把委托地址设成零地址",
   "start": 103.066,
   "end": 105.022,
   "id": "c46"
  },
  {
   "text": "才能清掉",
   "start": 105.042,
   "end": 105.95,
   "id": "c47"
  },
  {
   "text": "MPC 钱包没有一把单独的私钥能立刻做这件事",
   "start": 106.944,
   "end": 110.566,
   "id": "c48"
  },
  {
   "text": "所以要有一条独立的撤销路径",
   "start": 110.929,
   "end": 113.599,
   "id": "c49"
  },
  {
   "text": "预先批准",
   "start": 113.691,
   "end": 114.695,
   "id": "c50"
  },
  {
   "text": "每季度演练",
   "start": 114.858,
   "end": 115.98,
   "id": "c51"
  },
  {
   "text": "记下用时",
   "start": 116.048,
   "end": 117.087,
   "id": "c52"
  },
  {
   "text": "最后查一下账户代码",
   "start": 118.06,
   "end": 119.634,
   "id": "c53"
  },
  {
   "text": "结果为空",
   "start": 119.702,
   "end": 120.611,
   "id": "c54"
  },
  {
   "text": "才算完成",
   "start": 120.631,
   "end": 121.599,
   "id": "c55"
  },
  {
   "text": "也要说清局限",
   "start": 122.6,
   "end": 123.793,
   "id": "c56"
  },
  {
   "text": "架构挡不住所有内部人作恶",
   "start": 124.169,
   "end": 126.255,
   "id": "c57"
  },
  {
   "text": "它做的是把一个人作恶",
   "start": 126.633,
   "end": 128.768,
   "id": "c58"
  },
  {
   "text": "变成需要多人共谋",
   "start": 128.788,
   "end": 130.172,
   "id": "c59"
  }
 ]
