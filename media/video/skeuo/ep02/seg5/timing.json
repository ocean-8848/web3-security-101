   "id": "c0"
  },
  {
   "text": "在门限签名里",
   "start": 3.045,
   "end": 5.183,
   "id": "c1"
  },
  {
   "text": "也叫 TSS 或 MPC",
   "start": 5.226,
   "end": 7.498,
   "id": "c2"
  },
  {
   "text": "准确地说",
   "start": 7.865,
   "end": 8.622,
   "id": "c3"
  },
  {
   "text": "它是多方各持一份密钥分片",
   "start": 8.755,
   "end": 11.382,
   "id": "c4"
  },
  {
   "text": "合作产生签名",
   "start": 11.437,
   "end": 12.8,
   "id": "c5"
  },
  {
   "text": "安全性依赖协议里的每一步零知识证明",
   "start": 12.947,
   "end": 16.353,
   "id": "c6"
  },
  {
   "text": "打个比方",
   "start": 16.721,
   "end": 17.376,
   "id": "c7"
  },
  {
   "text": "几个人各拿一块拼图",
   "start": 17.905,
   "end": 19.865,
   "id": "c8"
  },
  {
   "text": "合作盖章",
   "start": 19.907,
   "end": 20.889,
   "id": "c9"
  },
  {
   "text": "每一步都要出示证明",
   "start": 21.249,
   "end": 22.964,
   "id": "c10"
  },
  {
   "text": "证明自己守规矩",
   "start": 23.071,
   "end": 24.382,
   "id": "c11"
  },
  {
   "text": "但不亮出自己那块",
   "start": 24.701,
   "end": 26.112,
   "id": "c12"
  },
  {
   "text": "比方不准的地方是",
   "start": 26.463,
   "end": 28.72,
   "id": "c13"
  },
  {
   "text": "分片不是拼图",
   "start": 28.833,
   "end": 29.792,
   "id": "c14"
  },
  {
   "text": "风险也不在有人偷拼图",
   "start": 29.908,
   "end": 32.324,
   "id": "c15"
  },
  {
   "text": "而在省掉一步证明后",
   "start": 32.682,
   "end": 34.463,
   "id": "c16"
  },
  {
   "text": "恶意参与方能在多次签名中",
   "start": 34.68,
   "end": 37.267,
   "id": "c17"
  },
  {
   "text": "逐步提取别人的分片",
   "start": 37.376,
   "end": 39.252,
   "id": "c18"
  },
  {
   "text": "2023 年 8 月",
   "start": 39.629,
   "end": 41.097,
   "id": "c19"
  },
  {
   "text": "Fireblocks 披露 BitForge",
   "start": 41.207,
   "end": 43.3,
   "id": "c20"
  },
  {
   "text": "GG18 和 GG20 的实现缺少参数证明",
   "start": 43.32,
   "end": 47.33,
   "id": "c21"
  },
  {
   "text": "恶意参与方可以提取完整私钥",
   "start": 47.522,
   "end": 50.052,
   "id": "c22"
  },
  {
   "text": "Lindell17 的实现偏离论文",
   "start": 50.407,
   "end": 52.923,
   "id": "c23"
  },
  {
   "text": "约 200 次签名请求就能提取私钥",
   "start": 53.08,
   "end": 56.345,
   "id": "c24"
  },
  {
   "text": "影响 15 家以上钱包服务商",
   "start": 56.4,
   "end": 59.087,
   "id": "c25"
  },
  {
   "text": "Verichains 的 TSSHOCK",
   "start": 59.33,
   "end": 60.888,
   "id": "c26"
  },
  {
   "text": "披露了三类攻击",
   "start": 60.908,
   "end": 62.436,
   "id": "c27"
  },
  {
   "text": "比如证明的重复次数从 128 降到 1",
   "start": 63.003,
   "end": 66.618,
   "id": "c28"
  },
  {
   "text": "可以直接猜中",
   "start": 66.995,
   "end": 68.07,
   "id": "c29"
  },
  {
   "text": "受影响的有 BNB 的 tss-lib",
   "start": 68.67,
   "end": 71.846,
   "id": "c30"
  },
  {
   "text": "Multichain",
   "start": 71.937,
   "end": 72.933,
   "id": "c31"
  },
  {
   "text": "THORChain",
   "start": 73.231,
   "end": 73.975,
   "id": "c32"
  },
  {
   "text": "Axelar 等多个开源库",
   "start": 74.161,
   "end": 76.203,
   "id": "c33"
  },
  {
   "text": "两项披露都没有报告实际资金损失",
   "start": 76.223,
   "end": 80.787,
   "id": "c34"
  },
  {
   "text": "教训是 MPC 库不能按论文简化",
   "start": 81.145,
   "end": 84.413,
   "id": "c35"
  },
  {
   "text": "选供应商时",
   "start": 84.562,
   "end": 85.603,
   "id": "c36"
  },
  {
   "text": "要问它是否修复了这两类漏洞",
   "start": 85.806,
   "end": 88.035,
   "id": "c37"
  },
  {
   "text": "并要审计报告",
   "start": 88.268,
   "end": 89.268,
   "id": "c38"
  },
  {
   "text": "最后看后量子",
   "start": 89.603,
   "end": 91.034,
   "id": "c39"
  },
  {
   "text": "足够大的量子计算机",
   "start": 91.26,
   "end": 92.837,
   "id": "c40"
  },
  {
   "text": "可以从公钥算出 ECDSA 和 EdDSA 私钥",
   "start": 92.947,
   "end": 96.825,
   "id": "c41"
  },
  {
   "text": "哈希函数受影响较小",
   "start": 96.876,
   "end": 99.375,
   "id": "c42"
  },
  {
   "text": "比特币 P2PKH 这类地址",
   "start": 99.747,
   "end": 102.473,
   "id": "c43"
  },
  {
   "text": "公钥在第一次签名后才暴露",
   "start": 102.723,
   "end": 104.97,
   "id": "c44"
  },
  {
   "text": "所以从未签过名的地址更安全",
   "start": 105.22,
   "end": 107.76,
   "id": "c45"
  },
  {
   "text": "截至 2026 年 11 月",
   "start": 108.03,
   "end": 110.055,
   "id": "c46"
  },
  {
   "text": "NIST 已发布后量子标准",
   "start": 110.238,
   "end": 112.806,
   "id": "c47"
  },
  {
   "text": "比特币的 BIP-360 仍是草案",
   "start": 112.963,
   "end": 115.914,
   "id": "c48"
  },
  {
   "text": "以太坊基金会的目标",
   "start": 116.267,
   "end": 118.554,
   "id": "c49"
  },
  {
   "text": "是约 2029 年完成核心基础设施",
   "start": 118.584,
   "end": 121.691,
   "id": "c50"
  },
  {
   "text": "这是规划",
   "start": 121.942,
   "end": 122.786,
   "id": "c51"
  },
  {
   "text": "不是承诺",
   "start": 123.049,
   "end": 123.816,
   "id": "c52"
  },
  {
   "text": "迁移周期以年计",
   "start": 124.07,
   "end": 125.887,
   "id": "c53"
  },
  {
   "text": "现在能做的",
   "start": 126.132,
   "end": 127.139,
   "id": "c54"
  },
  {
   "text": "是盘点资产",
   "start": 127.218,
   "end": 128.443,
   "id": "c55"
  },
  {
   "text": "避免地址重复使用",
   "start": 128.499,
   "end": 130.055,
   "id": "c56"
  },
  {
   "text": "跟踪各链的迁移计划",
   "start": 130.506,
   "end": 132.279,
   "id": "c57"
  }
 ]
}