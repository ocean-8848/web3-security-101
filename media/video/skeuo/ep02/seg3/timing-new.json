 "captions": [
  {
   "text": "先看第一处 熵不足",
   "start": 1.648,
   "end": 3.853,
   "id": "c0"
  },
  {
   "text": "攻击路径有四步",
   "start": 4.229,
   "end": 5.803,
   "id": "c1"
  },
  {
   "text": "第一 生成器用了状态很小的伪随机数生成器",
   "start": 6.764,
   "end": 10.672,
   "id": "c2"
  },
  {
   "text": "比如只用 32 位种子初始化的 mt19937",
   "start": 10.823,
   "end": 15.017,
   "id": "c3"
  },
  {
   "text": "第二 种子只有约 43 亿种",
   "start": 16.008,
   "end": 18.57,
   "id": "c4"
  },
  {
   "text": "私钥也就只有约 43 亿种",
   "start": 18.662,
   "end": 20.749,
   "id": "c5"
  },
  {
   "text": "第三 攻击者在 GPU 上枚举全部种子",
   "start": 21.724,
   "end": 25.513,
   "id": "c6"
  },
  {
   "text": "算出对应的地址",
   "start": 25.533,
   "end": 26.989,
   "id": "c7"
  },
  {
   "text": "第四 和链上有余额的地址比对",
   "start": 27.968,
   "end": 31.019,
   "id": "c8"
  },
  {
   "text": "命中 就转走资产",
   "start": 31.394,
   "end": 33.504,
   "id": "c9"
  },
  {
   "text": "看起来随机",
   "start": 34.5,
   "end": 35.551,
   "id": "c10"
  },
  {
   "text": "不等于安全",
   "start": 35.654,
   "end": 36.586,
   "id": "c11"
  },
  {
   "text": "私钥必须来自 CSPRNG",
   "start": 36.962,
   "end": 39.382,
   "id": "c12"
  },
  {
   "text": "也就是密码学安全随机数生成器",
   "start": 39.426,
   "end": 41.893,
   "id": "c13"
  },
  {
   "text": "满 256 位熵",
   "start": 41.985,
   "end": 43.429,
   "id": "c14"
  },
  {
   "text": "三个案例",
   "start": 44.416,
   "end": 45.538,
   "id": "c15"
  },
  {
   "text": "走的都是这条路",
   "start": 45.558,
   "end": 46.764,
   "id": "c16"
  },
  {
   "text": "第一个是 Profanity",
   "start": 47.732,
   "end": 49.402,
   "id": "c17"
  },
  {
   "text": "1.60 及以前的版本只用 32 位种子",
   "start": 49.777,
   "end": 53.006,
   "id": "c18"
  },
  {
   "text": "2022 年 9 月 15 日",
   "start": 54.0,
   "end": 55.741,
   "id": "c19"
  },
  {
   "text": "1inch 公开披露",
   "start": 55.762,
   "end": 57.134,
   "id": "c20"
  },
  {
   "text": "5 天后 Wintermute 被盗",
   "start": 57.509,
   "end": 59.441,
   "id": "c21"
  },
  {
   "text": "同期还有多个受害者",
   "start": 59.807,
   "end": 61.596,
   "id": "c22"
  },
  {
   "text": "第二个 Trust Wallet 浏览器扩展",
   "start": 62.572,
   "end": 65.194,
   "id": "c23"
  },
  {
   "text": "Wallet Core 的 WASM 版本生成助记词",
   "start": 65.569,
   "end": 69.275,
   "id": "c24"
  },
  {
   "text": "用的是 mt19937",
   "start": 69.295,
   "end": 71.692,
   "id": "c25"
  },
  {
   "text": "熵从 256 位降到 32 位",
   "start": 71.831,
   "end": 74.549,
   "id": "c26"
  },
  {
   "text": "受影响的",
   "start": 75.536,
   "end": 76.551,
   "id": "c27"
  },
  {
   "text": "是 2022 年 11 月 14 日",
   "start": 76.571,
   "end": 78.444,
   "id": "c28"
  },
  {
   "text": "到 23 日新建的扩展钱包",
   "start": 78.464,
   "end": 80.944,
   "id": "c29"
  },
  {
   "text": "Ledger 的安全团队报告后",
   "start": 81.307,
   "end": 83.215,
   "id": "c30"
  },
  {
   "text": "几天内就修复了",
   "start": 83.378,
   "end": 84.703,
   "id": "c31"
  },
  {
   "text": "但部分弱钱包后来还是被盗",
   "start": 85.692,
   "end": 87.933,
   "id": "c32"
  },
  {
   "text": "损失约 17 万美元",
   "start": 88.096,
   "end": 89.85,
   "id": "c33"
  },
  {
   "text": "Trust Wallet 承诺补偿",
   "start": 89.87,
   "end": 91.814,
   "id": "c34"
  },
  {
   "text": "第三个",
   "start": 92.8,
   "end": 93.565,
   "id": "c35"
  },
  {
   "text": "Libbitcoin Explorer",
   "start": 93.585,
   "end": 94.756,
   "id": "c36"
  },
  {
   "text": "的 Milk Sad 漏洞",
   "start": 94.776,
   "end": 96.077,
   "id": "c37"
  },
  {
   "text": "它生成种子的命令",
   "start": 96.452,
   "end": 97.955,
   "id": "c38"
  },
  {
   "text": "用的是一个 32 位的时间值",
   "start": 98.035,
   "end": 100.074,
   "id": "c39"
  },
  {
   "text": "2023 年 7 月 12 日发生集中盗取",
   "start": 101.06,
   "end": 104.218,
   "id": "c40"
  },
  {
   "text": "损失至少约 90 万美元",
   "start": 104.381,
   "end": 106.742,
   "id": "c41"
  },
  {
   "text": "厂商认为",
   "start": 107.736,
   "end": 108.81,
   "id": "c42"
  },
  {
   "text": "文档早有警告",
   "start": 108.974,
   "end": 110.441,
   "id": "c43"
  },
  {
   "text": "教训有三条",
   "start": 111.436,
   "end": 112.713,
   "id": "c44"
  },
  {
   "text": "在 WASM 或 JS 里替换随机源",
   "start": 113.076,
   "end": 116.163,
   "id": "c45"
  },
  {
   "text": "要单独审计",
   "start": 116.183,
   "end": 117.27,
   "id": "c46"
  },
  {
   "text": "文档里的警告挡不住误用",
   "start": 118.256,
   "end": 120.354,
   "id": "c47"
  },
  {
   "text": "生成密钥的接口必须默认安全",
   "start": 120.541,
   "end": 123.164,
   "id": "c48"
  },
  {
   "text": "最容易漏掉的一条是",
   "start": 124.164,
   "end": 125.798,
   "id": "c49"
  },
  {
   "text": "修好代码",
   "start": 125.866,
   "end": 126.917,
   "id": "c50"
  },
  {
   "text": "修不好已经生成的弱私钥",
   "start": 126.949,
   "end": 128.881,
   "id": "c51"
  },
  {
   "text": "用户必须迁移到新地址",
   "start": 129.256,
   "end": 131.248,
   "id": "c52"
  }
 ]
}