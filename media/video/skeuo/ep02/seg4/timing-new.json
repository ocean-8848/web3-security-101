 "captions": [
  {
   "text": "第二处随机性",
   "start": 1.648,
   "end": 2.96,
   "id": "c0"
  },
  {
   "text": "在签名里",
   "start": 3.04,
   "end": 3.96,
   "id": "c1"
  },
  {
   "text": "ECDSA 每次签名",
   "start": 4.94,
   "end": 6.372,
   "id": "c2"
  },
  {
   "text": "都需要一个一次性的数 叫 k",
   "start": 6.392,
   "end": 8.574,
   "id": "c3"
  },
  {
   "text": "也就是 nonce",
   "start": 8.594,
   "end": 9.645,
   "id": "c4"
  },
  {
   "text": "k 出错有三种情况",
   "start": 10.608,
   "end": 12.551,
   "id": "c5"
  },
  {
   "text": "第一种 两次签名用了同一个 k",
   "start": 12.927,
   "end": 15.847,
   "id": "c6"
  },
  {
   "text": "攻击者还需要别的东西吗",
   "start": 16.828,
   "end": 18.807,
   "id": "c7"
  },
  {
   "text": "不需要",
   "start": 20.064,
   "end": 20.876,
   "id": "c8"
  },
  {
   "text": "两个签名和两个消息哈希都是公开的",
   "start": 21.24,
   "end": 24.291,
   "id": "c9"
  },
  {
   "text": "直接解方程",
   "start": 24.442,
   "end": 25.66,
   "id": "c10"
  },
  {
   "text": "就得到私钥",
   "start": 25.776,
   "end": 26.696,
   "id": "c11"
  },
  {
   "text": "打个比方",
   "start": 27.676,
   "end": 28.631,
   "id": "c12"
  },
  {
   "text": "nonce 像一块每次都换的遮布",
   "start": 28.995,
   "end": 31.177,
   "id": "c13"
  },
  {
   "text": "盖在私钥上面",
   "start": 31.197,
   "end": 32.296,
   "id": "c14"
  },
  {
   "text": "同一块布用了两次",
   "start": 33.296,
   "end": 34.727,
   "id": "c15"
  },
  {
   "text": "两次结果一对比",
   "start": 34.831,
   "end": 36.18,
   "id": "c16"
  },
  {
   "text": "布就被消掉",
   "start": 36.343,
   "end": 37.644,
   "id": "c17"
  },
  {
   "text": "私钥就显出来了",
   "start": 37.688,
   "end": 38.954,
   "id": "c18"
  },
  {
   "text": "比方的局限是",
   "start": 39.924,
   "end": 41.117,
   "id": "c19"
  },
  {
   "text": "真实过程是解方程",
   "start": 41.174,
   "end": 42.867,
   "id": "c20"
  },
  {
   "text": "而且下面两种情况",
   "start": 43.243,
   "end": 44.782,
   "id": "c21"
  },
  {
   "text": "一次对比无法解决",
   "start": 44.909,
   "end": 46.556,
   "id": "c22"
  },
  {
   "text": "第二种 k 有偏置",
   "start": 47.536,
   "end": 49.241,
   "id": "c23"
  },
  {
   "text": "比如高几位总是 0",
   "start": 49.393,
   "end": 51.039,
   "id": "c24"
  },
  {
   "text": "收集足够多签名",
   "start": 51.402,
   "end": 52.989,
   "id": "c25"
  },
  {
   "text": "用格方法就能恢复私钥",
   "start": 53.093,
   "end": 55.168,
   "id": "c26"
  },
  {
   "text": "第三种最糟",
   "start": 56.156,
   "end": 57.457,
   "id": "c27"
  },
  {
   "text": "k 可以由公开数据算出",
   "start": 57.82,
   "end": 59.811,
   "id": "c28"
  },
  {
   "text": "那么单个签名就能反推私钥",
   "start": 60.034,
   "end": 62.335,
   "id": "c29"
  },
  {
   "text": "标准早有解法",
   "start": 63.312,
   "end": 64.66,
   "id": "c30"
  },
  {
   "text": "叫 RFC 6979",
   "start": 64.716,
   "end": 67.077,
   "id": "c31"
  },
  {
   "text": "它用私钥和消息",
   "start": 67.452,
   "end": 69.015,
   "id": "c32"
  },
  {
   "text": "确定性地派生 k",
   "start": 69.166,
   "end": 70.539,
   "id": "c33"
  },
  {
   "text": "可以消除前两种风险",
   "start": 70.559,
   "end": 72.229,
   "id": "c34"
  },
  {
   "text": "EdDSA 标准也要求",
   "start": 73.228,
   "end": 75.362,
   "id": "c35"
  },
  {
   "text": "nonce 由私钥的秘密部分派生",
   "start": 75.501,
   "end": 77.79,
   "id": "c36"
  },
  {
   "text": "风险来自偏离标准的实现",
   "start": 78.166,
   "end": 80.121,
   "id": "c37"
  },
  {
   "text": "三个案例",
   "start": 81.104,
   "end": 82.059,
   "id": "c38"
  },
  {
   "text": "2013 年 8 月",
   "start": 82.435,
   "end": 83.64,
   "id": "c39"
  },
  {
   "text": "Android 的随机数缺陷",
   "start": 83.792,
   "end": 85.497,
   "id": "c40"
  },
  {
   "text": "让不同签名用了相同的 nonce",
   "start": 85.601,
   "end": 87.926,
   "id": "c41"
  },
  {
   "text": "多款比特币钱包受影响",
   "start": 87.97,
   "end": 89.736,
   "id": "c42"
  },
  {
   "text": "2019 年",
   "start": 90.708,
   "end": 91.794,
   "id": "c43"
  },
  {
   "text": "一项研究用格方法",
   "start": 91.958,
   "end": 93.473,
   "id": "c44"
  },
  {
   "text": "恢复出数百个比特币私钥",
   "start": 93.517,
   "end": 95.58,
   "id": "c45"
  },
  {
   "text": "和数十个以太坊私钥",
   "start": 95.6,
   "end": 97.461,
   "id": "c46"
  },
  {
   "text": "2026 年 6 月",
   "start": 98.44,
   "end": 99.693,
   "id": "c47"
  },
  {
   "text": "Cardano 钱包 SecondFi",
   "start": 99.868,
   "end": 101.693,
   "id": "c48"
  },
  {
   "text": "的 Android 版",
   "start": 101.713,
   "end": 102.717,
   "id": "c49"
  },
  {
   "text": "用公开交易数据派生 nonce",
   "start": 102.749,
   "end": 105.074,
   "id": "c50"
  },
  {
   "text": "漏掉了秘密部分",
   "start": 105.106,
   "end": 106.348,
   "id": "c51"
  },
  {
   "text": "nonce 人人可算",
   "start": 107.348,
   "end": 108.803,
   "id": "c52"
  },
  {
   "text": "单个签名就能反推私钥",
   "start": 109.05,
   "end": 111.065,
   "id": "c53"
  },
  {
   "text": "374 个钱包被盗",
   "start": 112.032,
   "end": 113.749,
   "id": "c54"
  },
  {
   "text": "约 1600 万 ADA",
   "start": 113.913,
   "end": 115.559,
   "id": "c55"
  },
  {
   "text": "约 240 万美元",
   "start": 115.686,
   "end": 117.237,
   "id": "c56"
  },
  {
   "text": "这是官方口径",
   "start": 117.613,
   "end": 118.843,
   "id": "c57"
  },
  {
   "text": "SlowMist 的估计更高",
   "start": 118.863,
   "end": 120.711,
   "id": "c58"
  },
  {
   "text": "硬件钱包签名走另一条路径",
   "start": 121.684,
   "end": 124.151,
   "id": "c59"
  },
  {
   "text": "不受影响",
   "start": 124.196,
   "end": 125.056,
   "id": "c60"
  },
  {
   "text": "教训是 nonce 必须确定性派生",
   "start": 126.056,
   "end": 129.166,
   "id": "c61"
  },
  {
   "text": "并包含私钥的秘密材料",
   "start": 129.222,
   "end": 131.154,
   "id": "c62"
  },
  {
   "text": "封装层要做已知答案测试",
   "start": 131.529,
   "end": 133.664,
   "id": "c63"
  },
  {
   "text": "不能只信任底层库",
   "start": 133.732,
   "end": 135.259,
   "id": "c64"
  }
 ]
}