 "captions": [
  {
   "text": "第二处随机性",
   "start": 1.55,
   "end": 3.089,
   "id": "c0"
  },
  {
   "text": "在签名里",
   "start": 3.237,
   "end": 4.274,
   "id": "c1"
  },
  {
   "text": "ECDSA 每次签名",
   "start": 4.669,
   "end": 6.679,
   "id": "c2"
  },
  {
   "text": "都需要一个一次性的数 叫 k",
   "start": 6.707,
   "end": 9.197,
   "id": "c3"
  },
  {
   "text": "也就是 nonce",
   "start": 9.399,
   "end": 10.647,
   "id": "c4"
  },
  {
   "text": "k 出错有三种情况",
   "start": 10.965,
   "end": 12.665,
   "id": "c5"
  },
  {
   "text": "第一种 两次签名用了同一个 k",
   "start": 12.848,
   "end": 15.486,
   "id": "c6"
  },
  {
   "text": "攻击者还需要别的东西吗",
   "start": 15.73,
   "end": 17.691,
   "id": "c7"
  },
  {
   "text": "不需要",
   "start": 18.332,
   "end": 18.931,
   "id": "c8"
  },
  {
   "text": "两个签名和两个消息哈希都是公开的",
   "start": 19.188,
   "end": 22.322,
   "id": "c9"
  },
  {
   "text": "直接解方程",
   "start": 22.523,
   "end": 23.569,
   "id": "c10"
  },
  {
   "text": "就得到私钥",
   "start": 23.589,
   "end": 24.48,
   "id": "c11"
  },
  {
   "text": "打个比方",
   "start": 24.866,
   "end": 25.519,
   "id": "c12"
  },
  {
   "text": "nonce 像一块每次都换的遮布",
   "start": 25.727,
   "end": 28.786,
   "id": "c13"
  },
  {
   "text": "盖在私钥上面",
   "start": 28.838,
   "end": 30.016,
   "id": "c14"
  },
  {
   "text": "同一块布用了两次",
   "start": 30.366,
   "end": 32.086,
   "id": "c15"
  },
  {
   "text": "两次结果一对比",
   "start": 32.514,
   "end": 33.853,
   "id": "c16"
  },
  {
   "text": "布就被消掉",
   "start": 34.019,
   "end": 35.117,
   "id": "c17"
  },
  {
   "text": "私钥就显出来了",
   "start": 35.169,
   "end": 36.449,
   "id": "c18"
  },
  {
   "text": "比方的局限是",
   "start": 36.838,
   "end": 38.071,
   "id": "c19"
  },
  {
   "text": "真实过程是解方程",
   "start": 38.28,
   "end": 40.297,
   "id": "c20"
  },
  {
   "text": "而且下面两种情况",
   "start": 40.491,
   "end": 42.268,
   "id": "c21"
  },
  {
   "text": "一次对比无法解决",
   "start": 42.333,
   "end": 44.101,
   "id": "c22"
  },
  {
   "text": "第二种 k 有偏置",
   "start": 44.39,
   "end": 46.461,
   "id": "c23"
  },
  {
   "text": "比如高几位总是 0",
   "start": 46.932,
   "end": 47.999,
   "id": "c24"
  },
  {
   "text": "收集足够多签名",
   "start": 48.019,
   "end": 50.622,
   "id": "c25"
  },
  {
   "text": "用格方法就能恢复私钥",
   "start": 50.696,
   "end": 52.577,
   "id": "c26"
  },
  {
   "text": "第三种最糟",
   "start": 52.85,
   "end": 54.063,
   "id": "c27"
  },
  {
   "text": "k 可以由公开数据算出",
   "start": 54.583,
   "end": 56.59,
   "id": "c28"
  },
  {
   "text": "那么单个签名就能反推私钥",
   "start": 56.789,
   "end": 59.272,
   "id": "c29"
  },
  {
   "text": "标准早有解法",
   "start": 59.645,
   "end": 60.914,
   "id": "c30"
  },
  {
   "text": "叫 RFC 6979",
   "start": 61.148,
   "end": 62.259,
   "id": "c31"
  },
  {
   "text": "它用私钥和消息",
   "start": 62.279,
   "end": 64.88,
   "id": "c32"
  },
  {
   "text": "确定性地派生 k",
   "start": 65.06,
   "end": 65.842,
   "id": "c33"
  },
  {
   "text": "可以消除前两种风险",
   "start": 65.862,
   "end": 68.387,
   "id": "c34"
  },
  {
   "text": "EdDSA 标准也要求",
   "start": 68.75,
   "end": 70.581,
   "id": "c35"
  },
  {
   "text": "nonce 由私钥的秘密部分派生",
   "start": 70.641,
   "end": 73.261,
   "id": "c36"
  },
  {
   "text": "风险来自偏离标准的实现",
   "start": 73.627,
   "end": 75.826,
   "id": "c37"
  },
  {
   "text": "三个案例",
   "start": 76.07,
   "end": 76.955,
   "id": "c38"
  },
  {
   "text": "2013 年 8 月",
   "start": 77.387,
   "end": 78.641,
   "id": "c39"
  },
  {
   "text": "Android 的随机数缺陷",
   "start": 78.752,
   "end": 80.594,
   "id": "c40"
  },
  {
   "text": "让不同签名用了相同的 nonce",
   "start": 80.75,
   "end": 83.182,
   "id": "c41"
  },
  {
   "text": "多款比特币钱包受影响",
   "start": 83.342,
   "end": 85.266,
   "id": "c42"
  },
  {
   "text": "2019 年",
   "start": 85.594,
   "end": 86.606,
   "id": "c43"
  },
  {
   "text": "一项研究用格方法",
   "start": 86.738,
   "end": 88.73,
   "id": "c44"
  },
  {
   "text": "恢复出数百个比特币私钥",
   "start": 88.973,
   "end": 91.254,
   "id": "c45"
  },
  {
   "text": "和数十个以太坊私钥",
   "start": 91.439,
   "end": 93.51,
   "id": "c46"
  },
  {
   "text": "2026 年 6 月",
   "start": 93.897,
   "end": 95.205,
   "id": "c47"
  },
  {
   "text": "Cardano 钱包 SecondFi",
   "start": 95.442,
   "end": 97.15,
   "id": "c48"
  },
  {
   "text": "的 Android 版",
   "start": 97.17,
   "end": 98.369,
   "id": "c49"
  },
  {
   "text": "用公开交易数据派生 nonce",
   "start": 98.593,
   "end": 100.877,
   "id": "c50"
  },
  {
   "text": "漏掉了秘密部分",
   "start": 100.973,
   "end": 102.439,
   "id": "c51"
  },
  {
   "text": "nonce 人人可算",
   "start": 102.752,
   "end": 104.318,
   "id": "c52"
  },
  {
   "text": "单个签名就能反推私钥",
   "start": 104.699,
   "end": 106.715,
   "id": "c53"
  },
  {
   "text": "374 个钱包被盗",
   "start": 106.95,
   "end": 109.015,
   "id": "c54"
  },
  {
   "text": "约 1600 万 ADA",
   "start": 109.203,
   "end": 110.833,
   "id": "c55"
  },
  {
   "text": "约 240 万美元",
   "start": 111.09,
   "end": 112.783,
   "id": "c56"
  },
  {
   "text": "这是官方口径",
   "start": 112.963,
   "end": 114.169,
   "id": "c57"
  },
  {
   "text": "SlowMist 的估计更高",
   "start": 114.345,
   "end": 116.197,
   "id": "c58"
  },
  {
   "text": "硬件钱包签名走另一条路径",
   "start": 116.45,
   "end": 118.773,
   "id": "c59"
  },
  {
   "text": "不受影响",
   "start": 118.866,
   "end": 119.665,
   "id": "c60"
  },
  {
   "text": "教训是 nonce 必须确定性派生",
   "start": 120.04,
   "end": 122.808,
   "id": "c61"
  },
  {
   "text": "并包含私钥的秘密材料",
   "start": 122.828,
   "end": 124.772,
   "id": "c62"
  },
  {
   "text": "封装层要做已知答案测试",
   "start": 125.036,
   "end": 127.343,
   "id": "c63"
  },
  {
   "text": "不能只信任底层库",
   "start": 127.457,
   "end": 129.074,
   "id": "c64"
  }
 ]
}