 "captions": [
  {
   "text": "2026 年 9 月",
   "start": 1.655,
   "end": 3.171,
   "id": "c0"
  },
  {
   "text": "一名 Binance 工程师接到面试邀约",
   "start": 3.442,
   "end": 6.499,
   "id": "c1"
  },
  {
   "text": "邀约来自正规的招聘平台",
   "start": 6.826,
   "end": 8.817,
   "id": "c2"
  },
  {
   "text": "他也参加了视频面试",
   "start": 9.086,
   "end": 10.664,
   "id": "c3"
  },
  {
   "text": "看上去一切正常",
   "start": 11.074,
   "end": 12.481,
   "id": "c4"
  },
  {
   "text": "面试结束前",
   "start": 12.808,
   "end": 13.8,
   "id": "c5"
  },
  {
   "text": "对方给了他一份作业",
   "start": 14.031,
   "end": 15.625,
   "id": "c6"
  },
  {
   "text": "一个代码仓库",
   "start": 15.89,
   "end": 17.027,
   "id": "c7"
  },
  {
   "text": "要他下载下来完成",
   "start": 17.362,
   "end": 19.008,
   "id": "c8"
  },
  {
   "text": "他把仓库下载到了工作电脑上",
   "start": 19.322,
   "end": 21.832,
   "id": "c9"
  },
  {
   "text": "他没有输入密码",
   "start": 22.09,
   "end": 23.608,
   "id": "c10"
  },
  {
   "text": "也没有点任何钓鱼链接",
   "start": 23.868,
   "end": 25.822,
   "id": "c11"
  },
  {
   "text": "到了 10 月",
   "start": 26.07,
   "end": 26.937,
   "id": "c12"
  },
  {
   "text": "攻击者从工程师的电脑出发",
   "start": 27.012,
   "end": 29.397,
   "id": "c13"
  },
  {
   "text": "控制了更多同事的电脑",
   "start": 29.67,
   "end": 31.494,
   "id": "c14"
  },
  {
   "text": "最后 他们找到了部署令牌",
   "start": 31.823,
   "end": 34.263,
   "id": "c15"
  },
  {
   "text": "这次事件里",
   "start": 34.608,
   "end": 35.68,
   "id": "c16"
  },
  {
   "text": "受影响的资产约 63.4 亿美元",
   "start": 35.7,
   "end": 38.676,
   "id": "c17"
  },
  {
   "text": "先猜一道题",
   "start": 38.97,
   "end": 39.941,
   "id": "c18"
  },
  {
   "text": "没有密码",
   "start": 40.322,
   "end": 41.691,
   "id": "c19"
  },
  {
   "text": "没有链接",
   "start": 41.833,
   "end": 43.078,
   "id": "c20"
  },
  {
   "text": "这份作业",
   "start": 43.331,
   "end": 44.306,
   "id": "c21"
  },
  {
   "text": "是靠什么进入他电脑的",
   "start": 44.472,
   "end": 46.414,
   "id": "c22"
  },
  {
   "text": "先记住这个问题",
   "start": 46.97,
   "end": 48.131,
   "id": "c23"
  }
 ]
