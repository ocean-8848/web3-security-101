 "captions": [
  {
   "text": "先给准确的说法",
   "start": 1.55,
   "end": 2.785,
   "id": "c0"
  },
  {
   "text": "社会工程",
   "start": 3.05,
   "end": 4.275,
   "id": "c1"
  },
  {
   "text": "就是靠欺骗或利用信任",
   "start": 4.605,
   "end": 5.74,
   "id": "c2"
  },
  {
   "text": "让人自己动手",
   "start": 5.76,
   "end": 8.183,
   "id": "c3"
  },
  {
   "text": "做攻击者需要的事",
   "start": 8.237,
   "end": 9.613,
   "id": "c4"
  },
  {
   "text": "内部人风险",
   "start": 9.924,
   "end": 10.93,
   "id": "c5"
  },
  {
   "text": "是有合法权限的人",
   "start": 11.132,
   "end": 13.016,
   "id": "c6"
  },
  {
   "text": "有意或无意地造成损失",
   "start": 13.066,
   "end": 15.364,
   "id": "c7"
  },
  {
   "text": "最贵的漏洞",
   "start": 15.65,
   "end": 16.79,
   "id": "c8"
  },
  {
   "text": "常常不在合约里",
   "start": 16.81,
   "end": 18.369,
   "id": "c9"
  },
  {
   "text": "而在员工的电脑上",
   "start": 18.587,
   "end": 20.209,
   "id": "c10"
  },
  {
   "text": "攻击者不去破解多签合约",
   "start": 20.521,
   "end": 22.538,
   "id": "c11"
  },
  {
   "text": "他让一个签名人",
   "start": 22.706,
   "end": 23.9,
   "id": "c12"
  },
  {
   "text": "在自己电脑上打开一个文件",
   "start": 23.92,
   "end": 26.04,
   "id": "c13"
  },
  {
   "text": "之后 这台电脑上显示的一切",
   "start": 26.33,
   "end": 29.13,
   "id": "c14"
  },
  {
   "text": "都可能是假的",
   "start": 29.281,
   "end": 30.858,
   "id": "c15"
  },
  {
   "text": "打个比方",
   "start": 31.203,
   "end": 31.893,
   "id": "c16"
  },
  {
   "text": "金库有三道门",
   "start": 32.139,
   "end": 33.686,
   "id": "c17"
  },
  {
   "text": "三个人各管一把钥匙",
   "start": 33.749,
   "end": 35.552,
   "id": "c18"
  },
  {
   "text": "窃贼不撬门",
   "start": 35.81,
   "end": 37.205,
   "id": "c19"
  },
  {
   "text": "他给三个掌钥人",
   "start": 37.467,
   "end": 38.864,
   "id": "c20"
  },
  {
   "text": "各寄了一封老同事的来信",
   "start": 38.91,
   "end": 41.041,
   "id": "c21"
  },
  {
   "text": "信纸上涂了药",
   "start": 41.31,
   "end": 42.649,
   "id": "c22"
  },
  {
   "text": "读过信的人",
   "start": 42.935,
   "end": 43.887,
   "id": "c23"
  },
  {
   "text": "第二天会记错自己开的是哪道门",
   "start": 44.062,
   "end": 47.173,
   "id": "c24"
  },
  {
   "text": "比喻在这里不成立",
   "start": 47.547,
   "end": 49.074,
   "id": "c25"
  },
  {
   "text": "真实的攻击者",
   "start": 49.234,
   "end": 50.383,
   "id": "c26"
  },
  {
   "text": "不需要同时骗三个人",
   "start": 50.479,
   "end": 52.356,
   "id": "c27"
  },
  {
   "text": "签名人的电脑都运行同一个前端",
   "start": 52.55,
   "end": 55.48,
   "id": "c28"
  },
  {
   "text": "攻破其中几台",
   "start": 55.962,
   "end": 57.277,
   "id": "c29"
  },
  {
   "text": "再配合篡改前端",
   "start": 57.399,
   "end": 59.133,
   "id": "c30"
  },
  {
   "text": "就可能凑够门槛",
   "start": 59.229,
   "end": 60.81,
   "id": "c31"
  },
  {
   "text": "攻击者能控制的",
   "start": 61.09,
   "end": 62.544,
   "id": "c32"
  },
  {
   "text": "通常是这五样东西",
   "start": 62.651,
   "end": 64.135,
   "id": "c33"
  },
  {
   "text": "一个假身份",
   "start": 64.443,
   "end": 65.46,
   "id": "c34"
  },
  {
   "text": "冒充招聘者 前同事",
   "start": 65.528,
   "end": 67.726,
   "id": "c35"
  },
  {
   "text": "合作方或者记者",
   "start": 67.875,
   "end": 69.415,
   "id": "c36"
  },
  {
   "text": "一个任务",
   "start": 69.69,
   "end": 70.501,
   "id": "c37"
  },
  {
   "text": "比如测试题",
   "start": 70.574,
   "end": 71.984,
   "id": "c38"
  },
  {
   "text": "代码作业",
   "start": 72.18,
   "end": 73.007,
   "id": "c39"
  },
  {
   "text": "一份复盘 PDF",
   "start": 73.206,
   "end": 74.689,
   "id": "c40"
  },
  {
   "text": "一个会议",
   "start": 74.95,
   "end": 75.858,
   "id": "c41"
  },
  {
   "text": "比如假会议软件",
   "start": 76.023,
   "end": 77.724,
   "id": "c42"
  },
  {
   "text": "或者远程控制请求",
   "start": 77.799,
   "end": 79.684,
   "id": "c43"
  },
  {
   "text": "一笔钱 用来收买客服或外包人员",
   "start": 79.97,
   "end": 82.931,
   "id": "c44"
  },
  {
   "text": "还有一个被雇用的身份",
   "start": 83.23,
   "end": 85.104,
   "id": "c45"
  },
  {
   "text": "冒名应聘远程岗位",
   "start": 85.299,
   "end": 87.09,
   "id": "c46"
  },
  {
   "text": "公开通报显示",
   "start": 87.463,
   "end": 88.523,
   "id": "c47"
  },
  {
   "text": "朝鲜相关组织在这类攻击中最活跃",
   "start": 88.705,
   "end": 91.76,
   "id": "c48"
  },
  {
   "text": "但手法本身被各类犯罪团伙复用",
   "start": 92.083,
   "end": 95.062,
   "id": "c49"
  },
  {
   "text": "防御不该只盯着一个组织",
   "start": 95.279,
   "end": 97.608,
   "id": "c50"
  }
 ]
}