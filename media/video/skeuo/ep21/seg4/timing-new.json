 "captions": [
  {
   "text": "第二种手法",
   "start": 1.648,
   "end": 2.746,
   "id": "c0"
  },
  {
   "text": "是一个会议",
   "start": 2.898,
   "end": 3.877,
   "id": "c1"
  },
  {
   "text": "攻击者冒充媒体或投资机构",
   "start": 4.868,
   "end": 7.169,
   "id": "c2"
  },
  {
   "text": "邀请你参加访谈或路演",
   "start": 7.38,
   "end": 9.514,
   "id": "c3"
  },
  {
   "text": "然后要你下载一个专用会议软件",
   "start": 10.488,
   "end": 13.027,
   "id": "c4"
  },
  {
   "text": "或者在会议里申请远程控制",
   "start": 13.214,
   "end": 15.431,
   "id": "c5"
  },
  {
   "text": "2025 年 4 月",
   "start": 16.42,
   "end": 17.661,
   "id": "c6"
  },
  {
   "text": "Trail of Bits 公开了一种做法",
   "start": 17.705,
   "end": 19.875,
   "id": "c7"
  },
  {
   "text": "攻击者在 Zoom 通话里",
   "start": 20.864,
   "end": 22.57,
   "id": "c8"
  },
  {
   "text": "把自己的显示名改成 Zoom",
   "start": 22.59,
   "end": 24.665,
   "id": "c9"
  },
  {
   "text": "弹窗写着 Zoom 请求控制你的屏幕",
   "start": 25.644,
   "end": 28.433,
   "id": "c10"
  },
  {
   "text": "看起来像系统提示",
   "start": 28.453,
   "end": 29.909,
   "id": "c11"
  },
  {
   "text": "但这里的 Zoom",
   "start": 30.904,
   "end": 32.002,
   "id": "c12"
  },
  {
   "text": "只是一个参会者的名字",
   "start": 32.07,
   "end": 33.562,
   "id": "c13"
  },
  {
   "text": "点了同意",
   "start": 34.556,
   "end": 35.428,
   "id": "c14"
  },
  {
   "text": "对方就能控制电脑",
   "start": 35.603,
   "end": 37.011,
   "id": "c15"
  },
  {
   "text": "打开钱包或密码管理器",
   "start": 37.044,
   "end": 39.059,
   "id": "c16"
  },
  {
   "text": "同年 2 月",
   "start": 40.056,
   "end": 40.987,
   "id": "c17"
  },
  {
   "text": "还有人发布假的 Web3 职位",
   "start": 41.008,
   "end": 43.107,
   "id": "c18"
  },
  {
   "text": "引导求职者安装 GrassCall 会议软件",
   "start": 44.092,
   "end": 46.928,
   "id": "c19"
  },
  {
   "text": "里面是窃密木马",
   "start": 46.984,
   "end": 48.357,
   "id": "c20"
  },
  {
   "text": "第三种手法",
   "start": 49.352,
   "end": 50.522,
   "id": "c21"
  },
  {
   "text": "是把人直接送进公司",
   "start": 50.614,
   "end": 52.391,
   "id": "c22"
  },
  {
   "text": "攻击者用盗用或伪造的身份",
   "start": 53.388,
   "end": 55.593,
   "id": "c23"
  },
  {
   "text": "应聘远程开发岗位",
   "start": 55.792,
   "end": 57.558,
   "id": "c24"
  },
  {
   "text": "美国检方在 2025 年 6 月",
   "start": 58.552,
   "end": 60.745,
   "id": "c25"
  },
  {
   "text": "起诉了 4 名朝鲜人",
   "start": 60.778,
   "end": 62.484,
   "id": "c26"
  },
  {
   "text": "他们冒名受雇于区块链公司",
   "start": 63.476,
   "end": 65.836,
   "id": "c27"
  },
  {
   "text": "其中一人修改了雇主两个智能合约的源码",
   "start": 66.023,
   "end": 68.991,
   "id": "c28"
  },
  {
   "text": "把约 74 万美元转到自己的地址",
   "start": 69.984,
   "end": 72.785,
   "id": "c29"
  },
  {
   "text": "全案约 91.5 万美元",
   "start": 72.924,
   "end": 74.927,
   "id": "c30"
  },
  {
   "text": "最后一种",
   "start": 75.916,
   "end": 76.812,
   "id": "c31"
  },
  {
   "text": "是一笔钱",
   "start": 76.963,
   "end": 77.895,
   "id": "c32"
  },
  {
   "text": "2025 年 5 月",
   "start": 78.872,
   "end": 80.089,
   "id": "c33"
  },
  {
   "text": "攻击者用现金",
   "start": 80.157,
   "end": 81.352,
   "id": "c34"
  },
  {
   "text": "收买了 Coinbase 的海外外包客服",
   "start": 81.372,
   "end": 84.03,
   "id": "c35"
  },
  {
   "text": "导出约 7 万名用户的数据",
   "start": 84.996,
   "end": 87.059,
   "id": "c36"
  },
  {
   "text": "再冒充 Coinbase 行骗",
   "start": 87.079,
   "end": 89.118,
   "id": "c37"
  },
  {
   "text": "Coinbase 估算",
   "start": 90.112,
   "end": 91.27,
   "id": "c38"
  },
  {
   "text": "成本约 1.8 亿到 4 亿美元",
   "start": 91.314,
   "end": 93.555,
   "id": "c39"
  },
  {
   "text": "同年 7 月",
   "start": 94.556,
   "end": 95.499,
   "id": "c40"
  },
  {
   "text": "CoinDCX 的一名员工被兼职工作吸引",
   "start": 95.615,
   "end": 98.69,
   "id": "c41"
  },
  {
   "text": "在公司电脑上装了恶意软件",
   "start": 98.722,
   "end": 100.964,
   "id": "c42"
  },
  {
   "text": "运营钱包被盗走约 4400 万美元",
   "start": 101.952,
   "end": 104.848,
   "id": "c43"
  },
  {
   "text": "当地警方称",
   "start": 105.047,
   "end": 106.145,
   "id": "c44"
  },
  {
   "text": "这名员工并不知情",
   "start": 106.321,
   "end": 107.812,
   "id": "c45"
  },
  {
   "text": "只是被利用了",
   "start": 107.844,
   "end": 108.8,
   "id": "c46"
  }
 ]
}