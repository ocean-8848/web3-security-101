   "start": 25.596,
   "dur": 5.04,
   "speechStart": 25.694,
   "speechEnd": 29.789
  },
  {
   "id": "seg4-06",
   "text": "但这里的 Zoom，只是一个参会者的名字。",
   "spoken": "但这里的 Zoom，只是一个参会者的名字。",
