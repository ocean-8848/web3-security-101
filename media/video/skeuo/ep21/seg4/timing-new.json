   "start": 44.044,
   "dur": 5.04,
   "speechStart": 44.142,
   "speechEnd": 48.237
  },
  {
   "id": "seg4-10",
   "text": "第三种手法，是把人直接送进公司。",
   "spoken": "第三种手法，是把人直接送进公司。",
   "src": "/Users/k/Workon/Learning/web3/web3-security-101/media/video/skeuo/ep21/audio/lines/seg4-10.mp3",
   "start": 49.304,
   "dur": 3.816,
   "speechStart": 49.402,
   "speechEnd": 52.271
  },
  {
   "id": "seg4-11",
   "text": "攻击者用盗用或伪造的身份，应聘远程开发岗位。",
   "spoken": "攻击者用盗用或伪造的身份，应聘远程开发岗位。",
   "src": "/Users/k/Workon/Learning/web3/web3-security-101/media/video/skeuo/ep21/audio/lines/seg4-11.mp3",
   "start": 53.34,
   "dur": 4.944,
   "speechStart": 53.438,
   "speechEnd": 57.438
  },
  {
   "id": "seg4-12",
   "text": "美国检方在 2025 年 6 月，起诉了 4 名朝鲜人。",
   "spoken": "美国检方在 2025 年 6 月，起诉了 4 名朝鲜人。",
   "src": "/Users/k/Workon/Learning/web3/web3-security-101/media/video/skeuo/ep21/audio/lines/seg4-12.mp3",
   "start": 58.504,
   "dur": 4.704,
   "speechStart": 58.602,
   "speechEnd": 62.364
  },
  {
   "id": "seg4-13",
   "text": "他们冒名受雇于区块链公司，其中一人修改了雇主两个智能合约的源码。",
   "spoken": "他们冒名受雇于区块链公司，其中一人修改了雇主两个智能合约的源码。",
   "src": "/Users/k/Workon/Learning/web3/web3-security-101/media/video/skeuo/ep21/audio/lines/seg4-13.mp3",
   "start": 63.428,
   "dur": 6.288,
   "speechStart": 63.526,
   "speechEnd": 68.871
  },
  {
   "id": "seg4-14",
   "text": "把约 74 万美元转到自己的地址，全案约 91.5 万美元。",
   "spoken": "把约 74 万美元转到自己的地址，全案约 91.5 万美元。",
   "src": "/Users/k/Workon/Learning/web3/web3-security-101/media/video/skeuo/ep21/audio/lines/seg4-14.mp3",
   "start": 69.936,
   "dur": 5.712,
   "speechStart": 70.034,
   "speechEnd": 74.807
  },
  {
   "id": "seg4-15",
   "text": "最后一种，是一笔钱。",
   "spoken": "最后一种，是一笔钱。",
   "src": "/Users/k/Workon/Learning/web3/web3-security-101/media/video/skeuo/ep21/audio/lines/seg4-15.mp3",
   "start": 75.868,
   "dur": 2.736,
   "speechStart": 75.966,
   "speechEnd": 77.775
  },
  {
   "id": "seg4-16",
   "text": "2025 年 5 月，攻击者用现金，收买了 Coinbase 的海外外包客服。",
   "spoken": "2025 年 5 月，攻击者用现金，收买了 Coinbase 的海外外包客服。",
   "src": "/Users/k/Workon/Learning/web3/web3-security-101/media/video/skeuo/ep21/audio/lines/seg4-16.mp3",
   "start": 78.824,
   "dur": 5.904,
   "speechStart": 78.922,
   "speechEnd": 83.91
  },
  {
   "id": "seg4-17",
   "text": "导出约 7 万名用户的数据，再冒充 Coinbase 行骗。",
   "spoken": "导出约 7 万名用户的数据，再冒充 Coinbase 行骗。",
