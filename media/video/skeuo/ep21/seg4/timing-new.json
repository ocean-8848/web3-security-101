   "start": 10.44,
   "dur": 5.712,
   "speechStart": 10.538,
   "speechEnd": 15.311
  },
  {
   "id": "seg4-03",
   "text": "2025 年 4 月，Trail of Bits 公开了一种做法。",
   "spoken": "2025 年 4 月，Trail of Bits 公开了一种做法。",
