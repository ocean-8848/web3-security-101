   "text": "员工在工作电脑上",
   "start": 18.148,
   "end": 19.717,
   "id": "c9"
  },
  {
   "text": "运行了外部代码",
   "start": 19.836,
   "end": 21.245,
   "id": "c10"
  },
  {
   "text": "后门回连",
   "start": 21.47,
   "end": 22.669,
   "id": "c11"
  },
  {
   "text": "偷走浏览器的会话 cookie",
   "start": 22.701,
   "end": 26.05,
   "id": "c12"
  },
  {
   "text": "SSH 密钥和钱包",
   "start": 26.303,
   "end": 27.495,
   "id": "c13"
  },
  {
   "text": "注意 偷的是会话 cookie",
   "start": 27.77,
   "end": 30.161,
   "id": "c14"
  },
  {
   "text": "不是密码",
   "start": 30.318,
   "end": 31.134,
   "id": "c15"
  },
  {
   "text": "会话 cookie 是登录之后的凭证 拿到它",
   "start": 31.441,
   "end": 34.758,
   "id": "c16"
  },
  {
   "text": "就能绕过多因素认证",
   "start": 34.933,
   "end": 36.673,
   "id": "c17"
  },
  {
   "text": "就算账号用了硬件密钥",
   "start": 36.93,
   "end": 38.782,
   "id": "c18"
  },
  {
   "text": "通常也挡不住",
   "start": 38.98,
   "end": 40.241,
   "id": "c19"
  },
  {
   "text": "硬件密钥只保护登录这一步",
   "start": 40.398,
   "end": 42.657,
   "id": "c20"
  },
  {
   "text": "2024 年 3 月",
   "start": 43.014,
   "end": 44.233,
   "id": "c21"
  },
  {
   "text": "钱包软件供应商 Ginco 的一名员工",
   "start": 44.524,
   "end": 47.299,
   "id": "c22"
  },
  {
   "text": "就这样运行了一个测试脚本",
   "start": 47.563,
   "end": 49.739,
   "id": "c23"
  },
  {
   "text": "5 月 攻击者用偷来的会话",
   "start": 50.025,
   "end": 52.65,
   "id": "c24"
  },
  {
   "text": "进入 Ginco 的系统",
   "start": 52.825,
   "end": 54.197,
   "id": "c25"
  },
  {
   "text": "篡改了 DMM Bitcoin 的一笔交易",
   "start": 54.464,
   "end": 57.475,
   "id": "c26"
  },
  {
   "text": "被盗的 BTC 约 3.05 亿美元",
   "start": 57.85,
   "end": 61.438,
   "id": "c27"
  },
  {
   "text": "FBI 和日本警察厅等机构",
   "start": 61.746,
   "end": 64.073,
   "id": "c28"
  },
  {
   "text": "联合归因于朝鲜的 TraderTraitor",
   "start": 64.276,
   "end": 67.002,
   "id": "c29"
  },
  {
   "text": "供应商的员工",
   "start": 67.23,
   "end": 68.563,
   "id": "c30"
  },
  {
   "text": "也是你的攻击面",
   "start": 68.724,
   "end": 70.123,
   "id": "c31"
  },
  {
   "text": "这类假面试已经成了规模化的活动",
   "start": 70.427,
   "end": 73.43,
   "id": "c32"
  },
  {
   "text": "多国机构联合告警",
   "start": 73.772,
   "end": 75.488,
   "id": "c33"
  },
  {
   "text": "从 2025 年 12 月到 2026 年 7 月",
   "start": 75.985,
   "end": 79.469,
   "id": "c34"
  },
  {
   "text": "至少 3 万台设备被感染",
   "start": 79.845,
   "end": 81.859,
   "id": "c35"
  },
  {
   "text": "而且不一定要你手动运行",
   "start": 82.223,
   "end": 84.447,
   "id": "c36"
  },
  {
   "text": "打开项目时",
   "start": 84.642,
   "end": 85.508,
   "id": "c37"
  },
  {
   "text": "配置文件就可能自动执行代码",
   "start": 85.61,
   "end": 88.096,
   "id": "c38"
  },
  {
   "text": "文件也能做同样的事",
   "start": 88.35,
   "end": 90.024,
   "id": "c39"
  },
  {
   "text": "2024 年",
   "start": 90.25,
   "end": 91.201,
   "id": "c40"
  },
  {
   "text": "Radiant Capital 的开发者",
   "start": 91.414,
   "end": 93.061,
   "id": "c41"
  },
  {
   "text": "在 Telegram 上收到一个 zip",
   "start": 93.347,
   "end": 95.583,
   "id": "c42"
  },
  {
   "text": "发件人冒充前承包商",
   "start": 96.122,
   "end": 97.998,
   "id": "c43"
  },
  {
   "text": "里面是伪装成复盘 PDF 的 macOS 后门",
   "start": 98.23,
   "end": 101.876,
   "id": "c44"
  },
  {
   "text": "3 名开发者的设备被感染",
   "start": 102.221,
   "end": 104.103,
   "id": "c45"
  },
  {
   "text": "恶意软件改写了多签前端的显示",
   "start": 104.37,
   "end": 107.189,
   "id": "c46"
  },
  {
   "text": "签名人用了硬件钱包",
   "start": 107.562,
   "end": 109.511,
   "id": "c47"
  },
  {
   "text": "也做了交易模拟",
   "start": 109.736,
   "end": 111.186,
   "id": "c48"
  },
  {
   "text": "但界面上的模拟结果",
   "start": 111.431,
   "end": 113.207,
   "id": "c49"
  },
  {
   "text": "也是假的",
   "start": 113.255,
   "end": 114.154,
   "id": "c50"
  },
  {
   "text": "多签所有权被转走",
   "start": 114.509,
   "end": 116.215,
   "id": "c51"
  },
  {
   "text": "损失约 5000 万美元",
   "start": 116.29,
   "end": 118.56,
   "id": "c52"
  }
 ]
}