 "captions": [
  {
   "text": "最后 按角色各做一件事",
   "start": 1.648,
   "end": 4.02,
   "id": "c0"
  },
  {
   "text": "先对照八个关口问一句",
   "start": 4.988,
   "end": 6.789,
   "id": "c1"
  },
  {
   "text": "哪一个是你们跳过的",
   "start": 7.059,
   "end": 8.372,
   "id": "c2"
  },
  {
   "text": "开发者 今天就给你的核心合约",
   "start": 9.64,
   "end": 12.191,
   "id": "c3"
  },
  {
   "text": "写下一条不变量",
   "start": 12.306,
   "end": 13.536,
   "id": "c4"
  },
  {
   "text": "让测试去检查它",
   "start": 13.652,
   "end": 15.202,
   "id": "c5"
  },
  {
   "text": "做审计和评审的人",
   "start": 16.172,
   "end": 17.901,
   "id": "c6"
  },
  {
   "text": "核对审计版本的提交哈希",
   "start": 17.993,
   "end": 19.877,
   "id": "c7"
  },
  {
   "text": "和线上字节码是不是同一份",
   "start": 20.041,
   "end": 22.353,
   "id": "c8"
  },
  {
   "text": "项目负责人",
   "start": 23.328,
   "end": 24.415,
   "id": "c9"
  },
  {
   "text": "回答一个问题",
   "start": 24.435,
   "end": 25.45,
   "id": "c10"
  },
  {
   "text": "如果今晚出事",
   "start": 25.709,
   "end": 26.879,
   "id": "c11"
  },
  {
   "text": "谁有权按下暂停",
   "start": 26.947,
   "end": 28.45,
   "id": "c12"
  },
  {
   "text": "他自己知道吗",
   "start": 28.732,
   "end": 29.748,
   "id": "c13"
  },
  {
   "text": "回到开头的问题",
   "start": 31.004,
   "end": 32.388,
   "id": "c14"
  },
  {
   "text": "项目方能用我们通过了审计",
   "start": 33.384,
   "end": 35.446,
   "id": "c15"
  },
  {
   "text": "证明线上代码安全吗",
   "start": 35.586,
   "end": 37.089,
   "id": "c16"
  },
  {
   "text": "不能",
   "start": 38.348,
   "end": 39.137,
   "id": "c17"
  },
  {
   "text": "审计结论",
   "start": 40.44,
   "end": 41.586,
   "id": "c18"
  },
  {
   "text": "只对审计时的那个提交哈希成立",
   "start": 41.666,
   "end": 44.491,
   "id": "c19"
  },
  {
   "text": "还要证明线上字节码等于审计版本",
   "start": 45.484,
   "end": 48.761,
   "id": "c20"
  },
  {
   "text": "并且上线后的每一次改动",
   "start": 48.948,
   "end": 50.642,
   "id": "c21"
  },
  {
   "text": "都经过审查",
   "start": 50.662,
   "end": 51.713,
   "id": "c22"
  },
  {
   "text": "审计是流水线上的一个关口",
   "start": 52.712,
   "end": 54.81,
   "id": "c23"
  },
  {
   "text": "不是一张免检证书",
   "start": 55.009,
   "end": 56.489,
   "id": "c24"
  },
  {
   "text": "下一集讲事故案例库",
   "start": 57.468,
   "end": 59.376,
   "id": "c25"
  }
 ]
}