 "captions": [
  {
   "text": "2021 年 5 月",
   "start": 1.55,
   "end": 2.948,
   "id": "c0"
  },
  {
   "text": "PancakeBunny 被攻击",
   "start": 3.259,
   "end": 4.769,
   "id": "c1"
  },
  {
   "text": "损失约 4500 万美元",
   "start": 5.044,
   "end": 7.216,
   "id": "c2"
  },
  {
   "text": "这个项目",
   "start": 7.45,
   "end": 8.229,
   "id": "c3"
  },
  {
   "text": "做过审计",
   "start": 8.384,
   "end": 9.238,
   "id": "c4"
  },
  {
   "text": "可审计方事后说明",
   "start": 9.51,
   "end": 11.384,
   "id": "c5"
  },
  {
   "text": "被利用的那份代码",
   "start": 11.622,
   "end": 13.064,
   "id": "c6"
  },
  {
   "text": "是审计之后才上线的版本",
   "start": 13.225,
   "end": 15.355,
   "id": "c7"
  },
  {
   "text": "审计看的是一份代码",
   "start": 15.65,
   "end": 17.599,
   "id": "c8"
  },
  {
   "text": "链上跑的是另一份",
   "start": 17.807,
   "end": 19.629,
   "id": "c9"
  },
  {
   "text": "攻击 就发生在那个没被审过的版本上",
   "start": 19.965,
   "end": 23.57,
   "id": "c10"
  },
  {
   "text": "审计本身没有失败",
   "start": 23.85,
   "end": 25.558,
   "id": "c11"
  },
  {
   "text": "出问题的",
   "start": 25.865,
   "end": 26.764,
   "id": "c12"
  },
  {
   "text": "是审计和上线之间的那一段",
   "start": 26.839,
   "end": 29.264,
   "id": "c13"
  },
  {
   "text": "项目上线时",
   "start": 29.51,
   "end": 30.684,
   "id": "c14"
  },
  {
   "text": "常常会说一句",
   "start": 30.858,
   "end": 31.973,
   "id": "c15"
  },
  {
   "text": "我们通过了审计",
   "start": 32.363,
   "end": 33.754,
   "id": "c16"
  },
  {
   "text": "先猜一道题",
   "start": 34.05,
   "end": 35.021,
   "id": "c17"
  },
  {
   "text": "项目方能不能用",
   "start": 35.401,
   "end": 36.635,
   "id": "c18"
  },
  {
   "text": "我们通过了审计",
   "start": 36.655,
   "end": 37.827,
   "id": "c19"
  },
  {
   "text": "来证明线上的代码是安全的",
   "start": 37.939,
   "end": 40.235,
   "id": "c20"
  },
  {
   "text": "想一想 审计报告证明的",
   "start": 40.77,
   "end": 43.577,
   "id": "c21"
  },
  {
   "text": "到底是哪一份代码",
   "start": 43.712,
   "end": 45.359,
   "id": "c22"
  },
  {
   "text": "还有 审计之后改过的代码 谁来看",
   "start": 45.63,
   "end": 49.09,
   "id": "c23"
  },
  {
   "text": "带着这两个问题",
   "start": 49.65,
   "end": 51.007,
   "id": "c24"
  },
  {
   "text": "我们看看",
   "start": 51.251,
   "end": 51.951,
   "id": "c25"
  },
  {
   "text": "安全怎样写进开发的每一步",
   "start": 52.215,
   "end": 54.995,
   "id": "c26"
  }
 ]
}