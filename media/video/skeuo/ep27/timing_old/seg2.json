 "captions": [
  {
   "text": "先给一句准确的说法",
   "start": 1.55,
   "end": 3.268,
   "id": "c0"
  },
  {
   "text": "审计不是安全的起点",
   "start": 3.53,
   "end": 5.751,
   "id": "c1"
  },
  {
   "text": "也不是终点",
   "start": 5.802,
   "end": 6.84,
   "id": "c2"
  },
  {
   "text": "它是流水线上的一个关口",
   "start": 7.11,
   "end": 9.157,
   "id": "c3"
  },
  {
   "text": "它之前要有设计和测试",
   "start": 9.41,
   "end": 11.633,
   "id": "c4"
  },
  {
   "text": "之后要有监控和应急",
   "start": 11.995,
   "end": 14.011,
   "id": "c5"
  },
  {
   "text": "打个比方",
   "start": 14.924,
   "end": 15.616,
   "id": "c6"
  },
  {
   "text": "合约开发像造一架飞机",
   "start": 15.693,
   "end": 17.885,
   "id": "c7"
  },
  {
   "text": "设计时画图纸",
   "start": 18.17,
   "end": 19.717,
   "id": "c8"
  },
  {
   "text": "写下任何情况下机翼都不能断",
   "start": 19.755,
   "end": 22.809,
   "id": "c9"
  },
  {
   "text": "每个零件出厂前都要测",
   "start": 23.204,
   "end": 25.027,
   "id": "c10"
  },
  {
   "text": "还要放进风洞",
   "start": 25.547,
   "end": 26.454,
   "id": "c11"
  },
  {
   "text": "用各种极端风向去吹",
   "start": 26.474,
   "end": 28.484,
   "id": "c12"
  },
  {
   "text": "外部机构做适航认证",
   "start": 28.861,
   "end": 30.625,
   "id": "c13"
  },
  {
   "text": "它不查每一颗螺丝",
   "start": 30.861,
   "end": 32.383,
   "id": "c14"
  },
  {
   "text": "只抽查关键系统",
   "start": 32.641,
   "end": 34.115,
   "id": "c15"
  },
  {
   "text": "飞上天以后",
   "start": 34.35,
   "end": 35.381,
   "id": "c16"
  },
  {
   "text": "有黑匣子和地面雷达",
   "start": 35.601,
   "end": 37.476,
   "id": "c17"
  },
  {
   "text": "出了事有应急程序",
   "start": 37.668,
   "end": 39.335,
   "id": "c18"
  },
  {
   "text": "这个比方有一处不成立",
   "start": 39.703,
   "end": 41.374,
   "id": "c19"
  },
  {
   "text": "飞机出厂后",
   "start": 41.67,
   "end": 42.804,
   "id": "c20"
  },
  {
   "text": "还能召回维修",
   "start": 42.916,
   "end": 44.077,
   "id": "c21"
  },
  {
   "text": "不可升级的合约",
   "start": 44.473,
   "end": 46.039,
   "id": "c22"
  },
  {
   "text": "部署之后",
   "start": 46.281,
   "end": 47.016,
   "id": "c23"
  },
  {
   "text": "就再也不能修改",
   "start": 47.073,
   "end": 48.355,
   "id": "c24"
  },
  {
   "text": "所以前面的关口",
   "start": 48.59,
   "end": 50.08,
   "id": "c25"
  },
  {
   "text": "必须更严",
   "start": 50.16,
   "end": 51.124,
   "id": "c26"
  },
  {
   "text": "把这条流水线展开",
   "start": 51.465,
   "end": 52.939,
   "id": "c27"
  },
  {
   "text": "一共八个关口",
   "start": 53.055,
   "end": 54.303,
   "id": "c28"
  },
  {
   "text": "规格与威胁模型",
   "start": 54.643,
   "end": 56.831,
   "id": "c29"
  },
  {
   "text": "安全编码规范",
   "start": 56.987,
   "end": 58.288,
   "id": "c30"
  },
  {
   "text": "静态分析",
   "start": 58.58,
   "end": 59.514,
   "id": "c31"
  },
  {
   "text": "单元 模糊和不变量测试",
   "start": 59.822,
   "end": 62.797,
   "id": "c32"
  },
  {
   "text": "关键模块的形式化验证",
   "start": 63.011,
   "end": 64.973,
   "id": "c33"
  },
  {
   "text": "外部审计或竞赛",
   "start": 65.23,
   "end": 67.032,
   "id": "c34"
  },
  {
   "text": "安全部署与权限移交",
   "start": 67.245,
   "end": 69.564,
   "id": "c35"
  },
  {
   "text": "最后是监控",
   "start": 69.85,
   "end": 71.092,
   "id": "c36"
  },
  {
   "text": "漏洞赏金",
   "start": 71.253,
   "end": 72.151,
   "id": "c37"
  },
  {
   "text": "应急响应和保险",
   "start": 72.282,
   "end": 73.795,
   "id": "c38"
  },
  {
   "text": "越靠左的关口",
   "start": 74.163,
   "end": 75.464,
   "id": "c39"
  },
  {
   "text": "修复越便宜",
   "start": 75.484,
   "end": 76.583,
   "id": "c40"
  },
  {
   "text": "规格阶段发现的问题",
   "start": 76.827,
   "end": 78.442,
   "id": "c41"
  },
  {
   "text": "只要改文档",
   "start": 78.462,
   "end": 79.394,
   "id": "c42"
  },
  {
   "text": "静态分析",
   "start": 79.741,
   "end": 80.616,
   "id": "c43"
  },
  {
   "text": "测试和形式化验证是自动的",
   "start": 80.729,
   "end": 83.437,
   "id": "c44"
  },
  {
   "text": "每次提交代码都该跑一遍",
   "start": 83.638,
   "end": 85.745,
   "id": "c45"
  },
  {
   "text": "静态分析误报多",
   "start": 86.125,
   "end": 87.741,
   "id": "c46"
  },
  {
   "text": "不求零告警",
   "start": 87.83,
   "end": 89.089,
   "id": "c47"
  },
  {
   "text": "要求每个告警都有结论",
   "start": 89.585,
   "end": 91.555,
   "id": "c48"
  },
  {
   "text": "审计发现的问题",
   "start": 91.77,
   "end": 93.245,
   "id": "c49"
  },
  {
   "text": "要反过来补成测试",
   "start": 93.376,
   "end": 95.19,
   "id": "c50"
  },
  {
   "text": "防止以后再犯",
   "start": 95.424,
   "end": 96.486,
   "id": "c51"
  },
  {
   "text": "但所有关口都有一个前提",
   "start": 96.802,
   "end": 99.001,
   "id": "c52"
  },
  {
   "text": "你想到了要检查什么",
   "start": 99.126,
   "end": 100.946,
   "id": "c53"
  },
  {
   "text": "经济攻击和跨协议的组合风险",
   "start": 101.266,
   "end": 104.0,
   "id": "c54"
  },
  {
   "text": "常常要专门的经济审计",
   "start": 104.196,
   "end": 106.265,
   "id": "c55"
  }
 ]
}