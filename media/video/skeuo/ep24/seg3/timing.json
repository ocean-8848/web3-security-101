 "captions": [
  {
   "text": "交易所的数据",
   "start": 1.55,
   "end": 2.691,
   "id": "c0"
  },
  {
   "text": "不只留在交易所里",
   "start": 2.779,
   "end": 4.435,
   "id": "c1"
  },
  {
   "text": "KYC 服务商",
   "start": 4.743,
   "end": 5.952,
   "id": "c2"
  },
  {
   "text": "工单系统",
   "start": 6.147,
   "end": 7.154,
   "id": "c3"
  },
  {
   "text": "邮件营销 物流",
   "start": 7.239,
   "end": 8.988,
   "id": "c4"
  },
  {
   "text": "破产服务",
   "start": 9.2,
   "end": 10.05,
   "id": "c5"
  },
  {
   "text": "每一家都是一个泄露点",
   "start": 10.342,
   "end": 12.5,
   "id": "c6"
  },
  {
   "text": "2020 年 6 月",
   "start": 12.71,
   "end": 14.117,
   "id": "c7"
  },
  {
   "text": "攻击者用一把第三方的 API 密钥",
   "start": 14.395,
   "end": 17.324,
   "id": "c8"
  },
  {
   "text": "进了 Ledger 的电商和营销数据库",
   "start": 17.592,
   "end": 20.518,
   "id": "c9"
  },
  {
   "text": "约 100 万个邮箱泄露",
   "start": 20.77,
   "end": 22.906,
   "id": "c10"
  },
  {
   "text": "约 27.2 万条记录带着姓名",
   "start": 22.926,
   "end": 25.333,
   "id": "c11"
  },
  {
   "text": "住址和电话",
   "start": 25.399,
   "end": 26.513,
   "id": "c12"
  },
  {
   "text": "Ledger 后来修正为",
   "start": 26.75,
   "end": 28.381,
   "id": "c13"
  },
  {
   "text": "约 29.2 万名客户",
   "start": 28.531,
   "end": 30.549,
   "id": "c14"
  },
  {
   "text": "同年 12 月",
   "start": 30.81,
   "end": 31.803,
   "id": "c15"
  },
  {
   "text": "完整的数据库",
   "start": 32.161,
   "end": 33.234,
   "id": "c16"
  },
  {
   "text": "被公开在黑客论坛上",
   "start": 33.27,
   "end": 35.07,
   "id": "c17"
  },
  {
   "text": "之后是大量钓鱼邮件和短信",
   "start": 35.35,
   "end": 38.084,
   "id": "c18"
  },
  {
   "text": "还有针对客户的威胁电话",
   "start": 38.567,
   "end": 40.697,
   "id": "c19"
  },
  {
   "text": "硬件钱包本身没有被攻破",
   "start": 40.93,
   "end": 43.206,
   "id": "c20"
  },
  {
   "text": "可谁买了硬件钱包",
   "start": 43.47,
   "end": 45.251,
   "id": "c21"
  },
  {
   "text": "寄到了哪里",
   "start": 45.344,
   "end": 46.381,
   "id": "c22"
  },
  {
   "text": "本身就是高价值的数据",
   "start": 46.558,
   "end": 48.384,
   "id": "c23"
  },
  {
   "text": "2023 年 8 月",
   "start": 48.755,
   "end": 50.088,
   "id": "c24"
  },
  {
   "text": "Kroll 一名员工的手机号",
   "start": 50.14,
   "end": 52.167,
   "id": "c25"
  },
  {
   "text": "被 SIM 卡劫持",
   "start": 52.187,
   "end": 53.569,
   "id": "c26"
  },
  {
   "text": "攻击者借此看到了 FTX",
   "start": 53.922,
   "end": 55.863,
   "id": "c27"
  },
  {
   "text": "BlockFi",
   "start": 55.889,
   "end": 56.829,
   "id": "c28"
  },
  {
   "text": "Genesis 三个破产案的债权人文件",
   "start": 56.859,
   "end": 60.51,
   "id": "c29"
  },
  {
   "text": "姓名 地址 邮箱",
   "start": 60.77,
   "end": 62.88,
   "id": "c30"
  },
  {
   "text": "还有账户余额",
   "start": 62.9,
   "end": 64.032,
   "id": "c31"
  },
  {
   "text": "外包商员工的手机号",
   "start": 64.27,
   "end": 65.968,
   "id": "c32"
  },
  {
   "text": "也成了你的攻击面",
   "start": 65.988,
   "end": 67.218,
   "id": "c33"
  },
  {
   "text": "2024 年 1 月",
   "start": 67.637,
   "end": 68.8,
   "id": "c34"
  },
  {
   "text": "Trezor 的第三方工单平台",
   "start": 69.065,
   "end": 71.13,
   "id": "c35"
  },
  {
   "text": "遭到未授权访问",
   "start": 71.187,
   "end": 72.764,
   "id": "c36"
  },
  {
   "text": "最多约 6.6 万名联系过客服的用户",
   "start": 73.03,
   "end": 76.071,
   "id": "c37"
  },
  {
   "text": "邮箱和姓名泄露",
   "start": 76.229,
   "end": 77.648,
   "id": "c38"
  },
  {
   "text": "冒充者随后联系了约 40 名用户",
   "start": 77.89,
   "end": 80.853,
   "id": "c39"
  },
  {
   "text": "索要助记词",
   "start": 81.212,
   "end": 82.471,
   "id": "c40"
  },
  {
   "text": "2022 年 12 月",
   "start": 82.67,
   "end": 84.354,
   "id": "c41"
  },
  {
   "text": "Gemini 的一家供应商被入侵",
   "start": 84.671,
   "end": 86.911,
   "id": "c42"
  },
  {
   "text": "约 570 万行客户邮箱",
   "start": 87.13,
   "end": 89.534,
   "id": "c43"
  },
  {
   "text": "和部分遮蔽的电话号码泄露",
   "start": 89.634,
   "end": 91.997,
   "id": "c44"
  },
  {
   "text": "Gemini 称",
   "start": 92.326,
   "end": 93.128,
   "id": "c45"
  },
  {
   "text": "账户和系统没有受到影响",
   "start": 93.302,
   "end": 95.589,
   "id": "c46"
  },
  {
   "text": "你的数据有多安全",
   "start": 95.905,
   "end": 97.404,
   "id": "c47"
  },
  {
   "text": "取决于数据流向的",
   "start": 97.459,
   "end": 99.018,
   "id": "c48"
  },
  {
   "text": "最弱的那一家第三方",
   "start": 99.038,
   "end": 100.662,
   "id": "c49"
  }
 ]
