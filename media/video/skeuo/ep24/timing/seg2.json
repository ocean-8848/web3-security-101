 "captions": [
  {
   "text": "先给准确的说法",
   "start": 1.648,
   "end": 3.103,
   "id": "c0"
  },
  {
   "text": "数据泄露",
   "start": 4.1,
   "end": 5.187,
   "id": "c1"
  },
  {
   "text": "是下一次诈骗的名单",
   "start": 5.207,
   "end": 6.686,
   "id": "c2"
  },
  {
   "text": "攻击者知道了谁持有多少资产",
   "start": 7.68,
   "end": 10.278,
   "id": "c3"
  },
  {
   "text": "住在哪里",
   "start": 10.465,
   "end": 11.314,
   "id": "c4"
  },
  {
   "text": "用哪家交易所",
   "start": 11.358,
   "end": 12.469,
   "id": "c5"
  },
  {
   "text": "他就能冒充客服精准下手",
   "start": 13.468,
   "end": 15.542,
   "id": "c6"
  },
  {
   "text": "甚至找上门",
   "start": 15.658,
   "end": 16.769,
   "id": "c7"
  },
  {
   "text": "打个比方",
   "start": 17.744,
   "end": 18.699,
   "id": "c8"
  },
  {
   "text": "一份泄露的客户名单",
   "start": 18.851,
   "end": 20.568,
   "id": "c9"
  },
  {
   "text": "就是一本肥羊通讯录",
   "start": 20.613,
   "end": 22.116,
   "id": "c10"
  },
  {
   "text": "上面有姓名 电话",
   "start": 23.1,
   "end": 24.936,
   "id": "c11"
  },
  {
   "text": "存款金额",
   "start": 25.004,
   "end": 26.067,
   "id": "c12"
  },
  {
   "text": "还注明他上周刚联系过客服",
   "start": 26.112,
   "end": 28.401,
   "id": "c13"
  },
  {
   "text": "比喻在这里不成立",
   "start": 29.368,
   "end": 30.716,
   "id": "c14"
  },
  {
   "text": "银行流水是私密的",
   "start": 30.868,
   "end": 32.43,
   "id": "c15"
  },
  {
   "text": "链上交易是公开的",
   "start": 32.463,
   "end": 33.859,
   "id": "c16"
  },
  {
   "text": "名单里只要有一个地址",
   "start": 34.844,
   "end": 36.585,
   "id": "c17"
  },
  {
   "text": "攻击者就能查到这个人全部的链上历史",
   "start": 36.748,
   "end": 39.966,
   "id": "c18"
  },
  {
   "text": "和当前的余额",
   "start": 39.986,
   "end": 41.156,
   "id": "c19"
  },
  {
   "text": "一次泄露",
   "start": 42.144,
   "end": 43.04,
   "id": "c20"
  },
  {
   "text": "会同时引出三类攻击",
