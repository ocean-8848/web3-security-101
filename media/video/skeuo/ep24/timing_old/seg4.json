   "text": "就是把匿名的链上地址",
   "start": 6.769,
   "end": 8.847,
   "id": "c4"
  },
  {
   "text": "关联到真实的身份",
   "start": 8.962,
   "end": 10.503,
   "id": "c5"
  },
  {
   "text": "链上分析先把地址聚成一个个实体",
   "start": 10.884,
   "end": 14.249,
   "id": "c6"
  },
  {
   "text": "再把实体对上真人",
   "start": 14.571,
   "end": 16.503,
   "id": "c7"
  },
  {
   "text": "第一种方法",
   "start": 16.863,
   "end": 17.754,
   "id": "c8"
  },
  {
   "text": "共同输入",
   "start": 17.878,
   "end": 18.783,
   "id": "c9"
  },
  {
   "text": "一笔比特币交易的多个输入",
   "start": 18.99,
   "end": 21.276,
   "id": "c10"
  },
  {
   "text": "大概率属于同一个所有者",
   "start": 21.523,
   "end": 23.43,
   "id": "c11"
  },
  {
   "text": "第二种 找零地址",
   "start": 23.69,
   "end": 25.824,
   "id": "c12"
  },
  {
   "text": "认出交易里找零给自己的那个输出",
   "start": 26.023,
   "end": 29.036,
   "id": "c13"
  },
  {
   "text": "第三种 交易所出入金",
   "start": 29.27,
   "end": 31.66,
   "id": "c14"
  },
  {
   "text": "地址跟交易所的充值地址有往来",
   "start": 31.986,
   "end": 35.033,
   "id": "c15"
  },
  {
   "text": "而交易所掌握 KYC",
   "start": 35.445,
   "end": 37.387,
   "id": "c16"
  },
  {
   "text": "第四种 跨链",
   "start": 37.63,
   "end": 39.104,
   "id": "c17"
  },
  {
   "text": "跨混币器的时间和金额模式",
   "start": 39.124,
   "end": 41.663,
   "id": "c18"
  },
  {
   "text": "第五种 链下关联",
   "start": 41.93,
   "end": 43.945,
   "id": "c19"
  },
  {
   "text": "ENS 名称",
   "start": 44.398,
   "end": 45.429,
   "id": "c20"
  },
  {
   "text": "社交媒体上贴出的地址",
   "start": 45.586,
   "end": 47.586,
   "id": "c21"
  },
  {
   "text": "NFT 头像",
   "start": 47.677,
   "end": 48.685,
   "id": "c22"
  },
  {
   "text": "这些都是启发式规则 会误判",
   "start": 49.044,
   "end": 51.752,
   "id": "c23"
  },
  {
   "text": "比如一笔交易",
   "start": 52.149,
   "end": 53.451,
   "id": "c24"
  },
  {
   "text": "有 4 个输入",
   "start": 53.471,
   "end": 54.577,
   "id": "c25"
  },
  {
   "text": "4 个金额相等的输出",
   "start": 54.692,
   "end": 56.592,
   "id": "c26"
  },
  {
   "text": "共同输入规则",
   "start": 56.924,
   "end": 58.136,
   "id": "c27"
  },
  {
   "text": "会把 4 个输入",
   "start": 58.247,
   "end": 59.328,
   "id": "c28"
  },
  {
   "text": "归给同一个人",
   "start": 59.394,
   "end": 60.508,
   "id": "c29"
  },
  {
   "text": "可这是典型的 CoinJoin",
   "start": 60.73,
   "end": 62.872,
   "id": "c30"
  },
  {
   "text": "可能是 4 个人各出一个输入",
   "start": 63.035,
   "end": 65.069,
   "id": "c31"
  },
  {
   "text": "聚到一起",
   "start": 65.35,
   "end": 66.297,
   "id": "c32"
  },
  {
   "text": "一个人的 KYC 身份",
   "start": 66.434,
   "end": 67.981,
   "id": "c33"
  },
  {
   "text": "就扩散到了另外 3 个人身上",
   "start": 68.093,
   "end": 70.045,
   "id": "c34"
  },
  {
   "text": "这套方法",
   "start": 70.388,
   "end": 71.263,
   "id": "c35"
  },
  {
   "text": "已经走进了法庭",
   "start": 71.374,
   "end": 72.825,
   "id": "c36"
  },
  {
   "text": "Bitcoin Fog 是一个混币器",
   "start": 73.18,
   "end": 75.345,
   "id": "c37"
  },
  {
   "text": "经手 120 万余枚比特币",
   "start": 75.444,
   "end": 77.633,
   "id": "c38"
  },
  {
   "text": "2024 年 3 月",
   "start": 77.93,
   "end": 79.336,
   "id": "c39"
  },
  {
   "text": "陪审团裁定",
   "start": 79.565,
   "end": 80.565,
   "id": "c40"
  },
  {
   "text": "运营者 Roman Sterlingov",
   "start": 80.779,
   "end": 82.361,
   "id": "c41"
  },
  {
   "text": "四项罪名成立",
   "start": 82.381,
   "end": 83.584,
   "id": "c42"
  },
  {
   "text": "法官经过专门听证",
   "start": 83.83,
   "end": 85.507,
   "id": "c43"
  },
  {
   "text": "认定 Chainalysis Reactor",
   "start": 85.683,
   "end": 87.346,
   "id": "c44"
  },
  {
   "text": "的分析可以作为证据",
   "start": 87.366,
   "end": 89.121,
   "id": "c45"
  },
  {
   "text": "同时 还有卧底交易等其他证据印证",
   "start": 89.33,
   "end": 92.67,
   "id": "c46"
  },
  {
   "text": "2026 年 9 月",
   "start": 93.014,
   "end": 94.314,
   "id": "c47"
  },
  {
   "text": "上诉法院维持定罪",
   "start": 94.469,
   "end": 96.379,
   "id": "c48"
  },
  {
   "text": "没有要求公开工具的源代码",
   "start": 96.647,
   "end": 98.956,
   "id": "c49"
  },
  {
   "text": "混币和换地址",
   "start": 99.21,
   "end": 100.726,
   "id": "c50"
  },
  {
   "text": "不等于匿名",
   "start": 100.781,
   "end": 101.939,
   "id": "c51"
  },
  {
   "text": "交易所的出入金记录",
   "start": 102.322,
   "end": 104.089,
   "id": "c52"
  },
  {
   "text": "往往是把地址落到真人身上的关键一环",
   "start": 104.215,
   "end": 107.768,
   "id": "c53"
  },
  {
   "text": "执法和交易所用它追踪被盗资金",
   "start": 108.066,
   "end": 111.141,
   "id": "c54"
  },
  {
   "text": "攻击者用它筛选目标",
   "start": 111.223,
   "end": 113.103,
   "id": "c55"
  }
 ]
}