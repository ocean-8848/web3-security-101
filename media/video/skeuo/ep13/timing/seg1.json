 "captions": [
  {
   "text": "2022 年 2 月",
   "start": 1.648,
   "end": 2.853,
   "id": "c0"
  },
  {
   "text": "Wormhole 跨链桥在 Solana 一侧",
   "start": 2.981,
   "end": 5.258,
   "id": "c1"
  },
  {
   "text": "被铸出约 12 万枚 wETH",
   "start": 5.386,
   "end": 7.722,
   "id": "c2"
  },
  {
   "text": "按事发时的价格",
   "start": 8.708,
   "end": 10.128,
   "id": "c3"
  },
  {
   "text": "约 3.2 亿美元",
   "start": 10.184,
   "end": 11.651,
   "id": "c4"
  },
  {
   "text": "攻击者往程序里",
   "start": 12.648,
   "end": 14.044,
   "id": "c5"
  },
  {
   "text": "传了一个伪造的系统账户",
   "start": 14.064,
   "end": 15.96,
   "id": "c6"
  },
  {
   "text": "程序读了这个账户",
   "start": 16.948,
   "end": 18.463,
   "id": "c7"
  },
  {
   "text": "没有核对它是不是真的",
   "start": 18.614,
   "end": 20.677,
   "id": "c8"
  },
  {
   "text": "守护者的签名验证",
   "start": 21.656,
   "end": 23.302,
   "id": "c9"
  },
  {
   "text": "就这样被绕开",
   "start": 23.418,
   "end": 24.873,
   "id": "c10"
  },
  {
   "text": "先猜一道题",
   "start": 25.836,
   "end": 27.16,
   "id": "c11"
  },
  {
   "text": "在以太坊上",
   "start": 28.144,
   "end": 29.195,
   "id": "c12"
  },
  {
   "text": "合约要读另一个合约",
   "start": 29.394,
   "end": 30.885,
   "id": "c13"
  },
  {
   "text": "地址写在代码或存储里",
   "start": 30.953,
   "end": 32.98,
   "id": "c14"
  },
  {
   "text": "在 Solana 上",
   "start": 33.956,
   "end": 35.03,
   "id": "c15"
  },
  {
   "text": "程序要读的账户",
   "start": 35.075,
   "end": 36.293,
   "id": "c16"
  },
  {
   "text": "由谁提供",
   "start": 36.313,
   "end": 37.233,
   "id": "c17"
  },
  {
   "text": "先记住这个问题",
   "start": 38.512,
   "end": 39.955,
   "id": "c18"
  },
  {
   "text": "按 Kudelski 和 Halborn 的分析",
   "start": 40.94,
   "end": 43.336,
   "id": "c19"
  },
  {
   "text": "问题出在一个已经弃用的读取函数",
   "start": 43.511,
   "end": 46.205,
   "id": "c20"
  },
  {
   "text": "它不检查传进来的系统账户",
   "start": 47.184,
   "end": 49.461,
   "id": "c21"
  },
  {
   "text": "是不是真的系统账户",
   "start": 49.505,
   "end": 51.092,
   "id": "c22"
  },
  {
   "text": "修复的办法",
   "start": 52.084,
   "end": 53.23,
   "id": "c23"
  },
  {
   "text": "是改用带校验的函数",
   "start": 53.274,
   "end": 54.908,
   "id": "c24"
  },
  {
   "text": "Jump Crypto 补足了全部 ETH",
   "start": 55.284,
   "end": 57.513,
   "id": "c25"
  },
  {
   "text": "同样的错误",
   "start": 58.496,
   "end": 59.618,
   "id": "c26"
  },
  {
   "text": "换一条链",
   "start": 59.746,
   "end": 60.606,
   "id": "c27"
  },
  {
   "text": "就换了一副样子",
   "start": 60.722,
   "end": 61.844,
   "id": "c28"
  },
  {
   "text": "每种链上的程序",
   "start": 62.844,
   "end": 64.335,
   "id": "c29"
  },
  {
   "text": "到底在相信什么",
   "start": 64.546,
   "end": 65.68,
   "id": "c30"
  }
 ]
}