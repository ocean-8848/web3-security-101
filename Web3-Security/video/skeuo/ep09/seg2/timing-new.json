 "captions": [
  {
   "text": "先说一个词 MEV",
   "start": 1.648,
   "end": 3.723,
   "id": "c0"
  },
  {
   "text": "最大可提取价值",
   "start": 3.743,
   "end": 5.127,
   "id": "c1"
  },
  {
   "text": "它指的是",
   "start": 6.116,
   "end": 7.024,
   "id": "c2"
  },
  {
   "text": "区块生产者或者搜索者",
   "start": 7.128,
   "end": 9.298,
   "id": "c3"
  },
  {
   "text": "通过安排交易顺序",
   "start": 9.378,
   "end": 10.881,
   "id": "c4"
  },
  {
   "text": "插入或排除交易",
   "start": 10.901,
   "end": 12.369,
   "id": "c5"
  },
  {
   "text": "拿到的额外收益",
   "start": 12.425,
   "end": 13.786,
   "id": "c6"
  },
  {
   "text": "搜索者 是专门寻找这类机会",
   "start": 14.784,
   "end": 17.263,
   "id": "c7"
  },
  {
   "text": "把交易捆成一组提交的人或程序",
   "start": 17.391,
   "end": 19.846,
   "id": "c8"
  },
  {
   "text": "搜索者把捆绑包交给区块构建者",
   "start": 20.836,
   "end": 23.506,
   "id": "c9"
  },
  {
   "text": "构建者再把整个区块",
   "start": 23.705,
   "end": 25.328,
   "id": "c10"
  },
  {
   "text": "卖给提议者",
   "start": 25.348,
   "end": 26.339,
   "id": "c11"
  },
  {
   "text": "这叫提议者与构建者分离",
   "start": 27.32,
   "end": 29.478,
   "id": "c12"
  },
  {
   "text": "结果是 排序权可以被购买",
   "start": 29.853,
   "end": 32.321,
   "id": "c13"
  },
  {
   "text": "MEV 有三种形态",
   "start": 33.324,
   "end": 35.339,
   "id": "c14"
  },
  {
   "text": "第一种 抢跑",
   "start": 36.328,
   "end": 37.724,
   "id": "c15"
  },
  {
   "text": "攻击者排在你前面",
   "start": 37.911,
   "end": 39.319,
   "id": "c16"
  },
  {
   "text": "比如一道谜题",
   "start": 40.292,
   "end": 41.557,
   "id": "c17"
  },
  {
   "text": "第一个提交答案的人领奖",
   "start": 41.792,
   "end": 43.533,
   "id": "c18"
  },
  {
   "text": "机器人复制你的答案",
   "start": 43.908,
   "end": 45.388,
   "id": "c19"
  },
  {
   "text": "出更高的小费 先成交",
   "start": 45.492,
   "end": 47.626,
   "id": "c20"
  },
  {
   "text": "第二种 三明治",
   "start": 48.624,
   "end": 50.389,
   "id": "c21"
  },
  {
   "text": "攻击者先买 你再买",
   "start": 50.469,
   "end": 52.425,
   "id": "c22"
  },
  {
   "text": "攻击者最后卖",
   "start": 52.493,
   "end": 53.758,
   "id": "c23"
  },
  {
   "text": "他利用的",
   "start": 54.724,
   "end": 55.691,
   "id": "c24"
  },
  {
   "text": "是你设定的滑点容忍度",
   "start": 55.819,
   "end": 57.727,
   "id": "c25"
  },
  {
   "text": "第三种 尾随",
   "start": 58.712,
   "end": 60.394,
   "id": "c26"
  },
  {
   "text": "攻击者排在你后面",
   "start": 60.557,
   "end": 62.048,
   "id": "c27"
  },
  {
   "text": "吃掉你的交易留下的套利或清算机会",
   "start": 62.14,
   "end": 64.917,
   "id": "c28"
  },
  {
   "text": "尾随通常没有直接的受害者",
   "start": 65.916,
   "end": 68.109,
   "id": "c29"
  },
  {
   "text": "回到三明治 拆开看",
   "start": 69.088,
   "end": 71.293,
   "id": "c30"
  },
  {
   "text": "你的交易进入公开内存池",
   "start": 72.26,
   "end": 74.596,
   "id": "c31"
  },
  {
   "text": "搜索者发现它",
   "start": 75.576,
   "end": 76.948,
   "id": "c32"
  },
  {
   "text": "捆成一包",
   "start": 77.028,
   "end": 77.924,
   "id": "c33"
  },
  {
   "text": "自己买入",
   "start": 78.016,
   "end": 78.865,
   "id": "c34"
  },
  {
   "text": "你的交易",
   "start": 79.028,
   "end": 79.948,
   "id": "c35"
  },
  {
   "text": "自己卖出",
   "start": 80.052,
   "end": 80.984,
   "id": "c36"
  },
  {
   "text": "构建者按这个顺序打包",
   "start": 81.964,
   "end": 83.788,
   "id": "c37"
  },
  {
   "text": "搜索者先买",
   "start": 84.776,
   "end": 85.827,
   "id": "c38"
  },
  {
   "text": "把价格推高",
   "start": 85.954,
   "end": 86.886,
   "id": "c39"
  },
  {
   "text": "你按更坏的价格成交",
   "start": 87.876,
   "end": 89.498,
   "id": "c40"
  },
  {
   "text": "刚好满足最小输出",
   "start": 89.542,
   "end": 91.272,
   "id": "c41"
  },
  {
   "text": "搜索者再卖回去",
   "start": 92.272,
   "end": 93.87,
   "id": "c42"
  },
  {
   "text": "赚走中间的利润",
   "start": 93.903,
   "end": 95.227,
   "id": "c43"
  },
  {
   "text": "他最多能赚多少",
   "start": 96.212,
   "end": 97.727,
   "id": "c44"
  },
  {
   "text": "由你的最小输出决定",
   "start": 97.854,
   "end": 99.358,
   "id": "c45"
  },
  {
   "text": "滑点设得越宽",
   "start": 99.733,
   "end": 101.07,
   "id": "c46"
  },
  {
   "text": "被夹得越狠",
   "start": 101.174,
   "end": 102.141,
   "id": "c47"
  },
  {
   "text": "打个比方",
   "start": 103.128,
   "end": 104.083,
   "id": "c48"
  },
  {
   "text": "你在拍卖会上举牌之前",
   "start": 104.447,
   "end": 106.283,
   "id": "c49"
  },
  {
   "text": "大声说出了自己的最高出价",
   "start": 106.542,
   "end": 108.414,
   "id": "c50"
  },
  {
   "text": "旁边的人抢先用低一点的价格买下",
   "start": 109.396,
   "end": 111.923,
   "id": "c51"
  },
  {
   "text": "再加价转卖给你",
   "start": 112.11,
   "end": 113.423,
   "id": "c52"
  },
  {
   "text": "比喻在这里不成立",
   "start": 114.392,
   "end": 115.788,
   "id": "c53"
  },
  {
   "text": "拍卖会上",
   "start": 115.927,
   "end": 116.895,
   "id": "c54"
  },
  {
   "text": "你能看到谁插了队",
   "start": 117.094,
   "end": 118.55,
   "id": "c55"
  },
  {
   "text": "链上的三明治",
   "start": 119.532,
   "end": 120.773,
   "id": "c56"
  },
  {
   "text": "和你的交易在同一个区块里",
   "start": 120.841,
   "end": 123.035,
   "id": "c57"
  },
  {
   "text": "普通用户往往只看到",
   "start": 123.386,
   "end": 125.092,
   "id": "c58"
  },
  {
   "text": "成交价比预期低",
   "start": 125.148,
   "end": 126.699,
   "id": "c59"
  }
 ]
}