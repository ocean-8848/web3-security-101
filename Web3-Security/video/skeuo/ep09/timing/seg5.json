   "start": 18.155,
   "end": 19.028,
   "id": "c9"
  },
  {
   "text": "第二 签名可塑性",
   "start": 20.02,
   "end": 21.904,
   "id": "c10"
  },
  {
   "text": "同一条消息",
   "start": 21.936,
   "end": 23.023,
   "id": "c11"
  },
  {
   "text": "存在两份都有效的签名",
   "start": 23.067,
   "end": 25.082,
   "id": "c12"
  },
  {
   "text": "如果合约拿签名本身",
   "start": 26.072,
   "end": 27.742,
   "id": "c13"
  },
  {
   "text": "标记已使用",
   "start": 27.774,
   "end": 28.884,
   "id": "c14"
  },
  {
   "text": "翻转签名里的一个数值",
   "start": 29.0,
   "end": 30.694,
   "id": "c15"
  },
  {
   "text": "就成了一份新签名",
   "start": 30.714,
   "end": 32.123,
   "id": "c16"
  },
  {
   "text": "修复是 用 nonce 或消息哈希做标记",
   "start": 33.108,
   "end": 36.48,
   "id": "c17"
  },
  {
   "text": "再用拒绝这种翻转的库",
   "start": 36.584,
   "end": 38.385,
   "id": "c18"
  },
  {
   "text": "比如 OpenZeppelin 的 ECDSA",
   "start": 38.465,
   "end": 40.682,
   "id": "c19"
  },
  {
   "text": "第三 编码碰撞",
   "start": 41.656,
   "end": 43.314,
   "id": "c20"
  },
  {
   "text": "紧凑编码会把相邻的动态数据",
   "start": 43.689,
   "end": 46.24,
   "id": "c21"
  },
  {
   "text": "直接拼在一起",
   "start": 46.296,
   "end": 47.478,
   "id": "c22"
  },
  {
   "text": "ab 加 c",
   "start": 48.476,
   "end": 49.574,
   "id": "c23"
  },
  {
   "text": "和 a 加 bc",
   "start": 49.642,
   "end": 51.027,
   "id": "c24"
  },
  {
   "text": "结果完全相同",
   "start": 51.071,
   "end": 52.312,
   "id": "c25"
  },
  {
   "text": "签多个动态类型时",
   "start": 52.676,
   "end": 54.239,
   "id": "c26"
  },
  {
   "text": "用标准编码",
   "start": 54.259,
   "end": 55.381,
   "id": "c27"
  },
  {
   "text": "还有一点",
   "start": 56.376,
   "end": 57.236,
   "id": "c28"
  },
  {
   "text": "合约钱包没有私钥",
   "start": 57.611,
   "end": 59.008,
   "id": "c29"
  },
  {
   "text": "要用 ERC-1271 的接口校验",
   "start": 59.028,
   "end": 61.388,
   "id": "c30"
  },
  {
   "text": "不能只靠 ecrecover",
   "start": 61.433,
   "end": 63.019,
   "id": "c31"
  },
  {
   "text": "再看 permit 的两面",
   "start": 63.988,
   "end": 65.491,
   "id": "c32"
  },
  {
   "text": "一面是抢跑型的拒绝服务",
   "start": 66.488,
   "end": 68.443,
   "id": "c33"
  },
  {
   "text": "你提交的交易里",
   "start": 68.819,
   "end": 69.965,
   "id": "c34"
  },
  {
   "text": "带着 permit 签名",
   "start": 69.985,
   "end": 71.429,
   "id": "c35"
  },
  {
   "text": "别人从内存池复制这份签名",
   "start": 72.42,
   "end": 74.78,
   "id": "c36"
  },
  {
   "text": "抢先单独提交",
   "start": 74.801,
   "end": 76.316,
   "id": "c37"
  },
  {
   "text": "你的交易因为 nonce 已用 回滚",
   "start": 76.679,
   "end": 79.706,
   "id": "c38"
  },
  {
   "text": "修复是 把 permit 包在 try catch 里",
   "start": 80.68,
   "end": 83.457,
   "id": "c39"
  },
  {
   "text": "失败后 检查授权额度是否已经足够",
   "start": 83.82,
   "end": 87.335,
   "id": "c40"
  },
  {
   "text": "另一面是钓鱼",
   "start": 88.34,
   "end": 89.641,
   "id": "c41"
  },
  {
   "text": "permit 在链下签",
   "start": 90.016,
   "end": 91.472,
   "id": "c42"
  },
  {
   "text": "不花 gas",
   "start": 91.563,
   "end": 92.495,
   "id": "c43"
  },
  {
   "text": "钱包常常只显示一串十六进制",
   "start": 92.647,
   "end": 95.317,
   "id": "c44"
  },
  {
   "text": "签下之后",
   "start": 96.312,
   "end": 97.291,
   "id": "c45"
  },
  {
   "text": "对方可以随时拿去执行",
   "start": 97.443,
   "end": 99.351,
   "id": "c46"
  },
  {
   "text": "签名再安全",
   "start": 100.348,
   "end": 101.577,
   "id": "c47"
  },
  {
   "text": "签名人也可能签错东西",
   "start": 101.705,
   "end": 103.565,
   "id": "c48"
  },
  {
   "text": "2025 年 2 月",
   "start": 104.552,
   "end": 105.758,
   "id": "c49"
  },
  {
   "text": "交易所 Bybit 的冷钱包多签被盗",
   "start": 105.778,
   "end": 108.341,
   "id": "c50"
  },
  {
   "text": "按 Sygnia",
   "start": 109.308,
   "end": 110.359,
   "id": "c51"
  },
  {
   "text": "Verichains 等公开分析",
   "start": 110.403,
   "end": 112.097,
   "id": "c52"
  },
  {
   "text": "攻击者篡改了 Safe Wallet 的前端",
   "start": 112.296,
   "end": 114.716,
   "id": "c53"
  },
  {
   "text": "只对 Bybit 的多签地址生效",
   "start": 114.736,
   "end": 116.739,
   "id": "c54"
  },
  {
   "text": "签名人看到的",
   "start": 117.736,
   "end": 119.001,
   "id": "c55"
  },
  {
   "text": "是一笔普通转账",
   "start": 119.021,
   "end": 120.418,
   "id": "c56"
  },
  {
   "text": "实际签下的",
   "start": 121.412,
   "end": 122.439,
   "id": "c57"
  },
  {
   "text": "是一次 delegatecall",
   "start": 122.459,
   "end": 123.927,
   "id": "c58"
  },
  {
   "text": "把钱包的实现",
   "start": 123.983,
   "end": 125.058,
   "id": "c59"
  },
  {
   "text": "换成恶意合约",
   "start": 125.078,
   "end": 126.343,
   "id": "c60"
  },
  {
   "text": "多签合约只校验签名对不对",
   "start": 127.344,
   "end": 129.728,
   "id": "c61"
  },
  {
   "text": "数量够不够",
   "start": 129.879,
   "end": 130.906,
   "id": "c62"
  },
  {
   "text": "签名是真的",
   "start": 131.258,
   "end": 132.392,
   "id": "c63"
  },
  {
   "text": "内容不是签名人以为的内容",
   "start": 132.627,
   "end": 134.487,
   "id": "c64"
  },
  {
   "text": "按事发时估值",
   "start": 135.484,
   "end": 136.927,
   "id": "c65"
  },
  {
   "text": "损失约 15 亿美元",
   "start": 136.96,
   "end": 138.773,
   "id": "c66"
  },
  {
   "text": "多签防的是一把私钥被盗",
   "start": 139.76,
   "end": 142.001,
   "id": "c67"
  },
  {
   "text": "防不了所有签名人",
   "start": 142.141,
   "end": 143.692,
   "id": "c68"
  },
  {
   "text": "看到同一个假界面",
   "start": 143.712,
   "end": 145.168,
   "id": "c69"
  },
  {
   "text": "2024 年 7 月",
   "start": 146.124,
   "end": 147.413,
   "id": "c70"
  },
  {
   "text": "印度交易所 WazirX 的多签冷钱包",
   "start": 147.636,
   "end": 150.579,
   "id": "c71"
  },
  {
   "text": "也是这样",
   "start": 150.6,
   "end": 151.389,
   "id": "c72"
  },
  {
   "text": "界面上是日常交易",
   "start": 152.368,
   "end": 153.978,
   "id": "c73"
  },
  {
   "text": "硬件钱包签下的",
   "start": 154.106,
   "end": 155.502,
   "id": "c74"
  },
  {
   "text": "却是升级多签的恶意数据",
   "start": 155.546,
   "end": 157.645,
   "id": "c75"
  },
  {
   "text": "按公开分析",
   "start": 158.02,
   "end": 159.178,
   "id": "c76"
  },
  {
   "text": "损失约 2.3 亿美元",
   "start": 159.258,
   "end": 161.273,
   "id": "c77"
  },
  {
   "text": "防御有三条",
   "start": 162.26,
   "end": 163.561,
   "id": "c78"
  },
  {
   "text": "用硬件钱包逐个字段核对",
   "start": 163.924,
   "end": 166.368,
   "id": "c79"
  },
  {
   "text": "用独立工具解码交易数据",
   "start": 166.745,
   "end": 169.249,
   "id": "c80"
  },
  {
   "text": "对 delegatecall",
   "start": 170.232,
   "end": 171.366,
   "id": "c81"
  },
  {
   "text": "和修改实现地址的操作",
   "start": 171.386,
   "end": 173.366,
   "id": "c82"
  },
  {
   "text": "设白名单或额外审批",
   "start": 173.458,
   "end": 175.473,
   "id": "c83"
  }
 ]
}