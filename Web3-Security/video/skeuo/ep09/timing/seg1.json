 "captions": [
  {
   "text": "你在一个去中心化交易所",
   "start": 1.648,
   "end": 3.401,
   "id": "c0"
  },
  {
   "text": "用 10 个 ETH 换 USDC",
   "start": 3.421,
   "end": 5.413,
   "id": "c1"
  },
  {
   "text": "池子现价",
   "start": 6.404,
   "end": 7.383,
   "id": "c2"
  },
  {
   "text": "1 个 ETH 换 2000 USDC",
   "start": 7.427,
   "end": 9.931,
   "id": "c3"
  },
  {
   "text": "这是示例",
   "start": 10.294,
   "end": 11.238,
   "id": "c4"
  },
  {
   "text": "你把滑点设成 5%",
   "start": 12.24,
   "end": 14.124,
   "id": "c5"
  },
  {
   "text": "意思是 最少拿到 19000 USDC",
   "start": 15.1,
   "end": 18.555,
   "id": "c6"
  },
  {
   "text": "少于这个数",
   "start": 18.931,
   "end": 20.124,
   "id": "c7"
  },
  {
   "text": "交易就回滚",
   "start": 20.252,
   "end": 21.327,
   "id": "c8"
  },
  {
   "text": "交易发出去",
   "start": 22.304,
   "end": 23.378,
   "id": "c9"
  },
  {
   "text": "先进入公开的内存池",
   "start": 23.47,
   "end": 25.271,
   "id": "c10"
  },
  {
   "text": "排队等着打包",
   "start": 25.292,
   "end": 26.557,
   "id": "c11"
  },
  {
   "text": "有人在打包之前",
   "start": 27.54,
   "end": 28.924,
   "id": "c12"
  },
  {
   "text": "读到了它",
   "start": 29.075,
   "end": 29.912,
   "id": "c13"
  },
  {
   "text": "他把你的交易",
   "start": 30.88,
   "end": 32.073,
   "id": "c14"
  },
  {
   "text": "夹在自己的两笔交易中间",
   "start": 32.13,
   "end": 33.895,
   "id": "c15"
  },
  {
   "text": "先猜一道题",
   "start": 34.892,
   "end": 36.216,
   "id": "c16"
  },
  {
   "text": "你最少收到多少",
   "start": 37.2,
   "end": 38.608,
   "id": "c17"
  },
  {
   "text": "他能让你收到更少吗",
   "start": 38.983,
   "end": 40.534,
   "id": "c18"
  },
  {
   "text": "你最少收到 19000",
   "start": 41.804,
   "end": 43.652,
   "id": "c19"
  },
  {
   "text": "他不能让你更少",
   "start": 44.016,
   "end": 45.233,
   "id": "c20"
  },
  {
   "text": "低于这个数",
   "start": 46.224,
   "end": 47.334,
   "id": "c21"
  },
  {
   "text": "你的交易回滚",
   "start": 47.497,
   "end": 48.882,
   "id": "c22"
  },
  {
   "text": "他也赚不到钱",
   "start": 49.164,
   "end": 50.298,
   "id": "c23"
  },
  {
   "text": "所以 他会把价格推到刚好够 19000 的位置",
   "start": 51.292,
   "end": 55.057,
   "id": "c24"
  },
  {
   "text": "你的交易没有失败",
   "start": 56.048,
   "end": 57.515,
   "id": "c25"
  },
  {
   "text": "它只是按你允许的最差价格 成交了",
   "start": 57.89,
   "end": 60.941,
   "id": "c26"
  },
  {
   "text": "滑点设 5%",
   "start": 61.932,
   "end": 63.471,
   "id": "c27"
  },
  {
   "text": "就可能真的付 5%",
   "start": 63.551,
   "end": 65.173,
   "id": "c28"
  },
  {
   "text": "交易在打包之前是公开的",
   "start": 66.16,
   "end": 68.163,
   "id": "c29"
  },
  {
   "text": "顺序由别人决定",
   "start": 68.195,
   "end": 69.603,
   "id": "c30"
  },
  {
   "text": "签名在用过之后仍然存在",
   "start": 70.604,
   "end": 73.024,
   "id": "c31"
  },
  {
   "text": "能不能再用",
   "start": 73.399,
   "end": 74.414,
   "id": "c32"
  },
  {
   "text": "取决于你签了什么",
   "start": 74.53,
   "end": 75.795,
   "id": "c33"
  }
 ]
