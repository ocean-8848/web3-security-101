 "captions": [
  {
   "text": "怎么防",
   "start": 1.645,
   "end": 2.329,
   "id": "c0"
  },
  {
   "text": "分四层",
   "start": 2.468,
   "end": 3.253,
   "id": "c1"
  },
  {
   "text": "用户这一层",
   "start": 3.53,
   "end": 4.665,
   "id": "c2"
  },
  {
   "text": "把滑点设得合理",
   "start": 4.755,
   "end": 6.401,
   "id": "c3"
  },
  {
   "text": "大额交易",
   "start": 6.647,
   "end": 7.494,
   "id": "c4"
  },
  {
   "text": "走私有交易通道",
   "start": 7.749,
   "end": 9.26,
   "id": "c5"
  },
  {
   "text": "比如 Flashbots Protect",
   "start": 9.5,
   "end": 11.307,
   "id": "c6"
  },
  {
   "text": "一类的服务",
   "start": 11.327,
   "end": 12.544,
   "id": "c7"
  },
  {
   "text": "交易不进公开内存池",
   "start": 12.79,
   "end": 14.574,
   "id": "c8"
  },
  {
   "text": "搜索者在打包之前",
   "start": 14.912,
   "end": 16.511,
   "id": "c9"
  },
  {
   "text": "就看不到它",
   "start": 16.532,
   "end": 17.366,
   "id": "c10"
  },
  {
   "text": "前端这一层",
   "start": 17.745,
   "end": 18.866,
   "id": "c11"
  },
  {
   "text": "默认滑点要保守",
   "start": 18.894,
   "end": 20.548,
   "id": "c12"
  },
  {
   "text": "按池子的深度来计算",
   "start": 20.648,
   "end": 22.373,
   "id": "c13"
  },
  {
   "text": "合约这一层",
   "start": 22.67,
   "end": 23.973,
   "id": "c14"
  },
  {
   "text": "所有交换函数",
   "start": 24.072,
   "end": 25.424,
   "id": "c15"
  },
  {
   "text": "都要接受最小输出和截止时间两个参数",
   "start": 25.523,
   "end": 29.274,
   "id": "c16"
  },
  {
   "text": "常见的错误",
   "start": 29.625,
   "end": 30.726,
   "id": "c17"
  },
  {
   "text": "是在合约内部",
   "start": 30.847,
   "end": 32.271,
   "id": "c18"
  },
  {
   "text": "用现货价算出最小输出",
   "start": 32.353,
   "end": 34.761,
   "id": "c19"
  },
  {
   "text": "那个现货价",
   "start": 34.95,
   "end": 36.284,
   "id": "c20"
  },
  {
   "text": "在同一个区块里就能被推高",
   "start": 36.394,
   "end": 38.715,
   "id": "c21"
  },
  {
   "text": "按它算出的保护",
   "start": 39.208,
   "end": 40.55,
   "id": "c22"
  },
  {
   "text": "等于没有保护",
   "start": 40.664,
   "end": 41.773,
   "id": "c23"
  },
  {
   "text": "更糟的写法",
   "start": 42.152,
   "end": 43.144,
   "id": "c24"
  },
  {
   "text": "是把最小输出直接写成 0",
   "start": 43.287,
   "end": 45.724,
   "id": "c25"
  },
  {
   "text": "这等于告诉所有人",
   "start": 45.95,
   "end": 47.388,
   "id": "c26"
  },
  {
   "text": "我接受任何价格",
   "start": 47.577,
   "end": 49.696,
   "id": "c27"
  },
  {
   "text": "金库 自动复投合约",
   "start": 49.92,
   "end": 51.221,
   "id": "c28"
  },
  {
   "text": "清算合约",
   "start": 51.404,
   "end": 52.431,
   "id": "c29"
  },
  {
   "text": "常犯这个错误",
   "start": 52.55,
   "end": 53.634,
   "id": "c30"
  },
  {
   "text": "协议设计这一层",
   "start": 53.85,
   "end": 55.236,
   "id": "c31"
  },
  {
   "text": "有两种做法",
   "start": 55.265,
   "end": 56.169,
   "id": "c32"
  },
  {
   "text": "一是提交揭示",
   "start": 56.563,
   "end": 57.993,
   "id": "c33"
  },
  {
   "text": "先提交答案的哈希",
   "start": 58.259,
   "end": 59.836,
   "id": "c34"
  },
  {
   "text": "下一阶段再公开答案",
   "start": 60.052,
   "end": 61.951,
   "id": "c35"
  },
  {
   "text": "这个承诺",
   "start": 62.21,
   "end": 62.977,
   "id": "c36"
  },
  {
   "text": "必须绑定发送者的地址",
   "start": 63.165,
   "end": 65.216,
   "id": "c37"
  },
  {
   "text": "不然 机器人复制你的承诺",
   "start": 65.385,
   "end": 67.363,
   "id": "c38"
  },
  {
   "text": "也能完成揭示",
   "start": 67.383,
   "end": 68.542,
   "id": "c39"
  },
  {
   "text": "二是批量拍卖",
   "start": 68.93,
   "end": 70.37,
   "id": "c40"
  },
  {
   "text": "同一批订单",
   "start": 70.582,
   "end": 71.586,
   "id": "c41"
  },
  {
   "text": "按统一价格清算",
   "start": 71.668,
   "end": 73.059,
   "id": "c42"
  },
  {
   "text": "顺序由谁决定",
   "start": 73.37,
   "end": 75.159,
   "id": "c43"
  },
  {
   "text": "每条链也不一样",
   "start": 75.179,
   "end": 76.493,
   "id": "c44"
  },
  {
   "text": "BNB Chain",
   "start": 76.811,
   "end": 77.831,
   "id": "c45"
  },
  {
   "text": "验证者轮流出块",
   "start": 78.07,
   "end": 79.657,
   "id": "c46"
  },
  {
   "text": "2026 年 1 月",
   "start": 79.928,
   "end": 81.286,
   "id": "c47"
  },
  {
   "text": "出块间隔缩短到 0.45 秒",
   "start": 81.535,
   "end": 84.339,
   "id": "c48"
  },
  {
   "text": "抢跑的窗口更短",
   "start": 84.703,
   "end": 86.319,
   "id": "c49"
  },
  {
   "text": "但它有公开内存池和构建者市场",
   "start": 86.782,
   "end": 89.94,
   "id": "c50"
  },
  {
   "text": "三明治依然存在",
   "start": 90.09,
   "end": 91.531,
   "id": "c51"
  },
  {
   "text": "TRON",
   "start": 91.79,
   "end": 92.212,
   "id": "c52"
  },
  {
   "text": "27 个超级代表轮流出块",
   "start": 92.953,
   "end": 95.454,
   "id": "c53"
  },
  {
   "text": "按 TRON 官方文档",
   "start": 95.783,
   "end": 97.127,
   "id": "c54"
  },
  {
   "text": "它没有优先费",
   "start": 97.219,
   "end": 98.4,
   "id": "c55"
  },
  {
   "text": "不能靠出更高的价格插队",
   "start": 98.523,
   "end": 100.456,
   "id": "c56"
  },
  {
   "text": "但出块的人",
   "start": 100.71,
   "end": 101.883,
   "id": "c57"
  },
  {
   "text": "仍然可以决定顺序",
   "start": 101.986,
   "end": 103.519,
   "id": "c58"
  },
  {
   "text": "Mantle",
   "start": 103.907,
   "end": 104.484,
   "id": "c59"
  },
  {
   "text": "只有一个中心化排序器",
   "start": 104.649,
   "end": 106.45,
   "id": "c60"
  },
  {
   "text": "L2BEAT 列出的风险是",
   "start": 106.845,
   "end": 108.625,
   "id": "c61"
  },
  {
   "text": "运营者可以抢跑用户交易",
   "start": 108.795,
   "end": 110.91,
   "id": "c62"
  },
  {
   "text": "提取 MEV",
   "start": 110.984,
   "end": 112.11,
   "id": "c63"
  },
  {
   "text": "没有公开内存池",
   "start": 112.429,
   "end": 113.985,
   "id": "c64"
  },
  {
   "text": "不等于没有 MEV",
   "start": 114.076,
   "end": 115.551,
   "id": "c65"
  },
  {
   "text": "它只是把排序权",
   "start": 115.83,
   "end": 117.399,
   "id": "c66"
  },
  {
   "text": "从市场集中到一个运营者手里",
   "start": 117.432,
   "end": 119.97,
   "id": "c67"
  }
 ]
}