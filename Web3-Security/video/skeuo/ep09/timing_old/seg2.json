 "captions": [
  {
   "text": "先说一个词 MEV",
   "start": 1.55,
   "end": 3.703,
   "id": "c0"
  },
  {
   "text": "最大可提取价值",
   "start": 3.723,
   "end": 6.001,
   "id": "c1"
  },
  {
   "text": "它指的是",
   "start": 6.25,
   "end": 7.159,
   "id": "c2"
  },
  {
   "text": "区块生产者或者搜索者",
   "start": 7.384,
   "end": 9.756,
   "id": "c3"
  },
  {
   "text": "通过安排交易顺序",
   "start": 9.833,
   "end": 11.568,
   "id": "c4"
  },
  {
   "text": "插入或排除交易",
   "start": 11.692,
   "end": 13.54,
   "id": "c5"
  },
  {
   "text": "拿到的额外收益",
   "start": 13.746,
   "end": 15.094,
   "id": "c6"
  },
  {
   "text": "搜索者 是专门寻找这类机会",
   "start": 15.35,
   "end": 18.031,
   "id": "c7"
  },
  {
   "text": "把交易捆成一组提交的人或程序",
   "start": 18.249,
   "end": 21.116,
   "id": "c8"
  },
  {
   "text": "搜索者把捆绑包交给区块构建者",
   "start": 21.33,
   "end": 24.505,
   "id": "c9"
  },
  {
   "text": "构建者再把整个区块",
   "start": 24.756,
   "end": 26.446,
   "id": "c10"
  },
  {
   "text": "卖给提议者",
   "start": 26.545,
   "end": 27.594,
   "id": "c11"
  },
  {
   "text": "这叫提议者与构建者分离",
   "start": 27.87,
   "end": 30.44,
   "id": "c12"
  },
  {
   "text": "结果是 排序权可以被购买",
   "start": 30.731,
   "end": 33.381,
   "id": "c13"
  },
  {
   "text": "MEV 有三种形态",
   "start": 33.709,
   "end": 35.47,
   "id": "c14"
  },
  {
   "text": "第一种 抢跑",
   "start": 35.75,
   "end": 37.551,
   "id": "c15"
  },
  {
   "text": "攻击者排在你前面",
   "start": 37.814,
   "end": 39.449,
   "id": "c16"
  },
  {
   "text": "比如一道谜题",
   "start": 39.823,
   "end": 41.009,
   "id": "c17"
  },
  {
   "text": "第一个提交答案的人领奖",
   "start": 41.507,
   "end": 43.263,
   "id": "c18"
  },
  {
   "text": "机器人复制你的答案",
   "start": 43.664,
   "end": 45.261,
   "id": "c19"
  },
  {
   "text": "出更高的小费 先成交",
   "start": 45.397,
   "end": 47.38,
   "id": "c20"
  },
  {
   "text": "第二种 三明治",
   "start": 47.726,
   "end": 49.123,
   "id": "c21"
  },
  {
   "text": "攻击者先买 你再买",
   "start": 49.61,
   "end": 51.774,
   "id": "c22"
  },
  {
   "text": "攻击者最后卖",
   "start": 51.869,
   "end": 53.293,
   "id": "c23"
  },
  {
   "text": "他利用的",
   "start": 53.53,
   "end": 54.452,
   "id": "c24"
  },
  {
   "text": "是你设定的滑点容忍度",
   "start": 54.559,
   "end": 56.784,
   "id": "c25"
  },
  {
   "text": "第三种 尾随",
   "start": 57.13,
   "end": 58.808,
   "id": "c26"
  },
  {
   "text": "攻击者排在你后面",
   "start": 59.043,
   "end": 60.75,
   "id": "c27"
  },
  {
   "text": "吃掉你的交易留下的套利或清算机会",
   "start": 60.933,
   "end": 64.16,
   "id": "c28"
  },
  {
   "text": "尾随通常没有直接的受害者",
   "start": 64.541,
   "end": 66.727,
   "id": "c29"
  },
  {
   "text": "回到三明治 拆开看",
   "start": 66.99,
   "end": 68.692,
   "id": "c30"
  },
  {
   "text": "你的交易进入公开内存池",
   "start": 69.065,
   "end": 71.043,
   "id": "c31"
  },
  {
   "text": "搜索者发现它",
   "start": 71.441,
   "end": 72.56,
   "id": "c32"
  },
  {
   "text": "捆成一包",
   "start": 72.636,
   "end": 73.463,
   "id": "c33"
  },
  {
   "text": "自己买入",
   "start": 73.66,
   "end": 74.438,
   "id": "c34"
  },
  {
   "text": "你的交易",
   "start": 74.616,
   "end": 75.318,
   "id": "c35"
  },
  {
   "text": "自己卖出",
   "start": 75.573,
   "end": 76.39,
   "id": "c36"
  },
  {
   "text": "构建者按这个顺序打包",
   "start": 76.714,
   "end": 78.532,
   "id": "c37"
  },
  {
   "text": "搜索者先买",
   "start": 78.75,
   "end": 80.004,
   "id": "c38"
  },
  {
   "text": "把价格推高",
   "start": 80.182,
   "end": 81.155,
   "id": "c39"
  },
  {
   "text": "你按更坏的价格成交",
   "start": 81.463,
   "end": 83.119,
   "id": "c40"
  },
  {
   "text": "刚好满足最小输出",
   "start": 83.342,
   "end": 85.252,
   "id": "c41"
  },
  {
   "text": "搜索者再卖回去",
   "start": 85.51,
   "end": 87.283,
   "id": "c42"
  },
  {
   "text": "赚走中间的利润",
   "start": 87.503,
   "end": 88.751,
   "id": "c43"
  },
  {
   "text": "他最多能赚多少",
   "start": 89.01,
   "end": 90.604,
   "id": "c44"
  },
  {
   "text": "由你的最小输出决定",
   "start": 90.755,
   "end": 92.486,
   "id": "c45"
  },
  {
   "text": "滑点设得越宽",
   "start": 93.019,
   "end": 94.371,
   "id": "c46"
  },
  {
   "text": "被夹得越狠",
   "start": 94.461,
   "end": 95.431,
   "id": "c47"
  },
  {
   "text": "打个比方",
   "start": 95.809,
   "end": 96.464,
   "id": "c48"
  },
  {
   "text": "你在拍卖会上举牌之前",
   "start": 96.555,
   "end": 98.768,
   "id": "c49"
  },
  {
   "text": "大声说出了自己的最高出价",
   "start": 98.913,
   "end": 100.992,
   "id": "c50"
  },
  {
   "text": "旁边的人抢先用低一点的价格买下",
   "start": 101.21,
   "end": 104.114,
   "id": "c51"
  },
  {
   "text": "再加价转卖给你",
   "start": 104.354,
   "end": 106.075,
   "id": "c52"
  },
  {
   "text": "比喻在这里不成立",
   "start": 106.408,
   "end": 107.826,
   "id": "c53"
  },
  {
   "text": "拍卖会上",
   "start": 107.891,
   "end": 108.719,
   "id": "c54"
  },
  {
   "text": "你能看到谁插了队",
   "start": 108.774,
   "end": 110.367,
   "id": "c55"
  },
  {
   "text": "链上的三明治",
   "start": 110.705,
   "end": 111.865,
   "id": "c56"
  },
  {
   "text": "和你的交易在同一个区块里",
   "start": 112.056,
   "end": 114.345,
   "id": "c57"
  },
  {
   "text": "普通用户往往只看到",
   "start": 114.565,
   "end": 116.53,
   "id": "c58"
  },
  {
   "text": "成交价比预期低",
   "start": 116.616,
   "end": 118.148,
   "id": "c59"
  }
 ]
}