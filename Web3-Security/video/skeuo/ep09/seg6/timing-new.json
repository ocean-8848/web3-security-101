 "captions": [
  {
   "text": "最后 每个人今天就能做一件事",
   "start": 1.648,
   "end": 4.151,
   "id": "c0"
  },
  {
   "text": "写合约的人",
   "start": 5.132,
   "end": 6.171,
   "id": "c1"
  },
  {
   "text": "检查每个交换函数",
   "start": 6.215,
   "end": 7.766,
   "id": "c2"
  },
  {
   "text": "最小输出和截止时间",
   "start": 7.965,
   "end": 9.885,
   "id": "c3"
  },
  {
   "text": "是不是由调用者传进来",
   "start": 9.905,
   "end": 11.635,
   "id": "c4"
  },
  {
   "text": "所有签名",
   "start": 12.624,
   "end": 13.58,
   "id": "c5"
  },
  {
   "text": "用 EIP-712",
   "start": 13.6,
   "end": 15.413,
   "id": "c6"
  },
  {
   "text": "带上 nonce 和截止时间",
   "start": 15.493,
   "end": 17.425,
   "id": "c7"
  },
  {
   "text": "审计的人",
   "start": 18.412,
   "end": 19.367,
   "id": "c8"
  },
  {
   "text": "拿同一份签名提交第二次",
   "start": 19.424,
   "end": 21.665,
   "id": "c9"
  },
  {
   "text": "第二次也成功",
   "start": 22.028,
   "end": 23.186,
   "id": "c10"
  },
  {
   "text": "就是漏洞",
   "start": 23.433,
   "end": 24.222,
   "id": "c11"
  },
  {
   "text": "修复要两个结果 修复前",
   "start": 25.208,
   "end": 27.64,
   "id": "c12"
  },
  {
   "text": "重放成功 修复后 被拦下",
   "start": 27.66,
   "end": 30.473,
   "id": "c13"
  },
  {
   "text": "普通用户",
   "start": 31.452,
   "end": 32.407,
   "id": "c14"
  },
  {
   "text": "大额兑换设合理的滑点",
   "start": 32.654,
   "end": 34.562,
   "id": "c15"
  },
  {
   "text": "不用自动的高滑点",
   "start": 34.594,
   "end": 36.038,
   "id": "c16"
  },
  {
   "text": "可以走私有交易通道",
   "start": 36.106,
   "end": 37.872,
   "id": "c17"
  },
  {
   "text": "签名前看清链 ID",
   "start": 38.872,
   "end": 40.602,
   "id": "c18"
  },
  {
   "text": "合约地址",
   "start": 40.622,
   "end": 41.554,
   "id": "c19"
  },
  {
   "text": "数额和期限",
   "start": 41.574,
   "end": 42.839,
   "id": "c20"
  },
  {
   "text": "钱包只显示哈希",
   "start": 43.214,
   "end": 44.718,
   "id": "c21"
  },
  {
   "text": "或者提示盲签 就不签",
   "start": 44.822,
   "end": 46.777,
   "id": "c22"
  },
  {
   "text": "回到开头",
   "start": 47.756,
   "end": 48.711,
   "id": "c23"
  },
  {
   "text": "滑点设 5%",
   "start": 49.087,
   "end": 50.566,
   "id": "c24"
  },
  {
   "text": "为什么可能真的付 5%",
   "start": 50.813,
   "end": 52.614,
   "id": "c25"
  },
  {
   "text": "因为交易在打包之前是公开的",
   "start": 53.872,
   "end": 55.982,
   "id": "c26"
  },
  {
   "text": "滑点就是你公开的最差报价",
   "start": 56.145,
   "end": 58.399,
   "id": "c27"
  },
  {
   "text": "这在交易走公开内存池时成立",
   "start": 59.396,
   "end": 62.197,
   "id": "c28"
  },
  {
   "text": "走私有通道",
   "start": 62.572,
   "end": 63.682,
   "id": "c29"
  },
  {
   "text": "搜索者在打包前看不到它",
   "start": 63.774,
   "end": 65.813,
   "id": "c30"
  },
  {
   "text": "顺序可以被买",
   "start": 66.816,
   "end": 68.01,
   "id": "c31"
  },
  {
   "text": "签名可以被重放",
   "start": 68.03,
   "end": 69.45,
   "id": "c32"
  },
  {
   "text": "签之前看清内容",
   "start": 70.42,
   "end": 71.982,
   "id": "c33"
  },
  {
   "text": "发之前想好",
   "start": 72.062,
   "end": 73.161,
   "id": "c34"
  },
  {
   "text": "谁会先看到它",
   "start": 73.336,
   "end": 74.566,
   "id": "c35"
  },
  {
   "text": "下一集讲可升级合约与代理",
   "start": 75.56,
   "end": 78.122,
   "id": "c36"
  }
 ]
