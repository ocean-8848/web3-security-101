 "lines": [
  {
   "id": "seg2-00",
   "text": "先给准确的说法。",
   "spoken": "先给准确的说法。",
   "src": "/Users/k/Workon/Learning/web3/web3-security-101/Web3-Security/video/skeuo/ep23/audio/lines/seg2-00.mp3",
   "start": 1.6,
   "dur": 2.232,
   "speechStart": 1.698,
   "speechEnd": 2.983
  },
  {
   "id": "seg2-01",
   "text": "交易所同时扮演两个角色。",
   "spoken": "交易所同时扮演两个决色。",
   "src": "/Users/k/Workon/Learning/web3/web3-security-101/Web3-Security/video/skeuo/ep23/audio/lines/seg2-01.mp3",
   "start": 4.052,
   "dur": 2.928,
   "speechStart": 4.15,
   "speechEnd": 6.15
  },
  {
   "id": "seg2-02",
   "text": "一个是保管者，替用户保管私钥和资产，这叫托管。",
   "spoken": "一个是保管者，替用户保管私钥和资产，这叫托管。",
   "src": "/Users/k/Workon/Learning/web3/web3-security-101/Web3-Security/video/skeuo/ep23/audio/lines/seg2-02.mp3",
   "start": 7.2,
   "dur": 4.992,
   "speechStart": 7.298,
   "speechEnd": 11.357
  },
  {
   "id": "seg2-03",
   "text": "另一个是检查站，链上的资金，从这里进出法币世界。",
   "spoken": "另一个是检查站，链上的资金，从这里进出法币世界。",
   "src": "/Users/k/Workon/Learning/web3/web3-security-101/Web3-Security/video/skeuo/ep23/audio/lines/seg2-03.mp3",
   "start": 12.412,
   "dur": 4.872,
   "speechStart": 12.51,
   "speechEnd": 16.45
  },
  {
   "id": "seg2-04",
   "text": "保管者失误，用户丢钱。",
   "spoken": "保管者失误，用户丢钱。",
   "src": "/Users/k/Workon/Learning/web3/web3-security-101/Web3-Security/video/skeuo/ep23/audio/lines/seg2-04.mp3",
   "start": 17.504,
   "dur": 3.024,
   "speechStart": 17.602,
   "speechEnd": 19.697
  },
  {
   "id": "seg2-05",
   "text": "检查站失误，赃款被洗白，交易所自己也要承担法律责任。",
   "spoken": "检查站失误，赃款被洗白，交易所自己也要承担法律责任。",
   "src": "/Users/k/Workon/Learning/web3/web3-security-101/Web3-Security/video/skeuo/ep23/audio/lines/seg2-05.mp3",
   "start": 20.748,
   "dur": 5.76,
   "speechStart": 20.846,
   "speechEnd": 25.667
  },
  {
   "id": "seg2-06",
   "text": "打个比方，交易所像一座机场。",
   "spoken": "打个比方，交易所像一座机场。",
   "src": "/Users/k/Workon/Learning/web3/web3-security-101/Web3-Security/video/skeuo/ep23/audio/lines/seg2-06.mp3",
   "start": 26.728,
   "dur": 3.192,
   "speechStart": 26.826,
   "speechEnd": 29.076
  },
  {
   "id": "seg2-07",
   "text": "金库是冷钱包，要防盗。",
   "spoken": "金库是冷钱包，要防盗。",
   "src": "/Users/k/Workon/Learning/web3/web3-security-101/Web3-Security/video/skeuo/ep23/audio/lines/seg2-07.mp3",
   "start": 30.14,
   "dur": 3.048,
   "speechStart": 30.238,
   "speechEnd": 32.357
  },
  {
   "id": "seg2-08",
   "text": "登机口是提币，要验票，入境口是充值，要验真伪。",
   "spoken": "登机口是提币，要验票，入境口是充值，要验真伪。",
   "src": "/Users/k/Workon/Learning/web3/web3-security-101/Web3-Security/video/skeuo/ep23/audio/lines/seg2-08.mp3",
   "start": 33.408,
   "dur": 5.712,
   "speechStart": 33.506,
   "speechEnd": 38.268
  },
  {
   "id": "seg2-09",
   "text": "安检是反洗钱，边检是制裁筛查，拦住名单上的人。",
   "spoken": "安检是反洗钱，边检是制裁筛查，拦住名单上的人。",
   "src": "/Users/k/Workon/Learning/web3/web3-security-101/Web3-Security/video/skeuo/ep23/audio/lines/seg2-09.mp3",
   "start": 39.34,
   "dur": 5.352,
   "speechStart": 39.438,
   "speechEnd": 43.854
  },
  {
   "id": "seg2-10",
   "text": "比喻在这里不成立，机场的旅客，走了就走了。",
   "spoken": "比喻在这里不成立，机场的旅客，走了就走了。",
   "src": "/Users/k/Workon/Learning/web3/web3-security-101/Web3-Security/video/skeuo/ep23/audio/lines/seg2-10.mp3",
   "start": 44.912,
   "dur": 4.368,
   "speechStart": 45.01,
   "speechEnd": 48.45
  },
  {
   "id": "seg2-11",
   "text": "链上的资金流向永久公开，执法机构几年以后，还能回头追查每一笔。",
   "spoken": "链上的资金流向永久公开，执法机构几年以后，还能回头追查每一笔。",
   "src": "/Users/k/Workon/Learning/web3/web3-security-101/Web3-Security/video/skeuo/ep23/audio/lines/seg2-11.mp3",
   "start": 49.5,
   "dur": 6.168,
   "speechStart": 49.598,
   "speechEnd": 54.836
  },
  {
   "id": "seg2-12",
   "text": "先看保管者这一面，钱在交易所里怎么流动。",
   "spoken": "先看保管者这一面，钱在交易所里怎么流动。",
   "src": "/Users/k/Workon/Learning/web3/web3-security-101/Web3-Security/video/skeuo/ep23/audio/lines/seg2-12.mp3",
   "start": 55.888,
   "dur": 4.104,
   "speechStart": 55.986,
   "speechEnd": 59.14
  },
  {
   "id": "seg2-13",
   "text": "每个用户有自己的充值地址，钱到了，被归集到热钱包。",
   "spoken": "每个用户有自己的充值地址，钱到了，被归集到热钱包。",
   "src": "/Users/k/Workon/Learning/web3/web3-security-101/Web3-Security/video/skeuo/ep23/audio/lines/seg2-13.mp3",
   "start": 60.212,
   "dur": 5.544,
   "speechStart": 60.31,
   "speechEnd": 64.905
  },
  {
   "id": "seg2-14",
   "text": "热钱包负责日常提币，余额超出水位，多出来的转回冷钱包。",
   "spoken": "热钱包负责日常提币，余额超出水位，多出来的转回冷钱包。",
   "src": "/Users/k/Workon/Learning/web3/web3-security-101/Web3-Security/video/skeuo/ep23/audio/lines/seg2-14.mp3",
   "start": 65.976,
   "dur": 5.592,
   "speechStart": 66.074,
   "speechEnd": 70.728
  },
  {
   "id": "seg2-15",
   "text": "冷钱包补充温钱包，温钱包再补充热钱包。",
   "spoken": "冷钱包补充温钱包，温钱包再补充热钱包。",
   "src": "/Users/k/Workon/Learning/web3/web3-security-101/Web3-Security/video/skeuo/ep23/audio/lines/seg2-15.mp3",
   "start": 71.788,
   "dur": 4.368,
   "speechStart": 71.886,
   "speechEnd": 75.314
  },
  {
   "id": "seg2-16",
   "text": "链下还有一条流水线。",
   "spoken": "链下还有一条流水线。",
   "src": "/Users/k/Workon/Learning/web3/web3-security-101/Web3-Security/video/skeuo/ep23/audio/lines/seg2-16.mp3",
   "start": 76.376,
   "dur": 2.664,
   "speechStart": 76.474,
   "speechEnd": 78.2
  },
  {
   "id": "seg2-17",
   "text": "充值扫描服务读取链上数据，记进内部账本。",
   "spoken": "充值扫描服务读取链上数据，记进内部账本。",
   "src": "/Users/k/Workon/Learning/web3/web3-security-101/Web3-Security/video/skeuo/ep23/audio/lines/seg2-17.mp3",
   "start": 79.26,
   "dur": 4.44,
   "speechStart": 79.358,
   "speechEnd": 82.87
  },
  {
   "id": "seg2-18",
   "text": "提币请求从账本出发，经过风控引擎，再到签名服务，最后从热钱包发出。",
   "spoken": "提币请求从账本出发，经过风控引擎，再到签名服务，最后从热钱包发出。",
   "src": "/Users/k/Workon/Learning/web3/web3-security-101/Web3-Security/video/skeuo/ep23/audio/lines/seg2-18.mp3",
   "start": 83.92,
   "dur": 7.152,
   "speechStart": 84.018,
   "speechEnd": 90.232
  },
  {
   "id": "seg2-19",
   "text": "攻击打在四个点上。",
   "spoken": "攻击打在四个点上。",
   "src": "/Users/k/Workon/Learning/web3/web3-security-101/Web3-Security/video/skeuo/ep23/audio/lines/seg2-19.mp3",
   "start": 91.292,
   "dur": 2.28,
   "speechStart": 91.39,
   "speechEnd": 92.735
  },
  {
   "id": "seg2-20",
   "text": "充值扫描，被假充值骗过。",
   "spoken": "充值扫描，被假充值骗过。",
   "src": "/Users/k/Workon/Learning/web3/web3-security-101/Web3-Security/video/skeuo/ep23/audio/lines/seg2-20.mp3",
   "start": 93.792,
   "dur": 3.336,
   "speechStart": 93.89,
   "speechEnd": 96.318
  },
  {
   "id": "seg2-21",
   "text": "账本，被盗来的用户账号拿去提币。",
   "spoken": "账本，被盗来的用户账号拿去提币。",
   "src": "/Users/k/Workon/Learning/web3/web3-security-101/Web3-Security/video/skeuo/ep23/audio/lines/seg2-21.mp3",
   "start": 97.348,
   "dur": 4.008,
   "speechStart": 97.446,
   "speechEnd": 100.517
  },
  {
   "id": "seg2-22",
   "text": "签名服务，被伪造的上游请求驱动。",
   "spoken": "签名服务，被伪造的上游请求驱动。",
   "src": "/Users/k/Workon/Learning/web3/web3-security-101/Web3-Security/video/skeuo/ep23/audio/lines/seg2-22.mp3",
   "start": 101.576,
   "dur": 3.936,
   "speechStart": 101.674,
   "speechEnd": 104.674
  },
  {
   "id": "seg2-23",
   "text": "热钱包，私钥泄露。",
   "spoken": "热钱包，私钥泄漏。",
   "src": "/Users/k/Workon/Learning/web3/web3-security-101/Web3-Security/video/skeuo/ep23/audio/lines/seg2-23.mp3",
   "start": 105.732,
   "dur": 2.496,
   "speechStart": 105.83,
   "speechEnd": 107.377
  },
  {
   "id": "seg2-24",
   "text": "图里没画的还有内部人，他可以同时出现在这四个点上。",
   "spoken": "图里没画的还有内部人，他可以同时出现在这四个点上。",
