   "text": "替用户保管私钥和资产",
   "start": 8.545,
   "end": 10.537,
   "id": "c3"
  },
  {
   "text": "这叫托管",
   "start": 10.629,
   "end": 11.477,
   "id": "c4"
  },
  {
   "text": "另一个是检查站",
   "start": 12.46,
   "end": 13.701,
   "id": "c5"
  },
  {
   "text": "链上的资金",
   "start": 13.745,
   "end": 14.82,
   "id": "c6"
  },
  {
   "text": "从这里进出法币世界",
   "start": 14.864,
   "end": 16.57,
   "id": "c7"
  },
  {
   "text": "保管者失误",
   "start": 17.552,
   "end": 18.662,
   "id": "c8"
  },
  {
   "text": "用户丢钱",
   "start": 18.802,
   "end": 19.817,
   "id": "c9"
  },
  {
   "text": "检查站失误",
   "start": 20.796,
   "end": 21.954,
   "id": "c10"
  },
  {
   "text": "赃款被洗白",
   "start": 22.093,
   "end": 23.299,
   "id": "c11"
  },
  {
   "text": "交易所自己也要承担法律责任",
   "start": 23.379,
   "end": 25.787,
   "id": "c12"
  },
  {
   "text": "打个比方",
   "start": 26.776,
   "end": 27.719,
   "id": "c13"
  },
  {
   "text": "交易所像一座机场",
   "start": 27.752,
   "end": 29.196,
   "id": "c14"
  },
  {
   "text": "金库是冷钱包 要防盗",
   "start": 30.188,
   "end": 32.477,
   "id": "c15"
  },
  {
   "text": "登机口是提币 要验票",
   "start": 33.456,
   "end": 35.852,
   "id": "c16"
  },
  {
   "text": "入境口是充值",
   "start": 36.027,
   "end": 37.435,
   "id": "c17"
  },
  {
   "text": "要验真伪",
   "start": 37.491,
   "end": 38.388,
   "id": "c18"
  },
  {
   "text": "安检是反洗钱",
   "start": 39.388,
   "end": 40.867,
   "id": "c19"
  },
  {
   "text": "边检是制裁筛查",
   "start": 41.042,
   "end": 42.7,
   "id": "c20"
  },
  {
   "text": "拦住名单上的人",
   "start": 42.757,
   "end": 43.974,
   "id": "c21"
  },
  {
   "text": "比喻在这里不成立",
   "start": 44.96,
   "end": 46.356,
   "id": "c22"
  },
  {
   "text": "机场的旅客",
   "start": 46.507,
   "end": 47.582,
   "id": "c23"
  },
  {
   "text": "走了就走了",
   "start": 47.662,
   "end": 48.57,
   "id": "c24"
  },
  {
   "text": "链上的资金流向永久公开",
   "start": 49.548,
   "end": 51.67,
   "id": "c25"
  },
  {
   "text": "执法机构几年以后",
   "start": 51.881,
   "end": 53.349,
   "id": "c26"
  },
  {
   "text": "还能回头追查每一笔",
   "start": 53.369,
   "end": 54.956,
   "id": "c27"
  },
  {
   "text": "先看保管者这一面",
   "start": 55.936,
   "end": 57.522,
   "id": "c28"
  },
  {
   "text": "钱在交易所里怎么流动",
   "start": 57.662,
   "end": 59.26,
   "id": "c29"
  },
  {
   "text": "每个用户有自己的充值地址 钱到了",
   "start": 60.26,
   "end": 63.703,
   "id": "c30"
  },
  {
   "text": "被归集到热钱包",
   "start": 63.724,
   "end": 65.025,
   "id": "c31"
  },
  {
   "text": "热钱包负责日常提币",
   "start": 66.024,
   "end": 67.765,
   "id": "c32"
  },
  {
   "text": "余额超出水位",
   "start": 67.988,
   "end": 69.241,
   "id": "c33"
  },
  {
   "text": "多出来的转回冷钱包",
   "start": 69.321,
   "end": 70.848,
   "id": "c34"
  },
  {
   "text": "冷钱包补充温钱包",
   "start": 71.836,
   "end": 73.434,
   "id": "c35"
  },
  {
   "text": "温钱包再补充热钱包",
   "start": 73.621,
   "end": 75.434,
   "id": "c36"
  },
  {
   "text": "链下还有一条流水线",
   "start": 76.424,
   "end": 78.32,
   "id": "c37"
  },
  {
   "text": "充值扫描服务读取链上数据",
   "start": 79.308,
   "end": 81.668,
   "id": "c38"
  },
  {
   "text": "记进内部账本",
   "start": 81.772,
   "end": 82.99,
   "id": "c39"
  },
  {
   "text": "提币请求从账本出发",
   "start": 83.968,
   "end": 85.911,
   "id": "c40"
  },
  {
   "text": "经过风控引擎",
   "start": 86.039,
   "end": 87.436,
   "id": "c41"
  },
  {
   "text": "再到签名服务",
   "start": 87.456,
   "end": 88.721,
   "id": "c42"
  },
  {
   "text": "最后从热钱包发出",
   "start": 88.789,
   "end": 90.352,
   "id": "c43"
  },
  {
   "text": "攻击打在四个点上",
   "start": 91.34,
   "end": 92.855,
   "id": "c44"
  },
  {
   "text": "充值扫描",
   "start": 93.84,
   "end": 94.938,
   "id": "c45"
  },
  {
   "text": "被假充值骗过",
   "start": 94.971,
   "end": 96.438,
   "id": "c46"
  },
  {
   "text": "账本 被盗来的用户账号拿去提币",
   "start": 97.396,
   "end": 100.637,
   "id": "c47"
  },
  {
   "text": "签名服务",
   "start": 101.624,
   "end": 102.663,
   "id": "c48"
  },
  {
   "text": "被伪造的上游请求驱动",
   "start": 102.719,
   "end": 104.794,
   "id": "c49"
  },
  {
   "text": "热钱包 私钥泄露",
   "start": 105.78,
   "end": 107.497,
   "id": "c50"
  },
  {
   "text": "图里没画的还有内部人",
   "start": 108.496,
   "end": 110.654,
   "id": "c51"
  },
  {
   "text": "他可以同时出现在这四个点上",
   "start": 110.865,
   "end": 112.856,
   "id": "c52"
  }
 ]
}