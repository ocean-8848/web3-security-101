 "captions": [
  {
   "text": "再看提币这一头",
   "start": 1.55,
   "end": 3.099,
   "id": "c0"
  },
  {
   "text": "最要紧的是签名服务",
   "start": 3.33,
   "end": 5.391,
   "id": "c1"
  },
  {
   "text": "签名服务只认请求的格式对不对",
   "start": 5.69,
   "end": 8.103,
   "id": "c2"
  },
  {
   "text": "攻击者如果能伪造上游数据",
   "start": 8.403,
   "end": 10.617,
   "id": "c3"
  },
  {
   "text": "它就会按正常流程",
   "start": 10.843,
   "end": 12.408,
   "id": "c4"
  },
  {
   "text": "签出攻击交易",
   "start": 12.505,
   "end": 13.78,
   "id": "c5"
  },
  {
   "text": "2026 年 9 月",
   "start": 14.076,
   "end": 15.422,
   "id": "c6"
  },
  {
   "text": "Bitget 被盗约 3.875 亿美元",
   "start": 15.544,
   "end": 18.712,
   "id": "c7"
  },
  {
   "text": "公开报道称",
   "start": 19.005,
   "end": 19.916,
   "id": "c8"
  },
  {
   "text": "攻击者利用第三方安全产品的零日漏洞",
   "start": 20.199,
   "end": 23.473,
   "id": "c9"
  },
  {
   "text": "拿到了内部高权限凭证",
   "start": 23.668,
   "end": 25.631,
   "id": "c10"
  },
  {
   "text": "再向钱包后台",
   "start": 25.93,
   "end": 27.418,
   "id": "c11"
  },
  {
   "text": "插入伪造的提现指令",
   "start": 27.557,
   "end": 29.474,
   "id": "c12"
  },
  {
   "text": "项目方称",
   "start": 29.67,
   "end": 30.522,
   "id": "c13"
  },
  {
   "text": "已经排除了私钥泄露",
   "start": 30.56,
   "end": 32.377,
   "id": "c14"
  },
  {
   "text": "一个月后",
   "start": 32.704,
   "end": 33.407,
   "id": "c15"
  },
  {
   "text": "Binance 出事",
   "start": 33.502,
   "end": 34.487,
   "id": "c16"
  },
  {
   "text": "按它的初步报告",
   "start": 34.679,
   "end": 36.126,
   "id": "c17"
  },
  {
   "text": "路径是这样的",
   "start": 36.229,
   "end": 37.2,
   "id": "c18"
  },
  {
   "text": "6 月 一名工程师下载了被篡改的 Homebrew",
   "start": 37.561,
   "end": 41.085,
   "id": "c19"
  },
  {
   "text": "那一次已被发现并处置",
   "start": 41.37,
   "end": 43.408,
   "id": "c20"
  },
  {
   "text": "报告没有确认之后一直有访问",
   "start": 43.569,
   "end": 46.065,
   "id": "c21"
  },
  {
   "text": "9 月 另一名工程师运行了一份假的面试作业",
   "start": 46.31,
   "end": 50.235,
   "id": "c22"
  },
  {
   "text": "10 月 20 日",
   "start": 50.53,
   "end": 51.433,
   "id": "c23"
  },
  {
   "text": "攻击者经过这台电脑和内部 AI 工具",
   "start": 51.566,
   "end": 54.477,
   "id": "c24"
  },
  {
   "text": "又控制了另外两台电脑",
   "start": 54.684,
   "end": 56.327,
   "id": "c25"
  },
  {
   "text": "其中一台上",
   "start": 56.59,
   "end": 57.594,
   "id": "c26"
  },
  {
   "text": "存着容器部署令牌",
   "start": 57.852,
   "end": 59.71,
   "id": "c27"
  },
  {
   "text": "10 月 29 日",
   "start": 59.93,
   "end": 61.345,
   "id": "c28"
  },
  {
   "text": "攻击者用它部署容器",
   "start": 61.488,
   "end": 63.511,
   "id": "c29"
  },
  {
   "text": "运行恶意脚本",
   "start": 63.716,
   "end": 65.046,
   "id": "c30"
  },
  {
   "text": "访问内部签名服务",
   "start": 65.13,
   "end": 66.715,
   "id": "c31"
  },
  {
   "text": "攻击者不需要私钥",
   "start": 67.044,
   "end": 68.659,
   "id": "c32"
  },
  {
   "text": "它让签名服务替它签",
   "start": 68.865,
   "end": 70.677,
   "id": "c33"
  },
  {
   "text": "以太坊上",
   "start": 71.025,
   "end": 71.803,
   "id": "c34"
  },
  {
   "text": "签出的是 EIP-7702 委托",
   "start": 71.946,
   "end": 74.422,
   "id": "c35"
  },
  {
   "text": "把热钱包账户的代码",
   "start": 74.558,
   "end": 77.177,
   "id": "c36"
  },
  {
   "text": "指向攻击者的合约",
   "start": 77.249,
   "end": 78.713,
   "id": "c37"
  },
  {
   "text": "其他链上",
   "start": 79.08,
   "end": 79.898,
   "id": "c38"
  },
  {
   "text": "就是普通的签名转账",
   "start": 80.008,
   "end": 81.614,
   "id": "c39"
  },
  {
   "text": "决定性的一环",
   "start": 81.85,
   "end": 83.224,
   "id": "c40"
  },
  {
   "text": "是开发终端上的长期部署令牌",
   "start": 83.401,
   "end": 86.024,
   "id": "c41"
  },
  {
   "text": "它把一台电脑失陷",
   "start": 86.23,
   "end": 87.908,
   "id": "c42"
  },
  {
   "text": "变成了生产环境失陷",
   "start": 88.189,
   "end": 90.204,
   "id": "c43"
  },
  {
   "text": "签名流程本身被驱动了",
   "start": 90.45,
   "end": 92.574,
   "id": "c44"
  },
  {
   "text": "冷热隔离和私钥保护",
   "start": 92.676,
   "end": 94.57,
   "id": "c45"
  },
  {
   "text": "都挡不住",
   "start": 94.728,
   "end": 95.465,
   "id": "c46"
  },
  {
   "text": "防线有三条",
   "start": 95.71,
   "end": 97.11,
   "id": "c47"
  },
  {
   "text": "签名服务独立核对",
   "start": 97.468,
   "end": 99.067,
   "id": "c48"
  },
  {
   "text": "目标地址和金额",
   "start": 99.087,
   "end": 100.624,
   "id": "c49"
  },
  {
   "text": "必须对得上账本里的提现订单",
   "start": 100.739,
   "end": 103.34,
   "id": "c50"
  },
  {
   "text": "部署令牌要短期有效",
   "start": 103.68,
   "end": 105.498,
   "id": "c51"
  },
  {
   "text": "绑定设备",
   "start": 105.518,
   "end": 106.323,
   "id": "c52"
  },
  {
   "text": "还要第二个人批准",
   "start": 106.374,
   "end": 107.748,
   "id": "c53"
  },
  {
   "text": "风控引擎和签名服务",
   "start": 107.97,
   "end": 110.036,
   "id": "c54"
  },
  {
   "text": "由不同的团队维护",
   "start": 110.152,
   "end": 111.653,
   "id": "c55"
  },
  {
   "text": "两起事件",
   "start": 111.963,
   "end": 112.84,
   "id": "c56"
  },
  {
   "text": "都还没有最终的第三方调查报告",
   "start": 112.968,
   "end": 115.574,
   "id": "c57"
  }
 ]
