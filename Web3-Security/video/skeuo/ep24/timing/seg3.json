 "captions": [
  {
   "text": "交易所的数据",
   "start": 1.648,
   "end": 2.842,
   "id": "c0"
  },
  {
   "text": "不只留在交易所里",
   "start": 2.862,
   "end": 4.21,
   "id": "c1"
  },
  {
   "text": "KYC 服务商",
   "start": 5.18,
   "end": 6.504,
   "id": "c2"
  },
  {
   "text": "工单系统",
   "start": 6.525,
   "end": 7.373,
   "id": "c3"
  },
  {
   "text": "邮件营销 物流",
   "start": 7.394,
   "end": 8.957,
   "id": "c4"
  },
  {
   "text": "破产服务",
   "start": 8.977,
   "end": 9.921,
   "id": "c5"
  },
  {
   "text": "每一家都是一个泄露点",
   "start": 10.072,
   "end": 11.731,
   "id": "c6"
  },
  {
   "text": "2020 年 6 月",
   "start": 12.72,
   "end": 13.949,
   "id": "c7"
  },
  {
   "text": "攻击者用一把第三方的 API 密钥",
   "start": 14.017,
   "end": 16.735,
   "id": "c8"
  },
  {
   "text": "进了 Ledger 的电商和营销数据库",
   "start": 16.755,
   "end": 19.199,
   "id": "c9"
  },
  {
   "text": "约 100 万个邮箱泄露",
   "start": 20.188,
   "end": 21.905,
   "id": "c10"
  },
  {
   "text": "约 27.2 万条记录带着姓名",
   "start": 22.14,
   "end": 24.703,
   "id": "c11"
  },
  {
   "text": "住址和电话",
   "start": 24.723,
   "end": 25.977,
   "id": "c12"
  },
  {
   "text": "Ledger 后来修正为",
   "start": 26.96,
   "end": 28.737,
   "id": "c13"
  },
  {
   "text": "约 29.2 万名客户",
   "start": 28.817,
   "end": 30.677,
   "id": "c14"
  },
  {
   "text": "同年 12 月",
   "start": 31.668,
   "end": 32.766,
   "id": "c15"
  },
  {
   "text": "完整的数据库",
   "start": 32.965,
   "end": 34.076,
   "id": "c16"
  },
  {
   "text": "被公开在黑客论坛上",
   "start": 34.144,
   "end": 35.897,
   "id": "c17"
  },
  {
   "text": "之后是大量钓鱼邮件和短信",
   "start": 36.88,
   "end": 39.335,
   "id": "c18"
  },
  {
   "text": "还有针对客户的威胁电话",
   "start": 39.511,
   "end": 41.431,
   "id": "c19"
  },
  {
   "text": "硬件钱包本身没有被攻破",
   "start": 42.428,
   "end": 44.538,
   "id": "c20"
  },
  {
   "text": "可谁买了硬件钱包",
   "start": 45.528,
   "end": 47.055,
   "id": "c21"
  },
  {
   "text": "寄到了哪里",
   "start": 47.099,
   "end": 48.079,
   "id": "c22"
  },
  {
   "text": "本身就是高价值的数据",
   "start": 48.266,
   "end": 49.936,
   "id": "c23"
  },
  {
   "text": "2023 年 8 月",
   "start": 50.932,
   "end": 52.173,
   "id": "c24"
  },
  {
   "text": "Kroll 一名员工的手机号",
