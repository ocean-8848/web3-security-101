   "speechStart": 83.622,
   "speechEnd": 87.276
  },
  {
   "id": "seg3-16",
   "text": "2022 年 12 月，Gemini 的一家供应商被入侵。",
   "spoken": "2022 年 12 月，Gemini 的一家公应商被入侵。",
