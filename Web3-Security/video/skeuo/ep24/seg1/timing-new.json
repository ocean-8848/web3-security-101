 "captions": [
  {
   "text": "2025 年 5 月",
   "start": 1.648,
   "end": 2.877,
   "id": "c0"
  },
  {
   "text": "一个犯罪团伙",
   "start": 2.969,
   "end": 4.092,
   "id": "c1"
  },
  {
   "text": "找上了 Coinbase 的外包客服",
   "start": 4.112,
   "end": 6.246,
   "id": "c2"
  },
  {
   "text": "他们没去撬钱包",
   "start": 7.244,
   "end": 8.497,
   "id": "c3"
  },
  {
   "text": "只是花钱",
   "start": 8.636,
   "end": 9.581,
   "id": "c4"
  },
  {
   "text": "收买了客服",
   "start": 9.601,
   "end": 10.723,
   "id": "c5"
  },
  {
   "text": "被收买的人",
   "start": 11.712,
   "end": 12.846,
   "id": "c6"
  },
  {
   "text": "从客服工具里",
   "start": 12.902,
   "end": 14.156,
   "id": "c7"
  },
  {
   "text": "导出了 69461 名用户的数据",
   "start": 14.176,
   "end": 17.001,
   "id": "c8"
  },
  {
   "text": "姓名 联系方式",
   "start": 17.98,
   "end": 19.792,
   "id": "c9"
  },
  {
   "text": "证件图像 余额",
   "start": 19.896,
   "end": 21.673,
   "id": "c10"
  },
  {
   "text": "交易记录",
   "start": 21.825,
   "end": 22.626,
   "id": "c11"
  },
  {
   "text": "可这份数据里",
   "start": 23.624,
   "end": 24.913,
   "id": "c12"
  },
  {
   "text": "没有密码",
   "start": 24.969,
   "end": 25.901,
   "id": "c13"
  },
  {
   "text": "也没有私钥",
   "start": 26.005,
   "end": 26.96,
   "id": "c14"
  },
  {
   "text": "没有钥匙 照理说",
   "start": 27.948,
   "end": 29.987,
   "id": "c15"
  },
  {
   "text": "打不开任何一个账户",
   "start": 30.079,
   "end": 31.51,
   "id": "c16"
  },
  {
   "text": "可 Coinbase 在提交给 SEC 的文件里估算",
   "start": 32.512,
   "end": 35.432,
   "id": "c17"
  },
  {
   "text": "这次事件",
   "start": 35.678,
   "end": 36.527,
   "id": "c18"
  },
  {
   "text": "要花掉约 1.8 亿到 4 亿美元",
   "start": 36.547,
   "end": 38.932,
   "id": "c19"
  },
  {
   "text": "其中一项",
   "start": 39.932,
   "end": 40.875,
   "id": "c20"
  },
  {
   "text": "是赔偿被冒充客服骗走资金的用户",
   "start": 40.967,
   "end": 43.994,
   "id": "c21"
  },
  {
   "text": "先猜一道题",
   "start": 44.976,
   "end": 46.3,
   "id": "c22"
  },
  {
   "text": "一天 你接到电话",
   "start": 47.284,
   "end": 49.18,
   "id": "c23"
  },
  {
   "text": "对方自称交易所客服",
   "start": 49.26,
   "end": 51.049,
   "id": "c24"
  },
  {
   "text": "他叫得出你的名字",
   "start": 52.016,
   "end": 53.388,
   "id": "c25"
  },
  {
   "text": "说得出你的余额",
   "start": 53.48,
   "end": 54.709,
   "id": "c26"
  },
  {
   "text": "还知道你上周提过的工单",
   "start": 54.92,
   "end": 57.126,
   "id": "c27"
  },
  {
   "text": "他说你的账户有风险",
   "start": 58.116,
   "end": 60.119,
   "id": "c28"
  },
  {
   "text": "请你把资产",
   "start": 60.318,
   "end": 61.428,
   "id": "c29"
  },
  {
   "text": "转到一个安全钱包",
   "start": 61.461,
   "end": 62.857,
   "id": "c30"
  },
  {
   "text": "他是真客服吗",
   "start": 63.856,
   "end": 65.133,
   "id": "c31"
  },
  {
   "text": "带着这个问题",
   "start": 66.396,
   "end": 67.554,
   "id": "c32"
  },
  {
   "text": "我们看看",
   "start": 67.658,
   "end": 68.47,
   "id": "c33"
  },
  {
   "text": "泄露的数据怎样变成攻击",
