 "captions": [
  {
   "text": "2025 年 5 月",
   "start": 1.55,
   "end": 3.255,
   "id": "c0"
  },
  {
   "text": "一个犯罪团伙",
   "start": 3.501,
   "end": 5.015,
   "id": "c1"
  },
  {
   "text": "找上了 Coinbase 的外包客服",
   "start": 5.116,
   "end": 7.568,
   "id": "c2"
  },
  {
   "text": "他们没去撬钱包",
   "start": 7.85,
   "end": 9.38,
   "id": "c3"
  },
  {
   "text": "只是花钱",
   "start": 9.717,
   "end": 10.577,
   "id": "c4"
  },
  {
   "text": "收买了客服",
   "start": 10.597,
   "end": 11.752,
   "id": "c5"
  },
  {
   "text": "被收买的人",
   "start": 12.082,
   "end": 13.183,
   "id": "c6"
  },
  {
   "text": "从客服工具里",
   "start": 13.352,
   "end": 14.622,
   "id": "c7"
  },
  {
   "text": "导出了 69461 名用户的数据",
   "start": 14.736,
   "end": 18.471,
   "id": "c8"
  },
  {
   "text": "姓名 联系方式",
   "start": 18.77,
   "end": 20.626,
   "id": "c9"
  },
  {
   "text": "证件图像 余额",
   "start": 20.863,
   "end": 22.669,
   "id": "c10"
  },
  {
   "text": "交易记录",
   "start": 22.892,
   "end": 23.688,
   "id": "c11"
  },
  {
   "text": "可这份数据里",
   "start": 23.95,
   "end": 25.22,
   "id": "c12"
  },
  {
   "text": "没有密码",
   "start": 25.4,
   "end": 26.271,
   "id": "c13"
  },
  {
   "text": "也没有私钥",
   "start": 26.366,
   "end": 27.312,
   "id": "c14"
  },
  {
   "text": "没有钥匙 照理说",
   "start": 27.626,
   "end": 29.585,
   "id": "c15"
  },
  {
   "text": "打不开任何一个账户",
   "start": 29.605,
   "end": 32.319,
   "id": "c16"
  },
  {
   "text": "可 Coinbase 在提交给 SEC 的文件里估算",
   "start": 32.63,
   "end": 36.389,
   "id": "c17"
  },
  {
   "text": "这次事件",
   "start": 36.913,
   "end": 37.777,
   "id": "c18"
  },
  {
   "text": "要花掉约 1.8 亿到 4 亿美元",
   "start": 37.922,
   "end": 40.895,
   "id": "c19"
  },
  {
   "text": "其中一项",
   "start": 41.17,
   "end": 41.967,
   "id": "c20"
  },
  {
   "text": "是赔偿被冒充客服骗走资金的用户",
   "start": 42.139,
   "end": 45.278,
   "id": "c21"
  },
  {
   "text": "先猜一道题",
   "start": 45.55,
   "end": 46.521,
   "id": "c22"
  },
  {
   "text": "一天 你接到电话",
   "start": 46.908,
   "end": 49.02,
   "id": "c23"
  },
  {
   "text": "对方自称交易所客服",
   "start": 49.322,
   "end": 51.409,
   "id": "c24"
  },
  {
   "text": "他叫得出你的名字",
   "start": 51.762,
   "end": 53.188,
   "id": "c25"
  },
  {
   "text": "说得出你的余额",
   "start": 53.31,
   "end": 54.685,
   "id": "c26"
  },
  {
   "text": "还知道你上周提过的工单",
   "start": 54.795,
   "end": 57.065,
   "id": "c27"
  },
  {
   "text": "他说你的账户有风险",
   "start": 57.33,
   "end": 59.31,
   "id": "c28"
  },
  {
   "text": "请你把资产",
   "start": 59.392,
   "end": 60.506,
   "id": "c29"
  },
  {
   "text": "转到一个安全钱包",
   "start": 60.623,
   "end": 62.082,
   "id": "c30"
  },
  {
   "text": "他是真客服吗",
   "start": 62.444,
   "end": 63.752,
   "id": "c31"
  },
  {
   "text": "带着这个问题",
   "start": 64.29,
   "end": 65.302,
   "id": "c32"
  },
  {
   "text": "我们看看",
   "start": 65.458,
   "end": 66.088,
   "id": "c33"
  },
  {
   "text": "泄露的数据怎样变成攻击",
   "start": 66.292,
   "end": 68.549,
   "id": "c34"
  }
 ]
