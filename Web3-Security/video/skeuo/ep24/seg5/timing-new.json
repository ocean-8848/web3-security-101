 "captions": [
  {
   "text": "防守从源头开始",
   "start": 1.648,
   "end": 3.341,
   "id": "c0"
  },
  {
   "text": "数据最小化",
   "start": 3.374,
   "end": 4.675,
   "id": "c1"
  },
  {
   "text": "只收集业务和合规必需的数据",
   "start": 5.66,
   "end": 8.056,
   "id": "c2"
  },
  {
   "text": "写清每类数据保存多久",
   "start": 8.112,
   "end": 10.139,
   "id": "c3"
  },
  {
   "text": "客服后台默认遮蔽敏感字段 证件号",
   "start": 11.112,
   "end": 14.448,
   "id": "c4"
  },
  {
   "text": "完整住址",
   "start": 14.54,
   "end": 15.591,
   "id": "c5"
  },
  {
   "text": "完整余额",
   "start": 15.647,
   "end": 16.651,
   "id": "c6"
  },
  {
   "text": "需要看 就逐条申请",
   "start": 17.62,
   "end": 19.718,
   "id": "c7"
  },
  {
   "text": "写明原因",
   "start": 19.989,
   "end": 20.933,
   "id": "c8"
  },
  {
   "text": "客服只能查当前工单对应的用户",
   "start": 21.92,
   "end": 24.268,
   "id": "c9"
  },
  {
   "text": "不能任意搜索",
   "start": 24.289,
   "end": 25.399,
   "id": "c10"
  },
  {
   "text": "导出默认关闭",
   "start": 26.388,
   "end": 27.677,
   "id": "c11"
  },
  {
   "text": "开启要审批",
   "start": 27.78,
   "end": 28.927,
   "id": "c12"
  },
  {
   "text": "还要带水印",
   "start": 28.983,
   "end": 29.962,
   "id": "c13"
  },
  {
   "text": "每一次敏感查询都留痕",
   "start": 30.952,
   "end": 32.991,
   "id": "c14"
  },
  {
   "text": "记下查询人 时间",
   "start": 33.202,
   "end": 35.063,
   "id": "c15"
  },
  {
   "text": "对象和理由",
   "start": 35.083,
   "end": 36.264,
   "id": "c16"
  },
  {
   "text": "单人查询量突增",
   "start": 37.244,
   "end": 38.628,
   "id": "c17"
  },
  {
   "text": "查询和工单无关的用户",
   "start": 38.708,
   "end": 40.485,
   "id": "c18"
  },
  {
   "text": "非工作时间查询",
   "start": 40.613,
   "end": 42.009,
   "id": "c19"
  },
  {
   "text": "自动告警",
   "start": 42.029,
   "end": 42.854,
   "id": "c20"
  },
  {
   "text": "客服终端禁止截屏和外接存储",
   "start": 43.848,
   "end": 46.649,
   "id": "c21"
  },
  {
   "text": "外包客服用公司管理的设备",
   "start": 46.883,
   "end": 48.887,
   "id": "c22"
  },
  {
   "text": "第三方签约前做安全尽调",
   "start": 49.876,
   "end": 52.26,
   "id": "c23"
  },
  {
   "text": "合同写明用途",
   "start": 52.423,
   "end": 53.713,
   "id": "c24"
  },
  {
   "text": "保存期限",
   "start": 53.733,
   "end": 54.688,
   "id": "c25"
  },
  {
   "text": "泄露通知时限和审计权",
   "start": 54.792,
   "end": 57.129,
   "id": "c26"
  },
  {
   "text": "能给脱敏数据的",
   "start": 58.112,
   "end": 59.508,
   "id": "c27"
  },
  {
   "text": "不给原始数据",
   "start": 59.528,
   "end": 60.746,
   "id": "c28"
  },
  {
   "text": "业务结束",
   "start": 60.921,
   "end": 61.913,
   "id": "c29"
  },
  {
   "text": "确认数据已经删除",
   "start": 62.016,
   "end": 63.853,
   "id": "c30"
  },
  {
   "text": "万一泄露",
   "start": 64.836,
   "end": 65.72,
   "id": "c31"
  },
  {
   "text": "先确认范围",
   "start": 65.848,
   "end": 67.018,
   "id": "c32"
  },
  {
   "text": "按法规时限通知监管和用户",
   "start": 67.133,
   "end": 69.803,
   "id": "c33"
  },
  {
   "text": "告诉用户",
   "start": 70.792,
   "end": 71.712,
   "id": "c34"
  },
  {
   "text": "攻击者可能怎么联系他们",
   "start": 71.899,
   "end": 73.64,
   "id": "c35"
  },
  {
   "text": "交易所永远不会做什么",
   "start": 73.684,
   "end": 75.366,
   "id": "c36"
  },
  {
   "text": "受影响的用户",
   "start": 76.364,
   "end": 77.665,
   "id": "c37"
  },
  {
   "text": "加上提币冷却和异常登录拦截",
   "start": 77.78,
   "end": 80.593,
   "id": "c38"
  },
  {
   "text": "再盯住暗网上的数据售卖",
   "start": 80.614,
   "end": 82.581,
   "id": "c39"
  },
  {
   "text": "还有一类数据",
   "start": 83.568,
   "end": 84.714,
   "id": "c40"
  },
  {
   "text": "写上链就很难删掉",
   "start": 84.853,
   "end": 86.726,
   "id": "c41"
  },
  {
   "text": "比如合约里不存邮箱原文",
   "start": 87.724,
   "end": 90.179,
   "id": "c42"
  },
  {
   "text": "只存邮箱的哈希",
   "start": 90.259,
   "end": 91.667,
   "id": "c43"
  },
  {
   "text": "可邮箱的取值范围有限",
   "start": 92.648,
   "end": 94.365,
   "id": "c44"
  },
  {
   "text": "攻击者拿常见邮箱逐个算哈希",
   "start": 94.54,
   "end": 97.163,
   "id": "c45"
  },
  {
   "text": "一比对就能对上",
   "start": 97.267,
   "end": 98.46,
   "id": "c46"
  },
  {
   "text": "欧洲数据保护委员会 EDPB 认为 不加盐",
   "start": 99.444,
   "end": 103.221,
   "id": "c47"
  },
  {
   "text": "不带密钥的哈希",
   "start": 103.241,
   "end": 104.423,
   "id": "c48"
  },
  {
   "text": "放在公链上通常不够",
   "start": 104.456,
   "end": 106.268,
   "id": "c49"
  },
  {
   "text": "哈希本身",
   "start": 107.248,
   "end": 108.251,
   "id": "c50"
  },
  {
   "text": "也算个人数据",
   "start": 108.343,
   "end": 109.346,
   "id": "c51"
  },
  {
   "text": "更稳的做法",
   "start": 110.348,
   "end": 111.399,
   "id": "c52"
  },
  {
   "text": "是先拼上一段 32 字节的随机盐",
   "start": 111.431,
   "end": 113.839,
   "id": "c53"
  },
  {
   "text": "再算哈希",
   "start": 113.943,
   "end": 114.934,
   "id": "c54"
  },
  {
   "text": "链上只存这个承诺",
   "start": 115.014,
   "end": 116.577,
   "id": "c55"
  },
  {
   "text": "盐和原文存在链下可以删除的系统里 删掉盐",
   "start": 117.576,
   "end": 121.615,
   "id": "c56"
  },
  {
   "text": "链上的承诺就关联不到这个人",
   "start": 121.683,
   "end": 124.079,
   "id": "c57"
  },
  {
   "text": "加密上链再销毁密钥",
   "start": 125.044,
   "end": 127.047,
   "id": "c58"
  },
  {
   "text": "也不等于数据消失",
   "start": 127.198,
   "end": 128.571,
   "id": "c59"
  },
  {
   "text": "密文还留在每个节点里",
   "start": 128.627,
   "end": 130.392,
   "id": "c60"
  }
 ]
}