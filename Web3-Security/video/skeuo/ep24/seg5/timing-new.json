 "lines": [
  {
   "id": "seg5-00",
   "text": "防守从源头开始，数据最小化。",
   "spoken": "防守从源头开始，数据最小化。",
   "src": "/Users/k/Workon/Learning/web3/web3-security-101/Web3-Security/video/skeuo/ep24/audio/lines/seg5-00.mp3",
   "start": 1.6,
   "dur": 3.792,
   "speechStart": 1.698,
   "speechEnd": 4.555
  },
  {
   "id": "seg5-01",
   "text": "只收集业务和合规必需的数据，写清每类数据保存多久。",
   "spoken": "只收集业务和合规必需的数据，写清每类数据保存多久。",
   "src": "/Users/k/Workon/Learning/web3/web3-security-101/Web3-Security/video/skeuo/ep24/audio/lines/seg5-01.mp3",
   "start": 5.612,
   "dur": 5.232,
   "speechStart": 5.71,
   "speechEnd": 10.019
  },
  {
   "id": "seg5-02",
   "text": "客服后台默认遮蔽敏感字段，证件号、完整住址、完整余额。",
   "spoken": "客服后台默认遮蔽敏感字段，证件号、完整住址、完整余额。",
   "src": "/Users/k/Workon/Learning/web3/web3-security-101/Web3-Security/video/skeuo/ep24/audio/lines/seg5-02.mp3",
   "start": 11.064,
   "dur": 6.288,
   "speechStart": 11.162,
   "speechEnd": 16.531
  },
  {
   "id": "seg5-03",
   "text": "需要看，就逐条申请，写明原因。",
   "spoken": "需要看，就逐条申请，写明原因。",
   "src": "/Users/k/Workon/Learning/web3/web3-security-101/Web3-Security/video/skeuo/ep24/audio/lines/seg5-03.mp3",
   "start": 17.572,
   "dur": 4.08,
   "speechStart": 17.67,
   "speechEnd": 20.812
  },
  {
   "id": "seg5-04",
   "text": "客服只能查当前工单对应的用户，不能任意搜索。",
   "spoken": "客服只能查当前工单对应的用户，不能任意搜索。",
   "src": "/Users/k/Workon/Learning/web3/web3-security-101/Web3-Security/video/skeuo/ep24/audio/lines/seg5-04.mp3",
   "start": 21.872,
   "dur": 4.248,
   "speechStart": 21.97,
   "speechEnd": 25.279
  },
  {
   "id": "seg5-05",
   "text": "导出默认关闭，开启要审批，还要带水印。",
   "spoken": "导出默认关闭，开启要审批，还要带水印。",
   "src": "/Users/k/Workon/Learning/web3/web3-security-101/Web3-Security/video/skeuo/ep24/audio/lines/seg5-05.mp3",
   "start": 26.34,
   "dur": 4.344,
   "speechStart": 26.438,
   "speechEnd": 29.842
  },
  {
   "id": "seg5-06",
   "text": "每一次敏感查询都留痕，记下查询人、时间、对象和理由。",
   "spoken": "每一次敏感查询都留痕，记下查询人、时间、对象和理由。",
   "src": "/Users/k/Workon/Learning/web3/web3-security-101/Web3-Security/video/skeuo/ep24/audio/lines/seg5-06.mp3",
   "start": 30.904,
   "dur": 6.072,
   "speechStart": 31.002,
   "speechEnd": 36.144
  },
  {
   "id": "seg5-07",
   "text": "单人查询量突增、查询和工单无关的用户、非工作时间查询，自动告警。",
   "spoken": "单人查询亮突增、查询和工单无关的用户、非工作时间查询，自动告警。",
   "src": "/Users/k/Workon/Learning/web3/web3-security-101/Web3-Security/video/skeuo/ep24/audio/lines/seg5-07.mp3",
   "start": 37.196,
   "dur": 6.384,
   "speechStart": 37.294,
   "speechEnd": 42.734
  },
  {
   "id": "seg5-08",
   "text": "客服终端禁止截屏和外接存储，外包客服用公司管理的设备。",
   "spoken": "客服终端禁止截屏和外接存储，外包客服用公司管理的设备。",
   "src": "/Users/k/Workon/Learning/web3/web3-security-101/Web3-Security/video/skeuo/ep24/audio/lines/seg5-08.mp3",
   "start": 43.8,
   "dur": 5.808,
   "speechStart": 43.898,
   "speechEnd": 48.767
  },
  {
   "id": "seg5-09",
   "text": "第三方签约前做安全尽调，合同写明用途、保存期限、泄露通知时限和审计权。",
   "spoken": "第三方签约前做安全尽掉，合同写明用途、保存期限、泄漏通知时限和审计权。",
   "src": "/Users/k/Workon/Learning/web3/web3-security-101/Web3-Security/video/skeuo/ep24/audio/lines/seg5-09.mp3",
   "start": 49.828,
   "dur": 8.016,
   "speechStart": 49.926,
   "speechEnd": 57.009
  },
  {
   "id": "seg5-10",
   "text": "能给脱敏数据的，不给原始数据，业务结束，确认数据已经删除。",
   "spoken": "能给脱敏数据的，不给原始数据，业务结束，确认数据已经删除。",
   "src": "/Users/k/Workon/Learning/web3/web3-security-101/Web3-Security/video/skeuo/ep24/audio/lines/seg5-10.mp3",
   "start": 58.064,
   "dur": 6.504,
   "speechStart": 58.162,
   "speechEnd": 63.733
  },
  {
   "id": "seg5-11",
   "text": "万一泄露，先确认范围，按法规时限通知监管和用户。",
   "spoken": "万一泄漏，先确认范围，按法规时限通知监管和用户。",
   "src": "/Users/k/Workon/Learning/web3/web3-security-101/Web3-Security/video/skeuo/ep24/audio/lines/seg5-11.mp3",
   "start": 64.788,
   "dur": 5.736,
   "speechStart": 64.886,
   "speechEnd": 69.683
  },
  {
   "id": "seg5-12",
   "text": "告诉用户，攻击者可能怎么联系他们，交易所永远不会做什么。",
   "spoken": "告诉用户，攻击者可能怎么联系他们，交易所永远不会做什么。",
   "src": "/Users/k/Workon/Learning/web3/web3-security-101/Web3-Security/video/skeuo/ep24/audio/lines/seg5-12.mp3",
   "start": 70.744,
   "dur": 5.352,
   "speechStart": 70.842,
   "speechEnd": 75.246
  },
  {
   "id": "seg5-13",
   "text": "受影响的用户，加上提币冷却和异常登录拦截，再盯住暗网上的数据售卖。",
   "spoken": "受影响的用户，加上提币冷却和异常登录拦截，再盯住暗网上的数据售卖。",
   "src": "/Users/k/Workon/Learning/web3/web3-security-101/Web3-Security/video/skeuo/ep24/audio/lines/seg5-13.mp3",
   "start": 76.316,
   "dur": 6.984,
   "speechStart": 76.414,
   "speechEnd": 82.461
  },
  {
   "id": "seg5-14",
   "text": "还有一类数据，写上链就很难删掉。",
   "spoken": "还有一类数据，写上链就很难删掉。",
   "src": "/Users/k/Workon/Learning/web3/web3-security-101/Web3-Security/video/skeuo/ep24/audio/lines/seg5-14.mp3",
   "start": 83.52,
   "dur": 3.936,
   "speechStart": 83.618,
   "speechEnd": 86.606
  },
  {
   "id": "seg5-15",
   "text": "比如合约里不存邮箱原文，只存邮箱的哈希。",
   "spoken": "比如合约里不存邮箱原文，只存邮箱的哈希。",
   "src": "/Users/k/Workon/Learning/web3/web3-security-101/Web3-Security/video/skeuo/ep24/audio/lines/seg5-15.mp3",
   "start": 87.676,
   "dur": 4.704,
   "speechStart": 87.774,
   "speechEnd": 91.547
  },
  {
   "id": "seg5-16",
   "text": "可邮箱的取值范围有限，攻击者拿常见邮箱逐个算哈希，一比对就能对上。",
   "spoken": "可邮箱的取值范围有限，攻击者拿常见邮箱逐个算哈希，一比对就能对上。",
   "src": "/Users/k/Workon/Learning/web3/web3-security-101/Web3-Security/video/skeuo/ep24/audio/lines/seg5-16.mp3",
   "start": 92.6,
   "dur": 6.576,
   "speechStart": 92.698,
   "speechEnd": 98.34
  },
  {
   "id": "seg5-17",
   "text": "欧洲数据保护委员会 EDPB 认为，不加盐、不带密钥的哈希，放在公链上通常不够。",
   "spoken": "欧洲数据保护委员会 EDPB 认为，不加盐、不带密钥的哈希，放在公链上通常不够。",
   "src": "/Users/k/Workon/Learning/web3/web3-security-101/Web3-Security/video/skeuo/ep24/audio/lines/seg5-17.mp3",
   "start": 99.396,
   "dur": 7.584,
   "speechStart": 99.494,
   "speechEnd": 106.148
  },
  {
   "id": "seg5-18",
   "text": "哈希本身，也算个人数据。",
   "spoken": "哈希本身，也算个人数据。",
   "src": "/Users/k/Workon/Learning/web3/web3-security-101/Web3-Security/video/skeuo/ep24/audio/lines/seg5-18.mp3",
   "start": 107.2,
   "dur": 2.88,
   "speechStart": 107.298,
   "speechEnd": 109.226
  },
  {
   "id": "seg5-19",
   "text": "更稳的做法，是先拼上一段 32 字节的随机盐，再算哈希，链上只存这个承诺。",
   "spoken": "更稳的做法，是先拼上一段 32 字节的随机盐，再算哈希，链上只存这个承诺。",
   "src": "/Users/k/Workon/Learning/web3/web3-security-101/Web3-Security/video/skeuo/ep24/audio/lines/seg5-19.mp3",
   "start": 110.3,
   "dur": 7.008,
   "speechStart": 110.398,
   "speechEnd": 116.457
  },
  {
   "id": "seg5-20",
   "text": "盐和原文存在链下可以删除的系统里，删掉盐，链上的承诺就关联不到这个人。",
   "spoken": "盐和原文存在链下可以删除的系统里，删掉盐，链上的承诺就关联不到这个人。",
   "src": "/Users/k/Workon/Learning/web3/web3-security-101/Web3-Security/video/skeuo/ep24/audio/lines/seg5-20.mp3",
   "start": 117.528,
   "dur": 7.248,
   "speechStart": 117.626,
   "speechEnd": 123.959
  },
  {
   "id": "seg5-21",
   "text": "加密上链再销毁密钥，也不等于数据消失，密文还留在每个节点里。",
   "spoken": "加密上链再销毁密钥，也不等于数据消失，密文还留在每个节点里。",
   "src": "/Users/k/Workon/Learning/web3/web3-security-101/Web3-Security/video/skeuo/ep24/audio/lines/seg5-21.mp3",
   "start": 124.996,
   "dur": 6.096,
   "speechStart": 125.094,
   "speechEnd": 130.272
  }
