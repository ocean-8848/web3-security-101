 "captions": [
  {
   "text": "交易所今天就能做一件事",
   "start": 1.55,
   "end": 3.682,
   "id": "c0"
  },
  {
   "text": "查一查 客服后台有多少人",
   "start": 4.024,
   "end": 6.386,
   "id": "c1"
  },
  {
   "text": "能查到一条完整的用户记录",
   "start": 6.593,
   "end": 8.645,
   "id": "c2"
  },
  {
   "text": "普通用户也有几件事",
   "start": 8.95,
   "end": 10.662,
   "id": "c3"
  },
  {
   "text": "买硬件钱包用代收地址",
   "start": 11.032,
   "end": 13.256,
   "id": "c4"
  },
  {
   "text": "交易所和电商用不同的邮箱",
   "start": 13.495,
   "end": 15.865,
   "id": "c5"
  },
  {
   "text": "不在社交媒体上",
   "start": 16.206,
   "end": 17.509,
   "id": "c6"
  },
  {
   "text": "把自己的地址或 ENS 名称",
   "start": 17.587,
   "end": 20.126,
   "id": "c7"
  },
  {
   "text": "和真实身份连在一起",
   "start": 20.229,
   "end": 22.154,
   "id": "c8"
  },
  {
   "text": "收到交易所的泄露通知",
   "start": 22.41,
   "end": 24.399,
   "id": "c9"
  },
  {
   "text": "开启提币白名单",
   "start": 24.601,
   "end": 26.136,
   "id": "c10"
  },
  {
   "text": "至少几个月保持警惕",
   "start": 26.336,
   "end": 27.945,
   "id": "c11"
  },
  {
   "text": "回到开头的题",
   "start": 28.23,
   "end": 29.502,
   "id": "c12"
  },
  {
   "text": "对方说得出你的名字",
   "start": 29.73,
   "end": 31.526,
   "id": "c13"
  },
  {
   "text": "余额和工单",
   "start": 31.579,
   "end": 32.871,
   "id": "c14"
  },
  {
   "text": "不代表他是真客服",
   "start": 33.13,
   "end": 34.826,
   "id": "c15"
  },
  {
   "text": "这些数据",
   "start": 35.07,
   "end": 35.981,
   "id": "c16"
  },
  {
   "text": "可能早就泄露了",
   "start": 36.077,
   "end": 37.455,
   "id": "c17"
  },
  {
   "text": "交易所和钱包厂商",
   "start": 37.69,
   "end": 39.56,
   "id": "c18"
  },
  {
   "text": "永远不会让你把资产转到安全地址",
   "start": 39.631,
   "end": 42.669,
   "id": "c19"
  },
  {
   "text": "也不会索要助记词",
   "start": 42.887,
   "end": 44.598,
   "id": "c20"
  },
  {
   "text": "主动打来的电话 短信 邮件",
   "start": 44.965,
   "end": 47.943,
   "id": "c21"
  },
  {
   "text": "说你的账户有风险",
   "start": 48.112,
   "end": 49.549,
   "id": "c22"
  },
  {
   "text": "一律挂断",
   "start": 49.645,
   "end": 50.479,
   "id": "c23"
  },
  {
   "text": "再从官方 App 里联系客服",
   "start": 50.997,
   "end": 53.173,
   "id": "c24"
  },
  {
   "text": "数据里没有密码",
   "start": 53.41,
   "end": 55.018,
   "id": "c25"
  },
  {
   "text": "可它告诉骗子 该骗谁",
   "start": 55.416,
   "end": 57.574,
   "id": "c26"
  },
  {
   "text": "该怎么说",
   "start": 57.689,
   "end": 58.447,
   "id": "c27"
  },
  {
   "text": "下一集讲资金追踪与事后处置",
   "start": 58.75,
   "end": 62.02,
   "id": "c28"
  }
 ]
