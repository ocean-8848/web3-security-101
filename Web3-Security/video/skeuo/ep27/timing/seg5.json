   "speechStart": 74.814,
   "speechEnd": 75.564
  },
  {
   "id": "seg5-16",
   "text": "在 Bybit 事故里，mETH 协议追回了 cmETH。",
   "spoken": "在 Bybit 事故里，mETH 协议追回了 cmETH。",
   "src": "/Users/k/Workon/Learning/web3/web3-security-101/Web3-Security/video/skeuo/ep27/audio/lines/seg5-16.mp3",
