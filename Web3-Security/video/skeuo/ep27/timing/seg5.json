 "captions": [
  {
   "text": "上线不是终点",
   "start": 1.648,
   "end": 3.056,
   "id": "c0"
  },
  {
   "text": "合约上线以后",
   "start": 4.052,
   "end": 5.353,
   "id": "c1"
  },
  {
   "text": "要有人一直盯着",
   "start": 5.444,
   "end": 6.567,
   "id": "c2"
  },
  {
   "text": "同时开一个漏洞赏金",
   "start": 7.536,
   "end": 9.17,
   "id": "c3"
  },
  {
   "text": "让发现问题的白帽",
   "start": 9.333,
   "end": 10.718,
   "id": "c4"
  },
  {
   "text": "有动力先来报告",
   "start": 10.762,
   "end": 11.979,
   "id": "c5"
  },
  {
   "text": "盯什么",
   "start": 12.964,
   "end": 13.753,
   "id": "c6"
  },
  {
   "text": "锁仓总量突然下跌",
   "start": 14.116,
   "end": 15.715,
   "id": "c7"
  },
  {
   "text": "比如 10 分钟内跌了超过 10%",
   "start": 15.866,
   "end": 18.298,
   "id": "c8"
  },
  {
   "text": "同一笔交易里",
   "start": 19.28,
   "end": 20.414,
   "id": "c9"
  },
  {
   "text": "出现大额闪电贷和本协议的调用",
   "start": 20.53,
   "end": 23.319,
   "id": "c10"
  },
  {
   "text": "任何管理员函数被调用",
   "start": 24.3,
   "end": 26.148,
   "id": "c11"
  },
  {
   "text": "实现地址变了",
   "start": 26.228,
   "end": 27.601,
   "id": "c12"
  },
  {
   "text": "时间锁队列里多了新操作",
   "start": 27.633,
   "end": 29.91,
   "id": "c13"
  },
  {
   "text": "预言机价格偏离其他来源",
   "start": 30.88,
   "end": 33.073,
   "id": "c14"
  },
  {
   "text": "或者超过心跳时间没有更新",
   "start": 33.165,
   "end": 35.49,
   "id": "c15"
  },
  {
   "text": "跨链两侧",
   "start": 36.476,
   "end": 37.527,
   "id": "c16"
  },
  {
   "text": "锁定量和铸造量对不上",
   "start": 37.726,
   "end": 39.527,
   "id": "c17"
  },
  {
   "text": "告警响起",
   "start": 40.488,
   "end": 41.491,
   "id": "c18"
  },
  {
   "text": "接下来是应急流程",
   "start": 41.654,
   "end": 43.241,
   "id": "c19"
  },
  {
   "text": "值班人员先确认异常",
   "start": 44.236,
   "end": 46.096,
   "id": "c20"
  },
  {
   "text": "确认后触发暂停",
   "start": 47.096,
   "end": 48.873,
   "id": "c21"
  },
  {
   "text": "守护者的暂停权限没有延迟",
   "start": 48.988,
   "end": 51.575,
   "id": "c22"
  },
  {
   "text": "然后组建作战室",
   "start": 52.572,
   "end": 54.063,
   "id": "c23"
  },
  {
   "text": "里面有开发和审计方",
   "start": 54.214,
   "end": 56.015,
   "id": "c24"
  },
  {
   "text": "还有安全响应团队",
   "start": 56.048,
   "end": 57.468,
   "id": "c25"
  },
  {
   "text": "比如 SEAL 911 这类社区应急组织",
   "start": 57.548,
   "end": 60.694,
   "id": "c26"
  },
  {
   "text": "评估能不能白帽救援",
   "start": 61.672,
   "end": 63.496,
   "id": "c27"
  },
  {
   "text": "抢先把剩余资金转到安全的地方",
   "start": 63.541,
   "end": 66.163,
   "id": "c28"
  },
  {
   "text": "联系交易所和稳定币发行方",
   "start": 67.148,
   "end": 69.496,
   "id": "c29"
  },
  {
   "text": "冻结被盗资金",
   "start": 69.6,
   "end": 70.853,
   "id": "c30"
  },
  {
   "text": "最后发布公告和复盘",
   "start": 71.832,
   "end": 73.764,
   "id": "c31"
  },
  {
   "text": "看一个例子",
   "start": 74.764,
   "end": 75.684,
   "id": "c32"
  },
  {
   "text": "在 Bybit 事故里",
   "start": 76.856,
   "end": 78.24,
   "id": "c33"
  },
  {
   "text": "mETH 协议追回了 cmETH",
   "start": 78.368,
   "end": 80.776,
   "id": "c34"
  },
  {
   "text": "靠的是三样东西",
   "start": 81.756,
   "end": 83.116,
   "id": "c35"
  },
  {
   "text": "协议本身有提款延迟",
   "start": 83.387,
   "end": 85.366,
   "id": "c36"
  },
  {
   "text": "团队有暂停权限",
   "start": 85.398,
   "end": 86.973,
   "id": "c37"
  },
  {
   "text": "外部安全社区快速牵线",
   "start": 87.113,
   "end": 89.08,
   "id": "c38"
  },
  {
   "text": "这三样 没有一样是出事当天才能加上的",
   "start": 90.064,
   "end": 93.4,
   "id": "c39"
  },
  {
   "text": "应急能力",
   "start": 94.388,
   "end": 95.355,
   "id": "c40"
  },
  {
   "text": "要事先设计进合约",
   "start": 95.471,
   "end": 97.07,
   "id": "c41"
  }
 ]
