 "captions": [
  {
   "text": "最后 按角色各做一件事",
   "start": 1.55,
   "end": 3.958,
   "id": "c0"
  },
  {
   "text": "先对照八个关口问一句",
   "start": 4.25,
   "end": 6.188,
   "id": "c1"
  },
  {
   "text": "哪一个是你们跳过的",
   "start": 6.556,
   "end": 8.282,
   "id": "c2"
  },
  {
   "text": "开发者 今天就给你的核心合约",
   "start": 8.926,
   "end": 11.328,
   "id": "c3"
  },
  {
   "text": "写下一条不变量",
   "start": 11.348,
   "end": 12.672,
   "id": "c4"
  },
  {
   "text": "让测试去检查它",
   "start": 12.897,
   "end": 14.358,
   "id": "c5"
  },
  {
   "text": "做审计和评审的人",
   "start": 14.57,
   "end": 16.354,
   "id": "c6"
  },
  {
   "text": "核对审计版本的提交哈希",
   "start": 16.482,
   "end": 18.477,
   "id": "c7"
  },
  {
   "text": "和线上字节码是不是同一份",
   "start": 18.616,
   "end": 20.909,
   "id": "c8"
  },
  {
   "text": "项目负责人",
   "start": 21.19,
   "end": 22.169,
   "id": "c9"
  },
  {
   "text": "回答一个问题",
   "start": 22.361,
   "end": 23.2,
   "id": "c10"
  },
  {
   "text": "如果今晚出事",
   "start": 23.741,
   "end": 24.916,
   "id": "c11"
  },
  {
   "text": "谁有权按下暂停",
   "start": 25.0,
   "end": 26.484,
   "id": "c12"
  },
  {
   "text": "他自己知道吗",
   "start": 26.573,
   "end": 27.576,
   "id": "c13"
  },
  {
   "text": "回到开头的问题",
   "start": 28.09,
   "end": 29.441,
   "id": "c14"
  },
  {
   "text": "项目方能用我们通过了审计",
   "start": 29.76,
   "end": 31.848,
   "id": "c15"
  },
  {
   "text": "证明线上代码安全吗",
   "start": 31.913,
   "end": 33.598,
   "id": "c16"
  },
  {
   "text": "不能",
   "start": 34.199,
   "end": 34.725,
   "id": "c17"
  },
  {
   "text": "审计结论",
   "start": 35.03,
   "end": 36.014,
   "id": "c18"
  },
  {
   "text": "只对审计时的那个提交哈希成立",
   "start": 36.15,
   "end": 38.712,
   "id": "c19"
  },
  {
   "text": "还要证明线上字节码等于审计版本",
   "start": 38.93,
   "end": 42.7,
   "id": "c20"
  },
  {
   "text": "并且上线后的每一次改动",
   "start": 42.87,
   "end": 45.032,
   "id": "c21"
  },
  {
   "text": "都经过审查",
   "start": 45.113,
   "end": 46.192,
   "id": "c22"
  },
  {
   "text": "审计是流水线上的一个关口",
   "start": 46.43,
   "end": 49.248,
   "id": "c23"
  },
  {
   "text": "不是一张免检证书",
   "start": 49.461,
   "end": 50.916,
   "id": "c24"
  },
  {
   "text": "下一集讲事故案例库",
   "start": 51.21,
   "end": 53.56,
   "id": "c25"
  }
 ]
}