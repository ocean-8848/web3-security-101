 "captions": [
  {
   "text": "普通用户",
   "start": 1.648,
   "end": 2.64,
   "id": "c0"
  },
  {
   "text": "可以从这几件事做起",
   "start": 2.66,
   "end": 4.175,
   "id": "c1"
  },
  {
   "text": "交易所和邮箱",
   "start": 5.156,
   "end": 6.397,
   "id": "c2"
  },
  {
   "text": "用硬件密钥或验证器 App",
   "start": 6.489,
   "end": 8.659,
   "id": "c3"
  },
  {
   "text": "关掉短信验证",
   "start": 8.679,
   "end": 9.945,
   "id": "c4"
  },
  {
   "text": "向运营商申请号码转移锁",
   "start": 10.944,
   "end": 13.161,
   "id": "c5"
  },
  {
   "text": "关注的项目方账号",
   "start": 14.14,
   "end": 15.571,
   "id": "c6"
  },
  {
   "text": "突然发限时空投",
   "start": 15.628,
   "end": 17.095,
   "id": "c7"
  },
  {
   "text": "紧急迁移",
   "start": 17.187,
   "end": 18.25,
   "id": "c8"
  },
  {
   "text": "先去别的官方渠道核实",
   "start": 18.306,
   "end": 20.119,
   "id": "c9"
  },
  {
   "text": "和陌生网友线下见面",
   "start": 21.104,
   "end": 22.75,
   "id": "c10"
  },
  {
   "text": "选公共场所",
   "start": 22.842,
   "end": 24.155,
   "id": "c11"
  },
  {
   "text": "让别人知道你的行程",
   "start": 24.306,
   "end": 25.702,
   "id": "c12"
  },
  {
   "text": "遭遇胁迫时",
   "start": 26.676,
   "end": 27.905,
   "id": "c13"
  },
  {
   "text": "人身安全第一",
   "start": 28.057,
   "end": 29.322,
   "id": "c14"
  },
  {
   "text": "事后立即报警",
   "start": 29.366,
   "end": 30.667,
   "id": "c15"
  },
  {
   "text": "如果你是多签签名人",
   "start": 31.648,
   "end": 33.222,
   "id": "c16"
  },
  {
   "text": "今天就查一遍",
   "start": 33.314,
   "end": 34.437,
   "id": "c17"
  },
  {
   "text": "你的手机号能不能单独重置哪个账号",
   "start": 34.517,
   "end": 37.949,
   "id": "c18"
  },
  {
   "text": "如果你管理官方账号",
   "start": 38.948,
   "end": 40.594,
   "id": "c19"
  },
  {
   "text": "今天就把它的多因素认证",
   "start": 40.829,
   "end": 42.522,
   "id": "c20"
  },
  {
   "text": "换成硬件密钥",
   "start": 42.543,
   "end": 43.796,
   "id": "c21"
  },
  {
   "text": "如果你负责团队",
   "start": 44.784,
   "end": 46.037,
   "id": "c22"
  },
  {
   "text": "列一份关键人员名单",
   "start": 46.129,
   "end": 47.799,
   "id": "c23"
  },
  {
   "text": "给每个人配上号码锁和硬件密钥",
   "start": 47.998,
   "end": 50.632,
   "id": "c24"
  },
  {
   "text": "回到开头的题",
   "start": 51.628,
   "end": 53.024,
   "id": "c25"
  },
  {
   "text": "答案是没有",
   "start": 54.008,
   "end": 54.951,
   "id": "c26"
  },
  {
   "text": "SEC 承认",
   "start": 55.008,
   "end": 56.154,
   "id": "c27"
  },
  {
   "text": "此前曾请 X 关闭这个账号的多因素认证",
   "start": 56.174,
   "end": 59.499,
   "id": "c28"
  },
  {
   "text": "攻击者对绑定的手机号做了 SIM 卡劫持",
   "start": 60.492,
   "end": 63.9,
   "id": "c29"
  },
  {
   "text": "再用重置码登录",
   "start": 63.92,
   "end": 65.293,
   "id": "c30"
  },
  {
   "text": "负责换卡的人",
   "start": 66.28,
   "end": 67.497,
   "id": "c31"
  },
  {
   "text": "2025 年被判 14 个月",
   "start": 67.72,
   "end": 69.914,
   "id": "c32"
  },
  {
   "text": "监管机构的账号也会失守",
   "start": 70.892,
   "end": 72.895,
   "id": "c33"
  },
  {
   "text": "只要一条短信",
   "start": 73.058,
   "end": 74.181,
   "id": "c34"
  },
  {
   "text": "就能单独完成恢复",
   "start": 74.201,
   "end": 75.704,
   "id": "c35"
  },
  {
   "text": "攻击从链上走到线下",
   "start": 76.704,
   "end": 78.552,
   "id": "c36"
  },
  {
   "text": "防线就要让一张卡",
   "start": 78.751,
   "end": 80.195,
   "id": "c37"
  },
  {
   "text": "一次胁迫",
   "start": 80.263,
   "end": 81.195,
   "id": "c38"
  },
  {
   "text": "都不够拿走一切",
   "start": 81.263,
   "end": 82.409,
   "id": "c39"
  },
  {
   "text": "下一集讲托管",
