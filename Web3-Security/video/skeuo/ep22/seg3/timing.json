 "captions": [
  {
   "text": "先看账号这条路",
   "start": 1.64,
   "end": 2.905,
   "id": "c0"
  },
  {
   "text": "SIM 卡劫持",
   "start": 3.207,
   "end": 4.546,
   "id": "c1"
  },
  {
   "text": "攻击者让运营商",
   "start": 4.904,
   "end": 6.584,
   "id": "c2"
  },
  {
   "text": "把受害者的手机号",
   "start": 6.604,
   "end": 8.038,
   "id": "c3"
  },
  {
   "text": "转到自己的 SIM 卡上",
   "start": 8.255,
   "end": 10.409,
   "id": "c4"
  },
  {
   "text": "常见的手法",
   "start": 10.63,
   "end": 11.719,
   "id": "c5"
  },
  {
   "text": "是出示伪造证件",
   "start": 11.739,
   "end": 13.324,
   "id": "c6"
  },
  {
   "text": "或者贿赂",
   "start": 13.459,
   "end": 14.408,
   "id": "c7"
  },
  {
   "text": "欺骗客服",
   "start": 14.428,
   "end": 15.421,
   "id": "c8"
  },
  {
   "text": "号码到手",
   "start": 15.73,
   "end": 16.763,
   "id": "c9"
  },
  {
   "text": "他在交易所 邮箱",
   "start": 16.916,
   "end": 19.369,
   "id": "c10"
  },
  {
   "text": "社交账号上",
   "start": 19.538,
   "end": 20.576,
   "id": "c11"
  },
  {
   "text": "点忘记密码",
   "start": 20.655,
   "end": 21.909,
   "id": "c12"
  },
  {
   "text": "短信验证码",
   "start": 22.295,
   "end": 23.316,
   "id": "c13"
  },
  {
   "text": "发到了他的新卡上",
   "start": 23.455,
   "end": 24.988,
   "id": "c14"
  },
  {
   "text": "这一步能成功",
   "start": 25.311,
   "end": 26.428,
   "id": "c15"
  },
  {
   "text": "是因为账号允许短信验证码",
   "start": 26.46,
   "end": 28.94,
   "id": "c16"
  },
  {
   "text": "作为唯一的恢复方式",
   "start": 28.96,
   "end": 30.591,
   "id": "c17"
  },
  {
   "text": "再想一种情况",
   "start": 30.87,
   "end": 31.905,
   "id": "c18"
  },
  {
   "text": "账号开了验证器 App",
   "start": 32.076,
   "end": 33.693,
   "id": "c19"
  },
  {
   "text": "但忘记密码时",
   "start": 33.713,
   "end": 35.21,
   "id": "c20"
  },
  {
   "text": "仍然可以用短信",
   "start": 35.297,
   "end": 36.543,
   "id": "c21"
  },
  {
   "text": "只要短信能单独完成恢复",
   "start": 36.87,
   "end": 38.962,
   "id": "c22"
  },
  {
   "text": "验证器就被绕过了",
   "start": 39.198,
   "end": 40.765,
   "id": "c23"
  },
  {
   "text": "第二因素有多强",
   "start": 41.085,
   "end": 42.585,
   "id": "c24"
  },
  {
   "text": "取决于恢复流程里最弱的一环",
   "start": 42.724,
   "end": 45.325,
   "id": "c25"
  },
  {
   "text": "社交账号被劫持",
   "start": 45.53,
   "end": 47.374,
   "id": "c26"
  },
  {
   "text": "入口不止换卡",
   "start": 47.506,
   "end": 48.985,
   "id": "c27"
  },
  {
   "text": "还有弱密码被暴力破解",
   "start": 49.36,
   "end": 51.59,
   "id": "c28"
  },
  {
   "text": "团队交接时",
   "start": 51.802,
   "end": 52.859,
   "id": "c29"
  },
  {
   "text": "多因素认证被关掉",
   "start": 52.879,
   "end": 54.478,
   "id": "c30"
  },
  {
   "text": "冒充平台官方",
   "start": 54.861,
   "end": 56.108,
   "id": "c31"
  },
  {
   "text": "发版权侵权",
   "start": 56.243,
   "end": 57.675,
   "id": "c32"
  },
  {
   "text": "账号违规的钓鱼邮件",
   "start": 57.747,
   "end": 59.476,
   "id": "c33"
  },
  {
   "text": "官方账号发出的链接",
   "start": 59.71,
   "end": 61.569,
   "id": "c34"
  },
  {
   "text": "粉丝几乎没有理由怀疑",
   "start": 61.785,
   "end": 63.85,
   "id": "c35"
  },
  {
   "text": "2023 年 9 月",
   "start": 64.196,
   "end": 65.504,
   "id": "c36"
  },
  {
   "text": "Vitalik Buterin 的 X 账号被盗",
   "start": 65.734,
   "end": 67.976,
   "id": "c37"
  },
  {
   "text": "发出了假的纪念 NFT 链接",
   "start": 68.268,
   "end": 70.623,
   "id": "c38"
  },
  {
   "text": "粉丝签名后",
   "start": 70.87,
   "end": 72.022,
   "id": "c39"
  },
  {
   "text": "钱包被清空",
   "start": 72.058,
   "end": 73.883,
   "id": "c40"
  },
  {
   "text": "ZachXBT 统计",
   "start": 73.903,
   "end": 75.091,
   "id": "c41"
  },
  {
   "text": "约 69.1 万美元",
   "start": 75.174,
   "end": 77.316,
   "id": "c42"
  },
  {
   "text": "2024 年 1 月",
   "start": 77.57,
   "end": 78.717,
   "id": "c43"
  },
  {
   "text": "安全公司 Mandiant 的 X 账号",
   "start": 78.848,
   "end": 81.03,
   "id": "c44"
  },
  {
   "text": "被改名冒充 Phantom 钱包",
   "start": 81.14,
   "end": 82.983,
   "id": "c45"
  },
  {
   "text": "Mandiant 自查认为",
   "start": 83.321,
   "end": 84.781,
   "id": "c46"
  },
  {
   "text": "很可能是被暴力破解",
   "start": 84.957,
   "end": 86.731,
   "id": "c47"
  },
  {
   "text": "交接期间",
   "start": 86.964,
   "end": 87.833,
   "id": "c48"
  },
  {
   "text": "多因素认证没有起到保护",
   "start": 87.871,
   "end": 89.798,
   "id": "c49"
  },
  {
   "text": "后来 有人冒充 X 官方",
   "start": 90.09,
   "end": 92.344,
   "id": "c50"
  },
  {
   "text": "发版权侵权通知",
   "start": 92.508,
   "end": 93.991,
   "id": "c51"
  },
  {
   "text": "接管了 15 个加密类账号",
   "start": 94.23,
   "end": 96.543,
   "id": "c52"
  },
  {
   "text": "推广假代币",
   "start": 96.798,
   "end": 98.041,
   "id": "c53"
  },
  {
   "text": "约 50 万美元",
   "start": 98.075,
   "end": 99.447,
   "id": "c54"
  },
  {
   "text": "交易所的员工也一样",
   "start": 99.743,
   "end": 101.329,
   "id": "c55"
  },
  {
   "text": "美国联邦起诉书称",
   "start": 101.732,
   "end": 103.197,
   "id": "c56"
  },
  {
   "text": "一个团伙对一名员工",
   "start": 103.348,
   "end": 105.137,
   "id": "c57"
  },
  {
   "text": "做了 SIM 卡劫持",
   "start": 105.225,
   "end": 106.795,
   "id": "c58"
  },
  {
   "text": "转走的加密资产",
   "start": 107.146,
   "end": 108.715,
   "id": "c59"
  },
  {
   "text": "超过 4 亿美元",
   "start": 108.821,
   "end": 110.561,
   "id": "c60"
  },
  {
   "text": "媒体援引消息源",
   "start": 110.887,
   "end": 112.233,
   "id": "c61"
  },
  {
   "text": "确认受害公司是 FTX",
   "start": 112.373,
   "end": 114.654,
   "id": "c62"
  },
  {
   "text": "时间是它申请破产的当天",
   "start": 115.01,
