 "captions": [
  {
   "text": "先给准确的说法",
   "start": 1.648,
   "end": 3.103,
   "id": "c0"
  },
  {
   "text": "扳手攻击",
   "start": 4.1,
   "end": 5.044,
   "id": "c1"
  },
  {
   "text": "就是用暴力或威胁",
   "start": 5.064,
   "end": 6.686,
   "id": "c2"
  },
  {
   "text": "逼持币的人交出私钥",
   "start": 6.909,
   "end": 8.639,
   "id": "c3"
  },
  {
   "text": "或者转账",
   "start": 8.659,
   "end": 9.484,
   "id": "c4"
  },
  {
   "text": "这个名字来自一幅漫画",
   "start": 10.464,
   "end": 12.562,
   "id": "c5"
  },
  {
   "text": "花大价钱买算力",
   "start": 13.54,
   "end": 14.912,
   "id": "c6"
  },
  {
   "text": "破解不了加密",
   "start": 14.932,
   "end": 15.983,
   "id": "c7"
  },
  {
   "text": "买一把便宜的扳手 就够了",
   "start": 16.182,
   "end": 18.364,
   "id": "c8"
  },
  {
   "text": "密码学挡不住扳手",
   "start": 19.352,
   "end": 20.807,
   "id": "c9"
  },
  {
   "text": "攻击者知道你是谁 住在哪",
   "start": 21.804,
   "end": 24.164,
   "id": "c10"
  },
  {
   "text": "有多少资产",
   "start": 24.316,
   "end": 25.438,
   "id": "c11"
  },
  {
   "text": "最便宜的办法",
   "start": 25.577,
   "end": 26.807,
   "id": "c12"
  },
  {
   "text": "就是找到你本人",
   "start": 26.875,
   "end": 27.997,
   "id": "c13"
  },
  {
   "text": "打个比方",
   "start": 28.984,
   "end": 29.88,
   "id": "c14"
  },
  {
   "text": "你给家门装了一把银行级的锁",
   "start": 30.031,
   "end": 32.213,
   "id": "c15"
  },
  {
   "text": "可你的门牌号",
   "start": 33.188,
   "end": 34.298,
   "id": "c16"
  },
  {
   "text": "作息时间",
   "start": 34.378,
   "end": 35.262,
   "id": "c17"
  },
  {
   "text": "保险柜里有多少钱",
   "start": 35.307,
   "end": 36.87,
   "id": "c18"
  },
  {
   "text": "都印在一张贴在网上的海报上",
   "start": 36.973,
   "end": 39.25,
   "id": "c19"
  },
  {
   "text": "锁越好 劫匪越不会去撬锁",
   "start": 40.224,
   "end": 42.798,
   "id": "c20"
  },
  {
   "text": "而是等你回家",
   "start": 42.974,
   "end": 44.096,
   "id": "c21"
  },
  {
   "text": "比喻在这里不成立",
   "start": 45.076,
   "end": 46.496,
   "id": "c22"
  },
  {
   "text": "劫匪要先知道你有钱",
   "start": 46.718,
   "end": 48.555,
   "id": "c23"
  },
  {
   "text": "而链上资产的特点是",
   "start": 49.544,
   "end": 51.285,
   "id": "c24"
  },
  {
   "text": "地址一旦和身份连上",
   "start": 51.413,
   "end": 53.023,
   "id": "c25"
  },
  {
   "text": "余额对全世界公开",
   "start": 53.127,
   "end": 54.797,
   "id": "c26"
  },
  {
   "text": "所以攻击的第一步 是关联",
   "start": 55.788,
   "end": 58.434,
   "id": "c27"
  },
  {
   "text": "把一个链上地址",
   "start": 59.416,
   "end": 60.8,
   "id": "c28"
  },
  {
   "text": "连到一个真实的人",
   "start": 60.844,
   "end": 62.288,
   "id": "c29"
  },
  {
   "text": "一个真实的住址",
   "start": 62.38,
   "end": 63.669,
   "id": "c30"
  },
  {
   "text": "线索有三类",
   "start": 64.652,
   "end": 65.953,
   "id": "c31"
  },
  {
   "text": "公开信息",
   "start": 66.936,
   "end": 67.879,
   "id": "c32"
  },
  {
   "text": "比如社交媒体 采访",
   "start": 67.971,
   "end": 70.094,
   "id": "c33"
  },
  {
