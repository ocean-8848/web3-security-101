  {
   "line": 21,
   "text": "里",
   "start": 119.037,
   "end": 119.207
  },
  {
   "line": 21,
   "text": "的",
   "start": 119.207,
   "end": 119.377
  },
  {
   "line": 21,
   "text": "人",
   "start": 119.377,
   "end": 119.547
  }
 ],
 "captions": [
  {
   "text": "再看另一条路 找上门",
   "start": 1.55,
   "end": 3.463,
   "id": "c0"
  },
  {
   "text": "这部分涉及人身伤害",
   "start": 3.77,
   "end": 5.743,
   "id": "c1"
  },
  {
   "text": "我们只讲公开报道的事实",
   "start": 5.822,
   "end": 8.046,
   "id": "c2"
  },
  {
   "text": "不讲受害人的个人细节",
   "start": 8.16,
   "end": 10.108,
   "id": "c3"
  },
  {
   "text": "研究者 Jameson Lopp",
   "start": 10.403,
   "end": 11.937,
   "id": "c4"
  },
  {
   "text": "在 GitHub 上维护一份公开清单",
   "start": 12.114,
   "end": 14.847,
   "id": "c5"
  },
  {
   "text": "专门记录针对持币人的实体攻击",
   "start": 15.09,
   "end": 18.292,
   "id": "c6"
  },
  {
   "text": "按这份清单",
   "start": 18.608,
   "end": 19.61,
   "id": "c7"
  },
  {
   "text": "2023 年 74 起",
   "start": 19.871,
   "end": 22.195,
   "id": "c8"
  },
  {
   "text": "2024 年 106 起",
   "start": 22.479,
   "end": 25.12,
   "id": "c9"
  },
  {
   "text": "2025 年 170 起",
   "start": 25.356,
   "end": 27.974,
   "id": "c10"
  },
  {
   "text": "2026 年截至 10 月底",
   "start": 28.25,
   "end": 30.802,
   "id": "c11"
  },
  {
   "text": "已有 147 起",
   "start": 30.822,
   "end": 32.023,
   "id": "c12"
  },
  {
   "text": "其中法国 52 起",
   "start": 32.164,
   "end": 33.928,
   "id": "c13"
  },
  {
   "text": "各机构的统计口径不同",
   "start": 34.15,
   "end": 36.127,
   "id": "c14"
  },
  {
   "text": "数字不能直接比较",
   "start": 36.325,
   "end": 37.871,
   "id": "c15"
  },
  {
   "text": "Lopp 本人认为",
   "start": 38.229,
   "end": 39.341,
   "id": "c16"
  },
  {
   "text": "真实数量被低估了",
   "start": 39.483,
   "end": 40.907,
   "id": "c17"
  },
  {
   "text": "2025 年 1 月",
   "start": 41.256,
   "end": 42.477,
   "id": "c18"
  },
  {
   "text": "Ledger 的一位联合创始人",
   "start": 42.535,
   "end": 44.545,
   "id": "c19"
  },
  {
   "text": "和伴侣在家中被劫持",
   "start": 44.677,
   "end": 46.751,
   "id": "c20"
  },
  {
   "text": "绑匪向 Ledger 方面索要加密货币赎金",
   "start": 47.068,
   "end": 49.949,
   "id": "c21"
  },
  {
   "text": "法国宪兵特种部队救出了两人",
   "start": 50.139,
   "end": 52.455,
   "id": "c22"
  },
  {
   "text": "涉嫌主谋 6 月在摩洛哥落网",
   "start": 52.71,
   "end": 55.713,
   "id": "c23"
  },
  {
   "text": "2026 年 5 月被当地法院判处 25 年",
   "start": 55.813,
   "end": 59.818,
   "id": "c24"
  },
  {
   "text": "同年 5 月初",
   "start": 60.05,
   "end": 61.176,
   "id": "c25"
  },
  {
   "text": "一名加密企业家的父亲",
   "start": 61.354,
   "end": 63.174,
   "id": "c26"
  },
  {
   "text": "在巴黎街头被绑走",
   "start": 63.309,
   "end": 65.035,
   "id": "c27"
  },
  {
   "text": "警方突袭解救",
   "start": 65.31,
   "end": 66.779,
   "id": "c28"
  },
  {
   "text": "没有支付赎金",
   "start": 67.055,
   "end": 68.258,
   "id": "c29"
  },
  {
   "text": "5 月 13 日",
   "start": 68.588,
   "end": 69.573,
   "id": "c30"
  },
  {
   "text": "交易所 Paymium 的 CEO",
   "start": 69.788,
   "end": 71.982,
   "id": "c31"
  },
  {
   "text": "女儿和外孙在巴黎街头",
   "start": 72.193,
   "end": 74.481,
   "id": "c32"
  },
  {
   "text": "遭遇绑架未遂",
   "start": 74.559,
   "end": 75.833,
   "id": "c33"
  },
  {
   "text": "检方之后起诉了 25 人",
   "start": 76.07,
   "end": 78.11,
   "id": "c34"
  },
  {
   "text": "认为和 5 月初的绑架有关联",
   "start": 78.317,
   "end": 80.64,
   "id": "c35"
  },
  {
   "text": "法国内政部长会见业界",
   "start": 80.85,
   "end": 83.132,
   "id": "c36"
  },
  {
   "text": "宣布了安全简报",
   "start": 83.413,
   "end": 85.093,
   "id": "c37"
  },
  {
   "text": "紧急呼叫优先响应",
   "start": 85.175,
   "end": 86.888,
   "id": "c38"
  },
  {
   "text": "住宅安防检查等措施",
   "start": 87.107,
   "end": 88.985,
   "id": "c39"
  },
  {
   "text": "这几起案件里",
   "start": 89.327,
   "end": 90.423,
   "id": "c40"
  },
  {
   "text": "目标不只是持币人本人",
   "start": 90.584,
   "end": 92.593,
   "id": "c41"
  },
  {
   "text": "还有家属",
   "start": 92.689,
   "end": 93.508,
   "id": "c42"
  },
  {
   "text": "公开报道还显示",
   "start": 93.863,
   "end": 94.998,
   "id": "c43"
  },
  {
   "text": "部分团伙把执行环节",
   "start": 95.198,
   "end": 97.24,
   "id": "c44"
  },
  {
   "text": "外包给临时招募的人",
   "start": 97.28,
   "end": 99.012,
   "id": "c45"
  },
  {
   "text": "同在 2025 年 5 月",
   "start": 99.27,
   "end": 101.123,
   "id": "c46"
  },
  {
   "text": "纽约检方指控两名加密投资者",
   "start": 101.329,
   "end": 104.039,
   "id": "c47"
  },
  {
   "text": "把一名男子诱到曼哈顿的一处住宅",
   "start": 104.162,
   "end": 107.16,
   "id": "c48"
  },
  {
   "text": "囚禁 17 天",
   "start": 107.41,
   "end": 108.747,
   "id": "c49"
  },
  {
   "text": "逼他交出比特币密码",
   "start": 109.042,
   "end": 110.838,
   "id": "c50"
  },
  {
   "text": "两名被告不认罪",
   "start": 111.167,
   "end": 112.592,
   "id": "c51"
  },
  {
   "text": "公开报道里",
   "start": 112.695,
   "end": 113.638,
   "id": "c52"
  },
  {
   "text": "还没有查到判决",
   "start": 113.763,
   "end": 114.985,
   "id": "c53"
  },
  {
   "text": "施暴者 也可能是熟人",
   "start": 115.21,
   "end": 117.664,
   "id": "c54"
  },
  {
   "text": "或者同一个圈子里的人",
   "start": 117.798,
   "end": 119.667,
   "id": "c55"
  }
 ]
}