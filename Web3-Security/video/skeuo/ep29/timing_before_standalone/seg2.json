  },
  {
   "text": "账本里多了一张提现单",
   "start": 12.255,
   "end": 13.987,
   "id": "c6"
  },
  {
   "text": "第二关 请求构造",
   "start": 14.29,
   "end": 15.913,
   "id": "c7"
  },
  {
   "text": "钱包后台把这张单子",
   "start": 16.548,
   "end": 17.422,
   "id": "c8"
  },
  {
   "text": "翻译成一笔待签名的交易",
   "start": 17.442,
   "end": 20.498,
   "id": "c9"
  },
  {
   "text": "第三关 风控与审批",
   "start": 20.75,
   "end": 22.927,
   "id": "c10"
  },
  {
   "text": "规则检查金额和地址",
   "start": 23.06,
   "end": 24.916,
   "id": "c11"
  },
  {
   "text": "大额还要有人批准",
   "start": 25.02,
   "end": 26.629,
   "id": "c12"
  },
  {
   "text": "第四关 显示与解码",
   "start": 26.982,
   "end": 28.585,
   "id": "c13"
  },
  {
   "text": "审批的人看不懂原始字节",
   "start": 28.605,
   "end": 32.083,
   "id": "c14"
  },
  {
   "text": "他看到的",
   "start": 32.416,
   "end": 33.243,
   "id": "c15"
  },
  {
   "text": "是翻译出来的文字",
   "start": 33.279,
   "end": 34.64,
   "id": "c16"
  },
  {
   "text": "第五关 签名",
   "start": 34.968,
   "end": 36.654,
   "id": "c17"
  },
  {
   "text": "可能是 MPC 节点",
   "start": 37.131,
   "end": 37.823,
   "id": "c18"
  },
  {
   "text": "可能是硬件加密机",
   "start": 37.843,
   "end": 39.829,
   "id": "c19"
  },
  {
   "text": "也可能是多签的签名人",
   "start": 39.849,
   "end": 43.271,
   "id": "c20"
  },
  {
   "text": "第六关 广播",
   "start": 43.57,
   "end": 45.065,
   "id": "c21"
  },
  {
   "text": "签好的交易",
   "start": 45.272,
   "end": 46.307,
   "id": "c22"
  },
  {
   "text": "发到链上",
   "start": 46.439,
   "end": 47.202,
   "id": "c23"
  },
  {
   "text": "第七关 链上状态",
   "start": 47.47,
   "end": 49.442,
   "id": "c24"
  },
  {
   "text": "余额变了",
   "start": 49.714,
   "end": 50.536,
   "id": "c25"
  },
  {
   "text": "有时候 账户的代码和权限",
   "start": 50.779,
   "end": 53.078,
   "id": "c26"
  },
  {
   "text": "也会跟着变",
   "start": 53.124,
   "end": 54.095,
   "id": "c27"
  },
  {
   "text": "还有一条支线",
   "start": 54.33,
   "end": 55.599,
   "id": "c28"
  },
  {
   "text": "有些系统要先读链上数据",
   "start": 56.273,
   "end": 58.484,
   "id": "c29"
  },
  {
   "text": "再决定签不签",
   "start": 58.552,
   "end": 59.697,
   "id": "c30"
  },
  {
   "text": "这些数据",
   "start": 60.159,
   "end": 60.96,
   "id": "c31"
  },
  {
   "text": "来自 RPC 节点",
   "start": 61.06,
   "end": 62.363,
   "id": "c32"
  },
  {
   "text": "注意每一个箭头",
   "start": 62.727,
   "end": 64.01,
   "id": "c33"
  },
  {
   "text": "下游都默认",
   "start": 64.192,
   "end": 65.432,
   "id": "c34"
  },
  {
   "text": "上游已经检查过了",
   "start": 65.689,
   "end": 67.388,
   "id": "c35"
  },
  {
   "text": "从意图到链上",
   "start": 67.65,
   "end": 69.403,
   "id": "c36"
  },
  {
   "text": "这整条链路",
   "start": 69.622,
   "end": 70.726,
   "id": "c37"
  },
  {
   "text": "叫做签名路径",
   "start": 70.752,
   "end": 72.184,
   "id": "c38"
  },
  {
   "text": "私钥 只待在第五关",
   "start": 72.43,
   "end": 74.539,
   "id": "c39"
  },
  {
   "text": "攻击者要的",
   "start": 74.914,
   "end": 75.852,
   "id": "c40"
  },
  {
   "text": "只是让第五关",
   "start": 75.962,
   "end": 77.088,
   "id": "c41"
  },
  {
   "text": "签出他想要的东西",
   "start": 77.108,
   "end": 78.448,
   "id": "c42"
  }
 ]
}