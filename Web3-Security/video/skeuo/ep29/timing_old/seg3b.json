  },
  {
   "text": "2026 年 10 月 29 日",
   "start": 4.844,
   "end": 6.573,
   "id": "c2"
  },
  {
   "text": "Binance 多条链的热钱包",
   "start": 6.617,
   "end": 8.228,
   "id": "c3"
  },
  {
   "text": "被转走约 63.4 亿美元",
   "start": 8.248,
   "end": 10.287,
   "id": "c4"
  },
  {
   "text": "这是项目方的口径",
   "start": 10.663,
   "end": 12.13,
   "id": "c5"
  },
  {
   "text": "按项目方的初步报告",
   "start": 13.128,
   "end": 14.75,
   "id": "c6"
  },
  {
   "text": "攻击者先用一份假的面试作业",
   "start": 14.937,
   "end": 17.203,
   "id": "c7"
  },
  {
   "text": "控制了一名工程师的电脑",
   "start": 17.223,
   "end": 19.036,
   "id": "c8"
  },
  {
   "text": "另一名工程师的电脑上",
   "start": 20.02,
   "end": 21.892,
   "id": "c9"
  },
  {
   "text": "放着容器部署的令牌",
   "start": 21.948,
   "end": 23.606,
   "id": "c10"
  },
  {
   "text": "攻击者用它部署了自己的容器",
   "start": 24.608,
   "end": 26.694,
   "id": "c11"
  },
  {
   "text": "接触到了内部签名服务",
   "start": 26.953,
   "end": 28.754,
   "id": "c12"
  },
  {
   "text": "这是第五关",
   "start": 29.748,
   "end": 30.846,
   "id": "c13"
  },
  {
   "text": "攻击者没有偷钥匙",
   "start": 31.21,
   "end": 32.689,
   "id": "c14"
  },
  {
   "text": "他让签名服务替他签",
   "start": 32.769,
   "end": 34.475,
   "id": "c15"
  },
  {
   "text": "签出来的",
   "start": 35.464,
   "end": 36.325,
   "id": "c16"
  },
  {
   "text": "是 50 笔操纵 nonce",
   "start": 36.345,
   "end": 37.967,
   "id": "c17"
  },
  {
   "text": "设置 EIP-7702 委托的交易",
   "start": 38.13,
   "end": 41.098,
   "id": "c18"
  },
  {
   "text": "以太坊热钱包的地址",
   "start": 42.092,
   "end": 43.726,
   "id": "c19"
  },
  {
   "text": "从此会执行攻击者指定的代码",
   "start": 43.746,
   "end": 46.012,
   "id": "c20"
  },
  {
   "text": "然后是第七关",
   "start": 46.992,
   "end": 48.233,
   "id": "c21"
  },
  {
   "text": "Binance 暂停了提现",
   "start": 48.596,
   "end": 50.35,
   "id": "c22"
  },
  {
   "text": "关掉了热钱包服务",
   "start": 50.406,
   "end": 51.921,
   "id": "c23"
  },
  {
   "text": "但委托是链上状态",
   "start": 52.924,
   "end": 54.57,
   "id": "c24"
  },
  {
   "text": "不受这些开关控制",
   "start": 54.638,
   "end": 56.153,
   "id": "c25"
  },
  {
   "text": "按公开的时间",
   "start": 57.152,
   "end": 58.345,
   "id": "c26"
  },
  {
   "text": "这个委托在链上存活了大约 3 小时 50 分钟",
   "start": 58.509,
   "end": 61.655,
   "id": "c27"
  },
  {
   "text": "告警时间",
   "start": 62.652,
   "end": 63.595,
   "id": "c28"
  },
  {
   "text": "内部 AI 工具怎么被利用",
   "start": 63.759,
   "end": 65.905,
   "id": "c29"
  },
  {
   "text": "报告里还没有说清",
   "start": 66.068,
   "end": 67.607,
   "id": "c30"
  },
  {
   "text": "完整报告还在等",
