   "speechStart": 7.254,
   "speechEnd": 12.62
  },
  {
   "id": "seg1-02",
   "text": "屏幕上显示的，是一笔普通的转账。",
   "spoken": "屏幕上显示的，是一笔普通的转账。",
   "src": "/Users/k/Workon/Learning/web3/web3-security-101/Web3-Security/video/skeuo/ep29/audio/lines/seg1-02.mp3",
