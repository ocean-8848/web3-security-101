   "speechEnd": 16.333
  },
  {
   "id": "seg1-03",
   "text": "而真正签下去的交易，多了一个参数：operation，等于 1。",
   "spoken": "而真正签下去的交易，多了一个参数：operation，等于 1。",
   "src": "/Users/k/Workon/Learning/web3/web3-security-101/Web3-Security/video/skeuo/ep29/audio/lines/seg1-03.mp3",
