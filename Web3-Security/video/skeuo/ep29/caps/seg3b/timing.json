 "captions": [
  {
   "text": "最后一起",
   "start": 1.55,
   "end": 2.443,
   "id": "c0"
  },
  {
   "text": "也是最大的一起",
   "start": 2.521,
   "end": 3.747,
   "id": "c1"
  },
  {
   "text": "2026 年 10 月 29 日",
   "start": 4.116,
   "end": 6.152,
   "id": "c2"
  },
  {
   "text": "Binance 多条链的热钱包",
   "start": 6.362,
   "end": 8.272,
   "id": "c3"
  },
  {
   "text": "被转走约 63.4 亿美元",
   "start": 8.353,
   "end": 10.907,
   "id": "c4"
  },
  {
   "text": "这是项目方的口径",
   "start": 11.122,
   "end": 12.53,
   "id": "c5"
  },
  {
   "text": "按项目方的初步报告",
   "start": 12.885,
   "end": 14.542,
   "id": "c6"
  },
  {
   "text": "攻击者先用一份假的面试作业",
   "start": 14.768,
   "end": 17.249,
   "id": "c7"
  },
  {
   "text": "控制了一名工程师的电脑",
   "start": 17.269,
   "end": 19.05,
   "id": "c8"
  },
  {
   "text": "另一名工程师的电脑上",
   "start": 19.33,
   "end": 21.054,
   "id": "c9"
  },
  {
   "text": "放着容器部署的令牌",
   "start": 21.184,
   "end": 23.008,
   "id": "c10"
  },
  {
   "text": "攻击者用它部署了自己的容器",
   "start": 23.23,
   "end": 25.697,
   "id": "c11"
  },
  {
   "text": "接触到了内部签名服务",
   "start": 25.912,
   "end": 27.858,
   "id": "c12"
  },
  {
   "text": "这是第五关",
   "start": 28.09,
   "end": 29.06,
   "id": "c13"
  },
  {
   "text": "攻击者没有偷钥匙",
   "start": 29.366,
   "end": 30.85,
   "id": "c14"
  },
  {
   "text": "他让签名服务替他签",
   "start": 31.083,
   "end": 32.824,
   "id": "c15"
  },
  {
   "text": "签出来的",
   "start": 33.204,
   "end": 34.185,
   "id": "c16"
  },
  {
   "text": "是 50 笔操纵 nonce",
   "start": 34.333,
   "end": 36.124,
   "id": "c17"
  },
  {
   "text": "设置 EIP-7702 委托的交易",
   "start": 36.292,
   "end": 39.167,
   "id": "c18"
  },
  {
   "text": "以太坊热钱包的地址",
   "start": 39.505,
   "end": 41.289,
   "id": "c19"
  },
  {
   "text": "从此会执行攻击者指定的代码",
   "start": 41.356,
   "end": 44.087,
   "id": "c20"
  },
  {
   "text": "然后是第七关",
   "start": 44.449,
   "end": 45.791,
   "id": "c21"
  },
  {
   "text": "Binance 暂停了提现",
   "start": 46.337,
   "end": 47.867,
   "id": "c22"
  },
  {
   "text": "关掉了热钱包服务",
   "start": 48.032,
   "end": 49.57,
   "id": "c23"
  },
  {
   "text": "但委托是链上状态",
   "start": 49.942,
   "end": 51.763,
   "id": "c24"
  },
  {
   "text": "不受这些开关控制",
   "start": 51.865,
   "end": 53.214,
   "id": "c25"
  },
  {
   "text": "按公开的时间",
   "start": 53.529,
   "end": 54.661,
   "id": "c26"
  },
  {
   "text": "这个委托在链上存活了大约 3 小时 50 分钟",
   "start": 54.749,
   "end": 58.382,
   "id": "c27"
  },
  {
   "text": "告警时间",
   "start": 58.786,
   "end": 59.705,
   "id": "c28"
  },
  {
   "text": "内部 AI 工具怎么被利用",
   "start": 59.852,
   "end": 61.81,
   "id": "c29"
  },
  {
   "text": "报告里还没有说清",
   "start": 61.905,
   "end": 63.348,
   "id": "c30"
  },
  {
   "text": "完整报告还在等",
   "start": 63.544,
   "end": 65.057,
   "id": "c31"
  }
 ]
