 "captions": [
  {
   "text": "下面是一套示例架构",
   "start": 1.648,
   "end": 3.413,
   "id": "c0"
  },
  {
   "text": "它综合了公开事件的教训",
   "start": 3.776,
   "end": 5.649,
   "id": "c1"
  },
  {
   "text": "不是哪家交易所公布的方案",
   "start": 5.8,
   "end": 7.553,
   "id": "c2"
  },
  {
   "text": "账本 意图签发",
   "start": 8.54,
   "end": 10.341,
   "id": "c3"
  },
  {
   "text": "策略引擎 审批",
   "start": 10.409,
   "end": 12.293,
   "id": "c4"
  },
  {
   "text": "签名集群 广播 链上",
   "start": 12.361,
   "end": 15.007,
   "id": "c5"
  },
  {
   "text": "再加一套独立监控",
   "start": 15.099,
   "end": 16.698,
   "id": "c6"
  },
  {
   "text": "开发电脑到签名集群",
   "start": 17.688,
   "end": 19.572,
   "id": "c7"
  },
  {
   "text": "这条线是禁止的",
   "start": 19.771,
   "end": 21.167,
   "id": "c8"
  },
  {
   "text": "网络上根本不该有这条路由",
   "start": 21.53,
   "end": 23.641,
   "id": "c9"
  },
  {
   "text": "我们挑四个重点",
   "start": 24.628,
   "end": 26.0,
   "id": "c10"
  },
  {
   "text": "第一 账本绑定签名",
   "start": 26.375,
   "end": 28.652,
   "id": "c11"
  },
  {
   "text": "签名服务只为账本里存在",
   "start": 29.648,
   "end": 31.865,
   "id": "c12"
  },
  {
   "text": "状态正确",
   "start": 31.886,
   "end": 32.889,
   "id": "c13"
  },
  {
   "text": "金额一致的提现单签名",
   "start": 32.981,
   "end": 35.02,
   "id": "c14"
  },
  {
   "text": "同一张单",
   "start": 35.395,
   "end": 36.291,
   "id": "c15"
  },
  {
   "text": "只能签一次",
   "start": 36.467,
   "end": 37.482,
   "id": "c16"
  },
  {
   "text": "目标和金额",
   "start": 38.46,
   "end": 39.665,
   "id": "c17"
  },
  {
   "text": "要从原始交易里解析出来",
   "start": 39.722,
   "end": 41.641,
   "id": "c18"
  },
  {
   "text": "不读上游写的描述",
   "start": 41.757,
   "end": 43.177,
   "id": "c19"
  },
  {
   "text": "伪造的提现指令",
   "start": 43.552,
   "end": 44.949,
   "id": "c20"
  },
  {
   "text": "在这里对不上账",
   "start": 45.064,
   "end": 46.294,
   "id": "c21"
  },
  {
   "text": "第二 策略读的是原始待签字节",
   "start": 47.272,
   "end": 50.323,
   "id": "c22"
  },
  {
   "text": "而且默认拒绝",
   "start": 50.426,
   "end": 51.799,
   "id": "c23"
  },
  {
   "text": "没有明确规则的交易类型",
   "start": 52.162,
   "end": 54.118,
   "id": "c24"
  },
  {
   "text": "一律不签",
   "start": 54.138,
   "end": 55.106,
   "id": "c25"
  },
  {
   "text": "比如 Safe 多签",
   "start": 56.084,
   "end": 57.706,
   "id": "c26"
  },
  {
   "text": "operation 只允许等于 0",
   "start": 57.822,
   "end": 60.027,
   "id": "c27"
  },
  {
   "text": "要用 1 只能指向官方的批量调用合约",
   "start": 61.008,
   "end": 63.999,
   "id": "c28"
  },
  {
   "text": "链上还有 Guard 合约再拦一次",
   "start": 64.055,
   "end": 66.416,
   "id": "c29"
  },
  {
   "text": "Bybit 那笔 operation 等于 1 的交易",
   "start": 67.396,
   "end": 70.03,
   "id": "c30"
  },
  {
   "text": "在这里会被拒绝",
   "start": 70.05,
   "end": 71.387,
   "id": "c31"
  },
  {
   "text": "再比如热钱包",
   "start": 72.368,
   "end": 73.633,
   "id": "c32"
  },
  {
   "text": "EIP-7702 授权一律拒签",
   "start": 73.76,
   "end": 76.549,
   "id": "c33"
  },
  {
   "text": "策略如果覆盖了这一条",
   "start": 76.925,
   "end": 78.619,
   "id": "c34"
  },
  {
   "text": "Binance 那批委托就签不出来",
   "start": 78.722,
   "end": 81.035,
   "id": "c35"
  },
  {
   "text": "第三 分链熔断",
   "start": 82.02,
   "end": 83.844,
   "id": "c36"
  },
  {
   "text": "某条链流出异常",
   "start": 84.22,
   "end": 85.782,
   "id": "c37"
  },
  {
   "text": "就停这条链的广播",
   "start": 85.874,
   "end": 87.187,
   "id": "c38"
  },
  {
   "text": "发现账本里没有对应订单的流出",
   "start": 88.168,
   "end": 90.683,
   "id": "c39"
  },
  {
   "text": "所有链一起停",
   "start": 90.834,
   "end": 92.064,
   "id": "c40"
  },
  {
   "text": "熔断的开关",
   "start": 92.427,
   "end": 93.561,
   "id": "c41"
  },
  {
   "text": "不能依赖已经被攻击的系统",
   "start": 93.689,
   "end": 95.442,
   "id": "c42"
  },
  {
   "text": "第四 紧急撤销",
   "start": 96.428,
   "end": 98.264,
   "id": "c43"
  },
  {
   "text": "7702 委托",
   "start": 98.64,
   "end": 100.226,
   "id": "c44"
  },
  {
   "text": "要用一笔新的授权",
   "start": 100.306,
   "end": 101.821,
   "id": "c45"
  },
  {
   "text": "把委托地址设成零地址",
   "start": 101.866,
   "end": 103.822,
   "id": "c46"
  },
  {
   "text": "才能清掉",
   "start": 103.842,
   "end": 104.75,
   "id": "c47"
  },
  {
   "text": "MPC 钱包没有一把单独的私钥能立刻做这件事",
   "start": 105.744,
   "end": 109.366,
   "id": "c48"
  },
  {
   "text": "所以要有一条独立的撤销路径",
   "start": 109.729,
   "end": 112.399,
   "id": "c49"
  },
  {
   "text": "预先批准",
   "start": 112.491,
   "end": 113.495,
   "id": "c50"
  },
  {
   "text": "每季度演练",
   "start": 113.658,
   "end": 114.78,
   "id": "c51"
  },
  {
   "text": "记下用时",
   "start": 114.848,
   "end": 115.887,
   "id": "c52"
  },
  {
   "text": "最后查一下账户代码",
   "start": 116.86,
   "end": 118.434,
   "id": "c53"
  },
  {
   "text": "结果为空",
   "start": 118.502,
   "end": 119.411,
   "id": "c54"
  },
  {
   "text": "才算完成",
   "start": 119.431,
   "end": 120.399,
   "id": "c55"
  },
  {
   "text": "也要说清局限",
   "start": 121.4,
   "end": 122.593,
   "id": "c56"
  },
  {
   "text": "架构挡不住所有内部人作恶",
   "start": 122.969,
   "end": 125.055,
   "id": "c57"
  },
  {
   "text": "它做的 是把一个人作恶",
   "start": 125.433,
   "end": 127.568,
   "id": "c58"
  },
  {
   "text": "变成需要多人共谋",
   "start": 127.588,
   "end": 128.972,
   "id": "c59"
  }
 ]
}