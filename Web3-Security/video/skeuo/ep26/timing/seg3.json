 "captions": [
  {
   "text": "一个持有钱包的智能体",
   "start": 1.648,
   "end": 3.401,
   "id": "c0"
  },
  {
   "text": "大致是这样工作的",
   "start": 3.445,
   "end": 4.699,
   "id": "c1"
  },
  {
   "text": "用户消息 网页",
   "start": 5.684,
   "end": 7.413,
   "id": "c2"
  },
  {
   "text": "长期记忆",
   "start": 7.493,
   "end": 8.508,
   "id": "c3"
  },
  {
   "text": "工具说明",
   "start": 8.66,
   "end": 9.651,
   "id": "c4"
  },
  {
   "text": "都会送进模型",
   "start": 9.779,
   "end": 10.973,
   "id": "c5"
  },
  {
   "text": "模型决定调用哪个工具",
   "start": 11.952,
   "end": 14.026,
   "id": "c6"
  },
  {
   "text": "比如钱包的转账和授权",
   "start": 14.094,
   "end": 16.241,
   "id": "c7"
  },
  {
   "text": "模型读到的每一种内容",
   "start": 17.236,
   "end": 19.001,
   "id": "c8"
  },
  {
   "text": "都是输入",
   "start": 19.236,
   "end": 20.06,
   "id": "c9"
  },
  {
   "text": "任何一种输入能影响它调用钱包",
   "start": 21.056,
   "end": 23.821,
   "id": "c10"
  },
  {
   "text": "就是一条攻击路径",
   "start": 23.901,
   "end": 25.249,
   "id": "c11"
  },
  {
   "text": "第一条 提示注入",
   "start": 26.244,
   "end": 28.009,
   "id": "c12"
  },
  {
   "text": "2026 年 5 月",
   "start": 29.008,
   "end": 30.249,
   "id": "c13"
  },
  {
   "text": "攻击者先往一个钱包里送了一枚会员 NFT",
   "start": 30.377,
   "end": 33.737,
   "id": "c14"
  },
  {
   "text": "借此提升了权限",
   "start": 33.781,
   "end": 35.213,
   "id": "c15"
  },
  {
   "text": "再诱导 Grok 回复一条转账指令",
   "start": 36.212,
   "end": 38.644,
   "id": "c16"
  },
  {
   "text": "Bankr 照着执行了",
   "start": 38.807,
   "end": 40.263,
   "id": "c17"
  },
  {
   "text": "一道屏蔽模型之间指令的防护",
   "start": 41.232,
   "end": 43.509,
   "id": "c18"
  },
  {
   "text": "在代码重写时被删掉了",
   "start": 43.66,
   "end": 45.794,
   "id": "c19"
  },
  {
   "text": "约 15 万到 20 万美元被转走",
   "start": 46.78,
   "end": 49.069,
   "id": "c20"
  },
  {
   "text": "约 80% 已经归还",
   "start": 49.303,
   "end": 51.307,
   "id": "c21"
  },
  {
   "text": "第二条 记忆注入",
   "start": 52.304,
   "end": 53.986,
   "id": "c22"
  },
  {
   "text": "攻击者在智能体能读到的地方",
   "start": 54.972,
   "end": 57.308,
   "id": "c23"
  },
  {
   "text": "写进一段伪造的历史记录",
   "start": 57.46,
   "end": 59.415,
   "id": "c24"
  },
  {
   "text": "智能体把它存进长期记忆",
   "start": 60.4,
   "end": 62.653,
   "id": "c25"
  },
  {
   "text": "之后的会话里",
   "start": 62.816,
   "end": 64.07,
   "id": "c26"
  },
  {
   "text": "当成事实来用",
   "start": 64.102,
   "end": 65.332,
   "id": "c27"
  },
  {
   "text": "没有任何新的恶意提示",
   "start": 66.332,
   "end": 68.228,
   "id": "c28"
  },
  {
   "text": "它也会执行未授权的转账",
   "start": 68.26,
   "end": 70.24,
   "id": "c29"
  },
  {
   "text": "普林斯顿和 Sentient 的研究者",
   "start": 71.232,
   "end": 73.497,
   "id": "c30"
  },
  {
   "text": "在 ElizaOS 智能体上证明了这一点",
   "start": 73.589,
   "end": 76.354,
   "id": "c31"
  },
  {
   "text": "第三条 工具和插件",
   "start": 77.332,
   "end": 79.359,
   "id": "c32"
  },
  {
   "text": "MCP 让模型连接外部工具",
   "start": 80.36,
   "end": 82.851,
   "id": "c33"
  },
  {
   "text": "工具说明",
   "start": 82.919,
   "end": 83.839,
   "id": "c34"
  },
  {
   "text": "用户看不到",
   "start": 83.895,
   "end": 84.875,
   "id": "c35"
  },
  {
   "text": "模型看得到",
   "start": 84.907,
   "end": 85.887,
   "id": "c36"
  },
  {
   "text": "2025 年 4 月",
   "start": 86.868,
   "end": 88.133,
   "id": "c37"
  },
  {
   "text": "Invariant Labs 演示",
   "start": 88.201,
   "end": 89.728,
   "id": "c38"
  },
  {
   "text": "恶意工具说明能诱导编程助手",
   "start": 89.927,
   "end": 92.324,
   "id": "c39"
  },
  {
   "text": "读取并外传 SSH 私钥",
   "start": 92.344,
   "end": 94.788,
   "id": "c40"
  },
  {
   "text": "PyPI 上还出现过一个钱包 MCP 包",
   "start": 95.776,
   "end": 98.779,
   "id": "c41"
  },
  {
   "text": "在多个版本里外传 Solana 私钥",
   "start": 98.859,
   "end": 101.315,
   "id": "c42"
  },
  {
   "text": "第四条 运维面板",
   "start": 102.308,
   "end": 104.132,
   "id": "c43"
  },
  {
   "text": "2025 年 3 月",
   "start": 105.12,
   "end": 106.349,
   "id": "c44"
  },
  {
   "text": "攻击者进入 AIXBT 的运维面板",
   "start": 106.512,
   "end": 108.706,
   "id": "c45"
  },
  {
   "text": "排进恶意回复",
   "start": 108.822,
   "end": 110.063,
   "id": "c46"
  },
  {
   "text": "触发打赏功能",
   "start": 110.155,
   "end": 111.397,
   "id": "c47"
  },
  {
   "text": "转走 55.5 ETH",
   "start": 111.417,
   "end": 113.063,
   "id": "c48"
  },
  {
   "text": "维护者称",
   "start": 114.052,
   "end": 115.019,
   "id": "c49"
  },
  {
   "text": "这不是在操纵 AI",
   "start": 115.087,
   "end": 116.531,
   "id": "c50"
  },
  {
   "text": "还有一种",
   "start": 117.512,
   "end": 118.336,
   "id": "c51"
  },
  {
   "text": "根本没人攻击",
   "start": 118.464,
   "end": 119.586,
   "id": "c52"
  },
  {
   "text": "2026 年 2 月",
   "start": 120.588,
   "end": 121.758,
   "id": "c53"
  },
  {
   "text": "交易智能体 Lobstar Wilde",
   "start": 121.778,
   "end": 123.651,
   "id": "c54"
  },
  {
   "text": "重建钱包状态出错",
   "start": 123.671,
   "end": 125.091,
   "id": "c55"
  },
  {
   "text": "把全部代币持仓转了出去",
   "start": 125.242,
   "end": 127.162,
   "id": "c56"
  },
  {
   "text": "约 25 万到 44 万美元的代币 据转述 是故障",
   "start": 128.152,
   "end": 132.691,
   "id": "c57"
  },
  {
   "text": "不是注入",
