 "captions": [
  {
   "text": "再看代码这一边",
   "start": 1.55,
   "end": 2.93,
   "id": "c0"
  },
  {
   "text": "2025 年 12 月",
   "start": 3.13,
   "end": 4.526,
   "id": "c1"
  },
  {
   "text": "Anthropic 发布 SCONE-bench",
   "start": 4.698,
   "end": 7.614,
   "id": "c2"
  },
  {
   "text": "收录 405 个历史上被利用过的真实合约",
   "start": 7.839,
   "end": 11.702,
   "id": "c3"
  },
  {
   "text": "对模型知识截止之后才出事的那批合约",
   "start": 11.99,
   "end": 15.55,
   "id": "c4"
  },
  {
   "text": "智能体在模拟环境里能盗取的金额",
   "start": 15.96,
   "end": 19.845,
   "id": "c5"
  },
  {
   "text": "合计约 460 万美元",
   "start": 19.972,
   "end": 21.975,
   "id": "c6"
  },
  {
   "text": "扫描新部署的 BSC 合约时",
   "start": 22.21,
   "end": 24.7,
   "id": "c7"
  },
  {
   "text": "它发现了 2 个此前未知的漏洞",
   "start": 24.962,
   "end": 27.241,
   "id": "c8"
  },
  {
   "text": "其中一个后来被攻击者真实利用",
   "start": 27.724,
   "end": 30.291,
   "id": "c9"
  },
  {
   "text": "这些测试全部在模拟器里进行",
   "start": 30.683,
   "end": 33.39,
   "id": "c10"
  },
  {
   "text": "另一些基准给出的数字更冷静",
   "start": 33.61,
   "end": 36.205,
   "id": "c11"
  },
  {
   "text": "EVMbench 和后续复评里",
   "start": 36.39,
   "end": 38.724,
   "id": "c12"
  },
  {
   "text": "最佳检测率约 46%",
   "start": 38.888,
   "end": 41.139,
   "id": "c13"
  },
  {
   "text": "在 22 起真实事件上",
   "start": 41.502,
   "end": 43.488,
   "id": "c14"
  },
  {
   "text": "没有一组智能体完成端到端的利用",
   "start": 43.592,
   "end": 46.397,
   "id": "c15"
  },
  {
   "text": "AI 在降低利用漏洞的成本",
   "start": 46.773,
   "end": 48.969,
   "id": "c16"
  },
  {
   "text": "但在真实的复杂系统上",
   "start": 49.149,
   "end": 50.975,
   "id": "c17"
  },
  {
   "text": "仍明显弱于基准表现",
   "start": 51.098,
   "end": 52.893,
   "id": "c18"
  },
  {
   "text": "对防守方来说",
   "start": 53.13,
   "end": 54.407,
   "id": "c19"
  },
  {
   "text": "最确定的影响是",
   "start": 54.497,
   "end": 55.823,
   "id": "c20"
  },
  {
   "text": "修复要更快",
   "start": 55.91,
   "end": 57.409,
   "id": "c21"
  },
  {
   "text": "AI 写的代码",
   "start": 57.768,
   "end": 58.744,
   "id": "c22"
  },
  {
   "text": "同样会出错",
   "start": 58.866,
   "end": 59.891,
   "id": "c23"
  },
  {
   "text": "2026 年 2 月",
   "start": 60.13,
   "end": 62.296,
   "id": "c24"
  },
  {
   "text": "Moonwell 上线新的价格包装器",
   "start": 62.316,
   "end": 64.932,
   "id": "c25"
  },
  {
   "text": "cbETH 只取了它对 ETH 的汇率",
   "start": 64.952,
   "end": 67.876,
   "id": "c26"
  },
  {
   "text": "漏乘 ETH 的美元价格",
   "start": 68.148,
   "end": 70.19,
   "id": "c27"
  },
  {
   "text": "cbETH 被定价成约 1.12 美元",
   "start": 70.43,
   "end": 73.228,
   "id": "c28"
  },
  {
   "text": "引发大量清算",
   "start": 73.405,
   "end": 76.036,
   "id": "c29"
  },
  {
   "text": "留下约 178 万美元坏账",
   "start": 76.165,
   "end": 78.983,
   "id": "c30"
  },
  {
   "text": "相关提交里",
   "start": 79.21,
   "end": 80.447,
   "id": "c31"
  },
  {
   "text": "有 AI 编程助手署名的共同作者",
   "start": 80.615,
   "end": 83.21,
   "id": "c32"
  },
  {
   "text": "项目方没有把事故归因于 AI",
   "start": 83.604,
   "end": 86.356,
   "id": "c33"
  },
  {
   "text": "人类同样会犯这个错",
   "start": 86.654,
   "end": 88.41,
   "id": "c34"
  },
  {
   "text": "2025 年 7 月",
   "start": 88.69,
   "end": 90.046,
   "id": "c35"
  },
  {
   "text": "一个假的 Solidity 扩展上架插件市场",
   "start": 90.091,
   "end": 93.364,
   "id": "c36"
  },
  {
   "text": "一名区块链开发者被盗约 50 万美元",
   "start": 93.561,
   "end": 96.758,
   "id": "c37"
  },
  {
   "text": "模型还会编出不存在的包名",
   "start": 96.99,
   "end": 99.495,
   "id": "c38"
  },
  {
   "text": "攻击者抢先注册",
   "start": 100.095,
   "end": 101.567,
   "id": "c39"
  },
  {
   "text": "这叫幻觉包名",
   "start": 101.831,
   "end": 103.329,
   "id": "c40"
  },
  {
   "text": "2026 年 10 月",
   "start": 103.634,
   "end": 104.97,
   "id": "c41"
  },
  {
   "text": "Binance 报告称",
   "start": 105.061,
   "end": 106.239,
   "id": "c42"
  },
  {
   "text": "攻击者借助一个内部 AI 工具",
   "start": 106.405,
   "end": 108.973,
   "id": "c43"
  },
  {
   "text": "控制了另外两名钱包工程师的电脑",
   "start": 109.118,
   "end": 111.91,
   "id": "c44"
  },
  {
   "text": "工具名称和机制",
   "start": 112.15,
   "end": 113.753,
   "id": "c45"
  },
  {
   "text": "Binance 没有公开",
   "start": 113.825,
   "end": 115.023,
   "id": "c46"
  },
  {
   "text": "AI 也能帮防守方",
   "start": 115.352,
   "end": 117.051,
   "id": "c47"
  },
  {
   "text": "做大范围初筛",
   "start": 117.164,
   "end": 118.458,
   "id": "c48"
  },
  {
   "text": "起草测试",
   "start": 118.612,
   "end": 119.5,
   "id": "c49"
  },
  {
   "text": "给告警分诊",
   "start": 119.616,
   "end": 120.772,
   "id": "c50"
  },
  {
   "text": "但业务逻辑审查",
   "start": 121.166,
   "end": 122.946,
   "id": "c51"
  },
  {
   "text": "判断发现能不能真正利用",
   "start": 123.042,
   "end": 125.548,
   "id": "c52"
  },
  {
   "text": "对结论负责",
   "start": 125.619,
   "end": 126.824,
   "id": "c53"
  },
  {
   "text": "仍然要靠人",
   "start": 126.925,
   "end": 128.127,
   "id": "c54"
  }
 ]
