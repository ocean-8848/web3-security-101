  {
   "text": "2025 年 12 月",
   "start": 3.932,
   "end": 5.304,
   "id": "c1"
  },
  {
   "text": "Anthropic 发布 SCONE-bench",
   "start": 5.372,
   "end": 7.411,
   "id": "c2"
  },
  {
   "text": "收录 405 个历史上被利用过的真实合约",
   "start": 7.539,
   "end": 10.637,
   "id": "c3"
  },
  {
   "text": "对模型知识截止之后才出事的那批合约",
   "start": 11.64,
   "end": 14.75,
   "id": "c4"
  },
  {
   "text": "智能体在模拟环境里能盗取的金额",
   "start": 14.925,
   "end": 17.882,
   "id": "c5"
  },
  {
   "text": "合计约 460 万美元",
   "start": 17.902,
   "end": 19.798,
   "id": "c6"
  },
  {
   "text": "扫描新部署的 BSC 合约时",
   "start": 20.788,
   "end": 23.231,
   "id": "c7"
  },
  {
   "text": "它发现了 2 个此前未知的漏洞",
   "start": 23.323,
   "end": 25.374,
   "id": "c8"
  },
  {
   "text": "其中一个后来被攻击者真实利用",
   "start": 25.466,
   "end": 27.969,
   "id": "c9"
  },
  {
   "text": "这些测试全部在模拟器里进行",
   "start": 28.952,
   "end": 31.491,
   "id": "c10"
  },
  {
   "text": "另一些基准给出的数字更冷静",
   "start": 32.484,
   "end": 34.832,
   "id": "c11"
  },
  {
   "text": "EVMbench 和后续复评里",
   "start": 35.8,
   "end": 37.862,
   "id": "c12"
  },
  {
   "text": "最佳检测率约 46%",
   "start": 37.895,
   "end": 40.22,
   "id": "c13"
  },
  {
   "text": "在 22 起真实事件上",
   "start": 41.204,
   "end": 43.076,
   "id": "c14"
  },
  {
   "text": "没有一组智能体完成端到端的利用",
   "start": 43.263,
   "end": 45.945,
   "id": "c15"
  },
  {
   "text": "AI 在降低利用漏洞的成本",
   "start": 46.944,
   "end": 49.328,
   "id": "c16"
  },
  {
   "text": "但在真实的复杂系统上",
   "start": 49.372,
   "end": 51.137,
   "id": "c17"
  },
  {
   "text": "仍明显弱于基准表现",
   "start": 51.241,
   "end": 53.114,
   "id": "c18"
  },
  {
   "text": "对防守方来说",
   "start": 54.1,
   "end": 55.424,
   "id": "c19"
  },
  {
   "text": "最确定的影响是",
   "start": 55.588,
   "end": 56.924,
   "id": "c20"
  },
  {
   "text": "修复要更快",
   "start": 56.969,
   "end": 58.055,
   "id": "c21"
  },
  {
   "text": "AI 写的代码",
   "start": 59.024,
   "end": 60.289,
   "id": "c22"
  },
  {
   "text": "同样会出错",
   "start": 60.345,
   "end": 61.384,
   "id": "c23"
  },
  {
   "text": "2026 年 2 月",
   "start": 62.364,
   "end": 63.617,
   "id": "c24"
  },
  {
   "text": "Moonwell 上线新的价格包装器",
   "start": 63.792,
   "end": 66.141,
   "id": "c25"
  },
  {
   "text": "cbETH 只取了它对 ETH 的汇率",
   "start": 66.256,
   "end": 69.284,
   "id": "c26"
  },
  {
   "text": "漏乘 ETH 的美元价格",
   "start": 69.304,
   "end": 71.105,
   "id": "c27"
  },
  {
   "text": "cbETH 被定价成约 1.12 美元",
   "start": 72.088,
   "end": 75.317,
   "id": "c28"
  },
  {
   "text": "引发大量清算",
   "start": 75.48,
   "end": 76.722,
   "id": "c29"
  },
  {
   "text": "留下约 178 万美元坏账",
   "start": 76.742,
   "end": 78.829,
   "id": "c30"
  },
  {
   "text": "相关提交里",
   "start": 79.82,
   "end": 80.93,
   "id": "c31"
  },
  {
   "text": "有 AI 编程助手署名的共同作者",
   "start": 81.07,
   "end": 84.085,
   "id": "c32"
  },
  {
   "text": "项目方没有把事故归因于 AI",
   "start": 85.08,
   "end": 87.404,
   "id": "c33"
  },
  {
   "text": "人类同样会犯这个错",
   "start": 87.461,
   "end": 88.976,
   "id": "c34"
  },
  {
   "text": "2025 年 7 月",
   "start": 89.956,
   "end": 91.185,
   "id": "c35"
  },
  {
   "text": "一个假的 Solidity 扩展上架插件市场",
   "start": 91.301,
   "end": 94.566,
   "id": "c36"
  },
  {
   "text": "一名区块链开发者被盗约 50 万美元",
   "start": 94.729,
   "end": 97.614,
   "id": "c37"
  },
  {
   "text": "模型还会编出不存在的包名",
   "start": 98.6,
   "end": 100.758,
   "id": "c38"
  },
  {
   "text": "攻击者抢先注册",
   "start": 100.921,
   "end": 102.437,
   "id": "c39"
  },
  {
   "text": "这叫幻觉包名",
   "start": 102.457,
   "end": 103.698,
   "id": "c40"
  },
  {
   "text": "2026 年 10 月",
   "start": 104.7,
   "end": 105.965,
   "id": "c41"
  },
  {
   "text": "Binance 报告称",
   "start": 106.069,
   "end": 107.298,
   "id": "c42"
  },
  {
   "text": "攻击者借助一个内部 AI 工具",
   "start": 107.462,
   "end": 109.679,
   "id": "c43"
  },
  {
   "text": "控制了另外两名钱包工程师的电脑",
   "start": 109.712,
   "end": 112.12,
   "id": "c44"
  },
  {
   "text": "工具名称和机制",
   "start": 113.104,
   "end": 114.726,
   "id": "c45"
  },
  {
   "text": "Binance 没有公开",
   "start": 114.758,
   "end": 116.464,
   "id": "c46"
  },
  {
   "text": "AI 也能帮防守方",
   "start": 117.452,
   "end": 119.467,
   "id": "c47"
  },
  {
   "text": "做大范围初筛",
   "start": 119.594,
   "end": 120.895,
   "id": "c48"
  },
  {
   "text": "起草测试",
   "start": 120.916,
   "end": 121.932,
   "id": "c49"
  },
  {
   "text": "给告警分诊",
   "start": 121.952,
   "end": 123.014,
   "id": "c50"
  },
  {
   "text": "但业务逻辑审查",
   "start": 124.008,
   "end": 125.511,
   "id": "c51"
  },
  {
   "text": "判断发现能不能真正利用",
   "start": 125.746,
   "end": 127.916,
   "id": "c52"
  },
  {
   "text": "对结论负责",
   "start": 128.055,
   "end": 129.154,
   "id": "c53"
  },
  {
   "text": "仍然要靠人",
