 "captions": [
  {
   "text": "第四种 新增的函数",
   "start": 1.648,
   "end": 3.818,
   "id": "c0"
  },
  {
   "text": "绕过了原有的检查",
   "start": 3.85,
   "end": 5.294,
   "id": "c1"
  },
  {
   "text": "2023 年 3 月",
   "start": 6.284,
   "end": 7.489,
   "id": "c2"
  },
  {
   "text": "Euler Finance 损失约 1.97 亿美元",
   "start": 7.581,
   "end": 10.525,
   "id": "c3"
  },
  {
   "text": "大部分后来归还",
   "start": 10.557,
   "end": 11.846,
   "id": "c4"
  },
  {
   "text": "根因是新加的捐赠函数",
   "start": 12.84,
   "end": 14.891,
   "id": "c5"
  },
  {
   "text": "没有做健康检查",
   "start": 14.982,
   "end": 16.474,
   "id": "c6"
  },
  {
   "text": "别的入口都检查了",
   "start": 17.476,
   "end": 19.098,
   "id": "c7"
  },
  {
   "text": "偏偏新入口漏掉了",
   "start": 19.249,
   "end": 20.693,
   "id": "c8"
  },
  {
   "text": "识别信号是",
   "start": 21.68,
   "end": 22.933,
   "id": "c9"
  },
  {
   "text": "新增了一个能改余额或债务的入口",
   "start": 23.025,
   "end": 25.957,
   "id": "c10"
  },
  {
   "text": "防御是统一的操作后检查",
   "start": 26.94,
   "end": 29.038,
   "id": "c11"
  },
  {
   "text": "所有入口都要经过",
   "start": 29.225,
   "end": 30.753,
   "id": "c12"
  },
  {
   "text": "再用不变量测试兜底",
   "start": 30.773,
   "end": 32.288,
   "id": "c13"
  },
  {
   "text": "第五种 改动过的分叉和新版本",
   "start": 33.28,
   "end": 35.973,
   "id": "c14"
  },
  {
   "text": "没有重新审计",
   "start": 36.101,
   "end": 37.283,
   "id": "c15"
  },
  {
   "text": "2021 年 4 月的 Uranium Finance",
   "start": 38.276,
   "end": 40.981,
   "id": "c16"
  },
  {
   "text": "分叉了 Uniswap V2",
   "start": 41.133,
   "end": 43.148,
   "id": "c17"
  },
  {
   "text": "改手续费时",
   "start": 44.136,
   "end": 45.354,
   "id": "c18"
  },
  {
   "text": "漏改了一个常数",
   "start": 45.374,
   "end": 46.615,
   "id": "c19"
  },
  {
   "text": "恒定乘积的检查就此失效",
   "start": 46.719,
   "end": 48.71,
   "id": "c20"
  },
  {
   "text": "损失约 5000 万美元",
   "start": 48.838,
   "end": 50.698,
   "id": "c21"
  },
  {
   "text": "识别信号只有一句话",
   "start": 51.676,
   "end": 53.524,
   "id": "c22"
  },
  {
   "text": "只改了一行",
   "start": 53.652,
   "end": 54.655,
   "id": "c23"
  },
  {
   "text": "防御是改动即重审",
   "start": 55.616,
   "end": 57.381,
   "id": "c24"
  },
  {
   "text": "对差异做审计",
   "start": 57.556,
   "end": 58.857,
   "id": "c25"
  },
  {
   "text": "第六种 签名人看不懂自己签的是什么",
   "start": 59.844,
   "end": 62.835,
   "id": "c26"
  },
  {
   "text": "2024 年 7 月的 WazirX",
   "start": 63.808,
   "end": 65.847,
   "id": "c27"
  },
  {
   "text": "签名人看到的",
   "start": 65.867,
   "end": 66.942,
   "id": "c28"
  },
  {
   "text": "和签下的不一致",
   "start": 66.962,
   "end": 68.132,
   "id": "c29"
  },
  {
   "text": "损失约 2.3 亿美元",
   "start": 68.177,
   "end": 70.061,
   "id": "c30"
  },
