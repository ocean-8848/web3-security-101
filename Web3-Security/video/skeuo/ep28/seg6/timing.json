 "captions": [
  {
   "text": "认出模式之后",
   "start": 1.55,
   "end": 2.767,
   "id": "c0"
  },
  {
   "text": "还要会写复盘",
   "start": 3.025,
   "end": 4.287,
   "id": "c1"
  },
  {
   "text": "先写一句话摘要",
   "start": 4.66,
   "end": 6.063,
   "id": "c2"
  },
  {
   "text": "损失多少",
   "start": 6.221,
   "end": 7.15,
   "id": "c3"
  },
  {
   "text": "是否追回",
   "start": 7.17,
   "end": 8.104,
   "id": "c4"
  },
  {
   "text": "再写时间线",
   "start": 8.39,
   "end": 9.589,
   "id": "c5"
  },
  {
   "text": "漏洞在哪个版本引入",
   "start": 9.757,
   "end": 11.587,
   "id": "c6"
  },
  {
   "text": "攻击交易",
   "start": 11.763,
   "end": 12.668,
   "id": "c7"
  },
  {
   "text": "发现与响应",
   "start": 12.827,
   "end": 14.16,
   "id": "c8"
  },
  {
   "text": "根因分两层",
   "start": 14.468,
   "end": 15.746,
   "id": "c9"
  },
  {
   "text": "直接原因是代码哪一行",
   "start": 15.978,
   "end": 17.922,
   "id": "c10"
  },
  {
   "text": "根本原因是流程哪一环缺失",
   "start": 18.107,
   "end": 20.346,
   "id": "c11"
  },
  {
   "text": "最后写 哪个关口本可以拦住它",
   "start": 20.59,
   "end": 23.112,
   "id": "c12"
  },
  {
   "text": "被打破的不变量",
   "start": 23.321,
   "end": 24.488,
   "id": "c13"
  },
  {
   "text": "还有防御清单",
   "start": 24.757,
   "end": 25.919,
   "id": "c14"
  },
  {
   "text": "练习时 每周选一起",
   "start": 26.17,
   "end": 28.346,
   "id": "c15"
  },
  {
   "text": "只看交易哈希",
   "start": 28.366,
   "end": 29.78,
   "id": "c16"
  },
  {
   "text": "用调用树找根因",
   "start": 30.239,
   "end": 31.01,
   "id": "c17"
  },
  {
   "text": "再对照复盘",
   "start": 31.03,
   "end": 32.366,
   "id": "c18"
  },
  {
   "text": "找出自己漏掉的步骤",
   "start": 32.386,
   "end": 34.988,
   "id": "c19"
  },
  {
   "text": "事件库只是线索",
   "start": 35.27,
   "end": 36.912,
   "id": "c20"
  },
  {
   "text": "金额和根因要回到一手资料核对",
   "start": 37.187,
   "end": 40.072,
   "id": "c21"
  },
  {
   "text": "复现只在本地或分叉环境里做",
   "start": 40.259,
   "end": 42.971,
   "id": "c22"
  },
  {
   "text": "今天就能做一件事",
   "start": 43.25,
   "end": 44.64,
   "id": "c23"
  },
  {
   "text": "写代码的人",
   "start": 44.91,
   "end": 46.092,
   "id": "c24"
  },
  {
   "text": "拿八个识别信号",
   "start": 46.347,
   "end": 47.599,
   "id": "c25"
  },
  {
   "text": "查一遍自己最近的改动",
   "start": 47.653,
   "end": 49.34,
   "id": "c26"
  },
  {
   "text": "管资产的人",
   "start": 49.703,
   "end": 50.718,
   "id": "c27"
  },
  {
   "text": "数一数控制资金的钥匙有几把",
   "start": 50.849,
   "end": 53.478,
   "id": "c28"
  },
  {
   "text": "有没有时间锁",
   "start": 53.686,
   "end": 55.072,
   "id": "c29"
  },
  {
   "text": "回到开头的问题",
   "start": 55.35,
   "end": 56.701,
   "id": "c30"
  },
  {
   "text": "修过的漏洞会回来",
   "start": 56.93,
   "end": 58.742,
   "id": "c31"
  },
  {
   "text": "是因为环境变了 新链 新分叉 新版本 新组合",
   "start": 58.859,
   "end": 63.866,
   "id": "c32"
  },
  {
   "text": "检查却没跟上",
   "start": 63.964,
   "end": 65.269,
   "id": "c33"
  },
  {
   "text": "读旧事故",
   "start": 65.65,
   "end": 66.519,
   "id": "c34"
  },
  {
   "text": "能帮我们提前认出下一起",
   "start": 66.566,
   "end": 68.673,
   "id": "c35"
  },
  {
   "text": "前提是记住模式和信号",
   "start": 68.909,
   "end": 71.203,
   "id": "c36"
  },
  {
   "text": "而不是名字",
   "start": 71.274,
   "end": 72.228,
   "id": "c37"
  },
  {
   "text": "也要说清边界",
   "start": 72.587,
   "end": 73.764,
   "id": "c38"
  },
  {
   "text": "档案馆只认得出旧模式",
   "start": 73.982,
   "end": 76.337,
   "id": "c39"
  },
  {
   "text": "真正的新漏洞",
   "start": 76.58,
   "end": 77.673,
   "id": "c40"
  },
  {
   "text": "这里还没有展品",
   "start": 77.786,
   "end": 79.145,
   "id": "c41"
  },
  {
   "text": "同样的错误",
   "start": 79.525,
   "end": 80.451,
   "id": "c42"
  },
  {
   "text": "会换个名字再来 认出它",
   "start": 80.471,
   "end": 82.714,
   "id": "c43"
  },
  {
   "text": "靠的是模式",
   "start": 82.734,
   "end": 83.751,
   "id": "c44"
  },
  {
   "text": "下一集讲 2026 年的签名路径安全",
   "start": 84.144,
   "end": 87.994,
   "id": "c45"
  }
