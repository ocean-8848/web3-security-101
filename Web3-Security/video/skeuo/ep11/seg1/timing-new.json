 "captions": [
  {
   "text": "2023 年 3 月 13 日",
   "start": 1.648,
   "end": 3.306,
   "id": "c0"
  },
  {
   "text": "借贷协议 Euler Finance",
   "start": 3.326,
   "end": 5.353,
   "id": "c1"
  },
  {
   "text": "损失约 1.97 亿美元",
   "start": 5.41,
   "end": 7.485,
   "id": "c2"
  },
  {
   "text": "按事发时估值",
   "start": 7.505,
   "end": 8.794,
   "id": "c3"
  },
  {
   "text": "入口 是一个捐赠函数",
   "start": 9.788,
   "end": 12.136,
   "id": "c4"
  },
  {
   "text": "它让用户把自己的存款",
   "start": 13.128,
   "end": 15.036,
   "id": "c5"
  },
  {
   "text": "捐给协议的储备",
   "start": 15.092,
   "end": 16.333,
   "id": "c6"
  },
  {
   "text": "捐出去 账户的抵押品就少了",
   "start": 17.332,
   "end": 19.883,
   "id": "c7"
  },
  {
   "text": "但这个函数",
   "start": 20.864,
   "end": 21.903,
   "id": "c8"
  },
  {
   "text": "不检查账户是否仍然健康",
   "start": 22.078,
   "end": 24.557,
   "id": "c9"
  },
  {
   "text": "先猜一道题",
   "start": 25.548,
   "end": 26.872,
   "id": "c10"
  },
  {
   "text": "举个例子",
   "start": 27.856,
   "end": 28.752,
   "id": "c11"
  },
  {
   "text": "一个账户有 100 美元抵押品",
   "start": 29.127,
   "end": 31.487,
   "id": "c12"
  },
  {
   "text": "借了 90 美元",
   "start": 31.615,
   "end": 32.892,
   "id": "c13"
  },
  {
   "text": "它捐出 30 美元抵押品",
   "start": 33.884,
   "end": 35.685,
   "id": "c14"
  },
  {
   "text": "没人检查",
   "start": 35.8,
   "end": 36.911,
   "id": "c15"
  },
  {
   "text": "也没人偿还",
   "start": 37.003,
   "end": 38.149,
   "id": "c16"
  },
  {
   "text": "协议的缺口是多少",
   "start": 38.512,
   "end": 40.027,
   "id": "c17"
  },
  {
   "text": "缺口是 20 美元",
   "start": 41.296,
   "end": 42.93,
   "id": "c18"
  },
  {
   "text": "账户只剩 70 美元抵押品",
   "start": 43.916,
   "end": 46.121,
   "id": "c19"
  },
  {
   "text": "却欠着 90 美元",
   "start": 46.166,
   "end": 47.74,
   "id": "c20"
  },
  {
   "text": "这 20 美元成了坏账",
   "start": 48.72,
   "end": 50.294,
   "id": "c21"
  },
  {
   "text": "最后由存款人或保险基金承担",
   "start": 50.458,
   "end": 53.044,
   "id": "c22"
  },
  {
   "text": "每个函数单独看",
   "start": 54.028,
   "end": 55.507,
   "id": "c23"
  },
  {
   "text": "都没有错",
   "start": 55.67,
   "end": 56.507,
   "id": "c24"
  },
  {
   "text": "攻击者也没有利用代码 bug",
   "start": 57.488,
   "end": 59.42,
   "id": "c25"
  },
  {
   "text": "他只是按规则操作",
   "start": 59.783,
   "end": 61.286,
   "id": "c26"
  },
  {
   "text": "换了一种设计者没想到的组合",
   "start": 61.366,
   "end": 63.429,
   "id": "c27"
  },
  {
   "text": "规则本身",
   "start": 64.404,
   "end": 65.443,
   "id": "c28"
  },
  {
   "text": "怎么会让协议亏钱",
   "start": 65.618,
   "end": 67.026,
   "id": "c29"
  }
 ]
}