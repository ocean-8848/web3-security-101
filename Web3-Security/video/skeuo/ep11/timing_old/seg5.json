 "captions": [
  {
   "text": "回头看这些事故",
   "start": 1.55,
   "end": 2.919,
   "id": "c0"
  },
  {
   "text": "攻击者大多没有找到代码 bug",
   "start": 3.109,
   "end": 5.858,
   "id": "c1"
  },
  {
   "text": "他们改变的",
   "start": 6.09,
   "end": 6.987,
   "id": "c2"
  },
  {
   "text": "是三样东西 顺序 规模 时间",
   "start": 7.03,
   "end": 10.528,
   "id": "c3"
  },
  {
   "text": "防御也按这三样来设计",
   "start": 10.79,
   "end": 12.749,
   "id": "c4"
  },
  {
   "text": "先说顺序",
   "start": 13.01,
   "end": 13.874,
   "id": "c5"
  },
  {
   "text": "任何会减少抵押品",
   "start": 14.109,
   "end": 15.913,
   "id": "c6"
  },
  {
   "text": "或者增加债务的路径",
   "start": 15.99,
   "end": 17.733,
   "id": "c7"
  },
  {
   "text": "都必须在结束时检查健康因子",
   "start": 17.867,
   "end": 20.651,
   "id": "c8"
  },
  {
   "text": "新增一个函数",
   "start": 20.91,
   "end": 22.167,
   "id": "c9"
  },
  {
   "text": "就要确认它走了这道检查",
   "start": 22.245,
   "end": 24.269,
   "id": "c10"
  },
  {
   "text": "Euler 缺的",
   "start": 24.492,
   "end": 25.025,
   "id": "c11"
  },
  {
   "text": "就是这一步",
   "start": 25.045,
   "end": 26.148,
   "id": "c12"
  },
  {
   "text": "再说规模",
   "start": 26.41,
   "end": 27.37,
   "id": "c13"
  },
  {
   "text": "低流动性抵押品要有供应上限",
   "start": 27.883,
   "end": 30.326,
   "id": "c14"
  },
  {
   "text": "自家代币做抵押",
   "start": 30.685,
   "end": 31.987,
   "id": "c15"
  },
  {
   "text": "要有额外限制",
   "start": 32.007,
   "end": 33.156,
   "id": "c16"
  },
  {
   "text": "清算奖励在极端行情下也要有吸引力",
   "start": 33.43,
   "end": 36.755,
   "id": "c17"
  },
  {
   "text": "清算折扣要有上限",
   "start": 36.936,
   "end": 38.527,
   "id": "c18"
  },
  {
   "text": "铸币要有单笔和每日的累计限额",
   "start": 38.869,
   "end": 42.326,
   "id": "c19"
  },
  {
   "text": "多人审批",
   "start": 42.548,
   "end": 43.533,
   "id": "c20"
  },
  {
   "text": "异常时熔断",
   "start": 43.756,
   "end": 44.819,
   "id": "c21"
  },
  {
   "text": "三个签名人里一人就够",
   "start": 45.07,
   "end": 47.04,
   "id": "c22"
  },
  {
   "text": "等于只有一个签名人",
   "start": 47.277,
   "end": 48.896,
   "id": "c23"
  },
  {
   "text": "抵押品估值",
   "start": 49.226,
   "end": 50.352,
   "id": "c24"
  },
  {
   "text": "不能只看一家交易所的订单簿",
   "start": 50.49,
   "end": 52.818,
   "id": "c25"
  },
  {
   "text": "最后是时间",
   "start": 53.03,
   "end": 54.348,
   "id": "c26"
  },
  {
   "text": "投票权用历史快照",
   "start": 54.527,
   "end": 56.405,
   "id": "c27"
  },
  {
   "text": "提案执行要过时间锁",
   "start": 56.672,
   "end": 58.669,
   "id": "c28"
  },
  {
   "text": "提款和赎回",
   "start": 58.93,
   "end": 60.348,
   "id": "c29"
  },
  {
   "text": "也可以设延迟",
   "start": 60.44,
   "end": 61.508,
   "id": "c30"
  },
  {
   "text": "2025 年 2 月 Bybit 被盗以后",
   "start": 61.896,
   "end": 64.853,
   "id": "c31"
  },
  {
   "text": "攻击者尝试赎回 cmETH",
   "start": 64.969,
   "end": 67.862,
   "id": "c32"
  },
  {
   "text": "按 The Block 报道",
   "start": 68.184,
   "end": 69.469,
   "id": "c33"
  },
  {
   "text": "mETH 协议有 8 小时的提款延迟",
   "start": 69.718,
   "end": 72.805,
   "id": "c34"
  },
  {
   "text": "团队趁这段时间暂停了合约",
   "start": 73.03,
   "end": 76.216,
   "id": "c35"
  },
  {
   "text": "追回 15000 枚 cmETH",
   "start": 76.316,
   "end": 78.682,
   "id": "c36"
  },
  {
   "text": "约 4300 万美元",
   "start": 78.921,
   "end": 80.84,
   "id": "c37"
  },
  {
   "text": "延迟把攻击者完成攻击的时间",
   "start": 81.185,
   "end": 83.701,
   "id": "c38"
  },
  {
   "text": "从一笔交易拉长到几个小时",
   "start": 83.804,
   "end": 86.403,
   "id": "c39"
  },
  {
   "text": "让监控和人工响应有机会介入",
   "start": 86.618,
   "end": 89.178,
   "id": "c40"
  },
  {
   "text": "代价是 正常用户也要等",
   "start": 89.561,
   "end": 92.289,
   "id": "c41"
  },
  {
   "text": "所以延迟是一种安全参数",
   "start": 92.57,
   "end": 95.444,
   "id": "c42"
  },
  {
   "text": "不只是体验问题",
   "start": 95.671,
   "end": 96.991,
   "id": "c43"
  }
 ]
}