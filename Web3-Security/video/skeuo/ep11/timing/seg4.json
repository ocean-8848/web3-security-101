 "captions": [
  {
   "text": "另有一类风险",
   "start": 1.648,
   "end": 2.841,
   "id": "c0"
  },
  {
   "text": "根本不在合约里",
   "start": 3.005,
   "end": 4.21,
   "id": "c1"
  },
  {
   "text": "稳定币和代币化的现实资产",
   "start": 5.18,
   "end": 7.433,
   "id": "c2"
  },
  {
   "text": "把链下资产带上了链",
   "start": 7.596,
   "end": 9.278,
   "id": "c3"
  },
  {
   "text": "它们值多少",
   "start": 10.248,
   "end": 11.299,
   "id": "c4"
  },
  {
   "text": "不看合约代码",
   "start": 11.426,
   "end": 12.584,
   "id": "c5"
  },
  {
   "text": "看链下的储备 赎回",
   "start": 12.605,
   "end": 14.691,
   "id": "c6"
  },
  {
   "text": "和发行方的权限",
   "start": 14.712,
   "end": 16.037,
   "id": "c7"
  },
  {
   "text": "打个比方",
   "start": 17.02,
   "end": 17.975,
   "id": "c8"
  },
  {
   "text": "稳定币像一张银行开的提货单",
   "start": 18.339,
   "end": 20.794,
   "id": "c9"
  },
  {
   "text": "提货单印得再精美",
   "start": 21.776,
   "end": 23.184,
   "id": "c10"
  },
  {
   "text": "只要仓库里的货不够",
   "start": 23.323,
   "end": 24.719,
   "id": "c11"
  },
  {
   "text": "仓库被封",
   "start": 24.752,
   "end": 25.827,
   "id": "c12"
  },
  {
   "text": "或者银行能随时作废它",
   "start": 26.014,
   "end": 27.838,
   "id": "c13"
  },
  {
   "text": "它就不值一美元",
   "start": 27.978,
   "end": 29.172,
   "id": "c14"
  },
  {
   "text": "比喻在这里不成立",
   "start": 30.132,
   "end": 31.587,
   "id": "c15"
  },
  {
   "text": "作废提货单",
   "start": 31.822,
   "end": 32.897,
   "id": "c16"
  },
  {
   "text": "要走法律程序",
   "start": 32.917,
   "end": 34.242,
   "id": "c17"
  },
  {
   "text": "冻结或销毁一个地址上的代币",
   "start": 34.617,
   "end": 36.847,
   "id": "c18"
  },
  {
   "text": "通常只要一笔交易",
   "start": 36.903,
   "end": 38.264,
   "id": "c19"
  },
  {
   "text": "DeFi 协议拿它做抵押品",
   "start": 39.256,
   "end": 41.485,
   "id": "c20"
  },
  {
   "text": "就继承了这些链下风险",
   "start": 41.506,
   "end": 43.057,
   "id": "c21"
  },
  {
   "text": "风险分五类",
   "start": 44.036,
   "end": 45.277,
   "id": "c22"
  },
  {
   "text": "第一类 储备与托管",
   "start": 45.64,
   "end": 47.584,
   "id": "c23"
  },
  {
   "text": "2023 年 3 月",
   "start": 48.576,
   "end": 49.806,
   "id": "c24"
  },
  {
   "text": "按 Circle 的声明",
   "start": 49.826,
   "end": 51.138,
   "id": "c25"
  },
  {
   "text": "约 33 亿美元储备存在倒闭的硅谷银行",
   "start": 51.183,
   "end": 54.567,
   "id": "c26"
  },
  {
   "text": "按 The Block 报道",
   "start": 55.564,
   "end": 56.793,
   "id": "c27"
  },
  {
   "text": "USDC 最低跌到约 0.87 美元",
   "start": 57.004,
   "end": 59.769,
   "id": "c28"
  },
  {
   "text": "以它为主要抵押的 DAI",
   "start": 60.145,
   "end": 61.672,
   "id": "c29"
  },
  {
   "text": "也跌到约 0.90 美元",
   "start": 61.692,
   "end": 63.517,
   "id": "c30"
  },
  {
   "text": "第二类 设计缺陷",
   "start": 64.496,
   "end": 66.273,
   "id": "c31"
  },
  {
   "text": "2022 年 5 月",
   "start": 66.648,
   "end": 67.889,
   "id": "c32"
  },
  {
   "text": "算法稳定币 Terra UST 挤兑",
   "start": 67.91,
   "end": 70.354,
   "id": "c33"
  },
  {
   "text": "进入死亡螺旋",
   "start": 70.41,
   "end": 71.711,
   "id": "c34"
  },
  {
   "text": "约 400 亿美元市值蒸发",
   "start": 71.755,
   "end": 73.735,
   "id": "c35"
  },
  {
   "text": "第三类 铸币权限",
   "start": 74.724,
   "end": 76.632,
   "id": "c36"
  },
  {
   "text": "2026 年 3 月",
   "start": 77.632,
   "end": 78.861,
   "id": "c37"
  },
  {
   "text": "Resolv 被凭空铸出约 8000 万枚 USR",
   "start": 78.941,
   "end": 82.385,
   "id": "c38"
  },
  {
   "text": "按 QuillAudits 和 CertiK 的分析",
   "start": 83.372,
   "end": 85.946,
   "id": "c39"
  },
  {
   "text": "攻击者拿到了铸币密钥",
   "start": 86.134,
   "end": 87.78,
   "id": "c40"
  },
  {
   "text": "合约也不核对铸币量和存入资产的比例",
   "start": 87.884,
   "end": 90.804,
   "id": "c41"
  },
  {
   "text": "2026 年 5 月的 StablR",
   "start": 91.8,
   "end": 93.743,
   "id": "c42"
  },
  {
   "text": "三个签名人里任意一人",
   "start": 93.776,
   "end": 95.613,
   "id": "c43"
  },
  {
   "text": "就能批准铸币",
   "start": 95.633,
   "end": 96.72,
   "id": "c44"
  },
  {
   "text": "拿下一个人",
   "start": 97.095,
   "end": 98.217,
   "id": "c45"
  },
  {
   "text": "就拿下了全部",
   "start": 98.321,
   "end": 99.42,
   "id": "c46"
  },
  {
   "text": "第四类 链下策略",
   "start": 100.42,
   "end": 102.316,
   "id": "c47"
  },
  {
   "text": "2025 年 11 月",
   "start": 102.691,
   "end": 104.004,
   "id": "c48"
  },
  {
   "text": "Stream Finance",
   "start": 104.084,
   "end": 104.885,
   "id": "c49"
  },
  {
   "text": "的一名外部基金管理人",
   "start": 104.905,
   "end": 106.623,
   "id": "c50"
  },
  {
   "text": "亏掉约 9300 万美元",
   "start": 106.691,
   "end": 108.504,
   "id": "c51"
  },
  {
   "text": "提款随即冻结",
   "start": 108.524,
   "end": 109.837,
   "id": "c52"
  },
  {
   "text": "第五类 定价来源",
   "start": 110.816,
   "end": 112.521,
   "id": "c53"
  },
  {
   "text": "2025 年 10 月 10 日",
   "start": 112.897,
   "end": 114.447,
   "id": "c54"
  },
  {
   "text": "USDe 只在 Binance 现货",
   "start": 114.539,
   "end": 116.483,
   "id": "c55"
  },
  {
   "text": "跌到约 0.65 美元",
   "start": 116.575,
   "end": 118.209,
   "id": "c56"
  },
  {
   "text": "链上和其他交易所",
   "start": 119.196,
   "end": 120.735,
   "id": "c57"
  },
  {
   "text": "基本保持在约 0.90 美元以上",
   "start": 120.862,
   "end": 123.437,
   "id": "c58"
  },
  {
   "text": "Binance 用自家订单簿给抵押品估值",
   "start": 124.432,
   "end": 127.328,
   "id": "c59"
  },
  {
   "text": "触发了用户清算",
   "start": 127.348,
   "end": 128.685,
   "id": "c60"
  },
  {
   "text": "之后赔付约 2.83 亿美元",
   "start": 128.741,
   "end": 131.066,
   "id": "c61"
  },
  {
   "text": "风险会沿着抵押关系往下传",
   "start": 132.068,
   "end": 134.559,
   "id": "c62"
  },
  {
   "text": "储备一出问题",
   "start": 134.922,
   "end": 136.116,
   "id": "c63"
  },
  {
   "text": "所有拿它做抵押品的协议",
   "start": 136.244,
   "end": 138.129,
   "id": "c64"
  },
  {
   "text": "同时受影响",
