 ],
 "captions": [
  {
   "text": "最后 每个人今天就能做一件事",
   "start": 1.648,
   "end": 4.151,
   "id": "c0"
  },
  {
   "text": "写协议的人",
   "start": 5.132,
   "end": 6.194,
   "id": "c1"
  },
  {
   "text": "把偿付不变量写成一条公式",
   "start": 6.227,
   "end": 8.54,
   "id": "c2"
  },
  {
   "text": "再用不变量测试去验证它",
   "start": 8.703,
   "end": 10.778,
   "id": "c3"
  },
  {
   "text": "审计的人",
   "start": 11.736,
   "end": 12.715,
   "id": "c4"
  },
  {
   "text": "列出每一个改变抵押品和债务的入口",
   "start": 12.736,
   "end": 15.429,
   "id": "c5"
  },
  {
   "text": "逐个核对有没有健康检查",
   "start": 15.617,
   "end": 17.668,
   "id": "c6"
  },
  {
   "text": "普通用户",
   "start": 18.652,
   "end": 19.619,
   "id": "c7"
  },
  {
   "text": "收益来源说不清楚的产品",
   "start": 19.664,
   "end": 21.476,
   "id": "c8"
  },
  {
   "text": "不要投入大额",
   "start": 21.556,
   "end": 22.643,
   "id": "c9"
  },
  {
   "text": "稳定币也不是无风险资产",
   "start": 23.624,
   "end": 25.889,
   "id": "c10"
  },
  {
   "text": "先查它的储备",
   "start": 26.264,
   "end": 27.566,
   "id": "c11"
  },
  {
   "text": "赎回规则",
   "start": 27.586,
   "end": 28.839,
   "id": "c12"
  },
  {
   "text": "和发行方的冻结权限",
   "start": 28.859,
   "end": 30.755,
   "id": "c13"
  },
  {
   "text": "回到开头",
   "start": 31.74,
   "end": 32.695,
   "id": "c14"
  },
  {
   "text": "每个函数都没有错",
   "start": 33.071,
   "end": 34.502,
   "id": "c15"
  },
  {
   "text": "协议为什么损失约 1.97 亿美元",
   "start": 34.702,
   "end": 37.336,
   "id": "c16"
  },
  {
   "text": "因为规则允许一条路径",
   "start": 38.6,
   "end": 40.377,
   "id": "c17"
  },
  {
   "text": "减少抵押品",
   "start": 40.421,
   "end": 41.532,
   "id": "c18"
  },
  {
   "text": "却不检查健康因子",
   "start": 41.612,
   "end": 43.067,
   "id": "c19"
  },
  {
   "text": "这个答案成立的前提是",
   "start": 44.052,
   "end": 45.745,
   "id": "c20"
  },
  {
   "text": "清算折扣会随缺口变大",
   "start": 45.861,
   "end": 47.995,
   "id": "c21"
  },
  {
   "text": "缺口才能变成利润",
   "start": 48.052,
   "end": 49.65,
   "id": "c22"
  },
  {
   "text": "代码没错",
   "start": 50.632,
   "end": 51.552,
   "id": "c23"
  },
  {
   "text": "规则错了",
   "start": 51.751,
   "end": 52.659,
   "id": "c24"
  },
  {
   "text": "规则的每一种组合",
   "start": 53.022,
   "end": 54.502,
   "id": "c25"
  },
  {
   "text": "都要守住偿付不变量",
   "start": 54.534,
   "end": 56.18,
   "id": "c26"
  },
  {
   "text": "下一集讲跨链桥安全",
   "start": 57.164,
   "end": 59.107,
   "id": "c27"
  }
 ]
}