  },
  {
   "text": "按 CertiK 的分析",
   "start": 23.196,
   "end": 24.699,
   "id": "c11"
  },
  {
   "text": "提案满 1 天",
   "start": 24.862,
   "end": 25.878,
   "id": "c12"
  },
  {
   "text": "拿到三分之二的票",
   "start": 25.898,
   "end": 27.247,
   "id": "c13"
  },
  {
   "text": "就能立刻执行",
   "start": 27.267,
   "end": 28.508,
   "id": "c14"
  },
  {
   "text": "先猜一道题",
   "start": 29.488,
   "end": 30.812,
   "id": "c15"
  },
  {
   "text": "闪电贷必须在同一笔交易里归还",
   "start": 31.796,
   "end": 34.466,
   "id": "c16"
  },
  {
   "text": "用借来的代币",
   "start": 34.841,
   "end": 36.154,
   "id": "c17"
  },
  {
   "text": "能通过提案吗",
   "start": 36.317,
   "end": 37.701,
   "id": "c18"
  },
  {
   "text": "能",
   "start": 38.968,
   "end": 39.661,
   "id": "c19"
  },
  {
   "text": "借款 存入 投票 执行 还款",
   "start": 40.013,
   "end": 43.897,
   "id": "c20"
  },
  {
   "text": "全在同一笔交易里",
   "start": 44.037,
   "end": 45.457,
   "id": "c21"
  },
  {
   "text": "闪电贷的归还限制",
   "start": 46.436,
   "end": 48.165,
   "id": "c22"
  },
  {
   "text": "一步也没有挡住",
   "start": 48.293,
   "end": 49.748,
   "id": "c23"
  },
  {
   "text": "攻击者提前一天",
   "start": 50.736,
   "end": 52.215,
   "id": "c24"
  },
  {
   "text": "就提交了提案",
   "start": 52.259,
   "end": 53.394,
   "id": "c25"
  },
  {
   "text": "获利口径各方不同",
   "start": 54.388,
   "end": 56.046,
   "id": "c26"
  },
  {
   "text": "CertiK 称约 7600 万美元",
   "start": 56.421,
   "end": 58.912,
   "id": "c27"
  },
  {
   "text": "Beanstalk 称约 7700 万美元",
   "start": 59.004,
   "end": 61.472,
   "id": "c28"
  },
  {
   "text": "PeckShield 估约 8000 万美元",
   "start": 61.516,
   "end": 63.555,
   "id": "c29"
  },
  {
   "text": "修复有两步",
   "start": 64.544,
   "end": 65.845,
   "id": "c30"
  },
  {
   "text": "投票权用提案创建之前那个区块的快照",
   "start": 66.828,
   "end": 70.081,
   "id": "c31"
  },
  {
   "text": "借来的代币",
   "start": 70.456,
   "end": 71.436,
   "id": "c32"
  },
  {
   "text": "那时并不在你手里",
   "start": 71.647,
   "end": 72.948,
   "id": "c33"
  },
  {
   "text": "提案通过以后",
   "start": 73.936,
   "end": 75.047,
   "id": "c34"
  },
  {
   "text": "先过时间锁 再执行",
   "start": 75.067,
   "end": 77.129,
   "id": "c35"
  },
  {
   "text": "中间留出守护者否决的机会",
   "start": 77.493,
   "end": 79.687,
   "id": "c36"
  },
  {
   "text": "再加上法定人数",
   "start": 80.684,
   "end": 82.258,
   "id": "c37"
  },
  {
   "text": "并锁定提案内容",
   "start": 82.303,
   "end": 83.723,
   "id": "c38"
  },
  {
   "text": "内容一改",
   "start": 84.098,
   "end": 85.006,
   "id": "c39"
  },
  {
   "text": "重新计时",
   "start": 85.062,
   "end": 86.137,
   "id": "c40"
  },
  {
   "text": "奖励分发",
   "start": 87.12,
   "end": 88.135,
   "id": "c41"
  },
  {
   "text": "也有同样的问题",
   "start": 88.286,
   "end": 89.599,
   "id": "c42"
  },
  {
   "text": "如果奖励按存入那一刻的余额计算",
   "start": 90.58,
   "end": 92.928,
   "id": "c43"
  },
  {
   "text": "就能用闪电贷存入 领奖 取出",
   "start": 92.961,
   "end": 96.047,
   "id": "c44"
  },
  {
   "text": "修复是让奖励随时间累积",
   "start": 97.016,
   "end": 99.174,
   "id": "c45"
  },
  {
   "text": "存入以后有最短锁定期",
   "start": 99.266,
   "end": 101.424,
   "id": "c46"
  },
  {
   "text": "奖励的计算",
   "start": 102.42,
   "end": 103.482,
   "id": "c47"
  },
  {
   "text": "不能读一笔交易里就能改变的数据",
   "start": 103.622,
   "end": 106.232,
   "id": "c48"
  },
  {
   "text": "比如本区块的成交量",
   "start": 106.265,
   "end": 107.899,
   "id": "c49"
  },
  {
   "text": "或者池子的价格",
   "start": 107.92,
   "end": 109.256,
   "id": "c50"
  },
  {
   "text": "这几件事有个共同点",
   "start": 110.248,
   "end": 112.168,
   "id": "c51"
  },
  {
   "text": "攻击者借来的 是规模",
   "start": 112.543,
   "end": 114.796,
   "id": "c52"
  },
  {
   "text": "利用的 是时间",
   "start": 115.174,
   "end": 116.951,
   "id": "c53"
  }
 ]
}