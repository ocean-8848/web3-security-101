 "captions": [
  {
   "text": "最后一块基础",
   "start": 1.649,
   "end": 2.743,
   "id": "c0"
  },
  {
   "text": "是 gas 和回滚",
   "start": 2.919,
   "end": 4.356,
   "id": "c1"
  },
  {
   "text": "每条指令都消耗 gas",
   "start": 4.67,
   "end": 6.499,
   "id": "c2"
  },
  {
   "text": "gas 用完",
   "start": 6.734,
   "end": 7.522,
   "id": "c3"
  },
  {
   "text": "当前调用帧回滚",
   "start": 7.674,
   "end": 9.339,
   "id": "c4"
  },
  {
   "text": "require 和自定义错误",
   "start": 9.687,
   "end": 11.554,
   "id": "c5"
  },
  {
   "text": "会回滚当前调用",
   "start": 11.789,
   "end": 13.404,
   "id": "c6"
  },
  {
   "text": "并向上冒泡",
   "start": 13.497,
   "end": 14.596,
   "id": "c7"
  },
  {
   "text": "低级 call 失败却不冒泡",
   "start": 14.947,
   "end": 16.596,
   "id": "c8"
  },
  {
   "text": "只返回 false 和返回数据",
   "start": 16.738,
   "end": 18.764,
   "id": "c9"
  },
  {
   "text": "try catch 只能接住外部调用的失败",
   "start": 19.083,
   "end": 21.807,
   "id": "c10"
  },
  {
   "text": "接不住本合约内部的失败",
   "start": 22.182,
   "end": 24.097,
   "id": "c11"
  },
  {
   "text": "外部调用",
   "start": 24.423,
   "end": 25.35,
   "id": "c12"
  },
  {
   "text": "最多转发剩余 gas 的 64 分之 63",
   "start": 25.451,
   "end": 28.66,
   "id": "c13"
  },
  {
   "text": "被调用方耗尽 gas 调用方还剩 64 分之 1 来收尾",
   "start": 29.148,
   "end": 33.544,
   "id": "c14"
  },
  {
   "text": "这里有一个过时的习惯",
   "start": 33.923,
   "end": 36.751,
   "id": "c15"
  },
  {
   "text": "transfer 和 send",
   "start": 36.776,
   "end": 38.088,
   "id": "c16"
  },
  {
   "text": "只转发 2300 gas",
   "start": 38.108,
   "end": 40.034,
   "id": "c17"
  },
  {
   "text": "曾经被当成防重入的手段",
   "start": 40.143,
   "end": 42.484,
   "id": "c18"
  },
  {
   "text": "后来 gas 价格改过几次",
   "start": 42.77,
   "end": 44.831,
   "id": "c19"
  },
  {
   "text": "接收方是合约钱包时",
   "start": 45.057,
   "end": 46.945,
   "id": "c20"
  },
  {
   "text": "这种转账会直接失败",
   "start": 47.023,
   "end": 48.815,
   "id": "c21"
  },
  {
   "text": "现在推荐的做法",
   "start": 49.07,
   "end": 50.501,
   "id": "c22"
  },
  {
   "text": "是用 call 转账",
   "start": 50.553,
   "end": 51.966,
   "id": "c23"
  },
  {
   "text": "再用 CEI 或重入锁来防重入",
   "start": 52.101,
   "end": 54.842,
   "id": "c24"
  },
  {
   "text": "gas 规则还在变",
   "start": 55.13,
   "end": 56.736,
   "id": "c25"
  },
  {
   "text": "Fusaka 和尚未上线的",
   "start": 56.925,
   "end": 58.733,
   "id": "c26"
  },
  {
   "text": "Glamsterdam",
   "start": 58.753,
   "end": 59.914,
   "id": "c27"
  },
  {
   "text": "都会打破固定 gas 够用的假设",
   "start": 60.131,
   "end": 62.7,
   "id": "c28"
  },
  {
   "text": "编译器也在变",
   "start": 63.054,
   "end": 64.394,
   "id": "c29"
  },
  {
   "text": "0.8 以前",
   "start": 64.687,
   "end": 65.621,
   "id": "c30"
  },
  {
   "text": "算术默认不检查溢出",
   "start": 65.692,
   "end": 67.617,
   "id": "c31"
  },
  {
   "text": "必须用 SafeMath",
   "start": 67.831,
   "end": 69.206,
   "id": "c32"
  },
  {
   "text": "0.8.24 起",
   "start": 69.59,
   "end": 70.899,
   "id": "c33"
  },
  {
   "text": "支持瞬态存储",
   "start": 70.982,
   "end": 71.593,
   "id": "c34"
  },
  {
   "text": "可以做低成本的重入锁",
   "start": 71.834,
   "end": 75.627,
   "id": "c35"
  },
  {
   "text": "跨链部署前",
   "start": 75.856,
   "end": 76.926,
   "id": "c36"
  },
  {
   "text": "要确认目标链支持",
   "start": 77.005,
   "end": 78.79,
   "id": "c37"
  },
  {
   "text": "把这一集放在一起看",
   "start": 79.168,
   "end": 80.73,
   "id": "c38"
  },
  {
   "text": "就是一句话",
   "start": 80.763,
   "end": 81.632,
   "id": "c39"
  },
  {
   "text": "每一次调用",
   "start": 82.11,
   "end": 83.176,
   "id": "c40"
  },
  {
   "text": "都可能把控制权交给别人",
   "start": 83.234,
   "end": 85.332,
   "id": "c41"
  },
  {
   "text": "交给了谁",
   "start": 86.33,
   "end": 87.22,
   "id": "c42"
  },
  {
   "text": "用的是谁的存储",
   "start": 87.394,
   "end": 88.904,
   "id": "c43"
  },
  {
   "text": "失败时谁回滚",
   "start": 89.024,
   "end": 90.753,
   "id": "c44"
  },
  {
   "text": "都要自己看清楚",
   "start": 90.924,
   "end": 92.148,
   "id": "c45"
  }
 ]
}