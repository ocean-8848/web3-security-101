 "captions": [
  {
   "text": "EVM 是一台单线程的栈式计算机",
   "start": 1.648,
   "end": 4.282,
   "id": "c0"
  },
  {
   "text": "每个合约",
   "start": 4.657,
   "end": 5.625,
   "id": "c1"
  },
  {
   "text": "有自己的代码和存储",
   "start": 5.657,
   "end": 7.256,
   "id": "c2"
  },
  {
   "text": "合约之间",
   "start": 8.252,
   "end": 9.195,
   "id": "c3"
  },
  {
   "text": "靠消息调用来通信",
   "start": 9.275,
   "end": 10.743,
   "id": "c4"
  },
  {
   "text": "每一次调用",
   "start": 11.118,
   "end": 12.181,
   "id": "c5"
  },
  {
   "text": "都可能把控制权交给别人",
   "start": 12.237,
   "end": 14.336,
   "id": "c6"
  },
  {
   "text": "链上有两类账户",
   "start": 15.336,
   "end": 17.006,
   "id": "c7"
  },
  {
   "text": "外部账户叫 EOA",
   "start": 18.004,
   "end": 19.709,
   "id": "c8"
  },
  {
   "text": "由私钥控制",
   "start": 19.73,
   "end": 20.876,
   "id": "c9"
  },
  {
   "text": "能主动发起交易",
   "start": 20.896,
   "end": 22.162,
   "id": "c10"
  },
  {
   "text": "合约账户由代码控制",
   "start": 23.144,
   "end": 24.909,
   "id": "c11"
  },
  {
   "text": "不能主动发起",
   "start": 25.06,
   "end": 26.29,
   "id": "c12"
  },
  {
   "text": "只能被调用",
   "start": 26.358,
   "end": 27.314,
   "id": "c13"
  },
  {
   "text": "但这条界线在变",
   "start": 28.284,
   "end": 29.775,
   "id": "c14"
  },
  {
   "text": "2025 年 5 月",
   "start": 30.138,
   "end": 31.439,
   "id": "c15"
  },
  {
   "text": "以太坊 Pectra 升级上线了 EIP-7702",
   "start": 31.555,
   "end": 35.499,
   "id": "c16"
  },
  {
   "text": "EOA 可以委托执行一段合约代码",
   "start": 35.65,
   "end": 38.392,
   "id": "c17"
  },
  {
   "text": "所以 查对方有没有代码",
   "start": 39.376,
   "end": 41.724,
   "id": "c18"
  },
  {
   "text": "已经不能判断它是不是普通用户",
   "start": 41.78,
   "end": 43.974,
   "id": "c19"
  },
  {
   "text": "比较 msg.sender 和 tx.origin",
   "start": 44.349,
   "end": 47.96,
   "id": "c20"
  },
  {
   "text": "也不行",
   "start": 48.004,
   "end": 48.757,
   "id": "c21"
  },
  {
   "text": "再看调用上下文",
   "start": 49.748,
   "end": 51.56,
   "id": "c22"
  },
  {
   "text": "假设用户调用合约 A",
   "start": 51.936,
   "end": 53.796,
   "id": "c23"
  },
  {
   "text": "A 调用 B",
   "start": 53.924,
   "end": 54.82,
   "id": "c24"
  },
  {
   "text": "B 再调用 C",
   "start": 54.876,
   "end": 55.891,
   "id": "c25"
  },
  {
   "text": "站在 C 的位置",
   "start": 56.88,
   "end": 58.109,
   "id": "c26"
  },
  {
   "text": "看四个变量",
   "start": 58.177,
   "end": 59.264,
   "id": "c27"
  },
  {
   "text": "tx.origin",
   "start": 60.244,
   "end": 61.759,
   "id": "c28"
  },
  {
   "text": "是发起整笔交易的用户",
   "start": 61.779,
   "end": 63.545,
   "id": "c29"
  },
  {
   "text": "msg.sender",
   "start": 64.544,
   "end": 66.059,
   "id": "c30"
  },
  {
   "text": "是直接调用 C 的那一个",
   "start": 66.091,
   "end": 67.678,
   "id": "c31"
  },
  {
   "text": "也就是 B",
   "start": 67.71,
   "end": 68.726,
   "id": "c32"
  },
  {
   "text": "msg.value",
   "start": 69.684,
   "end": 71.104,
   "id": "c33"
  },
  {
   "text": "是这次调用附带的原生币",
   "start": 71.184,
   "end": 72.949,
   "id": "c34"
  },
  {
   "text": "也就是 B 转给 C 的数量",
   "start": 72.969,
   "end": 74.735,
   "id": "c35"
  },
  {
   "text": "address(this)",
   "start": 75.736,
   "end": 77.299,
   "id": "c36"
  },
  {
   "text": "是当前执行代码的合约",
   "start": 77.319,
   "end": 78.989,
   "id": "c37"
  },
  {
   "text": "也就是 C 自己",
   "start": 79.045,
   "end": 80.572,
   "id": "c38"
  },
  {
   "text": "开头那个金库",
   "start": 81.548,
   "end": 82.718,
   "id": "c39"
  },
  {
   "text": "该看的是 msg.sender",
   "start": 82.798,
   "end": 85.254,
   "id": "c40"
  },
  {
   "text": "不是 tx.origin",
   "start": 85.274,
   "end": 86.908,
   "id": "c41"
  },
  {
   "text": "合约之间怎么调用",
   "start": 87.888,
   "end": 89.284,
   "id": "c42"
  },
  {
   "text": "有三种方式",
   "start": 89.659,
   "end": 90.877,
   "id": "c43"
  },
  {
   "text": "第一种 call 最常见",
   "start": 91.876,
   "end": 93.617,
   "id": "c44"
  },
  {
   "text": "执行 B 的代码",
   "start": 93.98,
   "end": 95.281,
   "id": "c45"
  },
  {
   "text": "改的是 B 的存储",
   "start": 95.361,
   "end": 96.627,
   "id": "c46"
  },
  {
   "text": "第二种 delegatecall",
   "start": 97.616,
   "end": 99.286,
   "id": "c47"
  },
  {
   "text": "执行的还是 B 的代码",
   "start": 99.649,
   "end": 101.414,
   "id": "c48"
  },
  {
   "text": "改的却是 A 的存储",
   "start": 101.53,
   "end": 103.295,
   "id": "c49"
  },
  {
   "text": "而且 msg.sender 和",
   "start": 104.292,
   "end": 106.807,
   "id": "c50"
  },
  {
   "text": "msg.value 保持不变",
   "start": 106.827,
   "end": 109.045,
   "id": "c51"
  },
  {
   "text": "代理合约和库合约",
   "start": 109.396,
   "end": 110.793,
   "id": "c52"
  },
  {
   "text": "都依赖它",
   "start": 110.873,
   "end": 111.697,
   "id": "c53"
  },
  {
   "text": "打个比方",
   "start": 112.672,
   "end": 113.627,
   "id": "c54"
  },
  {
   "text": "EVM 像一个只有一个窗口的政务大厅",
   "start": 113.991,
   "end": 116.911,
   "id": "c55"
  },
  {
   "text": "每个合约是一个科室",
   "start": 116.955,
   "end": 118.577,
   "id": "c56"
  },
  {
   "text": "call",
   "start": 119.564,
   "end": 120.21,
   "id": "c57"
  },
  {
   "text": "是派人带着材料",
   "start": 120.254,
   "end": 121.531,
   "id": "c58"
  },
  {
   "text": "去 B 的窗口办事",
   "start": 121.576,
   "end": 122.817,
   "id": "c59"
  },
  {
   "text": "delegatecall",
   "start": 123.816,
   "end": 124.748,
   "id": "c60"
  },
  {
   "text": "是把 B 的规程手册借过来",
   "start": 124.768,
   "end": 126.807,
   "id": "c61"
  },
  {
   "text": "在 A 自己的档案柜上照着办",
   "start": 126.851,
   "end": 129.009,
   "id": "c62"
  },
  {
   "text": "如果手册写着",
   "start": 129.988,
   "end": 131.265,
   "id": "c63"
  },
  {
   "text": "清空 0 号抽屉",
   "start": 131.309,
   "end": 132.634,
   "id": "c64"
  },
  {
   "text": "被清空的是 A 的抽屉",
   "start": 132.654,
   "end": 134.17,
   "id": "c65"
  },
  {
   "text": "这个比方有一处不成立",
   "start": 135.152,
   "end": 137.107,
   "id": "c66"
  },
  {
   "text": "真实的大厅里",
   "start": 137.471,
   "end": 138.784,
   "id": "c67"
  },
  {
   "text": "你离开窗口",
   "start": 138.971,
   "end": 140.141,
   "id": "c68"
  },
  {
   "text": "就不能插队回来",
   "start": 140.28,
   "end": 141.533,
   "id": "c69"
  },
  {
   "text": "EVM 里",
   "start": 142.524,
   "end": 143.432,
   "id": "c70"
  },
  {
   "text": "B 办到一半",
   "start": 143.512,
   "end": 144.42,
   "id": "c71"
  },
  {
   "text": "可以反过来再找 A",
   "start": 144.476,
   "end": 145.753,
   "id": "c72"
  },
  {
   "text": "这时 A 的上一件事",
   "start": 146.116,
   "end": 147.596,
   "id": "c73"
  },
  {
   "text": "还没办完",
   "start": 147.616,
   "end": 148.513,
   "id": "c74"
  },
  {
   "text": "这就是重入",
   "start": 148.89,
   "end": 149.906,
   "id": "c75"
  },
  {
   "text": "第三种 staticcall",
   "start": 150.904,
   "end": 152.598,
   "id": "c76"
  },
  {
   "text": "是只读调用",
   "start": 152.618,
   "end": 153.776,
   "id": "c77"
  },
  {
   "text": "任何写存储或发事件的操作",
   "start": 154.151,
   "end": 156.571,
   "id": "c78"
  },
  {
   "text": "都会回滚",
   "start": 156.711,
   "end": 157.607,
   "id": "c79"
  },
  {
   "text": "还有一个坑",
   "start": 158.588,
   "end": 159.627,
   "id": "c80"
  },
  {
   "text": "低级 call 失败时",
   "start": 159.99,
   "end": 161.374,
   "id": "c81"
  },
  {
   "text": "不会自动让调用者回滚",
   "start": 161.502,
   "end": 163.47,
   "id": "c82"
  },
  {
   "text": "只返回 false",
   "start": 163.514,
   "end": 164.708,
   "id": "c83"
  }
 ]
}