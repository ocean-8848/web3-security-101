 "captions": [
  {
   "text": "接下来 看数据存在哪里",
   "start": 1.648,
   "end": 4.175,
   "id": "c0"
  },
  {
   "text": "每个合约都有一张巨大的键值表 叫存储",
   "start": 5.156,
   "end": 8.433,
   "id": "c1"
  },
  {
   "text": "键和值都是 32 字节",
   "start": 8.808,
   "end": 11.157,
   "id": "c2"
  },
  {
   "text": "键叫做槽位",
   "start": 11.308,
   "end": 12.49,
   "id": "c3"
  },
  {
   "text": "可以把它想成一排抽屉柜",
   "start": 13.488,
   "end": 15.443,
   "id": "c4"
  },
  {
   "text": "每个抽屉 32 字节",
   "start": 15.819,
   "end": 17.572,
   "id": "c5"
  },
  {
   "text": "从 0 号开始编号",
   "start": 17.592,
   "end": 19.084,
   "id": "c6"
  },
  {
   "text": "规则一 状态变量按声明顺序",
   "start": 20.068,
   "end": 22.928,
   "id": "c7"
  },
  {
   "text": "从 0 号槽开始放",
   "start": 22.984,
   "end": 24.547,
   "id": "c8"
  },
  {
   "text": "规则二 相邻的变量加起来不超过 32 字节",
   "start": 25.52,
   "end": 29.416,
   "id": "c9"
  },
  {
   "text": "编译器就把它们打包进同一个槽",
   "start": 29.591,
   "end": 31.928,
   "id": "c10"
  },
  {
   "text": "看一个例子",
   "start": 32.892,
   "end": 33.812,
   "id": "c11"
  },
  {
   "text": "owner 是地址",
   "start": 34.187,
   "end": 35.428,
   "id": "c12"
  },
  {
   "text": "占 20 字节",
   "start": 35.449,
   "end": 36.583,
   "id": "c13"
  },
  {
   "text": "放进 0 号槽",
   "start": 36.604,
   "end": 37.785,
   "id": "c14"
  },
  {
   "text": "paused 是布尔值",
   "start": 38.752,
   "end": 40.243,
   "id": "c15"
  },
  {
   "text": "占 1 字节",
   "start": 40.264,
   "end": 41.172,
   "id": "c16"
  },
  {
   "text": "也挤进 0 号槽",
   "start": 41.192,
   "end": 42.35,
   "id": "c17"
  },
  {
   "text": "fee 是 96 位整数",
   "start": 43.316,
   "end": 44.974,
   "id": "c18"
  },
  {
   "text": "占 12 字节",
   "start": 44.994,
   "end": 46.164,
   "id": "c19"
  },
  {
   "text": "20 加 1 加 12 是 33",
   "start": 46.528,
   "end": 48.59,
   "id": "c20"
  },
  {
   "text": "放不下了",
   "start": 48.718,
   "end": 49.483,
   "id": "c21"
  },
  {
   "text": "所以 fee 去了 1 号槽",
   "start": 50.472,
   "end": 52.415,
   "id": "c22"
  },
  {
   "text": "total 顺延到 2 号槽",
   "start": 52.472,
   "end": 54.439,
   "id": "c23"
  },
  {
   "text": "如果把 fee 改成 88 位",
   "start": 55.396,
   "end": 57.173,
   "id": "c24"
  },
  {
   "text": "也就是 11 字节",
   "start": 57.193,
   "end": 58.637,
   "id": "c25"
  },
  {
   "text": "三个变量正好 32 字节",
   "start": 58.777,
   "end": 61.007,
   "id": "c26"
  },
  {
   "text": "全部挤进 0 号槽",
   "start": 61.027,
   "end": 62.494,
   "id": "c27"
  },
  {
   "text": "total 就从 2 号槽",
   "start": 63.464,
   "end": 65.277,
   "id": "c28"
  },
  {
   "text": "挪到了 1 号槽",
   "start": 65.297,
   "end": 66.479,
   "id": "c29"
  },
  {
   "text": "代理升级时",
   "start": 66.83,
   "end": 67.941,
   "id": "c30"
  },
  {
   "text": "这种挪动会让后面的变量全部错位",
   "start": 68.128,
   "end": 70.917,
   "id": "c31"
  },
  {
   "text": "规则三 mapping 自己占一个槽",
   "start": 71.916,
   "end": 74.657,
   "id": "c32"
  },
  {
   "text": "这个槽是空的",
   "start": 74.689,
   "end": 75.776,
   "id": "c33"
  },
  {
   "text": "元素放在键和槽号一起哈希出来的位置",
   "start": 76.139,
   "end": 79.619,
   "id": "c34"
  },
  {
   "text": "规则四 动态数组的槽里存长度",
   "start": 80.608,
   "end": 83.635,
   "id": "c35"
  },
  {
   "text": "元素从槽号的哈希开始",
   "start": 83.998,
   "end": 86.073,
   "id": "c36"
  },
  {
   "text": "依次往后排",
   "start": 86.177,
   "end": 87.287,
   "id": "c37"
  },
  {
   "text": "规则五 常量和不可变量",
   "start": 88.268,
   "end": 90.545,
   "id": "c38"
  },
  {
   "text": "不占存储槽",
   "start": 90.672,
   "end": 91.783,
   "id": "c39"
  },
  {
   "text": "为什么这是安全问题",
   "start": 92.76,
   "end": 94.239,
   "id": "c40"
  },
  {
   "text": "看四个场景",
   "start": 94.614,
   "end": 95.772,
   "id": "c41"
  },
  {
   "text": "第一 代理合约和实现合约的变量顺序不一致",
   "start": 96.772,
   "end": 100.43,
   "id": "c42"
  },
  {
   "text": "实现合约以为在写 owner",
   "start": 100.793,
   "end": 102.927,
   "id": "c43"
  },
  {
   "text": "实际改写了代理的实现地址",
   "start": 103.055,
   "end": 105.261,
   "id": "c44"
  },
  {
   "text": "第二 升级时在中间插入新变量",
   "start": 106.256,
   "end": 109.247,
   "id": "c45"
  },
  {
   "text": "后面的变量全部错位",
   "start": 109.61,
   "end": 111.304,
   "id": "c46"
  },
  {
   "text": "余额可能被当成地址来读",
   "start": 111.527,
   "end": 113.566,
   "id": "c47"
  },
  {
   "text": "第三 用 private 变量存密码或种子",
   "start": 114.54,
   "end": 117.757,
   "id": "c48"
  },
  {
   "text": "任何人通过 RPC 读一下存储",
   "start": 118.132,
   "end": 120.731,
   "id": "c49"
  },
  {
   "text": "就能看到",
   "start": 120.763,
   "end": 121.576,
   "id": "c50"
  },
  {
   "text": "第四",
   "start": 122.56,
   "end": 123.206,
   "id": "c51"
  },
  {
   "text": "用 delegatecall",
   "start": 123.381,
   "end": 124.516,
   "id": "c52"
  },
  {
   "text": "去调用不受信任的合约",
   "start": 124.536,
   "end": 126.265,
   "id": "c53"
  },
  {
   "text": "对方的代码可以改写你的任何槽位",
   "start": 126.641,
   "end": 129.299,
   "id": "c54"
  },
  {
   "text": "甚至让合约自毁",
   "start": 129.462,
   "end": 130.87,
   "id": "c55"
  },
  {
   "text": "所以 EIP-1967 给代理定了固定的槽位",
   "start": 131.852,
   "end": 135.95,
   "id": "c56"
  },
  {
   "text": "用哈希算出一个看起来随机的位置",
   "start": 136.314,
   "end": 138.853,
   "id": "c57"
  },
  {
   "text": "避免和实现合约冲突",
   "start": 138.921,
   "end": 140.853,
   "id": "c58"
  }
 ]
}