 "captions": [
  {
   "text": "最后一块基础",
   "start": 1.648,
   "end": 2.735,
   "id": "c0"
  },
  {
   "text": "是 gas 和回滚",
   "start": 2.755,
   "end": 4.115,
   "id": "c1"
  },
  {
   "text": "每条指令都消耗 gas",
   "start": 5.084,
   "end": 6.861,
   "id": "c2"
  },
  {
   "text": "gas 用完",
   "start": 7.224,
   "end": 8.239,
   "id": "c3"
  },
  {
   "text": "当前调用帧回滚",
   "start": 8.26,
   "end": 9.62,
   "id": "c4"
  },
  {
   "text": "require 和自定义错误",
   "start": 10.608,
   "end": 12.35,
   "id": "c5"
  },
  {
   "text": "会回滚当前调用",
   "start": 12.37,
   "end": 13.766,
   "id": "c6"
  },
  {
   "text": "并向上冒泡",
   "start": 13.786,
   "end": 14.837,
   "id": "c7"
  },
  {
   "text": "低级 call 失败却不冒泡",
   "start": 15.82,
   "end": 17.68,
   "id": "c8"
  },
  {
   "text": "只返回 false 和返回数据",
   "start": 17.724,
   "end": 19.787,
   "id": "c9"
  },
  {
   "text": "try catch 只能接住外部调用的失败",
   "start": 20.768,
   "end": 23.39,
   "id": "c10"
  },
  {
   "text": "接不住本合约内部的失败",
   "start": 23.422,
   "end": 25.188,
   "id": "c11"
  },
  {
   "text": "外部调用",
   "start": 26.172,
   "end": 27.068,
   "id": "c12"
  },
  {
   "text": "最多转发剩余 gas 的 64 分之 63",
   "start": 27.16,
   "end": 30.294,
   "id": "c13"
  },
  {
   "text": "被调用方耗尽 gas",
   "start": 30.669,
   "end": 32.601,
   "id": "c14"
  },
  {
   "text": "调用方还剩 64 分之 1 来收尾",
   "start": 32.741,
   "end": 35.399,
   "id": "c15"
  },
  {
   "text": "这里有一个过时的习惯",
   "start": 36.4,
   "end": 37.927,
   "id": "c16"
  },
  {
   "text": "transfer 和 send",
   "start": 38.302,
   "end": 39.734,
   "id": "c17"
  },
  {
   "text": "只转发 2300 gas",
   "start": 39.754,
   "end": 41.567,
   "id": "c18"
  },
  {
   "text": "曾经被当成防重入的手段",
   "start": 41.731,
   "end": 43.639,
   "id": "c19"
  },
  {
   "text": "后来 gas 价格改过几次",
   "start": 44.636,
   "end": 46.496,
   "id": "c20"
  },
  {
   "text": "接收方是合约钱包时",
   "start": 46.859,
   "end": 48.672,
   "id": "c21"
  },
  {
   "text": "这种转账会直接失败",
   "start": 48.728,
   "end": 50.387,
   "id": "c22"
  },
  {
   "text": "现在推荐的做法",
   "start": 51.384,
   "end": 52.709,
   "id": "c23"
  },
  {
   "text": "是用 call 转账",
   "start": 52.729,
   "end": 54.006,
   "id": "c24"
  },
  {
   "text": "再用 CEI 或重入锁来防重入",
   "start": 54.134,
   "end": 56.887,
   "id": "c25"
  },
  {
   "text": "gas 规则还在变",
   "start": 57.868,
   "end": 59.288,
   "id": "c26"
  },
  {
   "text": "Fusaka 和尚未上线的",
   "start": 59.651,
   "end": 61.631,
   "id": "c27"
  },
  {
   "text": "Glamsterdam",
   "start": 61.651,
   "end": 62.583,
   "id": "c28"
  },
  {
   "text": "都会打破固定 gas 够用的假设",
   "start": 62.651,
   "end": 64.94,
   "id": "c29"
  },
  {
   "text": "编译器也在变",
   "start": 65.936,
   "end": 67.225,
   "id": "c30"
  },
  {
   "text": "0.8 以前",
   "start": 67.588,
   "end": 68.651,
   "id": "c31"
  },
  {
   "text": "算术默认不检查溢出",
   "start": 68.778,
   "end": 70.556,
   "id": "c32"
  },
  {
   "text": "必须用 SafeMath",
   "start": 70.576,
   "end": 72.032,
   "id": "c33"
  },
  {
   "text": "0.8.24 起",
   "start": 73.02,
   "end": 74.511,
   "id": "c34"
  },
  {
   "text": "支持瞬态存储",
   "start": 74.555,
   "end": 75.964,
   "id": "c35"
  },
  {
   "text": "可以做低成本的重入锁",
   "start": 75.984,
   "end": 77.856,
   "id": "c36"
  },
  {
   "text": "跨链部署前",
   "start": 78.22,
   "end": 79.354,
   "id": "c37"
  },
  {
   "text": "要确认目标链支持",
   "start": 79.386,
   "end": 80.985,
   "id": "c38"
  },
  {
   "text": "把这一集放在一起看",
   "start": 81.976,
   "end": 83.431,
   "id": "c39"
  },
  {
   "text": "就是一句话",
   "start": 83.547,
   "end": 84.479,
   "id": "c40"
  },
  {
   "text": "每一次调用",
   "start": 84.654,
   "end": 85.777,
   "id": "c41"
  },
  {
   "text": "都可能把控制权交给别人",
   "start": 85.845,
   "end": 88.003,
   "id": "c42"
  },
  {
   "text": "交给了谁",
   "start": 88.988,
   "end": 89.919,
   "id": "c43"
  },
  {
   "text": "用的是谁的存储",
   "start": 90.047,
   "end": 91.396,
   "id": "c44"
  },
  {
   "text": "失败时谁回滚",
   "start": 91.5,
   "end": 92.955,
   "id": "c45"
  },
  {
   "text": "都要自己看清楚",
   "start": 93.047,
   "end": 94.229,
   "id": "c46"
  }
 ]
