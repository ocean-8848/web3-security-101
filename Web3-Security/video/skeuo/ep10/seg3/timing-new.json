 "captions": [
  {
   "text": "代理的存储",
   "start": 1.648,
   "end": 2.758,
   "id": "c0"
  },
  {
   "text": "是一排编了号的格子 叫槽位",
   "start": 2.79,
   "end": 5.282,
   "id": "c1"
  },
  {
   "text": "代码不认变量名",
   "start": 6.26,
   "end": 7.763,
   "id": "c2"
  },
  {
   "text": "只认格子的编号",
   "start": 7.962,
   "end": 9.263,
   "id": "c3"
  },
  {
   "text": "第一种冲突",
   "start": 10.248,
   "end": 11.263,
   "id": "c4"
  },
  {
   "text": "代理自己的变量",
   "start": 11.426,
   "end": 12.668,
   "id": "c5"
  },
  {
   "text": "和实现的变量",
   "start": 12.688,
   "end": 13.858,
   "id": "c6"
  },
  {
   "text": "撞进同一个格子",
   "start": 13.902,
   "end": 15.096,
   "id": "c7"
  },
  {
   "text": "一个朴素的代理",
   "start": 16.084,
   "end": 17.48,
   "id": "c8"
  },
  {
   "text": "把实现地址放在 0 号槽位",
   "start": 17.548,
   "end": 20.004,
   "id": "c9"
  },
  {
   "text": "实现合约的第一个变量是管理员",
   "start": 20.984,
   "end": 23.785,
   "id": "c10"
  },
  {
   "text": "也在 0 号槽位",
   "start": 23.853,
   "end": 25.166,
   "id": "c11"
  },
  {
   "text": "于是 写管理员",
   "start": 26.148,
   "end": 28.104,
   "id": "c12"
  },
  {
   "text": "就是改写实现地址",
   "start": 28.124,
   "end": 29.865,
   "id": "c13"
  },
  {
   "text": "修复是 EIP-1967",
   "start": 30.856,
   "end": 33.549,
   "id": "c14"
  },
  {
   "text": "它用一个哈希算出的固定槽位",
   "start": 33.925,
   "end": 36.071,
   "id": "c15"
  },
  {
   "text": "存放实现地址和管理员地址",
   "start": 36.175,
   "end": 38.737,
   "id": "c16"
  },
  {
   "text": "这个位置远离普通变量",
   "start": 39.74,
   "end": 42.088,
   "id": "c17"
  },
  {
   "text": "算法里还减去 1",
   "start": 42.463,
   "end": 43.955,
   "id": "c18"
  },
  {
   "text": "让映射和数组的派生位置",
   "start": 44.094,
   "end": 46.05,
   "id": "c19"
  },
  {
   "text": "碰不到它",
   "start": 46.106,
   "end": 46.895,
   "id": "c20"
  },
  {
   "text": "第二种冲突",
   "start": 47.88,
   "end": 48.942,
   "id": "c21"
  },
  {
   "text": "升级前后",
   "start": 49.011,
   "end": 50.133,
   "id": "c22"
  },
  {
   "text": "变量的顺序变了",
   "start": 50.201,
   "end": 51.454,
   "id": "c23"
  },
  {
   "text": "先猜一道题",
   "start": 52.444,
   "end": 53.768,
   "id": "c24"
  },
  {
   "text": "旧版本里",
   "start": 54.752,
   "end": 55.684,
   "id": "c25"
  },
  {
   "text": "0 号槽位是管理员",
   "start": 55.859,
   "end": 57.541,
   "id": "c26"
  },
  {
   "text": "1 号是存款总额",
   "start": 57.74,
   "end": 59.207,
   "id": "c27"
  },
  {
   "text": "新版本在最前面",
   "start": 60.204,
   "end": 61.755,
   "id": "c28"
  },
  {
   "text": "插入了一个手续费变量",
   "start": 61.775,
   "end": 63.421,
   "id": "c29"
  },
  {
   "text": "升级以后读管理员",
   "start": 63.796,
   "end": 65.562,
   "id": "c30"
  },
  {
   "text": "读到的是什么",
   "start": 65.677,
   "end": 66.633,
   "id": "c31"
  },
  {
   "text": "读到的是旧的存款总额",
   "start": 67.88,
   "end": 70.073,
   "id": "c32"
  },
  {
   "text": "截掉一部分",
   "start": 70.153,
   "end": 71.157,
   "id": "c33"
  },
  {
   "text": "被解释成一个地址",
   "start": 71.189,
   "end": 72.478,
   "id": "c34"
  },
  {
   "text": "因为新代码把管理员挪到了 1 号",
   "start": 73.476,
   "end": 75.919,
   "id": "c35"
  },
  {
   "text": "而 1 号里还是旧数据",
   "start": 76.071,
   "end": 78.229,
   "id": "c36"
  },
  {
   "text": "后面每一格都错开一位",
   "start": 79.216,
   "end": 81.278,
   "id": "c37"
  },
  {
   "text": "映射的基址变了",
   "start": 81.642,
   "end": 83.074,
   "id": "c38"
  },
  {
   "text": "所有余额看上去都消失了",
   "start": 83.225,
   "end": 85.193,
   "id": "c39"
  },
  {
   "text": "规则有四条",
   "start": 86.18,
   "end": 87.492,
   "id": "c40"
  },
  {
   "text": "只在末尾追加变量",
   "start": 88.464,
   "end": 90.003,
   "id": "c41"
  },
  {
   "text": "不删除 不重新排序",
   "start": 90.988,
   "end": 93.086,
   "id": "c42"
  },
  {
   "text": "不改类型",
   "start": 93.214,
   "end": 94.074,
   "id": "c43"
  },
  {
   "text": "父合约预留一段空槽位",
   "start": 95.072,
   "end": 96.908,
   "id": "c44"
  },
  {
   "text": "或者用 ERC-7201 的命名空间存储",
   "start": 96.953,
   "end": 99.968,
   "id": "c45"
  },
  {
   "text": "用工具比对新旧布局",
   "start": 100.956,
   "end": 103.09,
   "id": "c46"
  },
  {
   "text": "比如 OpenZeppelin 的升级插件",
   "start": 103.146,
   "end": 105.448,
   "id": "c47"
  },
  {
   "text": "或者 forge inspect",
   "start": 105.468,
   "end": 106.899,
   "id": "c48"
  },
  {
   "text": "不要靠肉眼核对",
   "start": 107.275,
   "end": 108.647,
   "id": "c49"
  },
  {
   "text": "还有一种撞车",
   "start": 109.648,
   "end": 110.83,
   "id": "c50"
  },
  {
   "text": "不在存储里",
   "start": 110.85,
   "end": 111.877,
   "id": "c51"
  },
  {
   "text": "而在函数选择器上",
   "start": 112.076,
   "end": 113.591,
   "id": "c52"
  },
  {
   "text": "选择器是函数签名哈希的前 4 个字节",
   "start": 114.548,
   "end": 117.551,
   "id": "c53"
  },
  {
   "text": "两个名字完全不同的函数",
   "start": 117.926,
   "end": 119.87,
   "id": "c54"
  },
  {
   "text": "可能算出同一个选择器",
   "start": 120.057,
   "end": 121.715,
   "id": "c55"
  },
  {
   "text": "代理自己有这个函数时",
   "start": 122.712,
   "end": 124.405,
   "id": "c56"
  },
  {
   "text": "调用会被代理截下",
   "start": 124.533,
   "end": 125.882,
   "id": "c57"
  },
  {
   "text": "不会转给实现",
   "start": 125.95,
   "end": 126.989,
   "id": "c58"
  },
  {
   "text": "编译器只检查同一个合约内部的冲突",
   "start": 127.972,
   "end": 130.654,
   "id": "c59"
  },
  {
   "text": "代理和实现之间",
   "start": 131.029,
   "end": 132.484,
   "id": "c60"
  },
  {
   "text": "要在部署前用工具比对",
   "start": 132.636,
   "end": 134.854,
   "id": "c61"
  },
  {
   "text": "透明代理靠管理员不转发",
   "start": 135.824,
   "end": 138.148,
   "id": "c62"
  },
  {
   "text": "其他人只转发",
   "start": 138.359,
   "end": 139.625,
   "id": "c63"
  },
  {
   "text": "绕开了这个问题",
   "start": 139.681,
   "end": 140.767,
   "id": "c64"
  }
 ]
}