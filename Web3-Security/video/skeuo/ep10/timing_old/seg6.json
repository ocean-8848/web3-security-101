 "captions": [
  {
   "text": "最后 每个人今天就能做一件事",
   "start": 1.55,
   "end": 4.459,
   "id": "c0"
  },
  {
   "text": "写合约的人",
   "start": 4.73,
   "end": 5.862,
   "id": "c1"
  },
  {
   "text": "在实现合约的构造函数里禁用初始化",
   "start": 5.965,
   "end": 9.297,
   "id": "c2"
  },
  {
   "text": "把部署和初始化放进同一笔交易",
   "start": 9.776,
   "end": 12.657,
   "id": "c3"
  },
  {
   "text": "审计的人",
   "start": 12.87,
   "end": 13.727,
   "id": "c4"
  },
  {
   "text": "把新旧存储布局交给工具比对",
   "start": 13.747,
   "end": 16.189,
   "id": "c5"
  },
  {
   "text": "再解码升级交易的初始化参数",
   "start": 16.389,
   "end": 18.723,
   "id": "c6"
  },
  {
   "text": "看有没有零值",
   "start": 18.891,
   "end": 20.149,
   "id": "c7"
  },
  {
   "text": "普通用户",
   "start": 20.45,
   "end": 21.36,
   "id": "c8"
  },
  {
   "text": "存款前查一查",
   "start": 21.764,
   "end": 23.155,
   "id": "c9"
  },
  {
   "text": "这个协议能不能升级",
   "start": 23.317,
   "end": 24.858,
   "id": "c10"
  },
  {
   "text": "由谁升级",
   "start": 25.06,
   "end": 26.051,
   "id": "c11"
  },
  {
   "text": "有没有时间锁",
   "start": 26.289,
   "end": 27.414,
   "id": "c12"
  },
  {
   "text": "能无延迟升级的协议",
   "start": 27.8,
   "end": 29.464,
   "id": "c13"
  },
  {
   "text": "等于你把资金交给了升级权限的持有人",
   "start": 29.484,
   "end": 32.616,
   "id": "c14"
  },
  {
   "text": "同一个协议在不同的链上",
   "start": 32.89,
   "end": 34.96,
   "id": "c15"
  },
  {
   "text": "升级权限要分别核对",
   "start": 34.98,
   "end": 37.034,
   "id": "c16"
  },
  {
   "text": "回到开头",
   "start": 37.27,
   "end": 38.026,
   "id": "c17"
  },
  {
   "text": "升级的代码没有错",
   "start": 38.472,
   "end": 39.969,
   "id": "c18"
  },
  {
   "text": "为什么钱还是被提走了",
   "start": 40.278,
   "end": 42.309,
   "id": "c19"
  },
  {
   "text": "因为升级换掉的不只是代码",
   "start": 42.89,
   "end": 45.176,
   "id": "c20"
  },
  {
   "text": "初始化参数写进了存储",
   "start": 45.375,
   "end": 47.569,
   "id": "c21"
  },
  {
   "text": "把全零变成了可信",
   "start": 47.815,
   "end": 49.693,
   "id": "c22"
  },
  {
   "text": "这在默认值和合法值无法区分时成立",
   "start": 49.99,
   "end": 53.375,
   "id": "c23"
  },
  {
   "text": "零值没有业务含义",
   "start": 53.617,
   "end": 55.152,
   "id": "c24"
  },
  {
   "text": "这一步就拦得住",
   "start": 55.343,
   "end": 56.492,
   "id": "c25"
  },
  {
   "text": "代理存着钱",
   "start": 56.868,
   "end": 58.247,
   "id": "c26"
  },
  {
   "text": "实现给出规则",
   "start": 58.354,
   "end": 60.034,
   "id": "c27"
  },
  {
   "text": "谁能换规则",
   "start": 60.383,
   "end": 61.6,
   "id": "c28"
  },
  {
   "text": "谁就拥有这笔钱",
   "start": 61.632,
   "end": 63.172,
   "id": "c29"
  },
  {
   "text": "下一集讲 DeFi 经济安全",
   "start": 63.39,
   "end": 67.333,
   "id": "c30"
  }
 ]
}