 "captions": [
  {
   "text": "先给准确的说法",
   "start": 1.55,
   "end": 2.807,
   "id": "c0"
  },
  {
   "text": "一个可升级合约",
   "start": 3.141,
   "end": 4.589,
   "id": "c1"
  },
  {
   "text": "其实是两个合约",
   "start": 4.784,
   "end": 6.423,
   "id": "c2"
  },
  {
   "text": "代理合约",
   "start": 6.804,
   "end": 7.709,
   "id": "c3"
  },
  {
   "text": "保存数据和资金",
   "start": 7.974,
   "end": 9.456,
   "id": "c4"
  },
  {
   "text": "用户的每次调用",
   "start": 9.685,
   "end": 11.235,
   "id": "c5"
  },
  {
   "text": "都先到它这里",
   "start": 11.319,
   "end": 12.407,
   "id": "c6"
  },
  {
   "text": "实现合约",
   "start": 12.69,
   "end": 13.751,
   "id": "c7"
  },
  {
   "text": "只提供代码",
   "start": 13.897,
   "end": 14.942,
   "id": "c8"
  },
  {
   "text": "代理用 delegatecall 把调用转给实现",
   "start": 15.322,
   "end": 18.964,
   "id": "c9"
  },
  {
   "text": "借用实现的代码",
   "start": 19.144,
   "end": 20.545,
   "id": "c10"
  },
  {
   "text": "读写的却是代理自己的存储",
   "start": 20.709,
   "end": 23.636,
   "id": "c11"
  },
  {
   "text": "升级 就是让代理指向一个新的实现",
   "start": 23.93,
   "end": 27.1,
   "id": "c12"
  },
  {
   "text": "数据和资金原地不动",
   "start": 27.35,
   "end": 29.493,
   "id": "c13"
  },
  {
   "text": "只换代码",
   "start": 29.647,
   "end": 30.563,
   "id": "c14"
  },
  {
   "text": "所以 谁能换实现",
   "start": 30.77,
   "end": 32.685,
   "id": "c15"
  },
  {
   "text": "谁就拥有代理里的全部资金",
   "start": 32.75,
   "end": 35.226,
   "id": "c16"
  },
  {
   "text": "打个比方",
   "start": 35.568,
   "end": 36.207,
   "id": "c17"
  },
  {
   "text": "代理是一台售货机的机身",
   "start": 36.694,
   "end": 38.884,
   "id": "c18"
  },
  {
   "text": "货和钱都在里面",
   "start": 39.001,
   "end": 40.693,
   "id": "c19"
  },
  {
   "text": "实现是维修门后面的机芯",
   "start": 40.97,
   "end": 43.525,
   "id": "c20"
  },
  {
   "text": "决定按下按钮以后",
   "start": 43.672,
   "end": 45.212,
   "id": "c21"
  },
  {
   "text": "机器怎么动",
   "start": 45.232,
   "end": 46.357,
   "id": "c22"
  },
  {
   "text": "升级 就是打开维修门",
   "start": 46.63,
   "end": 49.084,
   "id": "c23"
  },
  {
   "text": "换一块新机芯",
   "start": 49.173,
   "end": 50.452,
   "id": "c24"
  },
  {
   "text": "比喻在这里不成立",
   "start": 50.79,
   "end": 53.035,
   "id": "c25"
  },
  {
   "text": "真实的机器换机芯要花时间",
   "start": 53.055,
   "end": 55.03,
   "id": "c26"
  },
  {
   "text": "链上如果没有时间锁",
   "start": 55.28,
   "end": 57.137,
   "id": "c27"
  },
  {
   "text": "换实现只要一笔交易",
   "start": 57.424,
   "end": 59.47,
   "id": "c28"
  },
  {
   "text": "常见的代理有三种",
   "start": 59.805,
   "end": 61.47,
   "id": "c29"
  },
  {
   "text": "区别在于",
   "start": 61.682,
   "end": 62.575,
   "id": "c30"
  },
  {
   "text": "升级的开关放在哪里",
   "start": 62.67,
   "end": 64.522,
   "id": "c31"
  },
  {
   "text": "第一种 透明代理",
   "start": 64.909,
   "end": 66.516,
   "id": "c32"
  },
  {
   "text": "升级函数在代理里",
   "start": 66.945,
   "end": 68.626,
   "id": "c33"
  },
  {
   "text": "由管理员调用",
   "start": 68.889,
   "end": 70.143,
   "id": "c34"
  },
  {
   "text": "管理员调用代理时不转发",
   "start": 70.484,
   "end": 72.52,
   "id": "c35"
  },
  {
   "text": "其他人的调用只转发",
   "start": 72.712,
   "end": 74.371,
   "id": "c36"
  },
  {
   "text": "两边的函数就不会混淆",
   "start": 74.655,
   "end": 76.51,
   "id": "c37"
  },
  {
   "text": "第二种 UUPS",
   "start": 76.77,
   "end": 78.521,
   "id": "c38"
  },
  {
   "text": "代理只做转发",
   "start": 78.662,
   "end": 79.998,
   "id": "c39"
  },
  {
   "text": "升级函数写在实现合约里",
   "start": 80.138,
   "end": 82.58,
   "id": "c40"
  },
  {
   "text": "风险是 新实现如果忘了带上升级函数",
   "start": 82.923,
   "end": 86.569,
   "id": "c41"
  },
  {
   "text": "这个合约就再也不能升级",
   "start": 86.853,
   "end": 88.76,
   "id": "c42"
  },
  {
   "text": "第三种 信标代理",
   "start": 89.05,
   "end": 91.233,
   "id": "c43"
  },
  {
   "text": "很多代理共用一个信标",
   "start": 91.387,
   "end": 93.447,
   "id": "c44"
  },
  {
   "text": "信标里存着实现的地址",
   "start": 93.629,
   "end": 95.696,
   "id": "c45"
  },
  {
   "text": "它适合大量相同的合约",
   "start": 95.91,
   "end": 98.209,
   "id": "c46"
  },
  {
   "text": "比如每个用户一个金库",
   "start": 98.606,
   "end": 100.62,
   "id": "c47"
  },
  {
   "text": "改一次信标",
   "start": 101.061,
   "end": 101.968,
   "id": "c48"
  },
  {
   "text": "所有代理一起换",
   "start": 102.021,
   "end": 103.53,
   "id": "c49"
  },
  {
   "text": "三种模式都依赖 delegatecall",
   "start": 103.81,
   "end": 106.31,
   "id": "c50"
  },
  {
   "text": "所以都有同一个风险",
   "start": 106.47,
   "end": 108.025,
   "id": "c51"
  },
  {
   "text": "存储冲突",
   "start": 108.105,
   "end": 109.0,
   "id": "c52"
  }
 ]
}