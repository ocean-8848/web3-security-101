   "start": 122.946,
   "end": 123.35
  },
  {
   "line": 14,
   "text": "现在",
   "start": 123.896,
   "end": 124.277
  },
  {
   "line": 14,
   "text": "能",
   "start": 124.288,
   "end": 124.443
  },
  {
   "line": 14,
   "text": "做",
   "start": 124.443,
   "end": 124.61
  },
  {
   "line": 14,
   "text": "的",
   "start": 124.61,
   "end": 124.86
  },
  {
   "line": 14,
   "text": "是",
   "start": 125.027,
   "end": 125.229
  },
  {
   "line": 14,
   "text": "盘点",
   "start": 125.241,
   "end": 125.634
  },
  {
   "line": 14,
   "text": "资产",
   "start": 125.646,
   "end": 126.122
  },
  {
   "line": 14,
   "text": "避免",
   "start": 126.491,
   "end": 126.896
  },
