 ],
 "captions": [
  {
   "text": "第三类风险",
   "start": 1.648,
   "end": 2.651,
   "id": "c0"
  },
  {
   "text": "在门限签名里",
   "start": 2.683,
   "end": 3.89,
   "id": "c1"
  },
  {
   "text": "也叫 TSS 或 MPC",
   "start": 3.91,
   "end": 5.937,
   "id": "c2"
  },
  {
   "text": "准确地说",
   "start": 6.932,
   "end": 7.828,
   "id": "c3"
  },
  {
   "text": "它是多方各持一份密钥分片",
   "start": 7.944,
   "end": 10.102,
   "id": "c4"
  },
  {
   "text": "合作产生签名",
   "start": 10.229,
   "end": 11.578,
   "id": "c5"
  },
  {
   "text": "安全性依赖协议里的每一步零知识证明",
   "start": 11.953,
   "end": 14.885,
   "id": "c6"
  },
  {
   "text": "打个比方",
   "start": 15.888,
   "end": 16.843,
   "id": "c7"
  },
  {
   "text": "几个人各拿一块拼图",
   "start": 17.207,
   "end": 18.769,
   "id": "c8"
  },
  {
   "text": "合作盖章",
   "start": 18.933,
   "end": 19.889,
   "id": "c9"
  },
  {
   "text": "每一步都要出示证明",
   "start": 20.254,
   "end": 21.9,
   "id": "c10"
  },
  {
   "text": "证明自己守规矩",
   "start": 22.016,
   "end": 23.317,
   "id": "c11"
  },
  {
   "text": "但不亮出自己那块",
   "start": 23.48,
   "end": 24.829,
   "id": "c12"
  },
  {
   "text": "比方不准的地方是",
   "start": 25.804,
   "end": 27.247,
   "id": "c13"
  },
  {
   "text": "分片不是拼图",
   "start": 27.304,
   "end": 28.652,
   "id": "c14"
  },
  {
   "text": "风险也不在有人偷拼图",
   "start": 28.816,
   "end": 30.866,
   "id": "c15"
  },
  {
   "text": "而在省掉一步证明后",
   "start": 31.856,
   "end": 33.418,
   "id": "c16"
  },
  {
   "text": "恶意参与方能在多次签名中",
   "start": 33.641,
   "end": 35.859,
   "id": "c17"
  },
  {
   "text": "逐步提取别人的分片",
   "start": 35.879,
   "end": 37.43,
   "id": "c18"
  },
  {
   "text": "2023 年 8 月",
   "start": 38.412,
   "end": 39.736,
   "id": "c19"
  },
  {
   "text": "Fireblocks 披露 BitForge",
   "start": 39.864,
   "end": 41.951,
   "id": "c20"
  },
  {
   "text": "GG18 和 GG20 的实现缺少参数证明",
   "start": 42.326,
   "end": 46.055,
   "id": "c21"
  },
  {
   "text": "恶意参与方可以提取完整私钥",
   "start": 46.135,
   "end": 48.448,
   "id": "c22"
  },
  {
   "text": "Lindell17 的实现偏离论文",
   "start": 49.432,
   "end": 51.649,
   "id": "c23"
  },
  {
   "text": "约 200 次签名请求就能提取私钥",
   "start": 51.765,
   "end": 54.316,
   "id": "c24"
  },
  {
   "text": "影响 15 家以上钱包服务商",
   "start": 54.691,
   "end": 57.004,
   "id": "c25"
  },
  {
   "text": "Verichains 的 TSSHOCK",
   "start": 58.004,
   "end": 59.555,
   "id": "c26"
  },
  {
   "text": "披露了三类攻击",
   "start": 59.575,
   "end": 60.864,
   "id": "c27"
  },
  {
   "text": "比如证明的重复次数从 128 降到 1",
   "start": 61.239,
   "end": 64.374,
   "id": "c28"
  },
  {
   "text": "可以直接猜中",
   "start": 64.406,
   "end": 65.505,
   "id": "c29"
  },
  {
   "text": "受影响的有 BNB 的 tss-lib",
   "start": 66.504,
   "end": 69.531,
   "id": "c30"
  },
  {
   "text": "Multichain",
   "start": 69.551,
   "end": 70.471,
   "id": "c31"
  },
  {
   "text": "THORChain",
   "start": 70.587,
   "end": 71.65,
   "id": "c32"
  },
  {
   "text": "Axelar 等多个开源库",
   "start": 71.694,
   "end": 73.328,
   "id": "c33"
  },
  {
   "text": "两项披露都没有报告实际资金损失",
   "start": 73.704,
   "end": 76.695,
   "id": "c34"
  },
  {
   "text": "教训是 MPC 库不能按论文简化",
   "start": 77.692,
   "end": 80.838,
   "id": "c35"
  },
  {
   "text": "选供应商时",
   "start": 81.213,
   "end": 82.55,
   "id": "c36"
  },
  {
   "text": "要问它是否修复了这两类漏洞",
   "start": 82.725,
   "end": 84.966,
   "id": "c37"
  },
  {
   "text": "并要审计报告",
   "start": 85.058,
   "end": 86.145,
   "id": "c38"
  },
  {
   "text": "最后看后量子",
   "start": 87.128,
   "end": 88.417,
   "id": "c39"
  },
  {
   "text": "足够大的量子计算机",
   "start": 88.792,
   "end": 90.296,
   "id": "c40"
  },
  {
   "text": "可以从公钥算出 ECDSA 和 EdDSA 私钥",
   "start": 90.316,
   "end": 93.367,
   "id": "c41"
  },
  {
   "text": "哈希函数受影响较小",
   "start": 93.744,
   "end": 95.7,
   "id": "c42"
  },
  {
   "text": "比特币 P2PKH 这类地址",
   "start": 96.684,
   "end": 99.163,
   "id": "c43"
  },
  {
   "text": "公钥在第一次签名后才暴露",
   "start": 99.315,
   "end": 101.235,
   "id": "c44"
  },
  {
   "text": "所以从未签过名的地址更安全",
   "start": 101.61,
   "end": 104.53,
   "id": "c45"
  },
  {
   "text": "截至 2026 年 11 月",
   "start": 105.52,
   "end": 107.356,
   "id": "c46"
  },
  {
   "text": "NIST 已发布后量子标准",
   "start": 107.496,
   "end": 109.404,
   "id": "c47"
  },
  {
   "text": "比特币的 BIP-360 仍是草案",
   "start": 109.779,
   "end": 112.604,
   "id": "c48"
  },
  {
   "text": "以太坊基金会的目标",
   "start": 113.588,
   "end": 115.222,
   "id": "c49"
  },
  {
   "text": "是约 2029 年完成核心基础设施",
   "start": 115.266,
   "end": 118.436,
   "id": "c50"
  },
  {
   "text": "这是规划",
   "start": 118.811,
   "end": 119.839,
   "id": "c51"
  },
  {
   "text": "不是承诺",
   "start": 120.002,
   "end": 120.898,
   "id": "c52"
  },
  {
   "text": "迁移周期以年计",
   "start": 121.896,
   "end": 123.47,
   "id": "c53"
  },
  {
   "text": "现在能做的",
   "start": 123.846,
   "end": 124.957,
   "id": "c54"
  },
  {
   "text": "是盘点资产",
   "start": 124.977,
   "end": 126.242,
   "id": "c55"
  },
  {
   "text": "避免地址重复使用",
   "start": 126.441,
   "end": 128.027,
   "id": "c56"
  },
  {
   "text": "跟踪各链的迁移计划",
   "start": 128.06,
   "end": 129.873,
   "id": "c57"
  }
 ]
}