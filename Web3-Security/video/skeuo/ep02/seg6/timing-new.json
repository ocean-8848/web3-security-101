 "captions": [
  {
   "text": "防御按层来",
   "start": 1.648,
   "end": 2.96,
   "id": "c0"
  },
  {
   "text": "生成层 用 CSPRNG 或硬件随机源",
   "start": 3.932,
   "end": 7.792,
   "id": "c1"
  },
  {
   "text": "满 256 位熵",
   "start": 7.872,
   "end": 9.244,
   "id": "c2"
  },
  {
   "text": "不在 WASM 和浏览器 JS 里自己替换随机源",
   "start": 9.608,
   "end": 14.206,
   "id": "c3"
  },
  {
   "text": "签名层 用标准 EdDSA 或 RFC 6979",
   "start": 15.192,
   "end": 19.766,
   "id": "c4"
  },
  {
   "text": "再用已知答案测试和差分测试",
   "start": 20.142,
   "end": 22.788,
   "id": "c5"
  },
  {
   "text": "验证封装层",
   "start": 22.88,
   "end": 24.097,
   "id": "c6"
  },
  {
   "text": "监控层 扫描自家地址的签名",
   "start": 25.084,
   "end": 27.718,
   "id": "c7"
  },
  {
   "text": "检测重复的 r 值",
   "start": 27.738,
   "end": 29.397,
   "id": "c8"
  },
  {
   "text": "靶号工具",
   "start": 30.368,
   "end": 31.288,
   "id": "c9"
  },
  {
   "text": "不用来生成管理员或金库地址",
   "start": 31.391,
   "end": 34.085,
   "id": "c10"
  },
  {
   "text": "MPC 库",
   "start": 34.46,
   "end": 35.452,
   "id": "c11"
  },
  {
   "text": "逐项审计证明",
   "start": 35.472,
   "end": 36.786,
   "id": "c12"
  },
  {
   "text": "及时升级",
   "start": 36.806,
   "end": 37.845,
   "id": "c13"
  },
  {
   "text": "生成缺陷修复后",
   "start": 38.844,
   "end": 40.407,
   "id": "c14"
  },
  {
   "text": "强制用户迁移到新地址",
   "start": 40.427,
   "end": 42.561,
   "id": "c15"
  },
  {
   "text": "按角色 今天就能做一件事",
   "start": 43.528,
   "end": 45.781,
   "id": "c16"
  },
  {
   "text": "钱包开发者",
   "start": 46.748,
   "end": 47.751,
   "id": "c17"
  },
  {
   "text": "搜一遍密钥生成代码",
   "start": 47.867,
   "end": 49.489,
   "id": "c18"
  },
  {
   "text": "确认没有时间戳种子",
   "start": 49.557,
   "end": 51.108,
   "id": "c19"
  },
  {
   "text": "Math.random 和 mt19937",
   "start": 51.212,
   "end": 54.156,
   "id": "c20"
  },
  {
   "text": "审计和安全团队",
   "start": 55.152,
   "end": 56.738,
   "id": "c21"
  },
  {
   "text": "查一遍金库和管理员地址",
   "start": 56.818,
   "end": 58.988,
   "id": "c22"
  },
  {
   "text": "是不是靶号工具生成的",
   "start": 59.021,
   "end": 60.714,
   "id": "c23"
  },
  {
   "text": "普通用户",
   "start": 61.684,
   "end": 62.616,
   "id": "c24"
  },
  {
   "text": "只用主流钱包生成助记词",
   "start": 62.672,
   "end": 64.854,
   "id": "c25"
  },
  {
   "text": "厂商一公告随机数缺陷",
   "start": 65.229,
   "end": 67.506,
   "id": "c26"
  },
  {
   "text": "立刻把资产转到新钱包生成的新地址",
   "start": 67.598,
   "end": 71.054,
   "id": "c27"
  },
  {
   "text": "回到开头的问题",
   "start": 72.032,
   "end": 73.416,
   "id": "c28"
  },
  {
   "text": "一把 256 位的私钥",
   "start": 73.791,
   "end": 75.461,
   "id": "c29"
  },
  {
   "text": "为什么只值 32 位",
   "start": 75.684,
   "end": 77.259,
   "id": "c30"
  },
  {
   "text": "因为私钥的强度",
   "start": 78.508,
   "end": 79.892,
   "id": "c31"
  },
  {
   "text": "取决于生成它的熵",
   "start": 79.912,
   "end": 81.38,
   "id": "c32"
  },
  {
   "text": "熵只有 32 位",
   "start": 81.743,
   "end": 83.247,
   "id": "c33"
  },
  {
   "text": "位数再多",
   "start": 83.41,
   "end": 84.425,
   "id": "c34"
  },
  {
   "text": "也只有 32 位",
   "start": 84.458,
   "end": 85.699,
   "id": "c35"
  },
  {
   "text": "256 位的强度要成立",
   "start": 86.672,
   "end": 88.615,
   "id": "c36"
  },
  {
   "text": "有三个条件",
   "start": 88.791,
   "end": 89.794,
   "id": "c37"
  },
  {
   "text": "熵满 256 位",
   "start": 90.169,
   "end": 91.684,
   "id": "c38"
  },
  {
   "text": "nonce 不可预测",
   "start": 91.8,
   "end": 93.232,
   "id": "c39"
  },
  {
   "text": "实现不偏离标准",
   "start": 93.264,
   "end": 94.637,
   "id": "c40"
  },
  {
   "text": "私钥只有它的种子那么强",
   "start": 95.628,
   "end": 97.5,
   "id": "c41"
  },
  {
   "text": "下一集讲 EVM 与 Solidity",
   "start": 97.863,
   "end": 100.343,
   "id": "c42"
  }
 ]
