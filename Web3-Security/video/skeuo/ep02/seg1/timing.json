 "captions": [
  {
   "text": "2022 年 9 月",
   "start": 1.653,
   "end": 3.043,
   "id": "c0"
  },
  {
   "text": "Wintermute 的金库被盗",
   "start": 3.31,
   "end": 5.033,
   "id": "c1"
  },
  {
   "text": "约 1.6 亿美元",
   "start": 5.053,
   "end": 6.649,
   "id": "c2"
  },
  {
   "text": "这个金库的地址",
   "start": 6.89,
   "end": 8.342,
   "id": "c3"
  },
  {
   "text": "是用一个叫 Profanity 的靶号工具生成的",
   "start": 8.452,
   "end": 11.383,
   "id": "c4"
  },
  {
   "text": "靶号地址",
   "start": 11.687,
   "end": 12.642,
   "id": "c5"
  },
  {
   "text": "就是首尾字符符合指定模式的地址",
   "start": 12.662,
   "end": 15.656,
   "id": "c6"
  },
  {
   "text": "比如开头是一串 0",
   "start": 15.916,
   "end": 17.84,
   "id": "c7"
  },
  {
   "text": "私钥有 256 位 按理说",
   "start": 18.13,
   "end": 21.513,
   "id": "c8"
  },
  {
   "text": "没人猜得出来",
   "start": 21.652,
   "end": 22.81,
   "id": "c9"
  },
  {
   "text": "可这个工具的随机数",
   "start": 23.07,
   "end": 25.316,
   "id": "c10"
  },
  {
   "text": "只用了一个 32 位的种子",
   "start": 25.473,
   "end": 28.203,
   "id": "c11"
  },
  {
   "text": "32 位种子",
   "start": 28.49,
   "end": 29.866,
   "id": "c12"
  },
  {
   "text": "只有约 43 亿种可能",
   "start": 30.264,
   "end": 32.772,
   "id": "c13"
  },
  {
   "text": "做个示例计算",
   "start": 33.03,
   "end": 34.276,
   "id": "c14"
  },
  {
   "text": "如果每秒试 10 亿个种子",
   "start": 34.534,
   "end": 36.661,
   "id": "c15"
  },
  {
   "text": "全部试完",
   "start": 37.232,
   "end": 38.168,
   "id": "c16"
  },
  {
   "text": "最多约 4.3 秒",
   "start": 38.188,
   "end": 39.796,
   "id": "c17"
  },
  {
   "text": "真实攻击还要从种子算出地址",
   "start": 40.149,
   "end": 42.942,
   "id": "c18"
  },
  {
   "text": "会慢一些",
   "start": 42.964,
   "end": 43.68,
   "id": "c19"
  },
  {
   "text": "但一张 GPU",
   "start": 44.139,
   "end": 45.148,
   "id": "c20"
  },
  {
   "text": "几分钟就够",
   "start": 45.168,
   "end": 46.055,
   "id": "c21"
  },
  {
   "text": "那么问题来了",
   "start": 46.364,
   "end": 47.354,
   "id": "c22"
  },
  {
   "text": "一把 256 位的私钥",
   "start": 47.67,
   "end": 49.851,
   "id": "c23"
  },
  {
   "text": "为什么只值 32 位",
   "start": 49.936,
   "end": 51.634,
   "id": "c24"
  },
  {
   "text": "这一集 我们讲私钥从哪里来",
   "start": 52.308,
   "end": 55.491,
   "id": "c25"
  },
  {
   "text": "又是怎么被算出来的",
   "start": 55.711,
   "end": 57.532,
   "id": "c26"
  }
 ]
}