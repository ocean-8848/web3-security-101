 "captions": [
  {
   "text": "防御按层来",
   "start": 1.55,
   "end": 3.046,
   "id": "c0"
  },
  {
   "text": "生成层 用 CSPRNG 或硬件随机源",
   "start": 3.29,
   "end": 7.101,
   "id": "c1"
  },
  {
   "text": "满 256 位熵",
   "start": 7.121,
   "end": 9.688,
   "id": "c2"
  },
  {
   "text": "不在 WASM 和浏览器 JS 里自己替换随机源",
   "start": 9.833,
   "end": 14.756,
   "id": "c3"
  },
  {
   "text": "签名层 用标准 EdDSA 或 RFC 6979",
   "start": 15.03,
   "end": 19.296,
   "id": "c4"
  },
  {
   "text": "再用已知答案测试和差分测试",
   "start": 19.316,
   "end": 23.309,
   "id": "c5"
  },
  {
   "text": "验证封装层",
   "start": 23.39,
   "end": 24.519,
   "id": "c6"
  },
  {
   "text": "监控层 扫描自家地址的签名",
   "start": 24.77,
   "end": 27.402,
   "id": "c7"
  },
  {
   "text": "检测重复的 r 值",
   "start": 27.555,
   "end": 29.097,
   "id": "c8"
  },
  {
   "text": "靶号工具",
   "start": 29.893,
   "end": 30.757,
   "id": "c9"
  },
  {
   "text": "不用来生成管理员或金库地址",
   "start": 30.939,
   "end": 34.174,
   "id": "c10"
  },
  {
   "text": "逐项 MPC 库审计证明及时升级",
   "start": 34.224,
   "end": 36.643,
   "id": "c11"
  },
  {
   "text": "生成缺陷修复后",
   "start": 36.89,
   "end": 38.495,
   "id": "c12"
  },
  {
   "text": "强制用户迁移到新地址",
   "start": 38.708,
   "end": 40.847,
   "id": "c13"
  },
  {
   "text": "按角色 今天就能做一件事",
   "start": 41.207,
   "end": 43.681,
   "id": "c14"
  },
  {
   "text": "钱包开发者",
   "start": 44.063,
   "end": 45.117,
   "id": "c15"
  },
  {
   "text": "搜一遍密钥生成代码",
   "start": 45.139,
   "end": 47.578,
   "id": "c16"
  },
  {
   "text": "确认没有时间戳种子",
   "start": 47.598,
   "end": 49.478,
   "id": "c17"
  },
  {
   "text": "Math.random 和 mt19937",
   "start": 49.498,
   "end": 52.569,
   "id": "c18"
  },
  {
   "text": "审计和安全团队",
   "start": 52.83,
   "end": 54.234,
   "id": "c19"
  },
  {
   "text": "查一遍金库和管理员地址",
   "start": 54.428,
   "end": 56.347,
   "id": "c20"
  },
  {
   "text": "是不是靶号工具生成的",
   "start": 56.767,
   "end": 58.368,
   "id": "c21"
  },
  {
   "text": "普通用户",
   "start": 58.65,
   "end": 59.502,
   "id": "c22"
  },
  {
   "text": "只用主流钱包生成助记词",
   "start": 59.522,
   "end": 61.653,
   "id": "c23"
  },
  {
   "text": "厂商一公告随机数缺陷",
   "start": 61.965,
   "end": 63.962,
   "id": "c24"
  },
  {
   "text": "立刻把资产转到新钱包生成的新地址",
   "start": 63.982,
   "end": 67.229,
   "id": "c25"
  },
  {
   "text": "回到开头的问题",
   "start": 67.607,
   "end": 68.934,
   "id": "c26"
  },
  {
   "text": "一把 256 位的私钥",
   "start": 69.268,
   "end": 71.422,
   "id": "c27"
  },
  {
   "text": "为什么只值 32 位",
   "start": 71.678,
   "end": 73.676,
   "id": "c28"
  },
  {
   "text": "因为私钥的强度",
   "start": 74.25,
   "end": 75.762,
   "id": "c29"
  },
  {
   "text": "取决于生成它的熵",
   "start": 75.805,
   "end": 77.551,
   "id": "c30"
  },
  {
   "text": "熵只有 32 位",
   "start": 78.09,
   "end": 79.577,
   "id": "c31"
  },
  {
   "text": "位数再多",
   "start": 79.747,
   "end": 80.554,
   "id": "c32"
  },
  {
   "text": "也只有 32 位",
   "start": 80.614,
   "end": 81.749,
   "id": "c33"
  },
  {
   "text": "256 位的强度要成立",
   "start": 82.094,
   "end": 84.775,
   "id": "c34"
  },
  {
   "text": "有三个条件",
   "start": 85.199,
   "end": 85.771,
   "id": "c35"
  },
  {
   "text": "熵满 256 位",
   "start": 85.791,
   "end": 86.928,
   "id": "c36"
  },
  {
   "text": "nonce 不可预测",
   "start": 87.144,
   "end": 88.4,
   "id": "c37"
  },
  {
   "text": "实现不偏离标准",
   "start": 88.725,
   "end": 90.297,
   "id": "c38"
  },
  {
   "text": "私钥只有它的种子那么强",
   "start": 90.53,
   "end": 92.714,
   "id": "c39"
  },
  {
   "text": "下一集讲 EVM 与 Solidity",
   "start": 92.93,
   "end": 95.569,
   "id": "c40"
  }
 ]
