 "captions": [
  {
   "text": "先说两个词",
   "start": 1.648,
   "end": 2.77,
   "id": "c0"
  },
  {
   "text": "预言机 是把链外或别的合约里的数据",
   "start": 3.74,
   "end": 6.732,
   "id": "c1"
  },
  {
   "text": "交给合约使用的机制",
   "start": 6.752,
   "end": 8.255,
   "id": "c2"
  },
  {
   "text": "它交出的",
   "start": 9.24,
   "end": 10.243,
   "id": "c3"
  },
  {
   "text": "通常是价格",
   "start": 10.335,
   "end": 11.493,
   "id": "c4"
  },
  {
   "text": "闪电贷 是借款 使用 还款",
   "start": 12.484,
   "end": 16.118,
   "id": "c5"
  },
  {
   "text": "都在同一笔交易里完成的贷款",
   "start": 16.269,
   "end": 18.38,
   "id": "c6"
  },
  {
   "text": "交易结束时没有归还",
   "start": 19.352,
   "end": 21.105,
   "id": "c7"
  },
  {
   "text": "整笔交易回滚",
   "start": 21.256,
   "end": 22.486,
   "id": "c8"
  },
  {
   "text": "就像什么都没发生",
   "start": 22.542,
   "end": 23.819,
   "id": "c9"
  },
  {
   "text": "所以出借方没有风险",
   "start": 24.804,
   "end": 26.855,
   "id": "c10"
  },
  {
   "text": "也不需要抵押",
   "start": 26.97,
   "end": 28.009,
   "id": "c11"
  },
  {
   "text": "这意味着",
   "start": 29.008,
   "end": 29.963,
   "id": "c12"
  },
  {
   "text": "本金不再是门槛",
   "start": 30.079,
   "end": 31.404,
   "id": "c13"
  },
  {
   "text": "任何人都能在一笔交易里",
   "start": 32.396,
   "end": 34.113,
   "id": "c14"
  },
  {
   "text": "借到闪电贷池的全部流动性",
   "start": 34.241,
   "end": 36.351,
   "id": "c15"
  },
  {
   "text": "打个比方",
   "start": 37.344,
   "end": 38.299,
   "id": "c16"
  },
  {
   "text": "一家当铺",
   "start": 38.663,
   "end": 39.654,
   "id": "c17"
  },
  {
   "text": "按隔壁菜市场的最新成交价",
   "start": 39.806,
   "end": 42.285,
   "id": "c18"
  },
  {
   "text": "给黄金估价",
   "start": 42.317,
   "end": 43.452,
   "id": "c19"
  },
  {
   "text": "你从朋友那里",
   "start": 44.452,
   "end": 45.693,
   "id": "c20"
  },
  {
   "text": "借来 1 亿",
   "start": 45.844,
   "end": 46.824,
   "id": "c21"
  },
  {
   "text": "在菜市场用离谱的高价",
   "start": 47.792,
   "end": 49.902,
   "id": "c22"
  },
  {
   "text": "买下全部黄金",
   "start": 50.101,
   "end": 51.497,
   "id": "c23"
  },
  {
   "text": "再拿 1 克黄金去当铺",
   "start": 52.5,
   "end": 54.074,
   "id": "c24"
  },
  {
   "text": "当铺按刚才的成交价",
   "start": 55.072,
   "end": 56.801,
   "id": "c25"
  },
  {
   "text": "估值 100 万",
   "start": 56.845,
   "end": 57.837,
   "id": "c26"
  },
  {
   "text": "借给你 75 万",
   "start": 58.036,
   "end": 59.325,
   "id": "c27"
  },
  {
   "text": "你把黄金卖回菜市场",
   "start": 60.308,
   "end": 62.013,
   "id": "c28"
  },
  {
   "text": "把 1 亿还给朋友",
   "start": 62.141,
   "end": 63.382,
   "id": "c29"
  },
  {
   "text": "你赚到 75 万",
   "start": 64.368,
   "end": 65.811,
   "id": "c30"
  },
  {
   "text": "减去买卖的损耗",
   "start": 65.88,
   "end": 67.407,
   "id": "c31"
  },
  {
   "text": "当铺手里",
   "start": 68.404,
   "end": 69.395,
   "id": "c32"
  },
  {
   "text": "只剩 1 克普通价格的黄金",
   "start": 69.523,
   "end": 71.443,
   "id": "c33"
  },
  {
   "text": "比喻在这里不成立 现实中",
   "start": 72.44,
   "end": 74.895,
   "id": "c34"
  },
  {
   "text": "这几步要好几天",
   "start": 74.975,
   "end": 76.479,
   "id": "c35"
  },
  {
   "text": "链上 它们发生在同一个区块的同一笔交易里",
   "start": 77.46,
   "end": 80.856,
   "id": "c36"
  },
  {
   "text": "没有人来得及反应",
   "start": 81.219,
   "end": 82.591,
   "id": "c37"
  },
  {
   "text": "那么 一笔交易里",
   "start": 83.584,
   "end": 85.432,
   "id": "c38"
  },
  {
   "text": "攻击者能改变什么",
   "start": 85.56,
   "end": 86.873,
   "id": "c39"
  },
  {
   "text": "他能把任何 AMM 池子的现货价",
   "start": 88.14,
   "end": 90.345,
   "id": "c40"
  },
  {
   "text": "推到想要的位置",
   "start": 90.413,
   "end": 91.632,
   "id": "c41"
  },
  {
   "text": "只要付得起滑点",
   "start": 91.652,
   "end": 92.869,
   "id": "c42"
  },
  {
   "text": "他能直接往合约里转入资产",
   "start": 93.856,
   "end": 96.24,
   "id": "c43"
  },
  {
   "text": "改变余额读数",
   "start": 96.391,
   "end": 97.633,
   "id": "c44"
  },
  {
   "text": "他能把这些操作",
   "start": 98.612,
   "end": 99.948,
   "id": "c45"
  },
  {
   "text": "和对目标协议的调用",
   "start": 99.969,
   "end": 101.544,
   "id": "c46"
  },
  {
   "text": "任意组合",
   "start": 101.635,
   "end": 102.686,
   "id": "c47"
  },
  {
   "text": "于是有一条规则",
   "start": 103.656,
   "end": 104.921,
   "id": "c48"
  },
  {
   "text": "一笔交易内可变的读数",
   "start": 105.12,
   "end": 106.838,
   "id": "c49"
  },
  {
   "text": "都是攻击者的输入参数",
   "start": 106.858,
   "end": 108.492,
   "id": "c50"
  },
  {
   "text": "池子的储备比例 可变",
   "start": 109.492,
   "end": 111.804,
   "id": "c51"
  },
  {
   "text": "按储备算出的 LP 代币价格 可变",
   "start": 112.168,
   "end": 115.314,
   "id": "c52"
  },
  {
   "text": "合约的余额 可变",
   "start": 116.288,
   "end": 118.172,
   "id": "c53"
  },
  {
   "text": "读余额算出的金库份额价格",
   "start": 118.535,
   "end": 120.694,
   "id": "c54"
  },
  {
   "text": "可以被捐赠改变",
   "start": 120.714,
   "end": 122.146,
   "id": "c55"
  },
  {
   "text": "时间加权平均价",
   "start": 123.132,
   "end": 124.647,
   "id": "c56"
  },
  {
   "text": "当前区块很难撼动",
   "start": 124.751,
   "end": 126.48,
   "id": "c57"
  },
  {
   "text": "链下聚合的价格",
   "start": 126.855,
   "end": 128.383,
   "id": "c58"
  },
  {
   "text": "一笔交易改不动",
   "start": 128.451,
   "end": 129.704,
   "id": "c59"
  },
  {
   "text": "但它们会过时",
   "start": 130.672,
   "end": 131.949,
   "id": "c60"
  },
  {
   "text": "也会撞上上下限",
   "start": 131.981,
   "end": 133.33,
   "id": "c61"
  }
 ]
}