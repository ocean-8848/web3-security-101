 "captions": [
  {
   "text": "最常见的错误",
   "start": 1.648,
   "end": 2.818,
   "id": "c0"
  },
  {
   "text": "是用 AMM 的现货价定价",
   "start": 2.838,
   "end": 4.925,
   "id": "c1"
  },
  {
   "text": "恒定乘积池里",
   "start": 5.924,
   "end": 7.344,
   "id": "c2"
  },
  {
   "text": "两种资产的数量相乘",
   "start": 7.519,
   "end": 9.379,
   "id": "c3"
  },
  {
   "text": "保持不变",
   "start": 9.4,
   "end": 10.248,
   "id": "c4"
  },
  {
   "text": "现货价 就是两边储备的比值",
   "start": 11.232,
   "end": 13.914,
   "id": "c5"
  },
  {
   "text": "再猜一道题",
   "start": 14.908,
   "end": 16.185,
   "id": "c6"
  },
  {
   "text": "这是示例",
   "start": 16.548,
   "end": 17.468,
   "id": "c7"
  },
  {
   "text": "忽略手续费",
   "start": 17.512,
   "end": 18.611,
   "id": "c8"
  },
  {
   "text": "池子里有 1000 个 ETH",
   "start": 19.592,
   "end": 21.321,
   "id": "c9"
  },
  {
   "text": "和 200 万 USDC",
   "start": 21.354,
   "end": 22.988,
   "id": "c10"
  },
  {
   "text": "现货价是 2000",
   "start": 23.351,
   "end": 24.902,
   "id": "c11"
  },
  {
   "text": "有人用 400 万 USDC",
   "start": 25.884,
   "end": 28.292,
   "id": "c12"
  },
  {
   "text": "买入 ETH",
   "start": 28.348,
   "end": 29.351,
   "id": "c13"
  },
  {
   "text": "现货价会变成多少",
   "start": 30.328,
   "end": 32.069,
   "id": "c14"
  },
  {
   "text": "大约 18000",
   "start": 33.348,
   "end": 34.851,
   "id": "c15"
  },
  {
   "text": "USDC 储备变成 600 万",
   "start": 35.226,
   "end": 37.527,
   "id": "c16"
  },
  {
   "text": "ETH 只剩约 333 个",
   "start": 37.643,
   "end": 39.634,
   "id": "c17"
  },
  {
   "text": "价格涨到原来的 9 倍",
   "start": 40.624,
   "end": 42.294,
   "id": "c18"
  },
  {
   "text": "只用了一笔交换",
   "start": 42.657,
   "end": 43.875,
   "id": "c19"
  },
  {
   "text": "现在看一个借贷合约",
   "start": 44.876,
   "end": 46.415,
   "id": "c20"
  },
  {
   "text": "它读取池子的储备",
   "start": 47.4,
   "end": 48.987,
   "id": "c21"
  },
  {
   "text": "用两边的比值当价格",
   "start": 49.007,
   "end": 50.867,
   "id": "c22"
  },
  {
   "text": "抵押品价值",
   "start": 51.868,
   "end": 53.157,
   "id": "c23"
  },
  {
   "text": "等于数量乘这个价格",
   "start": 53.201,
   "end": 54.752,
   "id": "c24"
  },
  {
   "text": "最多借出价值的百分之 75",
   "start": 55.127,
   "end": 57.476,
   "id": "c25"
  },
  {
   "text": "这也是示例",
   "start": 57.841,
   "end": 58.892,
   "id": "c26"
  },
  {
   "text": "把这几步串起来",
   "start": 59.888,
   "end": 61.26,
   "id": "c27"
  },
  {
   "text": "是一笔交易里的五个动作",
   "start": 61.28,
   "end": 62.915,
   "id": "c28"
  },
  {
   "text": "第一 借出闪电贷",
   "start": 63.9,
   "end": 65.76,
   "id": "c29"
  },
  {
   "text": "在池子里买入代币",
   "start": 65.804,
   "end": 67.201,
   "id": "c30"
  },
  {
   "text": "把现货价推高",
   "start": 67.34,
   "end": 68.605,
   "id": "c31"
  },
  {
   "text": "第二 存入少量代币",
   "start": 69.592,
   "end": 71.643,
   "id": "c32"
  },
  {
   "text": "作为抵押",
   "start": 71.711,
   "end": 72.643,
   "id": "c33"
  },
  {
   "text": "第三 协议读取储备",
   "start": 73.628,
   "end": 75.929,
   "id": "c34"
  },
  {
   "text": "按虚高的价格",
   "start": 76.02,
   "end": 77.274,
   "id": "c35"
  },
  {
   "text": "借出大笔资金",
   "start": 77.294,
   "end": 78.631,
   "id": "c36"
  },
  {
   "text": "第四 卖回代币",
   "start": 79.632,
   "end": 81.397,
   "id": "c37"
  },
  {
   "text": "第五 归还闪电贷和手续费",
   "start": 82.396,
   "end": 84.994,
   "id": "c38"
  },
  {
   "text": "交易结束",
   "start": 85.976,
   "end": 86.955,
   "id": "c39"
  },
  {
   "text": "抵押品的真实价值",
   "start": 87.166,
   "end": 88.753,
   "id": "c40"
  },
  {
   "text": "远低于借款",
   "start": 88.773,
   "end": 89.919,
   "id": "c41"
  },
  {
   "text": "协议留下坏账",
   "start": 90.295,
   "end": 91.679,
   "id": "c42"
  },
  {
   "text": "利润 是借出的金额",
   "start": 92.676,
   "end": 94.655,
   "id": "c43"
  },
  {
   "text": "减去两次交换的滑点 手续费",
   "start": 94.711,
   "end": 97.429,
   "id": "c44"
  },
  {
   "text": "和闪电贷费用",
   "start": 97.461,
   "end": 98.619,
   "id": "c45"
  },
  {
   "text": "池子越浅",
   "start": 99.616,
   "end": 100.691,
   "id": "c46"
  },
  {
   "text": "推高价格越便宜",
   "start": 100.711,
   "end": 102.119,
   "id": "c47"
  },
  {
   "text": "长尾资产和低流动性代币",
   "start": 102.482,
   "end": 104.962,
   "id": "c48"
  },
  {
   "text": "风险最高",
   "start": 105.066,
   "end": 106.164,
   "id": "c49"
  },
  {
   "text": "这类事件",
   "start": 107.156,
   "end": 108.111,
   "id": "c50"
  },
  {
   "text": "在公开报道里反复出现",
   "start": 108.179,
   "end": 110.04,
   "id": "c51"
  },
  {
   "text": "2020 年 2 月的 bZx",
   "start": 111.024,
   "end": 113.003,
   "id": "c52"
  },
  {
   "text": "是最早被广泛报道的闪电贷价格操纵之一",
   "start": 113.024,
   "end": 116.11,
   "id": "c53"
  },
  {
   "text": "两次合计约 95 万美元",
   "start": 116.309,
   "end": 118.598,
   "id": "c54"
  },
  {
   "text": "2021 年 5 月",
   "start": 119.596,
   "end": 120.813,
   "id": "c55"
  },
  {
   "text": "BNB Chain 上的 PancakeBunny",
   "start": 120.917,
   "end": 123.063,
   "id": "c56"
  },
  {
   "text": "按池子储备计算 LP 代币价值",
   "start": 123.131,
   "end": 125.635,
   "id": "c57"
  },
  {
   "text": "损失约 4500 万美元",
   "start": 125.667,
   "end": 127.813,
   "id": "c58"
  },
  {
   "text": "2021 年 10 月",
   "start": 128.792,
   "end": 130.021,
   "id": "c59"
  },
  {
   "text": "Cream Finance 用金库份额价格",
   "start": 130.173,
   "end": 132.653,
   "id": "c60"
  },
  {
   "text": "给抵押品估值",
   "start": 132.673,
   "end": 133.914,
   "id": "c61"
  },
  {
   "text": "攻击者向金库捐赠",
   "start": 134.892,
   "end": 136.573,
   "id": "c62"
  },
  {
   "text": "抬高份额价格",
   "start": 136.63,
   "end": 138.05,
   "id": "c63"
  },
  {
   "text": "损失约 1.3 亿美元",
   "start": 138.425,
   "end": 140.297,
   "id": "c64"
  },
  {
   "text": "三起事件",
   "start": 141.28,
   "end": 142.211,
   "id": "c65"
  },
  {
   "text": "根因一样",
   "start": 142.244,
   "end": 143.057,
   "id": "c66"
  },
  {
   "text": "价格来自一笔交易就能改写的数据",
   "start": 143.375,
   "end": 145.914,
   "id": "c67"
  }
