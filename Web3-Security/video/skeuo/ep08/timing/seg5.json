 "captions": [
  {
   "text": "选了链下预言机",
   "start": 1.648,
   "end": 2.972,
   "id": "c0"
  },
  {
   "text": "读取时还要做四项检查",
   "start": 3.04,
   "end": 5.258,
   "id": "c1"
  },
  {
   "text": "一 价格大于 0",
   "start": 6.26,
   "end": 8.358,
   "id": "c2"
  },
  {
   "text": "二 时效 现在的时间减去更新时间",
   "start": 9.336,
   "end": 13.125,
   "id": "c3"
  },
  {
   "text": "不超过这个喂价的心跳",
   "start": 13.169,
   "end": 14.744,
   "id": "c4"
  },
  {
   "text": "三 上下限",
   "start": 15.724,
   "end": 17.382,
   "id": "c5"
  },
  {
   "text": "价格落在合理的区间里",
   "start": 17.593,
   "end": 19.358,
   "id": "c6"
  },
  {
   "text": "四 精度 从喂价读取小数位数",
   "start": 20.336,
   "end": 23.589,
   "id": "c7"
  },
  {
   "text": "不要写死 8",
   "start": 23.633,
   "end": 24.613,
   "id": "c8"
  },
  {
   "text": "为什么要查上下限",
   "start": 25.596,
   "end": 26.944,
   "id": "c9"
  },
  {
   "text": "看一个案例",
   "start": 27.319,
   "end": 28.335,
   "id": "c10"
  },
  {
   "text": "2022 年 5 月",
