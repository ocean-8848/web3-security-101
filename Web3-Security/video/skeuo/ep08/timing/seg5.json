   "text": "第一",
   "start": 80.768,
   "end": 81.295,
   "id": "c34"
  },
  {
   "text": "不要用 latestAnswer",
   "start": 81.518,
   "end": 82.855,
   "id": "c35"
  },
  {
   "text": "判断价格新不新鲜",
   "start": 82.875,
   "end": 84.521,
   "id": "c36"
  },
  {
   "text": "Chainlink 的 API 文档写明",
   "start": 85.5,
   "end": 87.789,
   "id": "c37"
  },
  {
   "text": "它不含时间戳",
   "start": 87.809,
   "end": 88.979,
   "id": "c38"
  },
  {
   "text": "改用 latestRoundData",
   "start": 89.354,
   "end": 91.096,
   "id": "c39"
  },
  {
   "text": "第二 每个喂价的心跳不同",
   "start": 92.08,
   "end": 94.559,
   "id": "c40"
  },
  {
   "text": "不要给所有资产",
   "start": 94.934,
   "end": 96.319,
   "id": "c41"
  },
  {
   "text": "用同一个延迟上限",
   "start": 96.434,
   "end": 97.926,
   "id": "c42"
  },
  {
   "text": "第三 喂价失效时",
   "start": 98.924,
   "end": 101.177,
   "id": "c43"
  },
  {
   "text": "要有降级路径",
   "start": 101.221,
   "end": 102.498,
   "id": "c44"
  },
  {
   "text": "用 try catch 包住读取",
   "start": 103.488,
   "end": 105.384,
   "id": "c45"
  },
  {
   "text": "切到备用价格源",
   "start": 105.428,
   "end": 106.753,
   "id": "c46"
  },
  {
   "text": "或者暂停",
   "start": 106.773,
   "end": 107.729,
   "id": "c47"
  },
  {
   "text": "不要让清算全部回滚",
   "start": 108.104,
   "end": 109.798,
   "id": "c48"
  },
  {
   "text": "第四 拉取式预言机",
   "start": 110.788,
   "end": 112.839,
   "id": "c49"
  },
  {
   "text": "由用户在交易里提交签名价格",
   "start": 113.014,
   "end": 115.648,
   "id": "c50"
  },
  {
   "text": "提交者可以挑一个对自己有利的更新",
   "start": 116.648,
   "end": 119.306,
   "id": "c51"
  },
  {
   "text": "按 Pyth 文档",
   "start": 120.3,
   "end": 121.803,
   "id": "c52"
  },
  {
   "text": "合约要自己检查价格的时间戳和置信区间",
   "start": 121.954,
   "end": 125.172,
   "id": "c53"
  },
  {
   "text": "在 L2 上",
   "start": 126.16,
   "end": 127.258,
   "id": "c54"
  },
  {
   "text": "要多查一项",
   "start": 127.338,
   "end": 128.365,
   "id": "c55"
  },
  {
   "text": "排序器是否在线",
   "start": 128.457,
   "end": 129.984,
   "id": "c56"
  },
  {
   "text": "排序器宕机时",
   "start": 130.964,
   "end": 132.384,
   "id": "c57"
  },
  {
   "text": "喂价交易上不了链",
   "start": 132.511,
   "end": 133.931,
   "id": "c58"
  },
  {
   "text": "价格停在宕机前",
   "start": 134.106,
   "end": 135.526,
   "id": "c59"
  },
  {
   "text": "恢复后的第一批区块里",
   "start": 136.512,
   "end": 138.17,
   "id": "c60"
  },
  {
   "text": "清算机器人和普通用户同时涌入",
   "start": 138.285,
   "end": 141.217,
   "id": "c61"
  },
  {
   "text": "能通过 L1 强制提交交易的少数人",
   "start": 142.204,
   "end": 145.279,
   "id": "c62"
  },
  {
   "text": "占了先机",
   "start": 145.299,
   "end": 146.147,
   "id": "c63"
  },
  {
   "text": "按 L2BEAT 截至 2026 年 11 月的页面",
   "start": 147.128,
   "end": 150.214,
   "id": "c64"
  },
  {
   "text": "Mantle 排序器宕机时",
   "start": 150.318,
   "end": 151.976,
   "id": "c65"
  },
  {
   "text": "从 L1 强制提交",
   "start": 152.02,
   "end": 153.715,
   "id": "c66"
  },
  {
   "text": "最长要等 12 小时",
   "start": 153.735,
   "end": 155.381,
   "id": "c67"
  },
  {
   "text": "做法是读取 Chainlink",
   "start": 156.372,
   "end": 158.518,
   "id": "c68"
  },
  {
   "text": "提供的排序器在线状态喂价",
   "start": 158.538,
   "end": 160.958,
   "id": "c69"
  },
  {
   "text": "恢复后设一段宽限期",
   "start": 161.944,
   "end": 163.721,
   "id": "c70"
  },
  {
   "text": "比如 1 小时",
   "start": 163.777,
   "end": 164.816,
   "id": "c71"
  },
  {
   "text": "这是示例",
   "start": 164.836,
   "end": 165.661,
   "id": "c72"
  },
  {
   "text": "宽限期内",
   "start": 166.652,
   "end": 167.619,
   "id": "c73"
  },
  {
   "text": "暂停清算和新借款",
   "start": 167.664,
   "end": 169.512,
   "id": "c74"
  }
 ]
}