 "captions": [
  {
   "text": "2017 年 11 月",
   "start": 1.644,
   "end": 3.216,
   "id": "c0"
  },
  {
   "text": "以太坊上发生了一件怪事",
   "start": 3.514,
   "end": 5.626,
   "id": "c1"
  },
  {
   "text": "有个用户",
   "start": 5.947,
   "end": 6.712,
   "id": "c2"
  },
  {
   "text": "调用了一个库合约的初始化函数",
   "start": 6.749,
   "end": 9.338,
   "id": "c3"
  },
  {
   "text": "这个库 是 Parity 多签钱包共用的代码",
   "start": 9.688,
   "end": 12.764,
   "id": "c4"
  },
  {
   "text": "部署之后",
   "start": 13.107,
   "end": 13.973,
   "id": "c5"
  },
  {
   "text": "从来没有人初始化过它",
   "start": 14.008,
   "end": 16.223,
   "id": "c6"
  },
  {
   "text": "于是 他成了这个库的 owner",
   "start": 16.521,
   "end": 18.559,
   "id": "c7"
  },
  {
   "text": "接着 他调用了 kill",
   "start": 18.81,
   "end": 20.567,
   "id": "c8"
  },
  {
   "text": "把库合约销毁了",
   "start": 20.828,
   "end": 22.211,
   "id": "c9"
  },
  {
   "text": "依赖这个库的钱包",
   "start": 22.56,
   "end": 23.949,
   "id": "c10"
  },
  {
   "text": "一下子失去了代码逻辑",
   "start": 24.045,
   "end": 25.868,
   "id": "c11"
  },
  {
   "text": "约 51 万 ETH",
   "start": 26.13,
   "end": 28.009,
   "id": "c12"
  },
  {
   "text": "就此冻结",
   "start": 28.052,
   "end": 28.903,
   "id": "c13"
  },
  {
   "text": "他没有破解任何密码",
   "start": 29.15,
   "end": 31.09,
   "id": "c14"
  },
  {
   "text": "也没有偷任何私钥",
   "start": 31.47,
   "end": 33.297,
   "id": "c15"
  },
  {
   "text": "他只是调用了一个",
   "start": 33.53,
   "end": 34.925,
   "id": "c16"
  },
  {
   "text": "没有权限检查的函数",
   "start": 34.988,
   "end": 36.94,
   "id": "c17"
  },
  {
   "text": "这一集讲访问控制",
   "start": 37.289,
   "end": 39.131,
   "id": "c18"
  },
  {
   "text": "每个按钮背后",
   "start": 39.508,
   "end": 40.566,
   "id": "c19"
  },
  {
   "text": "都有同一个问题",
   "start": 40.74,
   "end": 43.043,
   "id": "c20"
  },
  {
   "text": "谁有权按它",
   "start": 43.197,
   "end": 44.245,
   "id": "c21"
  }
 ]
}