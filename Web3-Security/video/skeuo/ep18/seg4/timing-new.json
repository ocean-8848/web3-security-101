 "captions": [
  {
   "text": "回到开头的冷钱包",
   "start": 1.648,
   "end": 3.282,
   "id": "c0"
  },
  {
   "text": "六把钥匙里",
   "start": 4.268,
   "end": 5.259,
   "id": "c1"
  },
  {
   "text": "WazirX 持五把",
   "start": 5.28,
   "end": 6.783,
   "id": "c2"
  },
  {
   "text": "Liminal 持一把",
   "start": 6.863,
   "end": 8.033,
   "id": "c3"
  },
  {
   "text": "签名人在 Liminal 界面上看到的交易",
   "start": 9.0,
   "end": 11.515,
   "id": "c4"
  },
  {
   "text": "和实际签下的不一样",
   "start": 11.535,
   "end": 13.062,
   "id": "c5"
  },
  {
   "text": "实际签下的",
   "start": 14.044,
   "end": 15.202,
   "id": "c6"
  },
  {
   "text": "是一次合约升级",
   "start": 15.222,
   "end": 16.761,
   "id": "c7"
  },
  {
   "text": "钱包控制权被转走",
   "start": 16.782,
   "end": 18.416,
   "id": "c8"
  },
  {
   "text": "接手的是一个恶意合约",
   "start": 19.376,
   "end": 20.974,
   "id": "c9"
  },
  {
   "text": "它提前 8 天就部署好",
   "start": 21.114,
   "end": 22.784,
   "id": "c10"
  },
  {
   "text": "WazirX 称",
   "start": 23.772,
   "end": 24.954,
   "id": "c11"
  },
  {
   "text": "问题出在 Liminal 界面显示的数据",
   "start": 25.081,
   "end": 27.549,
   "id": "c12"
  },
  {
   "text": "Liminal 称",
   "start": 28.528,
   "end": 29.471,
   "id": "c13"
  },
  {
   "text": "自己的基础设施没有被攻破",
   "start": 29.599,
   "end": 31.746,
   "id": "c14"
  },
  {
   "text": "是受害方的 3 台机器被注入恶意载荷",
   "start": 31.766,
   "end": 34.733,
   "id": "c15"
  },
  {
   "text": "这一争议",
   "start": 35.732,
   "end": 36.687,
   "id": "c16"
  },
  {
   "text": "没有见到最终的独立报告",
   "start": 36.886,
   "end": 38.949,
   "id": "c17"
  },
  {
   "text": "多签只保证",
   "start": 39.936,
   "end": 41.01,
   "id": "c18"
  },
  {
   "text": "足够多的人同意某个哈希",
   "start": 41.174,
   "end": 43.237,
   "id": "c19"
  },
  {
   "text": "它不管这个哈希",
   "start": 44.236,
   "end": 45.56,
   "id": "c20"
  },
  {
   "text": "代表的是哪一笔交易",
   "start": 45.795,
   "end": 47.548,
   "id": "c21"
  },
  {
   "text": "签名人看到的和实际签的不一样",
   "start": 48.536,
   "end": 51.218,
   "id": "c22"
  },
  {
   "text": "每把钥匙都会正常工作",
   "start": 51.452,
   "end": 53.634,
   "id": "c23"
  },
  {
   "text": "防线在签名人自己这一侧",
   "start": 54.636,
   "end": 56.603,
   "id": "c24"
  },
  {
   "text": "每个签名人",
   "start": 57.592,
   "end": 58.679,
   "id": "c25"
  },
  {
   "text": "在自己的设备上",
   "start": 58.699,
   "end": 59.869,
   "id": "c26"
  },
  {
   "text": "用另一套代码",
   "start": 59.889,
   "end": 61.059,
   "id": "c27"
  },
  {
   "text": "独立算一遍交易哈希",
   "start": 61.246,
   "end": 63.226,
   "id": "c28"
  },
  {
   "text": "再在硬件钱包屏幕上",
   "start": 64.22,
   "end": 65.949,
   "id": "c29"
  },
  {
   "text": "核对收款地址 金额",
   "start": 66.101,
   "end": 68.307,
   "id": "c30"
  },
  {
   "text": "数据和操作类型",
   "start": 68.327,
   "end": 70.223,
   "id": "c31"
  },
  {
   "text": "设备把交易解析成人能读懂的字段再签",
   "start": 71.208,
   "end": 74.616,
   "id": "c32"
  },
  {
   "text": "这叫清晰签名",
   "start": 74.708,
   "end": 76.032,
   "id": "c33"
  },
  {
   "text": "例行转账",
   "start": 77.02,
   "end": 77.987,
   "id": "c34"
  },
  {
   "text": "操作类型应该是 CALL",
   "start": 78.079,
   "end": 79.856,
   "id": "c35"
  },
  {
   "text": "如果是 DELEGATECALL",
   "start": 80.816,
   "end": 82.521,
   "id": "c36"
  },
  {
   "text": "就是让多签合约执行外部代码 不签",
   "start": 82.589,
   "end": 85.795,
   "id": "c37"
  },
  {
   "text": "大额交易",
   "start": 86.772,
   "end": 87.763,
   "id": "c38"
  },
  {
   "text": "再用电话或当面",
   "start": 87.891,
   "end": 89.287,
   "id": "c39"
  },
  {
   "text": "确认发起人身份",
   "start": 89.45,
   "end": 90.811,
   "id": "c40"
  },
  {
   "text": "签名人不能共用一台电脑",
   "start": 91.792,
   "end": 93.795,
   "id": "c41"
  },
  {
   "text": "一个浏览器",
   "start": 93.899,
   "end": 94.878,
   "id": "c42"
  },
  {
   "text": "一个前端",
   "start": 95.018,
   "end": 95.974,
   "id": "c43"
  },
  {
   "text": "共用就是单点",
   "start": 96.113,
   "end": 97.152,
   "id": "c44"
  },
  {
   "text": "局限是 如果所有人用同一个解码工具",
   "start": 98.132,
   "end": 101.575,
   "id": "c45"
  },
  {
   "text": "这个工具就是新的单点",
   "start": 101.703,
   "end": 103.456,
   "id": "c46"
  }
 ]
}