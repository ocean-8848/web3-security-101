 "captions": [
  {
   "text": "一把密钥",
   "start": 1.648,
   "end": 2.556,
   "id": "c0"
  },
  {
   "text": "要经过生成 存储 使用 备份",
   "start": 2.576,
   "end": 6.199,
   "id": "c1"
  },
  {
   "text": "轮换和销毁",
   "start": 6.279,
   "end": 7.556,
   "id": "c2"
  },
  {
   "text": "每一步 都出过真实事故",
   "start": 8.54,
   "end": 10.721,
   "id": "c3"
  },
  {
   "text": "先看生成",
   "start": 11.712,
   "end": 12.846,
   "id": "c4"
  },
  {
   "text": "Profanity 是一个靶号地址生成器",
   "start": 13.828,
   "end": 16.379,
   "id": "c5"
  },
  {
   "text": "它的随机种子只有 32 位",
   "start": 17.36,
   "end": 19.78,
   "id": "c6"
  },
  {
   "text": "约 43 亿种",
   "start": 19.895,
   "end": 21.102,
   "id": "c7"
  },
  {
   "text": "私钥可以被 GPU 反推",
   "start": 21.122,
   "end": 23.256,
   "id": "c8"
  },
  {
   "text": "2022 年 9 月",
   "start": 24.252,
   "end": 25.564,
   "id": "c9"
  },
  {
   "text": "1inch 公开了这个问题",
   "start": 25.68,
   "end": 27.457,
   "id": "c10"
  },
  {
   "text": "Wintermute 把这样一个地址",
   "start": 28.456,
   "end": 30.305,
   "id": "c11"
  },
  {
   "text": "用作金库的管理员",
   "start": 30.325,
   "end": 31.864,
   "id": "c12"
  },
  {
   "text": "披露后 它转走了地址里的 ETH",
   "start": 32.852,
   "end": 35.45,
   "id": "c13"
  },
  {
   "text": "却没有撤销管理员权限",
   "start": 35.518,
   "end": 37.355,
   "id": "c14"
  },
  {
   "text": "约 5 天后",
   "start": 38.352,
   "end": 39.295,
   "id": "c15"
  },
  {
   "text": "金库被盗约 1.6 亿美元",
   "start": 39.423,
   "end": 41.593,
   "id": "c16"
  },
  {
   "text": "转走余额",
   "start": 42.58,
   "end": 43.678,
   "id": "c17"
  },
  {
   "text": "不等于消除风险",
   "start": 43.758,
   "end": 45.119,
   "id": "c18"
  },
  {
   "text": "权限也要撤销",
   "start": 45.234,
   "end": 46.595,
   "id": "c19"
  },
  {
   "text": "资金地址要在可信硬件里生成",
   "start": 47.576,
   "end": 50.246,
   "id": "c20"
  },
  {
   "text": "不用靶号工具",
   "start": 50.326,
   "end": 51.412,
   "id": "c21"
  },
  {
   "text": "再看存储",
   "start": 52.404,
   "end": 53.455,
   "id": "c22"
  },
  {
   "text": "2022 年 8 月",
   "start": 54.496,
   "end": 55.713,
   "id": "c23"
  },
  {
   "text": "Slope 钱包把助记词以",
   "start": 55.758,
   "end": 57.845,
   "id": "c24"
  },
  {
   "text": "明文发到自己的日志服务器",
   "start": 57.865,
   "end": 59.689,
   "id": "c25"
  },
  {
   "text": "Solana 官方通报",
   "start": 60.692,
   "end": 62.016,
   "id": "c26"
  },
  {
   "text": "约 9231 个钱包受影响",
   "start": 62.049,
   "end": 64.409,
   "id": "c27"
  },
  {
   "text": "损失约 410 万美元",
   "start": 64.561,
   "end": 66.516,
   "id": "c28"
  },
  {
   "text": "日志 崩溃上报 遥测",
   "start": 67.512,
   "end": 70.277,
   "id": "c29"
  },
  {
   "text": "都是密钥的泄露通道",
   "start": 70.321,
   "end": 71.932,
   "id": "c30"
  },
  {
   "text": "客户端要在采集这一端",
   "start": 72.916,
   "end": 74.931,
   "id": "c31"
  },
  {
   "text": "就把密钥材料屏蔽掉",
   "start": 74.951,
   "end": 76.705,
   "id": "c32"
  },
  {
   "text": "钱包的发布链路",
   "start": 77.672,
   "end": 79.032,
   "id": "c33"
  },
  {
   "text": "也是一把钥匙",
   "start": 79.16,
   "end": 80.175,
   "id": "c34"
  },
  {
   "text": "2025 年 12 月",
   "start": 81.156,
   "end": 82.564,
   "id": "c35"
  },
  {
   "text": "Trust Wallet 的浏览器扩展",
   "start": 82.596,
   "end": 84.587,
   "id": "c36"
  },
  {
   "text": "有一个恶意版本出现在 Chrome 商店",
   "start": 84.679,
   "end": 87.088,
   "id": "c37"
  },
  {
   "text": "它导出扩展里所有钱包的助记词",
   "start": 88.072,
   "end": 90.539,
   "id": "c38"
  },
  {
   "text": "约 850 万美元被盗",
   "start": 90.762,
   "end": 92.456,
   "id": "c39"
  },
  {
   "text": "项目方称",
   "start": 93.428,
   "end": 94.395,
   "id": "c40"
  },
  {
   "text": "攻击者用泄露的 GitHub secrets",
   "start": 94.582,
   "end": 96.908,
   "id": "c41"
  },
  {
   "text": "拿到商店的 API Key",
   "start": 96.928,
   "end": 98.788,
   "id": "c42"
  },
  {
   "text": "发布凭证和 CI 密钥",
   "start": 99.768,
   "end": 101.58,
   "id": "c43"
  },
  {
   "text": "本身就是资金级的资产",
   "start": 101.613,
   "end": 103.295,
   "id": "c44"
  },
  {
   "text": "最后看备份和分片",
   "start": 104.284,
   "end": 106.239,
   "id": "c45"
  },
  {
   "text": "2023 年 7 月",
   "start": 107.24,
   "end": 108.517,
   "id": "c46"
  },
  {
   "text": "Multichain 的 MPC 地址出现异常转出",
   "start": 108.632,
   "end": 111.802,
   "id": "c47"
  },
  {
   "text": "约 1.26 亿美元",
   "start": 111.882,
   "end": 113.362,
   "id": "c48"
  },
  {
   "text": "项目方声明",
   "start": 114.348,
   "end": 115.459,
   "id": "c49"
  },
  {
   "text": "全部 MPC 节点服务器",
   "start": 115.479,
   "end": 117.672,
   "id": "c50"
  },
  {
   "text": "都在 CEO 的个人云账户上",
   "start": 117.693,
   "end": 119.732,
   "id": "c51"
  },
  {
   "text": "CEO 被警方带走后",
   "start": 120.712,
   "end": 122.655,
   "id": "c52"
  },
  {
   "text": "团队无法登录",
   "start": 122.7,
   "end": 124.001,
   "id": "c53"
  },
  {
   "text": "外部攻击或内部转移",
   "start": 124.988,
   "end": 126.872,
   "id": "c54"
  },
  {
   "text": "外界有争议",
   "start": 127.023,
   "end": 128.039,
   "id": "c55"
  },
  {
   "text": "没有官方定性",
   "start": 128.095,
   "end": 129.253,
   "id": "c56"
  },
  {
   "text": "MPC 的前提是分片独立",
   "start": 130.248,
   "end": 132.56,
   "id": "c57"
  },
  {
   "text": "分片都在一个人手里",
   "start": 132.652,
   "end": 134.132,
   "id": "c58"
  },
  {
   "text": "门限只是名义上的",
   "start": 134.152,
   "end": 135.525,
   "id": "c59"
  },
  {
   "text": "分片要放在不同组织",
   "start": 136.492,
   "end": 138.162,
   "id": "c60"
  },
  {
   "text": "不同地域",
   "start": 138.182,
   "end": 139.114,
   "id": "c61"
  },
  {
   "text": "不同云账户",
   "start": 139.182,
   "end": 140.281,
   "id": "c62"
  }
 ]
