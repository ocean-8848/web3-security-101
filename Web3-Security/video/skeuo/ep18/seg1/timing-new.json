 "lines": [
  {
   "id": "seg1-00",
   "text": "2024 年 7 月，交易所 WazirX 的多签冷钱包，损失约 2.3 亿美元。",
   "spoken": "2024 年 7 月，交易所 WazirX 的多签冷钱包，损失约 2.3 亿美元。",
   "src": "/Users/k/Workon/Learning/web3/web3-security-101/Web3-Security/video/skeuo/ep18/audio/lines/seg1-00.mp3",
   "start": 1.6,
   "dur": 6.192,
   "speechStart": 1.698,
   "speechEnd": 6.959
  },
  {
   "id": "seg1-01",
   "text": "冷钱包放的是大部分资产，多签就是为了不让一把钥匙说了算。",
   "spoken": "冷钱包放的是大部分资产，多签就是为了不让一把钥匙说了算。",
   "src": "/Users/k/Workon/Learning/web3/web3-security-101/Web3-Security/video/skeuo/ep18/audio/lines/seg1-01.mp3",
   "start": 8.012,
   "dur": 4.8,
   "speechStart": 8.11,
   "speechEnd": 11.967
  },
  {
   "id": "seg1-02",
   "text": "这个钱包有六把钥匙，转账要其中四把签名。",
   "spoken": "这个钱包有六把钥匙，转账要其中四把签名。",
   "src": "/Users/k/Workon/Learning/web3/web3-security-101/Web3-Security/video/skeuo/ep18/audio/lines/seg1-02.mp3",
   "start": 13.032,
   "dur": 4.368,
   "speechStart": 13.13,
   "speechEnd": 16.57
  },
  {
   "id": "seg1-03",
   "text": "公开材料没有说，任何一把私钥被导出。",
   "spoken": "公开材料没有说，任何一把私钥被导出。",
   "src": "/Users/k/Workon/Learning/web3/web3-security-101/Web3-Security/video/skeuo/ep18/audio/lines/seg1-03.mp3",
   "start": 17.62,
   "dur": 3.984,
   "speechStart": 17.718,
   "speechEnd": 20.777
  },
  {
   "id": "seg1-04",
   "text": "签名人按流程，一个一个签了名。",
   "spoken": "签名人按流程，一个一个签了名。",
   "src": "/Users/k/Workon/Learning/web3/web3-security-101/Web3-Security/video/skeuo/ep18/audio/lines/seg1-04.mp3",
   "start": 21.824,
   "dur": 3.552,
   "speechStart": 21.922,
   "speechEnd": 24.553
  },
  {
   "id": "seg1-05",
   "text": "攻击者没有偷走钥匙，却让这些钥匙替他签了字。",
   "spoken": "攻击者没有偷走钥匙，却让这些钥匙替他签了字。",
   "src": "/Users/k/Workon/Learning/web3/web3-security-101/Web3-Security/video/skeuo/ep18/audio/lines/seg1-05.mp3",
   "start": 25.596,
   "dur": 4.68,
   "speechStart": 25.694,
   "speechEnd": 29.455
  },
  {
   "id": "seg1-06",
   "text": "钥匙都在，钱没了。",
   "spoken": "钥匙都在，钱没了。",
   "src": "/Users/k/Workon/Learning/web3/web3-security-101/Web3-Security/video/skeuo/ep18/audio/lines/seg1-06.mp3",
   "start": 30.496,
   "dur": 2.64,
   "speechStart": 30.594,
   "speechEnd": 32.308
  },
  {
   "id": "seg1-07",
   "text": "多数大额事故，都不是私钥被数学破解。",
   "spoken": "多数大额事故，都不是私钥被数学破解。",
   "src": "/Users/k/Workon/Learning/web3/web3-security-101/Web3-Security/video/skeuo/ep18/audio/lines/seg1-07.mp3",
