 "captions": [
  {
   "text": "按角色 各做一件事",
   "start": 1.645,
   "end": 3.575,
   "id": "c0"
  },
  {
   "text": "项目方和交易所",
   "start": 3.942,
   "end": 5.328,
   "id": "c1"
  },
  {
   "text": "列出每个签名人的设备和云账户",
   "start": 5.446,
   "end": 8.162,
   "id": "c2"
  },
  {
   "text": "看有没有两个人共用",
   "start": 8.632,
   "end": 10.154,
   "id": "c3"
  },
  {
   "text": "钱包开发者",
   "start": 10.482,
   "end": 11.653,
   "id": "c4"
  },
  {
   "text": "确认日志和崩溃上报屏蔽密钥材料",
   "start": 11.8,
   "end": 15.319,
   "id": "c5"
  },
  {
   "text": "发布凭证开启多因素认证",
   "start": 15.568,
   "end": 18.11,
   "id": "c6"
  },
  {
   "text": "运维负责人",
   "start": 18.37,
   "end": 19.544,
   "id": "c7"
  },
  {
   "text": "人员离职或漏洞披露后",
   "start": 19.564,
   "end": 21.932,
   "id": "c8"
  },
  {
   "text": "轮换密钥",
   "start": 22.13,
   "end": 22.976,
   "id": "c9"
  },
  {
   "text": "并撤销链上权限",
   "start": 23.101,
   "end": 24.623,
   "id": "c10"
  },
  {
   "text": "备份要和主密钥分开放",
   "start": 25.007,
   "end": 26.932,
   "id": "c11"
  },
  {
   "text": "每年至少演练一次恢复",
   "start": 27.283,
   "end": 29.057,
   "id": "c12"
  },
  {
   "text": "恢复要多人参与",
   "start": 29.159,
   "end": 30.557,
   "id": "c13"
  },
  {
   "text": "普通用户",
   "start": 30.902,
   "end": 31.687,
   "id": "c14"
  },
  {
   "text": "大额放硬件钱包",
   "start": 31.843,
   "end": 33.353,
   "id": "c15"
  },
  {
   "text": "小额放另一个钱包",
   "start": 33.444,
   "end": 35.137,
   "id": "c16"
  },
  {
   "text": "两个钱包用不同的助记词",
   "start": 35.438,
   "end": 37.463,
   "id": "c17"
  },
  {
   "text": "助记词只写在纸或金属板上 不拍照",
   "start": 37.75,
   "end": 41.318,
   "id": "c18"
  },
  {
   "text": "不存云笔记",
   "start": 41.418,
   "end": 42.547,
   "id": "c19"
  },
  {
   "text": "任何客服 网站",
   "start": 42.861,
   "end": 44.905,
   "id": "c20"
  },
  {
   "text": "表单让你输入助记词",
   "start": 44.955,
   "end": 47.084,
   "id": "c21"
  },
  {
   "text": "都是诈骗",
   "start": 47.22,
   "end": 47.993,
   "id": "c22"
  },
  {
   "text": "硬件钱包屏幕只显示哈希",
   "start": 48.27,
   "end": 50.539,
   "id": "c23"
  },
  {
   "text": "或者无法解析 就不签",
   "start": 50.658,
   "end": 52.534,
   "id": "c24"
  },
  {
   "text": "回到开头的问题",
   "start": 52.81,
   "end": 54.161,
   "id": "c25"
  },
  {
   "text": "六把私钥都没泄露",
   "start": 54.48,
   "end": 55.944,
   "id": "c26"
  },
  {
   "text": "攻击者也能转走资金",
   "start": 56.005,
   "end": 57.798,
   "id": "c27"
  },
  {
   "text": "只要签名人看到的和实际签下的不一样",
   "start": 58.05,
   "end": 61.667,
   "id": "c28"
  },
  {
   "text": "每把钥匙都会照常签名",
   "start": 61.831,
   "end": 64.292,
   "id": "c29"
  },
  {
   "text": "能挡住它的",
   "start": 64.693,
   "end": 65.644,
   "id": "c30"
  },
  {
   "text": "是每个签名人在自己的设备上独立解码",
   "start": 65.687,
   "end": 69.146,
   "id": "c31"
  },
  {
   "text": "核对屏幕上的字段",
   "start": 69.545,
   "end": 70.897,
   "id": "c32"
  },
  {
   "text": "这只在签名人真正独立时成立",
   "start": 71.227,
   "end": 73.856,
   "id": "c33"
  },
  {
   "text": "钥匙放在哪里很重要",
   "start": 74.15,
   "end": 76.028,
   "id": "c34"
  },
  {
   "text": "签下的是什么",
   "start": 76.264,
   "end": 77.517,
   "id": "c35"
  },
  {
   "text": "同样重要",
   "start": 77.628,
   "end": 78.478,
   "id": "c36"
  },
  {
   "text": "下一集讲用户侧诈骗",
   "start": 78.77,
   "end": 80.81,
   "id": "c37"
  }
 ]
