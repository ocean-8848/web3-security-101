 ],
 "captions": [
  {
   "text": "先给准确的说法",
   "start": 1.648,
   "end": 3.103,
   "id": "c0"
  },
  {
   "text": "私钥是一个 256 位的随机数",
   "start": 4.1,
   "end": 6.341,
   "id": "c1"
  },
  {
   "text": "用来给交易签名",
   "start": 6.397,
   "end": 7.651,
   "id": "c2"
  },
  {
   "text": "谁能让私钥签一笔交易",
   "start": 8.64,
   "end": 10.405,
   "id": "c3"
  },
  {
   "text": "谁就拥有这笔资产",
   "start": 10.58,
   "end": 11.988,
   "id": "c4"
  },
  {
   "text": "助记词是 12 或 24 个单词",
   "start": 12.988,
   "end": 15.527,
   "id": "c5"
  },
  {
   "text": "可以推导出一组私钥",
   "start": 15.559,
   "end": 17.027,
   "id": "c6"
  },
  {
   "text": "放私钥的方法",
   "start": 18.008,
   "end": 19.332,
   "id": "c7"
  },
  {
   "text": "常见的有五种",
   "start": 19.448,
   "end": 20.678,
   "id": "c8"
  },
  {
   "text": "第一种 助记词软件钱包",
   "start": 21.636,
   "end": 23.782,
   "id": "c9"
  },
  {
   "text": "私钥在手机",
   "start": 23.802,
   "end": 24.913,
   "id": "c10"
  },
  {
   "text": "电脑或浏览器扩展里",
   "start": 25.1,
   "end": 26.889,
   "id": "c11"
  },
  {
   "text": "设备被攻破",
   "start": 27.856,
   "end": 29.145,
   "id": "c12"
  },
  {
   "text": "钱就没了",
   "start": 29.248,
   "end": 30.109,
   "id": "c13"
  },
  {
   "text": "第二种 硬件钱包",
   "start": 31.076,
   "end": 32.865,
   "id": "c14"
  },
  {
   "text": "私钥在一块独立芯片里",
   "start": 33.016,
   "end": 34.686,
   "id": "c15"
  },
  {
   "text": "不离开设备",
   "start": 34.742,
   "end": 35.686,
   "id": "c16"
  },
  {
   "text": "它只负责签名 签之前",
   "start": 36.672,
   "end": 38.949,
   "id": "c17"
  },
  {
   "text": "人要看清签的是什么",
   "start": 39.088,
   "end": 40.663,
   "id": "c18"
  },
  {
   "text": "第三种 多签",
   "start": 41.62,
   "end": 43.028,
   "id": "c19"
  },
  {
   "text": "比如 Safe",
   "start": 43.084,
   "end": 44.373,
   "id": "c20"
  },
  {
   "text": "几个独立私钥加一个链上合约",
   "start": 44.584,
   "end": 46.825,
   "id": "c21"
  },
  {
   "text": "签名数达到门槛",
   "start": 47.816,
   "end": 49.283,
   "id": "c22"
  },
  {
   "text": "交易才执行",
   "start": 49.494,
   "end": 50.688,
   "id": "c23"
  },
  {
   "text": "第四种 MPC 门限签名",
   "start": 51.66,
   "end": 54.211,
   "id": "c24"
  },
  {
   "text": "私钥被切成几个分片",
   "start": 54.231,
   "end": 55.937,
   "id": "c25"
  },
  {
   "text": "几方各自计算",
   "start": 56.92,
   "end": 58.197,
   "id": "c26"
  },
  {
   "text": "合成一个普通签名",
   "start": 58.36,
   "end": 59.875,
   "id": "c27"
  },
  {
   "text": "完整私钥从不出现",
   "start": 59.932,
   "end": 61.673,
   "id": "c28"
  },
  {
   "text": "第五种 HSM",
   "start": 62.66,
   "end": 64.413,
   "id": "c29"
  },
  {
   "text": "私钥锁在专用硬件里",
   "start": 64.493,
   "end": 66.247,
   "id": "c30"
  },
  {
   "text": "不能导出",
   "start": 66.267,
   "end": 67.103,
   "id": "c31"
  },
  {
   "text": "它只按指令签名",
   "start": 68.088,
   "end": 69.579,
   "id": "c32"
  },
  {
   "text": "不判断指令对不对",
   "start": 69.671,
   "end": 71.031,
   "id": "c33"
  },
  {
   "text": "签名人看不懂签的内容就签 叫盲签",
   "start": 72.028,
   "end": 75.448,
   "id": "c34"
  },
  {
   "text": "软件钱包和 HSM",
   "start": 76.424,
   "end": 78.32,
   "id": "c35"
  },
  {
   "text": "盲签风险最高",
   "start": 78.364,
   "end": 79.701,
   "id": "c36"
  },
  {
   "text": "多签的门槛写在链上",
   "start": 80.7,
   "end": 82.274,
   "id": "c37"
  },
  {
   "text": "谁都能查",
   "start": 82.402,
   "end": 83.394,
   "id": "c38"
  },
  {
   "text": "MPC 在链上只是一个普通地址",
   "start": 83.414,
   "end": 85.858,
   "id": "c39"
  },
  {
   "text": "打个比方",
   "start": 86.848,
   "end": 87.815,
   "id": "c40"
  },
  {
   "text": "私钥是保险柜的钥匙",
   "start": 87.919,
   "end": 89.506,
   "id": "c41"
  },
  {
   "text": "多签像一个柜子三把锁",
   "start": 90.5,
   "end": 92.396,
   "id": "c42"
  },
  {
   "text": "要两把一起开",
   "start": 92.523,
   "end": 93.622,
   "id": "c43"
  },
  {
   "text": "可如果锁的主人看同一块屏幕",
   "start": 94.608,
   "end": 97.028,
   "id": "c44"
  },
  {
   "text": "三把锁就退化成一把",
   "start": 97.227,
   "end": 98.956,
   "id": "c45"
  },
  {
   "text": "比喻不成立的地方是",
   "start": 99.916,
   "end": 101.514,
   "id": "c46"
  },
  {
   "text": "真实的钥匙被复制",
   "start": 101.701,
   "end": 103.265,
   "id": "c47"
  },
  {
   "text": "会留下痕迹",
   "start": 103.285,
   "end": 104.288,
   "id": "c48"
  },
  {
   "text": "私钥被复制",
   "start": 105.272,
   "end": 106.513,
   "id": "c49"
  },
  {
   "text": "不留任何痕迹",
   "start": 106.617,
   "end": 107.858,
   "id": "c50"
  },
  {
   "text": "直到资产被转走",
   "start": 108.069,
   "end": 109.763,
   "id": "c51"
  },
  {
   "text": "你才知道",
   "start": 109.974,
   "end": 110.858,
   "id": "c52"
  },
  {
   "text": "所以方案的强度",
   "start": 111.828,
   "end": 113.593,
   "id": "c53"
  },
  {
   "text": "取决于最容易被攻破的那个环节",
   "start": 113.613,
   "end": 115.938,
   "id": "c54"
  },
  {
   "text": "一台设备",
   "start": 116.92,
   "end": 117.935,
   "id": "c55"
  },
  {
   "text": "一行日志",
   "start": 118.039,
   "end": 118.994,
   "id": "c56"
  },
  {
   "text": "一个签名人的眼睛",
   "start": 119.134,
   "end": 120.578,
   "id": "c57"
  }
 ]
}