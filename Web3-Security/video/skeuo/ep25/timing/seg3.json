   "id": "c2"
  },
  {
   "text": "是协议自己的暂停和延迟提款",
   "start": 6.983,
   "end": 9.653,
   "id": "c3"
  },
  {
   "text": "条件是合约里事先设计了暂停或延迟机制",
   "start": 10.632,
   "end": 14.468,
   "id": "c4"
  },
  {
   "text": "而且有人值守",
   "start": 14.632,
   "end": 15.814,
   "id": "c5"
  },
  {
   "text": "Bybit 被盗后",
   "start": 16.78,
   "end": 17.878,
   "id": "c6"
  },
  {
   "text": "mETH Protocol 靠 8 小时的提款延迟",
   "start": 18.077,
   "end": 20.723,
   "id": "c7"
  },
  {
   "text": "暂停了合约",
   "start": 20.78,
   "end": 21.7,
   "id": "c8"
  },
  {
   "text": "追回约 4300 万美元的 cmETH",
   "start": 21.72,
   "end": 24.378,
   "id": "c9"
  },
  {
   "text": "这是那次事件里",
   "start": 25.352,
   "end": 26.676,
   "id": "c10"
  },
  {
   "text": "追回最多的单项",
   "start": 26.768,
   "end": 28.093,
   "id": "c11"
  },
  {
   "text": "第二道 是稳定币发行方冻结",
   "start": 29.076,
   "end": 31.71,
   "id": "c12"
  },
  {
   "text": "Tether",
   "start": 32.704,
   "end": 33.338,
   "id": "c13"
  },
  {
   "text": "Circle 这类发行方",
   "start": 33.382,
   "end": 34.933,
   "id": "c14"
  },
  {
   "text": "可以在合约层面冻结一个地址",
   "start": 34.966,
   "end": 37.112,
   "id": "c15"
  },
  {
   "text": "2024 年 9 月",
   "start": 38.108,
   "end": 39.444,
   "id": "c16"
  },
  {
   "text": "Tether",
   "start": 39.524,
   "end": 40.135,
   "id": "c17"
  },
  {
   "text": "TRON 和 TRM 联合成立了 T3 金融犯罪部门",
   "start": 40.239,
   "end": 43.897,
   "id": "c18"
  },
  {
   "text": "2026 年 5 月",
   "start": 44.88,
   "end": 46.216,
   "id": "c19"
  },
  {
   "text": "T3 自报累计冻结 4.5 亿美元以上",
   "start": 46.308,
   "end": 49.312,
   "id": "c20"
  },
  {
   "text": "可这条路 有门槛 有时延",
   "start": 50.308,
   "end": 53.12,
   "id": "c21"
  },
  {
   "text": "也可能被撤销",
   "start": 53.2,
   "end": 54.216,
   "id": "c22"
  },
  {
   "text": "门槛是 通常要有执法请求或法院命令",
   "start": 55.184,
   "end": 59.032,
   "id": "c23"
  },
  {
   "text": "撤销的例子",
   "start": 60.012,
   "end": 61.111,
   "id": "c24"
  },
  {
   "text": "是 2025 年 5 月的 LIBRA 案",
   "start": 61.131,
   "end": 63.824,
   "id": "c25"
  },
  {
   "text": "Circle 依据纽约南区法院的临时限制令",
   "start": 64.792,
   "end": 67.89,
   "id": "c26"
  },
  {
   "text": "冻结了约 5760 万美元 USDC",
   "start": 68.042,
   "end": 71.116,
   "id": "c27"
  },
  {
   "text": "8 月 法官解除了冻结",
   "start": 72.116,
   "end": 74.464,
   "id": "c28"
  },
  {
   "text": "理由是原告没有证明不可弥补的损害",
   "start": 74.592,
   "end": 77.845,
   "id": "c29"
  },
  {
   "text": "时延的例子",
   "start": 78.84,
   "end": 79.796,
   "id": "c30"
  },
  {
   "text": "是 2026 年 4 月的 Drift 被盗事件",
   "start": 79.816,
   "end": 82.569,
   "id": "c31"
  },
  {
   "text": "链上调查者 ZachXBT",
   "start": 83.548,
   "end": 85.706,
   "id": "c32"
  },
  {
   "text": "公开批评 Circle 延迟了约 6 小时",
   "start": 85.798,
   "end": 88.646,
   "id": "c33"
  },
  {
   "text": "期间约 2.32 亿美元经跨链协议转走",
   "start": 88.821,
   "end": 91.98,
   "id": "c34"
  },
  {
   "text": "这是个人指控",
   "start": 92.96,
   "end": 94.141,
   "id": "c35"
  },
  {
   "text": "未见 Circle 回应",
   "start": 94.162,
   "end": 95.558,
   "id": "c36"
  },
  {
   "text": "美国 GENIUS 法案在 2025 年 7 月成为法律",
   "start": 96.54,
   "end": 100.114,
   "id": "c37"
  },
  {
   "text": "要求支付型稳定币发行方",
   "start": 100.29,
   "end": 102.579,
   "id": "c38"
  },
  {
   "text": "有能力执行冻结 扣押",
   "start": 102.671,
   "end": 104.876,
   "id": "c39"
  },
  {
   "text": "阻止转账这类合法命令",
   "start": 104.968,
   "end": 107.126,
   "id": "c40"
  },
  {
   "text": "第三道 是交易所冻结",
   "start": 108.112,
   "end": 110.401,
   "id": "c41"
  },
  {
   "text": "条件是交易所收到可信的地址清单",
   "start": 111.38,
   "end": 114.466,
   "id": "c42"
  },
  {
   "text": "或者风控名单命中",
   "start": 114.665,
   "end": 116.122,
   "id": "c43"
  },
  {
   "text": "时效在小时级",
   "start": 116.142,
   "end": 117.562,
   "id": "c44"
  },
  {
   "text": "局限也很明显",
   "start": 118.56,
   "end": 119.98,
   "id": "c45"
  },
  {
   "text": "攻击者会避开合规交易所",
   "start": 120.155,
   "end": 122.289,
   "id": "c46"
  }
 ]
}