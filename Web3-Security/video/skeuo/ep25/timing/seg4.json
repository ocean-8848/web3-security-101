   "start": 120.452,
   "end": 120.571
  },
  {
   "line": 19,
   "text": "争议",
   "start": 120.583,
   "end": 120.94
  },
  {
   "line": 20,
   "text": "从",
   "start": 122.09,
   "end": 122.34
  },
  {
   "line": 20,
   "text": "执法",
   "start": 122.363,
   "end": 122.792
  },
  {
   "line": 20,
   "text": "追回",
   "start": 122.804,
   "end": 123.113
  },
  {
   "line": 20,
   "text": "到",
   "start": 123.113,
   "end": 123.221
  },
  {
   "line": 20,
   "text": "真正",
   "start": 123.244,
   "end": 123.59
  },
  {
   "line": 20,
   "text": "返还",
   "start": 123.602,
   "end": 124.149
  },
  {
   "line": 20,
   "text": "可能",
   "start": 124.399,
   "end": 124.661
  },
  {
   "line": 20,
   "text": "要",
   "start": 124.661,
   "end": 124.792
  },
  {
   "line": 20,
   "text": "拖好",
   "start": 124.804,
   "end": 125.209
  },
  {
   "line": 20,
   "text": "几年",
   "start": 125.209,
   "end": 125.637
  }
 ],
 "captions": [
  {
   "text": "前排拦不住",
   "start": 1.648,
   "end": 2.734,
   "id": "c0"
  },
  {
   "text": "后面还有三条更重的路",
   "start": 2.921,
   "end": 4.972,
   "id": "c1"
  },
  {
   "text": "一条是链级冻结",
   "start": 5.948,
   "end": 7.749,
   "id": "c2"
  },
  {
   "text": "2025 年 5 月",
   "start": 8.736,
   "end": 9.978,
   "id": "c3"
  },
  {
   "text": "Sui 上的 Cetus 被盗约 2.23 亿美元",
   "start": 9.998,
   "end": 13.215,
   "id": "c4"
  },
  {
   "text": "根因是集中流动性合约的算术溢出",
   "start": 13.39,
   "end": 15.977,
   "id": "c5"
  },
  {
   "text": "约 6300 万美元",
   "start": 16.972,
   "end": 18.594,
   "id": "c6"
  },
  {
   "text": "在冻结前跨链到了以太坊",
   "start": 18.662,
   "end": 21.034,
   "id": "c7"
  },
  {
   "text": "Sui 验证者在链上冻结了约 1.62 亿美元",
   "start": 22.016,
   "end": 25.459,
   "id": "c8"
  },
  {
   "text": "治理投票以约 90.9% 的质押权通过",
   "start": 26.46,
   "end": 29.701,
   "id": "c9"
  },
  {
   "text": "用协议升级",
   "start": 29.745,
   "end": 30.915,
   "id": "c10"
  },
  {
   "text": "把冻结的钱转进三方共管的多签",
   "start": 31.043,
   "end": 33.452,
   "id": "c11"
  },
  {
   "text": "用于赔付",
   "start": 33.472,
   "end": 34.32,
   "id": "c12"
  },
  {
   "text": "钱保住了",
   "start": 35.32,
   "end": 36.24,
   "id": "c13"
  },
  {
   "text": "争议也来了",
   "start": 36.308,
   "end": 37.263,
   "id": "c14"
  },
  {
   "text": "部分验证者公开表达了保留意见",
   "start": 38.252,
   "end": 40.814,
   "id": "c15"
  },
  {
   "text": "能冻结并改写特定地址",
   "start": 41.808,
   "end": 43.882,
   "id": "c16"
  },
  {
   "text": "也就说明",
   "start": 43.998,
   "end": 44.87,
   "id": "c17"
  },
  {
   "text": "这条链的验证者可以干预任意地址",
   "start": 45.081,
   "end": 47.787,
   "id": "c18"
  },
  {
   "text": "Binance 事件里",
   "start": 48.772,
   "end": 49.965,
   "id": "c19"
  },
  {
   "text": "Arbitrum 安全委员会也强制转走了",
   "start": 50.117,
   "end": 52.775,
   "id": "c20"
  },
  {
   "text": "攻击者钱包里的 8426 ETH",
   "start": 52.903,
   "end": 55.394,
   "id": "c21"
  },
  {
   "text": "和 7460 万 ARB",
   "start": 55.414,
   "end": 57.192,
   "id": "c22"
  },
  {
   "text": "一条是谈判与白帽赎回",
   "start": 58.16,
   "end": 60.389,
   "id": "c23"
  },
  {
   "text": "2021 年 8 月",
   "start": 61.38,
   "end": 62.514,
   "id": "c24"
  },
  {
   "text": "Poly Network 被盗约 6.1 亿美元",
   "start": 62.63,
   "end": 65.204,
   "id": "c25"
  },
  {
   "text": "攻击者自称白帽",
   "start": 65.356,
   "end": 66.621,
   "id": "c26"
  },
  {
   "text": "约 15 天内归还",
   "start": 66.642,
   "end": 68.002,
   "id": "c27"
  },
  {
   "text": "2023 年 3 月",
   "start": 68.992,
   "end": 70.245,
   "id": "c28"
  },
  {
   "text": "Euler Finance 被闪电贷攻击",
   "start": 70.373,
   "end": 72.578,
   "id": "c29"
  },
  {
   "text": "损失约 1.97 亿美元",
   "start": 72.646,
   "end": 74.674,
   "id": "c30"
  },
  {
   "text": "Euler 提出 10% 的赏金",
   "start": 75.668,
   "end": 77.909,
   "id": "c31"
  },
  {
   "text": "同时另设 100 万美元悬赏",
   "start": 77.965,
   "end": 79.969,
   "id": "c32"
  },
  {
   "text": "征集攻击者的线索",
   "start": 79.989,
   "end": 81.397,
   "id": "c33"
  },
  {
   "text": "4 月初 Euler 宣布",
   "start": 82.392,
   "end": 84.181,
   "id": "c34"
  },
  {
   "text": "全部可追回的资金已经归还",
   "start": 84.201,
   "end": 86.335,
   "id": "c35"
  },
  {
   "text": "可攻击者为什么归还",
   "start": 87.316,
   "end": 88.938,
   "id": "c36"
  },
  {
   "text": "通常不公开",
   "start": 89.066,
   "end": 90.128,
   "id": "c37"
  },
  {
   "text": "谈判不能当作预案的主线",
   "start": 90.28,
   "end": 92.259,
   "id": "c38"
  },
  {
   "text": "最后一条",
   "start": 93.248,
   "end": 94.168,
   "id": "c39"
  },
  {
   "text": "是执法与司法",
   "start": 94.188,
   "end": 95.525,
   "id": "c40"
  },
  {
   "text": "2022 年 2 月",
   "start": 96.516,
   "end": 97.745,
   "id": "c41"
  },
  {
   "text": "美国司法部逮捕两名嫌疑人",
   "start": 97.956,
   "end": 100.15,
   "id": "c42"
  },
  {
   "text": "调查人员解密了云存储里的私钥文件",
   "start": 100.289,
   "end": 103.138,
   "id": "c43"
  },
  {
   "text": "没收约 94636 BTC",
   "start": 104.128,
   "end": 106.726,
   "id": "c44"
  },
  {
   "text": "当时约 36 亿美元",
   "start": 106.782,
   "end": 108.583,
   "id": "c45"
  },
  {
   "text": "这批币是 2016 年从 Bitfinex 被盗的",
   "start": 108.747,
   "end": 111.738,
   "id": "c46"
  },
  {
   "text": "2025 年 1 月",
   "start": 112.724,
   "end": 113.917,
   "id": "c47"
  },
  {
   "text": "检方申请把币以实物返还",
   "start": 114.009,
   "end": 116.536,
   "id": "c48"
  },
  {
   "text": "法官对返还方式提出了质疑",
   "start": 116.759,
   "end": 118.977,
   "id": "c49"
  },
  {
   "text": "最终处置至今仍有争议",
   "start": 119.045,
   "end": 121.06,
   "id": "c50"
  },
  {
   "text": "从执法追回到真正返还",
   "start": 122.04,
   "end": 124.269,
   "id": "c51"
  },
  {
   "text": "可能要拖好几年",
   "start": 124.349,
   "end": 125.757,
   "id": "c52"
  }
 ]
}