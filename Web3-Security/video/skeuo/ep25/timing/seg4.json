   "speechStart": 61.43,
   "speechEnd": 67.882
  },
  {
   "id": "seg4-12",
   "text": "2023 年 3 月，Euler Finance 被闪电贷攻击，损失约 1.97 亿美元。",
   "spoken": "2023 年 3 月，Euler Finance 被闪电贷攻击，损失约 1.97 亿美元。",
   "src": "/Users/k/Workon/Learning/web3/web3-security-101/Web3-Security/video/skeuo/ep25/audio/lines/seg4-12.mp3",
   "start": 68.944,
   "dur": 6.456,
   "speechStart": 69.042,
   "speechEnd": 74.554
  },
  {
   "id": "seg4-13",
   "text": "Euler 提出 10% 的赏金，同时另设 100 万美元悬赏，征集攻击者的线索。",
   "spoken": "Euler 提出 10% 的赏金，同时另设 100 万美元悬赏，征集攻击者的线索。",
