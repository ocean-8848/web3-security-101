   "start": 75.62,
   "dur": 6.504,
   "speechStart": 75.718,
   "speechEnd": 81.277
  },
  {
   "id": "seg4-14",
   "text": "4 月初，Euler 宣布，全部可追回的资金已经归还。",
   "spoken": "4 月初，Euler 宣布，全部可追回的资金已经归环。",
