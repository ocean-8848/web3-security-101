 "captions": [
  {
   "text": "这些路走不走得通",
   "start": 1.645,
   "end": 3.125,
   "id": "c0"
  },
  {
   "text": "要看事发后的前 6 小时",
   "start": 3.356,
   "end": 5.516,
   "id": "c1"
  },
  {
   "text": "发现异常 先暂停",
   "start": 5.77,
   "end": 7.314,
   "id": "c2"
  },
  {
   "text": "协议暂停",
   "start": 7.334,
   "end": 8.636,
   "id": "c3"
  },
  {
   "text": "交易所暂停这条链的提币",
   "start": 8.727,
   "end": 10.854,
   "id": "c4"
  },
  {
   "text": "接着整理地址清单",
   "start": 11.11,
   "end": 12.895,
   "id": "c5"
  },
  {
   "text": "被盗地址",
   "start": 13.083,
   "end": 13.941,
   "id": "c6"
  },
  {
   "text": "攻击者地址",
   "start": 14.061,
   "end": 15.071,
   "id": "c7"
  },
  {
   "text": "已知的下一跳",
   "start": 15.199,
   "end": 16.355,
   "id": "c8"
  },
  {
   "text": "清单是所有通知的前提",
   "start": 16.61,
   "end": 19.032,
   "id": "c9"
  },
  {
   "text": "清单不准",
   "start": 19.057,
   "end": 19.943,
   "id": "c10"
  },
  {
   "text": "冻结请求就会被拒绝或延误",
   "start": 19.963,
   "end": 22.707,
   "id": "c11"
  },
  {
   "text": "然后并行通知",
   "start": 23.086,
   "end": 24.472,
   "id": "c12"
  },
  {
   "text": "不是排队通知",
   "start": 24.583,
   "end": 25.678,
   "id": "c13"
  },
  {
   "text": "稳定币发行方",
   "start": 26.026,
   "end": 27.216,
   "id": "c14"
  },
  {
   "text": "交易所风控",
   "start": 27.488,
   "end": 28.5,
   "id": "c15"
  },
  {
   "text": "跨链桥和兑换服务",
   "start": 28.756,
   "end": 30.473,
   "id": "c16"
  },
  {
   "text": "SEAL 911 这样的应急网络",
   "start": 30.693,
   "end": 32.696,
   "id": "c17"
  },
  {
   "text": "链上分析公司",
   "start": 32.961,
   "end": 34.126,
   "id": "c18"
  },
  {
   "text": "同时发出去",
   "start": 34.146,
   "end": 35.101,
   "id": "c19"
  },
  {
   "text": "先发清单",
   "start": 35.35,
   "end": 36.461,
   "id": "c20"
  },
  {
   "text": "不要等完整报告",
   "start": 36.615,
   "end": 37.833,
   "id": "c21"
  },
  {
   "text": "冻结只需要准确的地址和交易哈希",
   "start": 38.036,
   "end": 41.159,
   "id": "c22"
  },
  {
   "text": "同时做证据保全",
   "start": 41.41,
   "end": 43.223,
   "id": "c23"
  },
  {
   "text": "交易哈希 日志",
   "start": 43.37,
   "end": 45.134,
   "id": "c24"
  },
  {
   "text": "服务器镜像",
   "start": 45.379,
   "end": 46.322,
   "id": "c25"
  },
  {
   "text": "保全要在清理和恢复系统之前完成",
   "start": 46.61,
   "end": 49.549,
   "id": "c26"
  },
  {
   "text": "恢复会覆盖证据",
   "start": 49.629,
   "end": 51.007,
   "id": "c27"
  },
  {
   "text": "然后报警",
   "start": 51.388,
   "end": 52.249,
   "id": "c28"
  },
  {
   "text": "按辖区通知监管",
   "start": 52.515,
   "end": 54.084,
   "id": "c29"
  },
  {
   "text": "一小时之后",
   "start": 54.405,
   "end": 55.227,
   "id": "c30"
  },
  {
   "text": "可以在链上喊话",
   "start": 55.247,
   "end": 56.544,
   "id": "c31"
  },
  {
   "text": "提出赏金和安全港条件",
   "start": 56.77,
   "end": 58.935,
   "id": "c32"
  },
  {
   "text": "并且每小时更新地址清单",
   "start": 59.163,
   "end": 61.434,
   "id": "c33"
  },
  {
   "text": "安全港要事先写好",
   "start": 61.827,
   "end": 63.432,
   "id": "c34"
  },
  {
   "text": "SEAL 的白帽安全港框架",
   "start": 63.71,
   "end": 65.818,
   "id": "c35"
  },
  {
   "text": "让协议通过治理事先授权白帽",
   "start": 66.282,
   "end": 68.972,
   "id": "c36"
  },
  {
   "text": "在攻击正在发生时抢救资金",
   "start": 69.239,
   "end": 71.598,
   "id": "c37"
  },
  {
   "text": "默认条款是 72 小时内把资金返回指定地址",
   "start": 71.946,
   "end": 76.519,
   "id": "c38"
  },
  {
   "text": "赏金 10%",
   "start": 76.689,
   "end": 78.165,
   "id": "c39"
  },
  {
   "text": "上限 100 万美元",
   "start": 78.266,
   "end": 80.007,
   "id": "c40"
  },
  {
   "text": "事发时再讨论",
   "start": 80.23,
   "end": 81.608,
   "id": "c41"
  },
  {
   "text": "白帽不敢动手",
   "start": 81.628,
   "end": 82.844,
   "id": "c42"
  },
  {
   "text": "平时也要准备",
   "start": 83.09,
   "end": 84.389,
   "id": "c43"
  },
  {
   "text": "实时监控大额流出和权限变更",
   "start": 84.67,
   "end": 87.724,
   "id": "c44"
  },
  {
   "text": "风控名单每日更新",
   "start": 88.257,
   "end": 89.946,
   "id": "c45"
  },
  {
   "text": "每季度演练一次",
   "start": 90.178,
   "end": 91.549,
   "id": "c46"
  },
  {
   "text": "确认联系人是否有效",
   "start": 91.8,
   "end": 93.623,
   "id": "c47"
  },
