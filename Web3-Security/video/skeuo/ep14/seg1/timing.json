 "lines": [
  {
   "id": "seg1-00",
   "text": "2026 年 6 月，一个已经弃用的合约，Aztec Connect，被取走约 228 万美元。",
   "spoken": "2026 年 6 月，一个已经弃用的合约，Aztec Connect，被取走约 228 万美元。",
   "src": "/Users/k/Workon/Learning/web3/web3-security-101/Web3-Security/video/skeuo/ep14/audio/lines/seg1-00.wav",
   "start": 1.6,
   "dur": 8.0,
   "speechStart": 1.6,
   "speechEnd": 9.39
  },
  {
   "id": "seg1-01",
   "text": "这是两名攻击者的合计，按事发时的估值。",
   "spoken": "这是两名攻击者的合计，按事发时的估值。",
   "src": "/Users/k/Workon/Learning/web3/web3-security-101/Web3-Security/video/skeuo/ep14/audio/lines/seg1-01.wav",
   "start": 9.82,
   "dur": 3.44,
   "speechStart": 9.915,
   "speechEnd": 13.005
  },
  {
   "id": "seg1-02",
   "text": "奇怪的是，每一个证明，都通过了验证。",
   "spoken": "奇怪的是，每一个证明，都通过了验证。",
   "src": "/Users/k/Workon/Learning/web3/web3-security-101/Web3-Security/video/skeuo/ep14/audio/lines/seg1-02.wav",
   "start": 13.48,
   "dur": 3.6,
   "speechStart": 13.48,
   "speechEnd": 16.915
  },
  {
   "id": "seg1-03",
   "text": "密码学没有失效。",
   "spoken": "密码学没有失效。",
   "src": "/Users/k/Workon/Learning/web3/web3-security-101/Web3-Security/video/skeuo/ep14/audio/lines/seg1-03.wav",
   "start": 17.3,
   "dur": 1.68,
   "speechStart": 17.391,
   "speechEnd": 18.754
  },
  {
   "id": "seg1-04",
   "text": "攻击者没有破解任何一道数学题。",
   "spoken": "攻击者没有破解任何一道数学题。",
   "src": "/Users/k/Workon/Learning/web3/web3-security-101/Web3-Security/video/skeuo/ep14/audio/lines/seg1-04.wav",
   "start": 19.2,
   "dur": 2.48,
   "speechStart": 19.2,
   "speechEnd": 21.492
  },
  {
   "id": "seg1-05",
   "text": "证明是一张数学凭据，它说，这一批交易算对了。",
   "spoken": "证明是一张数学凭据，它说，这一批交易算对了。",
   "src": "/Users/k/Workon/Learning/web3/web3-security-101/Web3-Security/video/skeuo/ep14/audio/lines/seg1-05.wav",
   "start": 21.9,
   "dur": 4.48,
   "speechStart": 21.9,
   "speechEnd": 26.211
  },
  {
   "id": "seg1-06",
   "text": "合约检查了凭据，钱还是被取走。",
   "spoken": "合约检查了凭据，钱还是被取走。",
   "src": "/Users/k/Workon/Learning/web3/web3-security-101/Web3-Security/video/skeuo/ep14/audio/lines/seg1-06.wav",
   "start": 26.6,
   "dur": 3.12,
   "speechStart": 26.6,
   "speechEnd": 29.507
  },
  {
   "id": "seg1-07",
   "text": "先猜一道题。",
   "spoken": "先猜一道题。",
   "src": "/Users/k/Workon/Learning/web3/web3-security-101/Web3-Security/video/skeuo/ep14/audio/lines/seg1-07.wav",
   "start": 29.94,
   "dur": 1.04,
   "speechStart": 29.94,
   "speechEnd": 30.741
  },
  {
   "id": "seg1-08",
   "text": "证明全部有效，结算却少处理了一部分交易。",
   "spoken": "证明全部有效，结算却少楚理了一部分交易。",
   "src": "/Users/k/Workon/Learning/web3/web3-security-101/Web3-Security/video/skeuo/ep14/audio/lines/seg1-08.wav",
   "start": 31.2,
   "dur": 4.48,
   "speechStart": 31.295,
   "speechEnd": 35.474
  },
  {
   "id": "seg1-09",
   "text": "只修验证器合约，能堵住这个洞吗？",
   "spoken": "只修验证器合约，能堵住这个洞吗？",
   "src": "/Users/k/Workon/Learning/web3/web3-security-101/Web3-Security/video/skeuo/ep14/audio/lines/seg1-09.wav",
   "start": 35.9,
   "dur": 2.64,
   "speechStart": 35.9,
   "speechEnd": 38.339
  },
  {
   "id": "seg1-10",
   "text": "先记住这个问题。",
   "spoken": "先记住这个问题。",
   "src": "/Users/k/Workon/Learning/web3/web3-security-101/Web3-Security/video/skeuo/ep14/audio/lines/seg1-10.wav",
   "start": 39.04,
   "dur": 1.2,
   "speechStart": 39.04,
   "speechEnd": 40.031
  },
  {
