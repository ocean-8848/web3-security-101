 "captions": [
  {
   "text": "2026 年 6 月",
   "start": 1.55,
   "end": 3.032,
   "id": "c0"
  },
  {
   "text": "一个已经弃用的合约",
   "start": 3.336,
   "end": 5.162,
   "id": "c1"
  },
  {
   "text": "Aztec Connect",
   "start": 5.447,
   "end": 6.689,
   "id": "c2"
  },
  {
   "text": "被取走约 228 万美元",
   "start": 6.871,
   "end": 9.51,
   "id": "c3"
  },
  {
   "text": "这是两名攻击者的合计",
   "start": 9.865,
   "end": 11.534,
   "id": "c4"
  },
  {
   "text": "按事发时的估值",
   "start": 11.751,
   "end": 13.125,
   "id": "c5"
  },
  {
   "text": "奇怪的是",
   "start": 13.43,
   "end": 14.485,
   "id": "c6"
  },
  {
   "text": "每一个证明",
   "start": 14.636,
   "end": 15.761,
   "id": "c7"
  },
  {
   "text": "都通过了验证",
   "start": 15.787,
   "end": 17.035,
   "id": "c8"
  },
  {
   "text": "密码学没有失效",
   "start": 17.341,
   "end": 18.874,
   "id": "c9"
  },
  {
   "text": "攻击者没有破解任何一道数学题",
   "start": 19.15,
   "end": 21.612,
   "id": "c10"
  },
  {
   "text": "证明是一张数学凭据 它说",
   "start": 21.85,
   "end": 24.41,
   "id": "c11"
  },
  {
   "text": "这一批交易算对了",
   "start": 24.682,
   "end": 26.331,
   "id": "c12"
  },
  {
   "text": "合约检查了凭据",
   "start": 26.55,
   "end": 27.98,
   "id": "c13"
  },
  {
   "text": "钱还是被取走",
   "start": 28.208,
   "end": 29.627,
   "id": "c14"
  },
  {
   "text": "先猜一道题",
   "start": 29.89,
   "end": 30.861,
   "id": "c15"
  },
  {
   "text": "证明全部有效",
   "start": 31.245,
   "end": 32.583,
   "id": "c16"
  },
  {
   "text": "结算却少处理了一部分交易",
   "start": 32.888,
   "end": 35.594,
   "id": "c17"
  },
  {
   "text": "只修验证器合约",
   "start": 35.85,
   "end": 37.401,
   "id": "c18"
  },
  {
   "text": "能堵住这个洞吗",
   "start": 37.421,
   "end": 38.459,
   "id": "c19"
  },
  {
   "text": "先记住这个问题",
   "start": 38.99,
   "end": 40.151,
   "id": "c20"
  },
  {
   "text": "一套证明系统",
   "start": 40.41,
   "end": 41.72,
   "id": "c21"
  },
  {
   "text": "有哪几个环节",
   "start": 41.766,
   "end": 42.905,
   "id": "c22"
  },
  {
   "text": "每个环节会怎么坏",
   "start": 43.145,
   "end": 44.808,
   "id": "c23"
  }
 ]
