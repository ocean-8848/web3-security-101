 "captions": [
  {
   "text": "先给准确的说法",
   "start": 1.648,
   "end": 3.103,
   "id": "c0"
  },
  {
   "text": "零知识证明",
   "start": 4.1,
   "end": 5.234,
   "id": "c1"
  },
  {
   "text": "是让验证者相信一个计算结果正确",
   "start": 5.266,
   "end": 8.091,
   "id": "c2"
  },
  {
   "text": "不用自己重算",
   "start": 8.171,
   "end": 9.305,
   "id": "c3"
  },
  {
   "text": "也看不到计算的秘密输入",
   "start": 9.469,
   "end": 11.115,
   "id": "c4"
  },
  {
   "text": "要证明的计算",
   "start": 12.096,
   "end": 13.266,
   "id": "c5"
  },
  {
   "text": "先写成一组数学约束 叫电路",
   "start": 13.441,
   "end": 16.289,
   "id": "c6"
  },
  {
   "text": "满足全部约束的输入",
   "start": 17.284,
   "end": 18.977,
   "id": "c7"
  },
  {
   "text": "才算正确",
   "start": 19.022,
   "end": 20.001,
   "id": "c8"
  },
  {
   "text": "证明器在链下",
   "start": 20.984,
   "end": 22.344,
   "id": "c9"
  },
  {
   "text": "按电路生成证明",
   "start": 22.543,
   "end": 24.106,
   "id": "c10"
  },
  {
   "text": "验证器在链上",
   "start": 25.092,
   "end": 26.416,
   "id": "c11"
  },
  {
   "text": "检查证明是不是满足这个电路",
   "start": 26.627,
   "end": 28.976,
   "id": "c12"
  },
  {
   "text": "有些方案",
   "start": 29.968,
   "end": 30.78,
   "id": "c13"
  },
  {
   "text": "开工前要先做一次可信设置",
   "start": 30.92,
   "end": 33.15,
   "id": "c14"
  },
  {
   "text": "生成证明用的参数",
   "start": 33.182,
   "end": 34.757,
   "id": "c15"
  },
  {
   "text": "最后 业务合约按证明里的公开输入 去结算",
   "start": 35.756,
   "end": 39.533,
   "id": "c16"
  },
  {
   "text": "电路 设置 证明器 验证器 结算",
   "start": 40.512,
   "end": 44.884,
   "id": "c17"
  },
  {
   "text": "任何一环都可能出错",
   "start": 45.035,
   "end": 46.646,
   "id": "c18"
  },
  {
   "text": "打个比方",
   "start": 47.644,
   "end": 48.599,
   "id": "c19"
  },
  {
   "text": "考试的阅卷机",
   "start": 49.736,
   "end": 50.989,
   "id": "c20"
  },
  {
   "text": "只核对答题卡上的格子",
   "start": 51.069,
   "end": 52.775,
   "id": "c21"
  },
  {
   "text": "是不是按规则涂满",
   "start": 52.795,
   "end": 54.275,
   "id": "c22"
  },
  {
   "text": "如果出题人漏写了一条",
   "start": 55.26,
   "end": 56.953,
   "id": "c23"
  },
  {
   "text": "第 5 题只能涂一个格子",
   "start": 57.022,
   "end": 58.822,
   "id": "c24"
  },
  {
   "text": "考生把第 5 题的 4 个格子全涂上",
   "start": 59.824,
   "end": 62.267,
   "id": "c25"
  },
  {
   "text": "阅卷机照样判对",
   "start": 62.359,
   "end": 64.017,
   "id": "c26"
  },
  {
   "text": "阅卷机没坏",
   "start": 65.012,
   "end": 66.158,
   "id": "c27"
  },
  {
   "text": "是规则漏了一条",
   "start": 66.25,
   "end": 67.622,
   "id": "c28"
  },
  {
   "text": "比喻不成立的地方是",
   "start": 68.616,
   "end": 70.202,
   "id": "c29"
  },
  {
   "text": "真实的电路有成千上万条约束",
   "start": 70.354,
   "end": 72.988,
   "id": "c30"
  },
  {
   "text": "漏写一条",
   "start": 73.972,
   "end": 74.927,
   "id": "c31"
  },
  {
   "text": "从外面看不出任何异常",
   "start": 74.984,
   "end": 76.856,
   "id": "c32"
  },
  {
   "text": "只能靠审计",
   "start": 76.972,
   "end": 78.034,
   "id": "c33"
  },
  {
   "text": "形式化验证和测试去找",
   "start": 78.198,
   "end": 80.201,
   "id": "c34"
  },
  {
   "text": "所以记住一句话",
   "start": 81.176,
   "end": 82.524,
   "id": "c35"
  },
  {
   "text": "验证器只检查证明是否满足电路",
   "start": 83.508,
   "end": 86.416,
   "id": "c36"
  },
  {
   "text": "不检查电路是否写对",
   "start": 86.603,
   "end": 88.285,
   "id": "c37"
  },
  {
   "text": "先看出题这一关 电路",
   "start": 89.272,
   "end": 91.465,
   "id": "c38"
  }
 ]
