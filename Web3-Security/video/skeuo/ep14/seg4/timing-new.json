 "captions": [
  {
   "text": "电路写对之后",
   "start": 1.648,
   "end": 2.829,
   "id": "c0"
  },
  {
   "text": "仍有三个地方会坏",
   "start": 2.957,
   "end": 4.449,
   "id": "c1"
  },
  {
   "text": "第一个 是可信设置",
   "start": 5.42,
   "end": 7.197,
   "id": "c2"
  },
  {
   "text": "Groth16 这类方案",
   "start": 8.184,
   "end": 9.592,
   "id": "c3"
  },
  {
   "text": "要先做一次设置",
   "start": 9.612,
   "end": 10.83,
   "id": "c4"
  },
  {
   "text": "生成证明密钥和验证密钥",
   "start": 10.85,
   "end": 13.056,
   "id": "c5"
  },
  {
   "text": "设置过程会产生秘密",
   "start": 14.044,
   "end": 15.88,
   "id": "c6"
  },
  {
   "text": "俗称有毒废料",
   "start": 15.925,
   "end": 17.476,
   "id": "c7"
  },
  {
   "text": "谁留着它",
   "start": 17.851,
   "end": 18.997,
   "id": "c8"
  },
  {
   "text": "谁就能伪造任意证明",
   "start": 19.077,
   "end": 20.747,
   "id": "c9"
  },
  {
   "text": "所以设置用多方仪式",
   "start": 21.728,
   "end": 23.743,
   "id": "c10"
  },
  {
   "text": "每人贡献一部分",
   "start": 24.118,
   "end": 25.49,
   "id": "c11"
  },
  {
   "text": "只要有一人诚实销毁自己那份",
   "start": 25.594,
   "end": 27.812,
   "id": "c12"
  },
  {
   "text": "秘密就拼不回来",
   "start": 27.963,
   "end": 29.229,
   "id": "c13"
  },
  {
   "text": "按 ECC 的公告",
   "start": 30.204,
   "end": 31.659,
   "id": "c14"
  },
  {
   "text": "Zcash 早期方案的设置产物里",
   "start": 31.799,
   "end": 34.207,
   "id": "c15"
  },
  {
   "text": "多出了一些证明者用不到的元素",
   "start": 34.227,
   "end": 36.374,
   "id": "c16"
  },
  {
   "text": "拿到它们",
   "start": 37.36,
   "end": 38.196,
   "id": "c17"
  },
  {
   "text": "就能把一个证明",
   "start": 38.312,
   "end": 39.482,
   "id": "c18"
  },
  {
   "text": "改造成另一个陈述的有效证明",
   "start": 39.514,
   "end": 41.637,
   "id": "c19"
  },
  {
   "text": "凭空增发 ZEC",
   "start": 41.705,
   "end": 43.101,
   "id": "c20"
  },
  {
   "text": "团队在 2018 年内部发现",
   "start": 44.084,
   "end": 45.956,
   "id": "c21"
  },
  {
   "text": "升级换掉参数",
   "start": 46.012,
   "end": 47.385,
   "id": "c22"
  },
  {
   "text": "2019 年才公开",
   "start": 47.548,
   "end": 49.206,
   "id": "c23"
  },
  {
   "text": "团队称没有发现被利用的证据",
   "start": 49.569,
   "end": 51.918,
   "id": "c24"
  },
  {
   "text": "第二个 是证明器和 zkVM 本身",
   "start": 52.92,
   "end": 55.732,
   "id": "c25"
  },
  {
   "text": "2025 年 1 月",
   "start": 56.716,
   "end": 57.921,
   "id": "c26"
  },
  {
   "text": "Plonky2 的查找表用 0 填充",
   "start": 58.085,
   "end": 60.445,
   "id": "c27"
  },
  {
   "text": "恶意证明者总能证明一个固定的等式",
   "start": 60.656,
   "end": 63.255,
   "id": "c28"
  },
  {
   "text": "2025 年 7 月",
   "start": 64.256,
   "end": 65.485,
   "id": "c29"
  },
  {
   "text": "ZKsync 的一个承诺漏掉了部分内部状态",
   "start": 65.553,
   "end": 68.914,
   "id": "c30"
  },
  {
   "text": "无效的输入能伪装成有效",
   "start": 69.065,
   "end": 71.116,
   "id": "c31"
  },
  {
   "text": "安全委员会紧急升级",
   "start": 72.108,
   "end": 73.92,
   "id": "c32"
  },
  {
   "text": "暂停证明生产",
   "start": 74.012,
   "end": 75.278,
   "id": "c33"
  },
  {
   "text": "没有损失",
   "start": 75.298,
   "end": 76.325,
   "id": "c34"
  },
  {
   "text": "第三个 是验证器",
   "start": 77.32,
   "end": 79.097,
   "id": "c35"
  },
  {
   "text": "证明里的数",
   "start": 80.084,
   "end": 81.087,
   "id": "c36"
  },
  {
   "text": "都在一个有限域里",
   "start": 81.167,
   "end": 82.385,
   "id": "c37"
  },
  {
   "text": "到了阶 r 就绕回 0",
   "start": 82.584,
   "end": 84.265,
   "id": "c38"
  },
  {
   "text": "就像钟面",
   "start": 85.248,
   "end": 86.227,
   "id": "c39"
  },
  {
   "text": "13 点和 1 点",
   "start": 86.26,
   "end": 87.537,
   "id": "c40"
  },
  {
   "text": "指在同一个位置",
   "start": 87.593,
   "end": 88.787,
   "id": "c41"
  },
  {
   "text": "验证器不检查公开输入小于 r",
   "start": 89.788,
   "end": 92.35,
   "id": "c42"
  },
  {
   "text": "攻击者把 x 换成 x 加 r",
   "start": 92.526,
   "end": 95.112,
   "id": "c43"
  },
  {
   "text": "证明照样有效",
   "start": 95.133,
   "end": 96.398,
   "id": "c44"
  },
  {
   "text": "合约却把它当成一个新数",
   "start": 97.376,
   "end": 99.117,
   "id": "c45"
  },
  {
   "text": "只能用一次的记录",
   "start": 99.492,
   "end": 101.031,
   "id": "c46"
  },
  {
   "text": "就能再用一次",
   "start": 101.183,
   "end": 102.305,
   "id": "c47"
  },
  {
   "text": "比喻不成立的地方是",
   "start": 103.284,
   "end": 104.858,
   "id": "c48"
  },
  {
   "text": "钟面只有 12 格",
   "start": 104.974,
   "end": 106.418,
   "id": "c49"
  },
  {
   "text": "有限域的阶是一个极大的数",
   "start": 106.474,
   "end": 108.537,
   "id": "c50"
  },
  {
   "text": "snarkjs 生成的验证器",
   "start": 109.504,
   "end": 111.352,
   "id": "c51"
  },
  {
   "text": "过去同时接受这两个值",
   "start": 111.504,
   "end": 113.328,
   "id": "c52"
  },
  {
   "text": "所以验证器要校验全部公开输入都在域内",
   "start": 114.284,
   "end": 118.096,
   "id": "c53"
  },
  {
   "text": "并跟踪上游的安全公告",
