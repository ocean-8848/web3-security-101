 "captions": [
  {
   "text": "链也可能整条停下",
   "start": 1.55,
   "end": 3.519,
   "id": "c0"
  },
  {
   "text": "活性 是链能继续处理新交易",
   "start": 3.77,
   "end": 6.406,
   "id": "c1"
  },
  {
   "text": "安全性 是已经确认的结果不被推翻",
   "start": 6.807,
   "end": 10.238,
   "id": "c2"
  },
  {
   "text": "2021 年 9 月",
   "start": 10.53,
   "end": 11.945,
   "id": "c3"
  },
  {
   "text": "一次代币发行引来机器人交易洪泛",
   "start": 12.188,
   "end": 15.489,
   "id": "c4"
  },
  {
   "text": "Solana 验证者内存溢出",
   "start": 15.79,
   "end": 17.91,
   "id": "c5"
  },
  {
   "text": "全网停止出块约 17 小时",
   "start": 18.138,
   "end": 20.433,
   "id": "c6"
  },
  {
   "text": "2022 年 10 月",
   "start": 20.831,
   "end": 22.108,
   "id": "c7"
  },
  {
   "text": "BSC 上的跨链桥被伪造证明攻击",
   "start": 22.223,
   "end": 25.27,
   "id": "c8"
  },
  {
   "text": "BNB Chain 要求验证者暂停出块",
   "start": 25.618,
   "end": 28.569,
   "id": "c9"
  },
  {
   "text": "新版本冻结了攻击者地址",
   "start": 28.749,
   "end": 31.06,
   "id": "c10"
  },
  {
   "text": "验证者少的链",
   "start": 31.33,
   "end": 32.725,
   "id": "c11"
  },
  {
   "text": "可以在几小时内协调停链 冻结",
   "start": 32.766,
   "end": 35.815,
   "id": "c12"
  },
  {
   "text": "甚至回滚",
   "start": 35.864,
   "end": 36.779,
   "id": "c13"
  },
  {
   "text": "这能救急",
   "start": 37.084,
   "end": 37.911,
   "id": "c14"
  },
  {
   "text": "也说明这条链的不可篡改",
   "start": 38.21,
   "end": 40.427,
   "id": "c15"
  },
  {
   "text": "是有前提的",
   "start": 40.464,
   "end": 41.528,
   "id": "c16"
  },
  {
   "text": "L2 的排序器",
   "start": 41.869,
   "end": 43.065,
   "id": "c17"
  },
  {
   "text": "通常由一个运营方负责出块",
   "start": 43.143,
   "end": 45.512,
   "id": "c18"
  },
  {
   "text": "它刚出的 unsafe 头",
   "start": 45.75,
   "end": 47.208,
   "id": "c19"
  },
  {
   "text": "只是排序器的承诺",
   "start": 47.318,
   "end": 48.771,
   "id": "c20"
  },
  {
   "text": "可以被回滚",
   "start": 48.795,
   "end": 49.778,
   "id": "c21"
  },
  {
   "text": "2025 年 9 月",
   "start": 50.155,
   "end": 51.46,
   "id": "c22"
  },
  {
   "text": "Starknet 升级后停链",
   "start": 51.505,
   "end": 53.369,
   "id": "c23"
  },
  {
   "text": "并两次回滚",
   "start": 53.5,
   "end": 54.613,
   "id": "c24"
  },
  {
   "text": "第二次回滚掉约 20 分钟的交易",
   "start": 54.921,
   "end": 57.398,
   "id": "c25"
  },
  {
   "text": "如果交易所按 unsafe 头入账",
   "start": 57.702,
   "end": 60.065,
   "id": "c26"
  },
  {
   "text": "用户随即提走",
   "start": 60.229,
   "end": 61.579,
   "id": "c27"
  },
  {
   "text": "块又被回滚",
   "start": 61.748,
   "end": 63.054,
   "id": "c28"
  },
  {
   "text": "这笔损失",
   "start": 63.368,
   "end": 64.149,
   "id": "c29"
  },
  {
   "text": "由交易所承担",
   "start": 64.285,
   "end": 65.396,
   "id": "c30"
  },
  {
   "text": "所以大额要等 L1 上最终确定的批次",
   "start": 65.65,
   "end": 69.191,
   "id": "c31"
  },
  {
   "text": "排序器宕机时",
   "start": 69.47,
   "end": 70.931,
   "id": "c32"
  },
  {
   "text": "用户可以通过 L1 合约",
   "start": 71.098,
   "end": 72.973,
   "id": "c33"
  },
  {
   "text": "强制提交交易",
   "start": 73.092,
   "end": 74.334,
   "id": "c34"
  },
  {
   "text": "最后一种资源",
   "start": 74.57,
   "end": 75.705,
   "id": "c35"
  },
  {
   "text": "是别人的动机",
   "start": 75.836,
   "end": 77.194,
   "id": "c36"
  },
  {
   "text": "2020 年 3 月的 Steem 事件",
   "start": 77.43,
   "end": 79.786,
   "id": "c37"
  },
  {
   "text": "报道称 Huobi",
   "start": 79.988,
   "end": 81.344,
   "id": "c38"
  },
  {
   "text": "Binance 和 Poloniex",
   "start": 81.402,
   "end": 83.244,
   "id": "c39"
  },
  {
   "text": "用托管的客户 STEEM 投票",
   "start": 83.373,
   "end": 85.41,
   "id": "c40"
  },
  {
   "text": "帮助 Justin Sun 控制了见证人席位",
   "start": 85.748,
   "end": 88.293,
   "id": "c41"
  },
  {
   "text": "Huobi 承认动用了客户资金",
   "start": 88.54,
   "end": 90.624,
   "id": "c42"
  },
  {
   "text": "交易所的托管资产",
   "start": 90.91,
   "end": 92.618,
   "id": "c43"
  },
  {
   "text": "本身就是共识权力",
   "start": 92.82,
   "end": 94.523,
   "id": "c44"
  },
  {
   "text": "客户资产默认不参与投票",
   "start": 94.81,
   "end": 97.11,
   "id": "c45"
  },
  {
   "text": "例外要有书面授权",
   "start": 97.354,
   "end": 99.166,
   "id": "c46"
  }
 ]
}