 "captions": [
  {
   "text": "链也可能整条停下",
   "start": 1.648,
   "end": 3.329,
   "id": "c0"
  },
  {
   "text": "活性 是链能继续处理新交易",
   "start": 4.316,
   "end": 7.271,
   "id": "c1"
  },
  {
   "text": "安全性 是已经确认的结果不被推翻",
   "start": 8.256,
   "end": 11.497,
   "id": "c2"
  },
  {
   "text": "2021 年 9 月",
   "start": 12.484,
   "end": 13.808,
   "id": "c3"
  },
  {
   "text": "一次代币发行引来机器人交易洪泛",
   "start": 13.96,
   "end": 16.57,
   "id": "c4"
  },
  {
   "text": "Solana 验证者内存溢出",
   "start": 17.552,
   "end": 19.424,
   "id": "c5"
  },
  {
   "text": "全网停止出块约 17 小时",
   "start": 19.456,
   "end": 21.769,
   "id": "c6"
  },
  {
   "text": "2022 年 10 月",
   "start": 22.764,
   "end": 24.041,
   "id": "c7"
  },
  {
   "text": "BSC 上的跨链桥被伪造证明攻击",
   "start": 24.133,
   "end": 26.636,
   "id": "c8"
  },
  {
   "text": "BNB Chain 要求验证者暂停出块",
   "start": 27.616,
   "end": 30.298,
   "id": "c9"
  },
  {
   "text": "新版本冻结了攻击者地址",
   "start": 30.449,
   "end": 32.512,
   "id": "c10"
  },
  {
   "text": "验证者少的链",
   "start": 33.5,
   "end": 34.765,
   "id": "c11"
  },
  {
   "text": "可以在几小时内协调停链 冻结",
   "start": 34.809,
   "end": 37.967,
   "id": "c12"
  },
  {
   "text": "甚至回滚",
   "start": 38.012,
   "end": 39.039,
   "id": "c13"
  },
  {
   "text": "这能救急",
   "start": 40.008,
   "end": 41.094,
   "id": "c14"
  },
  {
   "text": "也说明这条链的不可篡改",
   "start": 41.246,
   "end": 43.154,
   "id": "c15"
  },
  {
   "text": "是有前提的",
   "start": 43.353,
   "end": 44.392,
   "id": "c16"
  },
  {
   "text": "L2 的排序器",
   "start": 45.364,
   "end": 46.581,
   "id": "c17"
  },
  {
   "text": "通常由一个运营方负责出块",
   "start": 46.685,
   "end": 48.76,
   "id": "c18"
  },
  {
   "text": "它刚出的 unsafe 头",
   "start": 49.736,
   "end": 51.429,
   "id": "c19"
  },
  {
   "text": "只是排序器的承诺",
   "start": 51.462,
   "end": 52.823,
   "id": "c20"
  },
  {
   "text": "可以被回滚",
   "start": 52.843,
   "end": 53.775,
   "id": "c21"
  },
  {
   "text": "2025 年 9 月",
   "start": 54.756,
   "end": 56.069,
   "id": "c22"
  },
  {
   "text": "Starknet 升级后停链",
   "start": 56.089,
   "end": 57.854,
   "id": "c23"
  },
  {
   "text": "并两次回滚",
   "start": 57.875,
   "end": 59.068,
   "id": "c24"
  },
  {
   "text": "第二次回滚掉约 20 分钟的交易",
   "start": 60.064,
   "end": 62.388,
   "id": "c25"
  },
  {
   "text": "如果交易所按 unsafe 头入账",
   "start": 63.38,
   "end": 65.597,
   "id": "c26"
  },
  {
   "text": "用户随即提走",
   "start": 65.689,
   "end": 66.907,
   "id": "c27"
  },
  {
   "text": "块又被回滚",
   "start": 66.927,
   "end": 67.942,
   "id": "c28"
  },
  {
   "text": "这笔损失",
   "start": 68.928,
   "end": 69.99,
   "id": "c29"
  },
  {
   "text": "由交易所承担",
   "start": 70.023,
   "end": 71.229,
   "id": "c30"
  },
  {
   "text": "所以大额要等 L1 上最终确定的批次",
   "start": 72.22,
   "end": 75.842,
   "id": "c31"
  },
  {
   "text": "排序器宕机时",
   "start": 76.832,
   "end": 78.156,
   "id": "c32"
  },
  {
   "text": "用户可以通过 L1 合约",
   "start": 78.308,
   "end": 80.252,
   "id": "c33"
  },
  {
   "text": "强制提交交易",
   "start": 80.272,
   "end": 81.49,
   "id": "c34"
  },
  {
   "text": "最后一种资源",
   "start": 82.476,
   "end": 83.729,
   "id": "c35"
  },
  {
   "text": "是别人的动机",
   "start": 83.892,
   "end": 85.038,
   "id": "c36"
  },
  {
   "text": "2020 年 3 月的 Steem 事件",
   "start": 86.032,
   "end": 87.988,
   "id": "c37"
  },
  {
   "text": "报道称 Huobi",
   "start": 88.008,
   "end": 89.44,
   "id": "c38"
  },
  {
   "text": "Binance 和 Poloniex",
   "start": 89.46,
   "end": 91.19,
   "id": "c39"
  },
  {
   "text": "用托管的客户 STEEM 投票",
   "start": 91.222,
   "end": 93.392,
   "id": "c40"
  },
  {
   "text": "帮助 Justin Sun 控制了见证人席位",
   "start": 94.364,
   "end": 97.141,
   "id": "c41"
  },
  {
   "text": "Huobi 承认动用了客户资金",
   "start": 97.352,
   "end": 99.724,
   "id": "c42"
  },
  {
   "text": "交易所的托管资产",
   "start": 100.704,
   "end": 102.35,
   "id": "c43"
  },
  {
   "text": "本身就是共识权力",
   "start": 102.454,
   "end": 104.052,
   "id": "c44"
  },
  {
   "text": "客户资产默认不参与投票",
   "start": 105.052,
   "end": 107.257,
   "id": "c45"
  },
  {
   "text": "例外要有书面授权",
