 "captions": [
  {
   "text": "这些钓鱼网站",
   "start": 1.646,
   "end": 2.81,
   "id": "c0"
  },
  {
   "text": "很多出自同一类工具",
   "start": 2.912,
   "end": 4.769,
   "id": "c1"
  },
  {
   "text": "它叫 Drainer 即服务",
   "start": 5.05,
   "end": 6.632,
   "id": "c2"
  },
  {
   "text": "开发者维护钓鱼套件",
   "start": 6.968,
   "end": 8.788,
   "id": "c3"
  },
  {
   "text": "合约和后台",
   "start": 8.834,
   "end": 10.119,
   "id": "c4"
  },
  {
   "text": "把它当作产品出租",
   "start": 10.433,
   "end": 11.978,
   "id": "c5"
  },
  {
   "text": "分发者负责引流",
   "start": 12.21,
   "end": 13.958,
   "id": "c6"
  },
  {
   "text": "搭仿冒网站 买广告",
   "start": 14.223,
   "end": 16.014,
   "id": "c7"
  },
  {
   "text": "盗社交账号",
   "start": 16.034,
   "end": 17.57,
   "id": "c8"
  },
  {
   "text": "链接投到被盗的 X 和 Discord 账号",
   "start": 17.885,
   "end": 20.717,
   "id": "c9"
  },
  {
   "text": "搜索广告",
   "start": 20.872,
   "end": 21.738,
   "id": "c10"
  },
  {
   "text": "假空投和私信里",
   "start": 21.887,
   "end": 23.43,
   "id": "c11"
  },
  {
   "text": "受害者一签名",
   "start": 23.782,
   "end": 25.033,
   "id": "c12"
  },
  {
   "text": "转走的资产自动分账",
   "start": 25.229,
   "end": 27.059,
   "id": "c13"
  },
  {
   "text": "公开分析显示",
   "start": 27.27,
   "end": 28.445,
   "id": "c14"
  },
  {
   "text": "开发者抽成约 20%",
   "start": 28.604,
   "end": 30.826,
   "id": "c15"
  },
  {
   "text": "分发者拿约 80%",
   "start": 31.051,
   "end": 33.265,
   "id": "c16"
  },
  {
   "text": "各家套件的比例不同 也会变",
   "start": 33.49,
   "end": 36.054,
   "id": "c17"
  },
  {
   "text": "套件会先读你钱包里的余额",
   "start": 36.27,
   "end": 38.738,
   "id": "c18"
  },
  {
   "text": "按价值排序",
   "start": 38.903,
   "end": 39.937,
   "id": "c19"
  },
  {
   "text": "先请求最值钱的那个授权",
   "start": 40.244,
   "end": 42.423,
   "id": "c20"
  },
  {
   "text": "所以同一个钓鱼站",
   "start": 42.65,
   "end": 44.245,
   "id": "c21"
  },
  {
   "text": "对不同的人",
   "start": 44.418,
   "end": 45.348,
   "id": "c22"
  },
  {
   "text": "弹出的签名请求不一样",
   "start": 45.422,
   "end": 47.244,
   "id": "c23"
  },
  {
   "text": "Inferno Drainer",
   "start": 47.613,
   "end": 48.477,
   "id": "c24"
  },
  {
   "text": "在 2023 年 11 月宣布关停",
   "start": 48.497,
   "end": 50.493,
   "id": "c25"
  },
  {
   "text": "此前约 7000 万美元",
   "start": 50.513,
   "end": 53.115,
   "id": "c26"
  },
  {
   "text": "2025 年 5 月",
   "start": 53.435,
   "end": 54.692,
   "id": "c27"
  },
  {
   "text": "Check Point 发现它仍在运行",
   "start": 54.891,
   "end": 57.239,
   "id": "c28"
  },
  {
   "text": "半年内盗走约 900 万美元以上",
   "start": 57.481,
   "end": 60.497,
   "id": "c29"
  },
  {
   "text": "这次它在 Discord 冒充",
   "start": 60.75,
   "end": 62.721,
   "id": "c30"
  },
  {
   "text": "Collab.Land 引流",
   "start": 62.741,
   "end": 64.291,
   "id": "c31"
  },
  {
   "text": "受害者有 3 万多名",
   "start": 64.47,
   "end": 66.213,
   "id": "c32"
  },
  {
   "text": "Pink Drainer 在",
   "start": 66.589,
   "end": 67.877,
   "id": "c33"
  },
  {
   "text": "2024 年 5 月宣布退休",
   "start": 67.897,
   "end": 70.594,
   "id": "c34"
  },
  {
   "text": "约 2.1 万名受害者",
   "start": 70.723,
   "end": 72.318,
   "id": "c35"
  },
  {
   "text": "约 8500 万美元",
   "start": 72.539,
   "end": 74.566,
   "id": "c36"
  },
  {
   "text": "Angel Drainer 到 2024 年 2 月",
   "start": 74.887,
   "end": 77.787,
   "id": "c37"
  },
  {
   "text": "约 2500 万美元",
   "start": 78.023,
   "end": 79.951,
   "id": "c38"
  },
  {
   "text": "同年 7 月停止服务",
   "start": 80.16,
   "end": 81.883,
   "id": "c39"
  },
  {
   "text": "关停不等于消失",
   "start": 82.223,
   "end": 83.874,
   "id": "c40"
  },
  {
   "text": "套件代码和分发网络",
   "start": 83.96,
   "end": 85.958,
   "id": "c41"
  },
  {
   "text": "会换个名字回来",
   "start": 85.978,
   "end": 87.021,
   "id": "c42"
  },
  {
   "text": "整体看 2024 年的钓鱼损失约 4.94 亿美元",
   "start": 87.406,
   "end": 92.078,
   "id": "c43"
  },
  {
