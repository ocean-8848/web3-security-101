 "captions": [
  {
   "text": "先给准确的说法",
   "start": 1.648,
   "end": 3.103,
   "id": "c0"
  },
  {
   "text": "钓鱼签名",
   "start": 4.1,
   "end": 5.187,
   "id": "c1"
  },
  {
   "text": "是诱导你签下一个授权",
   "start": 5.207,
   "end": 7.186,
   "id": "c2"
  },
  {
   "text": "把资产的控制权交给攻击者",
   "start": 7.373,
   "end": 9.734,
   "id": "c3"
  },
  {
   "text": "你签的是真名",
   "start": 10.728,
   "end": 11.909,
   "id": "c4"
  },
  {
   "text": "私钥也一直在你手里",
   "start": 12.025,
   "end": 13.529,
   "id": "c5"
  },
  {
   "text": "打个比方",
   "start": 14.5,
   "end": 15.384,
   "id": "c6"
  },
  {
   "text": "骗子拿来一张快递签收单",
   "start": 15.464,
   "end": 17.324,
   "id": "c7"
  },
  {
   "text": "请你签个字",
   "start": 17.535,
   "end": 18.491,
   "id": "c8"
  },
  {
   "text": "签收单背面印着",
   "start": 19.472,
   "end": 21.07,
   "id": "c9"
  },
  {
   "text": "同意把房门钥匙交给持单人",
   "start": 21.162,
   "end": 23.463,
   "id": "c10"
  },
  {
   "text": "比喻在这里不成立",
   "start": 24.444,
   "end": 25.828,
   "id": "c11"
  },
  {
   "text": "签收单可以翻过来看",
   "start": 25.967,
   "end": 27.578,
   "id": "c12"
  },
  {
   "text": "钱包里的签名请求",
   "start": 28.576,
   "end": 30.21,
   "id": "c13"
  },
  {
   "text": "常常只显示一串十六进制数据",
   "start": 30.302,
   "end": 33.055,
   "id": "c14"
  },
  {
   "text": "最容易被滥用的签名 有五类",
   "start": 34.052,
   "end": 36.543,
   "id": "c15"
  },
  {
   "text": "第一类 approve",
   "start": 37.512,
   "end": 38.991,
   "id": "c16"
  },
  {
   "text": "允许对方转走你某个代币",
   "start": 39.25,
   "end": 41.086,
   "id": "c17"
  },
  {
   "text": "最多到一个额度",
   "start": 41.119,
   "end": 42.182,
   "id": "c18"
  },
  {
   "text": "它要上链",
   "start": 43.18,
   "end": 44.064,
   "id": "c19"
  },
  {
   "text": "要花 Gas",
   "start": 44.12,
   "end": 45.135,
   "id": "c20"
  },
  {
   "text": "第二类 permit",
   "start": 46.112,
   "end": 47.52,
   "id": "c21"
  },
  {
   "text": "效果和 approve 一样",
   "start": 47.635,
   "end": 49.222,
   "id": "c22"
  },
  {
   "text": "但只是一个链下签名",
   "start": 49.266,
   "end": 50.627,
   "id": "c23"
  },
  {
   "text": "签好的消息",
   "start": 51.612,
   "end": 52.734,
   "id": "c24"
  },
  {
   "text": "由别人提交上链",
   "start": 52.79,
   "end": 54.079,
   "id": "c25"
  },
  {
   "text": "第三类 setApprovalForAll",
   "start": 55.072,
   "end": 57.527,
   "id": "c26"
  },
  {
   "text": "对方能转走你在一个 NFT 系列里的全部 NFT",
   "start": 57.655,
   "end": 61.527,
   "id": "c27"
  },
  {
   "text": "第四类 Permit2 批量授权",
   "start": 62.516,
   "end": 65.162,
   "id": "c28"
  },
  {
   "text": "一次签名",
   "start": 65.242,
   "end": 66.055,
   "id": "c29"
  },
  {
   "text": "交出多种代币",
   "start": 66.075,
   "end": 67.305,
   "id": "c30"
  },
  {
   "text": "第五类 EIP-7702 委托",
   "start": 68.304,
   "end": 71.224,
   "id": "c31"
  },
  {
   "text": "你的地址去执行一份委托合约的代码",
   "start": 71.423,
   "end": 74.14,
   "id": "c32"
  },
  {
   "text": "那份代码",
   "start": 75.124,
   "end": 76.044,
   "id": "c33"
  },
  {
   "text": "可以直接转走全部资产",
   "start": 76.124,
   "end": 77.984,
   "id": "c34"
  },
  {
   "text": "最危险的是链下签名",
   "start": 78.968,
   "end": 80.65,
   "id": "c35"
  },
  {
   "text": "不花 Gas",
   "start": 80.67,
   "end": 81.602,
   "id": "c36"
  },
  {
   "text": "钱包里也没有交易记录",
   "start": 81.718,
   "end": 83.376,
   "id": "c37"
  },
  {
   "text": "你以为只是登录",
   "start": 84.372,
   "end": 85.732,
   "id": "c38"
  },
  {
   "text": "其实签下一张支票",
   "start": 85.8,
   "end": 87.268,
   "id": "c39"
  },
  {
   "text": "2024 年 9 月",
   "start": 88.264,
   "end": 89.506,
   "id": "c40"
  },
  {
   "text": "有人签了一个 permit",
   "start": 89.526,
   "end": 90.874,
   "id": "c41"
  },
  {
   "text": "被转走约 3243 万美元的 spWETH",
   "start": 91.002,
   "end": 94.731,
   "id": "c42"
  },
  {
   "text": "同年 8 月",
   "start": 95.732,
   "end": 96.687,
   "id": "c43"
  },
  {
   "text": "另一名用户的签名",
   "start": 96.744,
   "end": 98.128,
   "id": "c44"
  },
  {
   "text": "把金库合约的 owner 改成攻击者",
   "start": 98.148,
   "end": 100.675,
   "id": "c45"
  },
  {
   "text": "约 20 分钟后",
   "start": 101.664,
   "end": 102.905,
   "id": "c46"
  },
  {
   "text": "攻击者铸出约 5547 万美元的 DAI",
   "start": 103.068,
   "end": 106.131,
   "id": "c47"
  },
  {
   "text": "这一例不是 permit",
   "start": 107.092,
   "end": 108.738,
   "id": "c48"
  },
  {
   "text": "是改 owner",
   "start": 108.758,
   "end": 109.726,
   "id": "c49"
  },
  {
   "text": "链下签名不上链",
   "start": 110.72,
   "end": 112.163,
   "id": "c50"
  },
  {
   "text": "也能转移资产",
   "start": 112.303,
   "end": 113.437,
   "id": "c51"
  },
  {
   "text": "2025 年 8 月",
   "start": 114.42,
   "end": 115.744,
   "id": "c52"
  },
  {
   "text": "又有两起 7702 委托钓鱼",
   "start": 115.801,
   "end": 118.268,
   "id": "c53"
  },
  {
   "text": "分别约 154 万和 100 万美元",
   "start": 118.42,
   "end": 121.137,
   "id": "c54"
  },
  {
   "text": "也有研究者认为",
   "start": 122.128,
   "end": 123.393,
   "id": "c55"
  },
  {
   "text": "这两起的根因仍是私钥泄露",
   "start": 123.568,
   "end": 125.881,
   "id": "c56"
  },
  {
   "text": "委托只是让转账更快",
   "start": 126.02,
   "end": 127.762,
   "id": "c57"
  },
  {
   "text": "大额地址的签名",
   "start": 128.732,
   "end": 130.175,
   "id": "c58"
  },
  {
   "text": "要在可信设备上逐字段解码",
   "start": 130.291,
   "end": 132.806,
   "id": "c59"
  }
 ]
