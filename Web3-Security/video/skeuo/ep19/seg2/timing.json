 "captions": [
  {
   "text": "先给准确的说法",
   "start": 1.55,
   "end": 2.807,
   "id": "c0"
  },
  {
   "text": "钓鱼签名",
   "start": 3.141,
   "end": 3.963,
   "id": "c1"
  },
  {
   "text": "是诱导你签下一个授权",
   "start": 3.983,
   "end": 5.943,
   "id": "c2"
  },
  {
   "text": "把资产的控制权交给攻击者",
   "start": 6.138,
   "end": 8.572,
   "id": "c3"
  },
  {
   "text": "你签的是真名",
   "start": 8.883,
   "end": 10.129,
   "id": "c4"
  },
  {
   "text": "私钥也一直在你手里",
   "start": 10.224,
   "end": 11.925,
   "id": "c5"
  },
  {
   "text": "打个比方",
   "start": 12.305,
   "end": 12.971,
   "id": "c6"
  },
  {
   "text": "骗子拿来一张快递签收单",
   "start": 13.43,
   "end": 15.474,
   "id": "c7"
  },
  {
   "text": "请你签个字",
   "start": 15.576,
   "end": 16.489,
   "id": "c8"
  },
  {
   "text": "签收单背面印着",
   "start": 16.75,
   "end": 18.124,
   "id": "c9"
  },
  {
   "text": "同意把房门钥匙交给持单人",
   "start": 18.218,
   "end": 20.855,
   "id": "c10"
  },
  {
   "text": "比喻在这里不成立",
   "start": 21.23,
   "end": 22.651,
   "id": "c11"
  },
  {
   "text": "签收单可以翻过来看",
   "start": 22.921,
   "end": 24.464,
   "id": "c12"
  },
  {
   "text": "钱包里的签名请求",
   "start": 24.801,
   "end": 26.529,
   "id": "c13"
  },
  {
   "text": "常常只显示一串十六进制数据",
   "start": 26.648,
   "end": 28.967,
   "id": "c14"
  },
  {
   "text": "最容易被滥用的签名 有五类",
   "start": 29.344,
   "end": 31.78,
   "id": "c15"
  },
  {
   "text": "第一类 approve",
   "start": 32.127,
   "end": 33.476,
   "id": "c16"
  },
  {
   "text": "允许对方转走你某个代币",
   "start": 33.737,
   "end": 35.713,
   "id": "c17"
  },
  {
   "text": "最多到一个额度",
   "start": 35.955,
   "end": 37.427,
   "id": "c18"
  },
  {
   "text": "它要上链",
   "start": 37.69,
   "end": 38.709,
   "id": "c19"
  },
  {
   "text": "要花 Gas",
   "start": 38.773,
   "end": 39.673,
   "id": "c20"
  },
  {
   "text": "第二类 permit",
   "start": 40.003,
   "end": 41.404,
   "id": "c21"
  },
  {
   "text": "效果和 approve 一样",
   "start": 41.581,
   "end": 43.25,
   "id": "c22"
  },
  {
   "text": "但只是一个链下签名",
   "start": 43.443,
   "end": 45.218,
   "id": "c23"
  },
  {
   "text": "签好的消息",
   "start": 45.582,
   "end": 46.595,
   "id": "c24"
  },
  {
   "text": "由别人提交上链",
   "start": 46.727,
   "end": 48.224,
   "id": "c25"
  },
  {
   "text": "第三类 setApprovalForAll",
   "start": 48.616,
   "end": 50.977,
   "id": "c26"
  },
  {
   "text": "对方能转走你在一个 NFT 系列里的全部 NFT",
   "start": 51.258,
   "end": 55.424,
   "id": "c27"
  },
  {
   "text": "第四类 Permit2 批量授权",
   "start": 55.69,
   "end": 58.235,
   "id": "c28"
  },
  {
   "text": "一次签名",
   "start": 58.255,
   "end": 59.141,
   "id": "c29"
  },
  {
   "text": "交出多种代币",
   "start": 59.161,
   "end": 60.317,
   "id": "c30"
  },
  {
   "text": "第五类 EIP-7702 委托",
   "start": 60.647,
   "end": 62.952,
   "id": "c31"
  },
  {
   "text": "你的地址去执行一份委托合约的代码",
   "start": 63.055,
   "end": 67.165,
   "id": "c32"
  },
  {
   "text": "那份代码",
   "start": 67.41,
   "end": 68.194,
   "id": "c33"
  },
  {
   "text": "可以直接转走全部资产",
   "start": 68.378,
   "end": 70.3,
   "id": "c34"
  },
  {
   "text": "最危险的是链下签名",
   "start": 70.51,
   "end": 72.767,
   "id": "c35"
  },
  {
   "text": "不花 Gas",
   "start": 72.941,
   "end": 73.694,
   "id": "c36"
  },
  {
   "text": "钱包里也没有交易记录",
   "start": 73.825,
   "end": 75.541,
   "id": "c37"
  },
  {
   "text": "你以为只是登录",
   "start": 75.868,
   "end": 77.149,
   "id": "c38"
  },
  {
   "text": "其实签下一张支票",
   "start": 77.365,
   "end": 79.042,
   "id": "c39"
  },
  {
   "text": "2024 年 9 月",
   "start": 79.455,
   "end": 80.822,
   "id": "c40"
  },
  {
   "text": "有人签了一个 permit",
   "start": 81.0,
   "end": 83.398,
   "id": "c41"
  },
  {
   "text": "被转走约 3243 万美元的 spWETH",
   "start": 83.418,
   "end": 87.639,
   "id": "c42"
  },
  {
   "text": "同年 8 月",
   "start": 87.89,
   "end": 88.819,
   "id": "c43"
  },
  {
   "text": "另一名用户的签名",
   "start": 89.125,
   "end": 90.534,
   "id": "c44"
  },
  {
   "text": "把金库合约的 owner 改成攻击者",
   "start": 90.714,
   "end": 93.463,
   "id": "c45"
  },
  {
   "text": "约 20 分钟后",
   "start": 93.808,
   "end": 94.972,
   "id": "c46"
  },
  {
   "text": "攻击者铸出约 5547 万美元的 DAI",
   "start": 95.241,
   "end": 98.953,
   "id": "c47"
  },
  {
   "text": "这一例不是 permit",
   "start": 99.306,
   "end": 100.733,
   "id": "c48"
  },
  {
   "text": "是改 owner",
   "start": 100.93,
   "end": 101.807,
   "id": "c49"
  },
  {
   "text": "链下签名不上链",
   "start": 102.07,
   "end": 103.858,
   "id": "c50"
  },
  {
   "text": "也能转移资产",
   "start": 103.891,
   "end": 105.13,
   "id": "c51"
  },
  {
   "text": "2025 年 8 月",
   "start": 105.517,
   "end": 106.736,
   "id": "c52"
  },
  {
   "text": "又有两起 7702 委托钓鱼",
   "start": 106.842,
   "end": 109.2,
   "id": "c53"
  },
  {
   "text": "分别约 154 万和 100 万美元",
   "start": 109.465,
   "end": 112.747,
   "id": "c54"
  },
  {
   "text": "也有研究者认为",
   "start": 113.088,
   "end": 114.233,
   "id": "c55"
  },
  {
   "text": "这两起的根因仍是私钥泄露",
   "start": 114.414,
   "end": 116.861,
   "id": "c56"
  },
  {
   "text": "委托只是让转账更快",
   "start": 117.068,
   "end": 118.992,
   "id": "c57"
  },
  {
   "text": "大额地址的签名",
   "start": 119.306,
   "end": 120.589,
   "id": "c58"
  },
  {
   "text": "要在可信设备上逐字段解码",
   "start": 120.645,
   "end": 123.224,
   "id": "c59"
  }
 ]
}