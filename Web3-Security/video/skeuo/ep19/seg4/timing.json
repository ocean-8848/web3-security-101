   "id": "c33"
  },
  {
   "text": "开发者撤走流动性",
   "start": 82.613,
   "end": 84.44,
   "id": "c34"
  },
  {
   "text": "约 338 万美元",
   "start": 84.546,
   "end": 86.414,
   "id": "c35"
