  {
   "text": "不允许卖",
   "start": 71.24,
   "end": 72.111,
   "id": "c28"
  },
  {
   "text": "或者卖出税 100%",
   "start": 72.493,
   "end": 74.782,
   "id": "c29"
  },
  {
   "text": "隐藏增发",
   "start": 75.01,
   "end": 76.012,
   "id": "c30"
  },
  {
   "text": "是 owner 能无限铸币",
   "start": 76.122,
   "end": 77.733,
   "id": "c31"
  },
  {
   "text": "2021 年 11 月的 SQUID 代币",
