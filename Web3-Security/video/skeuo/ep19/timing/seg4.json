 "lines": [
  {
   "id": "seg4-00",
   "text": "回到开头那笔转账。",
   "spoken": "回到开头那笔转账。",
   "src": "/Users/k/Workon/Learning/web3/web3-security-101/Web3-Security/video/skeuo/ep19/audio/lines/seg4-00.mp3",
   "start": 1.6,
   "dur": 2.328,
   "speechStart": 1.698,
   "speechEnd": 3.09
  },
  {
   "id": "seg4-01",
   "text": "这叫地址投毒。",
   "spoken": "这叫地址投毒。",
   "src": "/Users/k/Workon/Learning/web3/web3-security-101/Web3-Security/video/skeuo/ep19/audio/lines/seg4-01.mp3",
   "start": 4.148,
   "dur": 2.208,
   "speechStart": 4.246,
   "speechEnd": 5.508
  },
  {
   "id": "seg4-02",
   "text": "攻击者监控链上的转账，看到你的测试转账。",
   "spoken": "攻击者监控链上的转账，看到你的测试转账。",
   "src": "/Users/k/Workon/Learning/web3/web3-security-101/Web3-Security/video/skeuo/ep19/audio/lines/seg4-02.mp3",
   "start": 6.576,
   "dur": 4.224,
   "speechStart": 6.674,
   "speechEnd": 9.947
  },
  {
   "id": "seg4-03",
   "text": "他生成一个首尾和收款地址相同、中间不同的地址。",
   "spoken": "他生成一个首尾和收款地址相同、中间不同的地址。",
   "src": "/Users/k/Workon/Learning/web3/web3-security-101/Web3-Security/video/skeuo/ep19/audio/lines/seg4-03.mp3",
   "start": 11.02,
   "dur": 5.352,
   "speechStart": 11.118,
   "speechEnd": 15.522
  },
  {
   "id": "seg4-04",
   "text": "首尾加起来 8 个十六进制字符，平均只要试约 43 亿次。",
   "spoken": "首尾加起来 8 个十六进制字符，平均只要试约 43 亿次。",
   "src": "/Users/k/Workon/Learning/web3/web3-security-101/Web3-Security/video/skeuo/ep19/audio/lines/seg4-04.mp3",
   "start": 16.592,
   "dur": 5.112,
   "speechStart": 16.69,
   "speechEnd": 20.868
  },
  {
   "id": "seg4-05",
   "text": "然后，他往你的记录里塞一笔 0 额或者粉尘转账。",
   "spoken": "然后，他往你的记录里塞一笔 0 额或者粉尘转账。",
   "src": "/Users/k/Workon/Learning/web3/web3-security-101/Web3-Security/video/skeuo/ep19/audio/lines/seg4-05.mp3",
   "start": 21.924,
   "dur": 5.208,
   "speechStart": 22.022,
   "speechEnd": 26.295
  },
  {
   "id": "seg4-06",
   "text": "这一步不需要你的任何授权。",
   "spoken": "这一步不需要你的任何授权。",
   "src": "/Users/k/Workon/Learning/web3/web3-security-101/Web3-Security/video/skeuo/ep19/audio/lines/seg4-06.mp3",
   "start": 27.352,
   "dur": 3.072,
   "speechStart": 27.45,
   "speechEnd": 29.581
  },
  {
   "id": "seg4-07",
   "text": "转 0 个代币，或者用他自己部署的同名假代币，都能在你的记录里留下一条。",
   "spoken": "转 0 个代币，或者用他自己部署的同名假代币，都能在你的记录里留下一条。",
   "src": "/Users/k/Workon/Learning/web3/web3-security-101/Web3-Security/video/skeuo/ep19/audio/lines/seg4-07.mp3",
   "start": 30.644,
   "dur": 6.504,
   "speechStart": 30.742,
   "speechEnd": 36.313
  },
  {
   "id": "seg4-08",
   "text": "钱包只显示地址的前后几位，两个地址看起来一样。",
   "spoken": "钱包只显示地址的前后几位，两个地址看起来一样。",
   "src": "/Users/k/Workon/Learning/web3/web3-security-101/Web3-Security/video/skeuo/ep19/audio/lines/seg4-08.mp3",
   "start": 37.368,
   "dur": 4.848,
   "speechStart": 37.466,
   "speechEnd": 41.382
  },
  {
   "id": "seg4-09",
   "text": "所以测试转账防不住投毒，投毒常在测试之后几分钟内出现。",
   "spoken": "所以测试转账防不住投毒，投毒常在测试之后几分钟内出现。",
   "src": "/Users/k/Workon/Learning/web3/web3-security-101/Web3-Security/video/skeuo/ep19/audio/lines/seg4-09.mp3",
   "start": 42.436,
   "dur": 5.736,
   "speechStart": 42.534,
   "speechEnd": 47.319
  },
  {
   "id": "seg4-10",
   "text": "2024 年 5 月，另一名受害者复制投毒地址，转出 1155 枚 WBTC，约 6800 万美元。",
   "spoken": "2024 年 5 月，另一名受害者复制投毒地址，转出 1155 枚 WBTC，约 6800 万美元。",
   "src": "/Users/k/Workon/Learning/web3/web3-security-101/Web3-Security/video/skeuo/ep19/audio/lines/seg4-10.mp3",
   "start": 48.392,
   "dur": 9.048,
   "speechStart": 48.49,
   "speechEnd": 56.597
  },
  {
   "id": "seg4-11",
   "text": "经过链上喊话谈判，攻击者在约一周内退回绝大部分资金。",
   "spoken": "经过链上喊话谈判，攻击者在约一周内退回绝大部分资金。",
   "src": "/Users/k/Workon/Learning/web3/web3-security-101/Web3-Security/video/skeuo/ep19/audio/lines/seg4-11.mp3",
   "start": 57.66,
   "dur": 5.688,
   "speechStart": 57.758,
   "speechEnd": 62.508
  },
  {
   "id": "seg4-12",
   "text": "骗你转错是一种，骗你买错是另一种。",
   "spoken": "骗你转错是一种，骗你买错是另一种。",
   "src": "/Users/k/Workon/Learning/web3/web3-security-101/Web3-Security/video/skeuo/ep19/audio/lines/seg4-12.mp3",
   "start": 63.568,
   "dur": 3.552,
   "speechStart": 63.666,
   "speechEnd": 66.308
  },
  {
   "id": "seg4-13",
   "text": "卷款，是团队撤走流动性，或者把手里的币集中卖掉。",
   "spoken": "卷款，是团队撤走流动性，或者把手里的币集中卖掉。",
