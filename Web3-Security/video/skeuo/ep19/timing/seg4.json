   "end": 19.0,
   "id": "c6"
  },
  {
   "text": "平均只要试约 43 亿次",
   "start": 19.152,
   "end": 20.988,
   "id": "c7"
  },
  {
   "text": "然后 他往你的记录里塞一笔 0 额或者粉尘转账",
   "start": 21.972,
   "end": 26.415,
   "id": "c8"
  },
  {
   "text": "这一步不需要你的任何授权",
   "start": 27.4,
   "end": 29.701,
   "id": "c9"
  },
  {
   "text": "转 0 个代币",
   "start": 30.692,
   "end": 31.838,
   "id": "c10"
  },
  {
   "text": "或者用他自己部署的同名假代币",
   "start": 32.001,
   "end": 34.528,
   "id": "c11"
  },
  {
   "text": "都能在你的记录里留下一条",
   "start": 34.727,
   "end": 36.433,
   "id": "c12"
  },
  {
   "text": "钱包只显示地址的前后几位",
   "start": 37.416,
   "end": 39.752,
   "id": "c13"
  },
  {
   "text": "两个地址看起来一样",
   "start": 39.892,
   "end": 41.502,
   "id": "c14"
  },
  {
   "text": "所以测试转账防不住投毒",
   "start": 42.484,
   "end": 44.856,
   "id": "c15"
  },
  {
   "text": "投毒常在测试之后几分钟内出现",
   "start": 44.984,
   "end": 47.439,
   "id": "c16"
  },
  {
   "text": "2024 年 5 月",
   "start": 48.44,
   "end": 49.741,
   "id": "c17"
  },
  {
   "text": "另一名受害者复制投毒地址",
   "start": 49.785,
   "end": 52.145,
   "id": "c18"
  },
  {
   "text": "转出 1155 枚 WBTC",
   "start": 52.19,
   "end": 54.991,
   "id": "c19"
  },
  {
   "text": "约 6800 万美元",
   "start": 55.094,
   "end": 56.717,
   "id": "c20"
  },
  {
   "text": "经过链上喊话谈判",
   "start": 57.708,
   "end": 59.413,
   "id": "c21"
  },
  {
   "text": "攻击者在约一周内退回绝大部分资金",
   "start": 59.624,
   "end": 62.628,
   "id": "c22"
  },
  {
   "text": "骗你转错是一种",
   "start": 63.616,
   "end": 64.94,
   "id": "c23"
  },
  {
   "text": "骗你买错是另一种",
   "start": 65.068,
   "end": 66.428,
   "id": "c24"
  },
  {
   "text": "卷款 是团队撤走流动性",
   "start": 67.388,
   "end": 70.022,
   "id": "c25"
  },
  {
   "text": "或者把手里的币集中卖掉",
   "start": 70.054,
   "end": 72.117,
   "id": "c26"
  },
  {
   "text": "貔貅盘 是合约只允许买",
   "start": 73.104,
   "end": 75.345,
   "id": "c27"
  },
  {
   "text": "不允许卖",
   "start": 75.473,
   "end": 76.369,
   "id": "c28"
  },
  {
   "text": "或者卖出税 100%",
   "start": 76.532,
   "end": 78.345,
   "id": "c29"
  },
  {
   "text": "隐藏增发",
   "start": 79.324,
   "end": 80.22,
   "id": "c30"
  },
  {
   "text": "是 owner 能无限铸币",
   "start": 80.24,
   "end": 82.172,
   "id": "c31"
  },
  {
   "text": "2021 年 11 月的 SQUID 代币",
   "start": 83.168,
   "end": 85.683,
   "id": "c32"
  },
  {
   "text": "限制持币者卖出",
   "start": 85.727,
   "end": 87.171,
   "id": "c33"
  },
  {
   "text": "开发者撤走流动性",
   "start": 87.215,
   "end": 88.885,
   "id": "c34"
  },
  {
   "text": "约 338 万美元",
   "start": 88.918,
   "end": 90.48,
   "id": "c35"
  },
  {
   "text": "2025 年 2 月的 LIBRA 代币",
   "start": 91.476,
   "end": 93.824,
   "id": "c36"
  },
  {
   "text": "阿根廷总统发推推广后暴涨",
   "start": 94.023,
   "end": 96.098,
   "id": "c37"
  },
  {
   "text": "随后崩盘",
   "start": 96.118,
   "end": 97.086,
   "id": "c38"
  },
  {
   "text": "Nansen 统计",
   "start": 98.08,
   "end": 99.119,
   "id": "c39"
  },
  {
   "text": "亏损的钱包合计亏约 2.51 亿美元",
   "start": 99.318,
   "end": 102.309,
   "id": "c40"
  },
  {
   "text": "案件结果尚无定论",
   "start": 102.353,
   "end": 103.94,
   "id": "c41"
  },
  {
   "text": "CertiK 追踪到一个地址",
   "start": 104.924,
   "end": 106.891,
   "id": "c42"
  },
  {
   "text": "在 2023 年 8 到 10 月部署 979 个貔貅盘代币",
   "start": 106.959,
   "end": 110.951,
   "id": "c43"
  },
  {
   "text": "约每 30 分钟一个",
   "start": 111.019,
   "end": 112.403,
   "id": "c44"
  },
  {
   "text": "名人推广和涨幅",
   "start": 113.4,
   "end": 114.939,
   "id": "c45"
  },
  {
   "text": "都不是安全信号",
   "start": 114.995,
   "end": 116.212,
   "id": "c46"
  }
 ]
}