 "captions": [
  {
   "text": "换两种框架",
   "start": 1.55,
   "end": 2.656,
   "id": "c0"
  },
  {
   "text": "单点换了位置",
   "start": 2.732,
   "end": 3.891,
   "id": "c1"
  },
  {
   "text": "Corda 不广播交易",
   "start": 4.263,
   "end": 5.614,
   "id": "c2"
  },
  {
   "text": "数据只发给需要知道的参与方",
   "start": 5.844,
   "end": 8.132,
   "id": "c3"
  },
  {
   "text": "防止同一个状态被花两次",
   "start": 8.39,
   "end": 10.615,
   "id": "c4"
  },
  {
   "text": "靠的是公证人",
   "start": 10.821,
   "end": 12.29,
   "id": "c5"
  },
  {
   "text": "非验证型公证人只看输入引用",
   "start": 12.53,
   "end": 15.205,
   "id": "c6"
  },
  {
   "text": "看不到完整交易",
   "start": 15.31,
   "end": 16.624,
   "id": "c7"
  },
  {
   "text": "隐私更好",
   "start": 16.833,
   "end": 17.745,
   "id": "c8"
  },
  {
   "text": "可如果整个网络只有一个公证人",
   "start": 18.03,
   "end": 20.648,
   "id": "c9"
  },
  {
   "text": "运营方作恶",
   "start": 20.904,
   "end": 21.907,
   "id": "c10"
  },
  {
   "text": "就能给同一个状态签两次",
   "start": 22.037,
   "end": 24.284,
   "id": "c11"
  },
  {
   "text": "造成双花",
   "start": 24.469,
   "end": 25.629,
   "id": "c12"
  },
  {
   "text": "防御是改成集群",
   "start": 25.85,
   "end": 27.547,
   "id": "c13"
  },
  {
   "text": "分给不同的运营方",
   "start": 27.567,
   "end": 29.053,
   "id": "c14"
  },
  {
   "text": "节点之间协商时",
   "start": 29.35,
   "end": 30.798,
   "id": "c15"
  },
  {
   "text": "对方发来的数据",
   "start": 30.986,
   "end": 32.265,
   "id": "c16"
  },
  {
   "text": "要先校验 再使用",
   "start": 32.296,
   "end": 33.931,
   "id": "c17"
  },
  {
   "text": "合约代码作为附件随交易分发",
   "start": 34.21,
   "end": 37.164,
   "id": "c18"
  },
  {
   "text": "always-accept 这种约束只用于测试",
   "start": 37.414,
   "end": 40.605,
   "id": "c19"
  },
  {
   "text": "生产环境不能用",
   "start": 40.666,
   "end": 42.022,
   "id": "c20"
  },
  {
   "text": "再看 Besu",
   "start": 42.27,
   "end": 43.136,
   "id": "c21"
  },
  {
   "text": "2026 年 9 月",
   "start": 43.476,
   "end": 44.854,
   "id": "c22"
  },
  {
   "text": "Besu 公布了一项 QBFT 漏洞",
   "start": 45.071,
   "end": 47.77,
   "id": "c23"
  },
  {
   "text": "启用 Shanghai 及之后的分叉",
   "start": 47.99,
   "end": 50.374,
   "id": "c24"
  },
  {
   "text": "一名拜占庭验证者",
   "start": 50.582,
   "end": 52.158,
   "id": "c25"
  },
  {
   "text": "能注入未经授权的提款",
   "start": 52.253,
   "end": 54.159,
   "id": "c26"
  },
  {
   "text": "诚实的验证者照常执行",
   "start": 54.37,
   "end": 56.684,
   "id": "c27"
  },
  {
   "text": "照常确定",
   "start": 56.753,
   "end": 57.621,
   "id": "c28"
  },
  {
   "text": "原生币凭空多了出来",
   "start": 58.035,
   "end": 59.99,
   "id": "c29"
  },
  {
   "text": "4 个验证者",
   "start": 60.27,
   "end": 61.384,
   "id": "c30"
  },
  {
   "text": "按规范只容忍 1 个作恶",
   "start": 61.611,
   "end": 63.687,
   "id": "c31"
  },
  {
   "text": "可这一次",
   "start": 64.028,
   "end": 64.813,
   "id": "c32"
  },
  {
   "text": "诚实节点的验证规则本身缺了一项",
   "start": 65.154,
   "end": 68.184,
   "id": "c33"
  },
  {
   "text": "一名验证者就够了",
   "start": 68.671,
   "end": 70.104,
   "id": "c34"
  },
  {
   "text": "合同能让你事后追责",
   "start": 70.31,
   "end": 72.534,
   "id": "c35"
  },
  {
   "text": "却拦不住状态被写错",
   "start": 72.667,
   "end": 74.588,
   "id": "c36"
  },
  {
   "text": "同一时期的另一项公告里",
   "start": 74.946,
   "end": 76.958,
   "id": "c37"
  },
  {
   "text": "能连上足够多验证者端口的节点",
   "start": 77.232,
   "end": 79.961,
   "id": "c38"
  },
  {
   "text": "用大体积提案",
   "start": 80.031,
   "end": 81.208,
   "id": "c39"
  },
  {
   "text": "就能阻止网络最终确定",
   "start": 81.369,
   "end": 83.352,
   "id": "c40"
  },
  {
   "text": "所以 P2P 监听也是攻击面",
   "start": 83.727,
   "end": 86.257,
   "id": "c41"
  },
  {
   "text": "要在网络层限制谁能连到验证者",
   "start": 86.501,
   "end": 89.506,
   "id": "c42"
  },
  {
   "text": "Besu 的本地准入规则只管本节点",
   "start": 89.87,
   "end": 92.995,
   "id": "c43"
  },
  {
   "text": "每个成员都要配置",
   "start": 93.133,
   "end": 94.712,
   "id": "c44"
  },
  {
   "text": "并且核对一致",
   "start": 94.925,
   "end": 96.172,
   "id": "c45"
  },
  {
   "text": "还有一种风险",
   "start": 96.39,
   "end": 97.623,
   "id": "c46"
  },
  {
   "text": "没有漏洞也会发生",
   "start": 97.812,
   "end": 99.82,
   "id": "c47"
  },
  {
   "text": "GoQuorum 的仓库已经归档",
   "start": 100.149,
   "end": 102.089,
   "id": "c48"
  },
  {
   "text": "Tessera 已经弃用",
   "start": 102.201,
   "end": 103.584,
   "id": "c49"
  },
  {
   "text": "还在用它们的网络",
   "start": 103.87,
   "end": 105.296,
   "id": "c50"
  },
  {
   "text": "从此没有上游的安全修复",
   "start": 105.345,
   "end": 107.597,
   "id": "c51"
  },
  {
   "text": "依赖这些功能的网络",
   "start": 107.85,
   "end": 109.388,
   "id": "c52"
  },
  {
   "text": "只能自己维护",
   "start": 109.454,
   "end": 110.717,
   "id": "c53"
  },
  {
   "text": "或者尽快迁移",
   "start": 110.779,
   "end": 112.18,
   "id": "c54"
  }
 ]
