 "captions": [
  {
   "text": "最后 今天就能做的事",
   "start": 1.55,
   "end": 3.569,
   "id": "c0"
  },
  {
   "text": "运营联盟链的人",
   "start": 3.85,
   "end": 5.311,
   "id": "c1"
  },
  {
   "text": "写下每项安全假设依赖哪几家组织",
   "start": 5.55,
   "end": 8.658,
   "id": "c2"
  },
  {
   "text": "不要只写成员可信",
   "start": 8.882,
   "end": 10.504,
   "id": "c3"
  },
  {
   "text": "写链码的人",
   "start": 10.79,
   "end": 11.79,
   "id": "c4"
  },
  {
   "text": "查一遍本地时间和随机数",
   "start": 11.81,
   "end": 13.828,
   "id": "c5"
  },
  {
   "text": "再给低熵的私有数据加盐",
   "start": 14.155,
   "end": 16.22,
   "id": "c6"
  },
  {
   "text": "选框架的人",
   "start": 16.45,
   "end": 17.847,
   "id": "c7"
  },
  {
   "text": "先核对它还有没有人维护",
   "start": 17.941,
   "end": 20.155,
   "id": "c8"
  },
  {
   "text": "作为用户",
   "start": 20.43,
   "end": 21.282,
   "id": "c9"
  },
  {
   "text": "听到上链了",
   "start": 21.328,
   "end": 22.55,
   "id": "c10"
  },
  {
   "text": "不可篡改",
   "start": 22.678,
   "end": 23.643,
   "id": "c11"
  },
  {
   "text": "先问三个问题",
   "start": 23.86,
   "end": 25.127,
   "id": "c12"
  },
  {
   "text": "谁能写 谁能看",
   "start": 25.37,
   "end": 27.336,
   "id": "c13"
  },
  {
   "text": "谁能改规则",
   "start": 27.424,
   "end": 28.815,
   "id": "c14"
  },
  {
   "text": "你的个人数据写进联盟链之前",
   "start": 29.207,
   "end": 31.613,
   "id": "c15"
  },
  {
   "text": "问清怎么删除",
   "start": 31.686,
   "end": 32.966,
   "id": "c16"
  },
  {
   "text": "怎么更正",
   "start": 33.025,
   "end": 33.734,
   "id": "c17"
  },
  {
   "text": "业务伙伴的联盟链",
   "start": 34.05,
   "end": 35.534,
   "id": "c18"
  },
  {
   "text": "不等于公开可查",
   "start": 35.558,
   "end": 36.968,
   "id": "c19"
  },
  {
   "text": "请对方拿出公链锚定或审计报告",
   "start": 37.189,
   "end": 40.004,
   "id": "c20"
  },
  {
   "text": "回到开头的问题",
   "start": 40.27,
   "end": 41.621,
   "id": "c21"
  },
  {
   "text": "只让熟人进门的区块链",
   "start": 41.85,
   "end": 44.07,
   "id": "c22"
  },
  {
   "text": "风险在门里面",
   "start": 44.324,
   "end": 46.019,
   "id": "c23"
  },
  {
   "text": "在发证书的人",
   "start": 46.23,
   "end": 47.487,
   "id": "c24"
  },
  {
   "text": "拿管理员密钥的人",
   "start": 47.648,
   "end": 49.179,
   "id": "c25"
  },
  {
   "text": "达到门槛的几家成员",
   "start": 49.328,
   "end": 51.248,
   "id": "c26"
  },
  {
   "text": "还有没人维护的软件上",
   "start": 51.391,
   "end": 53.533,
   "id": "c27"
  },
  {
   "text": "门禁只回答了谁能进来",
   "start": 53.81,
   "end": 56.178,
   "id": "c28"
  },
  {
   "text": "安全还取决于进来的人能做什么",
   "start": 56.425,
   "end": 59.631,
   "id": "c29"
  },
  {
   "text": "规则本身有没有写对",
   "start": 59.703,
   "end": 61.551,
   "id": "c30"
  },
  {
   "text": "这个答案成立的前提",
   "start": 61.884,
   "end": 63.448,
   "id": "c31"
  },
  {
   "text": "是把每一个单点写下来",
   "start": 63.523,
   "end": 65.568,
   "id": "c32"
  },
  {
   "text": "分给不同的组织",
   "start": 65.664,
   "end": 67.025,
   "id": "c33"
  },
  {
   "text": "并且定期演练",
   "start": 67.156,
   "end": 68.587,
   "id": "c34"
  },
  {
   "text": "许可链没有消灭信任",
   "start": 68.81,
   "end": 70.921,
   "id": "c35"
  },
  {
   "text": "只是把信任交给了具体的机构和人",
   "start": 71.097,
   "end": 74.153,
   "id": "c36"
  },
  {
   "text": "这个系列就到这里",
   "start": 74.487,
   "end": 75.825,
   "id": "c37"
  }
 ]
}