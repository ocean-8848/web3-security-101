 "captions": [
  {
   "text": "许可链最大的风险",
   "start": 1.55,
   "end": 3.27,
   "id": "c0"
  },
  {
   "text": "常常在流程里",
   "start": 3.34,
   "end": 4.728,
   "id": "c1"
  },
  {
   "text": "第一处 根 CA",
   "start": 5.068,
   "end": 7.139,
   "id": "c2"
  },
  {
   "text": "根私钥放在在线服务器上",
   "start": 7.529,
   "end": 9.73,
   "id": "c3"
  },
  {
   "text": "一旦被攻破",
   "start": 9.964,
   "end": 10.99,
   "id": "c4"
  },
  {
   "text": "攻击者就能签发任意身份",
   "start": 11.167,
   "end": 13.57,
   "id": "c5"
  },
  {
   "text": "控制是根 CA 离线",
   "start": 13.909,
   "end": 15.631,
   "id": "c6"
  },
  {
   "text": "私钥放进 HSM",
   "start": 15.761,
   "end": 17.473,
   "id": "c7"
  },
  {
   "text": "日常签发交给中间 CA",
   "start": 17.743,
   "end": 19.635,
   "id": "c8"
  },
  {
   "text": "节点和管理员的私钥",
   "start": 19.963,
   "end": 22.735,
   "id": "c9"
  },
  {
   "text": "也放进 HSM 或 KMS",
   "start": 22.755,
   "end": 24.472,
   "id": "c10"
  },
  {
   "text": "身份 CA 和 TLS CA",
   "start": 24.73,
   "end": 27.429,
   "id": "c11"
  },
  {
   "text": "也要分开",
   "start": 27.449,
   "end": 28.682,
   "id": "c12"
  },
  {
   "text": "第二处 管理员集中",
   "start": 29.044,
   "end": 30.757,
   "id": "c13"
  },
  {
   "text": "一家技术服务商",
   "start": 31.103,
   "end": 32.441,
   "id": "c14"
  },
  {
   "text": "替好几家组织拿着管理员证书",
   "start": 32.618,
   "end": 35.178,
   "id": "c15"
  },
  {
   "text": "它一出事",
   "start": 35.39,
   "end": 36.351,
   "id": "c16"
  },
  {
   "text": "好几家就同时失守",
   "start": 36.54,
   "end": 38.283,
   "id": "c17"
  },
  {
   "text": "控制是各家自持密钥",
   "start": 38.588,
   "end": 40.453,
   "id": "c18"
  },
  {
   "text": "服务商只拿受限的运维权限",
   "start": 40.785,
   "end": 42.95,
   "id": "c19"
  },
  {
   "text": "第三处 配置更新和成员退出",
   "start": 43.281,
   "end": 46.12,
   "id": "c20"
  },
  {
   "text": "改通道策略或成员名单",
   "start": 46.463,
   "end": 48.516,
   "id": "c21"
  },
  {
   "text": "要多家组织签名",
   "start": 48.716,
   "end": 50.183,
   "id": "c22"
  },
  {
   "text": "变更留痕",
   "start": 50.38,
   "end": 51.327,
   "id": "c23"
  },
  {
   "text": "成员退出时",
   "start": 51.647,
   "end": 52.661,
   "id": "c24"
  },
  {
   "text": "要吊销证书",
   "start": 52.726,
   "end": 53.776,
   "id": "c25"
  },
  {
   "text": "修改策略",
   "start": 53.864,
   "end": 54.817,
   "id": "c26"
  },
  {
   "text": "再评估它手里已经拿到的数据",
   "start": 55.039,
   "end": 57.611,
   "id": "c27"
  },
  {
   "text": "Fabric 文档提醒",
   "start": 57.85,
   "end": 59.25,
   "id": "c28"
  },
  {
   "text": "成员身份不会自动过期",
   "start": 59.443,
   "end": 61.356,
   "id": "c29"
  },
  {
   "text": "只能吊销",
   "start": 61.432,
   "end": 62.311,
   "id": "c30"
  },
  {
   "text": "所以吊销流程",
   "start": 62.647,
   "end": 63.991,
   "id": "c31"
  },
  {
   "text": "要提前演练",
   "start": 64.011,
   "end": 65.193,
   "id": "c32"
  },
  {
   "text": "第四处 成员共谋",
   "start": 65.49,
   "end": 67.78,
   "id": "c33"
  },
  {
   "text": "达到背书门槛的几家成员",
   "start": 68.123,
   "end": 70.259,
   "id": "c34"
  },
  {
   "text": "可以写入虚假的业务状态",
   "start": 70.425,
   "end": 72.754,
   "id": "c35"
  },
  {
   "text": "对策是外部锚定",
   "start": 73.073,
   "end": 74.754,
   "id": "c36"
  },
  {
   "text": "定期把账本摘要写到公链",
   "start": 74.918,
   "end": 77.239,
   "id": "c37"
  },
  {
   "text": "或者交给第三方保存",
   "start": 77.359,
   "end": 78.945,
   "id": "c38"
  },
  {
   "text": "它能证明历史没被改写",
   "start": 79.19,
   "end": 81.523,
   "id": "c39"
  },
  {
   "text": "却不能证明数据本身是真的",
   "start": 81.865,
   "end": 84.966,
   "id": "c40"
  },
  {
   "text": "最后 所有节点放在同一个云账户里",
   "start": 85.25,
   "end": 88.444,
   "id": "c41"
  },
  {
   "text": "也是单点",
   "start": 88.502,
   "end": 89.339,
   "id": "c42"
  },
  {
   "text": "要分账户 分地域",
   "start": 89.555,
   "end": 91.064,
   "id": "c43"
  },
  {
   "text": "分运营方",
   "start": 91.16,
   "end": 91.993,
   "id": "c44"
  }
 ]
}