 "captions": [
  {
   "text": "一个联盟链网络",
   "start": 1.648,
   "end": 2.972,
   "id": "c0"
  },
  {
   "text": "所有节点都由成员机构运营",
   "start": 3.076,
   "end": 5.544,
   "id": "c1"
  },
  {
   "text": "每个参与者",
   "start": 6.524,
   "end": 7.658,
   "id": "c2"
  },
  {
   "text": "都持有一张有效的证书",
   "start": 7.678,
   "end": 9.372,
   "id": "c3"
  },
  {
   "text": "没有匿名的陌生人",
   "start": 10.368,
   "end": 11.835,
   "id": "c4"
  },
  {
   "text": "也没有人能靠算力闯进来",
   "start": 11.927,
   "end": 13.728,
   "id": "c5"
  },
  {
   "text": "可就在这样的网络里",
   "start": 14.716,
   "end": 16.255,
   "id": "c6"
  },
  {
   "text": "账本分叉了",
   "start": 16.382,
   "end": 17.505,
   "id": "c7"
  },
  {
   "text": "Hyperledger Fabric",
   "start": 18.488,
   "end": 19.872,
   "id": "c8"
  },
  {
   "text": "公布过这样一个漏洞",
   "start": 19.892,
   "end": 21.181,
   "id": "c9"
  },
  {
   "text": "攻击者能把一个区块里的交易",
   "start": 22.164,
   "end": 24.156,
   "id": "c10"
  },
  {
   "text": "重新组合",
   "start": 24.176,
   "end": 25.238,
   "id": "c11"
  },
  {
   "text": "区块哈希没有变",
   "start": 26.224,
   "end": 27.775,
   "id": "c12"
  },
  {
   "text": "可是不同的节点",
   "start": 28.748,
   "end": 29.989,
   "id": "c13"
  },
  {
   "text": "从同一个区块里",
   "start": 30.093,
   "end": 31.453,
   "id": "c14"
  },
  {
   "text": "解析出了不同的交易",
   "start": 31.581,
   "end": 33.049,
   "id": "c15"
  },
  {
   "text": "收到不同版本的节点",
   "start": 34.032,
   "end": 35.618,
   "id": "c16"
  },
  {
   "text": "各自写入世界状态",
   "start": 35.77,
   "end": 37.333,
   "id": "c17"
  },
  {
   "text": "两份账本从此对不上",
   "start": 37.424,
   "end": 39.321,
   "id": "c18"
  },
  {
   "text": "修复的方向是",
   "start": 40.3,
   "end": 41.636,
   "id": "c19"
  },
  {
   "text": "让哈希的编码没有歧义",
   "start": 41.681,
   "end": 43.386,
   "id": "c20"
  },
  {
   "text": "同一串字节",
   "start": 43.645,
   "end": 44.755,
   "id": "c21"
  },
  {
   "text": "只能读出同一组交易",
   "start": 44.812,
   "end": 46.303,
   "id": "c22"
  },
  {
   "text": "这里没有人偷到私钥",
   "start": 47.288,
   "end": 48.839,
   "id": "c23"
  },
  {
   "text": "也没有人攻破共识",
   "start": 48.942,
   "end": 50.398,
   "id": "c24"
  },
  {
   "text": "门禁再严",
   "start": 51.396,
   "end": 52.506,
   "id": "c25"
  },
  {
   "text": "挡住的也只是外人",
   "start": 52.634,
   "end": 54.208,
   "id": "c26"
  },
  {
   "text": "那么 一个只让熟人进门的区块链",
   "start": 55.192,
   "end": 57.933,
   "id": "c27"
  },
  {
   "text": "风险到底在哪里",
   "start": 58.096,
   "end": 59.385,
   "id": "c28"
  },
  {
   "text": "谁能写 谁能看",
   "start": 60.66,
   "end": 62.461,
   "id": "c29"
  },
  {
   "text": "谁能改规则",
   "start": 62.672,
   "end": 63.794,
   "id": "c30"
  },
  {
   "text": "我们从一栋刷卡进门的写字楼说起",
   "start": 65.048,
   "end": 67.444,
   "id": "c31"
  }
 ]
