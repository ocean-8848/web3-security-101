 "captions": [
  {
   "text": "先给一句准确的说法",
   "start": 1.648,
   "end": 3.246,
   "id": "c0"
  },
  {
   "text": "许可链 只让获得授权的参与者",
   "start": 4.244,
   "end": 6.997,
   "id": "c1"
  },
  {
   "text": "读写或出块",
   "start": 7.077,
   "end": 8.426,
   "id": "c2"
  },
  {
   "text": "由多家组织共同治理的许可链",
   "start": 9.408,
   "end": 11.828,
   "id": "c3"
  },
  {
   "text": "叫联盟链",
   "start": 11.86,
   "end": 12.887,
   "id": "c4"
  },
  {
   "text": "它把谁能参与",
   "start": 13.876,
   "end": 15.106,
   "id": "c5"
  },
  {
   "text": "从密码学和经济的问题",
   "start": 15.126,
   "end": 17.094,
   "id": "c6"
  },
  {
   "text": "变成了身份和治理的问题",
   "start": 17.114,
   "end": 18.95,
   "id": "c7"
  },
  {
   "text": "攻击者不再需要多数算力",
   "start": 19.952,
   "end": 21.943,
   "id": "c8"
  },
  {
   "text": "一张有效证书",
   "start": 22.932,
   "end": 24.34,
   "id": "c9"
  },
  {
   "text": "一把管理员密钥",
   "start": 24.467,
   "end": 25.768,
   "id": "c10"
  },
  {
   "text": "或者几家成员共谋 就够了",
   "start": 25.836,
   "end": 28.125,
   "id": "c11"
  },
  {
   "text": "打个比方",
   "start": 29.104,
   "end": 30.047,
   "id": "c12"
  },
  {
   "text": "公链像公共广场",
   "start": 30.175,
   "end": 31.643,
   "id": "c13"
  },
  {
   "text": "谁都能进",
   "start": 31.806,
   "end": 32.75,
   "id": "c14"
  },
  {
   "text": "靠规则和押金维持秩序",
   "start": 32.77,
   "end": 34.833,
   "id": "c15"
  },
  {
   "text": "许可链像一栋写字楼",
   "start": 35.828,
   "end": 37.593,
   "id": "c16"
  },
  {
   "text": "进门要刷工牌",
   "start": 37.72,
   "end": 38.998,
   "id": "c17"
  },
  {
   "text": "陌生人大多进不来",
   "start": 39.984,
   "end": 41.594,
   "id": "c18"
  },
  {
   "text": "可发工牌的前台",
   "start": 41.757,
   "end": 43.237,
   "id": "c19"
  },
  {
   "text": "拿着万能钥匙的物业",
   "start": 43.353,
   "end": 44.868,
