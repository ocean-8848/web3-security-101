 "captions": [
  {
   "text": "换两种框架",
   "start": 1.648,
   "end": 2.889,
   "id": "c0"
  },
  {
   "text": "单点换了位置",
   "start": 3.064,
   "end": 4.151,
   "id": "c1"
  },
  {
   "text": "Corda 不广播交易",
   "start": 5.132,
   "end": 6.421,
   "id": "c2"
  },
  {
   "text": "数据只发给需要知道的参与方",
   "start": 6.632,
   "end": 8.873,
   "id": "c3"
  },
  {
   "text": "防止同一个状态被花两次",
   "start": 9.84,
   "end": 12.057,
   "id": "c4"
  },
  {
   "text": "靠的是公证人",
   "start": 12.113,
   "end": 13.343,
   "id": "c5"
  },
  {
   "text": "非验证型公证人只看输入引用",
   "start": 14.332,
   "end": 17.156,
   "id": "c6"
  },
  {
   "text": "看不到完整交易",
   "start": 17.224,
   "end": 18.514,
   "id": "c7"
  },
  {
   "text": "隐私更好",
   "start": 18.701,
   "end": 19.621,
   "id": "c8"
  },
  {
   "text": "可如果整个网络只有一个公证人",
   "start": 20.6,
   "end": 22.996,
   "id": "c9"
  },
  {
   "text": "运营方作恶",
   "start": 23.195,
   "end": 24.234,
   "id": "c10"
  },
  {
   "text": "就能给同一个状态签两次",
   "start": 24.254,
   "end": 26.115,
   "id": "c11"
  },
  {
   "text": "造成双花",
   "start": 26.159,
   "end": 27.055,
   "id": "c12"
  },
  {
   "text": "防御是改成集群",
   "start": 28.044,
   "end": 29.654,
   "id": "c13"
  },
  {
   "text": "分给不同的运营方",
   "start": 29.71,
   "end": 31.237,
   "id": "c14"
  },
  {
   "text": "节点之间协商时",
   "start": 32.224,
   "end": 33.727,
   "id": "c15"
  },
  {
   "text": "对方发来的数据",
   "start": 33.855,
   "end": 35.108,
   "id": "c16"
  },
  {
   "text": "要先校验 再使用",
   "start": 35.176,
   "end": 36.929,
   "id": "c17"
  },
  {
   "text": "合约代码作为附件随交易分发",
   "start": 37.916,
   "end": 40.121,
   "id": "c18"
  },
  {
   "text": "always-accept 这种约束只用于测试",
   "start": 40.261,
   "end": 43.003,
   "id": "c19"
  },
  {
   "text": "生产环境不能用",
   "start": 43.023,
   "end": 44.407,
   "id": "c20"
  },
  {
   "text": "再看 Besu",
   "start": 45.384,
   "end": 46.577,
   "id": "c21"
  },
  {
   "text": "2026 年 9 月",
   "start": 47.548,
   "end": 48.837,
   "id": "c22"
  },
  {
   "text": "Besu 公布了一项 QBFT 漏洞",
   "start": 48.94,
   "end": 51.444,
   "id": "c23"
  },
  {
   "text": "启用 Shanghai 及之后的分叉",
   "start": 52.424,
   "end": 54.486,
   "id": "c24"
  },
  {
   "text": "一名拜占庭验证者",
   "start": 54.614,
   "end": 56.213,
   "id": "c25"
  },
  {
   "text": "能注入未经授权的提款",
   "start": 56.233,
   "end": 58.082,
   "id": "c26"
  },
  {
   "text": "诚实的验证者照常执行",
   "start": 59.076,
   "end": 61.21,
   "id": "c27"
  },
  {
   "text": "照常确定",
   "start": 61.385,
   "end": 62.388,
   "id": "c28"
  },
  {
   "text": "原生币凭空多了出来",
   "start": 62.433,
   "end": 64.115,
   "id": "c29"
  },
  {
   "text": "4 个验证者",
   "start": 65.104,
   "end": 66.214,
   "id": "c30"
  },
  {
   "text": "按规范只容忍 1 个作恶",
   "start": 66.354,
   "end": 68.416,
   "id": "c31"
  },
  {
   "text": "可这一次",
   "start": 69.404,
   "end": 70.252,
   "id": "c32"
  },
  {
   "text": "诚实节点的验证规则本身缺了一项",
   "start": 70.356,
   "end": 73.216,
   "id": "c33"
  },
  {
   "text": "一名验证者就够了",
   "start": 73.356,
   "end": 74.693,
   "id": "c34"
  },
  {
   "text": "合同能让你事后追责",
   "start": 75.648,
   "end": 77.282,
   "id": "c35"
  },
  {
   "text": "却拦不住状态被写错",
   "start": 77.374,
   "end": 78.865,
   "id": "c36"
  },
  {
   "text": "同一时期的另一项公告里",
   "start": 79.852,
   "end": 81.557,
   "id": "c37"
  },
  {
   "text": "能连上足够多验证者端口的节点",
   "start": 81.744,
   "end": 84.141,
   "id": "c38"
  },
  {
   "text": "用大体积提案",
   "start": 84.173,
   "end": 85.391,
   "id": "c39"
  },
  {
   "text": "就能阻止网络最终确定",
   "start": 85.411,
   "end": 87.426,
   "id": "c40"
  },
  {
   "text": "所以 P2P 监听也是攻击面",
   "start": 88.424,
   "end": 90.927,
   "id": "c41"
  },
  {
   "text": "要在网络层限制谁能连到验证者",
   "start": 91.055,
   "end": 93.713,
   "id": "c42"
  },
  {
   "text": "Besu 的本地准入规则只管本节点",
   "start": 94.692,
   "end": 97.504,
   "id": "c43"
  },
  {
   "text": "每个成员都要配置",
   "start": 97.644,
   "end": 99.076,
   "id": "c44"
  },
  {
   "text": "并且核对一致",
   "start": 99.096,
   "end": 100.385,
   "id": "c45"
  },
  {
   "text": "还有一种风险",
   "start": 101.368,
   "end": 102.478,
   "id": "c46"
  },
  {
   "text": "没有漏洞也会发生",
   "start": 102.606,
   "end": 103.99,
   "id": "c47"
  },
  {
   "text": "GoQuorum 的仓库已经归档",
   "start": 104.972,
   "end": 106.952,
   "id": "c48"
  },
  {
   "text": "Tessera 已经弃用",
   "start": 106.972,
   "end": 108.38,
   "id": "c49"
  },
  {
   "text": "还在用它们的网络",
   "start": 109.368,
   "end": 110.859,
   "id": "c50"
  },
  {
   "text": "从此没有上游的安全修复",
   "start": 110.939,
   "end": 112.883,
   "id": "c51"
  },
  {
   "text": "依赖这些功能的网络",
   "start": 113.884,
   "end": 115.482,
   "id": "c52"
  },
  {
   "text": "只能自己维护",
   "start": 115.515,
   "end": 116.697,
   "id": "c53"
  },
  {
   "text": "或者尽快迁移",
   "start": 116.717,
   "end": 117.994,
   "id": "c54"
  }
 ]
