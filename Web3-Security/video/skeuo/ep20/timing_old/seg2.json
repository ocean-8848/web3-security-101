 "captions": [
  {
   "text": "先给准确的说法",
   "start": 1.55,
   "end": 2.807,
   "id": "c0"
  },
  {
   "text": "用户不读合约",
   "start": 3.05,
   "end": 4.447,
   "id": "c1"
  },
  {
   "text": "用户读页面",
   "start": 4.684,
   "end": 5.869,
   "id": "c2"
  },
  {
   "text": "页面告诉你",
   "start": 6.243,
   "end": 7.169,
   "id": "c3"
  },
  {
   "text": "这笔交易是什么",
   "start": 7.189,
   "end": 8.449,
   "id": "c4"
  },
  {
   "text": "钱包再把页面构造好的交易",
   "start": 8.69,
   "end": 11.075,
   "id": "c5"
  },
  {
   "text": "交给你签名",
   "start": 11.175,
   "end": 12.181,
   "id": "c6"
  },
  {
   "text": "攻击者改掉页面",
   "start": 12.43,
   "end": 13.828,
   "id": "c7"
  },
  {
   "text": "你就会对着一个审计过的合约",
   "start": 14.022,
   "end": 16.164,
   "id": "c8"
  },
  {
   "text": "签下攻击交易",
   "start": 16.184,
   "end": 17.301,
   "id": "c9"
  },
  {
   "text": "前端 就是浏览器里的网页",
   "start": 17.703,
   "end": 20.167,
   "id": "c10"
  },
  {
   "text": "和它加载的全部脚本",
   "start": 20.303,
   "end": 22.173,
   "id": "c11"
  },
  {
   "text": "打个比方",
   "start": 22.564,
   "end": 23.231,
   "id": "c12"
  },
  {
   "text": "银行柜台的玻璃上",
   "start": 23.693,
   "end": 25.023,
   "id": "c13"
  },
  {
   "text": "贴着收款账号",
   "start": 25.105,
   "end": 26.211,
   "id": "c14"
  },
  {
   "text": "金库 账本",
   "start": 26.45,
   "end": 27.854,
   "id": "c15"
  },
  {
   "text": "保安都没问题",
   "start": 27.874,
   "end": 29.182,
   "id": "c16"
  },
  {
   "text": "但有人夜里换了这张贴纸",
   "start": 29.811,
   "end": 32.095,
   "id": "c17"
  },
  {
   "text": "第二天 客户都把钱汇进新账号",
   "start": 32.445,
   "end": 35.427,
   "id": "c18"
  },
  {
   "text": "比喻在这里不成立",
   "start": 35.788,
   "end": 37.253,
   "id": "c19"
  },
  {
   "text": "换贴纸要进银行大厅",
   "start": 37.482,
   "end": 39.34,
   "id": "c20"
  },
  {
   "text": "改前端可以在千里之外完成",
   "start": 39.59,
   "end": 42.347,
   "id": "c21"
  },
  {
   "text": "而且能只对某一个客户显示假贴纸",
   "start": 42.544,
   "end": 45.804,
   "id": "c22"
  },
  {
   "text": "页面从源码到你的浏览器",
   "start": 46.05,
   "end": 48.456,
   "id": "c23"
  },
  {
   "text": "要经过一整串环节",
   "start": 48.585,
   "end": 50.355,
   "id": "c24"
  },
  {
   "text": "开发者的电脑",
   "start": 50.59,
   "end": 51.827,
   "id": "c25"
  },
  {
   "text": "代码仓库 依赖包 构建 托管 CDN",
   "start": 51.937,
   "end": 55.5,
   "id": "c26"
  },
  {
   "text": "最后是域名",
   "start": 55.52,
   "end": 57.039,
   "id": "c27"
  },
  {
   "text": "这一整串",
   "start": 57.29,
   "end": 58.227,
   "id": "c28"
  },
  {
   "text": "叫供应链",
   "start": 58.305,
   "end": 59.403,
   "id": "c29"
  },
  {
   "text": "任何一环被攻破",
   "start": 59.762,
   "end": 61.072,
   "id": "c30"
  },
  {
   "text": "结果都一样",
   "start": 61.099,
   "end": 61.94,
   "id": "c31"
  },
  {
   "text": "你的浏览器运行着攻击者的代码",
   "start": 62.213,
   "end": 64.531,
   "id": "c32"
  },
  {
   "text": "合约审计",
   "start": 64.77,
   "end": 65.812,
   "id": "c33"
  },
  {
   "text": "覆盖不到其中任何一环",
   "start": 65.98,
   "end": 67.675,
   "id": "c34"
  }
 ]
}