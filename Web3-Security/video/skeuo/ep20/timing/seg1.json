   "text": "浏览器没有任何警告",
   "start": 12.801,
   "end": 14.459,
   "id": "c6"
  },
  {
   "text": "页面请他授权",
   "start": 15.46,
   "end": 16.892,
   "id": "c7"
  },
  {
   "text": "他签了名",
   "start": 17.067,
   "end": 18.022,
   "id": "c8"
  },
  {
   "text": "签完之后",
   "start": 18.992,
   "end": 19.995,
   "id": "c9"
  },
  {
   "text": "他的代币被转走",
   "start": 20.099,
   "end": 21.34,
   "id": "c10"
  },
  {
   "text": "这一次 用户合计损失约 57 万美元",
   "start": 22.308,
   "end": 25.847,
   "id": "c11"
  },
  {
   "text": "Curve 的合约没有任何变化",
   "start": 26.848,
   "end": 28.946,
   "id": "c12"
  },
  {
   "text": "审计过的代码也没出错",
   "start": 29.145,
   "end": 30.815,
   "id": "c13"
  },
  {
   "text": "链上的一切都和昨天一样",
   "start": 30.895,
   "end": 32.815,
   "id": "c14"
  },
  {
   "text": "变的是页面",
   "start": 33.812,
   "end": 34.779,
   "id": "c15"
  },
  {
   "text": "那天 这个域名被解析到一个克隆的前端",
   "start": 35.904,
   "end": 39.276,
   "id": "c16"
  },
  {
   "text": "攻击者没碰合约",
   "start": 39.38,
   "end": 40.728,
   "id": "c17"
  },
  {
   "text": "他换掉的是页面",
   "start": 40.939,
   "end": 42.062,
   "id": "c18"
  },
  {
   "text": "先猜一道题",
   "start": 43.06,
   "end": 44.384,
   "id": "c19"
  },
  {
   "text": "域名是对的",
   "start": 45.368,
   "end": 46.407,
   "id": "c20"
  },
  {
   "text": "锁标志也在",
   "start": 46.475,
   "end": 47.859,
   "id": "c21"
  },
  {
   "text": "这能证明",
   "start": 48.07,
   "end": 48.978,
   "id": "c22"
  },
  {
   "text": "你看到的页面是真的吗",
   "start": 49.153,
   "end": 50.871,
   "id": "c23"
  },
  {
   "text": "先记住这个问题",
   "start": 52.132,
   "end": 53.575,
   "id": "c24"
  }
 ]
