 "lines": [
  {
   "id": "seg2-00",
   "text": "先给准确的说法。",
   "spoken": "先给准确的说法。",
   "src": "/Users/k/Workon/Learning/web3/web3-security-101/Web3-Security/video/skeuo/ep20/audio/lines/seg2-00.mp3",
   "start": 1.6,
   "dur": 2.232,
   "speechStart": 1.698,
   "speechEnd": 2.983
  },
  {
   "id": "seg2-01",
   "text": "用户不读合约，用户读页面。",
   "spoken": "用户不读合约，用户读页面。",
   "src": "/Users/k/Workon/Learning/web3/web3-security-101/Web3-Security/video/skeuo/ep20/audio/lines/seg2-01.mp3",
   "start": 4.052,
   "dur": 3.264,
   "speechStart": 4.15,
   "speechEnd": 6.483
  },
  {
   "id": "seg2-02",
   "text": "页面告诉你，这笔交易是什么。",
   "spoken": "页面告诉你，这笔交易是什么。",
   "src": "/Users/k/Workon/Learning/web3/web3-security-101/Web3-Security/video/skeuo/ep20/audio/lines/seg2-02.mp3",
   "start": 7.536,
   "dur": 3.024,
   "speechStart": 7.634,
   "speechEnd": 9.741
  },
  {
   "id": "seg2-03",
   "text": "钱包再把页面构造好的交易，交给你签名。",
   "spoken": "钱包再把页面构造好的交易，交给你签名。",
   "src": "/Users/k/Workon/Learning/web3/web3-security-101/Web3-Security/video/skeuo/ep20/audio/lines/seg2-03.mp3",
   "start": 10.78,
   "dur": 3.936,
   "speechStart": 10.878,
   "speechEnd": 13.866
  },
  {
   "id": "seg2-04",
   "text": "攻击者改掉页面，你就会对着一个审计过的合约，签下攻击交易。",
   "spoken": "攻击者改掉页面，你就会对着一个审计过的合约，签下攻击交易。",
   "src": "/Users/k/Workon/Learning/web3/web3-security-101/Web3-Security/video/skeuo/ep20/audio/lines/seg2-04.mp3",
   "start": 14.936,
   "dur": 5.568,
   "speechStart": 15.034,
   "speechEnd": 19.653
  },
  {
   "id": "seg2-05",
   "text": "前端，就是浏览器里的网页，和它加载的全部脚本。",
   "spoken": "前端，就是浏览器里的网页，和它加载的全部脚本。",
   "src": "/Users/k/Workon/Learning/web3/web3-security-101/Web3-Security/video/skeuo/ep20/audio/lines/seg2-05.mp3",
   "start": 20.724,
   "dur": 4.728,
   "speechStart": 20.822,
   "speechEnd": 24.619
  },
  {
   "id": "seg2-06",
   "text": "打个比方，银行柜台的玻璃上，贴着收款账号。",
   "spoken": "打个比方，银航柜台的玻璃上，贴着收款账号。",
   "src": "/Users/k/Workon/Learning/web3/web3-security-101/Web3-Security/video/skeuo/ep20/audio/lines/seg2-06.mp3",
   "start": 25.672,
   "dur": 4.464,
   "speechStart": 25.77,
   "speechEnd": 29.293
  },
  {
   "id": "seg2-07",
   "text": "金库、账本、保安都没问题，但有人夜里换了这张贴纸。",
   "spoken": "金库、账本、保安都没问题，但有人夜里换了这张贴纸。",
   "src": "/Users/k/Workon/Learning/web3/web3-security-101/Web3-Security/video/skeuo/ep20/audio/lines/seg2-07.mp3",
   "start": 30.356,
   "dur": 5.448,
   "speechStart": 30.454,
   "speechEnd": 34.954
  },
  {
   "id": "seg2-08",
   "text": "第二天，客户都把钱汇进新账号。",
   "spoken": "第二天，客户都把钱汇进新账号。",
   "src": "/Users/k/Workon/Learning/web3/web3-security-101/Web3-Security/video/skeuo/ep20/audio/lines/seg2-08.mp3",
   "start": 36.024,
   "dur": 3.576,
   "speechStart": 36.122,
   "speechEnd": 38.788
  },
  {
   "id": "seg2-09",
   "text": "比喻在这里不成立，换贴纸要进银行大厅。",
   "spoken": "比喻在这里不成立，换贴纸要进银航大厅。",
   "src": "/Users/k/Workon/Learning/web3/web3-security-101/Web3-Security/video/skeuo/ep20/audio/lines/seg2-09.mp3",
   "start": 39.82,
   "dur": 4.296,
   "speechStart": 39.918,
   "speechEnd": 43.275
  },
  {
   "id": "seg2-10",
   "text": "改前端可以在千里之外完成，而且能只对某一个客户显示假贴纸。",
   "spoken": "改前端可以在千里之外完成，而且能只对某一个客户显示假贴纸。",
   "src": "/Users/k/Workon/Learning/web3/web3-security-101/Web3-Security/video/skeuo/ep20/audio/lines/seg2-10.mp3",
   "start": 44.336,
   "dur": 6.072,
   "speechStart": 44.434,
   "speechEnd": 49.588
  },
  {
   "id": "seg2-11",
   "text": "页面从源码到你的浏览器，要经过一整串环节。",
   "spoken": "页面从源码到你的浏览器，要经过一整串环节。",
   "src": "/Users/k/Workon/Learning/web3/web3-security-101/Web3-Security/video/skeuo/ep20/audio/lines/seg2-11.mp3",
   "start": 50.628,
   "dur": 4.416,
   "speechStart": 50.726,
   "speechEnd": 54.19
  },
  {
   "id": "seg2-12",
   "text": "开发者的电脑、代码仓库、依赖包、构建、托管、CDN，最后是域名。",
   "spoken": "开发者的电脑、代码仓库、依赖包、构建、托管、CDN，最后是域名。",
   "src": "/Users/k/Workon/Learning/web3/web3-security-101/Web3-Security/video/skeuo/ep20/audio/lines/seg2-12.mp3",
   "start": 55.264,
   "dur": 6.816,
   "speechStart": 55.362,
   "speechEnd": 61.231
  },
  {
   "id": "seg2-13",
   "text": "这一整串，叫供应链。",
   "spoken": "这一整串，叫公应链。",
   "src": "/Users/k/Workon/Learning/web3/web3-security-101/Web3-Security/video/skeuo/ep20/audio/lines/seg2-13.mp3",
   "start": 62.3,
   "dur": 2.928,
   "speechStart": 62.398,
   "speechEnd": 64.386
  },
  {
   "id": "seg2-14",
   "text": "任何一环被攻破，结果都一样，你的浏览器运行着攻击者的代码。",
   "spoken": "任何一环被攻破，结果都一样，你的浏览器运行着攻击者的代码。",
   "src": "/Users/k/Workon/Learning/web3/web3-security-101/Web3-Security/video/skeuo/ep20/audio/lines/seg2-14.mp3",
   "start": 65.448,
   "dur": 6.024,
   "speechStart": 65.546,
   "speechEnd": 70.641
  },
  {
   "id": "seg2-15",
   "text": "合约审计，覆盖不到其中任何一环。",
   "spoken": "合约审计，覆盖不到其中任何一环。",
