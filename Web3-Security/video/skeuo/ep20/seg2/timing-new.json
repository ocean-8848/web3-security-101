 "captions": [
  {
   "text": "先给准确的说法",
   "start": 1.648,
   "end": 3.103,
   "id": "c0"
  },
  {
   "text": "用户不读合约",
   "start": 4.1,
   "end": 5.401,
   "id": "c1"
  },
  {
   "text": "用户读页面",
   "start": 5.433,
   "end": 6.603,
   "id": "c2"
  },
  {
   "text": "页面告诉你",
   "start": 7.584,
   "end": 8.694,
   "id": "c3"
  },
  {
   "text": "这笔交易是什么",
   "start": 8.798,
   "end": 9.861,
   "id": "c4"
  },
  {
   "text": "钱包再把页面构造好的交易",
   "start": 10.828,
   "end": 12.879,
   "id": "c5"
  },
  {
   "text": "交给你签名",
   "start": 13.018,
   "end": 13.986,
   "id": "c6"
  },
  {
   "text": "攻击者改掉页面",
   "start": 14.984,
   "end": 16.427,
   "id": "c7"
  },
  {
   "text": "你就会对着一个审计过的合约",
   "start": 16.555,
   "end": 18.38,
   "id": "c8"
  },
  {
   "text": "签下攻击交易",
   "start": 18.4,
   "end": 19.773,
   "id": "c9"
  },
  {
   "text": "前端 就是浏览器里的网页",
   "start": 20.772,
   "end": 23.037,
   "id": "c10"
  },
  {
   "text": "和它加载的全部脚本",
   "start": 23.153,
   "end": 24.739,
   "id": "c11"
  },
  {
   "text": "打个比方",
   "start": 25.72,
   "end": 26.652,
   "id": "c12"
  },
  {
   "text": "银行柜台的玻璃上",
   "start": 26.815,
   "end": 28.176,
   "id": "c13"
  },
  {
   "text": "贴着收款账号",
   "start": 28.196,
   "end": 29.413,
   "id": "c14"
  },
  {
   "text": "金库 账本",
   "start": 30.404,
   "end": 31.883,
   "id": "c15"
  },
  {
   "text": "保安都没问题",
   "start": 31.951,
   "end": 32.966,
   "id": "c16"
  },
  {
   "text": "但有人夜里换了这张贴纸",
   "start": 33.177,
   "end": 35.074,
   "id": "c17"
  },
  {
   "text": "第二天 客户都把钱汇进新账号",
   "start": 36.072,
   "end": 38.908,
   "id": "c18"
  },
  {
   "text": "比喻在这里不成立",
   "start": 39.868,
   "end": 41.288,
   "id": "c19"
  },
  {
   "text": "换贴纸要进银行大厅",
   "start": 41.391,
   "end": 43.395,
   "id": "c20"
  },
  {
   "text": "改前端可以在千里之外完成",
   "start": 44.384,
   "end": 46.696,
   "id": "c21"
  },
  {
   "text": "而且能只对某一个客户显示假贴纸",
   "start": 46.848,
   "end": 49.708,
   "id": "c22"
  },
  {
   "text": "页面从源码到你的浏览器",
   "start": 50.676,
   "end": 52.584,
   "id": "c23"
  },
  {
   "text": "要经过一整串环节",
   "start": 52.735,
   "end": 54.31,
   "id": "c24"
  },
  {
   "text": "开发者的电脑",
   "start": 55.312,
   "end": 56.386,
   "id": "c25"
  },
  {
   "text": "代码仓库 依赖包 构建 托管 CDN",
   "start": 56.419,
   "end": 60.327,
   "id": "c26"
  },
  {
   "text": "最后是域名",
   "start": 60.347,
   "end": 61.351,
   "id": "c27"
  },
  {
   "text": "这一整串",
   "start": 62.348,
   "end": 63.422,
   "id": "c28"
  },
  {
   "text": "叫供应链",
   "start": 63.61,
   "end": 64.506,
   "id": "c29"
  },
  {
   "text": "任何一环被攻破",
   "start": 65.496,
   "end": 66.951,
   "id": "c30"
  },
  {
   "text": "结果都一样",
   "start": 66.972,
   "end": 67.916,
   "id": "c31"
  },
  {
   "text": "你的浏览器运行着攻击者的代码",
   "start": 68.115,
   "end": 70.761,
   "id": "c32"
  },
  {
   "text": "合约审计",
   "start": 71.74,
   "end": 72.802,
   "id": "c33"
  },
  {
   "text": "覆盖不到其中任何一环",
   "start": 72.894,
   "end": 74.624,
   "id": "c34"
  }
 ]
