   "line": 13,
   "text": "根本",
   "start": 57.859,
   "end": 58.109
  },
  {
   "line": 13,
   "text": "不",
   "start": 58.121,
   "end": 58.24
  },
  {
   "line": 13,
   "text": "存在",
   "start": 58.24,
   "end": 58.609
  }
 ],
 "captions": [
  {
   "text": "2022 年 1 月",
   "start": 1.648,
   "end": 2.865,
   "id": "c0"
  },
  {
   "text": "Qubit 跨链桥出了事",
   "start": 2.945,
   "end": 4.818,
   "id": "c1"
  },
  {
   "text": "以太坊这一侧",
   "start": 5.804,
   "end": 6.962,
   "id": "c2"
  },
  {
   "text": "没有收到对应的 ETH",
   "start": 7.006,
   "end": 8.438,
   "id": "c3"
  },
  {
   "text": "BNB Chain 那一侧",
   "start": 9.408,
   "end": 10.804,
   "id": "c4"
  },
  {
   "text": "却铸造出了代表 ETH 的 qXETH",
   "start": 10.824,
   "end": 13.673,
   "id": "c5"
  },
  {
   "text": "公开报道的损失",
   "start": 14.644,
   "end": 15.98,
   "id": "c6"
  },
  {
   "text": "约 8000 万美元",
   "start": 16.048,
   "end": 17.349,
   "id": "c7"
  },
  {
   "text": "桥相信了一次外部调用的结果",
   "start": 18.344,
   "end": 20.883,
   "id": "c8"
  },
  {
   "text": "先猜一道题",
   "start": 21.876,
   "end": 23.2,
   "id": "c9"
  },
  {
   "text": "合约用低级 call",
   "start": 24.184,
   "end": 25.521,
   "id": "c10"
  },
  {
   "text": "去调用一个没有代码的地址",
   "start": 25.541,
   "end": 27.187,
   "id": "c11"
  },
  {
   "text": "call 返回 true",
   "start": 28.172,
   "end": 29.746,
   "id": "c12"
  },
  {
   "text": "还是 false",
   "start": 29.85,
   "end": 30.818,
   "id": "c13"
  },
  {
   "text": "答案是 true",
   "start": 32.056,
   "end": 33.154,
   "id": "c14"
  },
  {
   "text": "而且返回数据是空的",
   "start": 33.282,
   "end": 34.904,
   "id": "c15"
  },
  {
   "text": "EVM 不会因为目标没有代码",
   "start": 35.876,
   "end": 37.868,
   "id": "c16"
  },
  {
   "text": "就让 call 失败",
   "start": 37.888,
   "end": 38.927,
   "id": "c17"
  },
  {
   "text": "如果代码把成功加空返回",
   "start": 39.912,
   "end": 42.344,
   "id": "c18"
  },
  {
   "text": "当成转账成功",
   "start": 42.483,
   "end": 43.82,
   "id": "c19"
  },
  {
   "text": "它就会记下一笔",
   "start": 44.812,
   "end": 46.16,
   "id": "c20"
  },
  {
   "text": "根本没有发生的转账",
   "start": 46.288,
   "end": 47.874,
   "id": "c21"
  },
  {
   "text": "记住一句话",
   "start": 48.872,
   "end": 49.923,
   "id": "c22"
  },
  {
   "text": "每一个外部调用",
   "start": 50.122,
   "end": 51.423,
   "id": "c23"
  },
  {
   "text": "都是把命运交给别人",
   "start": 51.574,
   "end": 53.03,
   "id": "c24"
  },
  {
   "text": "对方可能失败",
   "start": 54.012,
   "end": 55.205,
   "id": "c25"
  },
  {
   "text": "可能撒谎",
   "start": 55.262,
   "end": 56.205,
   "id": "c26"
  },
  {
   "text": "可能拖延",
   "start": 56.393,
   "end": 57.396,
   "id": "c27"
  },
  {
   "text": "也可能根本不存在",
   "start": 57.452,
   "end": 58.729,
   "id": "c28"
  }
 ]
}