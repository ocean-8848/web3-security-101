 "captions": [
  {
   "text": "Move 的类型系统",
   "start": 1.641,
   "end": 2.906,
   "id": "c0"
  },
  {
   "text": "保证代币对象不能被复制",
   "start": 3.234,
   "end": 5.199,
   "id": "c1"
  },
  {
   "text": "也不能凭空丢掉",
   "start": 5.5,
   "end": 6.949,
   "id": "c2"
  },
  {
   "text": "但它不保证数学正确",
   "start": 7.21,
   "end": 9.087,
   "id": "c3"
  },
  {
   "text": "不保证权限正确",
   "start": 9.559,
   "end": 11.155,
   "id": "c4"
  },
  {
   "text": "也不保证升级正确",
   "start": 11.249,
   "end": 12.877,
   "id": "c5"
  },
  {
   "text": "2025 年 5 月 22 日",
   "start": 13.214,
   "end": 15.388,
   "id": "c6"
  },
  {
   "text": "Sui 上的 Cetus 被攻击",
   "start": 15.524,
   "end": 17.635,
   "id": "c7"
  },
  {
   "text": "按 Dedaub 和 Cyfrin 的分析",
   "start": 17.982,
   "end": 20.337,
   "id": "c8"
  },
  {
   "text": "漏洞不在 Cetus 自己的业务代码",
   "start": 20.508,
   "end": 23.155,
   "id": "c9"
  },
  {
   "text": "在它依赖的开源数学库",
   "start": 23.371,
   "end": 25.434,
   "id": "c10"
  },
  {
   "text": "加流动性时",
   "start": 25.71,
   "end": 26.889,
   "id": "c11"
  },
  {
   "text": "要把一个数左移 64 位",
   "start": 26.945,
   "end": 29.272,
   "id": "c12"
  },
  {
   "text": "数学库先判断",
   "start": 29.452,
   "end": 30.649,
   "id": "c13"
  },
  {
   "text": "这一步会不会溢出",
   "start": 30.744,
   "end": 32.337,
   "id": "c14"
  },
  {
   "text": "判断用的比较常量写错了",
   "start": 32.57,
   "end": 35.084,
   "id": "c15"
  },
  {
   "text": "本该拦住的值",
   "start": 35.588,
   "end": 36.876,
   "id": "c16"
  },
  {
   "text": "被放了过去",
   "start": 36.896,
   "end": 37.855,
   "id": "c17"
  },
  {
   "text": "在 Move 上",
   "start": 38.15,
   "end": 39.139,
   "id": "c18"
  },
  {
   "text": "位移溢出",
   "start": 39.287,
   "end": 40.252,
   "id": "c19"
  },
  {
   "text": "交易会中止吗",
   "start": 40.464,
   "end": 41.691,
   "id": "c20"
  },
  {
   "text": "不会",
   "start": 42.344,
   "end": 42.811,
   "id": "c21"
  },
  {
   "text": "位移溢出直接截断",
   "start": 43.28,
   "end": 44.918,
   "id": "c22"
  },
  {
   "text": "交易照常执行",
   "start": 45.088,
   "end": 46.256,
   "id": "c23"
  },
  {
   "text": "攻击者存入约 1 个代币",
   "start": 46.564,
   "end": 48.454,
   "id": "c24"
  },
  {
   "text": "拿到巨量的流动性份额",
   "start": 48.712,
   "end": 50.695,
   "id": "c25"
  },
  {
   "text": "提走池子资产",
   "start": 50.893,
   "end": 52.086,
   "id": "c26"
  },
  {
   "text": "约 2.23 亿美元",
   "start": 52.223,
   "end": 53.899,
   "id": "c27"
  },
  {
   "text": "Sui 验证者冻结了约 1.62 亿美元",
   "start": 54.226,
   "end": 57.84,
   "id": "c28"
  },
  {
   "text": "治理投票后",
   "start": 57.86,
   "end": 58.815,
   "id": "c29"
  },
  {
   "text": "转入共管多签",
   "start": 59.063,
   "end": 60.583,
   "id": "c30"
  },
  {
   "text": "用于赔付",
   "start": 60.603,
   "end": 61.383,
   "id": "c31"
  },
  {
   "text": "所以审计范围",
   "start": 61.63,
   "end": 63.238,
   "id": "c32"
  },
  {
   "text": "必须覆盖数学依赖库",
   "start": 63.363,
   "end": 65.359,
   "id": "c33"
  },
  {
   "text": "位移和乘法溢出",
   "start": 65.53,
   "end": 67.147,
   "id": "c34"
  },
  {
   "text": "要有显式检查",
   "start": 67.262,
   "end": 68.579,
   "id": "c35"
  },
  {
   "text": "语言的保证",
   "start": 68.81,
   "end": 69.865,
   "id": "c36"
  },
  {
   "text": "也依赖验证器本身没写错",
   "start": 69.978,
   "end": 72.23,
   "id": "c37"
  },
  {
   "text": "2023 年",
   "start": 72.574,
   "end": 73.497,
   "id": "c38"
  },
  {
   "text": "Zellic 发现",
   "start": 73.534,
   "end": 74.411,
   "id": "c39"
  },
  {
   "text": "Move 字节码验证器在处理超长函数时",
   "start": 74.47,
   "end": 77.682,
   "id": "c40"
  },
  {
   "text": "漏掉了控制流边",
   "start": 77.733,
   "end": 79.288,
   "id": "c41"
  },
  {
   "text": "两道安全检查被绕过",
   "start": 79.472,
   "end": 81.296,
   "id": "c42"
  },
  {
   "text": "这个漏洞已修复",
   "start": 81.666,
   "end": 82.86,
   "id": "c43"
  },
  {
   "text": "没有损失",
   "start": 82.95,
   "end": 83.635,
   "id": "c44"
  },
  {
   "text": "协议层的风险",
   "start": 83.87,
   "end": 85.075,
   "id": "c45"
  },
  {
   "text": "仍然在升级权限和部署流程",
   "start": 85.214,
   "end": 88.232,
   "id": "c46"
  },
  {
   "text": "2025 年 9 月",
   "start": 88.589,
   "end": 89.793,
   "id": "c47"
  },
  {
   "text": "Sui 上的 Nemo",
   "start": 89.871,
   "end": 91.034,
   "id": "c48"
  },
  {
   "text": "开发者在审计后",
   "start": 91.136,
   "end": 92.464,
   "id": "c49"
  },
  {
   "text": "私自部署了未审计的代码",
   "start": 92.536,
   "end": 94.525,
   "id": "c50"
  },
  {
   "text": "一个内部的闪电贷函数被设成公开",
   "start": 94.887,
   "end": 98.824,
   "id": "c51"
  },
  {
   "text": "升级权限只有单签",
   "start": 98.844,
   "end": 99.782,
   "id": "c52"
  },
  {
   "text": "损失约 240 万到约 260 万美元",
   "start": 100.03,
   "end": 103.782,
   "id": "c53"
  },
  {
   "text": "升级权限要用多签",
   "start": 104.05,
   "end": 106.063,
   "id": "c54"
  },
  {
   "text": "加时间锁",
   "start": 106.083,
   "end": 107.056,
   "id": "c55"
  },
  {
   "text": "部署的版本",
   "start": 107.228,
   "end": 108.186,
   "id": "c56"
  },
  {
   "text": "必须等于审计的版本",
   "start": 108.207,
   "end": 109.833,
   "id": "c57"
  }
 ]
