 "captions": [
  {
   "text": "先给准确的说法",
   "start": 1.55,
   "end": 2.807,
   "id": "c0"
  },
  {
   "text": "执行模型",
   "start": 3.144,
   "end": 4.358,
   "id": "c1"
  },
  {
   "text": "是一条链怎么存状态",
   "start": 4.545,
   "end": 6.6,
   "id": "c2"
  },
  {
   "text": "怎么调用程序",
   "start": 6.809,
   "end": 7.99,
   "id": "c3"
  },
  {
   "text": "怎么决定谁能改什么",
   "start": 8.19,
   "end": 10.187,
   "id": "c4"
  },
  {
   "text": "漏洞的本质",
   "start": 10.565,
   "end": 11.532,
   "id": "c5"
  },
  {
   "text": "在哪条链上都一样",
   "start": 11.623,
   "end": 13.256,
   "id": "c6"
  },
  {
   "text": "程序相信了一个不该相信的输入",
   "start": 13.582,
   "end": 16.432,
   "id": "c7"
  },
  {
   "text": "变的 是输入的样子",
   "start": 16.769,
   "end": 18.61,
   "id": "c8"
  },
  {
   "text": "在 EVM 上",
   "start": 18.984,
   "end": 20.307,
   "id": "c9"
  },
  {
   "text": "合约拥有自己的存储",
   "start": 20.43,
   "end": 22.514,
   "id": "c10"
  },
  {
   "text": "攻击者换不掉它",
   "start": 22.741,
   "end": 24.289,
   "id": "c11"
  },
  {
   "text": "输入是参数和外部调用",
   "start": 24.718,
   "end": 27.124,
   "id": "c12"
  },
  {
   "text": "在 Solana 上",
   "start": 27.35,
   "end": 28.628,
   "id": "c13"
  },
  {
   "text": "程序本身不存状态",
   "start": 28.83,
   "end": 30.624,
   "id": "c14"
  },
  {
   "text": "账户全部由调用者传进来",
   "start": 30.834,
   "end": 33.219,
   "id": "c15"
  },
  {
   "text": "在 Move 上",
   "start": 33.49,
   "end": 34.391,
   "id": "c16"
  },
  {
   "text": "状态是带类型的对象",
   "start": 34.528,
   "end": 36.333,
   "id": "c17"
  },
  {
   "text": "输入是对象",
   "start": 36.43,
   "end": 37.449,
   "id": "c18"
  },
  {
   "text": "风险常在数学库和权限",
   "start": 37.6,
   "end": 39.775,
   "id": "c19"
  },
  {
   "text": "在 Bitcoin 上",
   "start": 40.123,
   "end": 41.272,
   "id": "c20"
  },
  {
   "text": "链只记录交易",
   "start": 41.501,
   "end": 42.943,
   "id": "c21"
  },
  {
   "text": "铭文这类资产的余额",
   "start": 43.147,
   "end": 44.798,
   "id": "c22"
  },
  {
   "text": "由链下的索引器解释",
   "start": 44.894,
   "end": 46.743,
   "id": "c23"
  },
  {
   "text": "在 Cosmos 上",
   "start": 47.069,
   "end": 48.277,
   "id": "c24"
  },
  {
   "text": "各条应用链用 IBC",
   "start": 48.544,
   "end": 49.499,
   "id": "c25"
  },
  {
   "text": "验证对方链上的状态",
   "start": 49.519,
   "end": 52.085,
   "id": "c26"
  },
  {
   "text": "打个比方",
   "start": 52.41,
   "end": 53.068,
   "id": "c27"
  },
  {
   "text": "五个国家的海关",
   "start": 53.33,
   "end": 54.749,
   "id": "c28"
  },
  {
   "text": "都要防走私",
   "start": 54.806,
   "end": 55.8,
   "id": "c29"
  },
  {
   "text": "EVM 查行李",
   "start": 56.121,
   "end": 56.911,
   "id": "c30"
  },
  {
   "text": "Solana 查护照",
   "start": 56.931,
   "end": 58.647,
   "id": "c31"
  },
  {
   "text": "Move 给每件货物贴防伪芯片",
   "start": 58.671,
   "end": 61.988,
   "id": "c32"
  },
  {
   "text": "Bitcoin 只查集装箱的封条",
   "start": 62.353,
   "end": 64.553,
   "id": "c33"
  },
  {
   "text": "不管里面装什么",
   "start": 64.694,
   "end": 65.922,
   "id": "c34"
  },
  {
   "text": "Cosmos 和邻国互认海关章",
   "start": 66.137,
   "end": 68.481,
   "id": "c35"
  },
  {
   "text": "走私者在每个国家",
   "start": 68.71,
   "end": 70.658,
   "id": "c36"
  },
  {
   "text": "都找最薄弱的那一环",
   "start": 70.883,
   "end": 72.735,
   "id": "c37"
  },
  {
   "text": "比喻不成立的地方是",
   "start": 73.106,
   "end": 74.61,
   "id": "c38"
  },
  {
   "text": "真实的跨生态集成里",
   "start": 74.88,
   "end": 76.789,
   "id": "c39"
  },
  {
   "text": "同一笔资产会经过好几个国家",
   "start": 77.126,
   "end": 79.69,
   "id": "c40"
  },
  {
   "text": "每多一种模型",
   "start": 80.051,
   "end": 81.244,
   "id": "c41"
  },
  {
   "text": "就多一组需要专门知识的检查项",
   "start": 81.43,
   "end": 84.092,
   "id": "c42"
  },
  {
   "text": "先看护照这一关",
   "start": 84.423,
   "end": 85.818,
   "id": "c43"
  },
  {
   "text": "Solana",
   "start": 85.965,
   "end": 86.563,
   "id": "c44"
  }
 ]
