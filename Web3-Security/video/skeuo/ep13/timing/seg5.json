 "captions": [
  {
   "text": "Bitcoin 这一关",
   "start": 1.648,
   "end": 2.889,
   "id": "c0"
  },
  {
   "text": "链只记录",
   "start": 2.91,
   "end": 3.889,
   "id": "c1"
  },
  {
   "text": "链下软件来解释",
   "start": 3.993,
   "end": 5.687,
   "id": "c2"
  },
  {
   "text": "铭文和 BRC-20 的余额",
   "start": 6.668,
   "end": 9.207,
   "id": "c3"
  },
  {
   "text": "不由比特币共识决定",
   "start": 9.251,
   "end": 10.707,
   "id": "c4"
  },
  {
   "text": "由链下索引器解释同一批交易",
   "start": 10.775,
   "end": 13.052,
   "id": "c5"
  },
  {
   "text": "先猜一道题",
   "start": 14.04,
   "end": 15.364,
   "id": "c6"
  },
  {
   "text": "同一个铭文代币",
   "start": 15.728,
   "end": 16.933,
   "id": "c7"
  },
  {
   "text": "两家平台显示的余额不同",
   "start": 17.109,
   "end": 19.231,
   "id": "c8"
  },
  {
   "text": "比特币共识能裁决谁对吗",
   "start": 19.609,
   "end": 22.064,
   "id": "c9"
  },
  {
   "text": "不能",
   "start": 23.324,
   "end": 24.113,
   "id": "c10"
  },
  {
   "text": "共识只验证交易本身",
   "start": 24.464,
   "end": 26.432,
   "id": "c11"
  },
  {
   "text": "不解释铭文内容",
   "start": 26.5,
   "end": 27.896,
   "id": "c12"
  },
  {
   "text": "按 Cointelegraph 报道",
   "start": 28.872,
   "end": 30.542,
   "id": "c13"
  },
  {
   "text": "2023 到 2024 年",
   "start": 30.729,
   "end": 32.446,
   "id": "c14"
  },
  {
   "text": "各平台的索引器版本不一致",
   "start": 32.503,
   "end": 34.303,
   "id": "c15"
  },
  {
   "text": "Magic Eden 暂停交易",
   "start": 34.667,
   "end": 36.444,
   "id": "c16"
  },
  {
   "text": "UniSat 警告存在双花风险",
   "start": 36.667,
   "end": 39.039,
   "id": "c17"
  },
  {
   "text": "闪电网络的资金安全",
   "start": 40.036,
   "end": 41.765,
   "id": "c18"
  },
  {
   "text": "依赖用户在截止时间前",
   "start": 41.952,
   "end": 43.908,
   "id": "c19"
  },
  {
   "text": "把交易打包上链",
   "start": 43.928,
   "end": 45.194,
   "id": "c20"
  },
  {
   "text": "2023 年 10 月披露的替换循环攻击",
   "start": 46.184,
   "end": 48.889,
   "id": "c21"
  },
  {
   "text": "利用 mempool 的替换规则",
   "start": 48.969,
   "end": 50.806,
   "id": "c22"
  },
  {
   "text": "把受害者的超时交易反复挤出去",
   "start": 50.862,
   "end": 53.532,
   "id": "c23"
  },
  {
   "text": "四家主要实现在披露前已发布缓解",
   "start": 54.516,
   "end": 57.686,
   "id": "c24"
  },
  {
   "text": "未见在野利用",
   "start": 57.908,
   "end": 59.126,
   "id": "c25"
  },
  {
   "text": "BTC 跨链桥多靠多签或联盟",
   "start": 60.112,
   "end": 62.782,
   "id": "c26"
  },
  {
   "text": "2026 年 9 月 6 日",
   "start": 63.764,
   "end": 65.35,
   "id": "c27"
  },
  {
   "text": "Liquid 侧链上",
   "start": 65.371,
   "end": 66.612,
   "id": "c28"
  },
  {
   "text": "被凭空铸出约 4000 枚 L-BTC",
   "start": 66.656,
   "end": 69.35,
   "id": "c29"
  },
  {
   "text": "再通过正常提现换成真实 BTC",
   "start": 69.406,
   "end": 72.255,
   "id": "c30"
  },
  {
   "text": "约 3.19 亿美元",
   "start": 72.323,
   "end": 73.898,
   "id": "c31"
  },
  {
   "text": "Blockstream 称签名密钥没有泄露",
   "start": 74.88,
   "end": 77.335,
   "id": "c32"
  },
  {
   "text": "联盟按软件给出的链状态",
   "start": 77.711,
   "end": 79.738,
   "id": "c33"
  },
  {
   "text": "正常签了名",
   "start": 79.901,
   "end": 81.095,
   "id": "c34"
  },
  {
   "text": "第三方重建的根因",
   "start": 82.084,
   "end": 83.587,
   "id": "c35"
  },
  {
   "text": "是范围证明的验证缓存",
   "start": 83.607,
   "end": 85.599,
   "id": "c36"
  },
  {
   "text": "可能把无效输出当作已验证",
   "start": 85.774,
   "end": 88.23,
   "id": "c37"
  },
  {
   "text": "官方完整复盘尚未确认",
   "start": 88.605,
   "end": 91.085,
   "id": "c38"
  },
  {
   "text": "门限签名只保证多数人同意",
   "start": 92.072,
   "end": 94.515,
   "id": "c39"
  },
  {
   "text": "不保证被同意的状态是对的",
   "start": 94.774,
   "end": 96.765,
   "id": "c40"
  },
  {
   "text": "储备要由独立的对账程序实时核对",
   "start": 97.117,
   "end": 100.323,
   "id": "c41"
  },
  {
   "text": "Cosmos 这一关",
   "start": 101.316,
   "end": 102.569,
   "id": "c42"
  },
  {
   "text": "各条链用轻客户端和 Merkle 证明",
   "start": 102.601,
   "end": 105.259,
   "id": "c43"
  },
  {
   "text": "互认对方的状态",
   "start": 105.292,
   "end": 106.462,
   "id": "c44"
  },
  {
   "text": "2022 年 10 月的 Dragonberry",
   "start": 107.464,
   "end": 110.003,
   "id": "c45"
  },
  {
   "text": "ICS-23 接受了伪造的不存在证明",
   "start": 110.19,
   "end": 113.538,
   "id": "c46"
  },
  {
   "text": "可以伪造 IBC 超时",
   "start": 113.559,
   "end": 115.551,
   "id": "c47"
  },
  {
   "text": "掏空托管账户",
   "start": 115.571,
   "end": 116.86,
   "id": "c48"
  },
  {
   "text": "这个漏洞协调修复",
   "start": 117.235,
   "end": 118.679,
   "id": "c49"
  },
  {
   "text": "没有损失",
   "start": 118.854,
   "end": 119.762,
   "id": "c50"
  },
  {
   "text": "状态机也必须是确定性的",
   "start": 120.764,
   "end": 122.934,
   "id": "c51"
  },
  {
   "text": "2021 年 10 月的 Jackfruit",
   "start": 123.912,
   "end": 126.165,
   "id": "c52"
  },
  {
   "text": "授权模块用节点本地时钟判断过期",
   "start": 126.293,
   "end": 129.213,
   "id": "c53"
  },
  {
   "text": "不同节点算出不同结果",
   "start": 129.588,
   "end": 131.329,
   "id": "c54"
  },
  {
   "text": "任何人都能让链停机",
   "start": 131.493,
   "end": 133.139,
   "id": "c55"
  },
  {
   "text": "BeginBlock 和 EndBlock",
   "start": 134.14,
   "end": 135.834,
   "id": "c56"
  },
  {
   "text": "里的 panic 或无界循环",
   "start": 135.854,
   "end": 137.798,
   "id": "c57"
  },
  {
   "text": "也会让整条链停止出块",
   "start": 137.866,
   "end": 139.714,
   "id": "c58"
  }
 ]
