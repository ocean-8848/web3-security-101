 "captions": [
  {
   "text": "Solana 程序拿到的每一个账户",
   "start": 1.648,
   "end": 3.711,
   "id": "c0"
  },
  {
   "text": "都是用户输入",
   "start": 3.731,
   "end": 4.77,
   "id": "c1"
  },
  {
   "text": "第一件要查的",
   "start": 5.756,
   "end": 6.795,
   "id": "c2"
  },
  {
   "text": "是 owner",
   "start": 6.815,
   "end": 7.652,
   "id": "c3"
  },
  {
   "text": "这个账户",
   "start": 8.027,
   "end": 9.03,
   "id": "c4"
  },
  {
   "text": "是不是归本程序所有",
   "start": 9.051,
   "end": 10.649,
   "id": "c5"
  },
  {
   "text": "第二件 是签名",
   "start": 11.64,
   "end": 13.452,
   "id": "c6"
  },
  {
   "text": "管理员操作",
   "start": 13.816,
   "end": 14.843,
   "id": "c7"
  },
  {
   "text": "必须检查管理员账户签了名",
   "start": 14.935,
   "end": 17.331,
   "id": "c8"
  },
  {
   "text": "第三件 是类型",
   "start": 18.316,
   "end": 20.033,
   "id": "c9"
  },
  {
   "text": "两种账户结构相同",
   "start": 20.397,
   "end": 22.209,
   "id": "c10"
  },
  {
   "text": "攻击者就能拿一种冒充另一种",
   "start": 22.444,
   "end": 24.936,
   "id": "c11"
  },
  {
   "text": "要靠判别字段区分",
   "start": 25.301,
   "end": 27.055,
   "id": "c12"
  },
  {
   "text": "第四件 是跨程序调用的目标",
   "start": 28.04,
   "end": 30.579,
   "id": "c13"
  },
  {
   "text": "program id 由调用者传进来",
   "start": 30.954,
   "end": 33.422,
   "id": "c14"
  },
  {
   "text": "就必须核对",
   "start": 33.442,
   "end": 34.41,
   "id": "c15"
  },
  {
   "text": "第五件 是系统账户",
   "start": 35.412,
   "end": 37.486,
   "id": "c16"
  },
  {
   "text": "要用带校验的读取方式",
   "start": 37.862,
   "end": 39.746,
   "id": "c17"
  },
  {
   "text": "Wormhole 缺的就是这一件",
   "start": 40.124,
   "end": 41.877,
   "id": "c18"
  },
  {
   "text": "更隐蔽的一种",
   "start": 42.856,
   "end": 44.002,
   "id": "c19"
  },
  {
   "text": "是信任链没有终点",
   "start": 44.118,
   "end": 45.537,
   "id": "c20"
  },
  {
   "text": "2022 年 3 月的 Cashio",
   "start": 46.532,
   "end": 48.821,
   "id": "c21"
  },
  {
   "text": "存抵押品时",
   "start": 48.841,
   "end": 49.964,
   "id": "c22"
  },
  {
   "text": "只检查了各个账户互相一致",
   "start": 49.984,
   "end": 52.154,
   "id": "c23"
  },
  {
   "text": "铸币检查没有把 mint 字段",
   "start": 53.136,
   "end": 55.401,
   "id": "c24"
  },
  {
   "text": "锚定到一个可信的根",
   "start": 55.505,
   "end": 56.937,
   "id": "c25"
  },
  {
   "text": "攻击者伪造了整条账户链",
   "start": 57.916,
   "end": 59.919,
   "id": "c26"
  },
  {
   "text": "用没有价值的代币",
   "start": 59.951,
   "end": 61.169,
   "id": "c27"
  },
  {
   "text": "铸出约 20 亿枚 CASH",
   "start": 61.189,
   "end": 62.848,
   "id": "c28"
  },
  {
   "text": "损失的估计",
   "start": 63.824,
   "end": 64.875,
   "id": "c29"
  },
  {
   "text": "rekt.news 约 4800 万美元",
   "start": 64.99,
   "end": 67.505,
   "id": "c30"
  },
  {
   "text": "CertiK 约 5280 万美元",
   "start": 67.597,
   "end": 70.22,
   "id": "c31"
  },
  {
   "text": "账户之间再一致",
   "start": 71.22,
   "end": 72.699,
   "id": "c32"
  },
  {
   "text": "也要有一端",
   "start": 72.827,
   "end": 73.723,
   "id": "c33"
  },
  {
   "text": "落在硬编码的地址",
   "start": 73.779,
   "end": 75.235,
   "id": "c34"
  },
  {
   "text": "或本程序的 PDA 上",
   "start": 75.255,
   "end": 76.806,
   "id": "c35"
  },
  {
   "text": "PDA 要用规范的 bump",
   "start": 77.776,
   "end": 79.981,
   "id": "c36"
  },
  {
   "text": "跨程序调用之后",
   "start": 80.345,
   "end": 81.717,
   "id": "c37"
  },
  {
   "text": "要再次加载账户",
   "start": 81.797,
   "end": 83.181,
   "id": "c38"
  },
  {
   "text": "不用内存里的旧数据",
   "start": 83.285,
   "end": 84.669,
   "id": "c39"
  },
  {
   "text": "Anchor 框架的账户约束",
   "start": 85.652,
   "end": 87.512,
   "id": "c40"
  },
  {
   "text": "能自动做完大部分检查",
   "start": 87.616,
   "end": 89.488,
   "id": "c41"
  },
  {
   "text": "但约束是开发者写的",
   "start": 89.864,
   "end": 91.593,
   "id": "c42"
  },
  {
   "text": "漏写一个",
   "start": 91.744,
   "end": 92.772,
   "id": "c43"
  },
  {
   "text": "就等于没有",
   "start": 92.852,
   "end": 93.795,
   "id": "c44"
  },
  {
   "text": "签名的有效期",
   "start": 94.776,
   "end": 96.017,
   "id": "c45"
  },
  {
   "text": "也是一种输入",
   "start": 96.157,
   "end": 97.208,
   "id": "c46"
  },
  {
   "text": "2026 年 4 月",
   "start": 98.188,
   "end": 99.43,
   "id": "c47"
  },
  {
   "text": "按 Chainalysis 的分析",
   "start": 99.45,
   "end": 100.929,
   "id": "c48"
  },
  {
   "text": "Drift 损失约 2.85 亿美元",
   "start": 101.045,
   "end": 103.572,
   "id": "c49"
  },
  {
   "text": "它的安全委员会",
   "start": 104.552,
   "end": 105.757,
   "id": "c50"
  },
  {
   "text": "五个人里两人签名就能放行",
   "start": 106.04,
   "end": 108.055,
   "id": "c51"
  },
  {
   "text": "迁移到新配置后",
   "start": 108.43,
   "end": 109.803,
   "id": "c52"
  },
  {
   "text": "时间锁为零",
   "start": 109.823,
   "end": 111.017,
   "id": "c53"
  },
  {
   "text": "至少两名成员",
   "start": 111.996,
   "end": 113.38,
   "id": "c54"
  },
  {
   "text": "签了自己没有完全理解的审批",
   "start": 113.531,
   "end": 115.606,
   "id": "c55"
  },
  {
   "text": "Solana 的签名",
   "start": 116.584,
   "end": 117.766,
   "id": "c56"
  },
  {
   "text": "本来约 1 分钟就会过期",
   "start": 117.798,
   "end": 119.492,
   "id": "c57"
  },
  {
   "text": "持久 nonce 让这些签名长期有效",
   "start": 119.867,
   "end": 122.716,
   "id": "c58"
  },
  {
   "text": "Chainalysis 也说明",
   "start": 123.716,
   "end": 125.1,
   "id": "c59"
  },
  {
   "text": "这些描述来自 Drift 自己的调查",
   "start": 125.347,
   "end": 128.052,
   "id": "c60"
  },
  {
   "text": "未经独立验证",
   "start": 128.085,
   "end": 129.243,
   "id": "c61"
  },
  {
   "text": "管理操作要加时间锁",
   "start": 130.224,
   "end": 132.072,
   "id": "c62"
  },
  {
   "text": "执行前再确认一次",
   "start": 132.128,
   "end": 133.572,
   "id": "c63"
  }
 ]
}