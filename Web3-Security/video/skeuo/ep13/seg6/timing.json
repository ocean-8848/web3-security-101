 "captions": [
  {
   "text": "放到一个具体场景里",
   "start": 1.55,
   "end": 3.212,
   "id": "c0"
  },
  {
   "text": "交易所要接入一条新链",
   "start": 3.669,
   "end": 5.692,
   "id": "c1"
  },
  {
   "text": "照搬以太坊的接入逻辑",
   "start": 6.028,
   "end": 7.77,
   "id": "c2"
  },
  {
   "text": "是假充值",
   "start": 7.79,
   "end": 8.86,
   "id": "c3"
  },
  {
   "text": "错账和资金丢失的主要来源",
   "start": 8.88,
   "end": 11.516,
   "id": "c4"
  },
  {
   "text": "接入的人",
   "start": 11.84,
   "end": 12.601,
   "id": "c5"
  },
  {
   "text": "先问这几件事",
   "start": 12.712,
   "end": 13.991,
   "id": "c6"
  },
  {
   "text": "失败的交易会不会上链",
   "start": 14.21,
   "end": 16.428,
   "id": "c7"
  },
  {
   "text": "实际到账金额怎么读",
   "start": 16.659,
   "end": 18.664,
   "id": "c8"
  },
  {
   "text": "代币由什么唯一标识",
   "start": 19.013,
   "end": 21.068,
   "id": "c9"
  },
  {
   "text": "合约地址",
   "start": 21.301,
   "end": 22.25,
   "id": "c10"
  },
  {
   "text": "mint 地址",
   "start": 22.437,
   "end": 23.348,
   "id": "c11"
  },
  {
   "text": "对象类型",
   "start": 23.584,
   "end": 24.463,
   "id": "c12"
  },
  {
   "text": "还是 denom",
   "start": 24.674,
   "end": 25.064,
   "id": "c13"
  },
  {
   "text": "有没有同名假币",
   "start": 25.084,
   "end": 27.068,
   "id": "c14"
  },
  {
   "text": "多少个区块之后不可回滚",
   "start": 27.393,
   "end": 29.459,
   "id": "c15"
  },
  {
   "text": "历史上有没有停链",
   "start": 29.825,
   "end": 31.328,
   "id": "c16"
  },
  {
   "text": "有没有两个独立运营的节点",
   "start": 31.59,
   "end": 35.137,
   "id": "c17"
  },
  {
   "text": "现有的 HSM 和 MPC",
   "start": 35.182,
   "end": 36.442,
   "id": "c18"
  },
  {
   "text": "支不支持这条链的签名算法",
   "start": 36.462,
   "end": 39.719,
   "id": "c19"
  },
  {
   "text": "资产是否依赖链下索引器",
   "start": 39.97,
   "end": 42.412,
   "id": "c20"
  },
  {
   "text": "用哪个版本",
   "start": 42.518,
   "end": 43.497,
   "id": "c21"
  },
  {
   "text": "多个索引器的结果是否一致",
   "start": 43.613,
   "end": 45.647,
   "id": "c22"
  },
  {
   "text": "链官方的 SDK 也是供应链",
   "start": 46.042,
   "end": 48.414,
   "id": "c23"
  },
  {
   "text": "签名服务不要和业务代码共用依赖",
   "start": 48.677,
   "end": 51.329,
   "id": "c24"
  },
  {
   "text": "普通用户",
   "start": 51.61,
   "end": 52.413,
   "id": "c25"
  },
  {
   "text": "跨链前确认代币的唯一标识",
   "start": 52.577,
   "end": 55.259,
   "id": "c26"
  },
  {
   "text": "不只看名称",
   "start": 55.43,
   "end": 56.511,
   "id": "c27"
  },
  {
   "text": "在 Solana 上签名时",
   "start": 56.715,
   "end": 58.323,
   "id": "c28"
  },
  {
   "text": "看到陌生程序 不签",
   "start": 58.387,
   "end": 60.097,
   "id": "c29"
  },
  {
   "text": "回到开头的问题",
   "start": 60.31,
   "end": 61.663,
   "id": "c30"
  },
  {
   "text": "Solana 程序要读的账户",
   "start": 61.872,
   "end": 63.82,
   "id": "c31"
  },
  {
   "text": "由谁提供",
   "start": 63.961,
   "end": 64.967,
   "id": "c32"
  },
  {
   "text": "由调用者在交易里传进来",
   "start": 65.623,
   "end": 67.866,
   "id": "c33"
  },
  {
   "text": "所以程序必须自己核对每个账户的 owner",
   "start": 68.132,
   "end": 71.635,
   "id": "c34"
  },
  {
   "text": "类型和地址",
   "start": 71.741,
   "end": 73.105,
   "id": "c35"
  },
  {
   "text": "这个答案只对 Solana 成立",
   "start": 73.35,
   "end": 75.331,
   "id": "c36"
  },
  {
   "text": "换一条链",
   "start": 75.87,
   "end": 76.582,
   "id": "c37"
  },
  {
   "text": "输入换了样子",
   "start": 76.664,
   "end": 78.07,
   "id": "c38"
  },
  {
   "text": "要问的仍是同一个问题",
   "start": 78.385,
   "end": 80.492,
   "id": "c39"
  },
  {
   "text": "谁决定这个输入可信",
   "start": 80.759,
   "end": 82.716,
   "id": "c40"
  },
  {
   "text": "换一种账户模型",
   "start": 82.99,
   "end": 84.409,
   "id": "c41"
  },
  {
   "text": "就换一组漏洞",
   "start": 84.477,
   "end": 85.506,
   "id": "c42"
  },
  {
   "text": "下一集讲 ZK 与证明系统的安全",
   "start": 85.77,
   "end": 88.94,
   "id": "c43"
  }
 ]
