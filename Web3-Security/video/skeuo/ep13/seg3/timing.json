 "captions": [
  {
   "text": "Solana 程序拿到的每一个账户",
   "start": 1.642,
   "end": 3.907,
   "id": "c0"
  },
  {
   "text": "都是用户输入",
   "start": 3.927,
   "end": 4.945,
   "id": "c1"
  },
  {
   "text": "第一件要查的",
   "start": 5.303,
   "end": 6.35,
   "id": "c2"
  },
  {
   "text": "是 owner",
   "start": 6.378,
   "end": 7.104,
   "id": "c3"
  },
  {
   "text": "这个账户",
   "start": 7.345,
   "end": 8.137,
   "id": "c4"
  },
  {
   "text": "是不是归本程序所有",
   "start": 8.198,
   "end": 9.889,
   "id": "c5"
  },
  {
   "text": "第二件 是签名",
   "start": 10.244,
   "end": 11.776,
   "id": "c6"
  },
  {
   "text": "管理员操作",
   "start": 12.006,
   "end": 12.914,
   "id": "c7"
  },
  {
   "text": "必须检查管理员账户签了名",
   "start": 13.071,
   "end": 15.343,
   "id": "c8"
  },
  {
   "text": "第三件 是类型",
   "start": 15.57,
   "end": 17.207,
   "id": "c9"
  },
  {
   "text": "两种账户结构相同",
   "start": 17.444,
   "end": 19.238,
   "id": "c10"
  },
  {
   "text": "攻击者就能拿一种冒充另一种",
   "start": 19.456,
   "end": 21.988,
   "id": "c11"
  },
  {
   "text": "要靠判别字段区分",
   "start": 22.179,
   "end": 23.832,
   "id": "c12"
  },
  {
   "text": "第四件 是跨程序调用的目标",
   "start": 24.11,
   "end": 27.17,
   "id": "c13"
  },
  {
   "text": "program id 由调用者传进来",
   "start": 27.762,
   "end": 30.315,
   "id": "c14"
  },
  {
   "text": "就必须核对",
   "start": 30.475,
   "end": 31.543,
   "id": "c15"
  },
  {
   "text": "第五件 是系统账户",
   "start": 31.77,
   "end": 33.946,
   "id": "c16"
  },
  {
   "text": "要用带校验的读取方式",
   "start": 34.308,
   "end": 36.168,
   "id": "c17"
  },
  {
   "text": "Wormhole 缺的就是这一件",
   "start": 36.431,
   "end": 38.014,
   "id": "c18"
  },
  {
   "text": "更隐蔽的一种",
   "start": 38.332,
   "end": 39.483,
   "id": "c19"
  },
  {
   "text": "是信任链没有终点",
   "start": 39.61,
   "end": 41.397,
   "id": "c20"
  },
  {
   "text": "2022 年 3 月的 Cashio",
   "start": 41.755,
   "end": 43.845,
   "id": "c21"
  },
  {
   "text": "存抵押品时",
   "start": 44.119,
   "end": 45.311,
   "id": "c22"
  },
  {
   "text": "只检查了各个账户互相一致",
   "start": 45.368,
   "end": 47.63,
   "id": "c23"
  },
  {
   "text": "铸币检查没有把 mint 字段",
   "start": 47.87,
   "end": 50.157,
   "id": "c24"
  },
  {
   "text": "锚定到一个可信的根",
   "start": 50.265,
   "end": 51.931,
   "id": "c25"
  },
  {
   "text": "攻击者伪造了整条账户链",
   "start": 52.261,
   "end": 54.511,
   "id": "c26"
  },
  {
   "text": "用没有价值的代币",
   "start": 54.882,
   "end": 56.192,
   "id": "c27"
  },
  {
   "text": "铸出约 20 亿枚 CASH",
   "start": 56.212,
   "end": 57.879,
   "id": "c28"
  },
  {
   "text": "损失的估计",
   "start": 58.15,
   "end": 59.335,
   "id": "c29"
  },
  {
   "text": "rekt.news 约 4800 万美元",
   "start": 59.691,
   "end": 63.233,
   "id": "c30"
  },
  {
   "text": "CertiK 约 5280 万美元",
   "start": 63.519,
   "end": 66.934,
   "id": "c31"
  },
  {
   "text": "账户之间再一致",
   "start": 67.17,
   "end": 68.658,
   "id": "c32"
  },
  {
   "text": "也要有一端",
   "start": 68.824,
   "end": 69.685,
   "id": "c33"
  },
  {
   "text": "落在硬编码的地址",
   "start": 69.743,
   "end": 71.405,
   "id": "c34"
  },
  {
   "text": "或本程序的 PDA 上",
   "start": 71.425,
   "end": 73.065,
   "id": "c35"
  },
  {
   "text": "PDA 要用规范的 bump",
   "start": 73.31,
   "end": 74.917,
   "id": "c36"
  },
  {
   "text": "跨程序调用之后",
   "start": 74.937,
   "end": 76.873,
   "id": "c37"
  },
  {
   "text": "要再次加载账户",
   "start": 77.047,
   "end": 78.549,
   "id": "c38"
  },
  {
   "text": "不用内存里的旧数据",
   "start": 78.742,
   "end": 80.229,
   "id": "c39"
  },
  {
   "text": "Anchor 框架的账户约束",
   "start": 80.587,
   "end": 82.413,
   "id": "c40"
  },
  {
   "text": "能自动做完大部分检查",
   "start": 82.458,
   "end": 84.45,
   "id": "c41"
  },
  {
   "text": "但约束是开发者写的",
   "start": 84.642,
   "end": 86.663,
   "id": "c42"
  },
  {
   "text": "漏写一个",
   "start": 86.807,
   "end": 87.606,
   "id": "c43"
  },
  {
   "text": "就等于没有",
   "start": 87.626,
   "end": 88.644,
   "id": "c44"
  },
  {
   "text": "签名的有效期",
   "start": 88.96,
   "end": 90.048,
   "id": "c45"
  },
  {
   "text": "也是一种输入",
   "start": 90.122,
   "end": 91.16,
   "id": "c46"
  },
  {
   "text": "2026 年 4 月",
   "start": 91.516,
   "end": 92.719,
   "id": "c47"
  },
  {
   "text": "按 Chainalysis 的分析",
   "start": 92.899,
   "end": 95.065,
   "id": "c48"
  },
  {
   "text": "Drift 损失约 2.85 亿美元",
   "start": 95.085,
   "end": 97.255,
   "id": "c49"
  },
  {
   "text": "它的安全委员会",
   "start": 97.55,
   "end": 99.109,
   "id": "c50"
  },
  {
   "text": "五个人里两人签名就能放行",
   "start": 99.284,
   "end": 101.669,
   "id": "c51"
  },
  {
   "text": "迁移到新配置后",
   "start": 101.724,
   "end": 103.076,
   "id": "c52"
  },
  {
   "text": "时间锁为零",
   "start": 103.21,
   "end": 104.409,
   "id": "c53"
  },
  {
   "text": "至少两名成员",
   "start": 104.65,
   "end": 106.046,
   "id": "c54"
  },
  {
   "text": "签了自己没有完全理解的审批",
   "start": 106.137,
   "end": 108.377,
   "id": "c55"
  },
  {
   "text": "Solana 的签名",
   "start": 108.722,
   "end": 109.841,
   "id": "c56"
  },
  {
   "text": "本来约 1 分钟就会过期",
   "start": 109.861,
   "end": 111.679,
   "id": "c57"
  },
  {
   "text": "持久 nonce 让这些签名长期有效",
   "start": 111.912,
   "end": 114.551,
   "id": "c58"
  },
  {
   "text": "Chainalysis 也说明",
   "start": 114.77,
   "end": 116.299,
   "id": "c59"
  },
  {
   "text": "这些描述来自 Drift 自己的调查",
   "start": 116.42,
   "end": 119.108,
   "id": "c60"
  },
  {
   "text": "未经独立验证",
   "start": 119.211,
   "end": 120.313,
   "id": "c61"
  },
  {
   "text": "管理操作要加时间锁",
   "start": 120.684,
   "end": 122.476,
   "id": "c62"
  },
  {
   "text": "执行前再确认一次",
   "start": 122.728,
   "end": 124.336,
   "id": "c63"
  }
 ]
}