 "captions": [
  {
   "text": "Move 的类型系统",
   "start": 1.648,
   "end": 2.972,
   "id": "c0"
  },
  {
   "text": "保证代币对象不能被复制",
   "start": 3.16,
   "end": 5.104,
   "id": "c1"
  },
  {
   "text": "也不能凭空丢掉",
   "start": 5.124,
   "end": 6.389,
   "id": "c2"
  },
  {
   "text": "但它不保证数学正确",
   "start": 7.388,
   "end": 9.153,
   "id": "c3"
  },
  {
   "text": "不保证权限正确",
   "start": 9.269,
   "end": 10.76,
   "id": "c4"
  },
  {
   "text": "也不保证升级正确",
   "start": 10.828,
   "end": 12.355,
   "id": "c5"
  },
  {
   "text": "2025 年 5 月 22 日",
   "start": 13.344,
   "end": 14.99,
   "id": "c6"
  },
  {
   "text": "Sui 上的 Cetus 被攻击",
   "start": 15.01,
   "end": 17.014,
   "id": "c7"
  },
  {
   "text": "按 Dedaub 和 Cyfrin 的分析",
   "start": 18.004,
   "end": 20.162,
   "id": "c8"
  },
  {
   "text": "漏洞不在 Cetus 自己的业务代码",
   "start": 20.385,
   "end": 23.043,
   "id": "c9"
  },
  {
   "text": "在它依赖的开源数学库",
   "start": 23.063,
   "end": 24.65,
   "id": "c10"
  },
  {
   "text": "加流动性时",
   "start": 25.64,
   "end": 26.869,
   "id": "c11"
  },
  {
   "text": "要把一个数左移 64 位",
   "start": 26.949,
   "end": 28.976,
   "id": "c12"
  },
  {
   "text": "数学库先判断",
   "start": 29.34,
   "end": 30.76,
   "id": "c13"
  },
  {
   "text": "这一步会不会溢出",
   "start": 30.887,
   "end": 32.307,
   "id": "c14"
  },
  {
   "text": "判断用的比较常量写错了",
   "start": 33.3,
   "end": 35.648,
   "id": "c15"
  },
  {
   "text": "本该拦住的值",
   "start": 36.012,
   "end": 37.253,
   "id": "c16"
  },
  {
   "text": "被放了过去",
   "start": 37.285,
   "end": 38.158,
   "id": "c17"
  },
  {
   "text": "在 Move 上",
   "start": 39.16,
   "end": 40.092,
   "id": "c18"
  },
  {
   "text": "位移溢出",
   "start": 40.243,
   "end": 41.127,
   "id": "c19"
  },
  {
   "text": "交易会中止吗",
   "start": 41.172,
   "end": 42.389,
   "id": "c20"
  },
  {
   "text": "不会",
   "start": 43.644,
   "end": 44.302,
   "id": "c21"
  },
  {
   "text": "位移溢出直接截断",
   "start": 44.665,
   "end": 46.514,
   "id": "c22"
  },
  {
   "text": "交易照常执行",
   "start": 46.665,
   "end": 48.18,
   "id": "c23"
  },
  {
   "text": "攻击者存入约 1 个代币",
   "start": 49.168,
   "end": 50.992,
   "id": "c24"
  },
  {
   "text": "拿到巨量的流动性份额",
   "start": 51.18,
   "end": 53.04,
   "id": "c25"
  },
  {
   "text": "提走池子资产",
   "start": 53.06,
   "end": 54.373,
   "id": "c26"
  },
  {
   "text": "约 2.23 亿美元",
   "start": 54.501,
   "end": 56.088,
   "id": "c27"
  },
  {
   "text": "Sui 验证者冻结了约 1.62 亿美元",
   "start": 57.068,
   "end": 60.13,
   "id": "c28"
  },
  {
   "text": "治理投票后",
   "start": 60.318,
   "end": 61.298,
   "id": "c29"
  },
  {
   "text": "转入共管多签",
   "start": 61.318,
   "end": 62.56,
   "id": "c30"
  },
  {
   "text": "用于赔付",
   "start": 62.58,
   "end": 63.404,
   "id": "c31"
  },
  {
   "text": "所以审计范围",
   "start": 64.392,
   "end": 65.645,
   "id": "c32"
  },
  {
   "text": "必须覆盖数学依赖库",
   "start": 65.761,
   "end": 67.395,
   "id": "c33"
  },
  {
   "text": "位移和乘法溢出",
   "start": 67.77,
   "end": 69.357,
   "id": "c34"
  },
  {
   "text": "要有显式检查",
   "start": 69.496,
   "end": 70.833,
   "id": "c35"
  },
  {
   "text": "语言的保证",
   "start": 71.812,
   "end": 72.827,
   "id": "c36"
  },
  {
   "text": "也依赖验证器本身没写错",
   "start": 72.895,
   "end": 74.803,
   "id": "c37"
  },
  {
   "text": "2023 年",
   "start": 75.776,
   "end": 76.767,
   "id": "c38"
  },
  {
   "text": "Zellic 发现",
   "start": 76.823,
   "end": 77.85,
   "id": "c39"
  },
  {
   "text": "Move 字节码验证器在处理超长函数时",
   "start": 77.978,
   "end": 81.065,
   "id": "c40"
  },
  {
   "text": "漏掉了控制流边",
   "start": 81.085,
   "end": 82.41,
   "id": "c41"
  },
  {
   "text": "两道安全检查被绕过",
   "start": 82.454,
   "end": 84.148,
   "id": "c42"
  },
  {
   "text": "这个漏洞已修复",
   "start": 85.116,
   "end": 86.464,
   "id": "c43"
  },
  {
   "text": "没有损失",
   "start": 86.508,
   "end": 87.464,
   "id": "c44"
  },
  {
   "text": "协议层的风险",
   "start": 88.456,
   "end": 89.673,
   "id": "c45"
  },
  {
   "text": "仍然在升级权限和部署流程",
   "start": 89.777,
   "end": 92.471,
   "id": "c46"
  },
  {
   "text": "2025 年 9 月",
   "start": 93.452,
   "end": 94.765,
   "id": "c47"
  },
  {
   "text": "Sui 上的 Nemo",
   "start": 94.785,
   "end": 96.098,
   "id": "c48"
  },
  {
   "text": "开发者在审计后",
   "start": 96.118,
   "end": 97.527,
   "id": "c49"
  },
  {
   "text": "私自部署了未审计的代码",
   "start": 97.547,
   "end": 99.503,
   "id": "c50"
  },
  {
   "text": "一个内部的闪电贷函数被设成公开",
   "start": 100.488,
   "end": 103.277,
   "id": "c51"
  },
  {
   "text": "升级权限只有单签",
   "start": 103.38,
   "end": 105.146,
   "id": "c52"
  },
  {
   "text": "损失约 240 万到约 260 万美元",
   "start": 105.521,
   "end": 108.667,
   "id": "c53"
  },
  {
   "text": "升级权限要用多签",
   "start": 109.66,
   "end": 111.639,
   "id": "c54"
  },
  {
   "text": "加时间锁",
   "start": 111.672,
   "end": 112.711,
   "id": "c55"
  },
  {
   "text": "部署的版本",
   "start": 113.062,
   "end": 114.101,
   "id": "c56"
  },
  {
   "text": "必须等于审计的版本",
   "start": 114.145,
   "end": 115.625,
   "id": "c57"
  }
 ]
}