 "captions": [
  {
   "text": "2025 年 11 月",
   "start": 1.55,
   "end": 3.044,
   "id": "c0"
  },
  {
   "text": "Balancer V2 的稳定池",
   "start": 3.254,
   "end": 5.144,
   "id": "c1"
  },
  {
   "text": "被人取走了资金",
   "start": 5.37,
   "end": 6.872,
   "id": "c2"
  },
  {
   "text": "官方复盘估算",
   "start": 7.221,
   "end": 8.438,
   "id": "c3"
  },
  {
   "text": "用户资金被盗约 9480 万美元",
   "start": 8.724,
   "end": 12.848,
   "id": "c4"
  },
  {
   "text": "根因 被定位在一处取整错误",
   "start": 13.209,
   "end": 15.851,
   "id": "c5"
  },
  {
   "text": "单次交换的误差很小",
   "start": 16.223,
   "end": 17.76,
   "id": "c6"
  },
  {
   "text": "攻击者把大量小额交换",
   "start": 18.042,
   "end": 20.308,
   "id": "c7"
  },
  {
   "text": "串进一笔批量交换",
   "start": 20.381,
   "end": 22.169,
   "id": "c8"
  },
  {
   "text": "每一步的误差",
   "start": 22.509,
   "end": 23.573,
   "id": "c9"
  },
  {
   "text": "都朝对自己有利的方向累积",
   "start": 23.755,
   "end": 25.86,
   "id": "c10"
  },
  {
   "text": "先猜一道题",
   "start": 26.07,
   "end": 27.059,
   "id": "c11"
  },
  {
   "text": "金库里 每份额值 1.5 个最小资产单位",
   "start": 27.202,
   "end": 31.334,
   "id": "c12"
  },
  {
   "text": "铸造 1 份额时",
   "start": 31.57,
   "end": 32.771,
   "id": "c13"
  },
  {
   "text": "合约把应收的 1.5 向下取整",
   "start": 32.936,
   "end": 35.966,
   "id": "c14"
  },
  {
   "text": "只收 1 个单位",
   "start": 36.124,
   "end": 37.262,
   "id": "c15"
  },
  {
   "text": "重复 1000 次",
   "start": 37.55,
   "end": 38.862,
   "id": "c16"
  },
  {
   "text": "调用者多拿了多少",
   "start": 39.109,
   "end": 40.948,
   "id": "c17"
  },
  {
   "text": "大约 500 个单位",
   "start": 41.49,
   "end": 42.927,
   "id": "c18"
  },
  {
   "text": "这些差额",
   "start": 43.511,
   "end": 44.394,
   "id": "c19"
  },
  {
   "text": "来自其他持有人",
   "start": 44.46,
   "end": 45.897,
   "id": "c20"
  },
  {
   "text": "EVM 只有整数",
   "start": 46.21,
   "end": 47.804,
   "id": "c21"
  },
  {
   "text": "每一次除法",
   "start": 47.824,
   "end": 49.549,
   "id": "c22"
  },
  {
   "text": "都会丢掉余数",
   "start": 49.704,
   "end": 50.913,
   "id": "c23"
  },
  {
   "text": "丢掉的余数归谁",
   "start": 51.306,
   "end": 52.752,
   "id": "c24"
  },
  {
   "text": "决定了谁能从协议里",
   "start": 53.063,
   "end": 55.311,
   "id": "c25"
  },
  {
   "text": "慢慢抠出钱",
   "start": 55.512,
   "end": 56.965,
   "id": "c26"
  },
  {
   "text": "这一集讲三件事",
   "start": 57.37,
   "end": 58.873,
   "id": "c27"
  },
  {
   "text": "数学缺陷",
   "start": 59.138,
   "end": 60.013,
   "id": "c28"
  },
  {
   "text": "舍入方向",
   "start": 60.254,
   "end": 61.133,
   "id": "c29"
  },
  {
   "text": "金库通胀",
   "start": 61.358,
   "end": 62.313,
   "id": "c30"
  }
 ]
}