 "captions": [
  {
   "text": "合约里的数学缺陷",
   "start": 1.648,
   "end": 3.222,
   "id": "c0"
  },
  {
   "text": "可以分成五类",
   "start": 3.279,
   "end": 4.413,
   "id": "c1"
  },
  {
   "text": "溢出 截断",
   "start": 5.396,
   "end": 6.887,
   "id": "c2"
  },
  {
   "text": "先除后乘",
   "start": 7.062,
   "end": 8.268,
   "id": "c3"
  },
  {
   "text": "舍入方向",
   "start": 8.348,
   "end": 9.399,
   "id": "c4"
  },
  {
   "text": "单位不一致",
   "start": 9.491,
   "end": 10.566,
   "id": "c5"
  },
  {
   "text": "第一类 溢出",
   "start": 11.544,
   "end": 12.999,
   "id": "c6"
  },
  {
   "text": "整数有上限",
   "start": 13.363,
   "end": 14.687,
   "id": "c7"
  },
  {
   "text": "超过上限",
   "start": 14.767,
   "end": 15.783,
   "id": "c8"
  },
  {
   "text": "结果会回绕",
   "start": 15.863,
   "end": 17.056,
   "id": "c9"
  },
  {
   "text": "2018 年 4 月",
   "start": 18.052,
   "end": 19.341,
   "id": "c10"
  },
  {
   "text": "以太坊上的 BEC 代币",
   "start": 19.504,
   "end": 21.127,
   "id": "c11"
  },
  {
   "text": "栽在批量转账上",
   "start": 21.147,
   "end": 22.626,
   "id": "c12"
  },
  {
   "text": "合约用 0.4 版的 Solidity 写成",
   "start": 23.6,
   "end": 26.127,
   "id": "c13"
  },
  {
   "text": "没有溢出检查",
   "start": 26.183,
   "end": 27.317,
   "id": "c14"
  },
  {
   "text": "函数先算总额",
   "start": 28.308,
   "end": 29.787,
   "id": "c15"
  },
  {
   "text": "接收人数",
   "start": 29.903,
   "end": 30.942,
   "id": "c16"
  },
  {
   "text": "乘以每人的金额",
   "start": 30.962,
   "end": 32.275,
   "id": "c17"
  },
  {
   "text": "攻击者填了 2 个接收地址",
   "start": 33.256,
   "end": 35.318,
   "id": "c18"
  },
  {
   "text": "每人 2 的 255 次方",
   "start": 35.506,
   "end": 37.568,
   "id": "c19"
  },
  {
   "text": "2 乘以 2 的 255 次方",
   "start": 38.54,
   "end": 40.614,
   "id": "c20"
  },
  {
   "text": "是 2 的 256 次方",
   "start": 40.718,
   "end": 42.424,
   "id": "c21"
  },
  {
   "text": "它刚好超出 256 位整数的上限",
   "start": 43.392,
   "end": 46.073,
   "id": "c22"
  },
  {
   "text": "回绕成了 0",
   "start": 46.154,
   "end": 47.538,
   "id": "c23"
  },
  {
   "text": "余额检查比较的是 0",
   "start": 48.508,
   "end": 50.166,
   "id": "c24"
  },
  {
   "text": "直接通过",
   "start": 50.281,
   "end": 51.237,
   "id": "c25"
  },
  {
   "text": "发送者被扣掉的 也是 0",
   "start": 51.612,
   "end": 53.985,
   "id": "c26"
  },
  {
   "text": "两个接收者",
   "start": 54.968,
   "end": 56.019,
   "id": "c27"
  },
  {
   "text": "却各自收到 2 的 255 次方",
   "start": 56.075,
   "end": 58.566,
   "id": "c28"
  },
  {
   "text": "代币凭空出现",
   "start": 59.532,
   "end": 60.785,
   "id": "c29"
  },
  {
   "text": "按公开报道",
   "start": 61.16,
   "end": 62.33,
   "id": "c30"
  },
  {
   "text": "多家交易所暂停了 BEC 充提",
   "start": 62.494,
   "end": 64.89,
   "id": "c31"
  },
  {
   "text": "到了 0.8 版以后",
   "start": 65.872,
   "end": 67.173,
   "id": "c32"
  },
  {
   "text": "算术默认检查溢出",
   "start": 67.276,
   "end": 69.006,
   "id": "c33"
  },
  {
   "text": "但有三处",
   "start": 70.004,
   "end": 70.983,
   "id": "c34"
  },
  {
   "text": "仍会静默回绕",
   "start": 71.182,
   "end": 72.483,
   "id": "c35"
  },
  {
   "text": "unchecked 块",
   "start": 72.563,
   "end": 73.686,
   "id": "c36"
  },
  {
   "text": "内联汇编",
   "start": 73.777,
   "end": 74.745,
   "id": "c37"
  },
  {
   "text": "类型转换",
   "start": 74.777,
   "end": 75.757,
   "id": "c38"
  },
  {
   "text": "移位运算也不检查溢出",
   "start": 76.752,
   "end": 78.803,
   "id": "c39"
  },
  {
   "text": "第二类 截断",
   "start": 79.804,
   "end": 81.378,
   "id": "c40"
  },
  {
   "text": "大类型转成小类型",
   "start": 81.742,
   "end": 83.531,
   "id": "c41"
  },
  {
   "text": "高位被丢掉 不报错",
   "start": 83.658,
   "end": 85.459,
   "id": "c42"
  },
  {
   "text": "第三类 先除后乘",
   "start": 86.432,
   "end": 88.518,
   "id": "c43"
  },
  {
   "text": "看一组小数字 7 乘 3 除以 5",
   "start": 88.894,
   "end": 91.885,
   "id": "c44"
  },
  {
   "text": "先除 7 除以 5 等于 1",
   "start": 92.844,
   "end": 95.109,
   "id": "c45"
  },
  {
   "text": "余数丢掉",
   "start": 95.248,
   "end": 96.192,
   "id": "c46"
  },
  {
   "text": "再乘 3 结果是 3",
   "start": 96.567,
   "end": 98.392,
   "id": "c47"
  },
  {
   "text": "先乘 7 乘 3 等于 21",
   "start": 99.376,
   "end": 101.76,
   "id": "c48"
  },
  {
   "text": "再除以 5",
   "start": 101.864,
   "end": 102.665,
   "id": "c49"
  },
  {
   "text": "结果是 4",
   "start": 102.685,
   "end": 103.522,
   "id": "c50"
  },
  {
   "text": "先除的结果少了 1",
   "start": 104.492,
   "end": 106.114,
   "id": "c51"
  },
  {
   "text": "丢掉的误差",
   "start": 106.489,
   "end": 107.576,
   "id": "c52"
  },
  {
   "text": "被后面的乘法放大了",
   "start": 107.632,
   "end": 109.183,
   "id": "c53"
  },
  {
   "text": "所以要先乘后除",
   "start": 110.16,
   "end": 111.949,
   "id": "c54"
  },
  {
   "text": "更好的做法",
   "start": 112.324,
   "end": 113.244,
   "id": "c55"
  },
  {
   "text": "是用 mulDiv",
   "start": 113.264,
   "end": 114.625,
   "id": "c56"
  },
  {
   "text": "它的中间结果有 512 位",
   "start": 115.612,
   "end": 117.913,
   "id": "c57"
  },
  {
   "text": "不会溢出",
   "start": 117.969,
   "end": 118.841,
   "id": "c58"
  },
  {
   "text": "并且能指定舍入方向",
   "start": 118.933,
   "end": 120.532,
   "id": "c59"
  },
  {
   "text": "第四类舍入方向",
   "start": 121.52,
   "end": 123.023,
   "id": "c60"
  },
  {
   "text": "下一段讲",
   "start": 123.091,
   "end": 123.999,
   "id": "c61"
  },
  {
   "text": "先看第五类",
   "start": 124.362,
   "end": 125.651,
   "id": "c62"
  },
  {
   "text": "单位不一致",
   "start": 125.779,
   "end": 126.854,
   "id": "c63"
  },
  {
   "text": "同样叫 USDT",
   "start": 127.836,
   "end": 129.744,
   "id": "c64"
  },
  {
   "text": "以太坊上是 6 位小数",
   "start": 129.788,
   "end": 131.506,
   "id": "c65"
  },
  {
   "text": "TRON 上也是 6 位",
   "start": 131.574,
   "end": 132.922,
   "id": "c66"
  },
  {
   "text": "BNB Chain 上的 BSC-USD",
   "start": 133.912,
   "end": 136.356,
   "id": "c67"
  },
  {
   "text": "却是 18 位",
   "start": 136.376,
   "end": 137.427,
   "id": "c68"
  },
  {
   "text": "把以太坊的代码原样搬过去",
   "start": 138.404,
   "end": 140.824,
   "id": "c69"
  },
  {
   "text": "又写死了 6 位精度",
