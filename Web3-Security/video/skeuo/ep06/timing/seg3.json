 "captions": [
  {
   "text": "整数除法会丢掉余数",
   "start": 1.648,
   "end": 3.841,
   "id": "c0"
  },
  {
   "text": "问题是 余数归谁",
   "start": 4.217,
   "end": 6.28,
   "id": "c1"
  },
  {
   "text": "规则只有一条",
   "start": 7.268,
   "end": 8.557,
   "id": "c2"
  },
  {
   "text": "余数归协议",
   "start": 8.791,
   "end": 9.961,
   "id": "c3"
  },
  {
   "text": "不归调用者",
   "start": 9.994,
   "end": 11.08,
   "id": "c4"
  },
  {
   "text": "拿 ERC-4626 金库来看",
   "start": 12.048,
   "end": 14.456,
   "id": "c5"
  },
  {
   "text": "四个函数",
   "start": 14.571,
   "end": 15.503,
   "id": "c6"
  },
  {
   "text": "四个方向",
   "start": 15.524,
   "end": 16.396,
   "id": "c7"
  },
  {
   "text": "deposit",
   "start": 17.38,
   "end": 18.216,
   "id": "c8"
  },
  {
   "text": "用户给资产 拿份额",
   "start": 18.284,
   "end": 20.3,
   "id": "c9"
  },
  {
   "text": "份额向下取整 少给",
   "start": 20.663,
   "end": 22.988,
   "id": "c10"
  },
  {
   "text": "mint",
   "start": 23.96,
   "end": 24.606,
   "id": "c11"
  },
  {
   "text": "用户指定份额",
   "start": 24.733,
   "end": 26.07,
   "id": "c12"
  },
  {
   "text": "算要付多少资产",
   "start": 26.091,
   "end": 27.522,
   "id": "c13"
  },
  {
   "text": "资产向上取整 多收",
   "start": 27.898,
   "end": 30.044,
   "id": "c14"
  },
  {
   "text": "withdraw",
   "start": 31.02,
   "end": 31.975,
   "id": "c15"
  },
  {
   "text": "用户指定资产",
   "start": 32.079,
   "end": 33.38,
   "id": "c16"
  },
  {
   "text": "算要扣多少份额",
   "start": 33.484,
   "end": 35.011,
   "id": "c17"
  },
  {
   "text": "份额向上取整 多扣",
   "start": 35.386,
   "end": 37.544,
   "id": "c18"
  },
  {
   "text": "redeem",
   "start": 38.536,
   "end": 39.301,
   "id": "c19"
  },
  {
   "text": "用户交出份额 拿资产",
   "start": 39.512,
   "end": 41.729,
   "id": "c20"
  },
  {
   "text": "资产向下取整 少给",
   "start": 42.093,
   "end": 44.429,
   "id": "c21"
  },
  {
   "text": "记成一句话",
   "start": 45.404,
   "end": 46.55,
   "id": "c22"
  },
  {
   "text": "给出去的 向下",
   "start": 46.654,
   "end": 48.407,
   "id": "c23"
  },
  {
   "text": "收进来的 向上",
   "start": 48.535,
   "end": 50.371,
   "id": "c24"
  },
  {
   "text": "方向反了会怎样",
   "start": 51.36,
   "end": 52.589,
   "id": "c25"
  },
  {
   "text": "攻击者可以做往返套利",
   "start": 52.964,
   "end": 54.92,
   "id": "c26"
  },
  {
   "text": "反复 mint 1 份额",
   "start": 55.9,
   "end": 57.272,
   "id": "c27"
  },
  {
   "text": "再 redeem",
   "start": 57.292,
   "end": 58.129,
   "id": "c28"
  },
  {
   "text": "每次净赚 1 个单位的舍入误差",
   "start": 58.233,
   "end": 60.462,
   "id": "c29"
  },
  {
   "text": "单次很小",
   "start": 61.448,
   "end": 62.606,
   "id": "c30"
  },
  {
   "text": "但在没有手续费的场景下",
   "start": 62.969,
   "end": 64.782,
   "id": "c31"
  },
  {
   "text": "可以循环上千次",
   "start": 64.862,
   "end": 66.306,
   "id": "c32"
  },
  {
   "text": "打个比方",
   "start": 67.308,
   "end": 68.263,
   "id": "c33"
  },
  {
   "text": "披萨店按块卖",
   "start": 68.627,
   "end": 69.809,
   "id": "c34"
  },
  {
   "text": "一张披萨切 8 块",
   "start": 69.96,
   "end": 71.535,
   "id": "c35"
  },
  {
   "text": "你付三分之一张的钱",
   "start": 72.52,
   "end": 74.082,
   "id": "c36"
  },
  {
   "text": "店员要决定",
   "start": 74.282,
   "end": 75.285,
   "id": "c37"
  },
  {
   "text": "给你 2 块还是 3 块",
   "start": 75.424,
   "end": 77.118,
   "id": "c38"
  },
  {
   "text": "如果店员总往多了给",
   "start": 78.092,
   "end": 79.714,
   "id": "c39"
  },
  {
   "text": "聪明的顾客",
   "start": 79.854,
   "end": 80.798,
   "id": "c40"
  },
  {
   "text": "就反复买三分之一张",
   "start": 80.818,
   "end": 82.464,
   "id": "c41"
  },
  {
   "text": "比方在这里不成立",
   "start": 83.448,
   "end": 84.796,
   "id": "c42"
  },
  {
   "text": "披萨店会被投诉",
   "start": 84.971,
   "end": 86.403,
   "id": "c43"
  },
  {
   "text": "合约里 多拿 1 wei 的操作",
   "start": 87.388,
   "end": 89.57,
   "id": "c44"
  },
  {
   "text": "可以在一笔交易里重复几千次",
   "start": 89.59,
   "end": 91.879,
   "id": "c45"
  },
  {
   "text": "回到 Balancer",
   "start": 92.864,
   "end": 94.248,
   "id": "c46"
  },
  {
   "text": "按公开分析",
   "start": 94.623,
   "end": 95.841,
   "id": "c47"
  },
  {
   "text": "问题出在稳定池的批量交换里",
   "start": 96.004,
   "end": 98.353,
   "id": "c48"
  },
  {
   "text": "攻击者串联大量小额交换",
   "start": 99.324,
   "end": 101.47,
   "id": "c49"
  },
  {
   "text": "让每一步的舍入",
   "start": 101.645,
   "end": 102.851,
   "id": "c50"
  },
  {
   "text": "都朝自己累积",
   "start": 102.919,
   "end": 104.101,
   "id": "c51"
  },
  {
   "text": "池子的不变量和份额价格",
   "start": 105.088,
   "end": 107.412,
   "id": "c52"
  },
  {
   "text": "因此被操纵",
   "start": 107.492,
   "end": 108.543,
   "id": "c53"
  },
  {
   "text": "官方估算的约 9480 万美元",
   "start": 109.508,
   "end": 112.261,
   "id": "c54"
  },
  {
   "text": "按事发时估值",
   "start": 112.329,
   "end": 113.642,
   "id": "c55"
  },
  {
   "text": "只算 Balancer 部署的池子",
   "start": 113.662,
   "end": 115.487,
   "id": "c56"
  },
  {
   "text": "早期第三方分析的数字是约 1.28 亿美元",
   "start": 116.472,
   "end": 119.963,
   "id": "c57"
  },
  {
   "text": "引用时要写明口径",
   "start": 120.338,
   "end": 122.044,
   "id": "c58"
  },
  {
   "text": "再往前 2023 年 11 月",
   "start": 123.028,
   "end": 125.483,
   "id": "c59"
  },
  {
   "text": "KyberSwap Elastic 也栽在方向上",
   "start": 125.575,
   "end": 128.09,
