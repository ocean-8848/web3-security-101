   "end": 36.651,
   "id": "c16"
  },
  {
   "text": "直接往金库转入 1 万 USDC",
   "start": 36.755,
   "end": 39.306,
   "id": "c17"
  },
  {
   "text": "现在总份额只有 1",
   "start": 40.296,
   "end": 41.847,
   "id": "c18"
  },
  {
   "text": "总资产是 1 万 USDC",
   "start": 41.915,
   "end": 44.038,
   "id": "c19"
  },
  {
   "text": "再加 1 个最小单位",
   "start": 44.058,
   "end": 45.358,
   "id": "c20"
  },
  {
   "text": "第三步 受害者存入 9999 USDC",
   "start": 46.348,
   "end": 50.387,
   "id": "c21"
  },
  {
   "text": "他的份额",
   "start": 51.368,
   "end": 52.121,
   "id": "c22"
  },
  {
   "text": "是 9999 USDC 乘以 1",
   "start": 52.141,
   "end": 55.264,
   "id": "c23"
  },
  {
   "text": "除以略多于 1 万 USDC",
   "start": 55.368,
   "end": 57.419,
   "id": "c24"
  },
  {
   "text": "结果小于 1",
   "start": 58.404,
   "end": 59.49,
   "id": "c25"
  },
  {
   "text": "向下取整 是 0",
   "start": 59.594,
   "end": 61.514,
   "id": "c26"
  },
  {
   "text": "受害者的资产进了金库",
   "start": 62.488,
   "end": 64.372,
   "id": "c27"
  },
  {
   "text": "却一份也没拿到",
   "start": 64.583,
   "end": 66.122,
   "id": "c28"
  },
  {
   "text": "第四步 攻击者赎回那 1 份额",
   "start": 67.124,
   "end": 69.675,
   "id": "c29"
  },
  {
   "text": "取回约 19999 USDC",
   "start": 69.695,
   "end": 72.865,
   "id": "c30"
  },
  {
   "text": "这 1 份额",
   "start": 73.848,
   "end": 74.827,
   "id": "c31"
  },
  {
   "text": "代表了金库的全部资产",
   "start": 74.848,
   "end": 76.601,
   "id": "c32"
  },
  {
   "text": "受害者的存款",
   "start": 76.976,
   "end": 78.337,
   "id": "c33"
  },
  {
   "text": "等于捐给了它",
   "start": 78.44,
   "end": 79.551,
   "id": "c34"
  },
  {
   "text": "攻击者通常会抢跑受害者的第一笔存款交易",
   "start": 80.524,
   "end": 84.015,
   "id": "c35"
  },
  {
   "text": "攻击成本",
   "start": 85.016,
   "end": 86.078,
   "id": "c36"
  },
  {
   "text": "就是捐赠额",
   "start": 86.23,
   "end": 87.4,
   "id": "c37"
  },
  {
   "text": "受害者的存款接近捐赠额",
   "start": 87.763,
   "end": 90.231,
   "id": "c38"
  },
  {
   "text": "攻击就有利可图",
   "start": 90.275,
   "end": 91.719,
   "id": "c39"
  },
  {
   "text": "成立条件也要说清",
   "start": 92.7,
   "end": 94.251,
   "id": "c40"
  },
  {
   "text": "金库必须几乎是空的",
   "start": 94.438,
   "end": 96.084,
   "id": "c41"
  },
  {
   "text": "金库规模越大",
   "start": 97.072,
   "end": 98.396,
   "id": "c42"
  },
  {
   "text": "攻击成本越高",
   "start": 98.5,
   "end": 99.742,
   "id": "c43"
  },
  {
   "text": "换成披萨店",
   "start": 100.724,
   "end": 101.81,
   "id": "c44"
  },
  {
   "text": "第一个顾客买下整张披萨",
   "start": 102.021,
   "end": 104.156,
   "id": "c45"
  },
  {
   "text": "只切成 1 块",
   "start": 104.271,
   "end": 105.298,
   "id": "c46"
  },
  {
   "text": "然后往盒子里偷偷塞进 100 张披萨",
   "start": 106.272,
   "end": 109.239,
   "id": "c47"
  },
  {
   "text": "下一个顾客付了 99 张的钱",
   "start": 110.236,
   "end": 112.537,
   "id": "c48"
  },
  {
   "text": "因为 1 块披萨值 101 张",
   "start": 112.676,
   "end": 114.525,
   "id": "c49"
  },
  {
   "text": "他一块也分不到",
   "start": 114.617,
   "end": 115.739,
   "id": "c50"
  }
 ]
}