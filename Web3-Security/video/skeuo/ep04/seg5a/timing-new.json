 "captions": [
  {
   "text": "重入的入口",
   "start": 1.648,
   "end": 2.71,
   "id": "c0"
  },
  {
   "text": "不只是转 ETH",
   "start": 2.731,
   "end": 3.972,
   "id": "c1"
  },
  {
   "text": "2020 年 4 月的 imBTC",
   "start": 4.94,
   "end": 7.217,
   "id": "c2"
  },
  {
   "text": "是一种 ERC-777 代币",
   "start": 7.249,
   "end": 9.372,
   "id": "c3"
  },
  {
   "text": "转账时 会回调持有人注册的钩子",
   "start": 9.735,
   "end": 12.655,
   "id": "c4"
  },
  {
   "text": "借贷协议 Lendf.Me 的存款函数",
   "start": 13.656,
   "end": 16.207,
   "id": "c5"
  },
  {
   "text": "返回时用旧值写回余额",
   "start": 16.37,
   "end": 18.504,
   "id": "c6"
  },
  {
   "text": "抵押记录因此虚高",
   "start": 18.572,
   "end": 20.111,
   "id": "c7"
  },
  {
   "text": "攻击者借走约 2500 万美元的资产",
   "start": 21.1,
   "end": 23.924,
   "id": "c8"
  },
  {
   "text": "按事发时估值",
   "start": 24.064,
   "end": 25.496,
   "id": "c9"
  },
  {
   "text": "据 The Block 报道",
   "start": 25.871,
   "end": 27.065,
   "id": "c10"
  },
  {
   "text": "资金后来已归还",
   "start": 27.169,
   "end": 28.458,
   "id": "c11"
  },
  {
   "text": "在 BNB Chain 上",
   "start": 29.432,
   "end": 31.054,
   "id": "c12"
  },
  {
   "text": "很多项目分叉自以太坊协议",
   "start": 31.205,
   "end": 33.316,
   "id": "c13"
  },
  {
   "text": "原协议只接受白名单代币",
   "start": 34.308,
   "end": 36.513,
   "id": "c14"
  },
  {
   "text": "分叉项目放开成任意代币都能上架",
   "start": 36.889,
   "end": 39.582,
   "id": "c15"
  },
  {
   "text": "却没给存款函数加锁",
   "start": 39.65,
   "end": 41.44,
   "id": "c16"
  },
  {
   "text": "攻击者上架一个自己部署的代币",
   "start": 42.424,
   "end": 44.653,
   "id": "c17"
  },
  {
   "text": "在转账函数里回调存款",
   "start": 44.745,
   "end": 46.701,
   "id": "c18"
  },
  {
   "text": "同一笔资产被记了两次",
   "start": 46.805,
   "end": 48.832,
   "id": "c19"
  },
  {
   "text": "允许任意代币",
   "start": 49.82,
   "end": 51.157,
   "id": "c20"
  },
  {
   "text": "就等于允许任意回调",
   "start": 51.177,
   "end": 52.966,
   "id": "c21"
  },
  {
   "text": "上架流程本身",
   "start": 53.341,
   "end": 54.892,
   "id": "c22"
  },
  {
   "text": "就是安全边界",
   "start": 54.912,
   "end": 56.059,
   "id": "c23"
  },
  {
   "text": "2024 年 9 月的 Penpie 也类似",
   "start": 57.048,
   "end": 59.634,
   "id": "c24"
  },
  {
   "text": "损失约 2700 万美元",
   "start": 59.81,
   "end": 62.003,
   "id": "c25"
  },
  {
   "text": "攻击者无许可创建市场",
   "start": 63.004,
   "end": 65.031,
   "id": "c26"
  },
  {
   "text": "市场用了恶意代币",
   "start": 65.099,
   "end": 66.507,
   "id": "c27"
  },
  {
   "text": "批量领取奖励的函数没有锁",
   "start": 67.496,
   "end": 69.558,
   "id": "c28"
  },
  {
   "text": "攻击者在回调里存入资产",
   "start": 69.781,
   "end": 71.892,
   "id": "c29"
  },
  {
   "text": "把存款变成了奖励",
   "start": 71.96,
   "end": 73.547,
   "id": "c30"
  },
  {
   "text": "所以审计的第一步",
   "start": 74.532,
   "end": 76.393,
   "id": "c31"
  },
  {
   "text": "是列出所有外部调用",
   "start": 76.413,
   "end": 78.106,
   "id": "c32"
  },
  {
   "text": "代币转账",
   "start": 78.482,
   "end": 79.413,
   "id": "c33"
  },
  {
   "text": "NFT 安全转账 回调",
   "start": 79.541,
   "end": 81.723,
   "id": "c34"
  },
  {
   "text": "低级 call",
   "start": 81.791,
   "end": 82.533,
   "id": "c35"
  },
  {
   "text": "一个都不漏",
   "start": 82.624,
   "end": 83.425,
   "id": "c36"
  },
  {
   "text": "然后对每一处问两句",
   "start": 84.4,
   "end": 86.093,
   "id": "c37"
  },
  {
   "text": "调用之前",
   "start": 87.068,
   "end": 88.071,
   "id": "c38"
  },
  {
   "text": "相关状态都更新到最终值了吗",
   "start": 88.222,
   "end": 90.69,
   "id": "c39"
  },
  {
   "text": "读写同一状态的入口",
   "start": 91.96,
   "end": 93.618,
   "id": "c40"
  },
  {
   "text": "共用同一把锁吗",
   "start": 93.722,
   "end": 94.999,
   "id": "c41"
  }
 ]
