 "captions": [
  {
   "text": "2025 年 2 月",
   "start": 1.55,
   "end": 2.85,
   "id": "c0"
  },
  {
   "text": "Bybit 的多签签名人",
   "start": 3.065,
   "end": 4.889,
   "id": "c1"
  },
  {
   "text": "签了一笔看起来很正常的交易",
   "start": 4.989,
   "end": 7.252,
   "id": "c2"
  },
  {
   "text": "可他们用的 Safe 钱包网页前端",
   "start": 7.53,
   "end": 9.944,
   "id": "c3"
  },
  {
   "text": "已经被人篡改了",
   "start": 10.102,
   "end": 11.471,
   "id": "c4"
  },
  {
   "text": "签下去的这笔交易",
   "start": 11.842,
   "end": 13.131,
   "id": "c5"
  },
  {
   "text": "替换了多签的实现合约",
   "start": 13.319,
   "end": 15.293,
   "id": "c6"
  },
  {
   "text": "约 15 亿美元",
   "start": 15.66,
   "end": 17.484,
   "id": "c7"
  },
  {
   "text": "就这样被转走",
   "start": 17.514,
   "end": 18.869,
   "id": "c8"
  },
  {
   "text": "先请你猜一猜",
   "start": 19.07,
   "end": 20.212,
   "id": "c9"
  },
  {
   "text": "Safe 多签合约的代码",
   "start": 20.271,
   "end": 22.086,
   "id": "c10"
  },
  {
   "text": "有没有被利用的漏洞",
   "start": 22.23,
   "end": 23.662,
   "id": "c11"
  },
  {
   "text": "如果没有",
   "start": 24.21,
   "end": 25.143,
   "id": "c12"
  },
  {
   "text": "钱又是从哪里漏出去的",
   "start": 25.224,
   "end": 27.338,
   "id": "c13"
  },
  {
   "text": "这一集是整个系列的入口",
   "start": 28.013,
   "end": 30.117,
   "id": "c14"
  },
  {
   "text": "我们要回答三个问题",
   "start": 30.339,
   "end": 31.936,
   "id": "c15"
  },
  {
   "text": "合约安全和传统安全",
   "start": 32.21,
   "end": 34.532,
   "id": "c16"
  },
  {
   "text": "到底哪里不一样",
   "start": 34.643,
   "end": 35.884,
   "id": "c17"
  },
  {
   "text": "攻击会从哪些地方进来",
   "start": 36.562,
   "end": 38.479,
   "id": "c18"
  },
  {
   "text": "怎么站在攻击者的角度",
   "start": 39.05,
   "end": 41.054,
   "id": "c19"
  },
  {
   "text": "给一个系统建模",
   "start": 41.195,
   "end": 42.405,
   "id": "c20"
  },
  {
   "text": "开头那个问题的答案",
   "start": 43.005,
   "end": 44.408,
   "id": "c21"
  },
  {
   "text": "留到最后揭晓",
   "start": 44.577,
   "end": 45.679,
   "id": "c22"
  }
 ]
