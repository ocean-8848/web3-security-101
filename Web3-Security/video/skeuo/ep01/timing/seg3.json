 "captions": [
  {
   "text": "知道了合约是什么",
   "start": 1.648,
   "end": 2.913,
   "id": "c0"
  },
  {
   "text": "我们跟着一笔交易",
   "start": 3.076,
   "end": 4.484,
   "id": "c1"
  },
  {
   "text": "看攻击从哪里进来",
   "start": 4.529,
   "end": 5.877,
   "id": "c2"
  },
  {
   "text": "用户或者攻击者的账户",
   "start": 6.86,
   "end": 8.709,
   "id": "c3"
  },
  {
   "text": "先经过钱包和前端的签名界面",
   "start": 8.729,
   "end": 11.458,
   "id": "c4"
  },
  {
   "text": "交易进入内存池",
   "start": 12.456,
   "end": 13.995,
   "id": "c5"
  },
  {
   "text": "在那里公开排队",
   "start": 14.015,
   "end": 15.399,
   "id": "c6"
  },
  {
   "text": "区块构建者或者排序器",
   "start": 16.396,
   "end": 18.53,
   "id": "c7"
  },
  {
   "text": "决定它和别的交易谁先谁后",
   "start": 18.705,
   "end": 21.137,
   "id": "c8"
  },
  {
   "text": "然后它到达目标合约",
   "start": 22.112,
   "end": 24.222,
   "id": "c9"
  },
  {
   "text": "执行业务逻辑",
   "start": 24.254,
   "end": 25.567,
   "id": "c10"
  },
  {
   "text": "目标合约会去调用外部合约",
   "start": 26.556,
   "end": 29.19,
   "id": "c11"
  },
  {
   "text": "比如代币 DEX 预言机",
   "start": 29.353,
   "end": 31.857,
   "id": "c12"
  },
  {
   "text": "它背后还连着代理和实现",
   "start": 32.232,
   "end": 34.402,
   "id": "c13"
  },
  {
   "text": "也就是升级权限",
   "start": 34.529,
   "end": 35.878,
   "id": "c14"
  },
  {
   "text": "有的交易",
   "start": 36.88,
   "end": 37.752,
   "id": "c15"
  },
  {
   "text": "还要经过跨链桥",
   "start": 37.88,
   "end": 39.192,
   "id": "c16"
  },
  {
   "text": "去到另一条链上的合约",
   "start": 39.213,
   "end": 40.776,
   "id": "c17"
  },
  {
   "text": "这条路上",
   "start": 41.756,
   "end": 42.664,
   "id": "c18"
  },
  {
   "text": "有五个地方最危险",
   "start": 42.756,
   "end": 44.199,
   "id": "c19"
  },
  {
   "text": "签名界面 内存池",
   "start": 44.327,
   "end": 46.39,
   "id": "c20"
  },
  {
   "text": "外部合约",
   "start": 46.506,
   "end": 47.45,
   "id": "c21"
  },
  {
   "text": "升级权限 跨链桥",
   "start": 47.47,
   "end": 49.616,
   "id": "c22"
  },
  {
   "text": "它们叫信任边界",
   "start": 50.592,
   "end": 51.94,
   "id": "c23"
  },
  {
   "text": "数据和控制权在这里跨过去",
   "start": 52.315,
   "end": 54.783,
   "id": "c24"
  },
  {
   "text": "漏洞也最集中",
   "start": 54.887,
   "end": 56.152,
   "id": "c25"
  },
  {
   "text": "注意一个往回走的箭头",
   "start": 57.124,
   "end": 58.794,
   "id": "c26"
  },
  {
   "text": "外部合约可以在你的函数执行到一半时",
   "start": 59.157,
   "end": 62.113,
   "id": "c27"
  },
  {
   "text": "调回你的合约",
   "start": 62.228,
   "end": 63.244,
   "id": "c28"
  },
  {
   "text": "重入就发生在这里",
   "start": 63.621,
   "end": 65.089,
   "id": "c29"
  },
  {
   "text": "内存池和构建者决定交易的顺序",
   "start": 66.056,
   "end": 68.988,
   "id": "c30"
  },
  {
   "text": "顺序本身",
   "start": 69.363,
   "end": 70.509,
   "id": "c31"
  },
  {
   "text": "也可以被利用",
   "start": 70.613,
   "end": 71.592,
   "id": "c32"
  },
  {
   "text": "这张图也有局限",
   "start": 72.588,
   "end": 74.186,
   "id": "c33"
  },
  {
   "text": "它没画链本身的共识和节点",
   "start": 74.561,
   "end": 76.624,
   "id": "c34"
  },
  {
   "text": "链被攻破",
   "start": 77.608,
   "end": 78.659,
   "id": "c35"
  },
  {
   "text": "或者节点数据有误",
   "start": 78.739,
   "end": 80.111,
   "id": "c36"
  },
  {
   "text": "合约写得再对也没用",
   "start": 80.227,
   "end": 82.182,
   "id": "c37"
  },
  {
   "text": "沿着这张图",
   "start": 83.156,
   "end": 84.326,
   "id": "c38"
  },
  {
   "text": "可以把漏洞归成六大类",
   "start": 84.37,
   "end": 86.326,
   "id": "c39"
  },
  {
   "text": "第一类 控制流",
   "start": 87.312,
   "end": 88.958,
   "id": "c40"
  },
  {
   "text": "外部调用让攻击者插队执行",
   "start": 89.333,
   "end": 91.491,
   "id": "c41"
  },
  {
   "text": "比如重入",
   "start": 91.643,
   "end": 92.539,
   "id": "c42"
  },
  {
   "text": "第二类 权限",
   "start": 93.508,
   "end": 95.142,
   "id": "c43"
  },
  {
   "text": "不该调用的人调用了",
   "start": 95.505,
   "end": 97.044,
   "id": "c44"
  },
  {
   "text": "比如缺少修饰器",
   "start": 97.065,
   "end": 98.401,
   "id": "c45"
  },
  {
   "text": "合约未初始化",
   "start": 98.577,
   "end": 99.747,
   "id": "c46"
  },
  {
   "text": "私钥泄露",
   "start": 99.791,
   "end": 100.759,
   "id": "c47"
  },
  {
   "text": "第三类 数学",
   "start": 101.744,
   "end": 103.449,
   "id": "c48"
  },
  {
   "text": "数字算错了",
   "start": 103.813,
   "end": 105.042,
   "id": "c49"
  },
  {
   "text": "比如溢出",
   "start": 105.098,
   "end": 105.971,
   "id": "c50"
  },
  {
   "text": "精度损失",
   "start": 106.003,
   "end": 107.078,
   "id": "c51"
  },
  {
   "text": "舍入方向",
   "start": 107.134,
   "end": 108.114,
   "id": "c52"
  },
  {
   "text": "第四类 数据可信度",
   "start": 109.116,
   "end": 111.071,
   "id": "c53"
  },
  {
   "text": "合约相信了可以被操纵的数据",
   "start": 111.447,
   "end": 113.664,
   "id": "c54"
  },
  {
   "text": "比如现货价格预言机",
   "start": 113.78,
   "end": 115.379,
   "id": "c55"
  },
  {
   "text": "签名重放",
   "start": 115.399,
   "end": 116.438,
   "id": "c56"
  },
  {
   "text": "第五类 经济设计",
   "start": 117.424,
   "end": 119.248,
   "id": "c57"
  },
  {
   "text": "代码按规格执行",
   "start": 119.624,
   "end": 121.198,
   "id": "c58"
  },
  {
   "text": "但规格本身可以被套利",
   "start": 121.35,
   "end": 123.448,
   "id": "c59"
  },
  {
   "text": "第六类 系统与运营",
   "start": 124.436,
   "end": 126.606,
   "id": "c60"
  },
  {
   "text": "代码之外的环节失守",
   "start": 126.981,
   "end": 128.603,
   "id": "c61"
  },
  {
   "text": "比如跨链验证",
   "start": 128.683,
   "end": 129.817,
   "id": "c62"
  },
  {
   "text": "多签私钥",
   "start": 129.898,
   "end": 130.853,
   "id": "c63"
  },
  {
   "text": "前端篡改",
   "start": 130.909,
   "end": 132.032,
   "id": "c64"
  },
  {
   "text": "社会工程",
   "start": 132.052,
   "end": 133.127,
   "id": "c65"
  },
  {
   "text": "真实事故往往是几类叠加",
   "start": 134.112,
   "end": 136.555,
   "id": "c66"
  },
  {
   "text": "2023 年的 Euler",
   "start": 136.931,
   "end": 138.256,
   "id": "c67"
  },
  {
   "text": "就是业务逻辑缺陷",
   "start": 138.276,
   "end": 139.78,
   "id": "c68"
  },
  {
   "text": "加上闪电贷放大",
   "start": 139.8,
   "end": 141.255,
   "id": "c69"
  },
  {
   "text": "第六类 又可以拆成两块",
   "start": 142.252,
   "end": 144.541,
   "id": "c70"
  },
  {
   "text": "一块是链本身",
   "start": 144.904,
   "end": 146.169,
   "id": "c71"
  },
  {
   "text": "和你读链的方式",
   "start": 146.368,
   "end": 147.538,
   "id": "c72"
  },
  {
   "text": "另一块是人",
   "start": 147.916,
   "end": 149.05,
   "id": "c73"
  },
  {
   "text": "设备和流程",
   "start": 149.142,
   "end": 150.491,
   "id": "c74"
  },
  {
   "text": "社工常常是入口",
   "start": 151.472,
   "end": 153.046,
   "id": "c75"
  },
  {
   "text": "私钥或者前端是落点",
   "start": 153.114,
   "end": 154.915,
   "id": "c76"
  },
  {
   "text": "AI 不是独立的攻击面",
   "start": 155.279,
   "end": 157.27,
   "id": "c77"
  },
  {
   "text": "而是攻防两边的放大器",
   "start": 157.398,
   "end": 159.044,
   "id": "c78"
  }
 ]
}