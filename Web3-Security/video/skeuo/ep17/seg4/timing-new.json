 "captions": [
  {
   "text": "验证者这一端",
   "start": 1.648,
   "end": 2.901,
   "id": "c0"
  },
  {
   "text": "风险出在签名上",
   "start": 2.945,
   "end": 4.437,
   "id": "c1"
  },
  {
   "text": "罚没 是 PoS 验证者违反协议",
   "start": 5.42,
   "end": 8.316,
   "id": "c2"
  },
  {
   "text": "被扣除部分质押并强制退出",
   "start": 8.491,
   "end": 11.006,
   "id": "c3"
  },
  {
   "text": "最常见的原因是双签",
   "start": 12.0,
   "end": 14.265,
   "id": "c4"
  },
  {
   "text": "同一把密钥",
   "start": 15.22,
   "end": 16.259,
   "id": "c5"
  },
  {
   "text": "对同一个位置",
   "start": 16.291,
   "end": 17.342,
   "id": "c6"
  },
  {
   "text": "签了两个不同的消息",
   "start": 17.362,
   "end": 18.782,
   "id": "c7"
  },
  {
   "text": "凌晨 运维看到主机 A 失去响应",
   "start": 19.784,
   "end": 22.549,
   "id": "c8"
  },
  {
   "text": "就在备用机 B 上启动同一把密钥",
   "start": 22.581,
   "end": 25.251,
   "id": "c9"
  },
  {
   "text": "其实 A 没有停",
   "start": 26.244,
   "end": 28.116,
   "id": "c10"
  },
  {
   "text": "两台机器对同一个 slot 各签一票",
   "start": 28.208,
   "end": 30.783,
   "id": "c11"
  },
  {
   "text": "网络检测到双签",
   "start": 31.768,
   "end": 33.295,
   "id": "c12"
  },
  {
   "text": "验证者被罚没",
   "start": 33.434,
   "end": 34.676,
   "id": "c13"
  },
  {
   "text": "公开的罚没事件",
   "start": 35.66,
   "end": 36.961,
   "id": "c14"
  },
  {
   "text": "几乎都发生在故障切换或迁移时",
   "start": 36.993,
   "end": 39.687,
   "id": "c15"
  },
  {
   "text": "2021 年 2 月",
   "start": 40.656,
   "end": 41.849,
   "id": "c16"
  },
  {
   "text": "一家质押服务商重启出错",
   "start": 41.906,
   "end": 43.909,
   "id": "c17"
  },
  {
   "text": "75 个验证者被罚没",
   "start": 44.06,
   "end": 45.802,
   "id": "c18"
  },
  {
   "text": "约 18 ETH",
   "start": 45.858,
   "end": 46.921,
   "id": "c19"
  },
  {
   "text": "2023 年 10 月和 2025 年 9 月",
   "start": 47.908,
   "end": 50.649,
   "id": "c20"
  },
  {
   "text": "Lido 和 SSV 网络上",
   "start": 50.812,
   "end": 53.03,
   "id": "c21"
  },
  {
   "text": "也各有一批验证者被罚没",
   "start": 53.062,
   "end": 54.78,
   "id": "c22"
  },
  {
   "text": "防线在流程",
   "start": 55.736,
   "end": 56.989,
   "id": "c23"
  },
  {
   "text": "迁移前导出防罚没数据",
   "start": 57.14,
   "end": 59.084,
   "id": "c24"
  },
  {
   "text": "确认旧实例已经停止",
   "start": 59.224,
   "end": 61.048,
   "id": "c25"
  },
  {
   "text": "再等待至少 2 个 epoch",
   "start": 62.028,
   "end": 63.674,
   "id": "c26"
  },
  {
   "text": "并开启分身检测",
   "start": 63.694,
   "end": 65.15,
   "id": "c27"
  },
  {
   "text": "作为最后一道防线",
   "start": 65.182,
   "end": 66.424,
   "id": "c28"
  },
  {
   "text": "签名的另一个风险",
   "start": 67.408,
   "end": 68.923,
   "id": "c29"
  },
  {
   "text": "是看不见就签",
   "start": 69.086,
   "end": 70.316,
   "id": "c30"
  },
  {
   "text": "在 MEV-Boost 里",
   "start": 71.276,
   "end": 72.719,
   "id": "c31"
  },
  {
   "text": "relay 托管构建者组装的完整区块",
   "start": 72.966,
   "end": 75.66,
   "id": "c32"
  },
  {
   "text": "只给提议者区块头",
   "start": 75.752,
   "end": 77.219,
   "id": "c33"
  },
  {
   "text": "提议者签名区块头",
   "start": 78.216,
   "end": 79.778,
   "id": "c34"
  },
  {
   "text": "相信 relay 会发布完整区块并付款",
   "start": 79.87,
   "end": 82.767,
   "id": "c35"
  },
  {
   "text": "2023 年 4 月",
   "start": 83.74,
   "end": 85.124,
   "id": "c36"
  },
  {
   "text": "一个恶意提议者",
   "start": 85.216,
   "end": 86.422,
   "id": "c37"
  },
  {
   "text": "签了一个无效的区块头",
   "start": 86.442,
   "end": 88.1,
   "id": "c38"
  },
  {
   "text": "旧代码照样返回区块体",
   "start": 89.072,
   "end": 91.003,
   "id": "c39"
  },
  {
   "text": "他拆开三明治机器人的交易包",
   "start": 91.143,
   "end": 93.265,
   "id": "c40"
  },
  {
   "text": "获利约 2000 万美元",
   "start": 93.286,
   "end": 95.039,
   "id": "c41"
  },
  {
   "text": "修复后 relay 先广播区块",
   "start": 96.036,
   "end": 98.468,
   "id": "c42"
  },
  {
   "text": "再把区块交给提议者",
   "start": 98.488,
   "end": 100.087,
   "id": "c43"
  },
  {
   "text": "relay 是可信中间人",
   "start": 101.08,
   "end": 103.011,
   "id": "c44"
  },
  {
   "text": "验证者要评估自己用的 relay 和它的运营方",
   "start": 103.222,
   "end": 106.297,
   "id": "c45"
  },
  {
   "text": "这个市场也很集中",
   "start": 107.276,
   "end": 108.696,
   "id": "c46"
  },
  {
   "text": "2026 年 11 月的一个单日快照里",
   "start": 108.918,
   "end": 111.327,
   "id": "c47"
  },
  {
   "text": "前两大构建者约占 74% 的区块",
   "start": 111.478,
   "end": 114.434,
   "id": "c48"
  }
 ]
