 "lines": [
  {
   "id": "seg1-00",
   "text": "2026 年 4 月，LayerZero 给 KelpDAO 确认跨链消息的验证者，放行了一条消息。",
   "spoken": "2026 年 4 月，LayerZero 给 KelpDAO 确认跨链消息的验证者，放行了一条消息。",
   "src": "/Users/k/Workon/Learning/web3/web3-security-101/Web3-Security/video/skeuo/ep17/audio/lines/seg1-00.mp3",
   "start": 1.6,
   "dur": 6.384,
   "speechStart": 1.698,
   "speechEnd": 7.138
  },
  {
   "id": "seg1-01",
   "text": "这条消息，在源链上根本不存在。",
   "spoken": "这条消息，在源链上根本不存在。",
   "src": "/Users/k/Workon/Learning/web3/web3-security-101/Web3-Security/video/skeuo/ep17/audio/lines/seg1-01.mp3",
   "start": 8.204,
   "dur": 3.84,
   "speechStart": 8.302,
   "speechEnd": 11.218
  },
  {
   "id": "seg1-02",
   "text": "验证者读链，靠的是两个 RPC 节点。",
   "spoken": "验证者读链，靠的是两个 RPC 节点。",
   "src": "/Users/k/Workon/Learning/web3/web3-security-101/Web3-Security/video/skeuo/ep17/audio/lines/seg1-02.mp3",
   "start": 12.264,
   "dur": 3.96,
   "speechStart": 12.362,
   "speechEnd": 15.385
  },
  {
   "id": "seg1-03",
   "text": "攻击者控制了这两个节点，替换了节点程序。",
   "spoken": "攻击者控制了这两个节点，替换了节点程序。",
   "src": "/Users/k/Workon/Learning/web3/web3-security-101/Web3-Security/video/skeuo/ep17/audio/lines/seg1-03.mp3",
   "start": 16.444,
   "dur": 4.104,
   "speechStart": 16.542,
   "speechEnd": 19.696
  },
  {
   "id": "seg1-04",
   "text": "被替换的节点，只对验证者返回伪造数据。",
   "spoken": "被替换的节点，只对验证者返回伪造数据。",
   "src": "/Users/k/Workon/Learning/web3/web3-security-101/Web3-Security/video/skeuo/ep17/audio/lines/seg1-04.mp3",
   "start": 20.768,
   "dur": 4.272,
   "speechStart": 20.866,
   "speechEnd": 24.187
  },
  {
   "id": "seg1-05",
   "text": "对别的 IP 来的查询，它返回真实数据。",
   "spoken": "对别的 IP 来的查询，它返回真实数据。",
   "src": "/Users/k/Workon/Learning/web3/web3-security-101/Web3-Security/video/skeuo/ep17/audio/lines/seg1-05.mp3",
   "start": 25.26,
   "dur": 3.816,
   "speechStart": 25.358,
   "speechEnd": 28.239
  },
  {
   "id": "seg1-06",
   "text": "攻击者再用 DDoS，打掉没被攻破的外部 RPC。",
   "spoken": "攻击者再用 DDoS，打掉没被攻破的外部 RPC。",
   "src": "/Users/k/Workon/Learning/web3/web3-security-101/Web3-Security/video/skeuo/ep17/audio/lines/seg1-06.mp3",
   "start": 29.296,
   "dur": 5.088,
   "speechStart": 29.394,
   "speechEnd": 33.536
  },
  {
   "id": "seg1-07",
   "text": "系统自动切换，切到了被污染的节点上。",
   "spoken": "系统自动切换，切到了被污染的节点上。",
   "src": "/Users/k/Workon/Learning/web3/web3-security-101/Web3-Security/video/skeuo/ep17/audio/lines/seg1-07.mp3",
   "start": 34.604,
   "dur": 3.912,
   "speechStart": 34.702,
   "speechEnd": 37.69
  },
  {
   "id": "seg1-08",
   "text": "LayerZero 的声明写，损失约 2.9 亿美元。",
   "spoken": "LayerZero 的声明写，损失约 2.9 亿美元。",
   "src": "/Users/k/Workon/Learning/web3/web3-security-101/Web3-Security/video/skeuo/ep17/audio/lines/seg1-08.mp3",
   "start": 38.736,
   "dur": 4.176,
   "speechStart": 38.834,
   "speechEnd": 42.06
  },
  {
   "id": "seg1-09",
   "text": "先猜一道题。",
   "spoken": "先猜一道题。",
   "src": "/Users/k/Workon/Learning/web3/web3-security-101/Web3-Security/video/skeuo/ep17/audio/lines/seg1-09.mp3",
   "start": 43.132,
   "dur": 2.088,
   "speechStart": 43.23,
   "speechEnd": 44.384
  },
  {
   "id": "seg1-10",
   "text": "监控系统也查询了这两个节点，结果一切正常。",
   "spoken": "监控系统也查询了这两个节点，结果一切正常。",
   "src": "/Users/k/Workon/Learning/web3/web3-security-101/Web3-Security/video/skeuo/ep17/audio/lines/seg1-10.mp3",
   "start": 45.44,
   "dur": 4.44,
   "speechStart": 45.538,
   "speechEnd": 49.038
  },
  {
   "id": "seg1-11",
   "text": "它能发现这次攻击吗？",
   "spoken": "它能发现这次攻击吗？",
   "src": "/Users/k/Workon/Learning/web3/web3-security-101/Web3-Security/video/skeuo/ep17/audio/lines/seg1-11.mp3",
   "start": 50.1,
   "dur": 2.304,
   "speechStart": 50.198,
   "speechEnd": 51.579
  },
  {
   "id": "seg1-12",
   "text": "先记住这个问题。",
   "spoken": "先记住这个问题。",
