   "start": 6.237,
   "end": 8.276,
   "id": "c3"
  },
  {
   "text": "被人操纵",
   "start": 8.427,
   "end": 9.276,
   "id": "c4"
  },
  {
   "text": "节点之间直接交换区块和交易",
   "start": 10.272,
   "end": 13.049,
   "id": "c5"
  },
  {
   "text": "这叫 P2P 网络",
   "start": 13.105,
   "end": 14.561,
   "id": "c6"
  },
  {
   "text": "日蚀攻击",
   "start": 15.556,
   "end": 16.511,
   "id": "c7"
  },
  {
   "text": "是攻击者占满受害节点的全部对等连接",
   "start": 16.591,
   "end": 19.833,
   "id": "c8"
  },
  {
   "text": "节点只看到攻击者给的区块和交易",
   "start": 20.816,
   "end": 23.64,
   "id": "c9"
  },
  {
   "text": "最关键的一步",
   "start": 24.636,
   "end": 25.853,
   "id": "c10"
  },
  {
   "text": "在节点重启",
   "start": 25.993,
   "end": 27.056,
   "id": "c11"
  },
  {
   "text": "重启时 节点会从地址表里挑选对等节点",
   "start": 28.048,
   "end": 31.92,
   "id": "c12"
  },
  {
   "text": "地址表如果已经被攻击者填满",
   "start": 32.9,
   "end": 35.284,
   "id": "c13"
  },
  {
   "text": "它连上的就全是攻击者",
   "start": 35.519,
   "end": 37.772,
   "id": "c14"
  },
  {
   "text": "2018 年的一篇论文显示",
   "start": 38.76,
   "end": 40.966,
   "id": "c15"
  },
  {
   "text": "两台主机",
   "start": 40.986,
   "end": 41.965,
   "id": "c16"
  },
  {
   "text": "各一个 IP",
   "start": 42.093,
   "end": 43.121,
   "id": "c17"
  },
  {
   "text": "就能日蚀一个以太坊节点",
   "start": 43.141,
   "end": 44.953,
   "id": "c18"
  },
  {
   "text": "Geth 1.8.0 随后限制了同一网段的节点数",
   "start": 45.94,
   "end": 49.491,
   "id": "c19"
  },
  {
   "text": "比特币加了锚点连接",
   "start": 50.48,
   "end": 52.114,
   "id": "c20"
  },
  {
   "text": "重启时优先恢复上次的出站连接",
   "start": 52.277,
   "end": 54.995,
   "id": "c21"
  },
  {
   "text": "被日蚀的节点",
   "start": 55.98,
   "end": 57.161,
   "id": "c22"
  },
  {
   "text": "同步状态看起来正常",
   "start": 57.277,
   "end": 59.102,
   "id": "c23"
  },
  {
   "text": "它有连接",
   "start": 60.088,
   "end": 61.008,
   "id": "c24"
  },
  {
   "text": "也有新块",
   "start": 61.1,
   "end": 61.996,
   "id": "c25"
  },
  {
   "text": "只是落后",
   "start": 62.219,
   "end": 63.186,
   "id": "c26"
  },
  {
   "text": "或者在错误的分支上",
   "start": 63.242,
   "end": 64.65,
   "id": "c27"
  },
  {
   "text": "对等节点数只说明有连接",
   "start": 65.636,
   "end": 67.96,
   "id": "c28"
  },
  {
   "text": "不说明连接来自独立的运营方",
   "start": 68.195,
   "end": 70.294,
   "id": "c29"
  },
  {
   "text": "节点崩溃",
   "start": 71.28,
   "end": 72.342,
   "id": "c30"
  },
  {
   "text": "也可能是攻击的第一步",
   "start": 72.458,
   "end": 73.95,
   "id": "c31"
  },
  {
   "text": "切换逻辑如果把流量转到不可信的备用节点",
   "start": 74.932,
   "end": 78.102,
   "id": "c32"
  },
  {
   "text": "DoS 就成了数据污染的前置步骤",
   "start": 78.265,
   "end": 80.899,
   "id": "c33"
  },
  {
   "text": "开头的事件正是这样",
   "start": 81.896,
   "end": 83.53,
   "id": "c34"
  },
  {
   "text": "另一类事故",
   "start": 84.516,
   "end": 85.626,
   "id": "c35"
  },
  {
   "text": "来自节点自己的配置",
   "start": 85.682,
   "end": 87.09,
   "id": "c36"
  },
  {
   "text": "2018 年",
   "start": 88.072,
   "end": 89.027,
   "id": "c37"
  },
  {
   "text": "一个团伙扫描暴露 JSON-RPC 的以太坊节点",
   "start": 89.214,
   "end": 93.075,
   "id": "c38"
  },
  {
   "text": "盗走约 3.8 万个 ETH",
   "start": 93.119,
   "end": 95.015,
   "id": "c39"
  },
  {
   "text": "Geth 默认只监听本机",
   "start": 95.996,
   "end": 98.047,
   "id": "c40"
  },
  {
   "text": "接口是运营者自己打开的",
   "start": 98.067,
   "end": 99.844,
   "id": "c41"
  },
  {
   "text": "RPC 接口只绑内网或本机",
   "start": 100.824,
   "end": 103.303,
   "id": "c42"
  },
  {
   "text": "对外必须经过认证网关",
   "start": 103.478,
   "end": 105.41,
   "id": "c43"
  },
  {
   "text": "给执行客户端下指令的 Engine API",
   "start": 106.396,
   "end": 109.554,
   "id": "c44"
  },
  {
   "text": "只对共识客户端开放",
   "start": 109.574,
   "end": 111.256,
   "id": "c45"
  },
  {
   "text": "并用 JWT 认证",
   "start": 111.277,
   "end": 113.042,
   "id": "c46"
  }
 ]
}