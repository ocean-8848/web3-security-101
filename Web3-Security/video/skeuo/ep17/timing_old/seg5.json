 "captions": [
  {
   "text": "回到开头的节点",
   "start": 1.55,
   "end": 3.076,
   "id": "c0"
  },
  {
   "text": "它的关键",
   "start": 3.29,
   "end": 4.228,
   "id": "c1"
  },
  {
   "text": "是按来源区别对待",
   "start": 4.386,
   "end": 6.251,
   "id": "c2"
  },
  {
   "text": "你从别的 IP 去查",
   "start": 6.561,
   "end": 7.888,
   "id": "c3"
  },
  {
   "text": "它就给你真数据",
   "start": 8.0,
   "end": 9.108,
   "id": "c4"
  },
  {
   "text": "所以防线不是多看几次同一个节点",
   "start": 9.422,
   "end": 12.911,
   "id": "c5"
  },
  {
   "text": "而是比对不同运营方的数据源",
   "start": 13.01,
   "end": 15.447,
   "id": "c6"
  },
  {
   "text": "第一条 多源校验",
   "start": 15.81,
   "end": 17.784,
   "id": "c7"
  },
  {
   "text": "充值扫描和跨链放行",
   "start": 18.184,
   "end": 20.201,
   "id": "c8"
  },
  {
   "text": "至少用两个独立来源",
   "start": 20.404,
   "end": 22.229,
   "id": "c9"
  },
  {
   "text": "比如自建节点加一家第三方 RPC",
   "start": 22.45,
   "end": 25.728,
   "id": "c10"
  },
  {
   "text": "独立要按运营方算",
   "start": 26.089,
   "end": 27.705,
   "id": "c11"
  },
  {
   "text": "同一家服务商的两个节点",
   "start": 27.936,
   "end": 29.865,
   "id": "c12"
  },
  {
   "text": "只算一个",
   "start": 29.885,
   "end": 30.646,
   "id": "c13"
  },
  {
   "text": "第二条 不降级",
   "start": 31.026,
   "end": 32.523,
   "id": "c14"
  },
  {
   "text": "节点超时后",
   "start": 32.926,
   "end": 33.809,
   "id": "c15"
  },
  {
   "text": "法定数不自动下降",
   "start": 34.014,
   "end": 35.49,
   "id": "c16"
  },
  {
   "text": "达不到法定数就暂停",
   "start": 35.863,
   "end": 37.882,
   "id": "c17"
  },
  {
   "text": "人工确认",
   "start": 37.902,
   "end": 38.701,
   "id": "c18"
  },
  {
   "text": "开头的事件里",
   "start": 39.046,
   "end": 40.189,
   "id": "c19"
  },
  {
   "text": "干净的 RPC 被打掉",
   "start": 40.446,
   "end": 42.156,
   "id": "c20"
  },
  {
   "text": "系统自动切到剩下的节点",
   "start": 42.269,
   "end": 44.211,
   "id": "c21"
  },
  {
   "text": "这就是降级",
   "start": 44.316,
   "end": 45.597,
   "id": "c22"
  },
  {
   "text": "第三条 结果冲突就暂停入账",
   "start": 45.903,
   "end": 48.534,
   "id": "c23"
  },
  {
   "text": "不挑一个先用",
   "start": 48.76,
   "end": 49.795,
   "id": "c24"
  },
  {
   "text": "第四条 节点本身也要比对",
   "start": 50.03,
   "end": 52.533,
   "id": "c25"
  },
  {
   "text": "链头要和不同网络",
   "start": 52.81,
   "end": 54.867,
   "id": "c26"
  },
  {
   "text": "不同运营方的来源持续比对",
   "start": 55.039,
   "end": 57.422,
   "id": "c27"
  },
  {
   "text": "对等连接也要来自不同网络",
   "start": 57.944,
   "end": 60.249,
   "id": "c28"
  },
  {
   "text": "自建节点可以选少数派客户端",
   "start": 60.55,
   "end": 63.503,
   "id": "c29"
  },
  {
   "text": "或者两种客户端互相比对",
   "start": 63.821,
   "end": 66.545,
   "id": "c30"
  },
  {
   "text": "硬分叉前完成升级",
   "start": 66.687,
   "end": 68.474,
   "id": "c31"
  },
  {
   "text": "这几条 对被替换的节点",
   "start": 68.866,
   "end": 71.055,
   "id": "c32"
  },
  {
   "text": "被日蚀的节点",
   "start": 71.17,
   "end": 72.314,
   "id": "c33"
  },
  {
   "text": "停在错误分叉上的节点 都有效",
   "start": 72.403,
   "end": 74.76,
   "id": "c34"
  },
  {
   "text": "局限是 如果所有来源都接在同一个上游",
   "start": 74.99,
   "end": 78.366,
   "id": "c35"
  },
  {
   "text": "数量再多也没用",
   "start": 78.523,
   "end": 79.68,
   "id": "c36"
  }
 ]
}