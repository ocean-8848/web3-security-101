 "captions": [
  {
   "text": "按角色 各做一件事",
   "start": 1.648,
   "end": 3.591,
   "id": "c0"
  },
  {
   "text": "交易所和跨链桥",
   "start": 4.58,
   "end": 6.154,
   "id": "c1"
  },
  {
   "text": "列出每个资金决策读取的数据源",
   "start": 6.246,
   "end": 8.773,
   "id": "c2"
  },
  {
   "text": "去掉重复的运营方",
   "start": 8.842,
   "end": 10.262,
   "id": "c3"
  },
  {
   "text": "看剩下几个",
   "start": 10.282,
   "end": 11.333,
   "id": "c4"
  },
  {
   "text": "节点运维",
   "start": 12.312,
   "end": 13.196,
   "id": "c5"
  },
  {
   "text": "确认 RPC 和 Engine API 没有暴露在公网",
   "start": 13.395,
   "end": 16.958,
   "id": "c6"
  },
  {
   "text": "验证者团队",
   "start": 17.956,
   "end": 19.102,
   "id": "c7"
  },
  {
   "text": "把故障切换改成人工确认",
   "start": 19.218,
   "end": 21.626,
   "id": "c8"
  },
  {
   "text": "原实例停止之后",
   "start": 21.682,
   "end": 23.114,
   "id": "c9"
  },
  {
   "text": "才启动备用",
   "start": 23.134,
   "end": 24.245,
   "id": "c10"
  },
  {
   "text": "普通用户",
   "start": 25.232,
   "end": 26.092,
   "id": "c11"
  },
  {
   "text": "余额显示异常时",
   "start": 26.267,
   "end": 27.604,
   "id": "c12"
  },
  {
   "text": "换一个 RPC 或区块浏览器交叉确认",
   "start": 27.624,
   "end": 30.723,
   "id": "c13"
  },
  {
   "text": "自定义 RPC",
   "start": 31.716,
   "end": 33.255,
   "id": "c14"
  },
  {
   "text": "只添加官方文档列出的地址",
   "start": 33.287,
   "end": 35.326,
   "id": "c15"
  },
  {
   "text": "回到开头的问题",
   "start": 36.328,
   "end": 37.712,
   "id": "c16"
  },
  {
   "text": "监控查询的是同一个节点",
   "start": 38.708,
   "end": 40.532,
   "id": "c17"
  },
  {
   "text": "看到的是真实数据",
   "start": 40.636,
   "end": 42.14,
   "id": "c18"
  },
  {
   "text": "它无法发现这次攻击",
   "start": 42.315,
   "end": 43.818,
   "id": "c19"
  },
  {
   "text": "要发现它",
   "start": 44.808,
   "end": 45.751,
   "id": "c20"
  },
  {
   "text": "需要拿验证者实际收到的结果",
   "start": 45.867,
   "end": 48.109,
   "id": "c21"
  },
  {
   "text": "和不同运营方的数据源比对",
   "start": 48.212,
   "end": 50.097,
   "id": "c22"
  },
  {
   "text": "这只在来源真正独立时成立",
   "start": 51.076,
   "end": 53.424,
   "id": "c23"
  },
  {
   "text": "你读到的链",
   "start": 54.416,
   "end": 55.467,
   "id": "c24"
  },
  {
   "text": "只是某个节点告诉你的链",
   "start": 55.642,
   "end": 57.276,
   "id": "c25"
  },
  {
   "text": "先问几家独立的节点 再签名 再入账",
   "start": 57.439,
   "end": 60.728,
   "id": "c26"
  },
