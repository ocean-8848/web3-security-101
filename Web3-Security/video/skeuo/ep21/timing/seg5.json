   "end": 34.625,
   "id": "c17"
  },
  {
   "text": "权限变更",
   "start": 34.645,
   "end": 35.755,
   "id": "c18"
  },
  {
   "text": "至少两人独立确认",
   "start": 35.8,
   "end": 37.243,
   "id": "c19"
  },
  {
   "text": "这叫双人原则",
   "start": 37.323,
   "end": 38.601,
   "id": "c20"
  },
  {
   "text": "大额交易和权限变更",
   "start": 39.572,
   "end": 41.408,
   "id": "c21"
  },
  {
   "text": "用预先登记的电话或当面确认",
   "start": 41.584,
   "end": 44.123,
   "id": "c22"
  },
  {
   "text": "这叫带外确认",
   "start": 44.298,
   "end": 45.396,
   "id": "c23"
  },
  {
   "text": "要点是 不用发起请求的那个渠道",
   "start": 46.392,
   "end": 49.788,
   "id": "c24"
  },
  {
   "text": "发起人 审批人 执行人 审计人",
   "start": 50.788,
   "end": 54.517,
   "id": "c25"
  },
  {
   "text": "不能是同一个人",
   "start": 54.573,
   "end": 55.767,
   "id": "c26"
  },
  {
   "text": "这叫职责分离",
   "start": 55.8,
   "end": 56.981,
   "id": "c27"
  },
  {
   "text": "关键系统用硬件密钥",
   "start": 57.968,
   "end": 59.804,
   "id": "c28"
  },
  {
   "text": "会话短期有效",
   "start": 59.825,
   "end": 61.221,
   "id": "c29"
  },
  {
   "text": "异地登录要告警",
   "start": 61.337,
   "end": 62.649,
   "id": "c30"
  },
  {
   "text": "第三条 管好人员的进出",
   "start": 63.636,
   "end": 65.948,
   "id": "c31"
  },
  {
   "text": "招聘时 视频面试本人出镜",
   "start": 66.928,
   "end": 69.574,
   "id": "c32"
  },
  {
   "text": "核验证件和履历",
   "start": 69.63,
   "end": 71.074,
   "id": "c33"
  },
  {
   "text": "远程岗位核验设备所在地",
   "start": 71.166,
   "end": 73.336,
   "id": "c34"
  },
  {
   "text": "离职当天",
   "start": 74.324,
   "end": 75.351,
   "id": "c35"
  },
  {
   "text": "回收全部权限",
   "start": 75.419,
   "end": 76.922,
   "id": "c36"
  },
  {
   "text": "不只是代码仓库和云",
   "start": 77.904,
   "end": 79.74,
   "id": "c37"
  },
  {
   "text": "还有 npm",
   "start": 79.796,
   "end": 80.871,
   "id": "c38"
  },
  {
   "text": "域名注册商",
   "start": 81.011,
   "end": 82.097,
   "id": "c39"
  },
  {
   "text": "官方社交账号",
   "start": 82.213,
   "end": 83.526,
   "id": "c40"
  },
  {
   "text": "多签签名人身份",
   "start": 83.558,
   "end": 84.943,
   "id": "c41"
  },
  {
   "text": "漏掉一个边缘权限",
   "start": 85.924,
   "end": 87.427,
   "id": "c42"
  },
  {
   "text": "前员工的账号",
   "start": 87.602,
   "end": 88.844,
   "id": "c43"
  },
  {
   "text": "就是一扇没锁的门",
   "start": 88.864,
   "end": 90.165,
   "id": "c44"
  },
  {
   "text": "第四条 留意内部人风险的早期信号",
   "start": 91.136,
   "end": 94.413,
   "id": "c45"
  },
  {
   "text": "访问和岗位无关的数据",
   "start": 95.412,
   "end": 97.355,
   "id": "c46"
  },
  {
   "text": "短时间大量导出",
   "start": 97.435,
   "end": 98.939,
   "id": "c47"
  },
  {
   "text": "借口紧急",
   "start": 99.019,
   "end": 100.07,
   "id": "c48"
  },
  {
   "text": "要求绕过审批",
   "start": 100.126,
   "end": 101.415,
   "id": "c49"
  },
  {
   "text": "还有坚持独自处理某类操作",
   "start": 102.4,
   "end": 104.403,
   "id": "c50"
  },
  {
   "text": "拒绝休假或轮岗",
   "start": 104.554,
   "end": 106.332,
   "id": "c51"
  },
  {
   "text": "最后 要有匿名报告渠道",
   "start": 107.324,
   "end": 109.815,
   "id": "c52"
  },
  {
   "text": "员工报告可疑接触",
   "start": 109.955,
   "end": 111.66,
   "id": "c53"
  },
  {
   "text": "不受惩罚",
   "start": 111.681,
   "end": 112.648,
   "id": "c54"
  }
 ]
}