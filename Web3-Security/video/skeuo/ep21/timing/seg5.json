 "captions": [
  {
   "text": "防御不能指望员工永远不被骗",
   "start": 1.648,
   "end": 3.853,
   "id": "c0"
  },
  {
   "text": "要让一个人被骗",
   "start": 4.005,
   "end": 5.222,
   "id": "c1"
  },
  {
   "text": "也不够造成损失",
   "start": 5.35,
   "end": 6.591,
   "id": "c2"
  },
  {
   "text": "第一条 设备分离",
   "start": 7.58,
   "end": 9.392,
   "id": "c3"
  },
  {
   "text": "签名专用设备",
   "start": 10.392,
   "end": 11.622,
   "id": "c4"
  },
  {
   "text": "只用来签名和独立解码",
   "start": 11.642,
   "end": 13.443,
   "id": "c5"
  },
  {
   "text": "不收邮件",
   "start": 13.463,
   "end": 14.253,
   "id": "c6"
  },
  {
   "text": "不上 Telegram",
   "start": 14.273,
   "end": 15.336,
   "id": "c7"
  },
  {
   "text": "不打开外部文件",
   "start": 15.356,
   "end": 16.633,
   "id": "c8"
  },
  {
   "text": "日常办公电脑",
   "start": 17.62,
   "end": 18.909,
   "id": "c9"
  },
  {
   "text": "用来沟通和写文档",
   "start": 18.929,
   "end": 20.563,
   "id": "c10"
  },
  {
   "text": "不存生产凭证和私钥",
   "start": 20.715,
   "end": 22.766,
   "id": "c11"
  },
  {
   "text": "开发电脑要运行外部项目",
   "start": 23.744,
   "end": 26.116,
   "id": "c12"
  },
  {
   "text": "就放进隔离的虚拟机",
   "start": 26.148,
   "end": 27.771,
   "id": "c13"
  },
  {
   "text": "或者一次性环境",
