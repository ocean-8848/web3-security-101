 "lines": [
  {
   "id": "seg5-00",
   "text": "防御不能指望员工永远不被骗，要让一个人被骗，也不够造成损失。",
   "spoken": "防御不能指望员工永远不被骗，要让一个人被骗，也不够造成损失。",
   "src": "/Users/k/Workon/Learning/web3/web3-security-101/Web3-Security/video/skeuo/ep21/audio/lines/seg5-00.mp3",
   "start": 1.6,
   "dur": 5.712,
   "speechStart": 1.698,
   "speechEnd": 6.471
  },
  {
   "id": "seg5-01",
   "text": "第一条，设备分离。",
   "spoken": "第一条，设备分离。",
   "src": "/Users/k/Workon/Learning/web3/web3-security-101/Web3-Security/video/skeuo/ep21/audio/lines/seg5-01.mp3",
   "start": 7.532,
   "dur": 2.592,
   "speechStart": 7.63,
   "speechEnd": 9.272
  },
  {
   "id": "seg5-02",
   "text": "签名专用设备，只用来签名和独立解码，不收邮件，不上 Telegram，不打开外部文件。",
   "spoken": "签名专用设备，只用来签名和独立解码，不收邮件，不上 Telegram，不打开外部文件。",
   "src": "/Users/k/Workon/Learning/web3/web3-security-101/Web3-Security/video/skeuo/ep21/audio/lines/seg5-02.mp3",
   "start": 10.344,
   "dur": 7.008,
   "speechStart": 10.442,
   "speechEnd": 16.513
  },
  {
   "id": "seg5-03",
   "text": "日常办公电脑，用来沟通和写文档，不存生产凭证和私钥。",
   "spoken": "日常办公电脑，用来沟通和写文档，不存生产凭证和私钥。",
   "src": "/Users/k/Workon/Learning/web3/web3-security-101/Web3-Security/video/skeuo/ep21/audio/lines/seg5-03.mp3",
   "start": 17.572,
   "dur": 5.904,
   "speechStart": 17.67,
   "speechEnd": 22.646
  },
  {
   "id": "seg5-04",
   "text": "开发电脑要运行外部项目，就放进隔离的虚拟机，或者一次性环境。",
   "spoken": "开发电脑要运行外部项目，就放进隔离的虚拟机，或者一次性环境。",
   "src": "/Users/k/Workon/Learning/web3/web3-security-101/Web3-Security/video/skeuo/ep21/audio/lines/seg5-04.mp3",
   "start": 23.696,
   "dur": 6.072,
   "speechStart": 23.794,
   "speechEnd": 28.925
  },
  {
   "id": "seg5-05",
   "text": "第二条，流程控制。",
   "spoken": "第二条，流程控制。",
   "src": "/Users/k/Workon/Learning/web3/web3-security-101/Web3-Security/video/skeuo/ep21/audio/lines/seg5-05.mp3",
   "start": 29.988,
   "dur": 2.544,
   "speechStart": 30.086,
   "speechEnd": 31.681
  },
  {
   "id": "seg5-06",
   "text": "资金操作、合约发布、权限变更，至少两人独立确认，这叫双人原则。",
   "spoken": "资金操作、合约发布、权限变更，至少两人独立确认，这叫双人原则。",
   "src": "/Users/k/Workon/Learning/web3/web3-security-101/Web3-Security/video/skeuo/ep21/audio/lines/seg5-06.mp3",
   "start": 32.752,
   "dur": 6.552,
   "speechStart": 32.85,
   "speechEnd": 38.481
  },
  {
   "id": "seg5-07",
   "text": "大额交易和权限变更，用预先登记的电话或当面确认，这叫带外确认。",
   "spoken": "大额交易和权限变更，用预先登记的电话或当面确认，这叫带外确认。",
   "src": "/Users/k/Workon/Learning/web3/web3-security-101/Web3-Security/video/skeuo/ep21/audio/lines/seg5-07.mp3",
   "start": 39.524,
   "dur": 6.6,
   "speechStart": 39.622,
   "speechEnd": 45.276
  },
  {
   "id": "seg5-08",
   "text": "要点是，不用发起请求的那个渠道。",
   "spoken": "要点是，不用发起请求的那个渠道。",
   "src": "/Users/k/Workon/Learning/web3/web3-security-101/Web3-Security/video/skeuo/ep21/audio/lines/seg5-08.mp3",
   "start": 46.344,
   "dur": 4.176,
   "speechStart": 46.442,
   "speechEnd": 49.668
  },
  {
   "id": "seg5-09",
   "text": "发起人、审批人、执行人、审计人，不能是同一个人，这叫职责分离。",
   "spoken": "发起人、审批人、执行人、审计人，不能是同一个人，这叫职责分离。",
   "src": "/Users/k/Workon/Learning/web3/web3-security-101/Web3-Security/video/skeuo/ep21/audio/lines/seg5-09.mp3",
   "start": 50.74,
   "dur": 6.96,
   "speechStart": 50.838,
   "speechEnd": 56.861
  },
  {
   "id": "seg5-10",
   "text": "关键系统用硬件密钥，会话短期有效，异地登录要告警。",
   "spoken": "关键系统用硬件密钥，会话短期有效，异地登录要告警。",
   "src": "/Users/k/Workon/Learning/web3/web3-security-101/Web3-Security/video/skeuo/ep21/audio/lines/seg5-10.mp3",
   "start": 57.92,
   "dur": 5.448,
   "speechStart": 58.018,
   "speechEnd": 62.529
  },
  {
   "id": "seg5-11",
   "text": "第三条，管好人员的进出。",
   "spoken": "第三条，管好人员的进出。",
   "src": "/Users/k/Workon/Learning/web3/web3-security-101/Web3-Security/video/skeuo/ep21/audio/lines/seg5-11.mp3",
   "start": 63.588,
   "dur": 3.072,
   "speechStart": 63.686,
   "speechEnd": 65.828
  },
  {
   "id": "seg5-12",
   "text": "招聘时，视频面试本人出镜，核验证件和履历，远程岗位核验设备所在地。",
   "spoken": "招聘时，视频面试本人出镜，核验证件和履历，远程岗位核验设备所在地。",
   "src": "/Users/k/Workon/Learning/web3/web3-security-101/Web3-Security/video/skeuo/ep21/audio/lines/seg5-12.mp3",
   "start": 66.88,
   "dur": 7.176,
   "speechStart": 66.978,
   "speechEnd": 73.216
  },
  {
   "id": "seg5-13",
   "text": "离职当天，回收全部权限。",
   "spoken": "离职档天，回收全部权限。",
   "src": "/Users/k/Workon/Learning/web3/web3-security-101/Web3-Security/video/skeuo/ep21/audio/lines/seg5-13.mp3",
   "start": 74.276,
   "dur": 3.36,
   "speechStart": 74.374,
   "speechEnd": 76.802
  },
  {
   "id": "seg5-14",
   "text": "不只是代码仓库和云，还有 npm、域名注册商、官方社交账号、多签签名人身份。",
   "spoken": "不只是代码仓库和云，还有 npm、域名注册商、官方社交账号、多签签名人身份。",
   "src": "/Users/k/Workon/Learning/web3/web3-security-101/Web3-Security/video/skeuo/ep21/audio/lines/seg5-14.mp3",
   "start": 77.856,
   "dur": 7.8,
   "speechStart": 77.954,
   "speechEnd": 84.823
  },
  {
   "id": "seg5-15",
   "text": "漏掉一个边缘权限，前员工的账号，就是一扇没锁的门。",
   "spoken": "漏掉一个边缘权限，前员工的账号，就是一扇没锁的门。",
   "src": "/Users/k/Workon/Learning/web3/web3-security-101/Web3-Security/video/skeuo/ep21/audio/lines/seg5-15.mp3",
   "start": 85.876,
   "dur": 4.992,
   "speechStart": 85.974,
   "speechEnd": 90.045
  },
  {
   "id": "seg5-16",
   "text": "第四条，留意内部人风险的早期信号。",
   "spoken": "第四条，留意内部人风险的早期信号。",
   "src": "/Users/k/Workon/Learning/web3/web3-security-101/Web3-Security/video/skeuo/ep21/audio/lines/seg5-16.mp3",
   "start": 91.088,
   "dur": 4.056,
   "speechStart": 91.186,
   "speechEnd": 94.293
  },
  {
   "id": "seg5-17",
   "text": "访问和岗位无关的数据，短时间大量导出，借口紧急，要求绕过审批。",
   "spoken": "访问和岗位无关的数据，短时间大量导出，借口紧急，要求绕过审批。",
   "src": "/Users/k/Workon/Learning/web3/web3-security-101/Web3-Security/video/skeuo/ep21/audio/lines/seg5-17.mp3",
   "start": 95.364,
   "dur": 6.768,
   "speechStart": 95.462,
   "speechEnd": 101.295
  },
  {
   "id": "seg5-18",
   "text": "还有坚持独自处理某类操作，拒绝休假或轮岗。",
   "spoken": "还有坚持独自楚理某类操作，拒绝休架或轮岗。",
   "src": "/Users/k/Workon/Learning/web3/web3-security-101/Web3-Security/video/skeuo/ep21/audio/lines/seg5-18.mp3",
   "start": 102.352,
   "dur": 4.704,
   "speechStart": 102.45,
   "speechEnd": 106.212
  },
  {
   "id": "seg5-19",
   "text": "最后，要有匿名报告渠道，员工报告可疑接触，不受惩罚。",
