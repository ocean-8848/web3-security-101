   "start": 5.876,
   "dur": 6.504,
   "speechStart": 5.974,
   "speechEnd": 11.545
  },
  {
   "id": "seg3-02",
   "text": "然后发来一个 GitHub 项目，或者一个 Python 脚本。",
   "spoken": "然后发来一个 GitHub 项目，或者一个 Python 脚本。",
   "src": "/Users/k/Workon/Learning/web3/web3-security-101/Web3-Security/video/skeuo/ep21/audio/lines/seg3-02.mp3",
   "start": 12.6,
   "dur": 4.2,
   "speechStart": 12.698,
   "speechEnd": 15.948
  },
  {
   "id": "seg3-03",
   "text": "关键在下一步，员工在工作电脑上，运行了外部代码。",
   "spoken": "关键在下一步，员工在工作电脑上，运行了外部代码。",
