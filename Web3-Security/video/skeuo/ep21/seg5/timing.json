 "captions": [
  {
   "text": "防御不能指望员工永远不被骗",
   "start": 1.55,
   "end": 4.274,
   "id": "c0"
  },
  {
   "text": "要让一个人被骗",
   "start": 4.508,
   "end": 5.662,
   "id": "c1"
  },
  {
   "text": "也不够造成损失",
   "start": 5.716,
   "end": 7.157,
   "id": "c2"
  },
  {
   "text": "第一条 设备分离",
   "start": 7.552,
   "end": 9.261,
   "id": "c3"
  },
  {
   "text": "签名专用设备",
   "start": 9.51,
   "end": 10.874,
   "id": "c4"
  },
  {
   "text": "只用来签名和独立解码",
   "start": 11.041,
   "end": 13.246,
   "id": "c5"
  },
  {
   "text": "不收邮件",
   "start": 13.288,
   "end": 14.075,
   "id": "c6"
  },
  {
   "text": "不上 Telegram",
   "start": 14.124,
   "end": 15.323,
   "id": "c7"
  },
  {
   "text": "不打开外部文件",
   "start": 15.461,
   "end": 16.746,
   "id": "c8"
  },
  {
   "text": "日常办公电脑",
   "start": 17.105,
   "end": 18.468,
   "id": "c9"
  },
  {
   "text": "用来沟通和写文档",
   "start": 18.676,
   "end": 20.324,
   "id": "c10"
  },
  {
   "text": "不存生产凭证和私钥",
   "start": 20.539,
   "end": 22.531,
   "id": "c11"
  },
  {
   "text": "开发电脑要运行外部项目",
   "start": 22.848,
   "end": 25.157,
   "id": "c12"
  },
  {
   "text": "就放进隔离的虚拟机",
   "start": 25.38,
   "end": 27.523,
   "id": "c13"
  },
  {
   "text": "或者一次性环境",
   "start": 27.697,
   "end": 29.131,
   "id": "c14"
  },
  {
   "text": "第二条 流程控制",
   "start": 29.465,
   "end": 31.283,
   "id": "c15"
  },
  {
   "text": "资金操作",
   "start": 31.59,
   "end": 32.553,
   "id": "c16"
  },
  {
   "text": "合约发布",
   "start": 32.63,
   "end": 33.516,
   "id": "c17"
  },
  {
   "text": "权限变更",
   "start": 33.577,
   "end": 34.486,
   "id": "c18"
  },
  {
   "text": "至少两人独立确认",
   "start": 34.61,
   "end": 36.263,
   "id": "c19"
  },
  {
   "text": "这叫双人原则",
   "start": 36.491,
   "end": 37.866,
   "id": "c20"
  },
  {
   "text": "大额交易和权限变更",
   "start": 38.226,
   "end": 40.105,
   "id": "c21"
  },
  {
   "text": "用预先登记的电话或当面确认",
   "start": 40.159,
   "end": 42.793,
   "id": "c22"
  },
  {
   "text": "这叫带外确认",
   "start": 42.864,
   "end": 44.264,
   "id": "c23"
  },
  {
   "text": "要点是 不用发起请求的那个渠道",
   "start": 44.602,
   "end": 47.645,
   "id": "c24"
  },
  {
   "text": "发起人 审批人 执行人 审计人",
   "start": 47.93,
   "end": 51.637,
   "id": "c25"
  },
  {
   "text": "不能是同一个人",
   "start": 51.733,
   "end": 52.864,
   "id": "c26"
  },
  {
   "text": "这叫职责分离",
   "start": 53.077,
   "end": 54.8,
   "id": "c27"
  },
  {
   "text": "关键系统用硬件密钥",
   "start": 55.124,
   "end": 56.928,
   "id": "c28"
  },
  {
   "text": "会话短期有效",
   "start": 57.221,
   "end": 58.543,
   "id": "c29"
  },
  {
   "text": "异地登录要告警",
   "start": 58.778,
   "end": 60.182,
   "id": "c30"
  },
  {
