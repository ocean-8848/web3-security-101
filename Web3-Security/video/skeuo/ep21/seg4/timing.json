 "captions": [
  {
   "text": "第二种手法",
   "start": 1.643,
   "end": 2.55,
   "id": "c0"
  },
  {
   "text": "是一个会议",
   "start": 2.57,
   "end": 3.571,
   "id": "c1"
  },
  {
   "text": "攻击者冒充媒体或投资机构",
   "start": 3.946,
   "end": 6.632,
   "id": "c2"
  },
  {
   "text": "邀请你参加访谈或路演",
   "start": 6.79,
   "end": 8.944,
   "id": "c3"
  },
  {
   "text": "然后要你下载一个专用会议软件",
   "start": 9.29,
   "end": 12.019,
   "id": "c4"
  },
  {
   "text": "或者在会议里申请远程控制",
   "start": 12.409,
   "end": 14.797,
   "id": "c5"
  },
  {
   "text": "2025 年 4 月",
   "start": 15.196,
   "end": 16.494,
   "id": "c6"
  },
  {
   "text": "Trail of Bits 公开了一种做法",
   "start": 16.763,
   "end": 19.125,
   "id": "c7"
  },
  {
   "text": "攻击者在 Zoom 通话里",
   "start": 19.39,
   "end": 21.459,
   "id": "c8"
  },
  {
   "text": "把自己的显示名改成 Zoom",
   "start": 21.65,
   "end": 24.245,
   "id": "c9"
  },
  {
   "text": "弹窗写着 Zoom 请求控制你的屏幕",
   "start": 24.584,
   "end": 27.394,
   "id": "c10"
  },
  {
   "text": "看起来像系统提示",
   "start": 27.753,
   "end": 29.414,
   "id": "c11"
  },
  {
   "text": "但这里的 Zoom",
   "start": 29.67,
   "end": 30.872,
   "id": "c12"
  },
  {
   "text": "只是一个参会者的名字",
   "start": 30.951,
   "end": 32.748,
   "id": "c13"
  },
  {
   "text": "点了同意",
   "start": 33.103,
   "end": 33.783,
   "id": "c14"
  },
  {
   "text": "对方就能控制电脑",
   "start": 34.001,
   "end": 35.499,
   "id": "c15"
  },
  {
   "text": "打开钱包或密码管理器",
   "start": 35.519,
   "end": 37.478,
   "id": "c16"
  },
  {
   "text": "同年 2 月",
   "start": 37.71,
   "end": 38.53,
   "id": "c17"
  },
  {
   "text": "还有人发布假的 Web3 职位",
   "start": 38.779,
   "end": 40.893,
   "id": "c18"
  },
  {
   "text": "引导求职者安装 GrassCall 会议软件",
   "start": 41.221,
   "end": 44.021,
   "id": "c19"
  },
  {
   "text": "里面是窃密木马",
   "start": 44.196,
   "end": 45.686,
   "id": "c20"
  },
  {
   "text": "第三种手法",
   "start": 45.91,
   "end": 47.014,
   "id": "c21"
  },
  {
   "text": "是把人直接送进公司",
   "start": 47.133,
   "end": 49.313,
   "id": "c22"
  },
  {
   "text": "攻击者用盗用或伪造的身份",
   "start": 49.57,
   "end": 52.329,
   "id": "c23"
  },
  {
   "text": "应聘远程开发岗位",
   "start": 52.519,
   "end": 54.205,
   "id": "c24"
  },
  {
   "text": "美国检方在 2025 年 6 月",
   "start": 54.524,
   "end": 57.273,
   "id": "c25"
  },
  {
   "text": "起诉了 4 名朝鲜人",
   "start": 57.406,
   "end": 59.105,
   "id": "c26"
  },
  {
   "text": "他们冒名受雇于区块链公司",
   "start": 59.29,
   "end": 61.76,
   "id": "c27"
  },
  {
   "text": "其中一人修改了雇主两个智能合约的源码",
   "start": 62.192,
   "end": 65.204,
   "id": "c28"
  },
  {
   "text": "把约 74 万美元转到自己的地址",
   "start": 65.529,
   "end": 68.695,
   "id": "c29"
  },
  {
   "text": "全案约 91.5 万美元",
   "start": 68.909,
   "end": 71.292,
   "id": "c30"
  },
  {
   "text": "最后一种",
   "start": 71.662,
   "end": 72.437,
   "id": "c31"
  },
  {
   "text": "是一笔钱",
   "start": 72.672,
   "end": 73.564,
   "id": "c32"
  },
  {
   "text": "2025 年 5 月",
   "start": 73.79,
   "end": 75.107,
   "id": "c33"
  },
  {
   "text": "攻击者用现金",
   "start": 75.289,
   "end": 76.789,
   "id": "c34"
  },
  {
   "text": "收买了 Coinbase 的海外外包客服",
   "start": 76.884,
   "end": 79.6,
   "id": "c35"
  },
  {
   "text": "导出约 7 万名用户的数据",
   "start": 79.942,
   "end": 82.12,
   "id": "c36"
  },
  {
   "text": "再冒充 Coinbase 行骗",
   "start": 82.339,
   "end": 84.042,
   "id": "c37"
  },
  {
   "text": "Coinbase 估算",
   "start": 84.412,
   "end": 85.535,
   "id": "c38"
  },
  {
   "text": "成本约 1.8 亿到 4 亿美元",
   "start": 85.665,
   "end": 88.563,
   "id": "c39"
  },
  {
   "text": "同年 7 月",
   "start": 88.77,
   "end": 89.657,
   "id": "c40"
  },
  {
   "text": "CoinDCX 的一名员工被兼职工作吸引",
   "start": 89.736,
   "end": 93.234,
   "id": "c41"
  },
  {
   "text": "在公司电脑上装了恶意软件",
   "start": 93.261,
   "end": 95.604,
   "id": "c42"
