 "captions": [
  {
   "text": "普通用户也会遇到同样的手法",
   "start": 1.55,
   "end": 4.439,
   "id": "c0"
  },
  {
   "text": "招聘者让你下载项目",
   "start": 4.65,
   "end": 6.457,
   "id": "c1"
  },
  {
   "text": "运行脚本",
   "start": 6.538,
   "end": 7.432,
   "id": "c2"
  },
  {
   "text": "安装会议软件",
   "start": 7.54,
   "end": 8.638,
   "id": "c3"
  },
  {
   "text": "先停下来",
   "start": 8.9,
   "end": 9.647,
   "id": "c4"
  },
  {
   "text": "不在存放钱包的电脑上",
   "start": 9.91,
   "end": 11.726,
   "id": "c5"
  },
  {
   "text": "运行陌生项目",
   "start": 11.848,
   "end": 13.133,
   "id": "c6"
  },
  {
   "text": "打开陌生文件",
   "start": 13.153,
   "end": 14.234,
   "id": "c7"
  },
  {
   "text": "会议里 拒绝任何远程控制请求",
   "start": 14.53,
   "end": 17.384,
   "id": "c8"
  },
  {
   "text": "客服主动联系你",
   "start": 17.63,
   "end": 19.286,
   "id": "c9"
  },
  {
   "text": "说账户有风险",
   "start": 19.367,
   "end": 20.743,
   "id": "c10"
  },
  {
   "text": "要你转移资产",
   "start": 20.859,
   "end": 22.106,
   "id": "c11"
  },
  {
   "text": "一律挂断",
   "start": 22.21,
   "end": 22.987,
   "id": "c12"
  },
  {
   "text": "再从官方 App 里联系客服",
   "start": 23.459,
   "end": 25.614,
   "id": "c13"
  },
  {
   "text": "如果你是签名人",
   "start": 25.945,
   "end": 27.279,
   "id": "c14"
  },
  {
   "text": "今天就把聊天软件",
   "start": 27.43,
   "end": 28.935,
   "id": "c15"
  },
  {
   "text": "从签名设备上删掉",
   "start": 29.02,
   "end": 30.442,
   "id": "c16"
  },
  {
   "text": "如果你是开发者",
   "start": 30.805,
   "end": 32.223,
   "id": "c17"
  },
  {
   "text": "陌生项目一律先在隔离环境里打开",
   "start": 32.422,
   "end": 35.167,
   "id": "c18"
  },
  {
   "text": "如果你负责团队",
   "start": 35.507,
   "end": 36.776,
   "id": "c19"
  },
  {
   "text": "查一遍离职清单",
   "start": 37.086,
   "end": 38.376,
   "id": "c20"
  },
  {
   "text": "看它有没有覆盖边缘权限",
   "start": 38.71,
   "end": 40.766,
   "id": "c21"
  },
  {
   "text": "回到开头的题",
   "start": 40.99,
   "end": 42.262,
   "id": "c22"
  },
  {
   "text": "作业仓库靠的是安装脚本",
   "start": 42.49,
   "end": 44.843,
   "id": "c23"
  },
  {
   "text": "安装步骤运行了混淆的命令",
   "start": 45.021,
   "end": 47.373,
   "id": "c24"
  },
  {
   "text": "把合法的 pyenv 组件换成了恶意版本",
   "start": 47.56,
   "end": 51.227,
   "id": "c25"
  },
  {
   "text": "当时的终端防护没有发现",
   "start": 51.604,
   "end": 53.794,
   "id": "c26"
  },
  {
   "text": "在工作电脑上运行外部代码",
   "start": 54.028,
   "end": 56.457,
   "id": "c27"
  },
  {
   "text": "这一步就够了",
   "start": 56.57,
   "end": 57.794,
   "id": "c28"
  },
  {
   "text": "而在 6 月",
   "start": 58.147,
   "end": 59.036,
   "id": "c29"
  },
  {
   "text": "另一名工程师下载过被篡改的 Homebrew",
   "start": 59.184,
   "end": 62.415,
   "id": "c30"
  },
  {
   "text": "Binance 当时就发现并清理了这台设备",
   "start": 62.608,
   "end": 65.622,
   "id": "c31"
  },
  {
   "text": "但报告称",
   "start": 65.964,
   "end": 66.795,
   "id": "c32"
  },
  {
   "text": "攻击者由此了解了工程师的角色和同事",
   "start": 66.903,
   "end": 70.219,
   "id": "c33"
  },
  {
   "text": "一次清理完成",
   "start": 70.585,
   "end": 71.791,
   "id": "c34"
  },
  {
   "text": "不代表威胁结束",
   "start": 71.821,
   "end": 73.08,
   "id": "c35"
  },
  {
   "text": "攻击者先攻破人",
   "start": 73.35,
   "end": 75.009,
   "id": "c36"
  },
  {
   "text": "防线就要设计成",
   "start": 75.203,
   "end": 76.612,
   "id": "c37"
  },
  {
   "text": "一个人被攻破",
   "start": 76.668,
   "end": 77.919,
   "id": "c38"
  },
  {
   "text": "也转不走钱",
   "start": 78.101,
   "end": 79.031,
   "id": "c39"
  },
  {
   "text": "下一集讲人身与账号安全",
   "start": 79.33,
   "end": 82.146,
   "id": "c40"
  }
 ]
}