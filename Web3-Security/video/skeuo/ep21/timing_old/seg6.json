   "dur": 4.4,
   "speechStart": 66.014,
   "speechEnd": 70.099
  },
  {
   "id": "seg6-13",
   "text": "一次清理完成，不代表威胁结束。",
   "spoken": "一次清理完成，不代表威胁结束。",
