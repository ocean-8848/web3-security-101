 "captions": [
  {
   "text": "2022 年 3 月 23 日",
   "start": 1.653,
   "end": 3.779,
   "id": "c0"
  },
  {
   "text": "Ronin 跨链桥被提走约 17.36 万枚 ETH",
   "start": 4.091,
   "end": 8.65,
   "id": "c1"
  },
  {
   "text": "和约 2550 万枚 USDC",
   "start": 8.897,
   "end": 11.876,
   "id": "c2"
  },
  {
   "text": "只用了两笔交易",
   "start": 12.09,
   "end": 13.973,
   "id": "c3"
  },
  {
   "text": "这座桥有 9 个验证者",
   "start": 14.327,
   "end": 16.25,
   "id": "c4"
  },
  {
   "text": "一笔提款",
   "start": 16.623,
   "end": 17.501,
   "id": "c5"
  },
  {
   "text": "只要其中 5 个签名",
   "start": 17.521,
   "end": 19.166,
   "id": "c6"
  },
  {
   "text": "就会放行",
   "start": 19.266,
   "end": 20.136,
   "id": "c7"
  },
  {
   "text": "听上去 要攻破过半数的人",
   "start": 20.35,
   "end": 23.428,
   "id": "c8"
  },
  {
   "text": "先猜一道题",
   "start": 23.69,
   "end": 24.661,
   "id": "c9"
  },
  {
   "text": "9 个验证者里",
   "start": 24.95,
   "end": 26.129,
   "id": "c10"
  },
  {
   "text": "有 4 个由同一家公司 Sky Mavis 运营",
   "start": 26.199,
   "end": 29.276,
   "id": "c11"
  },
  {
   "text": "第 5 个签名",
   "start": 29.49,
   "end": 30.603,
   "id": "c12"
  },
  {
   "text": "可以通过 Axie DAO 的一项授权拿到",
   "start": 30.765,
   "end": 33.558,
   "id": "c13"
  },
  {
   "text": "这项授权",
   "start": 34.303,
   "end": 35.334,
   "id": "c14"
  },
  {
   "text": "本应早就撤销",
   "start": 35.477,
   "end": 36.748,
   "id": "c15"
  },
  {
   "text": "攻击者最少要攻破几个组织",
   "start": 36.99,
   "end": 39.887,
   "id": "c16"
  },
  {
   "text": "答案是两个",
   "start": 40.544,
   "end": 42.041,
   "id": "c17"
  },
  {
   "text": "门限写的是 9 个里要 5 个",
   "start": 42.361,
   "end": 45.653,
   "id": "c18"
  },
  {
   "text": "独立的防线却只有两道",
   "start": 45.84,
   "end": 48.108,
   "id": "c19"
  },
  {
   "text": "按 Ronin 复盘和 Elliptic 的分析",
   "start": 48.503,
   "end": 51.229,
   "id": "c20"
  },
  {
   "text": "攻击者控制了这 5 个验证者的签名",
   "start": 51.425,
   "end": 54.19,
   "id": "c21"
  },
  {
   "text": "公开报道的损失",
   "start": 54.47,
   "end": 56.464,
   "id": "c22"
  },
  {
   "text": "约 6.2 亿美元",
   "start": 56.498,
   "end": 57.839,
   "id": "c23"
  },
  {
   "text": "一座桥 凭什么相信另一条链上发生的事",
   "start": 58.225,
   "end": 61.528,
   "id": "c24"
  }
 ]
}