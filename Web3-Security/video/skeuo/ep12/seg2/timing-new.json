 ],
 "captions": [
  {
   "text": "先给准确的说法",
   "start": 1.648,
   "end": 3.103,
   "id": "c0"
  },
  {
   "text": "跨链桥 是在两条链之间转移资产或消息的系统",
   "start": 4.1,
   "end": 8.293,
   "id": "c1"
  },
  {
   "text": "B 链上的合约",
   "start": 9.264,
   "end": 10.398,
   "id": "c2"
  },
  {
   "text": "要相信 A 链上发生了某件事",
   "start": 10.526,
   "end": 12.922,
   "id": "c3"
  },
  {
   "text": "可 B 链看不到 A 链",
   "start": 13.9,
   "end": 15.534,
   "id": "c4"
  },
  {
   "text": "它只能相信某种证明",
   "start": 15.897,
   "end": 17.543,
   "id": "c5"
  },
  {
   "text": "最常见的做法",
   "start": 18.536,
   "end": 19.956,
   "id": "c6"
  },
  {
   "text": "叫锁定和铸造",
   "start": 20.036,
   "end": 21.444,
   "id": "c7"
  },
  {
   "text": "举个例子",
   "start": 22.428,
   "end": 23.324,
   "id": "c8"
  },
  {
   "text": "用户在 A 链",
   "start": 23.699,
   "end": 24.893,
   "id": "c9"
  },
  {
   "text": "把 100 USDT 存进桥合约 锁起来",
   "start": 24.913,
   "end": 27.881,
   "id": "c10"
  },
  {
   "text": "桥合约发出一条存款事件",
   "start": 28.864,
   "end": 30.974,
   "id": "c11"
  },
  {
   "text": "写着用户",
   "start": 31.066,
   "end": 32.01,
   "id": "c12"
  },
  {
   "text": "金额和一个序号",
   "start": 32.078,
   "end": 33.712,
   "id": "c13"
  },
  {
   "text": "中继者观察 A 链",
   "start": 34.7,
   "end": 36.274,
   "id": "c14"
  },
  {
   "text": "等这笔交易足够确定",
   "start": 36.366,
   "end": 37.906,
   "id": "c15"
  },
  {
   "text": "不会再被回滚",
   "start": 37.926,
   "end": 38.965,
   "id": "c16"
  },
  {
   "text": "然后把消息和证明",
   "start": 39.936,
   "end": 41.844,
   "id": "c17"
  },
  {
   "text": "一起送到 B 链",
   "start": 42.031,
   "end": 43.094,
   "id": "c18"
  },
  {
   "text": "证明可以是一组签名",
   "start": 44.068,
   "end": 45.821,
   "id": "c19"
  },
  {
   "text": "一条 Merkle 证明",
   "start": 45.925,
   "end": 47.262,
   "id": "c20"
  },
  {
   "text": "或者一份零知识证明",
   "start": 47.282,
   "end": 48.809,
   "id": "c21"
  },
  {
   "text": "B 链的桥合约验证证明",
   "start": 49.808,
   "end": 51.74,
   "id": "c22"
  },
  {
   "text": "再检查这个序号没有用过",
   "start": 51.796,
   "end": 53.882,
   "id": "c23"
  },
  {
   "text": "都通过了",
   "start": 54.852,
   "end": 55.748,
   "id": "c24"
  },
  {
   "text": "才给用户铸造 100 枚映射 USDT",
   "start": 55.852,
   "end": 58.914,
   "id": "c25"
  },
  {
   "text": "注意中间这一段",
   "start": 59.896,
   "end": 61.197,
   "id": "c26"
  },
  {
   "text": "从 A 链到 B 链",
   "start": 62.18,
   "end": 63.6,
   "id": "c27"
  },
  {
   "text": "是信任边界",
   "start": 63.62,
   "end": 64.838,
   "id": "c28"
  },
  {
   "text": "B 链判断真假",
   "start": 65.213,
   "end": 66.645,
   "id": "c29"
  },
  {
   "text": "只能靠这一步验证",
   "start": 66.784,
   "end": 68.192,
   "id": "c30"
  },
  {
   "text": "验证要同时查三件事",
   "start": 69.192,
   "end": 71.29,
   "id": "c31"
  },
  {
   "text": "证明是有效的",
   "start": 72.268,
   "end": 73.616,
   "id": "c32"
  },
  {
   "text": "消息没有被处理过",
   "start": 73.98,
   "end": 75.459,
   "id": "c33"
  },
  {
   "text": "消息来自正确的源链和源合约",
   "start": 75.813,
   "end": 78.245,
   "id": "c34"
  },
  {
   "text": "打个比方",
   "start": 79.232,
   "end": 80.187,
   "id": "c35"
  },
  {
   "text": "A 城的银行收下你的金条",
   "start": 81.324,
   "end": 83.267,
   "id": "c36"
  },
  {
   "text": "开一张提货单",
   "start": 83.288,
   "end": 84.458,
   "id": "c37"
  },
  {
   "text": "你拿着它",
   "start": 84.821,
   "end": 85.848,
   "id": "c38"
  },
  {
   "text": "到 B 城银行兑换等值的金券",
   "start": 85.976,
   "end": 87.908,
   "id": "c39"
  },
  {
   "text": "B 城银行看不到 A 城的账本",
   "start": 88.912,
   "end": 91.058,
   "id": "c40"
  },
  {
   "text": "只能看提货单上的签章",
   "start": 91.102,
   "end": 92.879,
   "id": "c41"
  },
  {
   "text": "印章被偷",
   "start": 93.86,
   "end": 94.946,
   "id": "c42"
  },
  {
   "text": "或者核对方法有漏洞",
   "start": 95.002,
   "end": 96.553,
   "id": "c43"
  },
  {
   "text": "B 城银行就会兑出不存在的金子",
   "start": 96.764,
   "end": 98.97,
   "id": "c44"
  },
  {
   "text": "比喻不成立的地方是",
   "start": 99.96,
   "end": 101.522,
   "id": "c45"
  },
  {
   "text": "两座银行的金库加起来",
   "start": 101.626,
   "end": 103.391,
   "id": "c46"
  },
  {
   "text": "往往是整个系统里最大的一笔钱",
   "start": 103.591,
   "end": 105.856,
   "id": "c47"
  },
  {
   "text": "所以跨链桥",
   "start": 106.828,
   "end": 108.343,
   "id": "c48"
  },
  {
   "text": "是攻击者的首选目标",
   "start": 108.363,
   "end": 110.105,
   "id": "c49"
  },
  {
   "text": "反过来走",
   "start": 111.104,
   "end": 112.059,
   "id": "c50"
  },
  {
   "text": "销毁映射代币",
   "start": 112.139,
   "end": 113.512,
   "id": "c51"
  },
  {
   "text": "解锁原来的资产",
   "start": 113.663,
   "end": 114.952,
   "id": "c52"
  },
  {
   "text": "风险一样",
   "start": 115.116,
   "end": 115.988,
   "id": "c53"
  },
  {
   "text": "金额往往更大",
   "start": 116.056,
   "end": 117.44,
   "id": "c54"
  },
  {
   "text": "那么 B 链到底该相信谁",
   "start": 118.428,
   "end": 120.812,
   "id": "c55"
  }
 ]
}