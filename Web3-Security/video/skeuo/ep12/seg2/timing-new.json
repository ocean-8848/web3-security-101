   "start": 109.044,
   "end": 109.175
  },
  {
   "line": 21,
   "text": "首选",
   "start": 109.199,
   "end": 109.592
  },
  {
   "line": 21,
   "text": "目标",
   "start": 109.604,
   "end": 109.985
  },
  {
   "line": 22,
   "text": "反过来",
   "start": 111.154,
   "end": 111.594
  },
