   "start": 113.951,
   "end": 114.07
  },
  {
   "line": 22,
   "text": "原来",
   "start": 114.094,
   "end": 114.296
  },
  {
   "line": 22,
   "text": "的",
   "start": 114.296,
   "end": 114.38
  },
  {
   "line": 22,
