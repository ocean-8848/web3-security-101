   "start": 116.606,
   "end": 116.88
  },
  {
   "line": 22,
   "text": "更",
   "start": 116.892,
   "end": 117.094
  },
  {
   "line": 22,
   "text": "大",
   "start": 117.094,
   "end": 117.32
  },
  {
   "line": 23,
   "text": "那么",
