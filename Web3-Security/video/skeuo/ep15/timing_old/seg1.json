  {
   "text": "2026 年 10 月",
   "start": 1.644,
   "end": 2.952,
   "id": "c0"
  },
  {
   "text": "一个以太坊热钱包出了事",
   "start": 3.146,
   "end": 4.996,
   "id": "c1"
  },
  {
   "text": "攻击者控制了 Binance 的内部签名服务",
   "start": 5.21,
   "end": 8.101,
   "id": "c2"
  },
  {
   "text": "他通过这个服务",
   "start": 8.39,
   "end": 10.638,
   "id": "c3"
  },
  {
   "text": "给热钱包设置了一份 EIP-7702 委托",
   "start": 10.658,
   "end": 14.135,
   "id": "c4"
  },
  {
   "text": "委托的目标",
   "start": 14.37,
   "end": 15.519,
   "id": "c5"
  },
  {
   "text": "是攻击者自己的合约",
   "start": 15.714,
   "end": 17.575,
   "id": "c6"
  },
  {
   "text": "随后 Binance 关闭了提现服务",
   "start": 17.79,
   "end": 20.625,
   "id": "c7"
  },
  {
   "text": "先猜一道题",
   "start": 20.89,
   "end": 21.861,
   "id": "c8"
  },
  {
   "text": "服务关了",
   "start": 22.15,
   "end": 23.403,
   "id": "c9"
  },
  {
   "text": "这份委托会自动失效吗",
   "start": 23.471,
   "end": 25.806,
   "id": "c10"
  },
  {
   "text": "先记住这个问题",
   "start": 26.33,
   "end": 27.491,
   "id": "c11"
  },
  {
   "text": "在旧的模型里",
   "start": 27.75,
   "end": 28.984,
   "id": "c12"
  },
  {
   "text": "签名的意思是",
   "start": 29.183,
   "end": 30.424,
   "id": "c13"
  },
  {
   "text": "转这笔钱",
   "start": 30.677,
   "end": 31.656,
   "id": "c14"
  },
  {
   "text": "现在 签名的意思变成",
   "start": 31.89,
   "end": 34.305,
   "id": "c15"
  },
  {
   "text": "允许这段代码替我做事",
   "start": 34.437,
   "end": 36.714,
   "id": "c16"
  },
  {
   "text": "签名的含义变大",
   "start": 36.99,
   "end": 38.431,
   "id": "c17"
  },
  {
   "text": "签错一次的后果",
   "start": 39.021,
