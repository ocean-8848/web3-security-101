 "captions": [
  {
   "text": "再看 EIP-7702",
   "start": 1.648,
   "end": 4.056,
   "id": "c0"
  },
  {
   "text": "它在 2025 年 5 月",
   "start": 4.207,
   "end": 5.759,
   "id": "c1"
  },
  {
   "text": "随 Pectra 升级上线",
   "start": 5.779,
   "end": 7.484,
   "id": "c2"
  },
  {
   "text": "普通地址可以签一份授权",
   "start": 8.468,
   "end": 10.542,
   "id": "c3"
  },
  {
   "text": "里面写三样东西",
   "start": 10.634,
   "end": 11.804,
   "id": "c4"
  },
  {
   "text": "链 ID 委托合约的地址",
   "start": 12.792,
   "end": 15.247,
   "id": "c5"
  },
  {
   "text": "nonce",
   "start": 15.315,
   "end": 16.069,
   "id": "c6"
  },
  {
   "text": "签完 这个地址的代码",
   "start": 17.044,
   "end": 19.143,
   "id": "c7"
  },
  {
   "text": "变成一个指针",
   "start": 19.163,
   "end": 20.309,
   "id": "c8"
  },
  {
   "text": "指向那个合约",
   "start": 20.389,
   "end": 21.499,
   "id": "c9"
  },
  {
   "text": "从此 这个地址执行的",
   "start": 22.472,
   "end": 24.737,
   "id": "c10"
  },
  {
   "text": "是那个合约的代码",
   "start": 24.757,
   "end": 26.142,
   "id": "c11"
  },
  {
   "text": "这就是委托",
   "start": 27.132,
   "end": 28.29,
   "id": "c12"
  },
  {
   "text": "它是写在地址上的链上状态",
   "start": 28.346,
   "end": 30.421,
   "id": "c13"
  },
  {
   "text": "风险有三层",
   "start": 31.408,
   "end": 32.923,
   "id": "c14"
  },
  {
   "text": "第一层 委托给恶意合约",
   "start": 33.908,
   "end": 36.042,
   "id": "c15"
  },
  {
   "text": "它的代码可以转走全部资产",
   "start": 36.181,
   "end": 38.59,
   "id": "c16"
  },
  {
   "text": "第二层 链 ID 填 0",
   "start": 39.576,
   "end": 41.901,
   "id": "c17"
  },
  {
   "text": "授权在所有支持它的 EVM 链上都有效",
   "start": 41.921,
   "end": 44.888,
   "id": "c18"
  },
  {
   "text": "前提只是",
   "start": 45.868,
   "end": 46.895,
   "id": "c19"
  },
  {
   "text": "那条链上这个地址的 nonce 对得上",
   "start": 47.046,
   "end": 49.311,
   "id": "c20"
  },
  {
   "text": "链 ID 是 0 的授权",
   "start": 50.288,
   "end": 51.993,
   "id": "c21"
  },
  {
   "text": "钱包应该默认拒绝",
   "start": 52.05,
   "end": 53.767,
   "id": "c22"
  },
  {
   "text": "第三层最常见",
   "start": 54.756,
   "end": 56.152,
   "id": "c23"
  },
  {
   "text": "委托合约是合法的",
   "start": 56.351,
   "end": 58.009,
   "id": "c24"
  },
  {
   "text": "用户却签了一个批量执行",
   "start": 58.113,
   "end": 60.366,
   "id": "c25"
  },
  {
   "text": "批量里的内容",
   "start": 61.36,
   "end": 62.506,
   "id": "c26"
  },
  {
   "text": "是转走资产",
   "start": 62.657,
   "end": 63.803,
   "id": "c27"
  },
  {
   "text": "2025 年 5 月",
   "start": 64.796,
   "end": 66.073,
   "id": "c28"
  },
  {
   "text": "一名用户这样损失了约 14.6 万美元",
   "start": 66.26,
   "end": 69.108,
   "id": "c29"
  },
  {
   "text": "2025 年 8 月",
   "start": 70.104,
   "end": 71.345,
   "id": "c30"
  },
  {
   "text": "ScamSniffer 记录到两起同类钓鱼",
   "start": 71.377,
   "end": 74.19,
   "id": "c31"
  },
  {
   "text": "约 100 万和 154 万美元",
   "start": 74.235,
   "end": 76.536,
   "id": "c32"
  },
  {
   "text": "Wintermute 的统计显示",
   "start": 77.524,
   "end": 79.217,
   "id": "c33"
  },
  {
   "text": "绝大部分委托",
   "start": 79.381,
   "end": 80.551,
   "id": "c34"
  },
  {
   "text": "指向同一类复制来的扫币合约",
   "start": 80.571,
   "end": 82.67,
   "id": "c35"
  },
  {
   "text": "它们专门扫走",
   "start": 83.648,
   "end": 84.829,
   "id": "c36"
  },
  {
   "text": "私钥已经泄露的地址收到的 ETH",
   "start": 84.933,
   "end": 87.139,
   "id": "c37"
  },
  {
   "text": "主要风险",
   "start": 88.116,
   "end": 89.036,
   "id": "c38"
  },
  {
   "text": "不在恶意合约",
   "start": 89.056,
   "end": 90.226,
   "id": "c39"
  },
  {
   "text": "而在对合法合约发出的恶意批量",
   "start": 90.449,
   "end": 92.94,
   "id": "c40"
  },
  {
   "text": "钱包必须把批量里的每一步",
   "start": 93.928,
   "end": 95.812,
   "id": "c41"
  },
  {
   "text": "逐项解码给用户看",
   "start": 95.844,
   "end": 97.324,
   "id": "c42"
  },
  {
   "text": "开发者也有三个坑",
   "start": 98.3,
   "end": 99.982,
   "id": "c43"
  },
  {
   "text": "委托时不运行初始化代码",
   "start": 100.968,
   "end": 103.09,
   "id": "c44"
  },
  {
   "text": "攻击者可以抢先初始化",
   "start": 103.253,
   "end": 105.173,
   "id": "c45"
  },
  {
   "text": "所以初始化数据",
   "start": 106.156,
   "end": 107.683,
   "id": "c46"
  },
  {
   "text": "要由这个地址的私钥签名",
   "start": 107.751,
   "end": 109.826,
   "id": "c47"
  },
  {
   "text": "换委托合约时",
   "start": 110.816,
   "end": 112.188,
   "id": "c48"
  },
  {
   "text": "旧存储仍在",
   "start": 112.208,
   "end": 113.355,
   "id": "c49"
  },
  {
   "text": "新合约会读到错的数据",
   "start": 113.423,
   "end": 115.509,
   "id": "c50"
  },
  {
   "text": "要用命名空间存储",
   "start": 116.508,
   "end": 118.13,
   "id": "c51"
  },
  {
   "text": "把两份数据隔开",
   "start": 118.222,
   "end": 119.606,
   "id": "c52"
  },
  {
   "text": "交易发起者等于调用者",
   "start": 120.592,
   "end": 122.309,
   "id": "c53"
  },
  {
   "text": "这个老检查",
   "start": 122.413,
   "end": 123.5,
   "id": "c54"
  },
  {
   "text": "不再能证明对方是普通地址",
   "start": 123.544,
   "end": 125.821,
   "id": "c55"
  },
  {
   "text": "EIP-7702 原文写明",
   "start": 126.812,
   "end": 129.017,
   "id": "c56"
  },
  {
   "text": "应用不应该请求用户签署委托授权",
   "start": 129.228,
   "end": 132.16,
   "id": "c57"
  },
  {
   "text": "网站请你升级成智能账户",
   "start": 133.152,
   "end": 135.5,
   "id": "c58"
  },
  {
   "text": "默认拒绝",
   "start": 135.616,
   "end": 136.595,
   "id": "c59"
  }
 ]
}