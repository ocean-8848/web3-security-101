   "text": "验证只检查签名",
   "start": 58.436,
   "end": 60.153,
   "id": "c29"
  },
  {
   "text": "验证写错了",
   "start": 61.128,
   "end": 62.345,
   "id": "c30"
  },
  {
   "text": "执行的就是攻击者的调用",
   "start": 62.449,
   "end": 64.357,
   "id": "c31"
  },
  {
   "text": "2024 年 3 月",
   "start": 65.356,
   "end": 66.645,
   "id": "c32"
  },
  {
   "text": "Code4rena 审计了 Coinbase",
   "start": 66.725,
   "end": 69.014,
   "id": "c33"
  },
  {
   "text": "SmartWallet",
   "start": 69.034,
   "end": 70.133,
   "id": "c34"
  },
  {
   "text": "删除 owner 的操作",
   "start": 71.12,
   "end": 72.612,
   "id": "c35"
  },
  {
   "text": "可以跨链重放",
   "start": 72.632,
   "end": 73.802,
   "id": "c36"
  },
  {
   "text": "各条链上",
   "start": 74.772,
   "end": 75.644,
   "id": "c37"
  },
  {
   "text": "同一个位置的 owner 可能不同",
   "start": 75.7,
   "end": 77.751,
   "id": "c38"
  },
  {
   "text": "重放过去",
   "start": 78.736,
   "end": 79.81,
   "id": "c39"
  },
  {
   "text": "可能删错人",
