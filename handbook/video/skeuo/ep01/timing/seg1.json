 "lines": [
  {
   "id": "seg1-00",
   "text": "2025 年 2 月，Bybit 的多签签名人，签了一笔看起来很正常的交易。",
   "spoken": "2025 年 2 月，Bybit 的多签签名人，签了一笔看起来很正常的交易。",
   "src": "/Users/k/Workon/Learning/web3/web3-security-101/handbook/video/skeuo/ep01/audio/lines/seg1-00.mp3",
   "start": 1.6,
   "dur": 5.904,
   "speechStart": 1.698,
   "speechEnd": 6.662
  },
  {
   "id": "seg1-01",
   "text": "可他们用的 Safe 钱包网页前端，已经被人篡改了。",
   "spoken": "可他们用的 Safe 钱包网页前端，已经被人篡改了。",
   "src": "/Users/k/Workon/Learning/web3/web3-security-101/handbook/video/skeuo/ep01/audio/lines/seg1-01.mp3",
   "start": 7.724,
   "dur": 4.416,
   "speechStart": 7.822,
   "speechEnd": 11.31
  },
  {
   "id": "seg1-02",
   "text": "签下去的这笔交易，替换了多签的实现合约。",
   "spoken": "签下去的这笔交易，替换了多签的实现合约。",
   "src": "/Users/k/Workon/Learning/web3/web3-security-101/handbook/video/skeuo/ep01/audio/lines/seg1-02.mp3",
   "start": 12.36,
   "dur": 4.128,
   "speechStart": 12.458,
   "speechEnd": 15.648
  },
  {
   "id": "seg1-03",
   "text": "约 15 亿美元，就这样被转走。",
   "spoken": "约 15 亿美元，就这样被转走。",
   "src": "/Users/k/Workon/Learning/web3/web3-security-101/handbook/video/skeuo/ep01/audio/lines/seg1-03.mp3",
   "start": 16.708,
   "dur": 3.312,
   "speechStart": 16.806,
   "speechEnd": 19.187
  },
  {
   "id": "seg1-04",
   "text": "先请你猜一猜。Safe 多签合约的代码，有没有被利用的漏洞？",
   "spoken": "先请你猜一猜。Safe 多签合约的代码，有没有被利用的漏洞？",
