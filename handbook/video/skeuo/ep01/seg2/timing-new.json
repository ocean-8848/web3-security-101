 "captions": [
  {
   "text": "先给一个准确的定义",
   "start": 1.648,
   "end": 3.199,
   "id": "c0"
  },
  {
   "text": "智能合约",
   "start": 4.196,
   "end": 5.128,
   "id": "c1"
  },
  {
   "text": "是部署在区块链上",
   "start": 5.148,
   "end": 6.711,
   "id": "c2"
  },
  {
   "text": "按代码自动执行的程序",
   "start": 6.779,
   "end": 8.687,
   "id": "c3"
  },
  {
   "text": "它可以持有资产",
   "start": 9.062,
   "end": 10.411,
   "id": "c4"
  },
  {
   "text": "也可以转出资产",
   "start": 10.455,
   "end": 11.708,
   "id": "c5"
  },
  {
   "text": "压成一句话就是",
   "start": 12.696,
   "end": 14.128,
   "id": "c6"
  },
  {
   "text": "一段公开的",
   "start": 14.231,
   "end": 15.354,
   "id": "c7"
  },
  {
   "text": "不可撤回的",
   "start": 15.374,
   "end": 16.449,
   "id": "c8"
  },
  {
   "text": "直接控制资金的代码",
   "start": 16.493,
   "end": 18.104,
   "id": "c9"
  },
  {
   "text": "任何人 都可以用任意参数",
   "start": 19.084,
   "end": 21.432,
   "id": "c10"
  },
  {
   "text": "任意顺序调用它",
   "start": 21.56,
   "end": 22.968,
   "id": "c11"
  },
  {
   "text": "打个比方",
   "start": 23.936,
   "end": 24.891,
   "id": "c12"
  },
  {
   "text": "它像一台放在广场中央的自动售货机",
   "start": 25.255,
   "end": 28.187,
   "id": "c13"
  },
  {
   "text": "机器里装着真金白银",
   "start": 29.172,
   "end": 30.901,
   "id": "c14"
  },
  {
   "text": "这就是合约余额",
   "start": 31.053,
   "end": 32.389,
   "id": "c15"
  },
  {
   "text": "电路图贴在外壳上",
   "start": 33.376,
   "end": 35.272,
   "id": "c16"
  },
  {
   "text": "谁都能看",
   "start": 35.459,
   "end": 36.355,
   "id": "c17"
  },
  {
   "text": "合约的字节码一定公开",
   "start": 36.718,
   "end": 38.4,
   "id": "c18"
  },
  {
   "text": "源码通常也公开",
   "start": 38.552,
   "end": 39.96,
   "id": "c19"
  },
  {
   "text": "全世界的人",
   "start": 40.94,
   "end": 42.098,
   "id": "c20"
  },
  {
   "text": "可以全天候来投币 按按钮",
   "start": 42.13,
   "end": 44.633,
   "id": "c21"
  },
  {
   "text": "拍打机器",
   "start": 44.749,
   "end": 45.788,
   "id": "c22"
  },
  {
   "text": "机器装好以后",
   "start": 46.776,
   "end": 48.113,
   "id": "c23"
  },
  {
   "text": "就不能打开维修",
   "start": 48.133,
   "end": 49.386,
   "id": "c24"
  },
  {
   "text": "如果留了维修门",
   "start": 50.38,
   "end": 51.681,
   "id": "c25"
  },
  {
   "text": "也就是升级代理",
   "start": 51.701,
   "end": 52.895,
   "id": "c26"
  },
  {
   "text": "这把钥匙本身就成了攻击目标",
   "start": 53.249,
   "end": 55.764,
   "id": "c27"
  },
  {
   "text": "机器吐错了钱",
   "start": 56.744,
   "end": 57.985,
   "id": "c28"
  },
  {
   "text": "没有客服能帮你追回",
   "start": 58.125,
   "end": 59.818,
   "id": "c29"
  },
  {
   "text": "交易是不可逆的",
   "start": 60.194,
   "end": 61.447,
   "id": "c30"
  },
  {
   "text": "但这个比方有个地方不成立",
   "start": 62.412,
   "end": 64.629,
   "id": "c31"
  },
  {
   "text": "真实的售货机",
   "start": 64.993,
   "end": 66.21,
   "id": "c32"
  },
  {
   "text": "一次只服务一个人",
   "start": 66.326,
   "end": 67.663,
   "id": "c33"
  },
  {
   "text": "合约在一笔交易里",
   "start": 68.632,
   "end": 70.004,
   "id": "c34"
  },
  {
   "text": "可以被同一个人反复调用",
   "start": 70.06,
   "end": 71.802,
   "id": "c35"
  },
  {
   "text": "嵌套调用",
   "start": 71.822,
   "end": 72.813,
   "id": "c36"
  },
  {
   "text": "它还能和几十台别的售货机",
   "start": 73.796,
   "end": 75.728,
   "id": "c37"
  },
  {
   "text": "拼在一起用",
   "start": 75.784,
   "end": 76.716,
   "id": "c38"
  },
  {
   "text": "这叫可组合性",
   "start": 77.079,
   "end": 78.427,
   "id": "c39"
  },
  {
   "text": "很多漏洞",
   "start": 78.805,
   "end": 79.808,
   "id": "c40"
  },
  {
   "text": "正是从这里来的",
   "start": 79.865,
   "end": 81.154,
   "id": "c41"
  },
  {
   "text": "拿它和 Web2 后端",
   "start": 82.128,
   "end": 83.655,
   "id": "c42"
  },
  {
   "text": "中心化交易所比一比",
   "start": 83.723,
   "end": 85.25,
   "id": "c43"
  },
  {
   "text": "最关键的区别有三个",
   "start": 85.282,
   "end": 86.821,
   "id": "c44"
  },
  {
   "text": "第一 谁能调用",
   "start": 87.796,
   "end": 89.454,
   "id": "c45"
  },
  {
   "text": "Web2 要先鉴权",
   "start": 89.829,
   "end": 91.475,
   "id": "c46"
  },
  {
   "text": "交易所要先过 KYC",
   "start": 91.567,
   "end": 93.594,
   "id": "c47"
  },
  {
   "text": "合约面前",
   "start": 94.592,
   "end": 95.619,
   "id": "c48"
  },
  {
   "text": "任何地址",
   "start": 95.699,
   "end": 96.762,
   "id": "c49"
  },
  {
   "text": "任何合约都能来",
   "start": 96.901,
   "end": 98.297,
   "id": "c50"
  },
  {
   "text": "public 函数",
   "start": 98.661,
   "end": 99.819,
   "id": "c51"
  },
  {
   "text": "就是对全世界开放的 API",
   "start": 99.851,
   "end": 102.354,
   "id": "c52"
  },
  {
   "text": "第二 出错能不能回滚",
   "start": 103.332,
   "end": 105.513,
   "id": "c53"
  },
  {
   "text": "Web2 可以改数据库",
   "start": 105.889,
   "end": 107.737,
   "id": "c54"
  },
  {
   "text": "交易所可以改内部账本",
   "start": 107.889,
   "end": 109.642,
   "id": "c55"
  },
  {
   "text": "合约的交易不可逆",
   "start": 110.632,
   "end": 112.075,
   "id": "c56"
  },
  {
   "text": "只能靠升级",
   "start": 112.155,
   "end": 113.326,
   "id": "c57"
  },
  {
   "text": "或者社会共识",
   "start": 113.346,
   "end": 114.552,
   "id": "c58"
  },
  {
   "text": "没有升级权限",
   "start": 114.927,
   "end": 116.323,
   "id": "c59"
  },
  {
   "text": "就修不了",
   "start": 116.51,
   "end": 117.371,
   "id": "c60"
  },
  {
   "text": "第三 攻击成本",
   "start": 118.34,
   "end": 119.95,
   "id": "c61"
  },
  {
   "text": "在别处 要绕过防火墙",
   "start": 120.325,
   "end": 122.769,
   "id": "c62"
  },
  {
   "text": "或者攻破内部系统",
   "start": 122.837,
   "end": 124.341,
   "id": "c63"
  },
  {
   "text": "在合约这里",
