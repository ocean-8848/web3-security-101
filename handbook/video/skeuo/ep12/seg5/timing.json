 "captions": [
  {
   "text": "把这些根因倒过来",
   "start": 1.644,
   "end": 3.226,
   "id": "c0"
  },
  {
   "text": "就是防御",
   "start": 3.271,
   "end": 4.127,
   "id": "c1"
  },
  {
   "text": "先看验证者",
   "start": 4.41,
   "end": 5.79,
   "id": "c2"
  },
  {
   "text": "门限要高于三分之二",
   "start": 6.217,
   "end": 8.259,
   "id": "c3"
  },
  {
   "text": "签名人在组织",
   "start": 8.55,
   "end": 10.397,
   "id": "c4"
  },
  {
   "text": "地域和基础设施上都要独立",
   "start": 10.488,
   "end": 13.167,
   "id": "c5"
  },
  {
   "text": "并且定期核对签名权清单",
   "start": 13.291,
   "end": 15.884,
   "id": "c6"
  },
  {
   "text": "再看消息",
   "start": 16.13,
   "end": 17.109,
   "id": "c7"
  },
  {
   "text": "消息里要写明源链 源合约 目标链",
   "start": 17.28,
   "end": 21.149,
   "id": "c8"
  },
  {
   "text": "目标合约和序号",
   "start": 21.288,
   "end": 22.82,
   "id": "c9"
  },
  {
   "text": "目标侧逐项核对",
   "start": 23.089,
   "end": 24.741,
   "id": "c10"
  },
  {
   "text": "处理过的消息要打上标记",
   "start": 25.085,
   "end": 27.305,
   "id": "c11"
  },
  {
   "text": "防止重放",
   "start": 27.496,
   "end": 28.33,
   "id": "c12"
  },
  {
   "text": "证明验证代码要有独立审计和测试向量",
   "start": 28.667,
   "end": 32.516,
   "id": "c13"
  },
  {
   "text": "零值 空数组",
   "start": 32.59,
   "end": 34.168,
   "id": "c14"
  },
  {
   "text": "没初始化的根",
   "start": 34.223,
   "end": 35.414,
   "id": "c15"
  },
  {
   "text": "都不能当作有效证明",
   "start": 35.457,
   "end": 37.486,
   "id": "c16"
  },
  {
   "text": "Merkle 树的叶子和中间节点",
   "start": 37.846,
   "end": 40.002,
   "id": "c17"
  },
  {
   "text": "要用不同的哈希前缀",
   "start": 40.131,
   "end": 41.704,
   "id": "c18"
  },
  {
   "text": "执行消息时",
   "start": 42.063,
   "end": 43.006,
   "id": "c19"
  },
  {
   "text": "目标地址和函数走白名单",
   "start": 43.093,
   "end": 45.111,
   "id": "c20"
  },
  {
   "text": "不许碰特权合约",
   "start": 45.322,
   "end": 46.705,
   "id": "c21"
  },
  {
   "text": "然后是限额",
   "start": 47.09,
   "end": 48.454,
   "id": "c22"
  },
  {
   "text": "单笔和单位时间的提款都有上限",
   "start": 48.746,
   "end": 51.522,
   "id": "c23"
  },
  {
   "text": "超过就进延迟队列",
   "start": 51.583,
   "end": 53.332,
   "id": "c24"
  },
  {
   "text": "监控两侧的总量",
   "start": 53.61,
   "end": 55.038,
   "id": "c25"
  },
  {
   "text": "A 链锁定的",
   "start": 55.25,
   "end": 56.18,
   "id": "c26"
  },
  {
   "text": "要不少于 B 链铸造的",
   "start": 56.245,
   "end": 57.759,
   "id": "c27"
  },
  {
   "text": "对不上 就自动暂停",
   "start": 57.955,
   "end": 59.408,
   "id": "c28"
  },
  {
   "text": "最后是升级",
   "start": 59.67,
   "end": 60.898,
   "id": "c29"
  },
  {
   "text": "桥合约升级必须经过时间锁",
   "start": 61.352,
   "end": 64.08,
   "id": "c30"
  },
  {
   "text": "初始化参数必须审计",
   "start": 64.1,
   "end": 65.969,
   "id": "c31"
  },
  {
   "text": "同样的问题",
   "start": 66.21,
   "end": 67.215,
   "id": "c32"
  },
  {
   "text": "也出现在交易所的充值系统里",
   "start": 67.349,
   "end": 69.664,
   "id": "c33"
  },
  {
   "text": "交易所相信链上发生了一笔转账",
   "start": 69.87,
   "end": 72.491,
   "id": "c34"
  },
  {
   "text": "然后在内部账本上记账",
   "start": 72.712,
   "end": 74.791,
   "id": "c35"
  },
  {
   "text": "这也是一座桥",
   "start": 74.996,
   "end": 76.154,
   "id": "c36"
  },
  {
   "text": "假币合约会发出同名的转账事件",
   "start": 76.41,
   "end": 79.506,
   "id": "c37"
  },
  {
   "text": "所以要核对代币合约地址",
   "start": 79.995,
   "end": 82.229,
   "id": "c38"
  },
  {
   "text": "不看名称和符号",
   "start": 82.268,
   "end": 83.691,
   "id": "c39"
  },
  {
   "text": "在 TRON 上",
   "start": 83.99,
   "end": 85.208,
   "id": "c40"
  },
  {
   "text": "转账失败的交易",
   "start": 85.391,
   "end": 86.691,
   "id": "c41"
  },
  {
   "text": "比如能量不足",
   "start": 86.729,
   "end": 88.09,
   "id": "c42"
  },
  {
   "text": "仍然会上链",
   "start": 88.147,
   "end": 89.071,
   "id": "c43"
  },
  {
   "text": "也有交易哈希",
   "start": 89.299,
   "end": 90.482,
   "id": "c44"
  },
  {
   "text": "只看交易存在就入账",
   "start": 90.77,
   "end": 92.618,
   "id": "c45"
  },
  {
   "text": "就会出现假充值",
   "start": 92.663,
   "end": 94.034,
   "id": "c46"
  },
  {
   "text": "要先确认回执状态是成功",
   "start": 94.425,
   "end": 96.729,
   "id": "c47"
  },
  {
   "text": "再看事件",
   "start": 96.819,
   "end": 97.554,
   "id": "c48"
  },
  {
   "text": "同一笔交易",
   "start": 97.887,
   "end": 98.752,
   "id": "c49"
  },
  {
   "text": "用交易哈希加日志序号做幂等键",
   "start": 99.009,
   "end": 101.769,
   "id": "c50"
  },
  {
   "text": "防止重复入账",
   "start": 101.942,
   "end": 103.107,
   "id": "c51"
  },
  {
   "text": "入账前等够确认数",
   "start": 103.465,
   "end": 105.22,
   "id": "c52"
  },
  {
   "text": "防止源链重组把这笔交易抹掉",
   "start": 105.593,
   "end": 108.033,
   "id": "c53"
  }
 ]
}