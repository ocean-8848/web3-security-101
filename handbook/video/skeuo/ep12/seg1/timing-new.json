 "lines": [
  {
   "id": "seg1-00",
   "text": "2022 年 3 月 23 日，Ronin 跨链桥被提走约 17.36 万枚 ETH，和约 2550 万枚 USDC。",
   "spoken": "2022 年 3 月 23 日，Ronin 跨链桥被提走约 17.36 万枚 ETH，和约 2550 万枚 USDC。",
   "src": "/Users/k/Workon/Learning/web3/web3-security-101/handbook/video/skeuo/ep12/audio/lines/seg1-00.mp3",
   "start": 1.6,
   "dur": 8.88,
   "speechStart": 1.698,
   "speechEnd": 9.638
  },
  {
   "id": "seg1-01",
   "text": "只用了两笔交易。",
   "spoken": "只用了两笔交易。",
   "src": "/Users/k/Workon/Learning/web3/web3-security-101/handbook/video/skeuo/ep12/audio/lines/seg1-01.mp3",
   "start": 10.7,
   "dur": 2.088,
   "speechStart": 10.798,
   "speechEnd": 11.952
  },
  {
   "id": "seg1-02",
   "text": "这座桥有 9 个验证者。",
   "spoken": "这座桥有 9 个验证者。",
   "src": "/Users/k/Workon/Learning/web3/web3-security-101/handbook/video/skeuo/ep12/audio/lines/seg1-02.mp3",
   "start": 13.008,
   "dur": 2.856,
   "speechStart": 13.106,
   "speechEnd": 15.022
  },
  {
   "id": "seg1-03",
   "text": "一笔提款，只要其中 5 个签名，就会放行。",
   "spoken": "一笔提款，只要其中 5 个签名，就会放行。",
   "src": "/Users/k/Workon/Learning/web3/web3-security-101/handbook/video/skeuo/ep12/audio/lines/seg1-03.mp3",
   "start": 16.084,
   "dur": 4.416,
   "speechStart": 16.182,
   "speechEnd": 19.67
  },
  {
   "id": "seg1-04",
   "text": "听上去，要攻破过半数的人。",
   "spoken": "听上去，要攻破过半数的人。",
   "src": "/Users/k/Workon/Learning/web3/web3-security-101/handbook/video/skeuo/ep12/audio/lines/seg1-04.mp3",
   "start": 20.72,
   "dur": 3.144,
   "speechStart": 20.818,
   "speechEnd": 23.044
  },
  {
   "id": "seg1-05",
   "text": "先猜一道题。",
   "spoken": "先猜一道题。",
   "src": "/Users/k/Workon/Learning/web3/web3-security-101/handbook/video/skeuo/ep12/audio/lines/seg1-05.mp3",
   "start": 24.084,
   "dur": 2.088,
   "speechStart": 24.182,
   "speechEnd": 25.336
  },
  {
   "id": "seg1-06",
   "text": "9 个验证者里，有 4 个由同一家公司 Sky Mavis 运营。",
   "spoken": "9 个验证者里，有 4 个由同一家公司 Sky Mavis 运营。",
   "src": "/Users/k/Workon/Learning/web3/web3-security-101/handbook/video/skeuo/ep12/audio/lines/seg1-06.mp3",
   "start": 26.392,
   "dur": 4.992,
   "speechStart": 26.49,
   "speechEnd": 30.549
  },
  {
   "id": "seg1-07",
   "text": "第 5 个签名，可以通过 Axie DAO 的一项授权拿到。这项授权，本应早就撤销。",
   "spoken": "第 5 个签名，可以通过 Axie DAO 的一项授权拿到。这项授权，本应早就撤销。",
   "src": "/Users/k/Workon/Learning/web3/web3-security-101/handbook/video/skeuo/ep12/audio/lines/seg1-07.mp3",
   "start": 31.604,
   "dur": 7.632,
   "speechStart": 31.702,
   "speechEnd": 38.402
  },
  {
   "id": "seg1-08",
   "text": "攻击者最少要攻破几个组织？",
   "spoken": "攻击者最少要攻破几个组织？",
   "src": "/Users/k/Workon/Learning/web3/web3-security-101/handbook/video/skeuo/ep12/audio/lines/seg1-08.mp3",
   "start": 39.456,
   "dur": 3.0,
   "speechStart": 39.554,
   "speechEnd": 41.613
  },
  {
   "id": "seg1-09",
   "text": "答案是两个。",
   "spoken": "答案是两个。",
   "src": "/Users/k/Workon/Learning/web3/web3-security-101/handbook/video/skeuo/ep12/audio/lines/seg1-09.mp3",
   "start": 42.956,
   "dur": 1.872,
   "speechStart": 43.054,
   "speechEnd": 43.935
  },
  {
   "id": "seg1-10",
   "text": "门限写的是 9 个里要 5 个，独立的防线却只有两道。",
   "spoken": "门限写的是 9 个里要 5 个，独立的防线却只有两道。",
   "src": "/Users/k/Workon/Learning/web3/web3-security-101/handbook/video/skeuo/ep12/audio/lines/seg1-10.mp3",
   "start": 45.048,
   "dur": 5.04,
   "speechStart": 45.146,
   "speechEnd": 49.265
  },
  {
   "id": "seg1-11",
   "text": "按 Ronin 复盘和 Elliptic 的分析，攻击者控制了这 5 个验证者的签名。",
   "spoken": "按 Ronin 复盘和 Elliptic 的分析，攻击者控制了这 5 个验证者的签名。",
   "src": "/Users/k/Workon/Learning/web3/web3-security-101/handbook/video/skeuo/ep12/audio/lines/seg1-11.mp3",
   "start": 50.308,
   "dur": 6.096,
   "speechStart": 50.406,
   "speechEnd": 55.56
  },
  {
   "id": "seg1-12",
   "text": "公开报道的损失，约 6.2 亿美元。",
   "spoken": "公开报道的损失，约 6.2 亿美元。",
   "src": "/Users/k/Workon/Learning/web3/web3-security-101/handbook/video/skeuo/ep12/audio/lines/seg1-12.mp3",
   "start": 56.624,
   "dur": 3.552,
   "speechStart": 56.722,
   "speechEnd": 59.329
  },
  {
