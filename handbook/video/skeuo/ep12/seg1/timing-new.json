 "captions": [
  {
   "text": "2022 年 3 月 23 日",
   "start": 1.648,
   "end": 3.425,
   "id": "c0"
  },
  {
   "text": "Ronin 跨链桥被提走约 17.36 万枚 ETH",
   "start": 3.517,
   "end": 6.865,
   "id": "c1"
  },
  {
   "text": "和约 2550 万枚 USDC",
   "start": 7.052,
   "end": 9.758,
   "id": "c2"
  },
  {
   "text": "只用了两笔交易",
   "start": 10.748,
   "end": 12.072,
   "id": "c3"
  },
  {
   "text": "这座桥有 9 个验证者",
   "start": 13.056,
   "end": 15.142,
   "id": "c4"
  },
  {
   "text": "一笔提款",
   "start": 16.132,
   "end": 17.111,
   "id": "c5"
  },
  {
   "text": "只要其中 5 个签名",
   "start": 17.31,
   "end": 18.706,
   "id": "c6"
  },
  {
   "text": "就会放行",
   "start": 18.87,
   "end": 19.79,
   "id": "c7"
  },
  {
   "text": "听上去 要攻破过半数的人",
   "start": 20.768,
   "end": 23.164,
   "id": "c8"
  },
  {
   "text": "先猜一道题",
   "start": 24.132,
   "end": 25.456,
   "id": "c9"
  },
  {
   "text": "9 个验证者里",
   "start": 26.44,
   "end": 27.586,
   "id": "c10"
  },
  {
   "text": "有 4 个由同一家公司 Sky Mavis 运营",
   "start": 27.702,
   "end": 30.669,
   "id": "c11"
  },
  {
   "text": "第 5 个签名",
   "start": 31.652,
   "end": 32.667,
   "id": "c12"
  },
  {
   "text": "可以通过 Axie DAO 的一项授权拿到",
   "start": 32.687,
   "end": 35.417,
   "id": "c13"
  },
  {
   "text": "这项授权",
   "start": 35.792,
   "end": 36.855,
   "id": "c14"
  },
  {
   "text": "本应早就撤销",
   "start": 36.971,
   "end": 38.522,
   "id": "c15"
  },
  {
   "text": "攻击者最少要攻破几个组织",
   "start": 39.504,
   "end": 41.733,
   "id": "c16"
  },
  {
   "text": "答案是两个",
   "start": 43.004,
   "end": 44.055,
   "id": "c17"
  },
  {
   "text": "门限写的是 9 个里要 5 个",
   "start": 45.096,
   "end": 47.337,
   "id": "c18"
  },
  {
   "text": "独立的防线却只有两道",
   "start": 47.477,
   "end": 49.385,
   "id": "c19"
  },
  {
   "text": "按 Ronin 复盘和 Elliptic 的分析",
   "start": 50.356,
   "end": 53.049,
   "id": "c20"
  },
  {
   "text": "攻击者控制了这 5 个验证者的签名",
   "start": 53.237,
   "end": 55.68,
   "id": "c21"
  },
  {
   "text": "公开报道的损失",
   "start": 56.672,
   "end": 57.996,
   "id": "c22"
  },
  {
   "text": "约 6.2 亿美元",
   "start": 58.076,
   "end": 59.449,
   "id": "c23"
  },
  {
   "text": "一座桥 凭什么相信另一条链上发生的事",
   "start": 60.444,
   "end": 64.018,
   "id": "c24"
  }
 ]
}