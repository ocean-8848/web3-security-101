 "captions": [
  {
   "text": "验证的方式",
   "start": 1.648,
   "end": 2.806,
   "id": "c0"
  },
  {
   "text": "大致有四种",
   "start": 2.886,
   "end": 3.972,
   "id": "c1"
  },
  {
   "text": "差别在于",
   "start": 4.336,
   "end": 5.339,
   "id": "c2"
  },
  {
   "text": "你信任谁",
   "start": 5.502,
   "end": 6.47,
   "id": "c3"
  },
  {
   "text": "第一种 外部多签",
   "start": 7.46,
   "end": 8.975,
   "id": "c4"
  },
  {
   "text": "或者 MPC",
   "start": 8.995,
   "end": 10.011,
   "id": "c5"
  },
  {
   "text": "一组验证者",
   "start": 10.992,
   "end": 12.09,
   "id": "c6"
  },
  {
   "text": "凑够门限个签名 就放行",
   "start": 12.146,
   "end": 14.507,
   "id": "c7"
  },
  {
   "text": "你信任的是这些签名人",
   "start": 15.484,
   "end": 17.213,
   "id": "c8"
  },
  {
   "text": "风险是私钥泄露",
   "start": 17.576,
   "end": 19.175,
   "id": "c9"
  },
  {
   "text": "验证者共谋",
   "start": 19.315,
   "end": 20.426,
   "id": "c10"
  },
  {
   "text": "或者门限太低",
   "start": 20.446,
   "end": 21.639,
   "id": "c11"
  },
  {
   "text": "Ronin 就是这一种",
   "start": 22.616,
   "end": 24.19,
   "id": "c12"
  },
  {
   "text": "第二种 轻客户端",
   "start": 25.164,
   "end": 27.084,
   "id": "c13"
  },
  {
   "text": "也叫原生证明",
   "start": 27.116,
   "end": 28.453,
   "id": "c14"
  },
  {
   "text": "B 链上的合约",
   "start": 29.44,
   "end": 30.526,
   "id": "c15"
  },
  {
   "text": "自己验证 A 链的区块头和证明",
   "start": 30.571,
   "end": 32.979,
   "id": "c16"
  },
  {
   "text": "你信任的是 A 链的共识",
   "start": 33.98,
   "end": 36.138,
   "id": "c17"
  },
  {
   "text": "加上这段证明验证代码",
   "start": 36.23,
   "end": 38.197,
   "id": "c18"
  },
  {
   "text": "代码有漏洞",
   "start": 39.192,
   "end": 40.219,
   "id": "c19"
  },
  {
   "text": "证明就能伪造",
   "start": 40.406,
   "end": 41.516,
   "id": "c20"
  },
  {
   "text": "2022 年的 BNB Chain Token Hub",
   "start": 41.892,
   "end": 44.49,
   "id": "c21"
  },
  {
   "text": "属于这一种",
   "start": 44.523,
   "end": 45.431,
   "id": "c22"
  },
  {
   "text": "第三种 乐观证明",
   "start": 46.396,
   "end": 48.447,
   "id": "c23"
  },
  {
   "text": "消息默认有效",
   "start": 49.424,
   "end": 50.76,
   "id": "c24"
  },
  {
   "text": "但留出一段挑战期",
   "start": 50.888,
   "end": 52.415,
   "id": "c25"
  },
  {
   "text": "这期间 任何人都可以提交欺诈证明推翻它",
   "start": 52.79,
   "end": 56.472,
   "id": "c26"
  },
  {
   "text": "你只需要一个诚实的挑战者",
   "start": 57.444,
   "end": 59.483,
   "id": "c27"
  },
  {
   "text": "风险是挑战期里没人盯着",
   "start": 59.858,
   "end": 62.361,
   "id": "c28"
  },
  {
   "text": "或者挑战者被审查",
   "start": 62.525,
   "end": 64.254,
   "id": "c29"
  },
  {
   "text": "多数乐观 Rollup 的原生桥",
   "start": 65.248,
   "end": 67.585,
   "id": "c30"
  },
  {
   "text": "用的是这一种",
   "start": 67.605,
   "end": 68.549,
   "id": "c31"
  },
  {
   "text": "第四种 零知识证明",
   "start": 69.524,
   "end": 71.575,
   "id": "c32"
  },
  {
   "text": "用数学证明 A 链的状态变化是正确的",
   "start": 72.576,
   "end": 75.698,
   "id": "c33"
  },
  {
   "text": "不用逐条核对账本",
   "start": 75.79,
   "end": 77.317,
   "id": "c34"
  },
  {
   "text": "你信任的是数学",
   "start": 78.316,
   "end": 79.759,
   "id": "c35"
  },
  {
   "text": "加上证明系统的实现和可信设置",
   "start": 79.899,
   "end": 82.295,
   "id": "c36"
  },
  {
   "text": "电路或验证器写错",
   "start": 82.67,
   "end": 84.4,
   "id": "c37"
  },
  {
   "text": "一样会出事",
   "start": 84.551,
   "end": 85.555,
   "id": "c38"
  },
  {
   "text": "再猜一道题",
   "start": 86.552,
   "end": 87.829,
   "id": "c39"
  },
  {
   "text": "一座 ZK 桥",
   "start": 88.192,
   "end": 89.434,
   "id": "c40"
  },
  {
   "text": "证明系统完全正确",
   "start": 89.454,
   "end": 91.053,
   "id": "c41"
  },
  {
   "text": "但桥合约可以被一个多签无延迟升级",
   "start": 91.204,
   "end": 94.017,
   "id": "c42"
  },
  {
   "text": "用户只需要信任数学吗",
   "start": 95.004,
   "end": 97.007,
   "id": "c43"
  },
  {
   "text": "不是",
   "start": 98.264,
   "end": 98.957,
   "id": "c44"
  },
  {
   "text": "多签可以把桥合约换成新实现",
   "start": 99.321,
   "end": 101.979,
   "id": "c45"
  },
  {
   "text": "绕过证明系统",
   "start": 102.083,
   "end": 103.205,
   "id": "c46"
  },
  {
   "text": "用户同时信任证明系统",
   "start": 104.196,
   "end": 106.199,
   "id": "c47"
  },
  {
   "text": "和升级权限的持有人",
   "start": 106.219,
   "end": 108.104,
   "id": "c48"
  },
  {
   "text": "按 L2BEAT 截至 2026 年的页面",
   "start": 109.072,
   "end": 111.694,
   "id": "c49"
  },
  {
   "text": "Mantle 用的是 OP Succinct",
   "start": 111.857,
   "end": 114.04,
   "id": "c50"
  },
  {
   "text": "有效性证明",
   "start": 114.06,
   "end": 115.123,
   "id": "c51"
  },
  {
   "text": "但它的输出预言机",
   "start": 116.108,
   "end": 117.539,
   "id": "c52"
  },
  {
   "text": "可以由工程多签切换到乐观模式",
   "start": 117.596,
   "end": 120.254,
   "id": "c53"
  },
  {
   "text": "桥合约可以由安全多签无延迟升级",
   "start": 120.629,
   "end": 123.585,
   "id": "c54"
  },
  {
   "text": "L2 的原生桥",
   "start": 124.584,
   "end": 125.849,
   "id": "c55"
  },
  {
   "text": "也是一座跨链桥",
   "start": 125.869,
   "end": 127.289,
   "id": "c56"
  },
  {
   "text": "它的安全",
   "start": 127.653,
   "end": 128.561,
   "id": "c57"
  },
  {
   "text": "取决于证明系统和升级权限两样",
   "start": 128.641,
   "end": 131.382,
   "id": "c58"
  }
 ]
