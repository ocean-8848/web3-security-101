 "captions": [
  {
   "text": "每个人 今天能做一件事",
   "start": 1.647,
   "end": 3.853,
   "id": "c0"
  },
  {
   "text": "写桥的人 把源链 目标链",
   "start": 4.17,
   "end": 7.342,
   "id": "c1"
  },
  {
   "text": "两侧合约和序号",
   "start": 7.586,
   "end": 8.567,
   "id": "c2"
  },
  {
   "text": "全部写进消息哈希",
   "start": 8.631,
   "end": 11.083,
   "id": "c3"
  },
  {
   "text": "审计的人",
   "start": 11.35,
   "end": 12.306,
   "id": "c4"
  },
  {
   "text": "列出签名人和运营商",
   "start": 12.546,
   "end": 14.455,
   "id": "c5"
  },
  {
   "text": "算一算攻破几个独立组织",
   "start": 14.694,
   "end": 16.804,
   "id": "c6"
  },
  {
   "text": "就能放行一条伪造消息",
   "start": 16.881,
   "end": 18.674,
   "id": "c7"
  },
  {
   "text": "普通用户",
   "start": 19.024,
   "end": 19.815,
   "id": "c8"
  },
  {
   "text": "跨链前先看这座桥靠什么验证",
   "start": 20.19,
   "end": 22.812,
   "id": "c9"
  },
  {
   "text": "L2BEAT 会列出风险",
   "start": 23.309,
   "end": 25.166,
   "id": "c10"
  },
  {
   "text": "只用官方入口",
   "start": 25.39,
   "end": 26.783,
   "id": "c11"
  },
  {
   "text": "跨链后核对收到的代币合约地址",
   "start": 27.303,
   "end": 30.424,
   "id": "c12"
  },
  {
   "text": "不要长期拿着映射代币",
   "start": 30.662,
   "end": 32.737,
   "id": "c13"
  },
  {
   "text": "回到开头的问题",
   "start": 32.97,
   "end": 34.182,
   "id": "c14"
  },
  {
   "text": "9 个验证者",
   "start": 34.397,
   "end": 35.544,
   "id": "c15"
  },
  {
   "text": "最少要攻破几个组织",
   "start": 35.775,
   "end": 37.703,
   "id": "c16"
  },
  {
   "text": "两个",
   "start": 38.27,
   "end": 38.929,
   "id": "c17"
  },
  {
   "text": "门限是 9 个里要 5 个",
   "start": 39.411,
   "end": 41.68,
   "id": "c18"
  },
  {
   "text": "可签名人并不独立",
   "start": 41.893,
   "end": 43.434,
   "id": "c19"
  },
  {
   "text": "这个答案成立的前提",
   "start": 43.786,
   "end": 45.336,
   "id": "c20"
  },
  {
   "text": "是那项本应撤销的授权仍在生效",
   "start": 45.539,
   "end": 48.553,
   "id": "c21"
  },
  {
   "text": "跨链桥的安全",
   "start": 48.885,
   "end": 50.077,
   "id": "c22"
  },
  {
   "text": "就看 B 链凭什么相信",
   "start": 50.171,
   "end": 52.003,
   "id": "c23"
  },
  {
   "text": "证明机制被骗",
   "start": 52.607,
   "end": 53.868,
   "id": "c24"
  },
  {
   "text": "桥上的钱就会被骗走",
   "start": 53.985,
   "end": 55.859,
   "id": "c25"
  },
  {
   "text": "下一集讲非 EVM 生态的安全",
   "start": 56.13,
   "end": 59.138,
   "id": "c26"
  }
 ]
