 "captions": [
  {
   "text": "验证的方式",
   "start": 1.55,
   "end": 2.622,
   "id": "c0"
  },
  {
   "text": "大致有四种",
   "start": 2.662,
   "end": 3.75,
   "id": "c1"
  },
  {
   "text": "差别在于",
   "start": 3.858,
   "end": 4.731,
   "id": "c2"
  },
  {
   "text": "你信任谁",
   "start": 4.767,
   "end": 5.696,
   "id": "c3"
  },
  {
   "text": "第一种 外部多签",
   "start": 6.032,
   "end": 7.85,
   "id": "c4"
  },
  {
   "text": "或者 MPC",
   "start": 7.976,
   "end": 9.213,
   "id": "c5"
  },
  {
   "text": "一组验证者",
   "start": 9.51,
   "end": 10.703,
   "id": "c6"
  },
  {
   "text": "凑够门限个签名 就放行",
   "start": 10.764,
   "end": 12.972,
   "id": "c7"
  },
  {
   "text": "你信任的是这些签名人",
   "start": 13.25,
   "end": 15.517,
   "id": "c8"
  },
  {
   "text": "风险是私钥泄露",
   "start": 15.765,
   "end": 17.48,
   "id": "c9"
  },
  {
   "text": "验证者共谋",
   "start": 17.691,
   "end": 18.771,
   "id": "c10"
  },
  {
   "text": "或者门限太低",
   "start": 18.896,
   "end": 20.317,
   "id": "c11"
  },
  {
   "text": "Ronin 就是这一种",
   "start": 20.684,
   "end": 22.06,
   "id": "c12"
  },
  {
   "text": "第二种 轻客户端",
   "start": 22.424,
   "end": 24.339,
   "id": "c13"
  },
  {
   "text": "也叫原生证明",
   "start": 24.548,
   "end": 26.012,
   "id": "c14"
  },
  {
   "text": "B 链上的合约",
   "start": 26.34,
   "end": 27.391,
   "id": "c15"
  },
  {
   "text": "自己验证 A 链的区块头和证明",
   "start": 27.548,
   "end": 30.292,
   "id": "c16"
  },
  {
   "text": "你信任的是 A 链的共识",
   "start": 30.626,
   "end": 32.57,
   "id": "c17"
  },
  {
   "text": "加上这段证明验证代码",
   "start": 32.784,
   "end": 34.83,
   "id": "c18"
  },
  {
   "text": "代码有漏洞",
   "start": 35.07,
   "end": 36.171,
   "id": "c19"
  },
  {
   "text": "证明就能伪造",
   "start": 36.201,
   "end": 37.297,
   "id": "c20"
  },
  {
   "text": "2022 年的 BNB Chain Token Hub",
   "start": 37.547,
   "end": 40.234,
   "id": "c21"
  },
  {
   "text": "属于这一种",
   "start": 40.324,
   "end": 41.131,
   "id": "c22"
  },
  {
   "text": "第三种 乐观证明",
   "start": 41.37,
   "end": 43.296,
   "id": "c23"
  },
  {
   "text": "消息默认有效",
   "start": 43.59,
   "end": 44.894,
   "id": "c24"
  },
  {
   "text": "但留出一段挑战期",
   "start": 45.012,
   "end": 46.662,
   "id": "c25"
  },
  {
   "text": "这期间 任何人都可以提交欺诈证明推翻它",
   "start": 46.805,
   "end": 50.232,
   "id": "c26"
  },
  {
   "text": "你只需要一个诚实的挑战者",
   "start": 50.543,
   "end": 52.907,
   "id": "c27"
  },
  {
   "text": "风险是挑战期里没人盯着",
   "start": 53.623,
   "end": 56.221,
   "id": "c28"
  },
  {
   "text": "或者挑战者被审查",
   "start": 56.321,
   "end": 57.825,
   "id": "c29"
  },
  {
   "text": "多数乐观 Rollup 的原生桥",
   "start": 58.206,
   "end": 60.339,
   "id": "c30"
  },
  {
   "text": "用的是这一种",
   "start": 60.359,
   "end": 61.316,
   "id": "c31"
  },
  {
   "text": "第四种 零知识证明",
   "start": 61.53,
   "end": 63.666,
   "id": "c32"
  },
  {
   "text": "用数学证明 A 链的状态变化是正确的",
   "start": 63.91,
   "end": 66.733,
   "id": "c33"
  },
  {
   "text": "不用逐条核对账本",
   "start": 66.863,
   "end": 68.357,
   "id": "c34"
  },
  {
   "text": "你信任的是数学",
   "start": 68.701,
   "end": 70.313,
   "id": "c35"
  },
  {
   "text": "加上证明系统的实现和可信设置",
   "start": 70.457,
   "end": 73.529,
   "id": "c36"
  },
  {
   "text": "电路或验证器写错",
   "start": 73.714,
   "end": 75.467,
   "id": "c37"
  },
  {
   "text": "一样会出事",
   "start": 75.605,
   "end": 76.537,
   "id": "c38"
  },
  {
   "text": "再猜一道题",
   "start": 76.83,
   "end": 77.729,
   "id": "c39"
  },
  {
   "text": "一座 ZK 桥",
   "start": 77.961,
   "end": 79.136,
   "id": "c40"
  },
  {
   "text": "证明系统完全正确",
   "start": 79.305,
   "end": 80.861,
   "id": "c41"
  },
  {
   "text": "但桥合约可以被一个多签无延迟升级",
   "start": 81.294,
   "end": 84.61,
   "id": "c42"
  },
  {
   "text": "用户只需要信任数学吗",
   "start": 84.89,
   "end": 86.857,
   "id": "c43"
  },
  {
   "text": "不是",
   "start": 87.486,
   "end": 87.923,
   "id": "c44"
  },
  {
   "text": "多签可以把桥合约换成新实现",
   "start": 88.241,
   "end": 91.036,
   "id": "c45"
  },
  {
   "text": "绕过证明系统",
   "start": 91.16,
   "end": 92.462,
   "id": "c46"
  },
  {
   "text": "用户同时信任证明系统",
   "start": 92.73,
   "end": 94.81,
   "id": "c47"
  },
  {
   "text": "和升级权限的持有人",
   "start": 94.941,
   "end": 96.583,
   "id": "c48"
  },
  {
   "text": "按 L2BEAT 截至 2026 年的页面",
   "start": 96.968,
   "end": 100.083,
   "id": "c49"
  },
  {
   "text": "Mantle 用的是 OP Succinct",
   "start": 100.237,
   "end": 102.021,
   "id": "c50"
  },
  {
   "text": "有效性证明",
   "start": 102.041,
   "end": 103.139,
   "id": "c51"
  },
  {
   "text": "但它的输出预言机",
   "start": 103.506,
   "end": 105.122,
   "id": "c52"
  },
  {
   "text": "可以由工程多签切换到乐观模式",
   "start": 105.264,
   "end": 108.101,
   "id": "c53"
  },
  {
   "text": "桥合约可以由安全多签无延迟升级",
   "start": 108.343,
   "end": 111.636,
   "id": "c54"
  },
  {
   "text": "L2 的原生桥",
   "start": 111.97,
   "end": 113.364,
   "id": "c55"
  },
  {
   "text": "也是一座跨链桥",
   "start": 113.463,
   "end": 114.992,
   "id": "c56"
  },
  {
   "text": "它的安全",
   "start": 115.227,
   "end": 115.982,
   "id": "c57"
  },
  {
   "text": "取决于证明系统和升级权限两样",
   "start": 116.089,
   "end": 118.928,
   "id": "c58"
  }
 ]
}