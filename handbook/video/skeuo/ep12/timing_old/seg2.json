   "text": "信",
   "start": 111.594,
   "end": 111.82
  },
  {
   "line": 23,
   "text": "谁",
   "start": 111.82,
   "end": 112.045
  }
 ],
 "captions": [
  {
   "text": "先给准确的说法",
   "start": 1.55,
   "end": 2.807,
   "id": "c0"
  },
  {
   "text": "跨链桥 是在两条链之间转移资产或消息的系统",
   "start": 3.05,
   "end": 7.848,
   "id": "c1"
  },
  {
   "text": "B 链上的合约",
   "start": 8.171,
   "end": 9.242,
   "id": "c2"
  },
  {
   "text": "要相信 A 链上发生了某件事",
   "start": 9.39,
   "end": 11.888,
   "id": "c3"
  },
  {
   "text": "可 B 链看不到 A 链",
   "start": 12.13,
   "end": 14.009,
   "id": "c4"
  },
  {
   "text": "它只能相信某种证明",
   "start": 14.473,
   "end": 16.308,
   "id": "c5"
  },
  {
   "text": "最常见的做法",
   "start": 16.59,
   "end": 17.791,
   "id": "c6"
  },
  {
   "text": "叫锁定和铸造",
   "start": 17.903,
   "end": 19.475,
   "id": "c7"
  },
  {
   "text": "举个例子",
   "start": 19.69,
   "end": 20.404,
   "id": "c8"
  },
  {
   "text": "用户在 A 链",
   "start": 20.908,
   "end": 22.093,
   "id": "c9"
  },
  {
   "text": "把 100 USDT 存进桥合约 锁起来",
   "start": 22.17,
   "end": 25.512,
   "id": "c10"
  },
  {
   "text": "桥合约发出一条存款事件",
   "start": 25.75,
   "end": 28.516,
   "id": "c11"
  },
  {
   "text": "写着用户",
   "start": 28.772,
   "end": 29.981,
   "id": "c12"
  },
  {
   "text": "金额和一个序号",
   "start": 30.178,
   "end": 31.915,
   "id": "c13"
  },
  {
   "text": "中继者观察 A 链",
   "start": 32.227,
   "end": 33.882,
   "id": "c14"
  },
  {
   "text": "等这笔交易足够确定",
   "start": 34.011,
   "end": 35.844,
   "id": "c15"
  },
  {
   "text": "不会再被回滚",
   "start": 35.916,
   "end": 37.19,
   "id": "c16"
  },
  {
   "text": "然后把消息和证明",
   "start": 37.566,
   "end": 39.275,
   "id": "c17"
  },
  {
   "text": "一起送到 B 链",
   "start": 39.404,
   "end": 40.659,
   "id": "c18"
  },
  {
   "text": "证明可以是一组签名",
   "start": 40.989,
   "end": 42.906,
   "id": "c19"
  },
  {
   "text": "一条 Merkle 证明",
   "start": 43.016,
   "end": 44.342,
   "id": "c20"
  },
  {
   "text": "或者一份零知识证明",
   "start": 44.435,
   "end": 46.066,
   "id": "c21"
  },
  {
   "text": "B 链的桥合约验证证明",
   "start": 46.405,
   "end": 48.676,
   "id": "c22"
  },
  {
   "text": "再检查这个序号没有用过",
   "start": 48.865,
   "end": 51.01,
   "id": "c23"
  },
  {
   "text": "都通过了",
   "start": 51.345,
   "end": 52.167,
   "id": "c24"
  },
  {
   "text": "才给用户铸造 100 枚映射 USDT",
   "start": 52.224,
   "end": 55.084,
   "id": "c25"
  },
  {
   "text": "注意中间这一段",
   "start": 55.31,
   "end": 56.744,
   "id": "c26"
  },
  {
   "text": "从 A 链到 B 链",
   "start": 57.05,
   "end": 58.667,
   "id": "c27"
  },
  {
   "text": "是信任边界",
   "start": 58.719,
   "end": 59.867,
   "id": "c28"
  },
  {
   "text": "B 链判断真假",
   "start": 60.041,
   "end": 61.352,
   "id": "c29"
  },
  {
   "text": "只能靠这一步验证",
   "start": 61.39,
   "end": 62.898,
   "id": "c30"
  },
  {
   "text": "验证要同时查三件事",
   "start": 63.19,
   "end": 65.789,
   "id": "c31"
  },
  {
   "text": "证明是有效的",
   "start": 66.05,
   "end": 67.624,
   "id": "c32"
  },
  {
   "text": "消息没有被处理过",
   "start": 67.644,
   "end": 68.629,
   "id": "c33"
  },
  {
   "text": "消息来自正确的源链和源合约",
   "start": 68.904,
   "end": 71.555,
   "id": "c34"
  },
  {
   "text": "打个比方",
   "start": 71.89,
   "end": 72.548,
   "id": "c35"
  },
  {
   "text": "A 城的银行收下你的金条",
   "start": 72.91,
   "end": 74.954,
   "id": "c36"
  },
  {
   "text": "开一张提货单",
   "start": 75.226,
   "end": 76.379,
   "id": "c37"
  },
  {
   "text": "你拿着它",
   "start": 76.916,
   "end": 77.79,
   "id": "c38"
  },
  {
   "text": "到 B 城银行兑换等值的金券",
   "start": 77.842,
   "end": 80.427,
   "id": "c39"
  },
  {
   "text": "B 城银行看不到 A 城的账本",
   "start": 80.729,
   "end": 83.17,
   "id": "c40"
  },
  {
   "text": "只能看提货单上的签章",
   "start": 83.277,
   "end": 85.252,
   "id": "c41"
  },
  {
   "text": "印章被偷",
   "start": 85.49,
   "end": 86.593,
   "id": "c42"
  },
  {
   "text": "或者核对方法有漏洞",
   "start": 86.613,
   "end": 88.489,
   "id": "c43"
  },
  {
   "text": "B 城银行就会兑出不存在的金子",
   "start": 89.012,
   "end": 91.595,
   "id": "c44"
  },
  {
   "text": "比喻不成立的地方是",
   "start": 91.962,
   "end": 93.503,
   "id": "c45"
  },
  {
   "text": "两座银行的金库加起来",
   "start": 93.753,
   "end": 95.908,
   "id": "c46"
  },
  {
   "text": "往往是整个系统里最大的一笔钱",
   "start": 96.052,
   "end": 98.747,
   "id": "c47"
  },
  {
   "text": "所以跨链桥",
   "start": 98.97,
   "end": 100.369,
   "id": "c48"
  },
  {
   "text": "是攻击者的首选目标",
   "start": 100.505,
   "end": 102.392,
   "id": "c49"
  },
  {
   "text": "反过来走",
   "start": 102.63,
   "end": 103.548,
   "id": "c50"
  },
  {
   "text": "销毁映射代币",
   "start": 103.609,
   "end": 105.033,
   "id": "c51"
  },
  {
   "text": "解锁原来的资产",
   "start": 105.166,
   "end": 106.618,
   "id": "c52"
  },
  {
   "text": "风险一样",
   "start": 106.724,
   "end": 107.531,
   "id": "c53"
  },
  {
   "text": "金额往往更大",
   "start": 107.641,
   "end": 109.219,
   "id": "c54"
  },
  {
   "text": "那么 B 链到底该相信谁",
   "start": 109.581,
   "end": 112.165,
   "id": "c55"
  }
 ]
}