// ---------------------------------------------------------------- cameras
const fit = () => {
  const ps = [];
  for (let i = 1; i <= 8; i++) { ps.push(at(BU[i], -260, 0, 0), at(BU[i], 260, 0, 420), at(BU[i], 0, 0, 0)); }
