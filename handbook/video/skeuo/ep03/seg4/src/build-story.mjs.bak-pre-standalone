  { name: "block.number", myth: "每块固定时间", fact: "BSC：3 秒 → 0.45 秒", impact: "按区块数算利息会错" },
  { name: "函数选择器", myth: "函数名唯一", fact: "选择器只有前 4 字节", impact: "不同签名可能碰撞" },
];

