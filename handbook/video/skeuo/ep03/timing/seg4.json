 "captions": [
  {
   "text": "下面是最容易误解的 8 个语言特性",
   "start": 1.648,
   "end": 4.199,
   "id": "c0"
  },
  {
   "text": "每个都看三件事 误解 事实 影响",
   "start": 4.574,
   "end": 8.541,
   "id": "c1"
  },
  {
   "text": "一 private",
   "start": 9.524,
   "end": 10.967,
   "id": "c2"
  },
  {
   "text": "误解是别人看不到",
   "start": 11.331,
   "end": 13.108,
   "id": "c3"
  },
  {
   "text": "事实是 它只限制其他合约来调用",
   "start": 14.088,
   "end": 17.067,
   "id": "c4"
  },
  {
   "text": "存储完全公开",
   "start": 17.159,
   "end": 18.627,
   "id": "c5"
  },
  {
   "text": "所以不能存秘密",
   "start": 19.002,
   "end": 20.589,
   "id": "c6"
  },
  {
   "text": "二 receive 和 fallback",
   "start": 21.58,
   "end": 23.928,
   "id": "c7"
  },
  {
   "text": "误解是 转账只是改个余额",
   "start": 24.303,
   "end": 26.64,
   "id": "c8"
  },
  {
   "text": "事实是 向合约转 ETH",
   "start": 27.608,
   "end": 29.885,
   "id": "c9"
  },
  {
   "text": "会执行它的代码",
   "start": 29.905,
   "end": 31.087,
   "id": "c10"
  },
  {
   "text": "这就是重入的入口",
   "start": 31.462,
   "end": 32.918,
   "id": "c11"
  },
  {
   "text": "三 selfdestruct",
   "start": 33.9,
   "end": 35.772,
   "id": "c12"
  },
  {
   "text": "误解是它能删掉合约",
   "start": 36.123,
   "end": 37.936,
   "id": "c13"
  },
  {
   "text": "2024 年 Cancun 升级",
   "start": 38.92,
   "end": 40.721,
   "id": "c14"
  },
  {
   "text": "引入了 EIP-6780",
   "start": 40.741,
   "end": 43.244,
   "id": "c15"
  },
  {
   "text": "之后 只有同一笔交易里创建的合约",
   "start": 43.608,
   "end": 46.433,
   "id": "c16"
  },
  {
   "text": "才会被删除",
   "start": 46.453,
   "end": 47.48,
   "id": "c17"
  },
  {
   "text": "其他情况",
   "start": 47.858,
   "end": 48.968,
   "id": "c18"
  },
  {
   "text": "只转走余额",
   "start": 49.06,
   "end": 50.278,
   "id": "c19"
  },
  {
   "text": "四 合约余额",
   "start": 51.26,
   "end": 53.334,
   "id": "c20"
  },
  {
   "text": "误解是 只能通过我的函数增加",
   "start": 53.71,
   "end": 56.284,
   "id": "c21"
  },
  {
   "text": "事实是 任何人都能强制转入",
   "start": 57.264,
   "end": 60.326,
   "id": "c22"
  },
  {
   "text": "比如 selfdestruct",
   "start": 60.702,
   "end": 62.431,
   "id": "c23"
  },
  {
   "text": "比如出块奖励地址",
   "start": 62.547,
   "end": 64.169,
   "id": "c24"
  },
  {
   "text": "所以 拿合约自己的余额来记账",
   "start": 65.164,
   "end": 68.381,
   "id": "c25"
  },
  {
   "text": "会被一笔捐赠打乱",
   "start": 68.414,
   "end": 69.905,
   "id": "c26"
  },
  {
   "text": "五 检查型算术",
   "start": 70.904,
   "end": 72.907,
   "id": "c27"
  },
  {
   "text": "0.8 版以后",
   "start": 73.282,
   "end": 74.524,
   "id": "c28"
  },
  {
   "text": "溢出会回滚",
   "start": 74.639,
   "end": 75.714,
   "id": "c29"
  },
  {
   "text": "但 unchecked 块",
   "start": 76.692,
   "end": 78.135,
   "id": "c30"
  },
  {
   "text": "类型转换",
   "start": 78.156,
   "end": 79.135,
   "id": "c31"
  },
  {
   "text": "除法截断",
   "start": 79.227,
   "end": 80.207,
   "id": "c32"
  },
  {
   "text": "都不会报错",
   "start": 80.275,
   "end": 81.171,
   "id": "c33"
  },
  {
   "text": "六 block.timestamp",
   "start": 82.168,
   "end": 84.111,
   "id": "c34"
  },
  {
   "text": "它不是精确时间",
   "start": 84.475,
   "end": 85.93,
   "id": "c35"
  },
  {
   "text": "出块者可以在小范围内改动它",
   "start": 86.924,
   "end": 89.344,
   "id": "c36"
  },
  {
   "text": "L2 上由排序器决定",
   "start": 89.543,
   "end": 91.486,
   "id": "c37"
  },
  {
   "text": "不能拿它做随机数",
   "start": 91.862,
   "end": 93.317,
   "id": "c38"
  },
  {
   "text": "也不能做秒级判断",
   "start": 93.445,
   "end": 94.913,
   "id": "c39"
  },
  {
   "text": "七 block.number",
   "start": 95.904,
   "end": 97.645,
   "id": "c40"
  },
  {
   "text": "误解是 每个块的时间固定",
   "start": 98.008,
   "end": 100.25,
   "id": "c41"
  },
  {
   "text": "BSC 在 2026 年 1 月的 Fermi 升级后",
   "start": 101.236,
   "end": 104.275,
   "id": "c42"
  },
  {
   "text": "出块时间从 3 秒缩到了 0.45 秒",
   "start": 104.498,
   "end": 107.358,
   "id": "c43"
  },
  {
   "text": "L2 上的含义",
   "start": 107.721,
   "end": 109.129,
   "id": "c44"
  },
  {
   "text": "因链而异",
   "start": 109.174,
   "end": 110.129,
   "id": "c45"
  },
  {
   "text": "用区块数来算利息或锁定期",
   "start": 111.104,
   "end": 113.976,
   "id": "c46"
  },
  {
   "text": "就会出错",
   "start": 113.996,
   "end": 114.774,
   "id": "c47"
  },
  {
   "text": "八 函数选择器",
   "start": 115.764,
   "end": 117.719,
   "id": "c48"
  },
  {
   "text": "误解是 函数名就是唯一的身份",
   "start": 118.095,
   "end": 121.003,
   "id": "c49"
  },
  {
   "text": "事实是 选择器只取哈希的前 4 字节",
   "start": 121.984,
   "end": 125.558,
   "id": "c50"
  },
  {
   "text": "不同的函数签名",
   "start": 125.746,
   "end": 127.059,
   "id": "c51"
  },
  {
   "text": "可能撞在一起",
   "start": 127.079,
   "end": 128.154,
   "id": "c52"
  },
  {
   "text": "2021 年 8 月的 Poly Network 事故",
   "start": 129.14,
   "end": 131.583,
   "id": "c53"
  },
  {
   "text": "关键一步就在这里",
   "start": 131.687,
   "end": 133.012,
   "id": "c54"
  },
  {
   "text": "损失约 6.1 亿美元",
   "start": 133.032,
   "end": 134.833,
   "id": "c55"
  },
  {
   "text": "按公开复盘",
   "start": 135.816,
   "end": 137.105,
   "id": "c56"
  },
  {
   "text": "一个构造出来的函数名",
   "start": 137.328,
   "end": 139.01,
   "id": "c57"
  },
  {
   "text": "撞上了替换验证者公钥的那个函数",
   "start": 139.03,
   "end": 141.89,
   "id": "c58"
  },
  {
   "text": "审计时还要盯住一对词",
   "start": 142.876,
   "end": 145.034,
   "id": "c59"
  },
  {
   "text": "storage 和 memory",
   "start": 145.054,
   "end": 146.807,
   "id": "c60"
  },
  {
   "text": "storage 是引用",
   "start": 147.776,
   "end": 149.184,
   "id": "c61"
  },
  {
   "text": "改了会写回",
   "start": 149.204,
   "end": 150.184,
   "id": "c62"
  },
  {
   "text": "memory 是副本",
   "start": 150.547,
   "end": 151.801,
   "id": "c63"
  },
  {
   "text": "改了不写回",
   "start": 151.821,
   "end": 152.812,
   "id": "c64"
  },
  {
   "text": "写错一个词",
   "start": 153.804,
   "end": 154.855,
   "id": "c65"
  },
  {
   "text": "余额或标志位没更新",
   "start": 155.089,
   "end": 156.7,
   "id": "c66"
  },
  {
   "text": "资金就可能被反复领取",
   "start": 156.887,
   "end": 158.676,
   "id": "c67"
  }
 ]
