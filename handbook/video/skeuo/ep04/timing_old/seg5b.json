 "captions": [
  {
   "text": "最后 每个人今天就能做一件事",
   "start": 1.55,
   "end": 4.357,
   "id": "c0"
  },
  {
   "text": "写合约的人",
   "start": 4.57,
   "end": 5.934,
   "id": "c1"
  },
  {
   "text": "找到第一个把控制权交出去的位置 问一句 那一刻",
   "start": 5.954,
   "end": 10.954,
   "id": "c2"
  },
  {
   "text": "哪些状态还没更新",
   "start": 11.121,
   "end": 12.855,
   "id": "c3"
  },
  {
   "text": "审计的人",
   "start": 13.39,
   "end": 14.414,
   "id": "c4"
  },
  {
   "text": "查一下编译器版本有没有已知的锁 bug",
   "start": 14.434,
   "end": 17.486,
   "id": "c5"
  },
  {
   "text": "再查部署链上转原生币",
   "start": 17.821,
   "end": 20.195,
   "id": "c6"
  },
  {
   "text": "会不会触发 fallback",
   "start": 20.259,
   "end": 21.788,
   "id": "c7"
  },
  {
   "text": "普通用户",
   "start": 22.09,
   "end": 22.962,
   "id": "c8"
  },
  {
   "text": "存款前看协议有没有审计报告",
   "start": 23.464,
   "end": 26.177,
   "id": "c9"
  },
  {
   "text": "范围是否覆盖你要用的合约",
   "start": 26.469,
   "end": 28.585,
   "id": "c10"
  },
  {
   "text": "没有审计的新金库",
   "start": 28.966,
   "end": 30.595,
   "id": "c11"
  },
  {
   "text": "只放能承受损失的金额",
   "start": 30.782,
   "end": 33.07,
   "id": "c12"
  },
  {
   "text": "回到开头的问题",
   "start": 33.434,
   "end": 34.774,
   "id": "c13"
  },
  {
   "text": "只调用一次取款",
   "start": 35.008,
   "end": 36.298,
   "id": "c14"
  },
  {
   "text": "为什么能取走全部 10 个 ETH",
   "start": 36.318,
   "end": 39.236,
   "id": "c15"
  },
  {
   "text": "因为银行先给钱 后记账",
   "start": 39.83,
   "end": 42.533,
   "id": "c16"
  },
  {
   "text": "每一层嵌套调用",
   "start": 43.037,
   "end": 44.441,
   "id": "c17"
  },
  {
   "text": "读到的都是同一个旧余额",
   "start": 44.499,
   "end": 46.847,
   "id": "c18"
  },
  {
   "text": "这个答案的前提",
   "start": 47.187,
   "end": 48.311,
   "id": "c19"
  },
  {
   "text": "是收款方能执行代码",
   "start": 48.427,
   "end": 50.276,
   "id": "c20"
  },
  {
   "text": "而状态在交出控制权之前还没更新",
   "start": 50.616,
   "end": 53.561,
   "id": "c21"
  },
  {
   "text": "把顺序写对",
   "start": 53.964,
   "end": 54.955,
   "id": "c22"
  },
  {
   "text": "第二层读到的就是 0",
   "start": 55.259,
   "end": 57.156,
   "id": "c23"
  },
  {
   "text": "下一集讲访问控制与权限",
   "start": 57.37,
   "end": 60.102,
   "id": "c24"
  },
  {
   "text": "谁有权按这个按钮",
   "start": 60.299,
   "end": 62.047,
   "id": "c25"
  }
 ]
}