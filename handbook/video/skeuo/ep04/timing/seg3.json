   "start": 173.33,
   "end": 173.52
  },
  {
   "line": 29,
   "text": "抵押品",
   "start": 173.52,
   "end": 173.985
  },
  {
   "line": 29,
   "text": "定价",
   "start": 173.997,
   "end": 174.437
  }
 ],
 "captions": [
  {
   "text": "接下来 按调用栈",
   "start": 1.648,
   "end": 3.603,
   "id": "c0"
  },
  {
   "text": "一种一种看",
   "start": 3.838,
   "end": 4.746,
   "id": "c1"
  },
  {
   "text": "第一种 单函数重入",
   "start": 5.732,
   "end": 7.771,
   "id": "c2"
  },
  {
   "text": "漏洞版的取款函数 分三步 读余额 转账 清零",
   "start": 8.76,
   "end": 13.858,
   "id": "c3"
  },
  {
   "text": "攻击者调用取款",
   "start": 14.836,
   "end": 16.434,
   "id": "c4"
  },
  {
   "text": "银行读到余额 1 个 ETH",
   "start": 16.809,
   "end": 18.491,
   "id": "c5"
  },
  {
   "text": "用 call 把钱转过去",
   "start": 18.631,
   "end": 20.301,
   "id": "c6"
  },
  {
   "text": "攻击合约的 receive 被触发",
   "start": 21.272,
   "end": 23.537,
   "id": "c7"
  },
  {
   "text": "银行还有钱",
   "start": 23.9,
   "end": 24.975,
   "id": "c8"
  },
  {
   "text": "它就再调用一次取款",
   "start": 25.126,
   "end": 26.654,
   "id": "c9"
  },
  {
   "text": "第二层读到的余额",
   "start": 27.636,
   "end": 29.127,
   "id": "c10"
  },
  {
   "text": "还是 1 个",
   "start": 29.207,
   "end": 30.091,
   "id": "c11"
  },
  {
   "text": "因为第一层的清零",
   "start": 30.455,
   "end": 31.875,
   "id": "c12"
  },
  {
   "text": "还没执行",
   "start": 31.943,
   "end": 32.922,
   "id": "c13"
  },
  {
   "text": "一层套一层",
   "start": 33.904,
   "end": 35.026,
   "id": "c14"
  },
  {
   "text": "直到金库余额不够",
   "start": 35.177,
   "end": 36.621,
   "id": "c15"
  },
  {
   "text": "递归才停下来",
   "start": 36.701,
   "end": 37.883,
   "id": "c16"
  },
  {
   "text": "然后各层依次返回",
   "start": 38.876,
   "end": 40.51,
   "id": "c17"
  },
  {
   "text": "依次清零",
   "start": 40.614,
   "end": 41.486,
   "id": "c18"
  },
  {
   "text": "这时钱已经没了",
   "start": 41.861,
   "end": 43.258,
   "id": "c19"
  },
  {
   "text": "递归有上限",
   "start": 44.232,
   "end": 45.544,
   "id": "c20"
  },
  {
   "text": "gas 和调用深度 1024",
   "start": 45.92,
   "end": 48.28,
   "id": "c21"
  },
  {
   "text": "都会限制它",
   "start": 48.336,
   "end": 49.304,
   "id": "c22"
  },
  {
   "text": "所以攻击者会每次取尽量大的金额",
   "start": 49.67,
   "end": 52.685,
   "id": "c23"
  },
  {
   "text": "减少层数",
   "start": 52.705,
   "end": 53.78,
   "id": "c24"
  },
  {
   "text": "第二种 跨函数重入",
   "start": 54.772,
   "end": 56.846,
   "id": "c25"
  },
  {
   "text": "攻击者不回到取款函数",
   "start": 57.824,
   "end": 59.696,
   "id": "c26"
  },
  {
   "text": "而是进入另一个共享同一份余额的函数",
   "start": 59.895,
   "end": 62.577,
   "id": "c27"
  },
  {
   "text": "比如转账",
   "start": 62.633,
   "end": 63.47,
   "id": "c28"
  },
  {
   "text": "取款加了重入锁",
   "start": 64.452,
   "end": 65.943,
   "id": "c29"
  },
  {
   "text": "转账没加",
   "start": 66.011,
   "end": 66.979,
   "id": "c30"
  },
  {
   "text": "攻击者还能利用回调吗",
   "start": 67.354,
   "end": 69.155,
   "id": "c31"
  },
  {
   "text": "能",
   "start": 70.424,
   "end": 71.117,
   "id": "c32"
  },
  {
   "text": "锁只拦截进入被锁函数的调用",
   "start": 71.469,
   "end": 73.889,
   "id": "c33"
  },
  {
   "text": "在回调里",
   "start": 74.868,
   "end": 75.847,
   "id": "c34"
  },
  {
   "text": "攻击者把还没清零的余额",
   "start": 76.046,
   "end": 77.966,
   "id": "c35"
  },
  {
   "text": "转给同伙",
   "start": 77.999,
   "end": 78.907,
   "id": "c36"
  },
  {
   "text": "外层返回之后 才清零",
   "start": 79.282,
   "end": 81.452,
   "id": "c37"
  },
  {
   "text": "同一笔钱",
   "start": 82.432,
   "end": 83.435,
   "id": "c38"
  },
  {
   "text": "既被提走了",
   "start": 83.503,
   "end": 84.59,
   "id": "c39"
  },
  {
   "text": "又被转走了",
   "start": 84.682,
   "end": 85.673,
   "id": "c40"
  },
  {
   "text": "2022 年 4 月的 Fei Rari",
   "start": 86.66,
   "end": 88.735,
   "id": "c41"
  },
  {
   "text": "就是它的真实版本",
   "start": 88.755,
   "end": 90.068,
   "id": "c42"
  },
  {
   "text": "损失约 8000 万美元",
   "start": 90.148,
   "end": 91.984,
   "id": "c43"
  },
  {
   "text": "借款函数先用 call 发送 ETH",
   "start": 92.976,
   "end": 95.515,
   "id": "c44"
  },
  {
   "text": "后写借款记录",
   "start": 95.654,
   "end": 96.872,
   "id": "c45"
  },
  {
   "text": "攻击者在回调里",
   "start": 97.852,
   "end": 99.248,
   "id": "c46"
  },
  {
   "text": "调用了没有被锁覆盖的退出市场函数",
   "start": 99.399,
   "end": 102.081,
   "id": "c47"
  },
  {
   "text": "取回了全部抵押品",
   "start": 102.137,
   "end": 103.617,
   "id": "c48"
  },
  {
   "text": "第三种 跨合约重入",
   "start": 104.6,
   "end": 106.817,
   "id": "c49"
  },
  {
   "text": "协议由多个合约组成",
   "start": 107.796,
   "end": 109.787,
   "id": "c50"
  },
  {
   "text": "比如金库合约和份额代币合约",
   "start": 109.903,
   "end": 112.406,
   "id": "c51"
  },
  {
   "text": "它们共享状态",
   "start": 112.45,
   "end": 113.704,
   "id": "c52"
  },
  {
   "text": "合约 A 的锁",
   "start": 114.688,
   "end": 115.763,
   "id": "c53"
  },
  {
   "text": "挡不住对合约 B 的调用",
   "start": 115.783,
   "end": 117.381,
   "id": "c54"
  },
  {
   "text": "B 此刻读到的",
   "start": 117.757,
   "end": 119.141,
   "id": "c55"
  },
  {
   "text": "是 A 还没更新的状态",
   "start": 119.233,
   "end": 121.224,
   "id": "c56"
  },
  {
   "text": "第四种 只读重入 最隐蔽",
   "start": 122.228,
   "end": 125.088,
   "id": "c57"
  },
  {
   "text": "攻击者在回调里不修改目标合约",
   "start": 126.048,
   "end": 128.718,
   "id": "c58"
  },
  {
   "text": "而是让第三方协议去读它",
   "start": 128.94,
   "end": 131.003,
   "id": "c59"
  },
  {
   "text": "比如一个 AMM 池",
   "start": 131.98,
   "end": 133.328,
   "id": "c60"
  },
  {
   "text": "移除流动性时",
   "start": 133.408,
   "end": 134.71,
   "id": "c61"
  },
  {
   "text": "先转出代币",
   "start": 134.73,
   "end": 135.852,
   "id": "c62"
  },
  {
   "text": "后更新总量",
   "start": 135.872,
   "end": 137.007,
   "id": "c63"
  },
  {
   "text": "在回调的那一刻",
   "start": 138.008,
   "end": 139.261,
   "id": "c64"
  },
  {
   "text": "储备已经减少",
   "start": 139.305,
   "end": 140.713,
   "id": "c65"
  },
  {
   "text": "总量还没减少",
   "start": 140.817,
   "end": 142.059,
   "id": "c66"
  },
  {
   "text": "这时借贷协议来读池子的价格函数",
   "start": 143.052,
   "end": 146.186,
   "id": "c67"
  },
  {
   "text": "读到一个被扭曲的价格",
   "start": 146.397,
   "end": 148.008,
   "id": "c68"
  },
  {
   "text": "再按它放贷或清算",
   "start": 148.028,
   "end": 149.722,
   "id": "c69"
  },
  {
   "text": "池子自己的状态",
   "start": 150.712,
   "end": 152.263,
   "id": "c70"
  },
  {
   "text": "最终是对的",
   "start": 152.343,
   "end": 153.453,
   "id": "c71"
  },
  {
   "text": "出错的 是在中间时刻读数据的第三方",
   "start": 153.804,
   "end": 157.379,
   "id": "c72"
  },
  {
   "text": "池子的 view 函数通常不加锁",
   "start": 158.348,
   "end": 160.899,
   "id": "c73"
  },
  {
   "text": "所以重入锁挡不住",
   "start": 160.955,
   "end": 162.887,
   "id": "c74"
  },
  {
   "text": "2023 年 2 月的 dForce",
   "start": 163.872,
   "end": 165.851,
   "id": "c75"
  },
  {
   "text": "就是这样",
   "start": 165.931,
   "end": 166.708,
   "id": "c76"
  },
  {
   "text": "损失约 360 万美元",
   "start": 166.788,
   "end": 168.827,
   "id": "c77"
  },
  {
   "text": "它用 Curve 池在回调期间返回的虚拟价格",
   "start": 169.828,
   "end": 173.26,
   "id": "c78"
  },
  {
   "text": "给抵押品定价",
   "start": 173.28,
   "end": 174.557,
   "id": "c79"
  }
 ]
}