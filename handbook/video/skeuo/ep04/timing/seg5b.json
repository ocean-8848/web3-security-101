 "captions": [
  {
   "text": "最后 每个人今天就能做一件事",
   "start": 1.648,
   "end": 4.151,
   "id": "c0"
  },
  {
   "text": "写合约的人",
   "start": 5.132,
   "end": 6.194,
   "id": "c1"
  },
  {
   "text": "找到第一个把控制权交出去的位置 问一句 那一刻",
   "start": 6.274,
   "end": 10.302,
   "id": "c2"
  },
  {
   "text": "哪些状态还没更新",
   "start": 10.465,
   "end": 12.04,
   "id": "c3"
  },
  {
   "text": "审计的人",
   "start": 13.312,
   "end": 14.279,
   "id": "c4"
  },
  {
   "text": "查一下编译器版本有没有已知的锁 bug",
   "start": 14.312,
   "end": 17.054,
   "id": "c5"
  },
  {
   "text": "再查部署链上转原生币",
   "start": 17.074,
   "end": 18.898,
   "id": "c6"
  },
  {
   "text": "会不会触发 fallback",
   "start": 18.966,
   "end": 20.482,
   "id": "c7"
  },
  {
   "text": "普通用户",
   "start": 21.476,
   "end": 22.431,
   "id": "c8"
  },
  {
   "text": "存款前看协议有没有审计报告",
   "start": 22.535,
   "end": 24.777,
   "id": "c9"
  },
  {
   "text": "范围是否覆盖你要用的合约",
   "start": 24.976,
   "end": 27.229,
   "id": "c10"
  },
  {
   "text": "没有审计的新金库",
   "start": 28.224,
   "end": 29.751,
   "id": "c11"
  },
  {
   "text": "只放能承受损失的金额",
   "start": 29.843,
   "end": 31.727,
   "id": "c12"
  },
  {
   "text": "回到开头的问题",
   "start": 32.716,
   "end": 34.1,
   "id": "c13"
  },
  {
   "text": "只调用一次取款",
   "start": 34.475,
   "end": 35.728,
   "id": "c14"
  },
  {
   "text": "为什么能取走全部 10 个 ETH",
   "start": 35.916,
   "end": 37.788,
   "id": "c15"
  },
  {
   "text": "因为银行先给钱 后记账",
   "start": 39.048,
   "end": 41.42,
   "id": "c16"
  },
  {
   "text": "每一层嵌套调用",
   "start": 41.795,
   "end": 43.287,
   "id": "c17"
  },
  {
   "text": "读到的都是同一个旧余额",
   "start": 43.45,
   "end": 45.715,
   "id": "c18"
  },
  {
   "text": "这个答案的前提",
   "start": 46.684,
   "end": 47.89,
   "id": "c19"
  },
  {
   "text": "是收款方能执行代码",
   "start": 47.91,
   "end": 49.663,
   "id": "c20"
  },
  {
   "text": "而状态在交出控制权之前还没更新",
   "start": 49.826,
   "end": 53.044,
   "id": "c21"
  },
  {
   "text": "把顺序写对",
   "start": 54.032,
   "end": 55.178,
   "id": "c22"
  },
  {
   "text": "第二层读到的就是 0",
   "start": 55.353,
   "end": 57.094,
   "id": "c23"
  },
  {
   "text": "下一集讲访问控制与权限",
   "start": 58.092,
   "end": 60.607,
   "id": "c24"
  },
  {
   "text": "谁有权按这个按钮",
   "start": 60.782,
   "end": 62.583,
   "id": "c25"
  }
 ]
