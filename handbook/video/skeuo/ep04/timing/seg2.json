 "captions": [
  {
   "text": "先给一句话的定义",
   "start": 1.648,
   "end": 3.151,
   "id": "c0"
  },
  {
   "text": "合约在更新自己的账本之前",
   "start": 4.148,
   "end": 6.294,
   "id": "c1"
  },
  {
   "text": "把控制权交给了外部地址",
   "start": 6.326,
   "end": 8.425,
   "id": "c2"
  },
  {
   "text": "外部地址趁账本还是旧的",
   "start": 9.408,
   "end": 11.768,
   "id": "c3"
  },
  {
   "text": "再次调用合约",
   "start": 11.789,
   "end": 13.018,
   "id": "c4"
  },
  {
   "text": "严格来说",
   "start": 13.996,
   "end": 15.035,
   "id": "c5"
  },
  {
   "text": "重入是一个函数还没执行完",
   "start": 15.15,
   "end": 17.368,
   "id": "c6"
  },
  {
   "text": "就被外部调用再次进入",
   "start": 17.508,
   "end": 19.439,
   "id": "c7"
  },
  {
   "text": "打个比方",
   "start": 20.432,
   "end": 21.387,
   "id": "c8"
  },
  {
   "text": "你去银行取 100 元",
   "start": 21.751,
   "end": 23.433,
   "id": "c9"
  },
  {
   "text": "柜员先把现金递给你",
   "start": 24.42,
   "end": 26.125,
   "id": "c10"
  },
  {
   "text": "然后才去改账本",
   "start": 26.348,
   "end": 27.661,
   "id": "c11"
  },
  {
   "text": "你接过现金的瞬间",
   "start": 28.648,
   "end": 30.163,
   "id": "c12"
  },
  {
   "text": "同伴在旁边说",
   "start": 30.29,
   "end": 31.472,
   "id": "c13"
  },
  {
   "text": "他要再取 100 元",
   "start": 31.612,
   "end": 32.996,
   "id": "c14"
  },
  {
   "text": "柜员一查",
   "start": 33.98,
   "end": 34.995,
   "id": "c15"
  },
  {
   "text": "账本上还是 100",
   "start": 35.099,
   "end": 36.626,
   "id": "c16"
  },
  {
   "text": "于是又给了一次",
   "start": 36.825,
   "end": 37.983,
   "id": "c17"
  },
  {
   "text": "只要柜员一直先给钱 后改账",
   "start": 38.976,
   "end": 41.705,
   "id": "c18"
  },
  {
   "text": "你们就能一直取",
   "start": 41.916,
   "end": 43.146,
   "id": "c19"
  },
  {
   "text": "直到金库见底",
   "start": 43.202,
   "end": 44.455,
   "id": "c20"
  },
  {
   "text": "这个比方有一处不成立",
   "start": 45.436,
   "end": 47.391,
   "id": "c21"
  },
  {
   "text": "现实里 柜员可以同时接待两个人",
   "start": 47.755,
   "end": 51.079,
   "id": "c22"
  },
  {
   "text": "EVM 是单线程的",
   "start": 52.064,
   "end": 53.853,
   "id": "c23"
  },
  {
   "text": "重入不是并发",
   "start": 54.216,
   "end": 55.6,
   "id": "c24"
  },
  {
   "text": "而是嵌套",
   "start": 55.835,
   "end": 56.85,
   "id": "c25"
  },
  {
   "text": "第二次取款",
   "start": 57.852,
   "end": 58.843,
   "id": "c26"
  },
  {
   "text": "整个发生在第一次取款的中间",
   "start": 59.018,
   "end": 61.153,
   "id": "c27"
  },
  {
   "text": "所以 重入的前提只有两个",
   "start": 62.152,
   "end": 64.631,
   "id": "c28"
  },
  {
   "text": "第一 合约在函数中途发起外部调用",
   "start": 65.612,
   "end": 69.234,
   "id": "c29"
  },
  {
   "text": "而被调用的一方",
   "start": 69.385,
   "end": 70.663,
   "id": "c30"
  },
  {
   "text": "受攻击者控制",
   "start": 70.683,
   "end": 72.02,
   "id": "c31"
  },
  {
   "text": "第二 外部调用发生的时候",
   "start": 73.008,
   "end": 75.392,
   "id": "c32"
  },
  {
   "text": "合约的状态",
   "start": 75.639,
   "end": 76.725,
   "id": "c33"
  },
  {
   "text": "还没有更新到最终值",
   "start": 76.746,
   "end": 78.392,
   "id": "c34"
  },
  {
   "text": "哪些操作会交出控制权",
   "start": 79.372,
   "end": 81.47,
   "id": "c35"
  },
  {
   "text": "一共有六类",
   "start": 81.845,
   "end": 82.932,
   "id": "c36"
  },
  {
   "text": "用 call 转 ETH",
   "start": 83.912,
   "end": 85.355,
   "id": "c37"
  },
  {
   "text": "接收方是合约时",
   "start": 85.719,
   "end": 87.246,
   "id": "c38"
  },
  {
   "text": "会执行它的 receive",
   "start": 87.266,
   "end": 88.77,
   "id": "c39"
  },
  {
   "text": "或者 fallback",
   "start": 88.838,
   "end": 89.984,
   "id": "c40"
  },
  {
   "text": "调用代币的 transfer",
   "start": 90.972,
   "end": 92.677,
   "id": "c41"
  },
  {
   "text": "代币如果是攻击者部署的",
   "start": 93.053,
   "end": 94.973,
   "id": "c42"
  },
  {
   "text": "里面的代码可以是任意的",
   "start": 95.124,
   "end": 96.961,
   "id": "c43"
  },
  {
   "text": "ERC-777 代币转账",
   "start": 97.936,
   "end": 100.034,
   "id": "c44"
  },
  {
   "text": "会触发接收方的钩子",
   "start": 100.055,
   "end": 101.665,
   "id": "c45"
  },
  {
   "text": "NFT 的安全转账和安全铸造",
   "start": 102.644,
   "end": 105.457,
   "id": "c46"
  },
  {
   "text": "会回调接收方",
   "start": 105.477,
   "end": 106.671,
   "id": "c47"
  },
  {
   "text": "闪电贷的回调",
   "start": 107.664,
   "end": 108.929,
   "id": "c48"
  },
  {
   "text": "设计上就是把控制权交给借款人",
   "start": 109.056,
   "end": 111.715,
   "id": "c49"
  },
  {
   "text": "还有 调用任何用户提供的地址",
   "start": 112.708,
   "end": 115.544,
   "id": "c50"
  },
  {
   "text": "包括路由器",
   "start": 115.66,
   "end": 116.747,
   "id": "c51"
  },
  {
   "text": "钩子和预言机",
   "start": 116.886,
   "end": 118.425,
   "id": "c52"
  },
  {
   "text": "再补一个细节",
   "start": 119.408,
   "end": 120.625,
   "id": "c53"
  },
  {
   "text": "同一份代码",
   "start": 121.0,
   "end": 121.98,
   "id": "c54"
  },
  {
   "text": "换一条链",
   "start": 122.036,
   "end": 122.92,
   "id": "c55"
  },
  {
   "text": "回调入口就不一样",
   "start": 123.084,
   "end": 124.444,
   "id": "c56"
  },
  {
   "text": "在 TRON 上",
   "start": 125.412,
   "end": 126.32,
   "id": "c57"
  },
  {
   "text": "用系统交易转 TRX",
   "start": 126.435,
   "end": 128.415,
   "id": "c58"
  },
  {
   "text": "不会执行接收合约的 fallback",
   "start": 128.447,
   "end": 130.582,
   "id": "c59"
  },
  {
   "text": "附带 callValue 去调用合约",
   "start": 131.56,
   "end": 133.468,
   "id": "c60"
  },
  {
   "text": "才会执行",
   "start": 133.488,
   "end": 134.408,
   "id": "c61"
  },
  {
   "text": "在 Mantle 上",
   "start": 135.404,
   "end": 136.466,
   "id": "c62"
  },
  {
   "text": "ETH 以 ERC-20 的形式存在",
   "start": 136.666,
   "end": 138.871,
   "id": "c63"
  },
  {
   "text": "转它不触发 receive",
   "start": 139.011,
   "end": 140.645,
   "id": "c64"
  },
  {
   "text": "转原生币 MNT",
   "start": 141.02,
   "end": 142.548,
   "id": "c65"
  },
  {
   "text": "才会触发",
   "start": 142.568,
   "end": 143.488,
   "id": "c66"
  }
 ]
