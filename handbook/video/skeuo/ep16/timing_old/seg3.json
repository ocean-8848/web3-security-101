 "captions": [
  {
   "text": "先看算力",
   "start": 1.55,
   "end": 2.553,
   "id": "c0"
  },
  {
   "text": "51% 攻击分四步",
   "start": 2.905,
   "end": 4.746,
   "id": "c1"
  },
  {
   "text": "攻击者在交易所充值一大笔币",
   "start": 5.122,
   "end": 7.737,
   "id": "c2"
  },
  {
   "text": "同时私下挖一条不包含这笔充值的链",
   "start": 7.975,
   "end": 11.069,
   "id": "c3"
  },
  {
   "text": "交易所等够确认数入账",
   "start": 11.33,
   "end": 13.148,
   "id": "c4"
  },
  {
   "text": "他把币卖掉",
   "start": 13.286,
   "end": 14.234,
   "id": "c5"
  },
  {
   "text": "提走别的资产",
   "start": 14.369,
   "end": 15.447,
   "id": "c6"
  },
  {
   "text": "然后他公开私下那条更长的链",
   "start": 15.812,
   "end": 18.387,
   "id": "c7"
  },
  {
   "text": "网络发生重组",
   "start": 18.668,
   "end": 20.023,
   "id": "c8"
  },
  {
   "text": "充值交易消失",
   "start": 20.25,
   "end": 21.553,
   "id": "c9"
  },
  {
   "text": "币回到他手里",
   "start": 21.769,
   "end": 23.064,
   "id": "c10"
  },
  {
   "text": "交易所账上多出一笔不存在的充值",
   "start": 23.357,
   "end": 26.153,
   "id": "c11"
  },
  {
   "text": "再猜一道题",
   "start": 26.39,
   "end": 27.323,
   "id": "c12"
  },
  {
   "text": "攻击者有 60% 算力",
   "start": 27.57,
   "end": 29.491,
   "id": "c13"
  },
  {
   "text": "确认数从 6 提高到 600",
   "start": 29.741,
   "end": 31.866,
   "id": "c14"
  },
  {
   "text": "成功概率降多少",
   "start": 31.97,
   "end": 33.237,
   "id": "c15"
  },
  {
   "text": "答案是不降",
   "start": 33.75,
   "end": 35.274,
   "id": "c16"
  },
  {
   "text": "算力超过一半",
   "start": 35.49,
   "end": 36.846,
   "id": "c17"
  },
  {
   "text": "攻击者最终一定能追上",
   "start": 36.995,
   "end": 39.104,
   "id": "c18"
  },
  {
   "text": "加确认数",
   "start": 39.31,
   "end": 40.392,
   "id": "c19"
  },
  {
   "text": "只增加他租算力的时间和成本",
   "start": 40.661,
   "end": 43.36,
   "id": "c20"
  },
  {
   "text": "所以小算力链的确认数",
   "start": 43.61,
   "end": 45.907,
   "id": "c21"
  },
  {
   "text": "是一个经济问题",
   "start": 45.952,
   "end": 47.252,
   "id": "c22"
  },
  {
   "text": "租算力的成本",
   "start": 47.609,
   "end": 48.832,
   "id": "c23"
  },
  {
   "text": "必须高于能双花的金额",
   "start": 48.983,
   "end": 51.155,
   "id": "c24"
  },
  {
   "text": "2019 年 1 月",
   "start": 51.41,
   "end": 52.672,
   "id": "c25"
  },
  {
   "text": "Ethereum Classic",
   "start": 52.865,
   "end": 54.182,
   "id": "c26"
  },
  {
   "text": "被深度重组和双花",
   "start": 54.202,
   "end": 56.07,
   "id": "c27"
  },
  {
   "text": "约 110 万美元",
   "start": 56.338,
   "end": 57.808,
   "id": "c28"
  },
  {
   "text": "Coinbase 发现后",
   "start": 58.131,
   "end": 59.25,
   "id": "c29"
  },
  {
   "text": "暂停了 ETC 的收付",
   "start": 59.27,
   "end": 60.804,
   "id": "c30"
  },
  {
   "text": "2020 年 8 月",
   "start": 61.05,
   "end": 62.465,
   "id": "c31"
