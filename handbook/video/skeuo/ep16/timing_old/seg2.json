 ],
 "captions": [
  {
   "text": "先给准确的说法",
   "start": 1.55,
   "end": 2.785,
   "id": "c0"
  },
  {
   "text": "共识 是网络里的节点",
   "start": 3.05,
   "end": 5.555,
   "id": "c1"
  },
  {
   "text": "就哪条链是正确的",
   "start": 5.77,
   "end": 7.603,
   "id": "c2"
  },
  {
   "text": "达成一致的机制",
   "start": 7.645,
   "end": 8.955,
   "id": "c3"
  },
  {
   "text": "重组 是节点放弃已经接受的几个区块",
   "start": 9.19,
   "end": 13.004,
   "id": "c4"
  },
  {
   "text": "改为接受另一条链",
   "start": 13.125,
   "end": 14.71,
   "id": "c5"
  },
  {
   "text": "已经确认的交易",
   "start": 15.026,
   "end": 16.318,
   "id": "c6"
  },
  {
   "text": "会在重组里消失",
   "start": 16.434,
   "end": 17.727,
   "id": "c7"
  },
  {
   "text": "所以交易所说的已确认",
   "start": 17.95,
   "end": 20.209,
   "id": "c8"
  },
  {
   "text": "只是对这条链安全假设的一个赌注",
   "start": 20.343,
   "end": 23.324,
   "id": "c9"
  },
  {
   "text": "打个比方",
   "start": 23.71,
   "end": 24.368,
   "id": "c10"
  },
  {
   "text": "一个城市的公证处",
   "start": 24.725,
   "end": 26.08,
   "id": "c11"
  },
  {
   "text": "靠多数公证员签字",
   "start": 26.202,
   "end": 27.893,
   "id": "c12"
  },
  {
   "text": "确认房产交易",
   "start": 27.988,
   "end": 29.2,
   "id": "c13"
  },
  {
   "text": "如果有人临时雇来半数以上的公证员",
   "start": 29.507,
   "end": 32.613,
   "id": "c14"
  },
  {
   "text": "他可以让一份盖过章的合同作废",
   "start": 32.83,
   "end": 35.327,
   "id": "c15"
  },
  {
   "text": "再把同一套房卖给另一个人",
   "start": 35.705,
   "end": 37.996,
   "id": "c16"
  },
  {
   "text": "这就是双花",
   "start": 38.25,
   "end": 39.646,
   "id": "c17"
  },
  {
   "text": "同一笔资产被花两次",
   "start": 40.019,
   "end": 42.078,
   "id": "c18"
  },
  {
   "text": "比喻不成立的地方是",
   "start": 42.407,
   "end": 44.034,
   "id": "c19"
  },
  {
   "text": "现实里雇公证员要花很多年",
   "start": 44.361,
   "end": 47.34,
   "id": "c20"
  },
  {
   "text": "在小算力的 PoW 链上",
   "start": 47.57,
   "end": 49.905,
   "id": "c21"
  },
  {
   "text": "算力可以按小时租",
   "start": 50.131,
   "end": 52.121,
   "id": "c22"
  },
  {
   "text": "很多人把所有共识攻击",
   "start": 52.35,
   "end": 55.064,
   "id": "c23"
  },
  {
   "text": "都叫 51% 攻击",
   "start": 55.106,
   "end": 57.222,
   "id": "c24"
  },
  {
   "text": "这会选错防线",
   "start": 57.543,
   "end": 59.194,
   "id": "c25"
  },
  {
   "text": "更好的问法是",
   "start": 59.531,
   "end": 60.613,
   "id": "c26"
  },
  {
   "text": "攻击者控制了什么",
   "start": 60.967,
   "end": 62.831,
   "id": "c27"
  },
  {
   "text": "身份和连接 算力",
   "start": 63.09,
   "end": 65.703,
   "id": "c28"
  },
  {
   "text": "单个区块的时机",
   "start": 65.838,
   "end": 67.154,
   "id": "c29"
  },
  {
   "text": "权益或旧私钥",
   "start": 67.39,
   "end": 69.268,
   "id": "c30"
  },
  {
   "text": "别人的动机",
   "start": 69.517,
   "end": 70.462,
   "id": "c31"
  },
  {
   "text": "以及让链停下的份额",
   "start": 70.655,
   "end": 72.829,
   "id": "c32"
  },
  {
   "text": "控制的资源不同",
   "start": 73.13,
   "end": 74.562,
   "id": "c33"
  },
  {
   "text": "防线就不同",
   "start": 74.664,
   "end": 75.653,
   "id": "c34"
  }
 ]
}