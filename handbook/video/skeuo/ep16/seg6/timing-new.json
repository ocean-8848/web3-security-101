 "captions": [
  {
   "text": "按角色 各做一件事",
   "start": 1.648,
   "end": 3.591,
   "id": "c0"
  },
  {
   "text": "交易所 每条链单独定入账条件",
   "start": 4.58,
   "end": 7.381,
   "id": "c1"
  },
  {
   "text": "以太坊看 finalized 标签",
   "start": 8.376,
   "end": 10.474,
   "id": "c2"
  },
  {
   "text": "PoW 小链按租算力的成本定确认数",
   "start": 10.59,
   "end": 13.284,
   "id": "c3"
  },
  {
   "text": "区分两种状态",
   "start": 14.284,
   "end": 15.608,
   "id": "c4"
  },
  {
   "text": "继续出块但不最终确定",
   "start": 15.712,
   "end": 17.835,
   "id": "c5"
  },
  {
   "text": "和完全停止",
   "start": 17.855,
   "end": 18.989,
   "id": "c6"
  },
  {
   "text": "最终性延迟或出块间隔超过阈值",
   "start": 19.976,
   "end": 23.074,
   "id": "c7"
  },
  {
   "text": "自动暂停充提",
   "start": 23.13,
   "end": 24.515,
   "id": "c8"
  },
  {
   "text": "恢复后逐笔对账",
   "start": 24.642,
   "end": 26.074,
   "id": "c9"
  },
  {
   "text": "运营节点的",
   "start": 27.06,
   "end": 28.23,
   "id": "c10"
  },
  {
   "text": "至少运行两种客户端",
   "start": 28.31,
   "end": 30.158,
   "id": "c11"
  },
  {
   "text": "交叉核对",
   "start": 30.191,
   "end": 31.194,
   "id": "c12"
  },
  {
   "text": "普通用户",
   "start": 32.176,
   "end": 33.131,
   "id": "c13"
  },
  {
   "text": "交易所显示等待确认时 耐心等",
   "start": 33.247,
   "end": 36.25,
   "id": "c14"
  },
  {
   "text": "链停摆时",
   "start": 37.22,
   "end": 38.282,
   "id": "c15"
  },
  {
   "text": "不要反复提交交易",
   "start": 38.327,
   "end": 39.711,
   "id": "c16"
  },
  {
   "text": "恢复后先查状态",
   "start": 39.898,
   "end": 41.521,
   "id": "c17"
  },
  {
   "text": "回到开头的问题",
   "start": 42.504,
   "end": 43.888,
   "id": "c18"
  },
  {
   "text": "同样的 bug 出在超过三分之一的客户端上",
   "start": 44.884,
   "end": 47.815,
   "id": "c19"
  },
  {
   "text": "检查点不再最终确定",
   "start": 47.943,
   "end": 49.637,
   "id": "c20"
  },
  {
   "text": "链照样出块",
   "start": 50.624,
   "end": 51.889,
   "id": "c21"
  },
  {
   "text": "N 个区块的条件照样满足",
   "start": 52.147,
   "end": 54.353,
   "id": "c22"
  },
  {
   "text": "系统继续入账",
   "start": 54.409,
   "end": 55.841,
   "id": "c23"
  },
  {
   "text": "只有看 finalized 标签",
   "start": 56.82,
   "end": 58.811,
   "id": "c24"
  },
  {
   "text": "监控最终性延迟的系统",
   "start": 58.915,
   "end": 60.704,
   "id": "c25"
  },
  {
   "text": "才会停下",
   "start": 60.724,
   "end": 61.573,
   "id": "c26"
  },
  {
   "text": "已确认只是一个赌注",
   "start": 62.56,
   "end": 64.218,
   "id": "c27"
  },
  {
   "text": "先问攻击者控制了什么",
