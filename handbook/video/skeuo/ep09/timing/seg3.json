 "captions": [
  {
   "text": "怎么防",
   "start": 1.648,
   "end": 2.341,
   "id": "c0"
  },
  {
   "text": "分四层",
   "start": 2.693,
   "end": 3.72,
   "id": "c1"
  },
  {
   "text": "用户这一层",
   "start": 4.7,
   "end": 5.846,
   "id": "c2"
  },
  {
   "text": "把滑点设得合理",
   "start": 5.902,
   "end": 7.155,
   "id": "c3"
  },
  {
   "text": "大额交易",
   "start": 7.531,
   "end": 8.367,
   "id": "c4"
  },
  {
   "text": "走私有交易通道",
   "start": 8.435,
   "end": 9.641,
   "id": "c5"
  },
  {
   "text": "比如 Flashbots Protect",
   "start": 9.673,
   "end": 11.249,
   "id": "c6"
  },
  {
   "text": "一类的服务",
   "start": 11.269,
   "end": 12.046,
   "id": "c7"
  },
  {
   "text": "交易不进公开内存池",
   "start": 13.032,
   "end": 14.844,
   "id": "c8"
  },
  {
   "text": "搜索者在打包之前",
   "start": 14.972,
   "end": 16.642,
   "id": "c9"
  },
  {
   "text": "就看不到它",
   "start": 16.71,
   "end": 17.63,
   "id": "c10"
  },
  {
   "text": "前端这一层",
   "start": 18.628,
   "end": 19.774,
   "id": "c11"
  },
  {
   "text": "默认滑点要保守",
   "start": 19.83,
   "end": 21.214,
   "id": "c12"
  },
  {
   "text": "按池子的深度来计算",
   "start": 21.33,
   "end": 23.155,
   "id": "c13"
  },
  {
   "text": "合约这一层",
   "start": 24.152,
   "end": 25.191,
   "id": "c14"
  },
  {
   "text": "所有交换函数",
   "start": 25.235,
   "end": 26.643,
   "id": "c15"
  },
  {
   "text": "都要接受最小输出和截止时间两个参数",
   "start": 26.699,
   "end": 29.965,
   "id": "c16"
  },
  {
   "text": "常见的错误",
   "start": 30.948,
   "end": 32.047,
   "id": "c17"
  },
  {
   "text": "是在合约内部",
   "start": 32.067,
   "end": 33.26,
   "id": "c18"
  },
  {
   "text": "用现货价算出最小输出",
   "start": 33.388,
   "end": 35.808,
   "id": "c19"
  },
  {
   "text": "那个现货价",
   "start": 36.784,
   "end": 37.846,
   "id": "c20"
  },
  {
   "text": "在同一个区块里就能被推高",
   "start": 37.95,
   "end": 40.108,
   "id": "c21"
  },
  {
   "text": "按它算出的保护",
   "start": 40.472,
   "end": 41.773,
   "id": "c22"
  },
  {
   "text": "等于没有保护",
   "start": 41.936,
   "end": 42.915,
   "id": "c23"
  },
  {
   "text": "更糟的写法",
   "start": 43.916,
   "end": 45.038,
   "id": "c24"
  },
  {
   "text": "是把最小输出直接写成 0",
   "start": 45.118,
   "end": 47.74,
   "id": "c25"
  },
  {
   "text": "这等于告诉所有人",
   "start": 48.696,
   "end": 50.258,
   "id": "c26"
  },
  {
   "text": "我接受任何价格",
   "start": 50.315,
   "end": 51.723,
   "id": "c27"
  },
  {
   "text": "金库 自动复投合约",
   "start": 52.098,
   "end": 54.185,
   "id": "c28"
  },
  {
   "text": "清算合约",
   "start": 54.205,
   "end": 55.292,
   "id": "c29"
  },
  {
   "text": "常犯这个错误",
   "start": 55.336,
   "end": 56.566,
   "id": "c30"
  },
  {
   "text": "协议设计这一层",
   "start": 57.532,
   "end": 58.928,
   "id": "c31"
  },
  {
   "text": "有两种做法",
   "start": 59.008,
   "end": 60.118,
   "id": "c32"
  },
  {
   "text": "一是提交揭示",
   "start": 61.112,
   "end": 62.424,
   "id": "c33"
  },
  {
   "text": "先提交答案的哈希",
   "start": 62.576,
   "end": 64.104,
   "id": "c34"
  },
  {
   "text": "下一阶段再公开答案",
   "start": 64.124,
   "end": 65.901,
   "id": "c35"
  },
  {
   "text": "这个承诺",
   "start": 66.9,
   "end": 67.891,
   "id": "c36"
  },
  {
   "text": "必须绑定发送者的地址",
   "start": 67.912,
   "end": 69.605,
   "id": "c37"
  },
  {
   "text": "不然 机器人复制你的承诺",
   "start": 69.981,
   "end": 72.627,
   "id": "c38"
  },
  {
   "text": "也能完成揭示",
   "start": 72.754,
   "end": 73.936,
   "id": "c39"
  },
  {
   "text": "二是批量拍卖",
   "start": 74.92,
   "end": 76.268,
   "id": "c40"
  },
  {
   "text": "同一批订单",
   "start": 76.432,
   "end": 77.459,
   "id": "c41"
  },
  {
   "text": "按统一价格清算",
   "start": 77.527,
   "end": 78.875,
   "id": "c42"
  },
  {
   "text": "顺序由谁决定",
   "start": 79.868,
   "end": 81.359,
   "id": "c43"
  },
  {
   "text": "每条链也不一样",
   "start": 81.439,
   "end": 82.716,
   "id": "c44"
  },
  {
   "text": "BNB Chain",
   "start": 83.712,
   "end": 84.739,
   "id": "c45"
  },
  {
   "text": "验证者轮流出块",
   "start": 84.902,
   "end": 86.286,
   "id": "c46"
  },
  {
   "text": "2026 年 1 月",
   "start": 86.65,
   "end": 87.939,
   "id": "c47"
  },
  {
   "text": "出块间隔缩短到 0.45 秒",
   "start": 88.031,
   "end": 90.474,
   "id": "c48"
  },
  {
   "text": "抢跑的窗口更短",
   "start": 91.444,
   "end": 92.899,
   "id": "c49"
  },
  {
   "text": "但它有公开内存池和构建者市场",
   "start": 93.063,
   "end": 95.745,
   "id": "c50"
  },
  {
   "text": "三明治依然存在",
   "start": 95.765,
   "end": 97.387,
   "id": "c51"
  },
  {
   "text": "TRON",
   "start": 98.384,
   "end": 98.994,
   "id": "c52"
  },
  {
   "text": "27 个超级代表轮流出块",
   "start": 99.205,
   "end": 101.47,
   "id": "c53"
  },
  {
   "text": "按 TRON 官方文档",
   "start": 102.444,
   "end": 103.911,
   "id": "c54"
  },
  {
   "text": "它没有优先费",
   "start": 103.932,
   "end": 104.959,
   "id": "c55"
  },
  {
   "text": "不能靠出更高的价格插队",
   "start": 105.003,
   "end": 106.792,
   "id": "c56"
  },
  {
   "text": "但出块的人",
   "start": 107.776,
   "end": 108.898,
   "id": "c57"
  },
  {
   "text": "仍然可以决定顺序",
   "start": 109.002,
   "end": 110.529,
   "id": "c58"
  },
  {
   "text": "Mantle",
   "start": 111.524,
   "end": 112.277,
   "id": "c59"
  },
  {
   "text": "只有一个中心化排序器",
   "start": 112.333,
   "end": 113.979,
   "id": "c60"
  },
  {
   "text": "L2BEAT 列出的风险是",
   "start": 114.96,
   "end": 116.892,
   "id": "c61"
  },
  {
   "text": "运营者可以抢跑用户交易",
   "start": 117.126,
   "end": 119.141,
   "id": "c62"
  },
  {
   "text": "提取 MEV",
   "start": 119.233,
   "end": 120.558,
   "id": "c63"
  },
  {
   "text": "没有公开内存池",
   "start": 121.54,
   "end": 122.983,
   "id": "c64"
  },
  {
   "text": "不等于没有 MEV",
   "start": 123.099,
   "end": 124.626,
   "id": "c65"
  },
  {
   "text": "它只是把排序权",
   "start": 125.624,
   "end": 126.996,
   "id": "c66"
  },
  {
   "text": "从市场集中到一个运营者手里",
   "start": 127.064,
   "end": 129.401,
   "id": "c67"
  }
 ]
}