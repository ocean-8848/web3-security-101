 "captions": [
  {
   "text": "最后 每个人今天就能做一件事",
   "start": 1.55,
   "end": 4.357,
   "id": "c0"
  },
  {
   "text": "写合约的人",
   "start": 4.57,
   "end": 5.699,
   "id": "c1"
  },
  {
   "text": "检查每个交换函数",
   "start": 5.768,
   "end": 7.476,
   "id": "c2"
  },
  {
   "text": "最小输出和截止时间",
   "start": 7.685,
   "end": 9.623,
   "id": "c3"
  },
  {
   "text": "是不是由调用者传进来",
   "start": 9.733,
   "end": 11.718,
   "id": "c4"
  },
  {
   "text": "所有签名",
   "start": 11.99,
   "end": 13.02,
   "id": "c5"
  },
  {
   "text": "用 EIP-712",
   "start": 13.083,
   "end": 14.112,
   "id": "c6"
  },
  {
   "text": "带上 nonce 和截止时间",
   "start": 14.132,
   "end": 16.849,
   "id": "c7"
  },
  {
   "text": "审计的人",
   "start": 17.09,
   "end": 17.92,
   "id": "c8"
  },
  {
   "text": "拿同一份签名提交第二次",
   "start": 17.94,
   "end": 20.219,
   "id": "c9"
  },
  {
   "text": "第二次也成功",
   "start": 20.353,
   "end": 21.698,
   "id": "c10"
  },
  {
   "text": "就是漏洞",
   "start": 21.886,
   "end": 22.574,
   "id": "c11"
  },
  {
   "text": "修复要两个结果 修复前",
   "start": 22.922,
   "end": 25.45,
   "id": "c12"
  },
  {
   "text": "重放成功 修复后 被拦下",
   "start": 25.47,
   "end": 27.989,
   "id": "c13"
  },
  {
   "text": "普通用户",
   "start": 28.25,
   "end": 29.141,
   "id": "c14"
  },
  {
   "text": "大额兑换设合理的滑点",
   "start": 29.454,
   "end": 31.522,
   "id": "c15"
  },
  {
   "text": "不用自动的高滑点",
   "start": 31.796,
   "end": 33.21,
   "id": "c16"
  },
  {
   "text": "可以走私有交易通道",
   "start": 33.514,
   "end": 35.119,
   "id": "c17"
  },
  {
   "text": "签名前看清链 ID",
   "start": 35.444,
   "end": 37.204,
   "id": "c18"
  },
  {
   "text": "合约地址",
   "start": 37.374,
   "end": 38.258,
   "id": "c19"
  },
  {
   "text": "数额和期限",
   "start": 38.39,
   "end": 39.648,
   "id": "c20"
  },
  {
   "text": "钱包只显示哈希",
   "start": 40.322,
   "end": 41.787,
   "id": "c21"
  },
  {
   "text": "或者提示盲签 就不签",
   "start": 42.079,
   "end": 44.119,
   "id": "c22"
  },
  {
   "text": "回到开头",
   "start": 44.37,
   "end": 45.272,
   "id": "c23"
  },
  {
   "text": "滑点设 5",
   "start": 45.518,
   "end": 47.105,
   "id": "c24"
  },
  {
   "text": "为什么可能真的付 5",
   "start": 47.224,
   "end": 49.524,
   "id": "c25"
  },
  {
   "text": "因为交易在打包之前是公开的",
   "start": 50.07,
   "end": 52.655,
   "id": "c26"
  },
  {
   "text": "滑点就是你公开的最差报价",
   "start": 52.774,
   "end": 55.309,
   "id": "c27"
  },
  {
   "text": "这在交易走公开内存池时成立",
   "start": 55.57,
   "end": 58.277,
   "id": "c28"
  },
  {
   "text": "走私有通道",
   "start": 58.479,
   "end": 59.435,
   "id": "c29"
  },
  {
   "text": "搜索者在打包前看不到它",
   "start": 59.455,
   "end": 61.621,
   "id": "c30"
  },
  {
   "text": "顺序可以被买",
   "start": 61.87,
   "end": 63.749,
   "id": "c31"
  },
  {
   "text": "签名可以被重放",
   "start": 64.167,
   "end": 65.925,
   "id": "c32"
  },
  {
   "text": "签之前看清内容",
   "start": 66.17,
   "end": 67.913,
   "id": "c33"
  },
  {
   "text": "发之前想好",
   "start": 68.103,
   "end": 69.379,
   "id": "c34"
  },
  {
   "text": "谁会先看到它",
   "start": 69.444,
   "end": 70.74,
   "id": "c35"
  },
  {
   "text": "下一集讲可升级合约与代理",
   "start": 71.047,
   "end": 73.897,
   "id": "c36"
  }
 ]
}