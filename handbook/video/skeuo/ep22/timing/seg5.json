  {
   "text": "先管住嘴",
   "start": 7.692,
   "end": 8.72,
   "id": "c4"
  },
  {
   "text": "不公开谈持仓",
   "start": 8.895,
   "end": 10.124,
   "id": "c5"
  },
  {
   "text": "不晒资产截图",
   "start": 10.18,
   "end": 11.434,
   "id": "c6"
  },
  {
   "text": "链上身份和真实身份分开",
   "start": 12.432,
   "end": 14.614,
   "id": "c7"
  },
  {
   "text": "公开收款地址和个人大额地址",
   "start": 14.789,
   "end": 17.399,
   "id": "c8"
  },
  {
   "text": "不用同一个",
   "start": 17.455,
   "end": 18.399,
   "id": "c9"
  },
  {
   "text": "硬件钱包这类订单",
   "start": 19.372,
   "end": 21.006,
   "id": "c10"
  },
  {
   "text": "用代收地址或者公司地址收货",
   "start": 21.157,
   "end": 23.827,
   "id": "c11"
  },
  {
   "text": "照片里不要拍到住址",
   "start": 24.824,
   "end": 26.732,
   "id": "c12"
  },
  {
   "text": "车牌和日常路线",
   "start": 26.859,
   "end": 28.505,
   "id": "c13"
  },
  {
   "text": "定期搜一搜自己的姓名和住址",
   "start": 29.508,
   "end": 31.856,
   "id": "c14"
  },
  {
   "text": "去数据经纪网站申请删除",
   "start": 31.936,
   "end": 34.285,
   "id": "c15"
  },
  {
   "text": "降低胁迫的收益",
   "start": 35.272,
   "end": 36.644,
   "id": "c16"
  },
  {
   "text": "靠的是让本人确实转不出去",
   "start": 36.795,
   "end": 38.87,
   "id": "c17"
  },
  {
   "text": "大额资产放进多签或者时间锁",
   "start": 39.86,
   "end": 42.732,
   "id": "c18"
  },
  {
   "text": "转出要异地的另一个人",
   "start": 42.824,
   "end": 44.435,
   "id": "c19"
  },
  {
   "text": "或者另一台设备",
   "start": 44.455,
   "end": 45.613,
   "id": "c20"
  },
  {
   "text": "随身的设备",
   "start": 46.608,
   "end": 47.742,
   "id": "c21"
  },
  {
   "text": "只放少量资产",
   "start": 47.762,
   "end": 49.242,
   "id": "c22"
  },
  {
   "text": "和家人约定胁迫暗号",
   "start": 50.236,
   "end": 52.048,
   "id": "c23"
  },
  {
   "text": "还有紧急联系的流程",
   "start": 52.188,
   "end": 53.775,
   "id": "c24"
  },
  {
   "text": "要说清楚",
   "start": 54.776,
   "end": 55.755,
   "id": "c25"
  },
  {
   "text": "多签和时间锁",
   "start": 55.883,
   "end": 57.196,
   "id": "c26"
  },
  {
   "text": "降低的是立即转出的可能",
   "start": 57.288,
   "end": 59.255,
   "id": "c27"
  },
  {
   "text": "不能保证人身安全",
   "start": 59.276,
   "end": 60.767,
   "id": "c28"
  },
  {
   "text": "劫匪对转不出的反应",
   "start": 61.764,
   "end": 63.446,
   "id": "c29"
  },
  {
   "text": "难以预测",
   "start": 63.585,
   "end": 64.517,
   "id": "c30"
  },
  {
   "text": "人身安全第一",
   "start": 64.656,
   "end": 65.957,
   "id": "c31"
  },
  {
   "text": "资产第二",
   "start": 66.037,
   "end": 66.957,
   "id": "c32"
  },
  {
   "text": "账号这边 邮箱 交易所",
   "start": 67.936,
   "end": 70.463,
   "id": "c33"
  },
  {
   "text": "社交账号",
   "start": 70.495,
   "end": 71.582,
   "id": "c34"
  },
  {
   "text": "域名注册商",
   "start": 71.781,
   "end": 72.879,
   "id": "c35"
  },
  {
   "text": "都用硬件安全密钥",
   "start": 72.924,
   "end": 74.332,
   "id": "c36"
  },
  {
   "text": "做多因素认证",
   "start": 74.4,
   "end": 75.57,
   "id": "c37"
  },
  {
   "text": "不用短信做多因素认证",
   "start": 76.556,
   "end": 78.368,
   "id": "c38"
  },
  {
   "text": "也不用它恢复密码",
   "start": 78.52,
   "end": 79.809,
   "id": "c39"
  },
  {
   "text": "向运营商申请号码转移锁",
   "start": 80.808,
   "end": 82.978,
   "id": "c40"
  },
  {
   "text": "或者 SIM 更换 PIN",
   "start": 83.022,
   "end": 84.728,
   "id": "c41"
  },
  {
   "text": "关键账号",
   "start": 85.708,
   "end": 86.711,
   "id": "c42"
  },
  {
   "text": "用不公开的专用邮箱注册",
   "start": 86.755,
   "end": 88.77,
   "id": "c43"
  },
  {
   "text": "项目方还要多做几件事",
   "start": 89.768,
   "end": 91.842,
   "id": "c44"
  },
  {
   "text": "列出关键人员 创始人",
   "start": 92.82,
   "end": 94.954,
   "id": "c45"
  },
  {
   "text": "多签签名人",
   "start": 94.974,
   "end": 96.168,
   "id": "c46"
  },
  {
   "text": "运维负责人",
   "start": 96.308,
   "end": 97.311,
   "id": "c47"
  },
  {
   "text": "官方账号管理员",
   "start": 97.343,
   "end": 98.859,
   "id": "c48"
  },
  {
   "text": "签名人名单不公开",
   "start": 99.856,
   "end": 101.383,
   "id": "c49"
  },
  {
   "text": "必要时只公开机构",
   "start": 101.51,
   "end": 103.121,
   "id": "c50"
  },
  {
   "text": "官方账号交接时",
   "start": 104.108,
   "end": 105.611,
   "id": "c51"
  },
  {
   "text": "不关闭多因素认证",
   "start": 105.715,
   "end": 107.17,
   "id": "c52"
  },
  {
   "text": "发帖权限和恢复权限分开",
   "start": 107.286,
   "end": 109.659,
   "id": "c53"
  },
  {
   "text": "再备好被盗预案",
   "start": 110.64,
   "end": 112.036,
   "id": "c54"
  },
  {
   "text": "备用公告渠道",
   "start": 112.152,
   "end": 113.345,
   "id": "c55"
  },
  {
   "text": "平台联系人",
   "start": 113.497,
   "end": 114.512,
   "id": "c56"
  },
  {
   "text": "写好的辟谣声明",
   "start": 114.532,
   "end": 116.083,
   "id": "c57"
  }
 ]
}