 "captions": [
  {
   "text": "2024 年 1 月",
   "start": 1.655,
   "end": 2.841,
   "id": "c0"
  },
  {
   "text": "美国 SEC 的官方 X 账号",
   "start": 3.074,
   "end": 5.533,
   "id": "c1"
  },
  {
   "text": "发了一条消息",
   "start": 5.623,
   "end": 6.587,
   "id": "c2"
  },
  {
   "text": "比特币 ETF 获批了",
   "start": 6.92,
   "end": 8.832,
   "id": "c3"
  },
  {
   "text": "这条消息是假的",
   "start": 9.206,
   "end": 11.553,
   "id": "c4"
  },
  {
   "text": "可它是从监管机构的官方账号发出来的",
   "start": 11.81,
   "end": 14.875,
   "id": "c5"
  },
  {
   "text": "很多人信了",
   "start": 15.064,
   "end": 15.97,
   "id": "c6"
  },
  {
   "text": "BTC 的价格",
   "start": 16.281,
   "end": 17.334,
   "id": "c7"
  },
  {
   "text": "短时间里大幅波动",
   "start": 17.458,
   "end": 18.939,
   "id": "c8"
  },
  {
   "text": "攻击者没有破解 SEC 的任何系统",
   "start": 19.21,
   "end": 22.286,
   "id": "c9"
  },
  {
   "text": "他们只是让一张新的 SIM 卡",
   "start": 22.644,
   "end": 25.32,
   "id": "c10"
  },
  {
   "text": "接管了一个手机号",
   "start": 25.37,
   "end": 26.832,
   "id": "c11"
  },
  {
   "text": "靠这个号码",
   "start": 27.09,
   "end": 28.611,
   "id": "c12"
  },
  {
   "text": "就拿到了官方账号的控制权",
   "start": 28.734,
   "end": 31.09,
   "id": "c13"
  },
  {
   "text": "一张小小的卡",
   "start": 31.404,
   "end": 32.867,
   "id": "c14"
  },
  {
   "text": "就让整个市场跟着晃了一下",
   "start": 33.024,
   "end": 35.628,
   "id": "c15"
  },
  {
   "text": "先猜一道题",
   "start": 35.85,
   "end": 36.821,
   "id": "c16"
  },
  {
   "text": "SEC 是监管机构",
   "start": 37.11,
   "end": 38.688,
   "id": "c17"
  },
  {
   "text": "当时这个账号",
   "start": 39.225,
   "end": 40.468,
   "id": "c18"
  },
  {
   "text": "开了多因素认证吗",
   "start": 40.488,
   "end": 41.875,
   "id": "c19"
  },
  {
   "text": "先记住这个问题",
   "start": 42.41,
   "end": 43.781,
   "id": "c20"
  },
  {
   "text": "我们从链上",
   "start": 44.012,
   "end": 45.009,
   "id": "c21"
  },
  {
   "text": "一路走到线下",
   "start": 45.076,
   "end": 46.231,
   "id": "c22"
  }
 ]
