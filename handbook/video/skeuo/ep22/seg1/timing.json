 "lines": [
  {
   "id": "seg1-00",
   "text": "2024 年 1 月，美国 SEC 的官方 X 账号，发了一条消息。",
   "spoken": "2024 年 1 月，美国 SEC 的官方 X 账号，发了一条消息。",
   "src": "/Users/k/Workon/Learning/web3/web3-security-101/handbook/video/skeuo/ep22/audio/lines/seg1-00.wav",
   "start": 1.6,
   "dur": 5.04,
   "speechStart": 1.705,
   "speechEnd": 6.467
  },
  {
   "id": "seg1-01",
   "text": "比特币 ETF 获批了。",
   "spoken": "比特币 ETF 获批了。",
   "src": "/Users/k/Workon/Learning/web3/web3-security-101/handbook/video/skeuo/ep22/audio/lines/seg1-01.wav",
   "start": 6.86,
   "dur": 2.08,
   "speechStart": 6.97,
   "speechEnd": 8.712
  },
  {
   "id": "seg1-02",
   "text": "这条消息是假的。",
   "spoken": "这条消息是假的。",
   "src": "/Users/k/Workon/Learning/web3/web3-security-101/handbook/video/skeuo/ep22/audio/lines/seg1-02.wav",
   "start": 9.16,
   "dur": 2.48,
   "speechStart": 9.256,
   "speechEnd": 11.433
  },
  {
   "id": "seg1-03",
   "text": "可它是从监管机构的官方账号发出来的，很多人信了。",
   "spoken": "可它是从监管机构的官方账号发出来的，很多人信了。",
   "src": "/Users/k/Workon/Learning/web3/web3-security-101/handbook/video/skeuo/ep22/audio/lines/seg1-03.wav",
   "start": 11.86,
   "dur": 4.16,
   "speechStart": 11.86,
   "speechEnd": 15.85
  },
  {
   "id": "seg1-04",
   "text": "BTC 的价格，短时间里大幅波动。",
   "spoken": "BTC 的价格，短时间里大幅波动。",
   "src": "/Users/k/Workon/Learning/web3/web3-security-101/handbook/video/skeuo/ep22/audio/lines/seg1-04.wav",
   "start": 16.24,
   "dur": 2.8,
   "speechStart": 16.331,
   "speechEnd": 18.819
  },
  {
   "id": "seg1-05",
   "text": "攻击者没有破解 SEC 的任何系统。",
   "spoken": "攻击者没有破解 SEC 的任何系统。",
   "src": "/Users/k/Workon/Learning/web3/web3-security-101/handbook/video/skeuo/ep22/audio/lines/seg1-05.wav",
   "start": 19.26,
   "dur": 3.12,
   "speechStart": 19.26,
   "speechEnd": 22.166
  },
  {
   "id": "seg1-06",
   "text": "他们只是让一张新的 SIM 卡，接管了一个手机号。",
   "spoken": "他们只是让一张新的 SIM 卡，接管了一个手机号。",
   "src": "/Users/k/Workon/Learning/web3/web3-security-101/handbook/video/skeuo/ep22/audio/lines/seg1-06.wav",
   "start": 22.6,
   "dur": 4.32,
   "speechStart": 22.694,
   "speechEnd": 26.712
  },
  {
   "id": "seg1-07",
   "text": "靠这个号码，就拿到了官方账号的控制权。",
   "spoken": "靠这个号码，就拿到了官方账号的控制权。",
   "src": "/Users/k/Workon/Learning/web3/web3-security-101/handbook/video/skeuo/ep22/audio/lines/seg1-07.wav",
   "start": 27.14,
   "dur": 4.0,
   "speechStart": 27.14,
   "speechEnd": 30.97
  },
  {
   "id": "seg1-08",
   "text": "一张小小的卡，就让整个市场跟着晃了一下。",
   "spoken": "一张小小的卡，就让整个市场跟着晃了一下。",
   "src": "/Users/k/Workon/Learning/web3/web3-security-101/handbook/video/skeuo/ep22/audio/lines/seg1-08.wav",
   "start": 31.36,
   "dur": 4.32,
   "speechStart": 31.454,
   "speechEnd": 35.508
  },
  {
   "id": "seg1-09",
   "text": "先猜一道题。",
   "spoken": "先猜一道题。",
   "src": "/Users/k/Workon/Learning/web3/web3-security-101/handbook/video/skeuo/ep22/audio/lines/seg1-09.wav",
   "start": 35.9,
   "dur": 1.04,
   "speechStart": 35.9,
   "speechEnd": 36.701
  },
  {
   "id": "seg1-10",
   "text": "SEC 是监管机构，当时这个账号，开了多因素认证吗？",
   "spoken": "SEC 是监管机构，当时这个账号，开了多因素认证吗？",
   "src": "/Users/k/Workon/Learning/web3/web3-security-101/handbook/video/skeuo/ep22/audio/lines/seg1-10.wav",
   "start": 37.16,
   "dur": 4.8,
   "speechStart": 37.16,
   "speechEnd": 41.755
  },
  {
   "id": "seg1-11",
   "text": "先记住这个问题，我们从链上，一路走到线下。",
   "spoken": "先记住这个问题，我们从链上，一路走到线下。",
