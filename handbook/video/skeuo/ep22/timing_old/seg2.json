 "captions": [
  {
   "text": "先给准确的说法",
   "start": 1.55,
   "end": 2.807,
   "id": "c0"
  },
  {
   "text": "扳手攻击",
   "start": 3.153,
   "end": 4.108,
   "id": "c1"
  },
  {
   "text": "就是用暴力或威胁",
   "start": 4.147,
   "end": 6.054,
   "id": "c2"
  },
  {
   "text": "逼持币的人交出私钥",
   "start": 6.263,
   "end": 8.058,
   "id": "c3"
  },
  {
   "text": "或者转账",
   "start": 8.078,
   "end": 8.805,
   "id": "c4"
  },
  {
   "text": "这个名字来自一幅漫画",
   "start": 9.13,
   "end": 10.969,
   "id": "c5"
  },
  {
   "text": "花大价钱买算力",
   "start": 11.25,
   "end": 12.74,
   "id": "c6"
  },
  {
   "text": "破解不了加密",
   "start": 12.935,
   "end": 13.951,
   "id": "c7"
  },
  {
   "text": "买一把便宜的扳手 就够了",
   "start": 14.2,
   "end": 16.253,
   "id": "c8"
  },
  {
   "text": "密码学挡不住扳手",
   "start": 16.603,
   "end": 18.404,
   "id": "c9"
  },
  {
   "text": "攻击者知道你是谁 住在哪",
   "start": 18.743,
   "end": 21.419,
   "id": "c10"
  },
  {
   "text": "有多少资产",
   "start": 21.563,
   "end": 22.591,
   "id": "c11"
  },
  {
   "text": "最便宜的办法",
   "start": 22.768,
   "end": 24.01,
   "id": "c12"
  },
  {
   "text": "就是找到你本人",
   "start": 24.142,
   "end": 25.478,
   "id": "c13"
  },
  {
   "text": "打个比方",
   "start": 25.845,
   "end": 26.517,
   "id": "c14"
  },
  {
   "text": "你给家门装了一把银行级的锁",
   "start": 26.779,
   "end": 29.27,
   "id": "c15"
  },
  {
   "text": "可你的门牌号",
   "start": 29.49,
   "end": 30.867,
   "id": "c16"
  },
  {
   "text": "作息时间",
   "start": 30.928,
   "end": 31.813,
   "id": "c17"
  },
  {
   "text": "保险柜里有多少钱",
   "start": 31.898,
   "end": 33.404,
   "id": "c18"
  },
  {
   "text": "都印在一张贴在网上的海报上",
   "start": 33.546,
   "end": 36.064,
   "id": "c19"
  },
  {
   "text": "锁越好 劫匪越不会去撬锁",
   "start": 36.444,
   "end": 39.271,
   "id": "c20"
  },
  {
   "text": "而是等你回家",
   "start": 39.291,
   "end": 40.311,
   "id": "c21"
  },
  {
   "text": "比喻在这里不成立",
   "start": 40.671,
   "end": 42.004,
   "id": "c22"
  },
  {
   "text": "劫匪要先知道你有钱",
   "start": 42.377,
   "end": 44.299,
   "id": "c23"
  },
  {
   "text": "而链上资产的特点是",
   "start": 44.55,
   "end": 46.213,
   "id": "c24"
  },
  {
   "text": "地址一旦和身份连上",
   "start": 46.422,
   "end": 48.253,
   "id": "c25"
  },
  {
   "text": "余额对全世界公开",
   "start": 48.459,
   "end": 50.194,
   "id": "c26"
  },
  {
   "text": "所以攻击的第一步 是关联",
   "start": 50.545,
   "end": 53.263,
   "id": "c27"
  },
  {
   "text": "把一个链上地址",
   "start": 53.565,
   "end": 55.049,
   "id": "c28"
  },
  {
   "text": "连到一个真实的人",
   "start": 55.156,
   "end": 56.822,
   "id": "c29"
  },
  {
   "text": "一个真实的住址",
   "start": 57.006,
   "end": 58.307,
   "id": "c30"
  },
  {
   "text": "线索有三类",
   "start": 58.57,
   "end": 59.856,
   "id": "c31"
  },
  {
   "text": "公开信息",
   "start": 60.168,
   "end": 61.245,
   "id": "c32"
  },
  {
   "text": "比如社交媒体 采访",
   "start": 61.495,
   "end": 63.871,
   "id": "c33"
  },
  {
   "text": "会议照片",
   "start": 63.948,
   "end": 64.765,
   "id": "c34"
  },
  {
   "text": "数据泄露",
   "start": 65.01,
   "end": 66.119,
   "id": "c35"
  },
  {
   "text": "比如 KYC 资料",
   "start": 66.387,
   "end": 67.895,
   "id": "c36"
  },
  {
   "text": "电商订单",
   "start": 68.1,
   "end": 69.101,
   "id": "c37"
  },
  {
   "text": "客服工单",
   "start": 69.3,
   "end": 70.25,
   "id": "c38"
  },
  {
   "text": "还有链上数据",
   "start": 70.51,
   "end": 71.773,
   "id": "c39"
  },
  {
   "text": "地址的余额和交易历史",
   "start": 71.838,
   "end": 73.793,
   "id": "c40"
  },
  {
   "text": "三类线索拼在一起",
   "start": 74.01,
   "end": 75.722,
   "id": "c41"
  },
  {
   "text": "就能筛出余额高",
   "start": 75.809,
   "end": 77.303,
   "id": "c42"
  },
  {
   "text": "住址已知的目标",
   "start": 77.408,
   "end": 78.643,
   "id": "c43"
  },
  {
   "text": "接下来有两条路",
   "start": 78.87,
   "end": 80.392,
   "id": "c44"
  },
  {
   "text": "一条找上门",
   "start": 80.592,
   "end": 81.821,
   "id": "c45"
  },
  {
   "text": "一条攻账号",
   "start": 82.038,
   "end": 83.25,
   "id": "c46"
  },
  {
   "text": "数据泄露直接交出了住址",
   "start": 83.49,
   "end": 85.722,
   "id": "c47"
  },
  {
   "text": "所以保护数据",
   "start": 85.912,
   "end": 87.105,
   "id": "c48"
  },
  {
   "text": "也是在保护人身安全",
   "start": 87.164,
   "end": 88.872,
   "id": "c49"
  }
 ]
}