{
 "id": "seg5",
 "title": "拉开距离",
 "pill": 5,
 "total": 110.72,
 "lines": [
  {
   "id": "seg5-00",
   "text": "防御分两头，一头降低暴露，一头降低胁迫的收益。",
   "spoken": "防御分两头，一头降低暴露，一头降低胁迫的收益。",
   "src": "/Users/k/Workon/Learning/web3/web3-security-101/handbook/video/skeuo/ep22/audio/lines/seg5-00.wav",
   "start": 1.6,
   "dur": 5.04,
   "speechStart": 1.6,
   "speechEnd": 6.438
  },
  {
   "id": "seg5-01",
   "text": "降低暴露，先管住嘴，不公开谈持仓，不晒资产截图。",
   "spoken": "降低暴露，先管住嘴，不公开谈持仓，不晒资产截图。",
   "src": "/Users/k/Workon/Learning/web3/web3-security-101/handbook/video/skeuo/ep22/audio/lines/seg5-01.wav",
   "start": 6.86,
   "dur": 4.96,
   "speechStart": 6.86,
   "speechEnd": 11.606
  },
  {
   "id": "seg5-02",
   "text": "链上身份和真实身份分开，公开收款地址和个人大额地址，不用同一个。",
   "spoken": "链上身份和真实身份分开，公开收款地址和个人大额地址，不用同一个。",
   "src": "/Users/k/Workon/Learning/web3/web3-security-101/handbook/video/skeuo/ep22/audio/lines/seg5-02.wav",
   "start": 12.04,
   "dur": 6.48,
   "speechStart": 12.132,
   "speechEnd": 18.316
  },
  {
   "id": "seg5-03",
   "text": "硬件钱包这类订单，用代收地址或者公司地址收货。",
   "spoken": "硬件钱包这类订单，用代收地址或者公司地址收货。",
   "src": "/Users/k/Workon/Learning/web3/web3-security-101/handbook/video/skeuo/ep22/audio/lines/seg5-03.wav",
   "start": 18.74,
   "dur": 4.72,
   "speechStart": 18.74,
   "speechEnd": 23.249
  },
  {
   "id": "seg5-04",
   "text": "照片里不要拍到住址、车牌和日常路线。",
   "spoken": "照片里不要拍到住址、车牌和日常路线。",
   "src": "/Users/k/Workon/Learning/web3/web3-security-101/handbook/video/skeuo/ep22/audio/lines/seg5-04.wav",
   "start": 23.68,
   "dur": 3.6,
   "speechStart": 23.781,
   "speechEnd": 27.108
  },
  {
   "id": "seg5-05",
   "text": "定期搜一搜自己的姓名和住址，去数据经纪网站申请删除。",
   "spoken": "定期搜一搜自己的姓名和住址，去数据经纪网站申请删除。",
   "src": "/Users/k/Workon/Learning/web3/web3-security-101/handbook/video/skeuo/ep22/audio/lines/seg5-05.wav",
   "start": 27.5,
   "dur": 5.28,
   "speechStart": 27.593,
   "speechEnd": 32.527
  },
  {
   "id": "seg5-06",
   "text": "降低胁迫的收益，靠的是让本人确实转不出去。",
   "spoken": "降低胁迫的收益，靠的是让本人确实转不出去。",
   "src": "/Users/k/Workon/Learning/web3/web3-security-101/handbook/video/skeuo/ep22/audio/lines/seg5-06.wav",
   "start": 33.0,
   "dur": 4.4,
   "speechStart": 33.0,
   "speechEnd": 37.152
  },
  {
   "id": "seg5-07",
   "text": "大额资产放进多签或者时间锁，转出要异地的另一个人，或者另一台设备。",
   "spoken": "大额资产放进多签或者时间锁，转出要异地的另一个人，或者另一台设备。",
   "src": "/Users/k/Workon/Learning/web3/web3-security-101/handbook/video/skeuo/ep22/audio/lines/seg5-07.wav",
   "start": 37.62,
   "dur": 6.56,
   "speechStart": 37.716,
   "speechEnd": 43.954
  },
  {
   "id": "seg5-08",
   "text": "随身的设备，只放少量资产。",
   "spoken": "随身的设备，只放少量资产。",
   "src": "/Users/k/Workon/Learning/web3/web3-security-101/handbook/video/skeuo/ep22/audio/lines/seg5-08.wav",
   "start": 44.4,
   "dur": 2.64,
   "speechStart": 44.4,
   "speechEnd": 46.862
  },
  {
   "id": "seg5-09",
   "text": "和家人约定胁迫暗号，还有紧急联系的流程。",
   "spoken": "和家人约定胁迫暗号，还有紧急联系的流程。",
   "src": "/Users/k/Workon/Learning/web3/web3-security-101/handbook/video/skeuo/ep22/audio/lines/seg5-09.wav",
   "start": 47.26,
   "dur": 3.84,
   "speechStart": 47.26,
   "speechEnd": 50.921
  },
  {
   "id": "seg5-10",
   "text": "要说清楚，多签和时间锁，降低的是立即转出的可能，不能保证人身安全。",
   "spoken": "要说清楚，多签和时间锁，降低的是立即转出的可能，不能保证人身安全。",
   "src": "/Users/k/Workon/Learning/web3/web3-security-101/handbook/video/skeuo/ep22/audio/lines/seg5-10.wav",
   "start": 51.32,
   "dur": 7.12,
   "speechStart": 51.414,
   "speechEnd": 58.278
  },
  {
   "id": "seg5-11",
   "text": "劫匪对转不出的反应，难以预测，人身安全第一，资产第二。",
   "spoken": "劫匪对转不出的反应，难以预测，人身安全第一，资产第二。",
   "src": "/Users/k/Workon/Learning/web3/web3-security-101/handbook/video/skeuo/ep22/audio/lines/seg5-11.wav",
   "start": 58.66,
   "dur": 5.2,
   "speechStart": 58.66,
   "speechEnd": 63.645
  },
  {
   "id": "seg5-12",
   "text": "账号这边，邮箱、交易所、社交账号、域名注册商，都用硬件安全密钥，做多因素认证。",
   "spoken": "账号这边，邮箱、交易所、社交账号、域名注册商，都用硬件安全密钥，做多因素认证。",
   "src": "/Users/k/Workon/Learning/web3/web3-security-101/handbook/video/skeuo/ep22/audio/lines/seg5-12.wav",
   "start": 64.08,
   "dur": 7.52,
   "speechStart": 64.178,
   "speechEnd": 71.412
  },
  {
   "id": "seg5-13",
   "text": "不用短信做多因素认证，也不用它恢复密码。",
   "spoken": "不用短信做多因素认证，也不用它恢复密码。",
   "src": "/Users/k/Workon/Learning/web3/web3-security-101/handbook/video/skeuo/ep22/audio/lines/seg5-13.wav",
   "start": 71.82,
   "dur": 3.52,
   "speechStart": 71.915,
   "speechEnd": 75.108
  },
  {
   "id": "seg5-14",
   "text": "向运营商申请号码转移锁，或者 SIM 更换 PIN。",
   "spoken": "向运营商申请号码转移锁，或者 SIM 更换 PIN。",
   "src": "/Users/k/Workon/Learning/web3/web3-security-101/handbook/video/skeuo/ep22/audio/lines/seg5-14.wav",
   "start": 75.56,
   "dur": 5.04,
   "speechStart": 75.56,
   "speechEnd": 80.376
  },
  {
   "id": "seg5-15",
   "text": "关键账号，用不公开的专用邮箱注册。",
   "spoken": "关键账号，用不公开的专用邮箱注册。",
   "src": "/Users/k/Workon/Learning/web3/web3-security-101/handbook/video/skeuo/ep22/audio/lines/seg5-15.wav",
   "start": 80.82,
   "dur": 3.6,
   "speechStart": 80.82,
   "speechEnd": 84.264
  },
  {
   "id": "seg5-16",
   "text": "项目方还要多做几件事。",
   "spoken": "项目方还要多做几件事。",
   "src": "/Users/k/Workon/Learning/web3/web3-security-101/handbook/video/skeuo/ep22/audio/lines/seg5-16.wav",
   "start": 84.64,
   "dur": 2.08,
   "speechStart": 84.64,
   "speechEnd": 86.489
  },
  {
   "id": "seg5-17",
   "text": "列出关键人员，创始人、多签签名人、运维负责人、官方账号管理员。",
   "spoken": "列出关键人员，创始人、多签签名人、运维负责人、官方账号管理员。",
   "src": "/Users/k/Workon/Learning/web3/web3-security-101/handbook/video/skeuo/ep22/audio/lines/seg5-17.wav",
   "start": 86.94,
   "dur": 6.8,
   "speechStart": 87.036,
   "speechEnd": 93.561
  },
  {
   "id": "seg5-18",
   "text": "签名人名单不公开，必要时只公开机构。",
   "spoken": "签名人名单不公开，必要时只公开机构。",
   "src": "/Users/k/Workon/Learning/web3/web3-security-101/handbook/video/skeuo/ep22/audio/lines/seg5-18.wav",
   "start": 93.96,
   "dur": 3.68,
   "speechStart": 94.051,
   "speechEnd": 97.429
  },
  {
   "id": "seg5-19",
   "text": "官方账号交接时，不关闭多因素认证，发帖权限和恢复权限分开。",
   "spoken": "官方账号交接时，不关闭多因素认证，发帖权限和恢复权限分开。",
   "src": "/Users/k/Workon/Learning/web3/web3-security-101/handbook/video/skeuo/ep22/audio/lines/seg5-19.wav",
   "start": 97.86,
   "dur": 5.76,
   "speechStart": 97.955,
   "speechEnd": 103.423
  },
  {
   "id": "seg5-20",
   "text": "再备好被盗预案，备用公告渠道、平台联系人、写好的辟谣声明。",
   "spoken": "再备好被盗预案，备用公告渠道、平台联系人、写好的辟谣声明。",
   "src": "/Users/k/Workon/Learning/web3/web3-security-101/handbook/video/skeuo/ep22/audio/lines/seg5-20.wav",
   "start": 103.84,
   "dur": 5.68,
   "speechStart": 103.84,
   "speechEnd": 109.346
  }
 ],
