   "text": "公开收款地址和个人大额地址",
   "start": 14.831,
   "end": 17.51,
   "id": "c8"
  },
  {
   "text": "不用同一个",
   "start": 17.637,
   "end": 18.436,
   "id": "c9"
  },
  {
   "text": "硬件钱包这类订单",
   "start": 18.69,
   "end": 20.394,
   "id": "c10"
  },
  {
   "text": "用代收地址或者公司地址收货",
   "start": 20.614,
   "end": 23.369,
   "id": "c11"
  },
  {
   "text": "照片里不要拍到住址",
   "start": 23.731,
   "end": 25.518,
   "id": "c12"
  },
  {
   "text": "车牌和日常路线",
   "start": 25.55,
   "end": 27.228,
   "id": "c13"
  },
  {
   "text": "定期搜一搜自己的姓名和住址",
   "start": 27.543,
   "end": 30.105,
   "id": "c14"
  },
  {
   "text": "去数据经纪网站申请删除",
   "start": 30.411,
   "end": 32.647,
   "id": "c15"
  },
  {
   "text": "降低胁迫的收益",
   "start": 32.95,
   "end": 34.538,
   "id": "c16"
  },
  {
   "text": "靠的是让本人确实转不出去",
   "start": 34.682,
   "end": 37.272,
   "id": "c17"
  },
  {
   "text": "大额资产放进多签或者时间锁",
   "start": 37.666,
   "end": 40.397,
   "id": "c18"
  },
  {
   "text": "转出要异地的另一个人",
   "start": 40.588,
   "end": 42.761,
   "id": "c19"
  },
  {
   "text": "或者另一台设备",
   "start": 42.843,
   "end": 44.074,
   "id": "c20"
  },
  {
   "text": "随身的设备",
   "start": 44.35,
   "end": 45.448,
   "id": "c21"
  },
  {
   "text": "只放少量资产",
   "start": 45.624,
   "end": 46.982,
   "id": "c22"
  },
  {
   "text": "和家人约定胁迫暗号",
   "start": 47.21,
   "end": 49.12,
   "id": "c23"
  },
  {
   "text": "还有紧急联系的流程",
   "start": 49.324,
   "end": 51.041,
   "id": "c24"
  },
  {
   "text": "要说清楚",
   "start": 51.364,
   "end": 52.22,
   "id": "c25"
  },
  {
   "text": "多签和时间锁",
   "start": 52.455,
   "end": 53.999,
   "id": "c26"
  },
  {
   "text": "降低的是立即转出的可能",
   "start": 54.232,
   "end": 56.627,
   "id": "c27"
  },
  {
   "text": "不能保证人身安全",
   "start": 56.873,
   "end": 58.398,
   "id": "c28"
  },
  {
   "text": "劫匪对转不出的反应",
   "start": 58.61,
   "end": 60.465,
   "id": "c29"
  },
  {
   "text": "难以预测",
   "start": 60.817,
   "end": 61.678,
   "id": "c30"
  },
  {
   "text": "人身安全第一",
   "start": 61.894,
   "end": 62.94,
   "id": "c31"
  },
  {
   "text": "资产第二",
   "start": 62.96,
   "end": 63.765,
   "id": "c32"
  },
  {
   "text": "账号这边 邮箱 交易所",
   "start": 64.128,
   "end": 66.53,
   "id": "c33"
  },
  {
   "text": "社交账号",
   "start": 66.55,
   "end": 67.483,
   "id": "c34"
  },
  {
   "text": "域名注册商",
   "start": 67.682,
   "end": 68.614,
   "id": "c35"
  },
  {
   "text": "都用硬件安全密钥",
   "start": 68.795,
   "end": 70.317,
   "id": "c36"
  },
  {
   "text": "做多因素认证",
   "start": 70.337,
   "end": 71.532,
   "id": "c37"
  },
  {
   "text": "不用短信做多因素认证",
   "start": 71.865,
   "end": 73.58,
   "id": "c38"
  },
  {
   "text": "也不用它恢复密码",
   "start": 73.809,
   "end": 75.228,
   "id": "c39"
  },
  {
   "text": "向运营商申请号码转移锁",
   "start": 75.51,
   "end": 78.588,
   "id": "c40"
  },
  {
   "text": "或者 SIM 更换 PIN",
   "start": 78.628,
   "end": 80.496,
   "id": "c41"
  },
  {
   "text": "关键账号",
   "start": 80.77,
   "end": 81.805,
   "id": "c42"
  },
  {
   "text": "用不公开的专用邮箱注册",
   "start": 82.034,
   "end": 84.384,
   "id": "c43"
  },
  {
   "text": "项目方还要多做几件事",
   "start": 84.59,
   "end": 86.609,
   "id": "c44"
  },
  {
   "text": "列出关键人员 创始人",
   "start": 86.986,
   "end": 89.322,
   "id": "c45"
  },
  {
   "text": "多签签名人",
   "start": 89.461,
   "end": 90.631,
   "id": "c46"
  },
  {
   "text": "运维负责人",
   "start": 90.892,
   "end": 91.988,
   "id": "c47"
  },
  {
   "text": "官方账号管理员",
   "start": 92.186,
   "end": 93.681,
   "id": "c48"
  },
  {
   "text": "签名人名单不公开",
   "start": 94.001,
   "end": 95.705,
   "id": "c49"
  },
  {
   "text": "必要时只公开机构",
   "start": 95.935,
   "end": 97.549,
   "id": "c50"
  },
  {
   "text": "官方账号交接时",
   "start": 97.905,
   "end": 99.309,
   "id": "c51"
  },
  {
   "text": "不关闭多因素认证",
   "start": 99.47,
   "end": 101.013,
   "id": "c52"
  },
  {
   "text": "发帖权限和恢复权限分开",
   "start": 101.162,
   "end": 103.543,
   "id": "c53"
  },
  {
   "text": "再备好被盗预案",
   "start": 103.79,
   "end": 105.249,
   "id": "c54"
  },
  {
   "text": "备用公告渠道",
   "start": 105.426,
   "end": 106.634,
   "id": "c55"
  },
  {
   "text": "平台联系人",
   "start": 106.78,
   "end": 107.775,
   "id": "c56"
  },
  {
   "text": "写好的辟谣声明",
   "start": 107.932,
   "end": 109.466,
   "id": "c57"
  }
 ]
}