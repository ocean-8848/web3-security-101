 "captions": [
  {
   "text": "最后 每个人今天就能做一件事",
   "start": 1.55,
   "end": 4.357,
   "id": "c0"
  },
  {
   "text": "写协议的人",
   "start": 4.57,
   "end": 5.706,
   "id": "c1"
  },
  {
   "text": "把偿付不变量写成一条公式",
   "start": 5.726,
   "end": 8.003,
   "id": "c2"
  },
  {
   "text": "再用不变量测试去验证它",
   "start": 8.058,
   "end": 10.175,
   "id": "c3"
  },
  {
   "text": "审计的人",
   "start": 10.39,
   "end": 11.311,
   "id": "c4"
  },
  {
   "text": "列出每一个改变抵押品和债务的入口",
   "start": 11.406,
   "end": 14.63,
   "id": "c5"
  },
  {
   "text": "逐个核对有没有健康检查",
   "start": 14.817,
   "end": 16.914,
   "id": "c6"
  },
  {
   "text": "普通用户",
   "start": 17.17,
   "end": 18.12,
   "id": "c7"
  },
  {
   "text": "收益来源说不清楚的产品",
   "start": 18.238,
   "end": 20.29,
   "id": "c8"
  },
  {
   "text": "不要投入大额",
   "start": 20.343,
   "end": 21.511,
   "id": "c9"
  },
  {
   "text": "稳定币也不是无风险资产",
   "start": 21.79,
   "end": 23.947,
   "id": "c10"
  },
  {
   "text": "先查它的储备",
   "start": 24.144,
   "end": 25.366,
   "id": "c11"
  },
  {
   "text": "赎回规则",
   "start": 25.472,
   "end": 26.376,
   "id": "c12"
  },
  {
   "text": "和发行方的冻结权限",
   "start": 26.501,
   "end": 28.236,
   "id": "c13"
  },
  {
   "text": "回到开头",
   "start": 28.588,
   "end": 29.321,
   "id": "c14"
  },
  {
   "text": "每个函数都没有错",
   "start": 29.809,
   "end": 31.225,
   "id": "c15"
  },
  {
   "text": "协议为什么损失约 1.97 亿美元",
   "start": 31.364,
   "end": 35.081,
   "id": "c16"
  },
  {
   "text": "因为规则允许一条路径",
   "start": 35.63,
   "end": 37.755,
   "id": "c17"
  },
  {
   "text": "减少抵押品",
   "start": 37.911,
   "end": 39.17,
   "id": "c18"
  },
  {
   "text": "却不检查健康因子",
   "start": 39.261,
   "end": 41.014,
   "id": "c19"
  },
  {
   "text": "这个答案成立的前提是",
   "start": 41.39,
   "end": 43.121,
   "id": "c20"
  },
  {
   "text": "清算折扣会随缺口变大",
   "start": 43.444,
   "end": 45.9,
   "id": "c21"
  },
  {
   "text": "缺口才能变成利润",
   "start": 46.005,
   "end": 47.481,
   "id": "c22"
  },
  {
   "text": "代码没错",
   "start": 47.841,
   "end": 48.738,
   "id": "c23"
  },
  {
   "text": "规则错了",
   "start": 48.834,
   "end": 49.71,
   "id": "c24"
  },
  {
   "text": "规则的每一种组合",
   "start": 49.9,
   "end": 51.36,
   "id": "c25"
  },
  {
   "text": "都要守住偿付不变量",
   "start": 51.522,
   "end": 53.414,
   "id": "c26"
  },
  {
   "text": "下一集讲跨链桥安全",
   "start": 53.65,
   "end": 55.849,
   "id": "c27"
  }
 ]
}