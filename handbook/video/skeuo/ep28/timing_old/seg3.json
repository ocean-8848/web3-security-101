 "captions": [
  {
   "text": "第一种 先交互 后记账",
   "start": 1.654,
   "end": 4.118,
   "id": "c0"
  },
  {
   "text": "识别信号是",
   "start": 4.41,
   "end": 5.498,
   "id": "c1"
  },
  {
   "text": "外部调用之后",
   "start": 5.67,
   "end": 6.798,
   "id": "c2"
  },
  {
   "text": "还有状态写入",
   "start": 6.831,
   "end": 7.791,
   "id": "c3"
  },
  {
   "text": "The DAO 是它",
   "start": 8.07,
   "end": 9.179,
   "id": "c4"
  },
  {
   "text": "Curve 也是它",
   "start": 9.302,
   "end": 10.705,
   "id": "c5"
  },
  {
   "text": "2022 年 4 月的 Fei Rari",
   "start": 11.113,
   "end": 14.214,
   "id": "c6"
  },
  {
   "text": "先发送 ETH 后记账",
   "start": 14.234,
   "end": 16.014,
   "id": "c7"
  },
  {
   "text": "损失约 8000 万美元",
   "start": 16.247,
   "end": 18.273,
   "id": "c8"
  },
  {
   "text": "其中一个退出函数",
   "start": 18.51,
   "end": 20.084,
   "id": "c9"
  },
  {
   "text": "没被重入锁覆盖",
   "start": 20.304,
   "end": 21.554,
   "id": "c10"
  },
  {
   "text": "防御是先检查",
   "start": 21.77,
   "end": 23.426,
   "id": "c11"
  },
  {
   "text": "再改状态",
   "start": 23.584,
   "end": 24.495,
   "id": "c12"
  },
  {
   "text": "最后才和外部交互",
   "start": 24.756,
   "end": 26.448,
   "id": "c13"
  },
  {
   "text": "再加一把所有函数共享的重入锁",
   "start": 26.659,
   "end": 29.589,
   "id": "c14"
  },
  {
   "text": "第二种 零值或默认值有含义",
   "start": 29.921,
   "end": 33.184,
   "id": "c15"
  },
  {
   "text": "2022 年 8 月",
   "start": 33.513,
   "end": 34.814,
   "id": "c16"
  },
  {
   "text": "Nomad 跨链桥的可信根",
   "start": 35.074,
   "end": 37.667,
   "id": "c17"
  },
  {
   "text": "被设成了全零",
   "start": 37.687,
   "end": 38.475,
   "id": "c18"
  },
  {
   "text": "损失约 1.9 亿美元",
   "start": 38.884,
   "end": 41.128,
   "id": "c19"
  },
  {
   "text": "零本该表示什么都没有",
   "start": 41.48,
   "end": 43.472,
   "id": "c20"
  },
  {
   "text": "在这里却成了合法的值",
   "start": 43.692,
   "end": 46.001,
   "id": "c21"
  },
  {
   "text": "同年 1 月",
   "start": 46.25,
   "end": 47.106,
   "id": "c22"
  },
  {
   "text": "BNB Chain 上的 Qubit 跨链桥",
   "start": 47.217,
   "end": 49.436,
   "id": "c23"
  },
  {
   "text": "对零地址发起的转账",
   "start": 49.486,
   "end": 51.266,
   "id": "c24"
  },
  {
   "text": "也返回了成功",
   "start": 51.365,
   "end": 52.449,
   "id": "c25"
  },
  {
   "text": "这一次 损失约 8000 万美元",
   "start": 52.808,
   "end": 55.723,
   "id": "c26"
  },
  {
   "text": "识别信号是 等于零 零地址",
   "start": 55.97,
   "end": 58.792,
   "id": "c27"
  },
  {
   "text": "没初始化的映射",
   "start": 59.025,
   "end": 60.212,
   "id": "c28"
  },
  {
   "text": "被当成了合法值",
   "start": 60.422,
   "end": 61.919,
   "id": "c29"
  },
  {
   "text": "防御是零值一律视为无效",
   "start": 62.19,
   "end": 64.752,
   "id": "c30"
  },
  {
   "text": "存在与否",
   "start": 64.965,
   "end": 65.83,
   "id": "c31"
  },
  {
   "text": "用单独的标记来记",
   "start": 65.85,
   "end": 67.32,
   "id": "c32"
  },
  {
   "text": "第三种 一笔交易里能被改变的数据",
   "start": 67.61,
   "end": 70.983,
   "id": "c33"
  },
  {
   "text": "被当成了事实",
   "start": 71.116,
   "end": 72.394,
   "id": "c34"
  },
  {
   "text": "2020 年 2 月的 bZx",
   "start": 72.723,
   "end": 75.106,
   "id": "c35"
  },
  {
   "text": "只看一个 DEX 的价格",
   "start": 75.349,
   "end": 77.259,
   "id": "c36"
  },
  {
   "text": "2021 年 5 月的 PancakeBunny",
   "start": 77.49,
   "end": 79.967,
   "id": "c37"
  },
  {
   "text": "按池子储备给 LP 定价",
   "start": 80.144,
   "end": 82.23,
   "id": "c38"
  },
  {
   "text": "同年 10 月的 Cream Finance",
   "start": 82.603,
   "end": 84.407,
   "id": "c39"
  },
  {
   "text": "份额价格可以被捐赠抬高",
   "start": 84.576,
   "end": 86.74,
   "id": "c40"
  },
  {
   "text": "损失约 1.3 亿美元",
   "start": 86.887,
   "end": 88.674,
   "id": "c41"
  },
  {
   "text": "池子储备",
