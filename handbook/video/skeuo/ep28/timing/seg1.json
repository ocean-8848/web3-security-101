 "captions": [
  {
   "text": "2016 年 6 月",
   "start": 1.648,
   "end": 2.96,
   "id": "c0"
  },
  {
   "text": "以太坊上的 The DAO 被攻击",
   "start": 3.017,
   "end": 5.115,
   "id": "c1"
  },
  {
   "text": "损失约 6000 万美元",
   "start": 5.195,
   "end": 7.091,
   "id": "c2"
  },
  {
   "text": "根因只有一句 先转账",
   "start": 8.084,
   "end": 10.218,
   "id": "c3"
  },
  {
   "text": "后更新余额",
   "start": 10.286,
   "end": 11.492,
   "id": "c4"
  },
  {
   "text": "钱已经转出去",
   "start": 12.48,
   "end": 13.709,
   "id": "c5"
  },
  {
   "text": "账上的余额还没减",
   "start": 13.908,
   "end": 15.304,
   "id": "c6"
  },
  {
   "text": "对方合约在收款的回调里",
   "start": 16.276,
   "end": 18.112,
   "id": "c7"
  },
  {
   "text": "马上回来",
   "start": 18.24,
   "end": 19.148,
   "id": "c8"
  },
  {
   "text": "再取一次",
   "start": 19.252,
   "end": 20.184,
   "id": "c9"
  },
  {
   "text": "七年后 2023 年 7 月",
   "start": 21.176,
   "end": 23.56,
   "id": "c10"
  },
  {
   "text": "Curve 被攻击",
   "start": 23.664,
   "end": 24.822,
   "id": "c11"
  },
  {
   "text": "损失约 7000 万美元",
   "start": 24.866,
   "end": 26.727,
   "id": "c12"
  },
  {
   "text": "这一次 合约里写了重入锁",
   "start": 27.708,
   "end": 30.568,
   "id": "c13"
  },
  {
   "text": "可是 Vyper 编译器",
   "start": 31.528,
   "end": 33.34,
   "id": "c14"
  },
  {
   "text": "把这把锁实现错了",
   "start": 33.42,
   "end": 34.769,
   "id": "c15"
  },
  {
   "text": "又过了一年多",
   "start": 35.756,
   "end": 36.807,
   "id": "c16"
  },
  {
   "text": "2024 年 9 月",
   "start": 36.982,
   "end": 38.259,
   "id": "c17"
  },
  {
   "text": "Penpie 损失约 2700 万美元",
   "start": 38.363,
   "end": 41.009,
   "id": "c18"
  },
  {
   "text": "它的领奖函数",
   "start": 42.0,
   "end": 43.253,
   "id": "c19"
  },
  {
   "text": "没有加锁",
   "start": 43.464,
   "end": 44.431,
   "id": "c20"
  },
  {
   "text": "三个名字",
   "start": 45.412,
   "end": 46.403,
   "id": "c21"
  },
  {
   "text": "三种写法",
   "start": 46.435,
   "end": 47.534,
   "id": "c22"
  },
  {
   "text": "其实是同一个错误 先交互 后记账",
   "start": 47.602,
   "end": 50.653,
   "id": "c23"
  },
  {
   "text": "一个早就修过的漏洞",
   "start": 51.632,
   "end": 53.242,
   "id": "c24"
  },
  {
   "text": "为什么会换个名字",
   "start": 53.608,
   "end": 54.944,
   "id": "c25"
  },
  {
   "text": "一再回来",
   "start": 55.072,
   "end": 55.837,
   "id": "c26"
  },
  {
   "text": "读旧事故",
   "start": 57.1,
   "end": 58.246,
   "id": "c27"
  },
  {
   "text": "能不能让我们提前认出下一起",
   "start": 58.29,
   "end": 60.853,
   "id": "c28"
  },
  {
   "text": "带着这两个问题",
   "start": 62.112,
   "end": 63.377,
   "id": "c29"
  },
  {
   "text": "我们走进一座事故档案馆",
   "start": 63.469,
   "end": 65.27,
   "id": "c30"
  }
 ]
}