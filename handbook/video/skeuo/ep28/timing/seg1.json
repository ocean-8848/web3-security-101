   "speechStart": 8.134,
   "speechEnd": 11.372
  },
  {
   "id": "seg1-02",
   "text": "钱已经转出去，账上的余额还没减。",
   "spoken": "钱已经转出去，账上的余额还没减。",
   "src": "/Users/k/Workon/Learning/web3/web3-security-101/handbook/video/skeuo/ep28/audio/lines/seg1-02.mp3",
   "start": 12.432,
   "dur": 3.576,
   "speechStart": 12.53,
   "speechEnd": 15.184
  },
  {
   "id": "seg1-03",
   "text": "对方合约在收款的回调里，马上回来，再取一次。",
   "spoken": "对方合约在收款的回掉里，马上回来，再取一次。",
