   "id": "c0"
  },
  {
   "text": "识别信号是",
   "start": 5.084,
   "end": 6.289,
   "id": "c1"
  },
  {
   "text": "外部调用之后",
   "start": 6.369,
   "end": 7.54,
   "id": "c2"
  },
  {
   "text": "还有状态写入",
   "start": 7.56,
   "end": 8.67,
   "id": "c3"
  },
  {
   "text": "The DAO 是它",
   "start": 9.648,
   "end": 10.639,
   "id": "c4"
  },
  {
   "text": "Curve 也是它",
   "start": 10.671,
   "end": 11.758,
   "id": "c5"
  },
  {
   "text": "2022 年 4 月的 Fei Rari",
   "start": 12.724,
   "end": 14.822,
   "id": "c6"
  },
  {
   "text": "先发送 ETH 后记账",
   "start": 14.938,
   "end": 16.965,
   "id": "c7"
  },
  {
   "text": "损失约 8000 万美元",
   "start": 16.997,
   "end": 18.763,
   "id": "c8"
  },
  {
   "text": "其中一个退出函数",
   "start": 19.76,
   "end": 21.358,
   "id": "c9"
  },
  {
   "text": "没被重入锁覆盖",
   "start": 21.533,
   "end": 22.918,
   "id": "c10"
  },
  {
   "text": "防御是先检查",
   "start": 23.916,
   "end": 25.336,
   "id": "c11"
  },
  {
   "text": "再改状态",
   "start": 25.404,
   "end": 26.431,
   "id": "c12"
  },
  {
   "text": "最后才和外部交互",
   "start": 26.499,
   "end": 27.978,
   "id": "c13"
  },
  {
   "text": "再加一把所有函数共享的重入锁",
