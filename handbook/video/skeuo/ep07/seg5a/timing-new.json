   "text": "现在想改成 50 枚",
   "start": 12.806,
   "end": 14.464,
   "id": "c5"
  },
  {
   "text": "Bob 能抢先打包自己的交易",
   "start": 15.436,
   "end": 17.522,
   "id": "c6"
  },
  {
   "text": "他最多能拿走多少",
   "start": 17.898,
   "end": 19.484,
   "id": "c7"
  },
  {
   "text": "150 枚",
   "start": 20.76,
   "end": 21.834,
   "id": "c8"
  },
  {
   "text": "他先花掉旧的 100 枚",
   "start": 22.198,
   "end": 23.82,
   "id": "c9"
  },
  {
   "text": "等新额度生效",
   "start": 24.796,
   "end": 26.145,
   "id": "c10"
  },
  {
   "text": "再花 50 枚",
   "start": 26.165,
   "end": 27.358,
   "id": "c11"
  },
  {
   "text": "这叫 approve 竞态",
   "start": 28.328,
   "end": 29.89,
   "id": "c12"
  },
  {
   "text": "缓解办法之一",
   "start": 30.876,
   "end": 31.998,
   "id": "c13"
  },
  {
   "text": "先设成 0",
   "start": 32.233,
   "end": 33.344,
   "id": "c14"
  },
  {
   "text": "看旧额度有没有被花掉",
   "start": 33.364,
   "end": 35.034,
   "id": "c15"
  },
  {
   "text": "再设新值",
   "start": 35.114,
   "end": 36.153,
   "id": "c16"
  },
  {
   "text": "之二",
   "start": 37.12,
   "end": 37.754,
   "id": "c17"
  },
  {
   "text": "用 safeDecreaseAllowance",
   "start": 37.774,
   "end": 39.385,
   "id": "c18"
  },
  {
   "text": "相对减少",
   "start": 39.405,
   "end": 40.337,
   "id": "c19"
  },
  {
   "text": "额度已被抢先花掉",
   "start": 40.712,
   "end": 42.299,
   "id": "c20"
  },
  {
   "text": "交易就回滚",
   "start": 42.439,
   "end": 43.466,
   "id": "c21"
  },
  {
   "text": "forceApprove 只解决兼容问题",
   "start": 44.444,
   "end": 46.721,
   "id": "c22"
  },
  {
   "text": "不解决竞态",
   "start": 46.741,
   "end": 47.685,
   "id": "c23"
  },
  {
   "text": "比竞态更大的风险",
   "start": 48.672,
   "end": 50.223,
   "id": "c24"
  },
  {
   "text": "是无限授权",
   "start": 50.291,
   "end": 51.58,
   "id": "c25"
  },
  {
   "text": "协议一旦被攻破",
   "start": 52.564,
   "end": 54.198,
   "id": "c26"
  },
  {
   "text": "攻击者能转走你钱包里全部的这种代币",
   "start": 54.468,
   "end": 56.96,
   "id": "c27"
  },
  {
   "text": "即使你从没把它存进协议",
   "start": 57.944,
   "end": 59.864,
   "id": "c28"
  },
  {
   "text": "钓鱼网站也盯着授权",
   "start": 60.852,
   "end": 62.617,
   "id": "c29"
  },
  {
   "text": "诱导你签 approve",
   "start": 62.768,
   "end": 64.213,
   "id": "c30"
  },
  {
   "text": "或者链下签名的 permit",
   "start": 64.233,
   "end": 65.998,
   "id": "c31"
  },
  {
   "text": "最危险的组合",
   "start": 67.0,
   "end": 68.277,
   "id": "c32"
  },
  {
   "text": "是任意调用加授权",
   "start": 68.297,
   "end": 70.027,
   "id": "c33"
  },
  {
   "text": "路由合约持有用户的授权",
   "start": 71.012,
   "end": 73.039,
   "id": "c34"
  },
  {
   "text": "又允许用户指定任意目标",
   "start": 74.04,
   "end": 76.353,
   "id": "c35"
  },
  {
   "text": "和任意 calldata",
   "start": 76.373,
   "end": 77.674,
   "id": "c36"
  },
  {
   "text": "攻击者就能让它",
   "start": 78.676,
   "end": 80.0,
   "id": "c37"
  },
  {
   "text": "调用代币的 transferFrom",
   "start": 80.045,
   "end": 81.81,
   "id": "c38"
  },
  {
   "text": "从受害者转给自己",
   "start": 81.866,
   "end": 83.31,
   "id": "c39"
  },
  {
   "text": "2023 年 4 月",
   "start": 84.296,
   "end": 85.597,
   "id": "c40"
  },
  {
   "text": "Sushi 的 RouteProcessor2",
   "start": 85.617,
   "end": 87.561,
   "id": "c41"
  },
  {
   "text": "路由里的池子地址",
   "start": 88.548,
   "end": 90.134,
   "id": "c42"
  },
  {
   "text": "由用户填写",
   "start": 90.19,
   "end": 91.444,
   "id": "c43"
  },
  {
   "text": "攻击者填入自己的池子",
   "start": 92.44,
   "end": 94.383,
   "id": "c44"
  },
  {
   "text": "在回调里",
   "start": 94.535,
   "end": 95.431,
   "id": "c45"
  },
  {
   "text": "把任意授权过的用户设成付款人",
   "start": 95.559,
   "end": 98.336,
   "id": "c46"
  },
  {
   "text": "回调校验只问",
   "start": 99.308,
   "end": 100.597,
   "id": "c47"
  },
  {
   "text": "是不是刚才调用的地址",
   "start": 100.879,
   "end": 102.525,
   "id": "c48"
  },
  {
   "text": "没有问 它是不是真实的池子",
   "start": 103.792,
   "end": 106.39,
   "id": "c49"
  },
  {
   "text": "按公开分析",
   "start": 107.652,
   "end": 108.833,
   "id": "c50"
  },
  {
   "text": "约 330 万美元被盗",
   "start": 109.056,
   "end": 110.834,
   "id": "c51"
  },
  {
   "text": "规则是 持有授权的合约",
   "start": 111.808,
   "end": 114.073,
   "id": "c52"
  },
  {
   "text": "必须禁止任意调用目标和任意 calldata",
   "start": 114.093,
   "end": 117.216,
   "id": "c53"
  }
 ]
}