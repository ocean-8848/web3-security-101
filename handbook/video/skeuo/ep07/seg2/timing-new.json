 "lines": [
  {
   "id": "seg2-00",
   "text": "低级调用，指 call，delegatecall 和 staticcall。",
   "spoken": "低级掉用，指 call，delegatecall 和 staticcall。",
   "src": "/Users/k/Workon/Learning/web3/web3-security-101/handbook/video/skeuo/ep07/audio/lines/seg2-00.mp3",
   "start": 1.6,
   "dur": 4.392,
   "speechStart": 1.698,
   "speechEnd": 5.138
  },
  {
   "id": "seg2-01",
   "text": "它们失败时，不会自动回滚，只返回一个 false。",
   "spoken": "它们失败时，不会自动回滚，只返回一个 false。",
   "src": "/Users/k/Workon/Learning/web3/web3-security-101/handbook/video/skeuo/ep07/audio/lines/seg2-01.mp3",
   "start": 6.212,
   "dur": 4.344,
   "speechStart": 6.31,
   "speechEnd": 9.714
  },
  {
   "id": "seg2-02",
   "text": "打个比方。你让快递员送包裹，然后在登记簿上写：已送达。",
   "spoken": "打个比方。你让快递员送包裹，然后在登记簿上写：已送达。",
   "src": "/Users/k/Workon/Learning/web3/web3-security-101/handbook/video/skeuo/ep07/audio/lines/seg2-02.mp3",
   "start": 10.776,
   "dur": 6.288,
   "speechStart": 10.874,
   "speechEnd": 16.228
  },
  {
   "id": "seg2-03",
   "text": "陷阱一，不检查返回值。快递员没回话，你就当作送到了。",
   "spoken": "陷阱一，不检查返回值。快递员没回话，你就荡作送到了。",
   "src": "/Users/k/Workon/Learning/web3/web3-security-101/handbook/video/skeuo/ep07/audio/lines/seg2-03.mp3",
   "start": 17.284,
   "dur": 6.024,
   "speechStart": 17.382,
   "speechEnd": 22.474
  },
  {
   "id": "seg2-04",
   "text": "修复是接住返回的布尔值，不成功就回滚。",
   "spoken": "修复是接住返回的布尔值，不成功就回滚。",
   "src": "/Users/k/Workon/Learning/web3/web3-security-101/handbook/video/skeuo/ep07/audio/lines/seg2-04.mp3",
   "start": 23.528,
   "dur": 4.032,
   "speechStart": 23.626,
   "speechEnd": 26.721
  },
  {
   "id": "seg2-05",
   "text": "陷阱二，目标没有代码。地址是一块荒地。",
   "spoken": "陷阱二，目标没有代码。地址是一块荒地。",
   "src": "/Users/k/Workon/Learning/web3/web3-security-101/handbook/video/skeuo/ep07/audio/lines/seg2-05.mp3",
   "start": 27.78,
   "dur": 4.68,
   "speechStart": 27.878,
   "speechEnd": 31.613
  },
  {
   "id": "seg2-06",
   "text": "快递员说送到了，因为荒地不会拒收。",
   "spoken": "快递员说送到了，因为荒地不会拒收。",
   "src": "/Users/k/Workon/Learning/web3/web3-security-101/handbook/video/skeuo/ep07/audio/lines/seg2-06.mp3",
   "start": 32.68,
   "dur": 3.528,
   "speechStart": 32.778,
   "speechEnd": 35.373
  },
  {
   "id": "seg2-07",
   "text": "对无代码地址的 call，返回成功，返回数据是空的。",
   "spoken": "对无代码地址的 call，返回成功，返回数据是空的。",
   "src": "/Users/k/Workon/Learning/web3/web3-security-101/handbook/video/skeuo/ep07/audio/lines/seg2-07.mp3",
   "start": 36.428,
   "dur": 4.608,
   "speechStart": 36.526,
   "speechEnd": 40.216
  },
  {
   "id": "seg2-08",
   "text": "修复是调用之前，检查目标地址的代码长度大于 0。",
   "spoken": "修复是掉用之前，检查目标地址的代码常度大于 0。",
   "src": "/Users/k/Workon/Learning/web3/web3-security-101/handbook/video/skeuo/ep07/audio/lines/seg2-08.mp3",
   "start": 41.256,
   "dur": 5.688,
   "speechStart": 41.354,
   "speechEnd": 46.092
  },
  {
   "id": "seg2-09",
   "text": "陷阱三，返回数据炸弹。对方返回超大的数据。",
   "spoken": "陷阱三，返回数据炸弹。对方返回超大的数据。",
   "src": "/Users/k/Workon/Learning/web3/web3-security-101/handbook/video/skeuo/ep07/audio/lines/seg2-09.mp3",
   "start": 47.164,
   "dur": 5.208,
   "speechStart": 47.262,
   "speechEnd": 51.521
  },
  {
   "id": "seg2-10",
   "text": "复制进内存，耗光 gas。修复是限制复制长度。",
   "spoken": "复制进内存，耗光 gas。修复是限制复制常度。",
   "src": "/Users/k/Workon/Learning/web3/web3-security-101/handbook/video/skeuo/ep07/audio/lines/seg2-10.mp3",
   "start": 52.592,
   "dur": 5.424,
   "speechStart": 52.69,
   "speechEnd": 57.163
  },
  {
   "id": "seg2-11",
   "text": "陷阱四，gas 不足型失败。",
   "spoken": "陷阱四，gas 不足型失败。",
   "src": "/Users/k/Workon/Learning/web3/web3-security-101/handbook/video/skeuo/ep07/audio/lines/seg2-11.mp3",
   "start": 58.236,
   "dur": 3.192,
   "speechStart": 58.334,
   "speechEnd": 60.584
  },
  {
   "id": "seg2-12",
   "text": "调用方故意给刚好不够的 gas，",
   "spoken": "掉用方故意给刚好不够的 gas，",
   "src": "/Users/k/Workon/Learning/web3/web3-security-101/handbook/video/skeuo/ep07/audio/lines/seg2-12.mp3",
   "start": 61.648,
   "dur": 3.144,
   "speechStart": 61.746,
   "speechEnd": 63.96
  },
  {
   "id": "seg2-13",
   "text": "内部调用失败，外层却继续往下走。",
   "spoken": "内部掉用失败，外层却继续往下走。",
   "src": "/Users/k/Workon/Learning/web3/web3-security-101/handbook/video/skeuo/ep07/audio/lines/seg2-13.mp3",
   "start": 65.012,
   "dur": 3.672,
   "speechStart": 65.11,
   "speechEnd": 67.848
  },
  {
   "id": "seg2-14",
   "text": "修复是检查剩余 gas。关键调用失败时，整体回滚。",
   "spoken": "修复是检查剩余 gas。关键掉用失败时，整体回滚。",
   "src": "/Users/k/Workon/Learning/web3/web3-security-101/handbook/video/skeuo/ep07/audio/lines/seg2-14.mp3",
   "start": 68.904,
   "dur": 5.784,
   "speechStart": 69.002,
   "speechEnd": 73.844
  },
  {
   "id": "seg2-15",
   "text": "比喻在这里不成立：快递员一次只会出一种错。",
   "spoken": "比喻在这里不成立：快递员一次只会出一种错。",
   "src": "/Users/k/Workon/Learning/web3/web3-security-101/handbook/video/skeuo/ep07/audio/lines/seg2-15.mp3",
   "start": 74.908,
   "dur": 4.464,
   "speechStart": 75.006,
   "speechEnd": 78.565
  },
  {
   "id": "seg2-16",
   "text": "外部合约可以同时撒谎，回调，耗尽 gas。",
   "spoken": "外部合约可以同时撒谎，回掉，耗尽 gas。",
   "src": "/Users/k/Workon/Learning/web3/web3-security-101/handbook/video/skeuo/ep07/audio/lines/seg2-16.mp3",
   "start": 79.592,
   "dur": 4.272,
   "speechStart": 79.69,
   "speechEnd": 83.023
  },
  {
   "id": "seg2-17",
   "text": "现在回到 Qubit。按 SlowMist 的公开分析，根因分五步。",
   "spoken": "现在回到 Qubit。按 SlowMist 的公开分析，根因分五步。",
   "src": "/Users/k/Workon/Learning/web3/web3-security-101/handbook/video/skeuo/ep07/audio/lines/seg2-17.mp3",
   "start": 84.084,
   "dur": 5.592,
   "speechStart": 84.182,
   "speechEnd": 88.846
  },
  {
   "id": "seg2-18",
   "text": "第一步，桥给原生 ETH 配的代币地址，是零地址。",
   "spoken": "第一步，桥给原生 ETH 配的代币地址，是零地址。",
   "src": "/Users/k/Workon/Learning/web3/web3-security-101/handbook/video/skeuo/ep07/audio/lines/seg2-18.mp3",
   "start": 89.896,
   "dur": 4.992,
   "speechStart": 89.994,
   "speechEnd": 94.053
  },
  {
   "id": "seg2-19",
   "text": "ETH 存款本该走 depositETH，它会核对随交易附带的 ETH。",
   "spoken": "ETH 存款本该走 depositETH，它会核对随交易附带的 ETH。",
   "src": "/Users/k/Workon/Learning/web3/web3-security-101/handbook/video/skeuo/ep07/audio/lines/seg2-19.mp3",
   "start": 95.108,
   "dur": 5.592,
   "speechStart": 95.206,
   "speechEnd": 99.872
  },
  {
   "id": "seg2-20",
   "text": "第二步，攻击者调用普通的 deposit，传入 ETH 的资源 ID。",
   "spoken": "第二步，攻击者掉用普通的 deposit，传入 ETH 的资源 ID。",
   "src": "/Users/k/Workon/Learning/web3/web3-security-101/handbook/video/skeuo/ep07/audio/lines/seg2-20.mp3",
   "start": 100.92,
   "dur": 5.496,
   "speechStart": 101.018,
   "speechEnd": 105.565
  },
  {
   "id": "seg2-21",
   "text": "白名单检查通过。",
   "spoken": "白名单检查通过。",
   "src": "/Users/k/Workon/Learning/web3/web3-security-101/handbook/video/skeuo/ep07/audio/lines/seg2-21.mp3",
   "start": 106.636,
   "dur": 2.256,
   "speechStart": 106.734,
   "speechEnd": 108.043
  },
  {
   "id": "seg2-22",
   "text": "第三步，deposit 对零地址，执行 safeTransferFrom。",
   "spoken": "第三步，deposit 对零地址，执行 safeTransferFrom。",
   "src": "/Users/k/Workon/Learning/web3/web3-security-101/handbook/video/skeuo/ep07/audio/lines/seg2-22.mp3",
   "start": 109.112,
   "dur": 5.064,
   "speechStart": 109.21,
   "speechEnd": 113.341
  },
  {
   "id": "seg2-23",
   "text": "第四步，零地址没有代码。低级调用返回成功，返回数据是空的。",
   "spoken": "第四步，零地址没有代码。低级掉用返回成功，返回数据是空的。",
   "src": "/Users/k/Workon/Learning/web3/web3-security-101/handbook/video/skeuo/ep07/audio/lines/seg2-23.mp3",
   "start": 114.396,
   "dur": 6.6,
   "speechStart": 114.494,
   "speechEnd": 120.17
  },
  {
   "id": "seg2-24",
   "text": "旧版的安全转账库，把空返回当作成功。",
   "spoken": "旧版的安全转账库，把空返回荡作成功。",
