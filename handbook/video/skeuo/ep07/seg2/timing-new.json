  },
  {
   "text": "delegatecall",
   "start": 3.362,
   "end": 4.235,
   "id": "c2"
  },
  {
   "text": "和 staticcall",
   "start": 4.255,
   "end": 5.258,
   "id": "c3"
  },
  {
   "text": "它们失败时",
   "start": 6.26,
   "end": 7.37,
   "id": "c4"
  },
  {
   "text": "不会自动回滚",
   "start": 7.438,
   "end": 8.573,
   "id": "c5"
  },
  {
   "text": "只返回一个 false",
   "start": 8.593,
   "end": 9.834,
   "id": "c6"
  },
  {
   "text": "打个比方",
   "start": 10.824,
   "end": 11.779,
   "id": "c7"
  },
  {
   "text": "你让快递员送包裹",
   "start": 12.143,
   "end": 13.729,
   "id": "c8"
  },
  {
   "text": "然后在登记簿上写 已送达",
   "start": 13.893,
   "end": 16.348,
   "id": "c9"
  },
  {
   "text": "陷阱一 不检查返回值",
   "start": 17.332,
   "end": 19.704,
   "id": "c10"
  },
  {
   "text": "快递员没回话",
   "start": 20.067,
   "end": 21.249,
   "id": "c11"
  },
  {
   "text": "你就当作送到了",
   "start": 21.424,
   "end": 22.594,
   "id": "c12"
  },
  {
   "text": "修复是接住返回的布尔值",
   "start": 23.576,
   "end": 25.638,
   "id": "c13"
  },
  {
   "text": "不成功就回滚",
   "start": 25.659,
   "end": 26.841,
   "id": "c14"
  },
  {
   "text": "陷阱二 目标没有代码",
   "start": 27.828,
   "end": 29.938,
   "id": "c15"
  },
  {
   "text": "地址是一块荒地",
   "start": 30.313,
   "end": 31.733,
   "id": "c16"
  },
  {
   "text": "快递员说送到了",
   "start": 32.728,
   "end": 34.064,
   "id": "c17"
  },
  {
   "text": "因为荒地不会拒收",
   "start": 34.132,
   "end": 35.493,
   "id": "c18"
  },
  {
   "text": "对无代码地址的 call",
   "start": 36.476,
   "end": 38.003,
   "id": "c19"
  },
  {
   "text": "返回成功",
   "start": 38.035,
   "end": 39.003,
   "id": "c20"
  },
  {
   "text": "返回数据是空的",
   "start": 39.023,
   "end": 40.336,
   "id": "c21"
  },
  {
   "text": "修复是调用之前",
   "start": 41.304,
   "end": 42.986,
   "id": "c22"
  },
  {
   "text": "检查目标地址的代码长度大于 0",
   "start": 43.196,
   "end": 46.212,
   "id": "c23"
  },
  {
   "text": "陷阱三 返回数据炸弹",
   "start": 47.212,
   "end": 49.56,
   "id": "c24"
  },
  {
   "text": "对方返回超大的数据",
   "start": 49.935,
   "end": 51.641,
   "id": "c25"
  },
  {
   "text": "复制进内存",
   "start": 52.64,
   "end": 53.786,
   "id": "c26"
  },
  {
   "text": "耗光 gas",
   "start": 53.878,
   "end": 55.048,
   "id": "c27"
  },
  {
   "text": "修复是限制复制长度",
   "start": 55.411,
   "end": 57.283,
   "id": "c28"
  },
  {
   "text": "陷阱四 gas 不足型失败",
   "start": 58.284,
   "end": 60.704,
   "id": "c29"
  },
  {
   "text": "调用方故意给刚好不够的 gas",
