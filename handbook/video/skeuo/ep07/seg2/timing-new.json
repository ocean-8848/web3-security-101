   "start": 136.852,
   "dur": 3.696,
   "speechStart": 136.95,
   "speechEnd": 139.712
  },
  {
   "id": "seg2-28",
   "text": "每一步单独看，都说得通。",
   "spoken": "每一步单独看，都说得通。",
