 "captions": [
  {
   "text": "2022 年 1 月",
   "start": 1.651,
   "end": 3.072,
   "id": "c0"
  },
  {
   "text": "Qubit 跨链桥出了事",
   "start": 3.42,
   "end": 5.086,
   "id": "c1"
  },
  {
   "text": "以太坊这一侧",
   "start": 5.463,
   "end": 6.534,
   "id": "c2"
  },
  {
   "text": "没有收到对应的 ETH",
   "start": 6.807,
   "end": 8.537,
   "id": "c3"
  },
  {
   "text": "BNB Chain 那一侧",
   "start": 8.899,
   "end": 11.282,
   "id": "c4"
  },
  {
   "text": "却铸造出了代表 ETH 的 qXETH",
   "start": 11.359,
   "end": 14.185,
   "id": "c5"
  },
  {
   "text": "公开报道的损失",
   "start": 14.45,
   "end": 15.943,
   "id": "c6"
  },
  {
   "text": "约 8000 万美元",
   "start": 16.065,
   "end": 17.623,
   "id": "c7"
  },
  {
   "text": "桥相信了一次外部调用的结果",
   "start": 17.962,
   "end": 20.445,
   "id": "c8"
  },
  {
   "text": "先猜一道题",
   "start": 20.65,
   "end": 21.621,
   "id": "c9"
  },
  {
   "text": "合约用低级 call",
   "start": 21.91,
   "end": 23.199,
   "id": "c10"
  },
  {
   "text": "去调用一个没有代码的地址",
   "start": 23.397,
   "end": 25.478,
   "id": "c11"
  },
  {
   "text": "call 返回 true",
   "start": 25.827,
   "end": 26.805,
   "id": "c12"
  },
  {
   "text": "还是 false",
   "start": 27.072,
   "end": 27.768,
   "id": "c13"
  },
  {
   "text": "答案是 true",
   "start": 28.31,
   "end": 29.465,
   "id": "c14"
  },
  {
   "text": "而且返回数据是空的",
   "start": 29.735,
   "end": 31.348,
   "id": "c15"
  },
  {
   "text": "EVM 不会因为目标没有代码",
   "start": 31.57,
   "end": 34.251,
   "id": "c16"
  },
  {
   "text": "就让 call 失败",
   "start": 34.271,
   "end": 35.257,
   "id": "c17"
  },
  {
   "text": "如果代码把成功加空返回",
   "start": 35.645,
   "end": 38.445,
   "id": "c18"
  },
  {
   "text": "当成转账成功",
   "start": 38.585,
   "end": 40.404,
   "id": "c19"
  },
  {
   "text": "它就会记下一笔",
   "start": 40.744,
   "end": 42.114,
   "id": "c20"
  },
  {
   "text": "根本没有发生的转账",
   "start": 42.263,
   "end": 43.724,
   "id": "c21"
  },
  {
   "text": "记住一句话",
   "start": 43.99,
   "end": 45.052,
   "id": "c22"
  },
  {
   "text": "每一个外部调用",
   "start": 45.362,
   "end": 47.094,
   "id": "c23"
  },
  {
   "text": "都是把命运交给别人",
   "start": 47.275,
   "end": 49.433,
   "id": "c24"
  },
  {
   "text": "对方可能失败",
   "start": 49.83,
   "end": 51.317,
   "id": "c25"
  },
  {
   "text": "可能撒谎",
   "start": 51.421,
   "end": 52.438,
   "id": "c26"
  },
  {
   "text": "可能拖延",
   "start": 52.477,
   "end": 53.368,
   "id": "c27"
  },
  {
   "text": "也可能根本不存在",
   "start": 53.732,
   "end": 55.341,
   "id": "c28"
  }
 ]
}