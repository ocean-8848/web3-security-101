 "captions": [
  {
   "text": "外部调用的第三种后果",
   "start": 1.55,
   "end": 3.493,
   "id": "c0"
  },
  {
   "text": "是拒绝服务",
   "start": 3.518,
   "end": 4.595,
   "id": "c1"
  },
  {
   "text": "攻击者不偷钱",
   "start": 4.81,
   "end": 6.308,
   "id": "c2"
  },
  {
   "text": "而是让合约的某个功能",
   "start": 6.476,
   "end": 8.207,
   "id": "c3"
  },
  {
   "text": "长期用不了",
   "start": 8.227,
   "end": 9.29,
   "id": "c4"
  },
  {
   "text": "再猜一道题",
   "start": 9.59,
   "end": 10.483,
   "id": "c5"
  },
  {
   "text": "拍卖合约收到新出价时",
   "start": 10.983,
   "end": 12.966,
   "id": "c6"
  },
  {
   "text": "把钱直接退给上一位出价者",
   "start": 13.142,
   "end": 15.433,
   "id": "c7"
  },
  {
   "text": "上一位出价者是一个合约",
   "start": 15.82,
   "end": 17.833,
   "id": "c8"
  },
  {
   "text": "它的 receive 函数总是回滚",
   "start": 18.083,
   "end": 20.63,
   "id": "c9"
  },
  {
   "text": "新出价能成功吗",
   "start": 20.83,
   "end": 22.822,
   "id": "c10"
  },
  {
   "text": "不能",
   "start": 23.425,
   "end": 23.887,
   "id": "c11"
  },
  {
   "text": "退款失败",
   "start": 24.204,
   "end": 25.104,
   "id": "c12"
  },
  {
   "text": "让整笔新出价回滚",
   "start": 25.131,
   "end": 26.822,
   "id": "c13"
  },
  {
   "text": "它会一直占着最高出价者的位置",
   "start": 27.07,
   "end": 29.715,
   "id": "c14"
  },
  {
   "text": "换成快递",
   "start": 30.01,
   "end": 30.851,
   "id": "c15"
  },
  {
   "text": "100 个包裹",
   "start": 31.141,
   "end": 32.043,
   "id": "c16"
  },
  {
   "text": "要按顺序送完",
   "start": 32.091,
   "end": 33.155,
   "id": "c17"
  },
  {
   "text": "第 1 个被拒收",
   "start": 33.43,
   "end": 34.643,
   "id": "c18"
  },
  {
   "text": "后面 99 个都送不出去",
   "start": 34.684,
   "end": 36.685,
   "id": "c19"
  },
  {
   "text": "修复是拉取式支付",
   "start": 37.021,
   "end": 38.943,
   "id": "c20"
  },
  {
   "text": "合约只记账",
   "start": 39.017,
   "end": 40.239,
   "id": "c21"
  },
  {
   "text": "收款人自己来取",
   "start": 40.321,
   "end": 41.797,
   "id": "c22"
  },
  {
   "text": "一个人拒收",
   "start": 42.124,
   "end": 43.038,
   "id": "c23"
  },
  {
   "text": "只影响他自己",
   "start": 43.076,
   "end": 44.255,
   "id": "c24"
  },
  {
   "text": "类似的毛病",
   "start": 44.582,
   "end": 45.506,
   "id": "c25"
  },
  {
   "text": "还有几种",
   "start": 45.565,
   "end": 46.392,
   "id": "c26"
  },
  {
   "text": "遍历所有用户发奖励",
   "start": 46.729,
   "end": 48.644,
   "id": "c27"
  },
  {
   "text": "用户一多",
   "start": 48.812,
   "end": 49.583,
   "id": "c28"
  },
  {
   "text": "就超过区块 gas 上限",
   "start": 49.693,
   "end": 51.542,
   "id": "c29"
  },
  {
   "text": "改成分页",
   "start": 51.903,
   "end": 52.743,
   "id": "c30"
  },
  {
   "text": "或者用累计奖励因子",
   "start": 52.961,
   "end": 54.973,
   "id": "c31"
  },
  {
   "text": "批量分发 USDT",
   "start": 55.327,
   "end": 56.985,
   "id": "c32"
  },
  {
   "text": "其中一个地址被冻结",
   "start": 57.072,
   "end": 58.664,
   "id": "c33"
  },
  {
   "text": "整批失败",
   "start": 58.845,
   "end": 59.675,
   "id": "c34"
  },
  {
   "text": "改成逐个捕获失败 记账",
   "start": 59.93,
   "end": 62.505,
   "id": "c35"
  },
  {
   "text": "等对方来领",
   "start": 62.618,
   "end": 63.759,
   "id": "c36"
  },
  {
   "text": "要求余额严格等于记录值",
   "start": 64.083,
   "end": 66.715,
   "id": "c37"
  },
  {
   "text": "被人强制转入 1 wei",
   "start": 67.03,
   "end": 68.661,
   "id": "c38"
  },
  {
   "text": "就再也对不上",
   "start": 68.931,
   "end": 70.074,
   "id": "c39"
  },
  {
   "text": "改用大于等于",
   "start": 70.37,
   "end": 71.776,
   "id": "c40"
  },
  {
   "text": "TRON 上",
   "start": 72.03,
   "end": 72.73,
   "id": "c41"
  },
  {
   "text": "每次执行有 80 毫秒的 CPU 时间上限",
   "start": 72.994,
   "end": 76.243,
   "id": "c42"
  },
  {
   "text": "以太坊上够用的循环",
   "start": 76.584,
   "end": 78.349,
   "id": "c43"
  },
  {
   "text": "在 TRON 上可能超时",
   "start": 78.405,
   "end": 79.974,
   "id": "c44"
  },
  {
   "text": "真实案例",
   "start": 80.329,
   "end": 81.07,
   "id": "c45"
  },
  {
   "text": "2022 年 4 月",
   "start": 81.197,
   "end": 82.582,
   "id": "c46"
  },
  {
   "text": "以太坊上的 Akutars NFT",
   "start": 82.785,
   "end": 85.184,
   "id": "c47"
  },
  {
   "text": "它的推送退款",
   "start": 85.49,
   "end": 86.706,
   "id": "c48"
  },
  {
   "text": "可以被一个拒收合约卡死",
   "start": 86.836,
   "end": 88.849,
   "id": "c49"
  },
  {
   "text": "项目方提款的条件",
   "start": 89.15,
   "end": 90.813,
   "id": "c50"
  },
  {
   "text": "又比较了错误的变量",
   "start": 91.015,
   "end": 92.751,
   "id": "c51"
  },
  {
   "text": "永远不成立",
   "start": 92.948,
   "end": 93.894,
   "id": "c52"
  },
  {
   "text": "超过 11539 个 ETH",
   "start": 94.17,
   "end": 96.67,
   "id": "c53"
  },
  {
   "text": "被永久锁定",
   "start": 96.69,
   "end": 98.699,
   "id": "c54"
  },
  {
   "text": "按 BlockSec 的分析",
   "start": 98.95,
   "end": 100.627,
   "id": "c55"
  },
  {
   "text": "直接锁死资金的",
   "start": 101.186,
   "end": 102.628,
   "id": "c56"
  },
  {
   "text": "是第二个缺陷",
   "start": 102.652,
   "end": 103.85,
   "id": "c57"
  },
  {
   "text": "但第一个",
   "start": 104.146,
   "end": 105.024,
   "id": "c58"
  },
  {
   "text": "同样是一个现成的 DoS 入口",
   "start": 105.179,
   "end": 108.216,
   "id": "c59"
  }
 ]
}