 "captions": [
  {
   "text": "第二类风险",
   "start": 1.643,
   "end": 2.608,
   "id": "c0"
  },
  {
   "text": "来自代币本身",
   "start": 2.901,
   "end": 4.271,
   "id": "c1"
  },
  {
   "text": "ERC-20 只规定了接口",
   "start": 4.57,
   "end": 7.074,
   "id": "c2"
  },
  {
   "text": "没有规定行为",
   "start": 7.128,
   "end": 8.299,
   "id": "c3"
  },
  {
   "text": "常见的非标准行为 有八种",
   "start": 8.55,
   "end": 11.315,
   "id": "c4"
  },
  {
   "text": "一 transfer 不返回值",
   "start": 11.666,
   "end": 13.784,
   "id": "c5"
  },
  {
   "text": "比如以太坊上的 USDT",
   "start": 14.059,
   "end": 16.345,
   "id": "c6"
  },
  {
   "text": "用 SafeERC20 兼容",
   "start": 16.606,
   "end": 19.313,
   "id": "c7"
  },
  {
   "text": "二 transfer 成功了",
   "start": 19.55,
   "end": 21.334,
   "id": "c8"
  },
  {
   "text": "却返回 false",
   "start": 21.454,
   "end": 22.486,
   "id": "c9"
  },
  {
   "text": "这是 TRON 上的 USDT",
   "start": 22.727,
   "end": 24.571,
   "id": "c10"
  },
  {
   "text": "三 转账收税",
   "start": 24.81,
   "end": 26.489,
   "id": "c11"
  },
  {
   "text": "到账的钱",
   "start": 26.663,
   "end": 27.525,
   "id": "c12"
  },
  {
   "text": "比转出的少",
   "start": 27.649,
   "end": 28.786,
   "id": "c13"
  },
  {
   "text": "四 余额自动变化",
   "start": 29.03,
   "end": 31.111,
   "id": "c14"
  },
  {
   "text": "比如 stETH",
   "start": 31.287,
   "end": 32.682,
   "id": "c15"
  },
  {
   "text": "缓存的余额会失效",
   "start": 32.702,
   "end": 34.568,
   "id": "c16"
  },
  {
   "text": "要用份额记账",
   "start": 34.588,
   "end": 36.811,
   "id": "c17"
  },
  {
   "text": "五 黑名单和冻结",
   "start": 37.09,
   "end": 39.325,
   "id": "c18"
  },
  {
   "text": "六 可暂停",
   "start": 39.55,
   "end": 41.163,
   "id": "c19"
  },
  {
   "text": "七 转账钩子",
   "start": 41.45,
   "end": 43.24,
   "id": "c20"
  },
  {
   "text": "比如 ERC-777",
   "start": 43.389,
   "end": 45.256,
   "id": "c21"
  },
  {
   "text": "会带来重入",
   "start": 45.541,
   "end": 46.493,
   "id": "c22"
  },
  {
   "text": "八 可升级",
   "start": 46.807,
   "end": 48.301,
   "id": "c23"
  },
  {
   "text": "行为以后可能改变",
   "start": 48.444,
   "end": 50.013,
   "id": "c24"
  },
  {
   "text": "细看第二种",
   "start": 50.304,
   "end": 51.521,
   "id": "c25"
  },
  {
   "text": "OpenZeppelin 在 2026 年",
   "start": 51.7,
   "end": 54.183,
   "id": "c26"
  },
  {
   "text": "审计了 Across 协议的 TRON 部署",
   "start": 54.259,
   "end": 56.899,
   "id": "c27"
  },
  {
   "text": "TRON 上的 USDT",
   "start": 57.15,
   "end": 58.898,
   "id": "c28"
  },
  {
   "text": "转账成功时",
   "start": 58.941,
   "end": 60.006,
   "id": "c29"
  },
  {
   "text": "也返回 false",
   "start": 60.211,
   "end": 61.42,
   "id": "c30"
  },
  {
   "text": "于是",
   "start": 61.704,
   "end": 62.161,
   "id": "c31"
  },
  {
   "text": "用 safeTransfer 推送 USDT 的代码",
   "start": 62.384,
   "end": 65.124,
   "id": "c32"
  },
  {
   "text": "在 TRON 上一律回滚",
   "start": 65.325,
   "end": 67.052,
   "id": "c33"
  },
  {
   "text": "存款走拉取方向的 transferFrom",
   "start": 67.27,
   "end": 70.064,
   "id": "c34"
  },
  {
   "text": "不受影响",
   "start": 70.084,
   "end": 70.886,
   "id": "c35"
  },
  {
   "text": "症状就是",
   "start": 71.09,
   "end": 72.032,
   "id": "c36"
  },
  {
   "text": "存款正常",
   "start": 72.225,
   "end": 73.296,
   "id": "c37"
  },
  {
   "text": "提款全部失败",
   "start": 73.316,
   "end": 74.57,
   "id": "c38"
  },
  {
   "text": "修复是不读返回值",
   "start": 74.92,
   "end": 77.002,
   "id": "c39"
  },
  {
   "text": "只看接收方的余额涨了多少",
   "start": 77.186,
   "end": 79.581,
   "id": "c40"
  },
  {
   "text": "涨的正好等于金额",
   "start": 79.946,
   "end": 81.698,
   "id": "c41"
  },
  {
   "text": "才算到账",
   "start": 81.731,
   "end": 82.555,
   "id": "c42"
  },
  {
   "text": "这个方案假设不收手续费",
   "start": 82.79,
   "end": 84.927,
   "id": "c43"
  },
  {
   "text": "而 Tether 保留了开启它的能力",
   "start": 85.134,
   "end": 87.425,
   "id": "c44"
  },
  {
   "text": "再看第三种",
   "start": 87.65,
   "end": 88.832,
   "id": "c45"
  },
  {
   "text": "收税代币",
   "start": 89.09,
   "end": 90.075,
   "id": "c46"
  },
  {
   "text": "协议按参数记账",
   "start": 90.35,
   "end": 91.935,
   "id": "c47"
  },
  {
   "text": "用户说存 100",
   "start": 92.419,
   "end": 93.735,
   "id": "c48"
  },
  {
   "text": "账上就记 100",
   "start": 93.819,
   "end": 95.215,
   "id": "c49"
  },
  {
   "text": "可代币扣了税",
   "start": 95.544,
   "end": 96.946,
   "id": "c50"
  },
  {
   "text": "金库实际只收到 98",
   "start": 97.051,
   "end": 99.201,
   "id": "c51"
  },
  {
   "text": "账面比实收多出 2 枚",
   "start": 99.528,
   "end": 101.708,
   "id": "c52"
  },
  {
   "text": "这个差额",
   "start": 101.884,
   "end": 102.664,
   "id": "c53"
  },
  {
   "text": "由其他用户承担",
   "start": 102.842,
   "end": 104.153,
   "id": "c54"
  },
  {
   "text": "所有用户都这样存取",
   "start": 104.45,
   "end": 106.518,
   "id": "c55"
  },
  {
   "text": "协议就会资不抵债",
   "start": 106.724,
   "end": 108.308,
   "id": "c56"
  },
  {
   "text": "修复是按实收记账",
   "start": 108.68,
   "end": 110.515,
   "id": "c57"
  },
  {
   "text": "转账前后",
   "start": 110.946,
   "end": 111.788,
   "id": "c58"
  },
  {
   "text": "各读一次余额",
   "start": 111.808,
   "end": 112.926,
   "id": "c59"
  },
  {
   "text": "只记增量",
   "start": 113.156,
   "end": 113.996,
   "id": "c60"
  },
  {
   "text": "这一步要配合重入锁",
   "start": 114.351,
   "end": 116.427,
   "id": "c61"
  },
  {
   "text": "防止回调干扰前后两次读数",
   "start": 116.633,
   "end": 119.032,
   "id": "c62"
  },
  {
   "text": "没有一个库",
   "start": 119.27,
   "end": 120.508,
   "id": "c63"
  },
  {
   "text": "能防住所有怪代币",
   "start": 120.653,
   "end": 122.443,
   "id": "c64"
  },
  {
   "text": "审计时 先问项目方",
   "start": 122.69,
   "end": 125.301,
   "id": "c65"
  },
  {
   "text": "你们支持哪些代币",
   "start": 125.536,
   "end": 127.127,
   "id": "c66"
  },
  {
   "text": "不支持的类型",
   "start": 127.767,
   "end": 129.387,
   "id": "c67"
  },
  {
   "text": "比如收税和变基",
   "start": 129.407,
   "end": 130.775,
   "id": "c68"
  },
  {
   "text": "要显式拒绝",
   "start": 130.838,
   "end": 132.042,
   "id": "c69"
  }
 ]
}