 "captions": [
  {
   "text": "最后一类风险 是授权",
   "start": 1.647,
   "end": 3.82,
   "id": "c0"
  },
  {
   "text": "approve 允许另一个地址",
   "start": 4.191,
   "end": 6.289,
   "id": "c1"
  },
  {
   "text": "代你转出代币",
   "start": 6.492,
   "end": 7.641,
   "id": "c2"
  },
  {
   "text": "最后一道题",
   "start": 7.91,
   "end": 8.812,
   "id": "c3"
  },
  {
   "text": "Alice 授权了 Bob 100 枚",
   "start": 8.984,
   "end": 10.769,
   "id": "c4"
  },
  {
   "text": "现在想改成 50 枚",
   "start": 10.922,
   "end": 12.64,
   "id": "c5"
  },
  {
   "text": "Bob 能抢先打包自己的交易",
   "start": 13.03,
   "end": 15.509,
   "id": "c6"
  },
  {
   "text": "他最多能拿走多少",
   "start": 15.959,
   "end": 17.794,
   "id": "c7"
  },
  {
   "text": "150 枚",
   "start": 18.31,
   "end": 19.526,
   "id": "c8"
  },
  {
   "text": "他先花掉旧的 100 枚",
   "start": 20.358,
   "end": 22.063,
   "id": "c9"
  },
  {
   "text": "等新额度生效",
   "start": 22.382,
   "end": 23.644,
   "id": "c10"
  },
  {
   "text": "再花 50 枚",
   "start": 23.732,
   "end": 24.849,
   "id": "c11"
  },
  {
   "text": "这叫 approve 竞态",
   "start": 25.15,
   "end": 27.06,
   "id": "c12"
  },
  {
   "text": "缓解办法之一",
   "start": 27.29,
   "end": 28.406,
   "id": "c13"
  },
  {
   "text": "先设成 0",
   "start": 28.484,
   "end": 29.404,
   "id": "c14"
  },
  {
   "text": "看旧额度有没有被花掉",
   "start": 29.504,
   "end": 31.395,
   "id": "c15"
  },
  {
   "text": "再设新值",
   "start": 31.614,
   "end": 32.633,
   "id": "c16"
  },
  {
   "text": "之二",
   "start": 32.964,
   "end": 33.556,
   "id": "c17"
  },
  {
   "text": "用 safeDecreaseAllowance",
   "start": 33.802,
   "end": 36.021,
   "id": "c18"
  },
  {
   "text": "相对减少",
   "start": 36.041,
   "end": 37.123,
   "id": "c19"
  },
  {
   "text": "额度已被抢先花掉",
   "start": 37.36,
   "end": 39.191,
   "id": "c20"
  },
  {
   "text": "交易就回滚",
   "start": 39.402,
   "end": 40.758,
   "id": "c21"
  },
  {
   "text": "forceApprove 只解决兼容问题",
   "start": 41.01,
   "end": 44.101,
   "id": "c22"
  },
  {
   "text": "不解决竞态",
   "start": 44.284,
   "end": 45.332,
   "id": "c23"
  },
  {
   "text": "比竞态更大的风险",
   "start": 45.55,
   "end": 47.287,
   "id": "c24"
  },
  {
   "text": "是无限授权",
   "start": 47.39,
   "end": 48.614,
   "id": "c25"
  },
  {
   "text": "协议一旦被攻破",
   "start": 48.98,
   "end": 50.517,
   "id": "c26"
  },
  {
   "text": "攻击者能转走你钱包里全部的这种代币",
   "start": 50.775,
   "end": 54.177,
   "id": "c27"
  },
  {
   "text": "即使你从没把它存进协议",
   "start": 54.47,
   "end": 56.651,
   "id": "c28"
  },
  {
   "text": "钓鱼网站也盯着授权",
   "start": 57.024,
   "end": 58.848,
   "id": "c29"
  },
  {
   "text": "诱导你签 approve",
   "start": 58.968,
   "end": 60.405,
   "id": "c30"
  },
  {
   "text": "或者链下签名的 permit",
   "start": 60.547,
   "end": 62.551,
   "id": "c31"
  },
  {
   "text": "最危险的组合",
   "start": 62.83,
   "end": 64.067,
   "id": "c32"
  },
  {
   "text": "是任意调用加授权",
   "start": 64.187,
   "end": 66.111,
   "id": "c33"
  },
  {
   "text": "路由合约持有用户的授权",
   "start": 66.426,
   "end": 68.685,
   "id": "c34"
  },
  {
   "text": "又允许用户指定任意目标",
   "start": 69.042,
   "end": 71.375,
   "id": "c35"
  },
  {
   "text": "和任意 calldata",
   "start": 71.436,
   "end": 72.877,
   "id": "c36"
  },
  {
   "text": "攻击者就能让它",
   "start": 73.17,
   "end": 74.638,
   "id": "c37"
  },
  {
   "text": "调用代币的 transferFrom",
   "start": 74.737,
   "end": 76.707,
   "id": "c38"
  },
  {
   "text": "从受害者转给自己",
   "start": 76.727,
   "end": 78.646,
   "id": "c39"
  },
  {
   "text": "2023 年 4 月",
   "start": 79.017,
   "end": 80.266,
   "id": "c40"
  },
  {
   "text": "Sushi 的 RouteProcessor2",
   "start": 80.497,
   "end": 82.378,
   "id": "c41"
  },
  {
   "text": "路由里的池子地址",
   "start": 82.746,
   "end": 84.392,
   "id": "c42"
  },
  {
   "text": "由用户填写",
   "start": 84.541,
   "end": 85.596,
   "id": "c43"
  },
  {
   "text": "攻击者填入自己的池子",
   "start": 85.83,
   "end": 87.772,
   "id": "c44"
  },
  {
   "text": "在回调里",
   "start": 87.981,
   "end": 88.873,
   "id": "c45"
  },
  {
   "text": "把任意授权过的用户设成付款人",
   "start": 88.918,
   "end": 91.579,
   "id": "c46"
  },
  {
