 "captions": [
  {
   "text": "先给准确的说法",
   "start": 1.648,
   "end": 3.103,
   "id": "c0"
  },
  {
   "text": "社会工程",
   "start": 4.1,
   "end": 5.127,
   "id": "c1"
  },
  {
   "text": "就是靠欺骗或利用信任",
   "start": 5.147,
   "end": 7.162,
   "id": "c2"
  },
  {
   "text": "让人自己动手",
   "start": 7.254,
   "end": 8.46,
   "id": "c3"
  },
  {
   "text": "做攻击者需要的事",
   "start": 8.504,
   "end": 10.055,
   "id": "c4"
  },
  {
   "text": "内部人风险",
   "start": 11.04,
   "end": 12.067,
   "id": "c5"
  },
  {
   "text": "是有合法权限的人",
   "start": 12.111,
   "end": 13.674,
   "id": "c6"
  },
  {
   "text": "有意或无意地造成损失",
   "start": 13.766,
   "end": 15.805,
   "id": "c7"
  },
  {
   "text": "最贵的漏洞",
   "start": 16.804,
   "end": 17.974,
   "id": "c8"
  },
  {
   "text": "常常不在合约里",
   "start": 18.066,
   "end": 19.414,
   "id": "c9"
  },
  {
   "text": "而在员工的电脑上",
   "start": 19.649,
   "end": 21.045,
   "id": "c10"
  },
  {
   "text": "攻击者不去破解多签合约",
   "start": 22.016,
   "end": 23.948,
   "id": "c11"
  },
  {
   "text": "他让一个签名人",
   "start": 24.087,
   "end": 25.317,
   "id": "c12"
  },
  {
   "text": "在自己电脑上打开一个文件",
   "start": 25.337,
   "end": 27.305,
   "id": "c13"
  },
  {
   "text": "之后 这台电脑上显示的一切",
   "start": 28.284,
   "end": 30.977,
   "id": "c14"
  },
  {
   "text": "都可能是假的",
   "start": 31.069,
   "end": 32.18,
   "id": "c15"
  },
  {
   "text": "打个比方",
   "start": 33.16,
   "end": 34.068,
   "id": "c16"
  },
  {
   "text": "金库有三道门",
   "start": 34.16,
   "end": 35.461,
   "id": "c17"
  },
  {
   "text": "三个人各管一把钥匙",
   "start": 35.588,
   "end": 37.08,
   "id": "c18"
  },
  {
   "text": "窃贼不撬门",
   "start": 38.06,
   "end": 39.265,
   "id": "c19"
  },
  {
   "text": "他给三个掌钥人",
   "start": 39.333,
   "end": 40.563,
   "id": "c20"
  },
  {
   "text": "各寄了一封老同事的来信",
   "start": 40.607,
   "end": 42.325,
   "id": "c21"
  },
  {
   "text": "信纸上涂了药",
   "start": 43.32,
   "end": 44.537,
   "id": "c22"
  },
  {
   "text": "读过信的人",
   "start": 44.665,
   "end": 45.692,
   "id": "c23"
  },
  {
   "text": "第二天会记错自己开的是哪道门",
   "start": 45.796,
   "end": 48.501,
   "id": "c24"
  },
  {
   "text": "比喻在这里不成立",
   "start": 49.468,
   "end": 50.84,
   "id": "c25"
  },
  {
   "text": "真实的攻击者",
   "start": 51.003,
   "end": 52.197,
   "id": "c26"
  },
  {
   "text": "不需要同时骗三个人",
   "start": 52.265,
   "end": 53.84,
   "id": "c27"
  },
  {
   "text": "签名人的电脑都运行同一个前端",
   "start": 54.824,
   "end": 57.363,
   "id": "c28"
  },
  {
   "text": "攻破其中几台",
   "start": 57.466,
   "end": 58.732,
   "id": "c29"
  },
  {
   "text": "再配合篡改前端",
   "start": 58.907,
   "end": 60.316,
   "id": "c30"
  },
  {
   "text": "就可能凑够门槛",
   "start": 60.336,
   "end": 61.66,
   "id": "c31"
  },
  {
   "text": "攻击者能控制的",
   "start": 62.652,
   "end": 64.095,
   "id": "c32"
  },
  {
   "text": "通常是这五样东西",
   "start": 64.164,
   "end": 65.607,
   "id": "c33"
  },
  {
   "text": "一个假身份",
   "start": 66.592,
   "end": 67.726,
   "id": "c34"
  },
  {
   "text": "冒充招聘者 前同事",
   "start": 67.758,
   "end": 69.904,
   "id": "c35"
  },
  {
   "text": "合作方或者记者",
   "start": 70.08,
   "end": 71.821,
   "id": "c36"
  },
  {
   "text": "一个任务",
   "start": 72.788,
   "end": 73.6,
   "id": "c37"
  },
  {
   "text": "比如测试题",
   "start": 73.621,
   "end": 74.827,
   "id": "c38"
  },
  {
   "text": "代码作业",
   "start": 74.883,
   "end": 75.731,
   "id": "c39"
  },
  {
   "text": "一份复盘 PDF",
   "start": 75.764,
   "end": 77.422,
   "id": "c40"
  },
  {
   "text": "一个会议",
   "start": 78.408,
   "end": 79.328,
   "id": "c41"
  },
  {
   "text": "比如假会议软件",
   "start": 79.408,
   "end": 80.863,
   "id": "c42"
  },
  {
   "text": "或者远程控制请求",
   "start": 80.884,
   "end": 82.518,
   "id": "c43"
  },
  {
   "text": "一笔钱 用来收买客服或外包人员",
   "start": 83.5,
   "end": 86.598,
   "id": "c44"
  },
  {
   "text": "还有一个被雇用的身份",
   "start": 87.584,
   "end": 89.027,
   "id": "c45"
  },
  {
   "text": "冒名应聘远程岗位",
   "start": 89.119,
   "end": 90.789,
   "id": "c46"
  },
  {
   "text": "公开通报显示",
   "start": 91.788,
   "end": 93.041,
   "id": "c47"
  },
  {
   "text": "朝鲜相关组织在这类攻击中最活跃",
   "start": 93.157,
   "end": 95.803,
   "id": "c48"
  },
  {
   "text": "但手法本身被各类犯罪团伙复用",
   "start": 96.784,
   "end": 99.573,
   "id": "c49"
  },
  {
   "text": "防御不该只盯着一个组织",
   "start": 99.796,
   "end": 101.739,
   "id": "c50"
  }
 ]
}