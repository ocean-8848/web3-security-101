 "captions": [
  {
   "text": "普通用户也会遇到同样的手法",
   "start": 1.648,
   "end": 4.079,
   "id": "c0"
  },
  {
   "text": "招聘者让你下载项目",
   "start": 5.06,
   "end": 6.611,
   "id": "c1"
  },
  {
   "text": "运行脚本",
   "start": 6.655,
   "end": 7.599,
   "id": "c2"
  },
  {
   "text": "安装会议软件",
   "start": 7.774,
   "end": 8.992,
   "id": "c3"
  },
  {
   "text": "先停下来",
   "start": 9.143,
   "end": 10.051,
   "id": "c4"
  },
  {
   "text": "不在存放钱包的电脑上",
   "start": 11.04,
   "end": 12.805,
   "id": "c5"
  },
  {
   "text": "运行陌生项目",
   "start": 12.98,
   "end": 14.234,
   "id": "c6"
  },
  {
   "text": "打开陌生文件",
   "start": 14.254,
   "end": 15.424,
   "id": "c7"
  },
  {
   "text": "会议里 拒绝任何远程控制请求",
   "start": 16.42,
   "end": 19.244,
   "id": "c8"
  },
  {
   "text": "客服主动联系你",
   "start": 20.24,
   "end": 21.648,
   "id": "c9"
  },
  {
   "text": "说账户有风险",
   "start": 21.752,
   "end": 23.029,
   "id": "c10"
  },
  {
   "text": "要你转移资产",
   "start": 23.168,
   "end": 24.291,
   "id": "c11"
  },
  {
   "text": "一律挂断",
   "start": 24.394,
   "end": 25.231,
   "id": "c12"
  },
  {
   "text": "再从官方 App 里联系客服",
   "start": 25.275,
   "end": 27.338,
   "id": "c13"
  },
  {
   "text": "如果你是签名人",
   "start": 28.308,
   "end": 29.68,
   "id": "c14"
  },
  {
   "text": "今天就把聊天软件",
   "start": 29.808,
   "end": 31.228,
   "id": "c15"
  },
  {
   "text": "从签名设备上删掉",
   "start": 31.272,
   "end": 32.847,
   "id": "c16"
  },
  {
   "text": "如果你是开发者",
   "start": 33.832,
   "end": 35.085,
   "id": "c17"
  },
  {
   "text": "陌生项目一律先在隔离环境里打开",
   "start": 35.26,
   "end": 37.847,
   "id": "c18"
  },
  {
   "text": "如果你负责团队",
   "start": 38.828,
   "end": 40.069,
   "id": "c19"
  },
  {
   "text": "查一遍离职清单",
   "start": 40.125,
   "end": 41.45,
   "id": "c20"
  },
  {
   "text": "看它有没有覆盖边缘权限",
   "start": 41.744,
   "end": 44.021,
   "id": "c21"
  },
  {
   "text": "回到开头的题",
   "start": 45.0,
   "end": 46.396,
   "id": "c22"
  },
  {
   "text": "作业仓库靠的是安装脚本",
   "start": 47.38,
   "end": 49.502,
   "id": "c23"
  },
  {
   "text": "安装步骤运行了混淆的命令",
   "start": 49.618,
   "end": 51.645,
   "id": "c24"
  },
  {
   "text": "把合法的 pyenv 组件换成了恶意版本",
   "start": 51.761,
   "end": 54.573,
   "id": "c25"
  },
  {
   "text": "当时的终端防护没有发现",
   "start": 55.568,
   "end": 57.523,
   "id": "c26"
  },
  {
   "text": "在工作电脑上运行外部代码",
   "start": 57.71,
   "end": 60.071,
   "id": "c27"
  },
  {
   "text": "这一步就够了",
   "start": 60.115,
   "end": 61.202,
   "id": "c28"
  },
  {
   "text": "而在 6 月",
   "start": 62.172,
   "end": 63.044,
   "id": "c29"
  },
  {
   "text": "另一名工程师下载过被篡改的 Homebrew",
   "start": 63.195,
   "end": 66.246,
   "id": "c30"
  },
  {
   "text": "Binance 当时就发现并清理了这台设备",
   "start": 66.362,
   "end": 69.234,
   "id": "c31"
  },
  {
   "text": "但报告称",
   "start": 70.216,
   "end": 71.183,
   "id": "c32"
  },
  {
   "text": "攻击者由此了解了工程师的角色和同事",
   "start": 71.382,
   "end": 74.386,
   "id": "c33"
  },
  {
   "text": "一次清理完成",
   "start": 75.38,
   "end": 76.812,
   "id": "c34"
  },
  {
   "text": "不代表威胁结束",
   "start": 76.844,
   "end": 78.228,
   "id": "c35"
  },
  {
   "text": "攻击者先攻破人",
   "start": 79.224,
   "end": 80.667,
   "id": "c36"
  },
  {
   "text": "防线就要设计成",
   "start": 80.736,
   "end": 82.06,
   "id": "c37"
  },
  {
   "text": "一个人被攻破",
   "start": 82.116,
   "end": 83.286,
   "id": "c38"
  },
  {
   "text": "也转不走钱",
   "start": 83.366,
   "end": 84.358,
   "id": "c39"
  },
  {
   "text": "下一集讲人身与账号安全",
   "start": 85.324,
   "end": 87.434,
   "id": "c40"
  }
 ]
