 "captions": [
  {
   "text": "先给一句准确的说法",
   "start": 1.55,
   "end": 3.268,
   "id": "c0"
  },
  {
   "text": "追回的窗口",
   "start": 3.624,
   "end": 4.606,
   "id": "c1"
  },
  {
   "text": "以小时计",
   "start": 4.626,
   "end": 5.609,
   "id": "c2"
  },
  {
   "text": "头几个小时里",
   "start": 5.83,
   "end": 6.886,
   "id": "c3"
  },
  {
   "text": "被盗的钱",
   "start": 6.948,
   "end": 7.716,
   "id": "c4"
  },
  {
   "text": "还是可冻结的稳定币",
   "start": 8.068,
   "end": 9.799,
   "id": "c5"
  },
  {
   "text": "是交易所里的充值",
   "start": 9.912,
   "end": 11.511,
   "id": "c6"
  },
  {
   "text": "或者是链上可以暂停的合约份额",
   "start": 11.692,
   "end": 14.535,
   "id": "c7"
  },
  {
   "text": "几个小时之后",
   "start": 14.77,
   "end": 15.838,
   "id": "c8"
  },
  {
   "text": "它会变成跨链后的原生币",
   "start": 16.042,
   "end": 18.11,
   "id": "c9"
  },
  {
   "text": "混币器里的存款",
   "start": 18.298,
   "end": 19.618,
   "id": "c10"
  },
  {
   "text": "或者场外交易的现金",
   "start": 19.69,
   "end": 21.381,
   "id": "c11"
  },
  {
   "text": "这里有两个动作",
   "start": 21.63,
   "end": 22.95,
   "id": "c12"
  },
  {
   "text": "资金追踪",
   "start": 23.21,
   "end": 24.117,
   "id": "c13"
  },
  {
   "text": "是沿着链上交易",
   "start": 24.228,
   "end": 25.82,
   "id": "c14"
  },
  {
   "text": "跟踪钱的去向",
   "start": 25.847,
   "end": 27.043,
   "id": "c15"
  },
  {
   "text": "冻结 是由发行方",
   "start": 27.447,
   "end": 29.416,
   "id": "c16"
  },
  {
   "text": "交易所或链上机制",
   "start": 29.472,
   "end": 31.661,
   "id": "c17"
  },
  {
   "text": "阻止某个地址转出资产",
   "start": 31.826,
   "end": 33.852,
   "id": "c18"
  },
  {
   "text": "打个比方",
   "start": 34.224,
   "end": 34.878,
   "id": "c19"
  },
  {
   "text": "抢劫发生后",
   "start": 35.409,
   "end": 36.566,
   "id": "c20"
  },
  {
   "text": "警方在城市的每个出口设卡",
   "start": 36.824,
   "end": 39.265,
   "id": "c21"
  },
  {
   "text": "出口就是稳定币发行方 交易所",
   "start": 39.646,
   "end": 43.003,
   "id": "c22"
  },
  {
   "text": "跨链桥和混币器",
   "start": 43.27,
   "end": 45.236,
   "id": "c23"
  },
  {
   "text": "设卡越早",
   "start": 45.626,
   "end": 46.744,
   "id": "c24"
  },
  {
   "text": "拦住的车越多",
   "start": 46.972,
   "end": 48.344,
   "id": "c25"
  },
  {
   "text": "劫匪一旦开上国道",
   "start": 48.63,
   "end": 50.23,
   "id": "c26"
  },
  {
   "text": "换了车牌",
   "start": 50.298,
   "end": 51.123,
   "id": "c27"
  },
  {
   "text": "再拦就很难了",
   "start": 51.228,
   "end": 52.641,
   "id": "c28"
  },
  {
   "text": "这个比方有一处不成立",
   "start": 53.023,
   "end": 54.694,
   "id": "c29"
  },
  {
   "text": "链上的出口",
   "start": 55.08,
   "end": 56.083,
   "id": "c30"
  },
  {
   "text": "大多不归任何警察管",
   "start": 56.209,
   "end": 57.771,
   "id": "c31"
  },
  {
   "text": "去中心化的跨链桥",
   "start": 58.104,
   "end": 59.983,
   "id": "c32"
  },
  {
   "text": "混币器和交易所",
   "start": 60.139,
   "end": 61.763,
   "id": "c33"
  },
  {
   "text": "没有义务配合",
   "start": 61.91,
   "end": 63.104,
   "id": "c34"
  },
  {
   "text": "能拦住的",
   "start": 63.446,
   "end": 64.504,
   "id": "c35"
  },
  {
   "text": "主要是有中心化运营方的那部分出口",
   "start": 64.599,
   "end": 67.567,
   "id": "c36"
  },
  {
   "text": "攻击者也清楚这一点",
   "start": 67.81,
   "end": 69.725,
   "id": "c37"
  },
  {
   "text": "所以路线很固定",
   "start": 69.862,
   "end": 71.308,
   "id": "c38"
  },
  {
   "text": "第一步 把稳定币换掉",
   "start": 71.652,
   "end": 73.744,
   "id": "c39"
  },
  {
   "text": "躲开发行方冻结",
   "start": 74.036,
   "end": 75.541,
   "id": "c40"
  },
  {
   "text": "第二步 分散到大量地址",
   "start": 75.77,
   "end": 78.065,
   "id": "c41"
  },
  {
   "text": "抬高追踪成本",
   "start": 78.12,
   "end": 79.485,
   "id": "c42"
  },
  {
   "text": "第三步 跨链",
   "start": 79.75,
   "end": 81.145,
   "id": "c43"
  },
  {
   "text": "或者进混币器",
   "start": 81.43,
   "end": 82.815,
   "id": "c44"
  },
  {
   "text": "切断链上的关联",
   "start": 83.028,
   "end": 84.393,
   "id": "c45"
  },
  {
   "text": "最后 通过场外交易",
   "start": 84.703,
   "end": 86.505,
   "id": "c46"
  },
  {
   "text": "或者小额分批进交易所",
   "start": 86.649,
   "end": 88.912,
   "id": "c47"
  },
  {
   "text": "换成现金",
   "start": 88.932,
   "end": 89.793,
   "id": "c48"
  },
  {
   "text": "实在走不掉 他就等",
   "start": 90.03,
   "end": 92.178,
   "id": "c49"
  },
  {
   "text": "等关注度下降",
   "start": 92.237,
   "end": 93.669,
   "id": "c50"
  },
  {
   "text": "2025 年 Bybit 被盗之后",
   "start": 94.028,
   "end": 96.21,
   "id": "c51"
  },
  {
   "text": "约 72% 的资金经 THORChain",
   "start": 96.382,
   "end": 100.243,
   "id": "c52"
  },
  {
   "text": "换成了 BTC",
   "start": 100.263,
   "end": 101.632,
   "id": "c53"
  },
  {
   "text": "约 16% 经兑换服务 eXch 兑换",
   "start": 101.951,
   "end": 105.407,
   "id": "c54"
  },
  {
   "text": "拦截点越靠前",
   "start": 105.766,
   "end": 107.264,
   "id": "c55"
  },
  {
   "text": "成功率越高",
   "start": 107.319,
   "end": 108.537,
   "id": "c56"
  }
 ]
}