 "captions": [
  {
   "text": "这些路走不走得通",
   "start": 1.648,
   "end": 3.044,
   "id": "c0"
  },
  {
   "text": "要看事发后的前 6 小时",
   "start": 3.195,
   "end": 5.27,
   "id": "c1"
  },
  {
   "text": "发现异常 先暂停",
   "start": 6.26,
   "end": 8.382,
   "id": "c2"
  },
  {
   "text": "协议暂停",
   "start": 8.402,
   "end": 9.584,
   "id": "c3"
  },
  {
   "text": "交易所暂停这条链的提币",
   "start": 9.772,
   "end": 11.632,
   "id": "c4"
  },
  {
   "text": "接着整理地址清单",
   "start": 12.624,
   "end": 14.377,
   "id": "c5"
  },
  {
   "text": "被盗地址",
   "start": 14.457,
   "end": 15.425,
   "id": "c6"
  },
  {
   "text": "攻击者地址",
   "start": 15.54,
   "end": 16.722,
   "id": "c7"
  },
  {
   "text": "已知的下一跳",
   "start": 16.79,
   "end": 17.889,
   "id": "c8"
  },
  {
   "text": "清单是所有通知的前提",
   "start": 18.868,
   "end": 20.8,
   "id": "c9"
  },
  {
   "text": "清单不准",
   "start": 20.82,
   "end": 21.776,
   "id": "c10"
  },
  {
   "text": "冻结请求就会被拒绝或延误",
   "start": 21.951,
   "end": 24.419,
   "id": "c11"
  },
  {
   "text": "然后并行通知",
   "start": 25.4,
   "end": 26.641,
   "id": "c12"
  },
  {
   "text": "不是排队通知",
   "start": 26.662,
   "end": 27.891,
   "id": "c13"
  },
  {
   "text": "稳定币发行方",
   "start": 28.884,
   "end": 30.197,
   "id": "c14"
  },
  {
   "text": "交易所风控",
   "start": 30.217,
   "end": 31.196,
   "id": "c15"
  },
  {
   "text": "跨链桥和兑换服务",
   "start": 31.241,
   "end": 32.958,
   "id": "c16"
  },
  {
   "text": "SEAL 911 这样的应急网络",
   "start": 33.003,
   "end": 35.375,
   "id": "c17"
  },
  {
   "text": "链上分析公司",
   "start": 35.396,
   "end": 36.59,
   "id": "c18"
  },
  {
   "text": "同时发出去",
   "start": 36.61,
   "end": 37.601,
   "id": "c19"
  },
  {
   "text": "先发清单",
   "start": 38.584,
   "end": 39.575,
   "id": "c20"
  },
  {
   "text": "不要等完整报告",
   "start": 39.619,
   "end": 40.861,
   "id": "c21"
  },
  {
   "text": "冻结只需要准确的地址和交易哈希",
   "start": 41.072,
   "end": 43.801,
   "id": "c22"
  },
  {
   "text": "同时做证据保全",
   "start": 44.78,
   "end": 46.426,
   "id": "c23"
  },
  {
   "text": "交易哈希 日志",
   "start": 46.458,
   "end": 48.188,
   "id": "c24"
  },
  {
   "text": "服务器镜像",
   "start": 48.232,
   "end": 49.307,
   "id": "c25"
  },
  {
   "text": "保全要在清理和恢复系统之前完成",
   "start": 50.304,
   "end": 53.628,
   "id": "c26"
  },
  {
   "text": "恢复会覆盖证据",
   "start": 53.851,
   "end": 55.212,
   "id": "c27"
  },
  {
   "text": "然后报警",
   "start": 56.212,
   "end": 57.156,
   "id": "c28"
  },
  {
   "text": "按辖区通知监管",
   "start": 57.176,
   "end": 58.763,
   "id": "c29"
  },
  {
   "text": "一小时之后",
   "start": 59.744,
   "end": 60.783,
   "id": "c30"
  },
  {
   "text": "可以在链上喊话",
   "start": 60.839,
   "end": 62.116,
   "id": "c31"
  },
  {
   "text": "提出赏金和安全港条件",
   "start": 62.172,
   "end": 64.378,
   "id": "c32"
  },
  {
   "text": "并且每小时更新地址清单",
   "start": 64.47,
   "end": 66.568,
   "id": "c33"
  },
  {
   "text": "安全港要事先写好",
   "start": 67.548,
   "end": 69.384,
   "id": "c34"
  },
  {
