   "text": "记下被盗地址",
   "start": 11.59,
   "end": 12.928,
   "id": "c5"
  },
  {
   "text": "攻击者地址",
   "start": 13.01,
   "end": 13.981,
   "id": "c6"
  },
  {
   "text": "交易哈希 时间",
   "start": 14.189,
   "end": 15.787,
   "id": "c7"
  },
  {
   "text": "和你点过的链接",
   "start": 15.969,
   "end": 17.196,
   "id": "c8"
  },
  {
   "text": "被盗的是 USDT 或 USDC",
   "start": 17.507,
   "end": 19.311,
   "id": "c9"
  },
  {
   "text": "马上联系发行方",
   "start": 19.454,
   "end": 22.087,
   "id": "c10"
  },
  {
   "text": "附上交易哈希",
   "start": 22.159,
   "end": 23.327,
   "id": "c11"
  },
  {
   "text": "钱流进了某个交易所",
   "start": 23.643,
   "end": 25.565,
   "id": "c12"
  },
  {
   "text": "就通过它的官方渠道提交冻结请求",
   "start": 25.794,
   "end": 29.15,
   "id": "c13"
  },
  {
   "text": "报警 拿到报案回执",
   "start": 29.473,
   "end": 31.973,
   "id": "c14"
  },
  {
   "text": "交易所和发行方通常需要执法请求才能冻结",
   "start": 32.22,
   "end": 36.207,
   "id": "c15"
  },
  {
   "text": "当心追回诈骗",
   "start": 36.568,
   "end": 37.768,
   "id": "c16"
  },
  {
   "text": "说能帮你追回资金",
   "start": 37.867,
   "end": 39.42,
   "id": "c17"
  },
  {
   "text": "要你先付费的人",
   "start": 39.496,
   "end": 40.981,
   "id": "c18"
  },
  {
   "text": "几乎都是诈骗",
   "start": 41.021,
   "end": 42.163,
   "id": "c19"
  },
  {
   "text": "回到开头的问题",
   "start": 42.45,
   "end": 43.772,
   "id": "c20"
  },
  {
   "text": "发行方冻结",
   "start": 43.95,
   "end": 45.437,
   "id": "c21"
  },
  {
   "text": "只能管到 USDT",
   "start": 45.632,
   "end": 47.299,
   "id": "c22"
  },
  {
   "text": "USDC 这类有发行方的代币",
   "start": 47.371,
   "end": 49.897,
   "id": "c23"
  },
  {
   "text": "BTC XRP",
   "start": 50.268,
   "end": 50.944,
   "id": "c24"
  },
  {
   "text": "SOL 是原生资产",
   "start": 50.964,
   "end": 52.838,
   "id": "c25"
  },
  {
   "text": "没有发行方",
   "start": 52.858,
   "end": 53.92,
   "id": "c26"
  },
  {
   "text": "这条路管不到它们",
   "start": 53.954,
   "end": 56.455,
   "id": "c27"
  },
  {
   "text": "所以第一批通知发给发行方",
   "start": 56.8,
   "end": 59.284,
   "id": "c28"
  },
  {
   "text": "但不能把它当成全部方案",
   "start": 59.52,
   "end": 61.673,
   "id": "c29"
  },
  {
   "text": "最有效的",
   "start": 62.06,
   "end": 62.903,
   "id": "c30"
  },
  {
   "text": "是事先设计好的暂停和延迟",
   "start": 62.939,
   "end": 65.63,
   "id": "c31"
  },
  {
   "text": "加上提前备好的地址清单和联系人",
   "start": 66.251,
   "end": 69.23,
   "id": "c32"
  },
  {
   "text": "钱被转走之后能追回多少",
   "start": 69.47,
   "end": 71.67,
   "id": "c33"
  },
  {
   "text": "大半在出事之前就定了",
   "start": 71.774,
   "end": 73.787,
   "id": "c34"
  },
  {
   "text": "下一集讲 AI 与 Web3 安全",
   "start": 74.01,
   "end": 77.438,
   "id": "c35"
  }
 ]
