 "captions": [
  {
   "text": "如果被盗的是你自己的钱",
   "start": 1.648,
   "end": 3.544,
   "id": "c0"
  },
  {
   "text": "顺序也差不多",
   "start": 3.636,
   "end": 4.889,
   "id": "c1"
  },
  {
   "text": "先撤销所有授权",
   "start": 5.876,
   "end": 7.569,
   "id": "c2"
  },
  {
   "text": "把剩下的资产转到全新的地址",
   "start": 7.709,
   "end": 10.343,
   "id": "c3"
  },
  {
   "text": "用新助记词 新设备",
   "start": 10.376,
   "end": 12.462,
   "id": "c4"
  },
  {
   "text": "记下被盗地址",
   "start": 13.44,
   "end": 14.669,
   "id": "c5"
  },
  {
   "text": "攻击者地址",
   "start": 14.702,
   "end": 15.776,
   "id": "c6"
  },
  {
   "text": "交易哈希 时间",
   "start": 15.916,
   "end": 17.788,
   "id": "c7"
  },
  {
   "text": "和你点过的链接",
   "start": 17.868,
   "end": 19.062,
   "id": "c8"
  },
  {
   "text": "被盗的是 USDT 或 USDC",
   "start": 20.044,
   "end": 22.976,
   "id": "c9"
  },
  {
   "text": "马上联系发行方",
   "start": 22.996,
   "end": 24.321,
   "id": "c10"
  },
  {
   "text": "附上交易哈希",
   "start": 24.341,
   "end": 25.499,
   "id": "c11"
  },
  {
   "text": "钱流进了某个交易所",
   "start": 26.48,
   "end": 28.079,
   "id": "c12"
  },
  {
   "text": "就通过它的官方渠道提交冻结请求",
   "start": 28.099,
   "end": 31.054,
   "id": "c13"
  },
  {
   "text": "报警 拿到报案回执",
   "start": 32.052,
   "end": 34.162,
   "id": "c14"
  },
  {
   "text": "交易所和发行方通常需要执法请求才能冻结",
   "start": 34.266,
   "end": 37.96,
   "id": "c15"
  },
  {
   "text": "当心追回诈骗",
   "start": 38.944,
   "end": 40.245,
   "id": "c16"
  },
  {
   "text": "说能帮你追回资金",
   "start": 40.348,
   "end": 41.756,
   "id": "c17"
  },
  {
   "text": "要你先付费的人",
   "start": 41.92,
   "end": 43.126,
   "id": "c18"
  },
  {
   "text": "几乎都是诈骗",
   "start": 43.182,
   "end": 44.245,
   "id": "c19"
  },
  {
   "text": "回到开头的问题",
   "start": 45.236,
   "end": 46.62,
   "id": "c20"
  },
  {
   "text": "发行方冻结",
   "start": 47.616,
   "end": 48.75,
   "id": "c21"
  },
  {
   "text": "只能管到 USDT",
   "start": 48.77,
   "end": 50.452,
   "id": "c22"
  },
  {
   "text": "USDC 这类有发行方的代币",
   "start": 50.592,
