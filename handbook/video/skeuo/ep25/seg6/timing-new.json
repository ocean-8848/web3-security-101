   "id": "c23"
  },
  {
   "text": "BTC XRP",
   "start": 54.196,
   "end": 55.973,
   "id": "c24"
  },
  {
   "text": "SOL 是原生资产",
   "start": 55.993,
   "end": 57.616,
   "id": "c25"
  },
  {
   "text": "没有发行方",
   "start": 57.719,
   "end": 58.735,
   "id": "c26"
  },
  {
   "text": "这条路管不到它们",
   "start": 58.767,
   "end": 60.163,
   "id": "c27"
  },
  {
   "text": "所以第一批通知发给发行方",
   "start": 61.16,
   "end": 63.556,
   "id": "c28"
  },
  {
   "text": "但不能把它当成全部方案",
   "start": 63.707,
