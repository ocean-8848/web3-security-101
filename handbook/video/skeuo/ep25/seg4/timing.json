   "id": "c2"
  },
  {
   "text": "2025 年 5 月",
   "start": 7.936,
   "end": 9.247,
   "id": "c3"
  },
  {
   "text": "Sui 上的 Cetus 被盗约 2.23 亿美元",
   "start": 9.405,
   "end": 13.189,
   "id": "c4"
  },
  {
   "text": "根因是集中流动性合约的算术溢出",
   "start": 13.398,
   "end": 16.937,
   "id": "c5"
  },
  {
   "text": "约 6300 万美元",
   "start": 17.17,
   "end": 19.415,
   "id": "c6"
  },
  {
   "text": "在冻结前跨链到了以太坊",
   "start": 19.539,
   "end": 21.936,
   "id": "c7"
  },
  {
   "text": "Sui 验证者在链上冻结了约 1.62 亿美元",
   "start": 22.284,
   "end": 26.347,
   "id": "c8"
  },
  {
   "text": "治理投票以约 90.9% 的质押权通过",
   "start": 26.748,
   "end": 30.51,
   "id": "c9"
  },
  {
   "text": "用协议升级",
   "start": 31.108,
   "end": 32.23,
   "id": "c10"
  },
  {
   "text": "把冻结的钱转进三方共管的多签",
   "start": 32.344,
   "end": 35.452,
   "id": "c11"
  },
  {
   "text": "用于赔付",
   "start": 35.489,
   "end": 36.329,
   "id": "c12"
  },
  {
   "text": "钱保住了",
   "start": 36.721,
   "end": 37.719,
   "id": "c13"
  },
  {
   "text": "争议也来了",
   "start": 37.99,
   "end": 39.253,
   "id": "c14"
  },
  {
   "text": "部分验证者公开表达了保留意见",
   "start": 39.588,
   "end": 42.217,
   "id": "c15"
  },
  {
   "text": "能冻结并改写特定地址",
   "start": 42.529,
   "end": 44.931,
   "id": "c16"
  },
  {
   "text": "也就说明",
   "start": 45.14,
   "end": 45.819,
   "id": "c17"
  },
  {
   "text": "这条链的验证者可以干预任意地址",
   "start": 46.024,
   "end": 48.909,
   "id": "c18"
  },
  {
   "text": "Binance 事件里",
   "start": 49.228,
   "end": 51.084,
   "id": "c19"
  },
  {
   "text": "Arbitrum 安全委员会也强制转走了",
   "start": 51.104,
   "end": 54.614,
   "id": "c20"
  },
  {
   "text": "攻击者钱包里的 8426 ETH",
   "start": 54.74,
   "end": 57.484,
   "id": "c21"
  },
  {
   "text": "和 7460 万 ARB",
   "start": 57.504,
   "end": 59.282,
   "id": "c22"
  },
  {
   "text": "一条是谈判与白帽赎回",
   "start": 59.608,
   "end": 62.022,
   "id": "c23"
  },
  {
   "text": "2021 年 8 月",
   "start": 62.398,
   "end": 63.67,
   "id": "c24"
  },
  {
   "text": "Poly Network 被盗约 6.1 亿美元",
   "start": 63.932,
   "end": 66.955,
   "id": "c25"
  },
  {
   "text": "攻击者自称白帽",
   "start": 67.454,
   "end": 68.891,
   "id": "c26"
  },
  {
   "text": "约 15 天内归还",
   "start": 69.189,
   "end": 70.524,
   "id": "c27"
  },
  {
   "text": "2023 年 3 月",
   "start": 70.75,
   "end": 72.007,
   "id": "c28"
  },
  {
   "text": "Euler Finance 被闪电贷攻击",
   "start": 72.135,
   "end": 74.301,
   "id": "c29"
  },
  {
   "text": "损失约 1.97 亿美元",
   "start": 74.512,
   "end": 76.628,
   "id": "c30"
  },
  {
   "text": "Euler 提出 10% 的赏金",
   "start": 76.984,
   "end": 79.589,
   "id": "c31"
  },
  {
   "text": "同时另设 100 万美元悬赏",
   "start": 79.923,
   "end": 82.448,
   "id": "c32"
  },
  {
   "text": "征集攻击者的线索",
   "start": 82.548,
   "end": 84.065,
   "id": "c33"
  },
  {
   "text": "4 月初 Euler 宣布",
   "start": 84.31,
   "end": 86.018,
   "id": "c34"
  },
  {
   "text": "全部可追回的资金已经归还",
   "start": 86.222,
   "end": 88.635,
   "id": "c35"
  },
  {
   "text": "可攻击者为什么归还",
   "start": 88.948,
   "end": 91.167,
   "id": "c36"
  },
  {
   "text": "通常不公开",
   "start": 91.311,
   "end": 92.61,
   "id": "c37"
  },
  {
   "text": "谈判不能当作预案的主线",
   "start": 92.84,
   "end": 95.144,
   "id": "c38"
  },
  {
   "text": "最后一条",
   "start": 95.39,
   "end": 96.193,
   "id": "c39"
  },
  {
   "text": "是执法与司法",
   "start": 96.352,
   "end": 97.956,
   "id": "c40"
  },
  {
   "text": "2022 年 2 月",
   "start": 98.274,
   "end": 99.686,
   "id": "c41"
  },
  {
   "text": "美国司法部逮捕两名嫌疑人调查",
   "start": 99.973,
   "end": 103.179,
   "id": "c42"
  },
  {
   "text": "人员解密了云存储里的私钥文件",
   "start": 103.199,
   "end": 106.536,
   "id": "c43"
  },
  {
   "text": "没收约 94636 BTC",
   "start": 106.79,
   "end": 110.097,
   "id": "c44"
  },
  {
   "text": "当时约 36 亿美元",
   "start": 110.338,
   "end": 110.95,
   "id": "c45"
  },
  {
   "text": "这批币是 2016 年从 Bitfinex 被盗的",
   "start": 111.049,
   "end": 116.389,
   "id": "c46"
  },
  {
   "text": "2025 年 1 月",
   "start": 116.718,
   "end": 117.987,
   "id": "c47"
  },
  {
   "text": "检方申请把币以实物返还",
   "start": 118.227,
   "end": 120.763,
   "id": "c48"
  },
  {
   "text": "法官对返还方式提出了质疑",
   "start": 121.076,
   "end": 123.808,
   "id": "c49"
  },
  {
   "text": "最终处置至今仍有争议",
   "start": 124.037,
   "end": 126.284,
   "id": "c50"
  },
  {
   "text": "从执法追回到真正返还",
   "start": 126.602,
   "end": 128.98,
   "id": "c51"
  },
  {
   "text": "可能要拖好几年",
   "start": 129.041,
   "end": 130.419,
   "id": "c52"
  }
 ]
}