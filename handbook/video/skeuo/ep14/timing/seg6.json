 "captions": [
  {
   "text": "具体到每个角色",
   "start": 1.648,
   "end": 3.02,
   "id": "c0"
  },
  {
   "text": "今天就能做的一件事",
   "start": 3.171,
   "end": 4.532,
   "id": "c1"
  },
  {
   "text": "写电路的人",
   "start": 5.516,
   "end": 6.662,
   "id": "c2"
  },
  {
   "text": "给每条约束",
   "start": 6.682,
   "end": 7.793,
   "id": "c3"
  },
  {
   "text": "写一个恶意输入的测试",
   "start": 7.873,
   "end": 9.495,
   "id": "c4"
  },
  {
   "text": "写结算合约的人",
   "start": 10.488,
   "end": 11.848,
   "id": "c5"
  },
  {
   "text": "列出证明里的每个公开输入",
   "start": 11.869,
   "end": 13.729,
   "id": "c6"
  },
  {
   "text": "看有没有字段只被读取",
   "start": 13.94,
   "end": 16.122,
   "id": "c7"
  },
  {
   "text": "没有被证明",
   "start": 16.166,
   "end": 17.134,
   "id": "c8"
  },
  {
   "text": "运营 L2 或桥的人",
   "start": 18.1,
   "end": 19.936,
   "id": "c9"
  },
  {
   "text": "验证器和电路的升级要走时间锁",
   "start": 20.04,
   "end": 22.592,
   "id": "c10"
  },
  {
   "text": "紧急权限要公开",
   "start": 22.612,
   "end": 24.103,
   "id": "c11"
  },
  {
   "text": "普通用户",
   "start": 25.088,
   "end": 25.96,
   "id": "c12"
  },
  {
   "text": "在 L2 上放大额资产前",
   "start": 25.98,
   "end": 28.055,
   "id": "c13"
  },
  {
   "text": "先在 L2BEAT 上查它的 Stage",
   "start": 28.123,
   "end": 30.519,
   "id": "c14"
  },
  {
   "text": "协议宣布弃用",
   "start": 30.883,
   "end": 32.219,
   "id": "c15"
  },
  {
   "text": "及时取回资产",
   "start": 32.252,
   "end": 33.565,
   "id": "c16"
  },
  {
   "text": "使用隐私或 ZK 协议前",
   "start": 34.548,
   "end": 36.694,
   "id": "c17"
  },
  {
   "text": "确认它有公开的电路审计和赏金计划",
   "start": 36.798,
   "end": 39.86,
   "id": "c18"
  },
  {
   "text": "回到开头的问题",
   "start": 40.84,
   "end": 42.224,
   "id": "c19"
  },
  {
   "text": "只修验证器合约",
   "start": 42.599,
   "end": 44.162,
   "id": "c20"
  },
  {
   "text": "能堵住这个洞吗",
   "start": 44.361,
   "end": 45.614,
   "id": "c21"
  },
  {
   "text": "不能",
   "start": 46.86,
   "end": 47.649,
   "id": "c22"
  },
  {
   "text": "验证器确认的",
   "start": 48.0,
   "end": 49.278,
   "id": "c23"
  },
  {
   "text": "是证明对这些公开输入成立",
   "start": 49.298,
   "end": 51.503,
   "id": "c24"
  },
  {
   "text": "漏洞在业务合约",
   "start": 52.504,
   "end": 54.126,
   "id": "c25"
  },
  {
   "text": "结算几笔交易的边界",
   "start": 54.501,
   "end": 56.112,
   "id": "c26"
  },
  {
   "text": "没有和证明绑定",
   "start": 56.204,
   "end": 57.457,
   "id": "c27"
  },
  {
   "text": "这个答案的前提 是电路",
   "start": 58.46,
   "end": 60.499,
   "id": "c28"
  },
  {
   "text": "设置和验证器都没有出错",
   "start": 60.71,
   "end": 62.868,
   "id": "c29"
  },
  {
   "text": "任何一环出错",
   "start": 63.243,
   "end": 64.58,
   "id": "c30"
  },
  {
   "text": "有效的证明也会说谎",
   "start": 64.683,
   "end": 66.353,
   "id": "c31"
  },
  {
   "text": "证明对了",
   "start": 67.344,
   "end": 68.264,
   "id": "c32"
  },
  {
   "text": "不等于电路对了",
   "start": 68.403,
   "end": 69.597,
   "id": "c33"
  },
  {
   "text": "也不等于钱算对了",
   "start": 69.641,
   "end": 70.966,
   "id": "c34"
  },
  {
   "text": "下一集讲账户抽象与新钱包的安全",
   "start": 71.932,
   "end": 74.744,
   "id": "c35"
  }
