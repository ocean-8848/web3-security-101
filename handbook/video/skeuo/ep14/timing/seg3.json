 "captions": [
  {
   "text": "电路最常见的漏洞",
   "start": 1.648,
   "end": 3.294,
   "id": "c0"
  },
  {
   "text": "叫约束不足",
   "start": 3.41,
   "end": 4.841,
   "id": "c1"
  },
  {
   "text": "某个值被算出来了",
   "start": 5.828,
   "end": 7.2,
   "id": "c2"
  },
  {
   "text": "却没有被约束",
   "start": 7.375,
   "end": 8.414,
   "id": "c3"
  },
  {
   "text": "在 Circom 语言里",
   "start": 9.384,
   "end": 10.792,
   "id": "c4"
  },
  {
   "text": "有一种写法只赋值 不约束",
   "start": 10.943,
   "end": 13.268,
   "id": "c5"
  },
  {
   "text": "另一种写法",
   "start": 13.631,
   "end": 14.694,
   "id": "c6"
  },
  {
   "text": "赋值的同时加上约束",
   "start": 14.798,
   "end": 16.48,
   "id": "c7"
  },
  {
   "text": "只用了前一种写法的信号",
   "start": 17.476,
   "end": 19.3,
   "id": "c8"
  },
  {
   "text": "恶意证明者可以填任何值",
   "start": 19.488,
   "end": 21.86,
   "id": "c9"
  },
  {
   "text": "看一个玩具例子",
   "start": 22.832,
   "end": 24.037,
   "id": "c10"
  },
  {
   "text": "账户余额是 20",
   "start": 24.413,
   "end": 25.987,
   "id": "c11"
  },
  {
   "text": "有人要提款 25",
   "start": 26.091,
   "end": 27.487,
   "id": "c12"
  },
  {
   "text": "电路要求",
   "start": 28.476,
   "end": 29.443,
   "id": "c13"
  },
  {
   "text": "新余额拆成 5 个二进制位",
   "start": 29.63,
   "end": 31.681,
   "id": "c14"
  },
  {
   "text": "每一位只能是 0 或 1",
   "start": 31.809,
   "end": 33.598,
   "id": "c15"
  },
  {
   "text": "只去掉最高位的这一条",
   "start": 34.576,
   "end": 36.246,
   "id": "c16"
  },
  {
   "text": "恶意证明者就把最高位填成 30",
   "start": 36.397,
   "end": 38.984,
   "id": "c17"
  },
  {
   "text": "电路里的数",
   "start": 39.98,
   "end": 41.007,
   "id": "c18"
  },
  {
   "text": "算到一个上限就绕回去",
   "start": 41.134,
   "end": 43.138,
   "id": "c19"
  },
  {
   "text": "填 30 之后",
   "start": 43.501,
   "end": 44.659,
   "id": "c20"
  },
  {
   "text": "等式照样成立",
   "start": 44.739,
   "end": 45.992,
   "id": "c21"
  },
  {
   "text": "余额检查被绕过",
   "start": 46.992,
   "end": 48.376,
   "id": "c22"
  },
  {
   "text": "提款 25 通过了验证",
   "start": 48.539,
   "end": 50.233,
   "id": "c23"
  },
  {
   "text": "反过来 约束写得太严",
   "start": 51.22,
   "end": 53.461,
   "id": "c24"
  },
  {
   "text": "叫过度约束",
   "start": 53.482,
   "end": 54.64,
   "id": "c25"
  },
  {
   "text": "合法的输入也无法生成证明",
   "start": 55.64,
   "end": 58.0,
   "id": "c26"
  },
  {
   "text": "结果是拒绝服务",
   "start": 58.128,
   "end": 59.976,
   "id": "c27"
  },
  {
   "text": "资金可能被锁住",
   "start": 60.14,
   "end": 61.452,
   "id": "c28"
  },
  {
   "text": "真实的例子在 2019 年",
   "start": 62.436,
   "end": 64.606,
   "id": "c29"
  },
  {
   "text": "按 Trail of Bits 的介绍",
   "start": 65.584,
   "end": 67.194,
   "id": "c30"
  },
  {
   "text": "Tornado Cash 用的一个哈希实现里",
   "start": 67.274,
   "end": 69.789,
   "id": "c31"
  },
  {
   "text": "有一个输出只被赋值",
   "start": 69.869,
   "end": 71.409,
   "id": "c32"
  },
  {
   "text": "没有被约束",
   "start": 71.429,
   "end": 72.313,
   "id": "c33"
  },
  {
   "text": "攻击者本可以伪造 Merkle 根",
   "start": 73.292,
   "end": 75.641,
   "id": "c34"
  },
  {
   "text": "取走别人的资金",
   "start": 75.661,
   "end": 76.938,
   "id": "c35"
  },
  {
   "text": "团队发现后",
   "start": 77.928,
   "end": 79.038,
   "id": "c36"
  },
  {
   "text": "抢先利用这个漏洞",
   "start": 79.19,
   "end": 80.621,
   "id": "c37"
  },
  {
   "text": "把资金转走保护起来 再修复",
   "start": 80.654,
   "end": 83.193,
   "id": "c38"
  },
  {
   "text": "没有资金被盗",
   "start": 84.172,
   "end": 85.473,
   "id": "c39"
  },
  {
   "text": "同类问题很多",
   "start": 86.456,
   "end": 87.709,
   "id": "c40"
  },
  {
   "text": "0xPARC 维护的公开漏洞清单里",
   "start": 88.084,
   "end": 90.898,
   "id": "c41"
  },
  {
   "text": "收录了大量这样的例子",
   "start": 90.918,
   "end": 92.445,
   "id": "c42"
  },
  {
   "text": "防御有三条",
   "start": 93.444,
   "end": 94.745,
   "id": "c43"
  },
  {
   "text": "用静态分析工具",
   "start": 95.728,
   "end": 97.16,
   "id": "c44"
  },
  {
   "text": "找出没有约束的信号",
   "start": 97.18,
   "end": 98.743,
   "id": "c45"
  },
  {
   "text": "关键电路",
   "start": 99.74,
   "end": 100.731,
   "id": "c46"
  },
  {
   "text": "做形式化验证",
   "start": 100.835,
   "end": 102.195,
   "id": "c47"
  },
  {
   "text": "每条约束写正反两种测试",
   "start": 103.176,
   "end": 105.393,
   "id": "c48"
  },
  {
   "text": "恶意的输入也要测",
   "start": 105.545,
   "end": 106.846,
   "id": "c49"
  }
 ]
