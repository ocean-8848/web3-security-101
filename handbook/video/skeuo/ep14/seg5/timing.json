 "captions": [
  {
   "text": "回到开头的 Aztec Connect",
   "start": 1.643,
   "end": 3.697,
   "id": "c0"
  },
  {
   "text": "它已经弃用",
   "start": 3.93,
   "end": 5.043,
   "id": "c1"
  },
  {
   "text": "管理员密钥已经放弃",
   "start": 5.351,
   "end": 7.131,
   "id": "c2"
  },
  {
   "text": "合约里却仍然有钱",
   "start": 7.274,
   "end": 9.15,
   "id": "c3"
  },
  {
   "text": "证明按 32 笔交易一组校验",
   "start": 9.43,
   "end": 12.067,
   "id": "c4"
  },
  {
   "text": "L1 上的结算",
   "start": 12.384,
   "end": 14.001,
   "id": "c5"
  },
  {
   "text": "只处理到一个字段写的笔数",
   "start": 14.221,
   "end": 16.623,
   "id": "c6"
  },
  {
   "text": "这个字段",
   "start": 17.007,
   "end": 17.711,
   "id": "c7"
  },
  {
   "text": "没有和证明绑定",
   "start": 17.839,
   "end": 19.333,
   "id": "c8"
  },
  {
   "text": "由攻击者填写",
   "start": 19.471,
   "end": 20.723,
   "id": "c9"
  },
  {
   "text": "攻击者把它设成 1",
   "start": 20.97,
   "end": 22.646,
   "id": "c10"
  },
  {
   "text": "伪造的存款不被记账",
   "start": 22.799,
   "end": 24.587,
   "id": "c11"
  },
  {
   "text": "证明仍然有效",
   "start": 24.759,
   "end": 26.091,
   "id": "c12"
  },
  {
   "text": "按 rekt.news",
   "start": 26.483,
   "end": 27.921,
   "id": "c13"
  },
  {
   "text": "SlowMist 和 Halborn 的分析",
   "start": 27.941,
   "end": 29.906,
   "id": "c14"
  },
  {
   "text": "第一名攻击者取走约 219 万美元",
   "start": 30.485,
   "end": 33.811,
   "id": "c15"
  },
  {
   "text": "第二名又取走约 8.8 万美元",
   "start": 34.276,
   "end": 36.946,
   "id": "c16"
  },
  {
   "text": "安全研究者的结论是",
   "start": 37.265,
   "end": 38.775,
   "id": "c17"
  },
  {
   "text": "问题在证明和结算之间的绑定",
   "start": 39.339,
   "end": 42.28,
   "id": "c18"
  },
  {
   "text": "所以结算要用证明里的全部公开输入",
   "start": 42.59,
   "end": 46.622,
   "id": "c19"
  },
  {
   "text": "数量 索引 长度",
   "start": 46.709,
   "end": 47.673,
   "id": "c20"
  },
  {
   "text": "也必须被证明覆盖",
   "start": 47.693,
   "end": 49.718,
   "id": "c21"
  },
  {
   "text": "已经弃用的合约",
   "start": 50.027,
   "end": 51.394,
   "id": "c22"
  },
  {
   "text": "要么彻底停用",
   "start": 51.549,
   "end": 52.991,
   "id": "c23"
  },
  {
   "text": "要么继续放在监控和赏金范围里",
   "start": 53.259,
   "end": 56.524,
   "id": "c24"
  },
  {
   "text": "同样的问题",
   "start": 56.79,
   "end": 57.838,
   "id": "c25"
  },
  {
   "text": "放大到整条 L2",
   "start": 58.004,
   "end": 59.442,
   "id": "c26"
  },
  {
   "text": "欺诈证明的 Rollup",
   "start": 59.82,
   "end": 61.31,
   "id": "c27"
  },
  {
   "text": "假设挑战期里至少有一个诚实的挑战者",
   "start": 61.525,
   "end": 65.019,
   "id": "c28"
  },
  {
   "text": "提款要等几天",
   "start": 65.096,
   "end": 66.414,
   "id": "c29"
  },
  {
   "text": "有效性证明的 Rollup",
   "start": 66.67,
   "end": 68.629,
   "id": "c30"
  },
  {
   "text": "假设证明系统可靠",
   "start": 69.109,
   "end": 70.771,
   "id": "c31"
  },
  {
   "text": "电路正确",
   "start": 70.994,
   "end": 71.848,
   "id": "c32"
  },
  {
   "text": "提款通常几小时",
   "start": 72.104,
   "end": 73.787,
   "id": "c33"
  },
  {
   "text": "两种证明系统",
   "start": 74.184,
   "end": 75.351,
   "id": "c34"
  },
  {
   "text": "都能被运营方切换或暂停",
   "start": 75.419,
   "end": 77.712,
   "id": "c35"
  },
  {
   "text": "链也能回滚",
   "start": 78.001,
   "end": 79.2,
   "id": "c36"
  },
  {
   "text": "2024 年 8 月",
   "start": 79.43,
   "end": 80.754,
   "id": "c37"
  },
  {
   "text": "OP Mainnet 的故障证明在审计中发现漏洞",
   "start": 81.086,
   "end": 84.545,
   "id": "c38"
  },
  {
   "text": "守护者把它切回许可模式",
   "start": 84.769,
   "end": 87.039,
   "id": "c39"
  },
  {
   "text": "2025 年 9 月",
   "start": 87.357,
   "end": 88.732,
   "id": "c40"
  },
  {
   "text": "Starknet 的证明层发现状态不一致",
   "start": 89.032,
   "end": 92.027,
   "id": "c41"
  },
  {
   "text": "拒绝出证明",
   "start": 92.285,
   "end": 93.423,
   "id": "c42"
  },
  {
   "text": "链回滚约 1.5 小时",
   "start": 93.779,
   "end": 95.935,
   "id": "c43"
  },
  {
   "text": "L2BEAT 的 Stages 框架",
   "start": 96.29,
   "end": 98.474,
   "id": "c44"
  },
  {
   "text": "按去掉运营方之后剩下多少保障",
   "start": 98.646,
   "end": 101.386,
   "id": "c45"
  },
  {
   "text": "给 L2 分级",
   "start": 101.406,
   "end": 102.752,
   "id": "c46"
  },
  {
   "text": "Stage 越低",
   "start": 102.97,
   "end": 103.958,
   "id": "c47"
  },
  {
   "text": "安全越依赖运营方和多签",
   "start": 104.05,
   "end": 106.226,
   "id": "c48"
  }
 ]
}