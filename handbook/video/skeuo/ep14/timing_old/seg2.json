 "captions": [
  {
   "text": "先给准确的说法",
   "start": 1.55,
   "end": 2.807,
   "id": "c0"
  },
  {
   "text": "零知识证明",
   "start": 3.142,
   "end": 4.125,
   "id": "c1"
  },
  {
   "text": "是让验证者相信一个计算结果正确",
   "start": 4.214,
   "end": 7.079,
   "id": "c2"
  },
  {
   "text": "不用自己重算",
   "start": 7.323,
   "end": 8.434,
   "id": "c3"
  },
  {
   "text": "也看不到计算的秘密输入",
   "start": 8.722,
   "end": 10.683,
   "id": "c4"
  },
  {
   "text": "要证明的计算",
   "start": 10.95,
   "end": 12.14,
   "id": "c5"
  },
  {
   "text": "先写成一组数学约束 叫电路",
   "start": 12.312,
   "end": 15.392,
   "id": "c6"
  },
  {
   "text": "满足全部约束的输入",
   "start": 15.65,
   "end": 17.32,
   "id": "c7"
  },
  {
   "text": "才算正确",
   "start": 17.397,
   "end": 18.203,
   "id": "c8"
  },
  {
   "text": "证明器在链下",
   "start": 18.53,
   "end": 19.815,
   "id": "c9"
  },
  {
   "text": "按电路生成证明",
   "start": 19.993,
   "end": 21.513,
   "id": "c10"
  },
  {
   "text": "验证器在链上",
   "start": 21.77,
   "end": 23.404,
   "id": "c11"
  },
  {
   "text": "检查证明是不是满足这个电路",
   "start": 23.461,
   "end": 26.213,
   "id": "c12"
  },
  {
   "text": "有些方案",
   "start": 26.563,
   "end": 27.316,
   "id": "c13"
  },
  {
   "text": "开工前要先做一次可信设置",
   "start": 27.597,
   "end": 29.873,
   "id": "c14"
  },
  {
   "text": "生成证明用的参数",
   "start": 29.899,
   "end": 31.585,
   "id": "c15"
  },
  {
   "text": "最后 业务合约按证明里的公开输入 去结算",
   "start": 31.81,
   "end": 35.704,
   "id": "c16"
  },
  {
   "text": "电路 设置 证明器 验证器 结算",
   "start": 36.043,
   "end": 39.915,
   "id": "c17"
  },
  {
   "text": "任何一环都可能出错",
   "start": 40.043,
   "end": 41.646,
   "id": "c18"
  },
  {
   "text": "打个比方",
   "start": 42.03,
   "end": 42.688,
   "id": "c19"
  },
  {
   "text": "考试的阅卷机",
   "start": 43.046,
   "end": 44.288,
   "id": "c20"
  },
  {
   "text": "只核对答题卡上的格子",
   "start": 44.479,
   "end": 46.266,
   "id": "c21"
  },
  {
   "text": "是不是按规则涂满",
   "start": 46.315,
   "end": 48.023,
   "id": "c22"
  },
  {
   "text": "如果出题人漏写了一条",
   "start": 48.381,
   "end": 50.291,
   "id": "c23"
  },
  {
   "text": "第 5 题只能涂一个格子",
   "start": 50.578,
   "end": 52.483,
   "id": "c24"
  },
  {
   "text": "考生把第 5 题的 4 个格子全涂上",
   "start": 52.75,
   "end": 55.884,
   "id": "c25"
  },
  {
   "text": "阅卷机照样判对",
   "start": 56.115,
   "end": 57.683,
   "id": "c26"
  },
  {
   "text": "阅卷机没坏",
   "start": 57.93,
   "end": 58.974,
   "id": "c27"
  },
  {
   "text": "是规则漏了一条",
   "start": 59.129,
   "end": 60.418,
   "id": "c28"
  },
  {
   "text": "比喻不成立的地方是",
   "start": 60.735,
   "end": 62.254,
   "id": "c29"
  },
  {
   "text": "真实的电路有成千上万条约束",
   "start": 62.41,
   "end": 65.241,
   "id": "c30"
  },
  {
   "text": "漏写一条",
   "start": 65.586,
   "end": 66.526,
   "id": "c31"
  },
  {
   "text": "从外面看不出任何异常",
   "start": 66.605,
   "end": 68.424,
   "id": "c32"
  },
  {
   "text": "只能靠审计",
   "start": 68.556,
   "end": 69.829,
   "id": "c33"
  },
  {
   "text": "形式化验证和测试去找",
   "start": 69.977,
   "end": 72.092,
   "id": "c34"
  },
  {
   "text": "所以记住一句话",
   "start": 72.27,
   "end": 73.774,
   "id": "c35"
  },
  {
   "text": "验证器只检查证明是否满足电路",
   "start": 74.01,
   "end": 77.235,
   "id": "c36"
  },
  {
   "text": "不检查电路是否写对",
   "start": 77.286,
   "end": 79.187,
   "id": "c37"
  },
  {
   "text": "先看出题这一关 电路",
   "start": 79.43,
   "end": 81.292,
   "id": "c38"
  }
 ]
