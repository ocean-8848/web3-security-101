 "captions": [
  {
   "text": "方向都写对了",
   "start": 1.55,
   "end": 3.108,
   "id": "c0"
  },
  {
   "text": "金库就安全了吗",
   "start": 3.165,
   "end": 4.53,
   "id": "c1"
  },
  {
   "text": "不一定",
   "start": 4.706,
   "end": 5.228,
   "id": "c2"
  },
  {
   "text": "ERC-4626 的份额公式是",
   "start": 5.53,
   "end": 8.574,
   "id": "c3"
  },
  {
   "text": "存入资产",
   "start": 8.812,
   "end": 9.859,
   "id": "c4"
  },
  {
   "text": "乘以总份额",
   "start": 9.977,
   "end": 11.353,
   "id": "c5"
  },
  {
   "text": "除以总资产",
   "start": 11.543,
   "end": 12.919,
   "id": "c6"
  },
  {
   "text": "结果向下取整",
   "start": 13.19,
   "end": 14.712,
   "id": "c7"
  },
  {
   "text": "这一步方向没错",
   "start": 14.895,
   "end": 16.322,
   "id": "c8"
  },
  {
   "text": "麻烦在总资产",
   "start": 16.709,
   "end": 18.043,
   "id": "c9"
  },
  {
   "text": "它通常直接读金库的代币余额",
   "start": 18.466,
   "end": 21.097,
   "id": "c10"
  },
  {
   "text": "而余额 任何人都能通过直接转账来增加",
   "start": 21.31,
   "end": 25.138,
   "id": "c11"
  },
  {
   "text": "看攻击怎么走",
   "start": 25.466,
   "end": 26.697,
   "id": "c12"
  },
  {
   "text": "金库是空的",
   "start": 26.87,
   "end": 27.972,
   "id": "c13"
  },
  {
   "text": "第一步 攻击者存入 1 wei",
   "start": 28.329,
   "end": 30.512,
   "id": "c14"
  },
  {
   "text": "拿到 1 份额",
   "start": 30.588,
   "end": 31.472,
   "id": "c15"
  },
  {
   "text": "第二步 攻击者不走存款函数",
   "start": 31.824,
   "end": 34.464,
   "id": "c16"
  },
  {
   "text": "直接往金库转入 1 万 USDC",
   "start": 34.629,
   "end": 37.204,
   "id": "c17"
  },
  {
   "text": "现在总份额只有 1",
   "start": 37.56,
   "end": 39.545,
   "id": "c18"
  },
  {
   "text": "总资产是 1 万 USDC",
   "start": 39.768,
   "end": 41.105,
   "id": "c19"
  },
  {
   "text": "再加 1 个最小单位",
   "start": 41.206,
   "end": 43.769,
   "id": "c20"
  },
  {
   "text": "第三步 受害者存入 9999 USDC",
   "start": 44.01,
   "end": 48.112,
   "id": "c21"
  },
  {
   "text": "他的份额",
   "start": 48.483,
   "end": 49.77,
   "id": "c22"
  },
  {
   "text": "是 9999 USDC 乘以 1",
   "start": 49.928,
   "end": 53.175,
   "id": "c23"
  },
  {
   "text": "除以略多于 1 万 USDC",
   "start": 53.355,
   "end": 56.061,
   "id": "c24"
  },
  {
   "text": "结果小于 1",
   "start": 56.37,
   "end": 57.734,
   "id": "c25"
  },
  {
   "text": "向下取整 是 0",
   "start": 57.764,
   "end": 59.542,
   "id": "c26"
  },
  {
   "text": "受害者的资产进了金库",
   "start": 59.79,
   "end": 62.253,
   "id": "c27"
  },
  {
   "text": "却一份也没拿到",
   "start": 62.484,
   "end": 63.933,
   "id": "c28"
  },
  {
   "text": "第四步 攻击者赎回那 1 份额",
   "start": 64.27,
   "end": 67.691,
   "id": "c29"
  },
  {
   "text": "取回约 19999 USDC",
   "start": 67.711,
   "end": 70.146,
   "id": "c30"
  },
  {
   "text": "这 1 份额",
   "start": 70.39,
   "end": 71.212,
   "id": "c31"
  },
  {
   "text": "代表了金库的全部资产",
   "start": 71.248,
   "end": 73.309,
   "id": "c32"
  },
  {
   "text": "受害者的存款",
   "start": 73.807,
   "end": 75.056,
   "id": "c33"
  },
  {
   "text": "等于捐给了它",
   "start": 75.096,
   "end": 76.51,
   "id": "c34"
  },
  {
   "text": "攻击者通常会抢跑受害者的第一笔存款交易",
   "start": 76.865,
   "end": 80.39,
   "id": "c35"
  },
  {
   "text": "攻击成本",
   "start": 80.767,
   "end": 81.603,
   "id": "c36"
  },
  {
   "text": "就是捐赠额",
   "start": 81.623,
   "end": 82.603,
   "id": "c37"
  },
  {
   "text": "受害者的存款接近捐赠额",
   "start": 82.813,
   "end": 85.055,
   "id": "c38"
  },
  {
   "text": "攻击就有利可图",
   "start": 85.141,
   "end": 86.711,
   "id": "c39"
  },
  {
   "text": "成立条件也要说清",
   "start": 86.97,
   "end": 88.673,
   "id": "c40"
  },
  {
   "text": "金库必须几乎是空的",
   "start": 88.89,
   "end": 90.873,
   "id": "c41"
  },
  {
   "text": "金库规模越大",
   "start": 91.206,
   "end": 92.47,
   "id": "c42"
  },
  {
   "text": "攻击成本越高",
   "start": 92.49,
   "end": 93.678,
   "id": "c43"
  },
  {
   "text": "换成披萨店",
   "start": 93.89,
   "end": 94.948,
   "id": "c44"
  },
  {
   "text": "第一个顾客买下整张披萨",
   "start": 95.124,
   "end": 97.117,
   "id": "c45"
  },
  {
   "text": "只切成 1 块",
   "start": 97.359,
   "end": 98.366,
   "id": "c46"
  },
  {
   "text": "然后往盒子里偷偷塞进 100 张披萨",
   "start": 98.683,
   "end": 102.249,
   "id": "c47"
  },
  {
   "text": "下一个顾客付了 99 张的钱",
   "start": 102.49,
   "end": 105.156,
   "id": "c48"
