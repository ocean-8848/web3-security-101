 "captions": [
  {
   "text": "怎么防",
   "start": 1.55,
   "end": 2.388,
   "id": "c0"
  },
  {
   "text": "有四种做法",
   "start": 2.57,
   "end": 3.83,
   "id": "c1"
  },
  {
   "text": "第一 虚拟份额加偏移",
   "start": 4.263,
   "end": 6.24,
   "id": "c2"
  },
  {
   "text": "OpenZeppelin 从 4.9 版起提供",
   "start": 6.26,
   "end": 9.777,
   "id": "c3"
  },
  {
   "text": "计算份额时",
   "start": 10.165,
   "end": 11.168,
   "id": "c4"
  },
  {
   "text": "总份额加上 10 的偏移次方",
   "start": 11.227,
   "end": 13.999,
   "id": "c5"
  },
  {
   "text": "总资产加上 1",
   "start": 14.054,
   "end": 15.639,
   "id": "c6"
  },
  {
   "text": "攻击者想造成同样的损失",
   "start": 15.89,
   "end": 18.029,
   "id": "c7"
  },
  {
   "text": "需要捐赠 10 的偏移次方倍的资金",
   "start": 18.232,
   "end": 20.955,
   "id": "c8"
  },
  {
   "text": "第二 初始存款销毁",
   "start": 21.331,
   "end": 23.379,
   "id": "c9"
  },
  {
   "text": "部署时先存入一笔",
   "start": 23.606,
   "end": 25.295,
   "id": "c10"
  },
  {
   "text": "把份额发给死地址",
   "start": 25.346,
   "end": 27.055,
   "id": "c11"
  },
  {
   "text": "这样金库永远不会是空的",
   "start": 27.387,
   "end": 29.632,
   "id": "c12"
  },
  {
   "text": "Uniswap V2 也是这个思路",
   "start": 30.01,
   "end": 32.219,
   "id": "c13"
  },
  {
   "text": "首次添加流动性时",
   "start": 32.469,
   "end": 34.149,
   "id": "c14"
  },
  {
   "text": "永久锁定 1000 份 LP 代币",
   "start": 34.25,
   "end": 36.928,
   "id": "c15"
  },
  {
   "text": "第三 内部记账",
   "start": 37.17,
   "end": 38.629,
   "id": "c16"
  },
  {
   "text": "用状态变量记录总资产",
   "start": 38.916,
   "end": 40.988,
   "id": "c17"
  },
  {
   "text": "不读余额",
   "start": 41.081,
   "end": 41.884,
   "id": "c18"
  },
  {
   "text": "捐赠多少",
   "start": 42.11,
   "end": 43.123,
   "id": "c19"
  },
  {
   "text": "都无法改变份额价格",
   "start": 43.267,
   "end": 44.931,
   "id": "c20"
  },
  {
   "text": "第四 最小份额检查",
   "start": 45.31,
   "end": 47.433,
   "id": "c21"
  },
  {
   "text": "份额是 0 就回滚",
   "start": 47.703,
   "end": 49.383,
   "id": "c22"
  },
  {
   "text": "用户也可以设最少到账份额",
   "start": 49.637,
   "end": 52.096,
   "id": "c23"
  },
  {
   "text": "这样受害者的交易会回滚",
   "start": 52.406,
   "end": 54.965,
   "id": "c24"
  },
  {
   "text": "而不是换回 0 份额",
   "start": 55.175,
   "end": 56.839,
   "id": "c25"
  },
  {
   "text": "修好了 怎么证明",
   "start": 57.09,
   "end": 58.649,
   "id": "c26"
  },
  {
   "text": "要两个结果",
   "start": 58.938,
   "end": 59.864,
   "id": "c27"
  },
  {
   "text": "漏洞版上",
   "start": 60.21,
   "end": 61.044,
   "id": "c28"
  },
  {
   "text": "受害者损失资产",
   "start": 61.25,
   "end": 62.834,
   "id": "c29"
  },
  {
   "text": "修复版上",
   "start": 63.027,
   "end": 63.924,
   "id": "c30"
  },
  {
   "text": "攻击无利可图",
   "start": 64.15,
   "end": 65.523,
   "id": "c31"
  },
  {
   "text": "最后一个案例",
   "start": 65.861,
   "end": 66.83,
   "id": "c32"
  },
  {
   "text": "是另一种失误",
   "start": 66.85,
   "end": 68.05,
   "id": "c33"
  },
  {
   "text": "2021 年 4 月",
   "start": 68.31,
   "end": 69.724,
   "id": "c34"
  },
  {
   "text": "BNB Chain 上的 Uranium",
   "start": 69.921,
   "end": 71.645,
   "id": "c35"
  },
  {
   "text": "Finance",
   "start": 71.665,
   "end": 72.453,
   "id": "c36"
  },
  {
   "text": "分叉自 Uniswap V2",
   "start": 72.493,
   "end": 74.3,
   "id": "c37"
  },
  {
   "text": "按公开分析",
   "start": 74.63,
   "end": 75.743,
   "id": "c38"
  },
  {
   "text": "开发者把手续费从百分之 0.3",
   "start": 76.006,
   "end": 79.096,
   "id": "c39"
  },
  {
   "text": "改成了百分之 0.16",
   "start": 79.204,
   "end": 81.194,
   "id": "c40"
  },
  {
   "text": "余额检查左边的放大系数",
   "start": 81.565,
   "end": 83.594,
   "id": "c41"
  },
  {
   "text": "从 1000 改成了 1 万",
   "start": 83.86,
   "end": 85.478,
   "id": "c42"
  },
  {
   "text": "右边那一处",
   "start": 85.77,
   "end": 86.776,
   "id": "c43"
  },
  {
   "text": "仍是 1000 的平方 漏改了",
   "start": 87.061,
   "end": 89.93,
   "id": "c44"
  },
  {
   "text": "左边被放大了 100 倍",
   "start": 90.23,
   "end": 91.909,
   "id": "c45"
  },
  {
   "text": "右边没有",
   "start": 92.029,
   "end": 92.861,
   "id": "c46"
  },
  {
   "text": "不变量 x 乘 y 不小于 k",
   "start": 93.09,
   "end": 95.504,
   "id": "c47"
  },
  {
   "text": "退化成了不小于 k 的百分之一",
   "start": 95.58,
   "end": 98.295,
   "id": "c48"
  },
  {
   "text": "攻击者只投入极少量代币",
   "start": 98.59,
   "end": 100.894,
   "id": "c49"
  },
  {
   "text": "就换出了池子约百分之 99 的储备",
   "start": 100.993,
   "end": 103.807,
   "id": "c50"
  },
  {
   "text": "按公开报道",
   "start": 104.186,
   "end": 105.292,
   "id": "c51"
  },
  {
   "text": "损失约 5000 万美元",
   "start": 105.623,
   "end": 107.732,
   "id": "c52"
  },
  {
   "text": "教训是 修改过的分叉代码",
   "start": 107.99,
   "end": 111.185,
   "id": "c53"
  },
  {
   "text": "等于新代码",
   "start": 111.319,
   "end": 112.773,
   "id": "c54"
  },
  {
   "text": "改过的常数",
   "start": 113.103,
   "end": 114.093,
   "id": "c55"
  },
  {
   "text": "每一个使用位置",
   "start": 114.34,
   "end": 115.581,
   "id": "c56"
  },
  {
   "text": "都要同步",
   "start": 115.601,
   "end": 116.329,
   "id": "c57"
  }
 ]
}