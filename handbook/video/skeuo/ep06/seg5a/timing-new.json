 "captions": [
  {
   "text": "怎么防",
   "start": 1.648,
   "end": 2.341,
   "id": "c0"
  },
  {
   "text": "有四种做法",
   "start": 2.693,
   "end": 3.815,
   "id": "c1"
  },
  {
   "text": "第一 虚拟份额加偏移",
   "start": 4.796,
   "end": 7.013,
   "id": "c2"
  },
  {
   "text": "OpenZeppelin 从 4.9 版起提供",
   "start": 7.388,
   "end": 9.904,
   "id": "c3"
  },
  {
   "text": "计算份额时",
   "start": 10.896,
   "end": 12.042,
   "id": "c4"
  },
  {
   "text": "总份额加上 10 的偏移次方",
   "start": 12.134,
   "end": 14.351,
   "id": "c5"
  },
  {
   "text": "总资产加上 1",
   "start": 14.443,
   "end": 15.804,
   "id": "c6"
  },
  {
   "text": "攻击者想造成同样的损失",
   "start": 16.804,
   "end": 18.843,
   "id": "c7"
  },
  {
   "text": "需要捐赠 10 的偏移次方倍的资金",
   "start": 18.899,
   "end": 21.212,
   "id": "c8"
  },
  {
   "text": "第二 初始存款销毁",
   "start": 22.208,
   "end": 24.151,
   "id": "c9"
  },
  {
   "text": "部署时先存入一笔",
   "start": 24.527,
   "end": 26.209,
   "id": "c10"
  },
  {
   "text": "把份额发给死地址",
   "start": 26.3,
   "end": 27.816,
   "id": "c11"
  },
  {
   "text": "这样金库永远不会是空的",
   "start": 28.788,
   "end": 30.612,
   "id": "c12"
  },
  {
   "text": "Uniswap V2 也是这个思路",
   "start": 31.6,
   "end": 33.853,
   "id": "c13"
  },
  {
   "text": "首次添加流动性时",
   "start": 34.028,
   "end": 35.71,
   "id": "c14"
  },
  {
   "text": "永久锁定 1000 份 LP 代币",
   "start": 35.754,
   "end": 38.031,
   "id": "c15"
  },
  {
   "text": "第三 内部记账",
   "start": 39.02,
   "end": 40.702,
   "id": "c16"
  },
  {
   "text": "用状态变量记录总资产",
   "start": 41.077,
   "end": 43.521,
   "id": "c17"
  },
  {
   "text": "不读余额",
   "start": 43.612,
   "end": 44.58,
   "id": "c18"
  },
  {
   "text": "捐赠多少",
   "start": 45.576,
   "end": 46.698,
   "id": "c19"
  },
  {
   "text": "都无法改变份额价格",
   "start": 46.73,
   "end": 48.484,
   "id": "c20"
  },
  {
   "text": "第四 最小份额检查",
   "start": 49.468,
   "end": 51.542,
   "id": "c21"
  },
  {
   "text": "份额是 0 就回滚",
   "start": 51.918,
   "end": 53.397,
   "id": "c22"
  },
  {
   "text": "用户也可以设最少到账份额",
   "start": 53.584,
   "end": 55.54,
   "id": "c23"
  },
  {
   "text": "这样受害者的交易会回滚",
   "start": 56.528,
   "end": 58.364,
   "id": "c24"
  },
  {
   "text": "而不是换回 0 份额",
   "start": 58.575,
   "end": 60.114,
   "id": "c25"
  },
  {
   "text": "修好了 怎么证明",
   "start": 61.092,
   "end": 62.738,
   "id": "c26"
  },
  {
   "text": "要两个结果",
   "start": 63.101,
   "end": 64.152,
   "id": "c27"
  },
  {
   "text": "漏洞版上",
   "start": 65.152,
   "end": 66.131,
   "id": "c28"
  },
  {
   "text": "受害者损失资产",
   "start": 66.235,
   "end": 67.857,
   "id": "c29"
  },
  {
   "text": "修复版上",
   "start": 68.233,
   "end": 69.236,
   "id": "c30"
  },
  {
   "text": "攻击无利可图",
   "start": 69.256,
   "end": 70.593,
   "id": "c31"
  },
  {
   "text": "最后一个案例",
   "start": 71.588,
   "end": 72.71,
   "id": "c32"
  },
  {
   "text": "是另一种失误",
   "start": 72.802,
   "end": 73.936,
   "id": "c33"
  },
  {
   "text": "2021 年 4 月",
   "start": 74.928,
   "end": 76.181,
   "id": "c34"
  },
  {
   "text": "BNB Chain 上的 Uranium",
   "start": 76.249,
   "end": 77.872,
   "id": "c35"
  },
  {
   "text": "Finance",
   "start": 77.892,
   "end": 78.657,
   "id": "c36"
  },
  {
   "text": "分叉自 Uniswap V2",
   "start": 78.749,
   "end": 80.598,
   "id": "c37"
  },
  {
   "text": "按公开分析",
   "start": 81.58,
   "end": 82.726,
   "id": "c38"
  },
  {
   "text": "开发者把手续费从百分之 0.3",
   "start": 83.02,
   "end": 85.595,
   "id": "c39"
  },
  {
   "text": "改成了百分之 0.16",
   "start": 85.675,
   "end": 87.25,
   "id": "c40"
  },
  {
   "text": "余额检查左边的放大系数",
   "start": 88.232,
   "end": 90.366,
   "id": "c41"
  },
  {
   "text": "从 1000 改成了 1 万",
   "start": 90.47,
   "end": 92.164,
   "id": "c42"
  },
  {
   "text": "右边那一处",
   "start": 93.132,
   "end": 94.302,
   "id": "c43"
  },
  {
   "text": "仍是 1000 的平方 漏改了",
   "start": 94.37,
   "end": 96.968,
   "id": "c44"
  },
  {
   "text": "左边被放大了 100 倍",
   "start": 97.936,
   "end": 99.558,
   "id": "c45"
  },
  {
   "text": "右边没有",
   "start": 99.733,
   "end": 100.641,
   "id": "c46"
  },
  {
   "text": "不变量 x 乘 y 不小于 k",
   "start": 101.612,
   "end": 103.96,
   "id": "c47"
  },
  {
   "text": "退化成了不小于 k 的百分之一",
   "start": 104.1,
   "end": 105.936,
   "id": "c48"
  },
  {
   "text": "攻击者只投入极少量代币",
   "start": 106.92,
   "end": 108.971,
   "id": "c49"
  },
  {
   "text": "就换出了池子约百分之 99 的储备",
   "start": 109.003,
   "end": 111.59,
   "id": "c50"
  },
  {
   "text": "按公开报道",
   "start": 112.588,
   "end": 113.686,
   "id": "c51"
  },
  {
   "text": "损失约 5000 万美元",
   "start": 113.778,
   "end": 115.65,
   "id": "c52"
  },
  {
   "text": "教训是 修改过的分叉代码",
   "start": 116.648,
   "end": 119.282,
   "id": "c53"
  },
  {
   "text": "等于新代码",
   "start": 119.302,
   "end": 120.377,
   "id": "c54"
  },
  {
   "text": "改过的常数",
   "start": 121.356,
   "end": 122.442,
   "id": "c55"
  },
  {
   "text": "每一个使用位置",
   "start": 122.653,
   "end": 123.99,
   "id": "c56"
  },
  {
   "text": "都要同步",
   "start": 124.058,
   "end": 124.883,
   "id": "c57"
  }
 ]
