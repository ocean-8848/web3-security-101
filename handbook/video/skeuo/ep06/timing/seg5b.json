 ],
 "captions": [
  {
   "text": "最后 每个人今天就能做一件事",
   "start": 1.648,
   "end": 4.151,
   "id": "c0"
  },
  {
   "text": "写合约的人",
   "start": 5.132,
   "end": 6.23,
   "id": "c1"
  },
  {
   "text": "找出每一处除法",
   "start": 6.251,
   "end": 7.635,
   "id": "c2"
  },
  {
   "text": "写下余数归谁",
   "start": 7.798,
   "end": 9.159,
   "id": "c3"
  },
  {
   "text": "审计的人",
   "start": 10.128,
   "end": 11.107,
   "id": "c4"
  },
  {
   "text": "逐个检查 unchecked 块",
   "start": 11.151,
   "end": 13.107,
   "id": "c5"
  },
  {
   "text": "类型转换",
   "start": 13.175,
   "end": 14.095,
   "id": "c6"
  },
  {
   "text": "内联汇编和移位",
   "start": 14.223,
   "end": 15.571,
   "id": "c7"
  },
  {
   "text": "做测试的人",
   "start": 16.564,
   "end": 17.627,
   "id": "c8"
  },
  {
   "text": "把同一操作重复 1000 次",
   "start": 17.647,
   "end": 19.472,
   "id": "c9"
  },
  {
   "text": "看误差流向谁",
   "start": 19.516,
   "end": 20.805,
   "id": "c10"
  },
  {
   "text": "普通用户",
   "start": 21.776,
   "end": 22.743,
   "id": "c11"
  },
  {
   "text": "别当新金库的第一个存款人",
   "start": 22.871,
   "end": 25.077,
   "id": "c12"
  },
  {
   "text": "存入后马上核对份额",
   "start": 26.076,
   "end": 28.103,
   "id": "c13"
  },
  {
   "text": "是 0 或明显偏少",
   "start": 28.478,
   "end": 30.219,
   "id": "c14"
  },
  {
   "text": "立刻停下",
   "start": 30.288,
   "end": 31.231,
   "id": "c15"
  },
  {
   "text": "跨链转账时",
   "start": 32.224,
   "end": 33.441,
   "id": "c16"
  },
  {
   "text": "核对同一代币在两条链上的精度",
   "start": 33.64,
   "end": 36.251,
   "id": "c17"
  },
  {
   "text": "回到开头的问题",
   "start": 37.244,
   "end": 38.628,
   "id": "c18"
  },
  {
   "text": "只错一点点的取整",
   "start": 39.003,
   "end": 40.542,
   "id": "c19"
  },
  {
   "text": "怎么变成约 9480 万美元的损失",
   "start": 40.717,
   "end": 43.435,
   "id": "c20"
  },
  {
   "text": "因为余数给错了人",
   "start": 44.704,
   "end": 46.1,
   "id": "c21"
  },
  {
   "text": "而且这一步",
   "start": 46.287,
   "end": 47.338,
   "id": "c22"
  },
  {
   "text": "能在一笔交易里重复很多次",
   "start": 47.418,
   "end": 49.695,
   "id": "c23"
  },
  {
   "text": "反过来 只要余数始终归协议",
   "start": 50.684,
   "end": 53.413,
   "id": "c24"
  },
  {
   "text": "重复多少次",
   "start": 53.588,
   "end": 54.806,
   "id": "c25"
  },
  {
   "text": "也抠不出钱",
   "start": 54.874,
   "end": 55.913,
   "id": "c26"
  },
  {
   "text": "下一集讲外部调用与代币兼容性",
   "start": 56.88,
   "end": 59.788,
   "id": "c27"
  }
 ]
