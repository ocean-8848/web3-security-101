 "captions": [
  {
   "text": "最后 每个人今天就能做一件事",
   "start": 1.55,
   "end": 4.459,
   "id": "c0"
  },
  {
   "text": "写合约的人",
   "start": 4.73,
   "end": 5.891,
   "id": "c1"
  },
  {
   "text": "找出每一处除法",
   "start": 5.978,
   "end": 7.435,
   "id": "c2"
  },
  {
   "text": "写下余数归谁",
   "start": 7.612,
   "end": 8.775,
   "id": "c3"
  },
  {
   "text": "审计的人",
   "start": 9.03,
   "end": 9.963,
   "id": "c4"
  },
  {
   "text": "逐个检查 unchecked 块",
   "start": 10.11,
   "end": 11.788,
   "id": "c5"
  },
  {
   "text": "类型转换",
   "start": 11.977,
   "end": 12.857,
   "id": "c6"
  },
  {
   "text": "内联汇编和移位",
   "start": 12.952,
   "end": 14.504,
   "id": "c7"
  },
  {
   "text": "做测试的人",
   "start": 14.77,
   "end": 15.856,
   "id": "c8"
  },
  {
   "text": "把同一操作重复 1000 次",
   "start": 15.876,
   "end": 17.775,
   "id": "c9"
  },
  {
   "text": "看误差流向谁",
   "start": 18.058,
   "end": 19.331,
   "id": "c10"
  },
  {
   "text": "普通用户",
   "start": 19.63,
   "end": 20.63,
   "id": "c11"
  },
  {
   "text": "别当新金库的第一个存款人",
   "start": 20.883,
   "end": 23.791,
   "id": "c12"
  },
  {
   "text": "存入后马上核对份额",
   "start": 24.09,
   "end": 26.053,
   "id": "c13"
  },
  {
   "text": "是 0 或明显偏少",
   "start": 26.187,
   "end": 28.028,
   "id": "c14"
  },
  {
   "text": "立刻停下",
   "start": 28.101,
   "end": 28.885,
   "id": "c15"
  },
  {
   "text": "跨链转账时",
   "start": 29.205,
   "end": 30.431,
   "id": "c16"
  },
  {
   "text": "核对同一代币在两条链上的精度",
   "start": 30.631,
   "end": 33.593,
   "id": "c17"
  },
  {
   "text": "回到开头的问题",
   "start": 33.81,
   "end": 35.2,
   "id": "c18"
  },
  {
   "text": "只错一点点的取整",
   "start": 35.93,
   "end": 38.651,
   "id": "c19"
  },
  {
   "text": "怎么变成约 9480 万美元的损失",
   "start": 38.832,
   "end": 42.664,
   "id": "c20"
  },
  {
   "text": "因为余数给错了人",
   "start": 43.19,
   "end": 44.632,
   "id": "c21"
  },
  {
   "text": "而且这一步",
   "start": 44.815,
   "end": 45.625,
   "id": "c22"
  },
  {
   "text": "能在一笔交易里重复很多次",
   "start": 45.855,
   "end": 48.052,
   "id": "c23"
  },
  {
   "text": "反过来 只要余数始终归协议重复多少次",
   "start": 48.29,
   "end": 52.67,
   "id": "c24"
  },
  {
   "text": "也抠不出钱",
   "start": 52.69,
   "end": 53.711,
   "id": "c25"
  },
  {
   "text": "下一集讲外部调用与代币兼容性",
   "start": 53.95,
   "end": 57.138,
   "id": "c26"
  }
 ]
}