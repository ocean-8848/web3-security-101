   "speechStart": 6.406,
   "speechEnd": 9.667
  },
  {
   "id": "seg1-02",
   "text": "这个库，是 Parity 多签钱包共用的代码。",
   "spoken": "这个库，是 Parity 多签钱包共用的代码。",
   "src": "/Users/k/Workon/Learning/web3/web3-security-101/handbook/video/skeuo/ep05/audio/lines/seg1-02.mp3",
