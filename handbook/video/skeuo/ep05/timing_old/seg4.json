 "captions": [
  {
   "text": "前面讲的",
   "start": 1.55,
   "end": 2.413,
   "id": "c0"
  },
  {
   "text": "都是合约层的权限",
   "start": 2.433,
   "end": 3.808,
   "id": "c1"
  },
  {
   "text": "账户本身",
   "start": 4.104,
   "end": 5.068,
   "id": "c2"
  },
  {
   "text": "也有权限",
   "start": 5.088,
   "end": 5.963,
   "id": "c3"
  },
  {
   "text": "以太坊的外部账户",
   "start": 6.346,
   "end": 7.795,
   "id": "c4"
  },
  {
   "text": "只有一把私钥",
   "start": 7.895,
   "end": 9.035,
   "id": "c5"
  },
  {
   "text": "TRON 不一样",
   "start": 9.367,
   "end": 10.29,
   "id": "c6"
  },
  {
   "text": "按 TRON 官方文档和安全公司的公开资料",
   "start": 10.589,
   "end": 14.39,
   "id": "c7"
  },
  {
   "text": "它的账户原生支持多重权限",
   "start": 14.57,
   "end": 17.25,
   "id": "c8"
  },
  {
   "text": "Owner 权限最高",
   "start": 17.587,
   "end": 18.843,
   "id": "c9"
  },
  {
   "text": "能修改其他权限",
   "start": 18.98,
   "end": 20.27,
   "id": "c10"
  },
  {
   "text": "包括增删签名人",
   "start": 20.383,
   "end": 21.958,
   "id": "c11"
  },
  {
   "text": "Active 管日常操作",
   "start": 22.292,
   "end": 24.202,
   "id": "c12"
  },
  {
   "text": "比如转账 质押",
   "start": 24.363,
   "end": 26.252,
   "id": "c13"
  },
  {
   "text": "调用合约",
   "start": 26.375,
   "end": 27.241,
   "id": "c14"
  },
  {
   "text": "它可以有多个",
   "start": 27.407,
   "end": 28.013,
   "id": "c15"
  },
  {
   "text": "每个可以限定操作类型",
   "start": 28.033,
   "end": 30.839,
   "id": "c16"
  },
  {
   "text": "Witness 只管超级代表",
   "start": 31.23,
   "end": 33.246,
   "id": "c17"
  },
  {
   "text": "也就是出块节点的相关操作",
   "start": 33.298,
   "end": 35.464,
   "id": "c18"
  },
  {
   "text": "每个权限有一组地址",
   "start": 35.848,
   "end": 37.974,
   "id": "c19"
  },
  {
   "text": "每个地址有权重",
   "start": 38.203,
   "end": 39.821,
   "id": "c20"
  },
  {
   "text": "权重加起来达到阈值",
   "start": 40.05,
   "end": 41.831,
   "id": "c21"
  },
  {
   "text": "操作才执行",
   "start": 41.897,
   "end": 43.047,
   "id": "c22"
  },
  {
   "text": "这套设计",
   "start": 43.407,
   "end": 44.236,
   "id": "c23"
  },
  {
   "text": "被骗子用来做多签诈骗",
   "start": 44.335,
   "end": 46.21,
   "id": "c24"
  },
  {
   "text": "第一步 受害者在假钱包或钓鱼页上",
   "start": 46.588,
   "end": 50.434,
   "id": "c25"
  },
  {
   "text": "泄露了私钥",
   "start": 50.537,
   "end": 51.582,
   "id": "c26"
  },
  {
   "text": "第二步 攻击者修改账户权限",
   "start": 51.923,
   "end": 54.496,
   "id": "c27"
  },
  {
   "text": "把 Owner 和 Active 都改成自己",
   "start": 54.645,
   "end": 57.353,
   "id": "c28"
  },
  {
   "text": "第三步 受害者还能看到余额",
   "start": 57.65,
   "end": 60.598,
   "id": "c29"
  },
  {
   "text": "但已经转不出来",
   "start": 60.747,
   "end": 61.977,
   "id": "c30"
  },
  {
   "text": "转入不需要签名",
   "start": 62.366,
   "end": 63.785,
   "id": "c31"
  },
  {
   "text": "新的 USDT",
   "start": 63.952,
   "end": 65.216,
   "id": "c32"
  },
  {
   "text": "还会继续转进来",
   "start": 65.406,
   "end": 66.628,
   "id": "c33"
  },
  {
   "text": "攻击者不急",
   "start": 66.983,
   "end": 68.114,
   "id": "c34"
  },
  {
   "text": "账户看起来正常",
   "start": 68.458,
   "end": 69.765,
   "id": "c35"
  },
  {
   "text": "他择机再全部转走",
   "start": 69.989,
   "end": 71.611,
   "id": "c36"
  },
  {
   "text": "这种骗局",
   "start": 72.007,
   "end": 72.797,
   "id": "c37"
  },
  {
   "text": "也常见于场外交易",
   "start": 73.003,
   "end": 74.619,
   "id": "c38"
  },
  {
   "text": "骗子给你一个有余额",
   "start": 74.85,
   "end": 76.735,
   "id": "c39"
  },
  {
   "text": "却转不出来的账户私钥",
   "start": 76.778,
   "end": 78.666,
   "id": "c40"
  },
  {
   "text": "诱导你付手续费",
   "start": 78.843,
   "end": 80.223,
   "id": "c41"
  },
  {
   "text": "对合约开发者",
   "start": 80.43,
   "end": 82.096,
   "id": "c42"
  },
  {
   "text": "这里有一个含义",
   "start": 82.116,
   "end": 83.353,
   "id": "c43"
  },
  {
   "text": "在 TRON 上",
   "start": 83.61,
   "end": 84.515,
   "id": "c44"
  },
  {
   "text": "一个地址等于一把私钥",
   "start": 84.72,
   "end": 86.784,
   "id": "c45"
  },
  {
   "text": "这个假设不成立",
   "start": 86.934,
   "end": 88.238,
   "id": "c46"
  },
  {
   "text": "收到一个地址",
   "start": 88.47,
   "end": 89.758,
   "id": "c47"
  },
  {
   "text": "不能假设它由单一私钥控制",
   "start": 90.202,
   "end": 92.595,
   "id": "c48"
  },
  {
   "text": "设成 owner 之前",
   "start": 92.879,
   "end": 94.25,
   "id": "c49"
  },
  {
   "text": "先查它的权限配置",
   "start": 94.306,
   "end": 95.843,
   "id": "c50"
  }
 ]
}