 "captions": [
  {
   "text": "最后 每个人今天就能做一件事",
   "start": 1.55,
   "end": 4.459,
   "id": "c0"
  },
  {
   "text": "写合约的人",
   "start": 4.73,
   "end": 5.926,
   "id": "c1"
  },
  {
   "text": "列出每个修改状态的外部函数",
   "start": 6.002,
   "end": 8.701,
   "id": "c2"
  },
  {
   "text": "逐个写下",
   "start": 8.843,
   "end": 9.712,
   "id": "c3"
  },
  {
   "text": "谁能调用",
   "start": 9.981,
   "end": 11.011,
   "id": "c4"
  },
  {
   "text": "凭什么安全",
   "start": 11.184,
   "end": 12.251,
   "id": "c5"
  },
  {
   "text": "审计的人",
   "start": 12.55,
   "end": 13.28,
   "id": "c6"
  },
  {
   "text": "搜一遍 initialize",
   "start": 13.3,
   "end": 14.52,
   "id": "c7"
  },
  {
   "text": "和 delegatecall",
   "start": 14.54,
   "end": 15.75,
   "id": "c8"
  },
  {
   "text": "确认实现合约已锁死",
   "start": 15.932,
   "end": 17.656,
   "id": "c9"
  },
  {
   "text": "目标地址不由用户决定",
   "start": 17.819,
   "end": 19.519,
   "id": "c10"
  },
  {
   "text": "管私钥的人",
   "start": 19.904,
   "end": 20.756,
   "id": "c11"
  },
  {
   "text": "列出所有特权私钥 谁持有 放在哪",
   "start": 20.776,
   "end": 24.043,
   "id": "c12"
  },
  {
   "text": "阈值多少",
   "start": 24.122,
   "end": 24.979,
   "id": "c13"
  },
  {
   "text": "上次撤销是什么时候",
   "start": 25.098,
   "end": 26.567,
   "id": "c14"
  },
  {
   "text": "普通用户",
   "start": 26.83,
   "end": 27.717,
   "id": "c15"
  },
  {
   "text": "存款前看一眼协议的管理员权限",
   "start": 28.084,
   "end": 30.903,
   "id": "c16"
  },
  {
   "text": "管理员是单个地址",
   "start": 31.358,
   "end": 33.114,
   "id": "c17"
  },
  {
   "text": "就是高风险信号",
   "start": 33.134,
   "end": 34.457,
   "id": "c18"
  },
  {
   "text": "在 TRON 上",
   "start": 34.73,
   "end": 35.669,
   "id": "c19"
  },
  {
   "text": "不导入别人给的私钥",
   "start": 35.96,
   "end": 37.615,
   "id": "c20"
  },
  {
   "text": "也不签修改账户权限的交易",
   "start": 37.871,
   "end": 40.285,
   "id": "c21"
  },
  {
   "text": "回到开头的问题",
   "start": 40.644,
   "end": 41.99,
   "id": "c22"
  },
  {
   "text": "那个用户没破解任何东西",
