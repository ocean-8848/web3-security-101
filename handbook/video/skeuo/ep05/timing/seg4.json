 "captions": [
  {
   "text": "前面讲的",
   "start": 1.648,
   "end": 2.651,
   "id": "c0"
  },
  {
   "text": "都是合约层的权限",
   "start": 2.671,
   "end": 4.127,
   "id": "c1"
  },
  {
   "text": "账户本身",
   "start": 4.502,
   "end": 5.601,
   "id": "c2"
  },
  {
   "text": "也有权限",
   "start": 5.764,
   "end": 6.66,
   "id": "c3"
  },
  {
   "text": "以太坊的外部账户",
   "start": 7.652,
   "end": 9.226,
   "id": "c4"
  },
  {
   "text": "只有一把私钥",
   "start": 9.283,
   "end": 10.441,
   "id": "c5"
  },
  {
   "text": "TRON 不一样",
   "start": 11.424,
   "end": 12.403,
   "id": "c6"
  },
  {
   "text": "按 TRON 官方文档和安全公司的公开资料",
   "start": 12.766,
   "end": 15.817,
   "id": "c7"
  },
  {
   "text": "它的账户原生支持多重权限",
   "start": 16.028,
   "end": 18.413,
   "id": "c8"
  },
  {
   "text": "Owner 权限最高",
   "start": 19.396,
   "end": 20.78,
   "id": "c9"
  },
  {
   "text": "能修改其他权限",
   "start": 20.848,
   "end": 22.244,
   "id": "c10"
  },
  {
   "text": "包括增删签名人",
   "start": 22.288,
   "end": 23.768,
   "id": "c11"
  },
  {
   "text": "Active 管日常操作",
   "start": 24.752,
   "end": 26.434,
   "id": "c12"
  },
  {
   "text": "比如转账 质押",
   "start": 26.466,
   "end": 28.088,
   "id": "c13"
  },
  {
   "text": "调用合约",
   "start": 28.156,
   "end": 28.993,
   "id": "c14"
  },
  {
   "text": "它可以有多个",
   "start": 29.368,
   "end": 30.431,
   "id": "c15"
  },
  {
   "text": "每个可以限定操作类型",
   "start": 30.618,
   "end": 32.55,
   "id": "c16"
  },
  {
   "text": "Witness 只管超级代表",
   "start": 33.54,
   "end": 35.662,
   "id": "c17"
  },
  {
   "text": "也就是出块节点的相关操作",
   "start": 35.694,
   "end": 37.829,
   "id": "c18"
  },
  {
   "text": "每个权限有一组地址",
   "start": 38.824,
   "end": 40.613,
   "id": "c19"
  },
  {
   "text": "每个地址有权重",
   "start": 40.74,
   "end": 42.291,
   "id": "c20"
  },
  {
   "text": "权重加起来达到阈值",
   "start": 43.268,
   "end": 44.997,
   "id": "c21"
  },
  {
   "text": "操作才执行",
   "start": 45.041,
   "end": 46.295,
   "id": "c22"
  },
  {
   "text": "这套设计",
   "start": 47.28,
   "end": 48.307,
   "id": "c23"
  },
  {
   "text": "被骗子用来做多签诈骗",
   "start": 48.363,
   "end": 50.533,
   "id": "c24"
  },
  {
   "text": "第一步 受害者在假钱包或钓鱼页上",
   "start": 51.508,
   "end": 54.749,
   "id": "c25"
  },
  {
   "text": "泄露了私钥",
   "start": 54.77,
   "end": 55.809,
   "id": "c26"
  },
  {
   "text": "第二步 攻击者修改账户权限",
   "start": 56.792,
   "end": 59.378,
   "id": "c27"
  },
  {
   "text": "把 Owner 和 Active 都改成自己",
   "start": 59.53,
   "end": 62.164,
   "id": "c28"
  },
  {
   "text": "第三步 受害者还能看到余额",
   "start": 63.156,
   "end": 65.802,
   "id": "c29"
  },
  {
   "text": "但已经转不出来",
   "start": 65.858,
   "end": 66.968,
   "id": "c30"
  },
  {
   "text": "转入不需要签名",
   "start": 67.936,
   "end": 69.356,
   "id": "c31"
  },
  {
   "text": "新的 USDT",
   "start": 69.731,
   "end": 71.115,
   "id": "c32"
  },
  {
   "text": "还会继续转进来",
   "start": 71.136,
   "end": 72.365,
   "id": "c33"
  },
  {
   "text": "攻击者不急",
   "start": 73.34,
   "end": 74.474,
   "id": "c34"
  },
  {
   "text": "账户看起来正常",
   "start": 74.837,
   "end": 76.448,
   "id": "c35"
  },
  {
   "text": "他择机再全部转走",
   "start": 76.671,
   "end": 78.198,
   "id": "c36"
  },
  {
   "text": "这种骗局",
   "start": 79.176,
   "end": 80.191,
   "id": "c37"
  },
  {
   "text": "也常见于场外交易",
   "start": 80.211,
   "end": 81.774,
   "id": "c38"
  },
  {
   "text": "骗子给你一个有余额",
   "start": 82.756,
   "end": 84.402,
   "id": "c39"
  },
  {
   "text": "却转不出来的账户私钥",
   "start": 84.529,
   "end": 86.128,
   "id": "c40"
  },
  {
   "text": "诱导你付手续费",
   "start": 86.244,
   "end": 87.426,
   "id": "c41"
  },
  {
   "text": "对合约开发者",
   "start": 88.424,
   "end": 89.677,
   "id": "c42"
  },
  {
   "text": "这里有一个含义",
   "start": 89.757,
   "end": 90.915,
   "id": "c43"
  },
  {
   "text": "在 TRON 上",
   "start": 91.908,
   "end": 92.875,
   "id": "c44"
  },
  {
   "text": "一个地址等于一把私钥",
   "start": 93.003,
   "end": 94.638,
   "id": "c45"
  },
  {
   "text": "这个假设不成立",
   "start": 94.658,
   "end": 95.887,
   "id": "c46"
  },
  {
   "text": "收到一个地址",
   "start": 96.856,
   "end": 98.014,
   "id": "c47"
  },
  {
   "text": "不能假设它由单一私钥控制",
   "start": 98.034,
   "end": 100.109,
   "id": "c48"
  },
  {
   "text": "设成 owner 之前",
   "start": 100.484,
   "end": 102.012,
   "id": "c49"
  },
  {
   "text": "先查它的权限配置",
   "start": 102.032,
   "end": 103.607,
   "id": "c50"
  }
 ]
}