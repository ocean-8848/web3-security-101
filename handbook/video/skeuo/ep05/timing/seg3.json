 "captions": [
  {
   "text": "其实 Parity 在同一年出过两次事",
   "start": 1.648,
   "end": 4.734,
   "id": "c0"
  },
  {
   "text": "2017 年 7 月那次",
   "start": 5.708,
   "end": 7.318,
   "id": "c1"
  },
  {
   "text": "钱包合约把不认识的调用",
   "start": 7.422,
   "end": 9.211,
   "id": "c2"
  },
  {
   "text": "用 delegatecall 转给了库合约",
   "start": 9.231,
   "end": 11.568,
   "id": "c3"
  },
  {
   "text": "库里的 initWallet 没有保护",
   "start": 12.552,
   "end": 14.972,
   "id": "c4"
  },
  {
   "text": "攻击者通过钱包调用它",
   "start": 15.347,
   "end": 17.231,
   "id": "c5"
  },
  {
   "text": "把自己设成了 owner",
   "start": 17.287,
   "end": 18.957,
   "id": "c6"
  },
  {
   "text": "约 15.3 万 ETH 被转走",
   "start": 19.948,
   "end": 22.118,
   "id": "c7"
  },
  {
   "text": "约合 3000 万美元",
   "start": 22.198,
   "end": 23.677,
   "id": "c8"
  },
  {
   "text": "11 月那次不同",
   "start": 24.68,
   "end": 26.112,
   "id": "c9"
  },
  {
   "text": "被接管的是库合约自己",
   "start": 26.487,
   "end": 28.323,
   "id": "c10"
  },
  {
   "text": "然后它被销毁了",
   "start": 28.522,
   "end": 29.764,
   "id": "c11"
  },
  {
   "text": "两次的教训相同",
   "start": 30.732,
   "end": 32.283,
   "id": "c12"
  },
  {
   "text": "实现合约本身",
   "start": 32.494,
   "end": 33.914,
   "id": "c13"
  },
  {
   "text": "也要初始化或者锁死",
   "start": 33.934,
   "end": 35.854,
   "id": "c14"
  },
  {
   "text": "这就引出第四种缺陷",
   "start": 36.832,
   "end": 38.525,
   "id": "c15"
  },
  {
   "text": "任意外部调用",
   "start": 38.665,
   "end": 39.835,
   "id": "c16"
  },
  {
   "text": "和任意 delegatecall",
   "start": 39.855,
   "end": 41.371,
   "id": "c17"
  },
  {
   "text": "一个合约公开了 execute 函数",
   "start": 42.356,
   "end": 44.728,
   "id": "c18"
  },
  {
   "text": "目标地址和调用数据",
   "start": 45.103,
   "end": 46.988,
   "id": "c19"
  },
  {
   "text": "全由调用者决定",
   "start": 47.008,
   "end": 48.476,
   "id": "c20"
  },
  {
   "text": "假设这个合约",
   "start": 49.464,
   "end": 50.634,
   "id": "c21"
  },
  {
   "text": "持有受害者对某个代币的授权",
   "start": 50.69,
   "end": 52.979,
   "id": "c22"
  },
  {
   "text": "攻击者不需要受害者的私钥",
   "start": 53.98,
   "end": 55.852,
   "id": "c23"
  },
  {
   "text": "他让这个合约去调用代币的",
   "start": 56.84,
   "end": 58.689,
   "id": "c24"
  },
  {
   "text": "transferFrom",
   "start": 58.709,
   "end": 59.688,
   "id": "c25"
  },
  {
   "text": "把受害者的币转给自己",
   "start": 59.744,
   "end": 61.355,
   "id": "c26"
  },
  {
   "text": "代币合约看到的调用方",
   "start": 62.34,
   "end": 64.402,
   "id": "c27"
  },
  {
   "text": "是被授权的合约",
   "start": 64.518,
   "end": 65.914,
   "id": "c28"
  },
  {
   "text": "额度检查 通过",
   "start": 66.29,
   "end": 68.019,
   "id": "c29"
  },
  {
   "text": "如果这里用的是 delegatecall",
   "start": 69.016,
   "end": 71.09,
   "id": "c30"
  },
  {
   "text": "攻击者的代码",
   "start": 71.147,
   "end": 72.15,
   "id": "c31"
  },
  {
   "text": "会直接改写这个合约的存储",
   "start": 72.17,
   "end": 73.971,
   "id": "c32"
  },
  {
   "text": "权限没有被偷",
   "start": 74.972,
   "end": 76.344,
   "id": "c33"
  },
  {
   "text": "是被借走了",
   "start": 76.472,
   "end": 77.534,
   "id": "c34"
  },
  {
   "text": "第五种 单步所有权转移",
   "start": 78.504,
   "end": 81.066,
   "id": "c35"
  },
  {
   "text": "owner 填入新地址",
   "start": 82.06,
   "end": 83.837,
   "id": "c36"
  },
  {
   "text": "一步就生效",
   "start": 83.952,
   "end": 84.956,
   "id": "c37"
  },
  {
   "text": "地址输错",
   "start": 85.319,
   "end": 86.311,
   "id": "c38"
  },
  {
   "text": "权限就永久丢失",
   "start": 86.367,
   "end": 88.037,
   "id": "c39"
  },
  {
   "text": "修复是两步转移",
   "start": 89.024,
   "end": 90.634,
   "id": "c40"
  },
  {
   "text": "新 owner 必须自己调用",
   "start": 91.009,
   "end": 92.906,
   "id": "c41"
  },
  {
   "text": "acceptOwnership",
   "start": 92.926,
   "end": 94.334,
   "id": "c42"
  },
  {
   "text": "证明这个地址真的能用",
   "start": 94.426,
   "end": 96.132,
   "id": "c43"
  },
  {
   "text": "第六种 签名鉴权写错",
   "start": 97.116,
   "end": 99.369,
   "id": "c44"
  },
  {
   "text": "用签名代替 msg.sender 时",
   "start": 100.36,
   "end": 103.125,
   "id": "c45"
  },
  {
   "text": "ecrecover 遇到无效签名",
   "start": 103.229,
   "end": 105.363,
   "id": "c46"
  },
  {
   "text": "会返回零地址",
   "start": 105.383,
   "end": 106.637,
   "id": "c47"
  },
  {
   "text": "如果被比较的签名人变量没有设置",
   "start": 107.612,
   "end": 109.913,
   "id": "c48"
  },
  {
   "text": "它的默认值也是零",
   "start": 110.147,
   "end": 111.555,
   "id": "c49"
  },
  {
   "text": "两边相等",
   "start": 111.919,
   "end": 112.898,
   "id": "c50"
  },
  {
   "text": "检查就通过了",
   "start": 113.085,
   "end": 114.196,
   "id": "c51"
  },
  {
   "text": "所以比对前",
   "start": 115.176,
   "end": 116.322,
   "id": "c52"
  },
  {
   "text": "先排除零地址",
   "start": 116.342,
   "end": 117.762,
   "id": "c53"
  },
  {
   "text": "最后 还有三个容易漏掉的判断",
   "start": 118.732,
   "end": 121.485,
   "id": "c54"
  },
  {
   "text": "一 代码长度是零",
   "start": 122.48,
   "end": 124.566,
   "id": "c55"
  },
  {
   "text": "不能证明对方是外部账户",
   "start": 124.658,
   "end": 126.519,
   "id": "c56"
  },
  {
   "text": "构造函数里发起调用的合约",
   "start": 126.894,
   "end": 129.397,
   "id": "c57"
  },
  {
   "text": "代码长度也是零",
   "start": 129.501,
   "end": 131.052,
   "id": "c58"
  },
  {
   "text": "二 renounceOwnership 之后",
   "start": 132.036,
   "end": 134.396,
   "id": "c59"
  },
  {
   "text": "owner 权限无法恢复",
   "start": 134.488,
   "end": 136.229,
   "id": "c60"
  },
  {
   "text": "先确认没有函数还依赖它",
   "start": 136.605,
   "end": 138.858,
   "id": "c61"
  },
  {
   "text": "三 Solidity 0.4 时期",
   "start": 139.816,
   "end": 142.331,
   "id": "c62"
  },
  {
   "text": "构造函数和合约同名",
   "start": 142.387,
   "end": 144.283,
   "id": "c63"
  },
  {
   "text": "合约一改名",
   "start": 144.658,
   "end": 145.805,
   "id": "c64"
  },
  {
   "text": "旧构造函数就成了公共函数",
   "start": 145.837,
   "end": 148.209,
   "id": "c65"
  }
 ]
}