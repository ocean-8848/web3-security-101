 "captions": [
  {
   "text": "合约里每一个修改状态的函数",
   "start": 1.648,
   "end": 3.639,
   "id": "c0"
  },
  {
   "text": "都要回答一个问题",
   "start": 3.85,
   "end": 5.032,
   "id": "c1"
  },
  {
   "text": "谁可以调用我",
   "start": 5.243,
   "end": 6.353,
   "id": "c2"
  },
  {
   "text": "如果答案是任何人",
   "start": 7.62,
   "end": 9.063,
   "id": "c3"
  },
  {
   "text": "就必须证明",
   "start": 9.084,
   "end": 10.147,
   "id": "c4"
  },
  {
   "text": "任何人调用都安全",
   "start": 10.227,
   "end": 11.694,
   "id": "c5"
  },
  {
   "text": "打个比方",
   "start": 12.688,
   "end": 13.643,
   "id": "c6"
  },
  {
   "text": "合约像一栋写字楼",
   "start": 14.007,
   "end": 15.474,
   "id": "c7"
  },
  {
   "text": "public 函数是大堂的门",
   "start": 16.46,
   "end": 18.368,
   "id": "c8"
  },
  {
   "text": "谁都能进",
   "start": 18.388,
   "end": 19.272,
   "id": "c9"
  },
  {
   "text": "onlyOwner 函数是机房的门 要刷卡",
   "start": 20.256,
   "end": 23.414,
   "id": "c10"
  },
  {
   "text": "这个比方有一处不成立",
   "start": 24.412,
   "end": 26.367,
   "id": "c11"
  },
  {
   "text": "写字楼可以换锁",
   "start": 26.731,
   "end": 28.044,
   "id": "c12"
  },
  {
   "text": "合约如果不能升级",
   "start": 29.024,
   "end": 30.479,
   "id": "c13"
  },
  {
   "text": "锁一旦装错",
   "start": 30.666,
   "end": 31.837,
   "id": "c14"
  },
  {
   "text": "就永远是错的",
   "start": 31.893,
   "end": 32.979,
   "id": "c15"
  },
  {
   "text": "谁会来试这些门",
   "start": 33.948,
   "end": 35.344,
   "id": "c16"
  },
  {
   "text": "大致有五类",
   "start": 35.707,
   "end": 36.746,
   "id": "c17"
  },
  {
   "text": "任意外部地址",
   "start": 37.72,
   "end": 39.068,
   "id": "c18"
  },
  {
   "text": "恶意合约",
   "start": 39.16,
   "end": 40.044,
   "id": "c19"
  },
  {
   "text": "被钓鱼的特权用户",
   "start": 40.101,
   "end": 41.568,
   "id": "c20"
  },
  {
   "text": "拿到私钥的攻击者",
   "start": 41.589,
   "end": 43.009,
   "id": "c21"
  },
  {
   "text": "还有内部人员",
   "start": 43.988,
   "end": 45.146,
   "id": "c22"
  },
  {
   "text": "他们本来就合法持有权限",
   "start": 45.297,
   "end": 47.289,
   "id": "c23"
  },
  {
   "text": "下面看六种常见缺陷",
   "start": 48.288,
   "end": 50.279,
   "id": "c24"
  },
  {
   "text": "先看前三种",
   "start": 50.654,
   "end": 52.05,
   "id": "c25"
  },
  {
   "text": "第一种 缺少权限检查",
   "start": 53.02,
   "end": 55.297,
   "id": "c26"
  },
  {
   "text": "一个增发函数",
   "start": 56.288,
   "end": 57.636,
   "id": "c27"
  },
  {
   "text": "对外公开",
   "start": 57.728,
   "end": 58.731,
   "id": "c28"
  },
  {
   "text": "却没有修饰器",
   "start": 58.776,
   "end": 59.934,
   "id": "c29"
  },
  {
   "text": "任何地址",
   "start": 60.309,
   "end": 61.396,
   "id": "c30"
  },
  {
   "text": "都能给自己印币",
   "start": 61.476,
   "end": 62.693,
   "id": "c31"
  },
  {
   "text": "修复是加上 onlyRole",
   "start": 63.684,
   "end": 65.402,
   "id": "c32"
  },
  {
   "text": "只认持有 MINTER 角色的地址",
   "start": 65.422,
   "end": 67.258,
   "id": "c33"
  },
  {
   "text": "老合约还有一个坑",
   "start": 68.248,
   "end": 69.953,
   "id": "c34"
  },
  {
   "text": "Solidity 0.5 之前",
   "start": 70.305,
   "end": 72.141,
   "id": "c35"
  },
  {
   "text": "函数默认是 public",
   "start": 72.329,
   "end": 74.272,
   "id": "c36"
  },
  {
   "text": "忘写可见性",
   "start": 75.26,
   "end": 76.501,
   "id": "c37"
  },
  {
   "text": "内部函数就暴露给了所有人",
   "start": 76.76,
   "end": 78.763,
   "id": "c38"
  },
  {
   "text": "第二种 用 tx.origin 做鉴权",
   "start": 79.752,
   "end": 82.838,
   "id": "c39"
  },
  {
   "text": "tx.origin",
   "start": 83.812,
   "end": 85.339,
   "id": "c40"
  },
  {
   "text": "是最初签名的那个外部账户",
   "start": 85.359,
   "end": 87.398,
   "id": "c41"
  },
  {
   "text": "管理员去领空投",
   "start": 88.4,
   "end": 89.927,
   "id": "c42"
  },
  {
   "text": "调用了攻击者的合约",
   "start": 89.947,
   "end": 91.439,
   "id": "c43"
  },
  {
   "text": "攻击者的合约",
   "start": 91.814,
   "end": 92.996,
   "id": "c44"
  },
  {
   "text": "再来调用你的",
   "start": 93.052,
   "end": 94.079,
   "id": "c45"
  },
  {
   "text": "这时 tx.origin 仍然是管理员",
   "start": 95.052,
   "end": 98.341,
   "id": "c46"
  },
  {
   "text": "检查通过了",
   "start": 98.716,
   "end": 99.814,
   "id": "c47"
  },
  {
   "text": "修复是改看 msg.sender",
   "start": 100.792,
   "end": 103.259,
   "id": "c48"
  },
  {
   "text": "也就是直接调用者",
   "start": 103.28,
   "end": 104.712,
   "id": "c49"
  },
  {
   "text": "中间的合约",
   "start": 105.075,
   "end": 106.114,
   "id": "c50"
  },
  {
   "text": "冒充不了它",
   "start": 106.265,
   "end": 107.316,
   "id": "c51"
  },
  {
   "text": "第三种 未保护的初始化函数",
   "start": 108.308,
   "end": 111.109,
   "id": "c52"
  },
  {
   "text": "可升级合约和克隆合约",
   "start": 112.104,
   "end": 114.143,
   "id": "c53"
  },
  {
   "text": "用 initialize 代替构造函数",
   "start": 114.163,
   "end": 116.726,
   "id": "c54"
  },
  {
   "text": "如果它没人调用",
   "start": 117.724,
   "end": 119.025,
   "id": "c55"
  },
  {
   "text": "或者能被重复调用",
   "start": 119.045,
   "end": 120.489,
   "id": "c56"
  },
  {
   "text": "谁先调用",
   "start": 120.509,
   "end": 121.525,
   "id": "c57"
  },
  {
   "text": "谁就是 owner",
   "start": 121.545,
   "end": 122.679,
   "id": "c58"
  },
  {
   "text": "修复有两步",
   "start": 123.68,
   "end": 124.981,
   "id": "c59"
  },
  {
   "text": "第一步 加上 initializer 修饰器",
   "start": 125.344,
   "end": 128.157,
   "id": "c60"
  },
  {
   "text": "只允许执行一次",
   "start": 128.177,
   "end": 129.633,
   "id": "c61"
  },
  {
   "text": "第二步 在实现合约的构造函数里",
   "start": 130.62,
   "end": 133.016,
   "id": "c62"
  },
  {
   "text": "调用 disableInitializers",
   "start": 133.048,
   "end": 134.862,
   "id": "c63"
  },
  {
   "text": "把实现合约本身锁死",
   "start": 134.882,
   "end": 136.551,
   "id": "c64"
  },
  {
   "text": "开头的 Parity 库合约",
   "start": 137.536,
   "end": 139.23,
   "id": "c65"
  },
  {
   "text": "缺的正是这一步",
   "start": 139.25,
   "end": 140.503,
   "id": "c66"
  }
 ]
}