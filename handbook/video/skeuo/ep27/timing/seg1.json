   "speechStart": 16.518,
   "speechEnd": 19.327
  },
  {
   "id": "seg1-04",
   "text": "攻击，就发生在那个没被审过的版本上。",
   "spoken": "攻击，就发生在那个没被审过的版本上。",
   "src": "/Users/k/Workon/Learning/web3/web3-security-101/handbook/video/skeuo/ep27/audio/lines/seg1-04.mp3",
   "start": 20.36,
   "dur": 3.672,
   "speechStart": 20.458,
   "speechEnd": 23.196
  },
  {
   "id": "seg1-05",
   "text": "审计本身没有失败，出问题的，是审计和上线之间的那一段。",
   "spoken": "审计本身没有失败，出问题的，是审计和上线之间的那一段。",
