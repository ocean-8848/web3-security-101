 "captions": [
  {
   "text": "2021 年 5 月",
   "start": 1.648,
   "end": 2.841,
   "id": "c0"
  },
  {
   "text": "PancakeBunny 被攻击",
   "start": 2.91,
   "end": 4.318,
   "id": "c1"
  },
  {
   "text": "损失约 4500 万美元",
   "start": 4.398,
   "end": 6.437,
   "id": "c2"
  },
  {
   "text": "这个项目",
   "start": 7.436,
   "end": 8.427,
   "id": "c3"
  },
  {
   "text": "做过审计",
   "start": 8.531,
   "end": 9.415,
   "id": "c4"
  },
  {
   "text": "可审计方事后说明",
   "start": 10.416,
   "end": 11.943,
   "id": "c5"
  },
  {
   "text": "被利用的那份代码",
   "start": 12.023,
   "end": 13.371,
   "id": "c6"
  },
  {
   "text": "是审计之后才上线的版本",
   "start": 13.439,
   "end": 15.478,
   "id": "c7"
  },
  {
   "text": "审计看的是一份代码",
   "start": 16.468,
   "end": 18.054,
   "id": "c8"
  },
  {
   "text": "链上跑的是另一份",
   "start": 18.099,
   "end": 19.447,
   "id": "c9"
  },
  {
   "text": "攻击 就发生在那个没被审过的版本上",
   "start": 20.408,
   "end": 23.316,
   "id": "c10"
  },
  {
   "text": "审计本身没有失败",
   "start": 24.3,
   "end": 25.898,
   "id": "c11"
  },
  {
   "text": "出问题的",
   "start": 26.014,
   "end": 26.958,
   "id": "c12"
  },
  {
   "text": "是审计和上线之间的那一段",
   "start": 26.978,
   "end": 28.993,
   "id": "c13"
  },
  {
   "text": "项目上线时",
   "start": 29.968,
   "end": 31.221,
   "id": "c14"
  },
  {
   "text": "常常会说一句",
   "start": 31.301,
   "end": 32.435,
   "id": "c15"
  },
  {
   "text": "我们通过了审计",
   "start": 32.634,
   "end": 33.78,
   "id": "c16"
  },
  {
   "text": "先猜一道题",
   "start": 34.772,
   "end": 36.096,
   "id": "c17"
  },
  {
   "text": "项目方能不能用",
   "start": 37.08,
   "end": 38.273,
   "id": "c18"
  },
  {
   "text": "我们通过了审计",
   "start": 38.472,
   "end": 39.833,
   "id": "c19"
  },
  {
   "text": "来证明线上的代码是安全的",
   "start": 39.972,
   "end": 41.666,
   "id": "c20"
  },
  {
   "text": "想一想 审计报告证明的",
   "start": 42.932,
   "end": 45.316,
   "id": "c21"
  },
  {
   "text": "到底是哪一份代码",
   "start": 45.372,
   "end": 46.602,
   "id": "c22"
  },
  {
   "text": "还有 审计之后改过的代码 谁来看",
   "start": 47.592,
   "end": 50.964,
   "id": "c23"
  },
  {
   "text": "带着这两个问题",
   "start": 52.22,
   "end": 53.509,
   "id": "c24"
  },
  {
   "text": "我们看看",
   "start": 53.589,
   "end": 54.449,
   "id": "c25"
  },
  {
   "text": "安全怎样写进开发的每一步",
   "start": 54.624,
   "end": 56.687,
   "id": "c26"
  }
 ]
