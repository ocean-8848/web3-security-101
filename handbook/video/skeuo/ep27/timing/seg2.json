  },
  {
   "line": 23,
   "text": "经济",
   "start": 114.174,
   "end": 114.508
  },
  {
   "line": 23,
   "text": "审计",
   "start": 114.519,
   "end": 114.936
  }
 ],
 "captions": [
  {
   "text": "先给一句准确的说法",
   "start": 1.648,
   "end": 3.246,
   "id": "c0"
  },
  {
   "text": "审计不是安全的起点",
   "start": 4.244,
   "end": 5.961,
   "id": "c1"
  },
  {
   "text": "也不是终点",
   "start": 6.148,
   "end": 7.056,
   "id": "c2"
  },
  {
   "text": "它是流水线上的一个关口",
   "start": 8.04,
   "end": 9.888,
   "id": "c3"
  },
  {
   "text": "它之前要有设计和测试",
   "start": 10.876,
   "end": 12.796,
   "id": "c4"
  },
  {
   "text": "之后要有监控和应急",
   "start": 12.911,
   "end": 15.129,
   "id": "c5"
  },
  {
   "text": "打个比方",
   "start": 16.112,
   "end": 16.913,
   "id": "c6"
  },
  {
   "text": "合约开发像造一架飞机",
   "start": 17.124,
   "end": 18.972,
   "id": "c7"
  },
  {
   "text": "设计时画图纸",
   "start": 19.956,
   "end": 21.483,
   "id": "c8"
  },
  {
   "text": "写下任何情况下机翼都不能断",
   "start": 21.658,
   "end": 24.257,
   "id": "c9"
  },
  {
   "text": "每个零件出厂前都要测",
   "start": 25.216,
   "end": 27.041,
   "id": "c10"
  },
  {
   "text": "还要放进风洞",
   "start": 27.061,
   "end": 28.148,
   "id": "c11"
  },
  {
   "text": "用各种极端风向去吹",
   "start": 28.239,
   "end": 29.969,
   "id": "c12"
  },
  {
   "text": "外部机构做适航认证",
   "start": 30.956,
   "end": 32.673,
   "id": "c13"
  },
  {
   "text": "它不查每一颗螺丝",
   "start": 32.86,
   "end": 34.269,
   "id": "c14"
  },
  {
   "text": "只抽查关键系统",
   "start": 34.289,
   "end": 35.709,
   "id": "c15"
  },
  {
   "text": "飞上天以后",
   "start": 36.696,
   "end": 37.794,
   "id": "c16"
  },
  {
   "text": "有黑匣子和地面雷达",
   "start": 37.874,
   "end": 39.675,
   "id": "c17"
  },
  {
   "text": "出了事有应急程序",
   "start": 39.767,
   "end": 41.497,
   "id": "c18"
  },
  {
   "text": "这个比方有一处不成立",
   "start": 42.484,
   "end": 44.439,
   "id": "c19"
  },
  {
   "text": "飞机出厂后",
   "start": 45.416,
   "end": 46.61,
   "id": "c20"
  },
  {
   "text": "还能召回维修",
   "start": 46.63,
   "end": 47.824,
   "id": "c21"
  },
  {
   "text": "不可升级的合约",
   "start": 48.804,
   "end": 50.009,
   "id": "c22"
  },
  {
   "text": "部署之后",
   "start": 50.22,
   "end": 51.093,
   "id": "c23"
  },
  {
   "text": "就再也不能修改",
   "start": 51.113,
   "end": 52.331,
   "id": "c24"
  },
  {
   "text": "所以前面的关口",
   "start": 53.32,
   "end": 55.013,
   "id": "c25"
  },
  {
   "text": "必须更严",
   "start": 55.093,
   "end": 56.049,
   "id": "c26"
  },
  {
   "text": "把这条流水线展开",
   "start": 57.02,
   "end": 58.606,
   "id": "c27"
  },
  {
   "text": "一共八个关口",
   "start": 58.674,
   "end": 59.832,
   "id": "c28"
  },
  {
   "text": "规格与威胁模型",
   "start": 60.816,
   "end": 62.331,
   "id": "c29"
  },
  {
   "text": "安全编码规范",
   "start": 62.506,
   "end": 63.736,
   "id": "c30"
  },
  {
   "text": "静态分析",
   "start": 63.947,
   "end": 64.831,
   "id": "c31"
  },
  {
   "text": "单元 模糊和不变量测试",
   "start": 65.812,
   "end": 68.422,
   "id": "c32"
  },
  {
   "text": "关键模块的形式化验证",
   "start": 68.538,
   "end": 70.22,
   "id": "c33"
  },
  {
   "text": "外部审计或竞赛",
   "start": 71.192,
   "end": 72.683,
   "id": "c34"
  },
  {
   "text": "安全部署与权限移交",
   "start": 72.834,
   "end": 74.731,
   "id": "c35"
  },
  {
   "text": "最后是监控",
   "start": 75.732,
   "end": 76.747,
   "id": "c36"
  },
  {
   "text": "漏洞赏金",
   "start": 76.827,
   "end": 77.89,
   "id": "c37"
  },
  {
   "text": "应急响应和保险",
   "start": 78.041,
   "end": 79.461,
   "id": "c38"
  },
  {
   "text": "越靠左的关口",
   "start": 80.44,
   "end": 81.681,
   "id": "c39"
  },
  {
   "text": "修复越便宜",
   "start": 81.713,
   "end": 82.955,
   "id": "c40"
  },
  {
   "text": "规格阶段发现的问题",
   "start": 83.082,
   "end": 84.669,
   "id": "c41"
  },
  {
   "text": "只要改文档",
   "start": 84.773,
   "end": 85.788,
   "id": "c42"
  },
  {
   "text": "静态分析",
   "start": 86.756,
   "end": 87.723,
   "id": "c43"
  },
  {
   "text": "测试和形式化验证是自动的",
   "start": 87.851,
   "end": 90.89,
   "id": "c44"
  },
  {
   "text": "每次提交代码都该跑一遍",
   "start": 91.029,
   "end": 93.116,
   "id": "c45"
  },
  {
   "text": "静态分析误报多",
   "start": 94.08,
   "end": 95.369,
   "id": "c46"
  },
  {
   "text": "不求零告警",
   "start": 95.389,
   "end": 96.44,
   "id": "c47"
  },
  {
   "text": "要求每个告警都有结论",
   "start": 96.532,
   "end": 98.345,
   "id": "c48"
  },
  {
   "text": "审计发现的问题",
   "start": 99.34,
   "end": 100.807,
   "id": "c49"
  },
  {
   "text": "要反过来补成测试",
   "start": 100.875,
   "end": 102.307,
   "id": "c50"
  },
  {
   "text": "防止以后再犯",
   "start": 102.411,
   "end": 103.676,
   "id": "c51"
  },
  {
   "text": "但所有关口都有一个前提",
   "start": 104.672,
   "end": 106.818,
   "id": "c52"
  },
  {
   "text": "你想到了要检查什么",
   "start": 107.029,
   "end": 109.199,
   "id": "c53"
  },
  {
   "text": "经济攻击和跨协议的组合风险",
   "start": 110.196,
   "end": 112.889,
   "id": "c54"
  },
  {
   "text": "常常要专门的经济审计",
   "start": 113.041,
   "end": 115.056,
   "id": "c55"
  }
 ]
}