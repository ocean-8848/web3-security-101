 "captions": [
  {
   "text": "测试之前",
   "start": 1.648,
   "end": 2.651,
   "id": "c0"
  },
  {
   "text": "先要写清楚测什么",
   "start": 2.79,
   "end": 4.151,
   "id": "c1"
  },
  {
   "text": "规格里 写出每个函数调用前要满足什么",
   "start": 5.132,
   "end": 8.694,
   "id": "c2"
  },
  {
   "text": "调用后保证什么",
   "start": 8.774,
   "end": 10.111,
   "id": "c3"
  },
  {
   "text": "再写出系统的不变量",
   "start": 11.112,
   "end": 12.71,
   "id": "c4"
  },
  {
   "text": "也就是任何时候都必须成立的性质",
   "start": 12.921,
   "end": 15.591,
   "id": "c5"
  },
  {
   "text": "还要列出每个特权角色",
   "start": 16.588,
   "end": 18.329,
   "id": "c6"
  },
  {
   "text": "最多能造成多大破坏",
   "start": 18.48,
   "end": 20.21,
   "id": "c7"
  },
  {
   "text": "有了这些",
   "start": 21.2,
   "end": 22.072,
   "id": "c8"
  },
  {
   "text": "测试分三层",
   "start": 22.128,
   "end": 23.358,
   "id": "c9"
  },
  {
   "text": "第一层 单元测试",
   "start": 24.324,
   "end": 26.172,
   "id": "c10"
  },
  {
   "text": "验证你想到的情况",
   "start": 26.359,
   "end": 27.625,
   "id": "c11"
  },
  {
   "text": "第二层 模糊测试",
   "start": 28.624,
   "end": 30.52,
   "id": "c12"
  },
  {
   "text": "让工具生成大量随机输入",
   "start": 30.54,
   "end": 32.782,
   "id": "c13"
  },
  {
   "text": "比如一个金库 存进去",
   "start": 33.764,
   "end": 35.862,
   "id": "c14"
  },
  {
   "text": "马上取出来",
   "start": 35.906,
   "end": 36.993,
   "id": "c15"
  },
  {
   "text": "用户不能多拿",
   "start": 37.145,
   "end": 38.481,
   "id": "c16"
  },
  {
   "text": "工具会换着各种随机金额",
   "start": 39.456,
   "end": 41.53,
   "id": "c17"
  },
  {
   "text": "一遍遍去试",
   "start": 41.61,
   "end": 42.578,
   "id": "c18"
  },
  {
   "text": "只要有一个金额",
   "start": 43.564,
   "end": 44.865,
   "id": "c19"
  },
  {
   "text": "让取回的比存入的多",
   "start": 44.956,
   "end": 46.519,
   "id": "c20"
  },
  {
   "text": "测试就失败",
   "start": 46.611,
   "end": 47.698,
   "id": "c21"
  },
  {
   "text": "这条性质背后的规则是",
   "start": 48.68,
   "end": 50.493,
   "id": "c22"
  },
  {
   "text": "舍入必须偏向金库",
   "start": 50.513,
   "end": 52.338,
   "id": "c23"
  },
  {
   "text": "第三层 不变量测试",
   "start": 53.34,
   "end": 55.343,
   "id": "c24"
  },
  {
   "text": "随机的不是参数",
   "start": 55.447,
   "end": 56.867,
   "id": "c25"
  },
  {
   "text": "是调用的顺序",
   "start": 56.887,
   "end": 57.974,
   "id": "c26"
  },
  {
   "text": "比如一个银行合约 存款 取款 转账",
   "start": 58.96,
   "end": 62.832,
   "id": "c27"
  },
  {
   "text": "被随机组合着连续调用",
   "start": 62.936,
   "end": 64.749,
   "id": "c28"
  },
  {
   "text": "每一步之后都检查一次",
   "start": 65.732,
   "end": 67.568,
   "id": "c29"
  },
  {
   "text": "银行的余额",
   "start": 67.755,
   "end": 68.712,
   "id": "c30"
  },
  {
   "text": "不少于所有存款加起来",
   "start": 68.732,
   "end": 70.521,
   "id": "c31"
  },
  {
   "text": "先猜一道题",
   "start": 71.496,
   "end": 72.82,
   "id": "c32"
  },
  {
   "text": "一个重入漏洞",
   "start": 73.804,
   "end": 75.033,
   "id": "c33"
  },
  {
   "text": "要先调用存款",
   "start": 75.125,
   "end": 76.569,
   "id": "c34"
  },
  {
   "text": "再在回调里调用转账",
   "start": 76.696,
   "end": 78.235,
   "id": "c35"
  },
  {
   "text": "才会触发",
   "start": 78.316,
   "end": 79.212,
   "id": "c36"
  },
  {
   "text": "只随机参数的模糊测试",
   "start": 80.192,
   "end": 82.266,
   "id": "c37"
  },
  {
   "text": "能发现它吗",
   "start": 82.501,
   "end": 83.647,
   "id": "c38"
  },
  {
   "text": "通常不能",
   "start": 84.916,
   "end": 85.871,
   "id": "c39"
  },
  {
   "text": "因为它不会打乱调用顺序",
   "start": 86.023,
   "end": 87.776,
   "id": "c40"
  },
  {
   "text": "不变量测试生成随机调用序列",
   "start": 88.76,
   "end": 91.227,
   "id": "c41"
  },
  {
   "text": "再配上能触发回调的封装合约",
   "start": 91.283,
   "end": 93.609,
   "id": "c42"
  },
  {
   "text": "才有机会发现",
   "start": 93.629,
   "end": 94.703,
   "id": "c43"
  },
  {
   "text": "但要注意",
   "start": 95.7,
   "end": 96.655,
   "id": "c44"
  },
  {
   "text": "不变量测试只检查你写下的不变量",
   "start": 96.842,
   "end": 99.691,
   "id": "c45"
  },
  {
   "text": "Euler 事故里那一条",
   "start": 100.648,
   "end": 102.103,
   "id": "c46"
  },
  {
   "text": "每个账户健康因子不低于 1",
   "start": 102.183,
   "end": 104.306,
   "id": "c47"
  },
  {
   "text": "或者能被清算",
   "start": 104.326,
   "end": 105.389,
   "id": "c48"
  },
  {
   "text": "而且清算后协议不亏",
   "start": 105.457,
   "end": 107.318,
   "id": "c49"
  },
  {
   "text": "如果它没写进测试",
   "start": 108.284,
   "end": 109.811,
   "id": "c50"
  },
  {
   "text": "工具也不会发现",
   "start": 109.962,
   "end": 111.585,
   "id": "c51"
  },
  {
   "text": "核心数学库",
   "start": 112.584,
   "end": 113.826,
   "id": "c52"
  },
  {
   "text": "清算逻辑",
   "start": 113.846,
   "end": 114.92,
   "id": "c53"
  },
  {
   "text": "跨链桥的证明验证",
   "start": 115.084,
   "end": 116.515,
   "id": "c54"
  },
  {
   "text": "还可以再做形式化验证",
   "start": 116.631,
   "end": 118.706,
   "id": "c55"
  },
  {
   "text": "它用数学方法证明",
   "start": 119.692,
   "end": 121.362,
   "id": "c56"
  },
  {
   "text": "代码在所有输入和状态下都满足规格",
   "start": 121.537,
   "end": 124.588,
   "id": "c57"
  },
  {
   "text": "代价是规格难写",
   "start": 125.576,
   "end": 127.138,
   "id": "c58"
  },
  {
   "text": "需要专门的人才",
   "start": 127.183,
   "end": 128.555,
   "id": "c59"
  }
 ]
}