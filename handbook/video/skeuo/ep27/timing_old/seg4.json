 "captions": [
  {
   "text": "测试做足了",
   "start": 1.55,
   "end": 2.736,
   "id": "c0"
  },
  {
   "text": "才轮到外部审计",
   "start": 2.773,
   "end": 4.132,
   "id": "c1"
  },
  {
   "text": "审计期间冻结代码",
   "start": 4.41,
   "end": 6.404,
   "id": "c2"
  },
  {
   "text": "审计的对象",
   "start": 6.65,
   "end": 7.715,
   "id": "c3"
  },
  {
   "text": "是某一个提交哈希",
   "start": 7.737,
   "end": 9.455,
   "id": "c4"
  },
  {
   "text": "把规格 威胁模型",
   "start": 9.842,
   "end": 11.011,
   "id": "c5"
  },
  {
   "text": "已知风险和测试覆盖率",
   "start": 11.121,
   "end": 14.157,
   "id": "c6"
  },
  {
   "text": "一起交给审计方",
   "start": 14.224,
   "end": 15.546,
   "id": "c7"
  },
  {
   "text": "关键协议",
   "start": 15.81,
   "end": 16.696,
   "id": "c8"
  },
  {
   "text": "请两家以上审计",
   "start": 16.884,
   "end": 18.43,
   "id": "c9"
  },
  {
   "text": "各有侧重",
   "start": 18.525,
   "end": 19.328,
   "id": "c10"
  },
  {
   "text": "也可以在 Code4rena",
   "start": 19.727,
   "end": 21.738,
   "id": "c11"
  },
  {
   "text": "Sherlock",
   "start": 21.825,
   "end": 22.505,
   "id": "c12"
  },
  {
   "text": "Cantina 这类平台办审计竞赛",
   "start": 22.588,
   "end": 25.023,
   "id": "c13"
  },
  {
   "text": "覆盖面更广",
   "start": 25.175,
   "end": 26.196,
   "id": "c14"
  },
  {
   "text": "修复本身也可能带来新漏洞",
   "start": 26.581,
   "end": 28.919,
   "id": "c15"
  },
  {
   "text": "所以修完要复审",
   "start": 29.112,
   "end": 30.669,
   "id": "c16"
  },
  {
   "text": "编译器版本也要记下来",
   "start": 31.057,
   "end": 32.926,
   "id": "c17"
  },
  {
   "text": "查它有没有已知 bug",
   "start": 33.13,
   "end": 34.806,
   "id": "c18"
  },
  {
   "text": "2023 年的 Vyper 事故",
   "start": 35.068,
   "end": 36.984,
   "id": "c19"
  },
  {
   "text": "就出在编译器上",
   "start": 37.131,
   "end": 38.57,
   "id": "c20"
  },
  {
   "text": "审计之后",
   "start": 38.77,
   "end": 39.87,
   "id": "c21"
  },
  {
   "text": "审计范围内的代码",
   "start": 40.01,
   "end": 41.584,
   "id": "c22"
  },
  {
   "text": "一个字都不能再改",
   "start": 41.795,
   "end": 43.338,
   "id": "c23"
  },
  {
   "text": "接着是部署",
   "start": 43.63,
   "end": 44.897,
   "id": "c24"
  },
  {
   "text": "用脚本部署",
   "start": 45.13,
   "end": 46.325,
   "id": "c25"
  },
  {
   "text": "不手动操作",
   "start": 46.559,
   "end": 47.584,
   "id": "c26"
  },
  {
   "text": "脚本本身也要评审",
   "start": 47.62,
   "end": 49.047,
   "id": "c27"
  },
  {
   "text": "部署和初始化",
   "start": 49.371,
   "end": 50.771,
   "id": "c28"
  },
  {
   "text": "放在同一笔交易里完成",
   "start": 50.895,
   "end": 52.817,
   "id": "c29"
  },
  {
   "text": "部署后在区块浏览器上验证源码",
   "start": 53.185,
   "end": 56.13,
   "id": "c30"
  },
  {
   "text": "再跑一个验证脚本",
   "start": 56.359,
   "end": 57.996,
   "id": "c31"
  },
  {
   "text": "把关键参数逐个读出来",
   "start": 58.2,
   "end": 60.232,
   "id": "c32"
  },
  {
   "text": "和预期对比",
   "start": 60.371,
   "end": 61.489,
   "id": "c33"
  },
  {
   "text": "最后 把权限从部署账户移交给多签和时间锁",
   "start": 61.79,
   "end": 66.544,
   "id": "c34"
  },
  {
   "text": "撤销部署账户的所有角色",
   "start": 66.779,
   "end": 68.852,
   "id": "c35"
  },
  {
   "text": "还有一件常被跳过的事",
   "start": 69.05,
   "end": 71.011,
   "id": "c36"
  },
  {
   "text": "在目标链上测",
   "start": 71.198,
   "end": 72.425,
   "id": "c37"
  },
  {
   "text": "在以太坊上测过",
