 "captions": [
  {
   "text": "上线不是终点",
   "start": 1.55,
   "end": 3.266,
   "id": "c0"
  },
  {
   "text": "合约上线以后",
   "start": 3.53,
   "end": 4.687,
   "id": "c1"
  },
  {
   "text": "要有人一直盯着",
   "start": 4.864,
   "end": 6.144,
   "id": "c2"
  },
  {
   "text": "同时开一个漏洞赏金",
   "start": 6.39,
   "end": 8.299,
   "id": "c3"
  },
  {
   "text": "让发现问题的白帽",
   "start": 8.794,
   "end": 10.21,
   "id": "c4"
  },
  {
   "text": "有动力先来报告",
   "start": 10.23,
   "end": 11.615,
   "id": "c5"
  },
  {
   "text": "盯什么",
   "start": 11.983,
   "end": 12.597,
   "id": "c6"
  },
  {
   "text": "锁仓总量突然下跌",
   "start": 12.852,
   "end": 15.01,
   "id": "c7"
  },
  {
   "text": "比如 10 分钟内跌了超过 10%",
   "start": 15.152,
   "end": 18.577,
   "id": "c8"
  },
  {
   "text": "同一笔交易里",
   "start": 18.927,
   "end": 20.066,
   "id": "c9"
  },
  {
   "text": "出现大额闪电贷和本协议的调用",
   "start": 20.169,
   "end": 23.308,
   "id": "c10"
  },
  {
   "text": "任何管理员函数被调用",
   "start": 23.53,
   "end": 25.404,
   "id": "c11"
  },
  {
   "text": "实现地址变了",
   "start": 25.51,
   "end": 26.702,
   "id": "c12"
  },
  {
   "text": "时间锁队列里多了新操作",
   "start": 27.02,
   "end": 29.471,
   "id": "c13"
  },
  {
   "text": "预言机价格偏离其他来源",
   "start": 29.75,
   "end": 32.064,
   "id": "c14"
  },
  {
   "text": "或者超过心跳时间没有更新",
   "start": 32.211,
   "end": 34.376,
   "id": "c15"
  },
  {
   "text": "跨链两侧",
   "start": 34.61,
   "end": 35.684,
   "id": "c16"
  },
  {
   "text": "锁定量和铸造量对不上",
   "start": 35.972,
   "end": 38.249,
   "id": "c17"
  },
  {
   "text": "告警响起",
   "start": 38.601,
   "end": 39.47,
   "id": "c18"
  },
  {
   "text": "接下来是应急流程",
   "start": 39.652,
   "end": 41.056,
   "id": "c19"
  },
  {
   "text": "值班人员先确认异常",
   "start": 41.29,
   "end": 43.208,
   "id": "c20"
  },
  {
   "text": "确认后触发暂停",
   "start": 43.43,
   "end": 45.051,
   "id": "c21"
  },
  {
   "text": "守护者的暂停权限没有延迟",
   "start": 45.486,
   "end": 47.686,
   "id": "c22"
  },
  {
   "text": "然后组建作战室",
   "start": 48.068,
   "end": 49.435,
   "id": "c23"
  },
  {
   "text": "里面有开发和审计方",
   "start": 49.583,
   "end": 51.562,
   "id": "c24"
  },
  {
   "text": "还有安全响应团队",
   "start": 51.771,
   "end": 53.293,
   "id": "c25"
  },
  {
   "text": "比如 SEAL 911 这类社区应急组织",
   "start": 53.416,
   "end": 56.269,
   "id": "c26"
  },
  {
   "text": "评估能不能白帽救援",
   "start": 56.51,
   "end": 58.406,
   "id": "c27"
  },
  {
   "text": "抢先把剩余资金转到安全的地方",
   "start": 58.444,
   "end": 61.296,
   "id": "c28"
  },
  {
   "text": "联系交易所和稳定币发行方",
   "start": 61.624,
   "end": 64.381,
   "id": "c29"
  },
  {
   "text": "冻结被盗资金",
   "start": 64.401,
   "end": 65.772,
   "id": "c30"
  },
  {
   "text": "最后发布公告和复盘",
   "start": 65.99,
   "end": 68.108,
   "id": "c31"
  },
  {
   "text": "看一个例子",
   "start": 68.37,
   "end": 69.231,
   "id": "c32"
  },
  {
   "text": "在 Bybit 事故里",
   "start": 69.566,
   "end": 70.945,
   "id": "c33"
  },
  {
   "text": "mETH 协议追回了 cmETH",
   "start": 71.197,
   "end": 74.512,
   "id": "c34"
  },
  {
   "text": "靠的是三样东西",
   "start": 74.834,
   "end": 76.341,
   "id": "c35"
  },
  {
   "text": "协议本身有提款延迟",
   "start": 76.572,
   "end": 78.884,
   "id": "c36"
  },
  {
   "text": "团队有暂停权限",
   "start": 79.086,
   "end": 80.994,
   "id": "c37"
  },
  {
   "text": "外部安全社区快速牵线",
   "start": 81.165,
   "end": 83.253,
   "id": "c38"
  },
  {
   "text": "这三样 没有一样是出事当天才能加上的",
   "start": 83.51,
   "end": 86.875,
   "id": "c39"
  },
  {
   "text": "应急能力",
   "start": 87.09,
   "end": 88.13,
   "id": "c40"
  },
  {
   "text": "要事先设计进合约",
   "start": 88.22,
   "end": 90.001,
   "id": "c41"
  }
 ]
}