 "captions": [
  {
   "text": "先给准确的说法",
   "start": 1.55,
   "end": 2.785,
   "id": "c0"
  },
  {
   "text": "数据泄露",
   "start": 3.05,
   "end": 4.183,
   "id": "c1"
  },
  {
   "text": "是下一次诈骗的名单",
   "start": 4.203,
   "end": 5.932,
   "id": "c2"
  },
  {
   "text": "攻击者知道了谁持有多少资产",
   "start": 6.244,
   "end": 8.487,
   "id": "c3"
  },
  {
   "text": "住在哪里",
   "start": 8.695,
   "end": 9.501,
   "id": "c4"
  },
  {
   "text": "用哪家交易所",
   "start": 9.521,
   "end": 10.65,
   "id": "c5"
  },
  {
   "text": "他就能冒充客服精准下手",
   "start": 11.024,
   "end": 13.154,
   "id": "c6"
  },
  {
   "text": "甚至找上门",
   "start": 13.33,
   "end": 14.378,
   "id": "c7"
  },
  {
   "text": "打个比方",
   "start": 14.766,
   "end": 15.412,
   "id": "c8"
  },
  {
   "text": "一份泄露的客户名单",
   "start": 15.769,
   "end": 17.639,
   "id": "c9"
  },
  {
   "text": "就是一本肥羊通讯录",
   "start": 17.802,
   "end": 19.469,
   "id": "c10"
  },
  {
   "text": "上面有姓名 电话",
   "start": 19.77,
   "end": 21.873,
   "id": "c11"
  },
  {
   "text": "存款金额",
   "start": 21.986,
   "end": 22.958,
   "id": "c12"
  },
  {
   "text": "还注明他上周刚联系过客服",
   "start": 23.127,
   "end": 25.772,
   "id": "c13"
  },
  {
   "text": "比喻在这里不成立",
   "start": 26.091,
   "end": 27.589,
   "id": "c14"
  },
  {
   "text": "银行流水是私密的",
   "start": 27.697,
   "end": 29.33,
   "id": "c15"
  },
  {
   "text": "链上交易是公开的",
   "start": 29.46,
   "end": 31.144,
   "id": "c16"
  },
  {
   "text": "名单里只要有一个地址",
   "start": 31.505,
   "end": 33.712,
   "id": "c17"
  },
  {
   "text": "攻击者就能查到这个人全部的链上历史",
   "start": 33.943,
   "end": 37.237,
   "id": "c18"
  },
  {
   "text": "和当前的余额",
   "start": 37.336,
   "end": 38.59,
   "id": "c19"
  },
  {
   "text": "一次泄露",
   "start": 38.83,
   "end": 39.751,
   "id": "c20"
  },
  {
   "text": "会同时引出三类攻击",
   "start": 39.829,
   "end": 41.871,
   "id": "c21"
  },
  {
   "text": "第一类 精准钓鱼",
   "start": 42.188,
   "end": 43.942,
   "id": "c22"
  },
  {
   "text": "冒充客服",
   "start": 44.009,
   "end": 44.914,
   "id": "c23"
  },
  {
   "text": "说出真实的细节",
   "start": 45.139,
   "end": 46.645,
   "id": "c24"
  },
  {
   "text": "第二类 账号接管",
   "start": 47.043,
   "end": 48.715,
   "id": "c25"
  },
  {
   "text": "拿证件信息骗过运营商",
   "start": 48.873,
   "end": 50.882,
   "id": "c26"
  },
  {
   "text": "劫持手机号",
   "start": 51.04,
   "end": 52.113,
   "id": "c27"
  },
  {
   "text": "第三类 人身风险",
   "start": 52.37,
   "end": 54.335,
   "id": "c28"
  },
  {
   "text": "知道住址",
   "start": 54.536,
   "end": 55.467,
   "id": "c29"
  },
  {
   "text": "又知道资产",
   "start": 55.496,
   "end": 56.725,
   "id": "c30"
  },
  {
   "text": "泄露的数据还会长期流通",
   "start": 56.99,
   "end": 59.447,
   "id": "c31"
  },
  {
   "text": "几年前的名单",
   "start": 59.828,
   "end": 61.037,
   "id": "c32"
  },
  {
   "text": "今天还在被用来诈骗",
   "start": 61.121,
   "end": 62.866,
   "id": "c33"
  },
  {
   "text": "名单从哪里流出来",
   "start": 63.223,
   "end": 64.701,
   "id": "c34"
  },
  {
   "text": "先看最集中的出口",
   "start": 65.058,
   "end": 66.679,
   "id": "c35"
  },
  {
   "text": "客服后台",
   "start": 66.883,
   "end": 67.769,
   "id": "c36"
  },
  {
   "text": "攻击者在社交平台上",
   "start": 68.07,
   "end": 69.815,
   "id": "c37"
  },
  {
   "text": "招募交易所的客服或者外包人员",
   "start": 69.947,
   "end": 72.598,
   "id": "c38"
  },
  {
   "text": "开价收买",
   "start": 72.757,
   "end": 73.631,
   "id": "c39"
  },
  {
   "text": "被收买的人",
   "start": 73.987,
   "end": 75.039,
   "id": "c40"
  },
  {
   "text": "在客服后台查询用户",
   "start": 75.109,
   "end": 77.16,
   "id": "c41"
  },
  {
