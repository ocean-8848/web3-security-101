 "captions": [
  {
   "text": "交易所今天就能做一件事",
   "start": 1.648,
   "end": 3.508,
   "id": "c0"
  },
  {
   "text": "查一查 客服后台有多少人",
   "start": 4.484,
   "end": 7.249,
   "id": "c1"
  },
  {
   "text": "能查到一条完整的用户记录",
   "start": 7.293,
   "end": 9.285,
   "id": "c2"
  },
  {
   "text": "普通用户也有几件事",
   "start": 10.272,
   "end": 12.144,
   "id": "c3"
  },
  {
   "text": "买硬件钱包用代收地址",
   "start": 13.132,
   "end": 15.349,
   "id": "c4"
  },
  {
   "text": "交易所和电商用不同的邮箱",
   "start": 15.489,
   "end": 17.873,
   "id": "c5"
  },
  {
   "text": "不在社交媒体上",
   "start": 18.872,
   "end": 20.173,
   "id": "c6"
  },
  {
   "text": "把自己的地址或 ENS 名称",
   "start": 20.3,
   "end": 22.542,
   "id": "c7"
  },
  {
   "text": "和真实身份连在一起",
   "start": 22.574,
   "end": 24.161,
   "id": "c8"
  },
  {
   "text": "收到交易所的泄露通知",
   "start": 25.14,
   "end": 26.965,
   "id": "c9"
  },
  {
   "text": "开启提币白名单",
   "start": 26.985,
   "end": 28.405,
   "id": "c10"
  },
  {
   "text": "至少几个月保持警惕",
   "start": 28.425,
   "end": 30.0,
   "id": "c11"
  },
  {
   "text": "回到开头的题",
   "start": 31.0,
   "end": 32.396,
   "id": "c12"
  },
  {
   "text": "对方说得出你的名字",
   "start": 33.38,
   "end": 34.835,
   "id": "c13"
  },
  {
   "text": "余额和工单",
   "start": 35.034,
   "end": 36.062,
   "id": "c14"
  },
  {
   "text": "不代表他是真客服",
   "start": 36.32,
   "end": 37.776,
   "id": "c15"
  },
  {
   "text": "这些数据",
   "start": 38.76,
   "end": 39.846,
   "id": "c16"
  },
  {
   "text": "可能早就泄露了",
   "start": 39.879,
   "end": 41.144,
   "id": "c17"
  },
  {
   "text": "交易所和钱包厂商",
   "start": 42.124,
   "end": 43.746,
   "id": "c18"
  },
  {
   "text": "永远不会让你把资产转到安全地址",
   "start": 43.957,
   "end": 46.77,
   "id": "c19"
  },
  {
   "text": "也不会索要助记词",
   "start": 46.909,
   "end": 48.294,
   "id": "c20"
  },
  {
   "text": "主动打来的电话 短信 邮件",
   "start": 49.28,
   "end": 51.938,
   "id": "c21"
  },
  {
   "text": "说你的账户有风险",
   "start": 52.053,
   "end": 53.509,
   "id": "c22"
  },
  {
   "text": "一律挂断",
   "start": 53.625,
   "end": 54.474,
   "id": "c23"
  },
  {
   "text": "再从官方 App 里联系客服",
   "start": 54.494,
   "end": 56.592,
   "id": "c24"
  },
  {
   "text": "数据里没有密码",
   "start": 57.588,
   "end": 58.912,
   "id": "c25"
  },
  {
   "text": "可它告诉骗子 该骗谁",
   "start": 59.076,
   "end": 61.067,
   "id": "c26"
  },
  {
   "text": "该怎么说",
   "start": 61.207,
   "end": 61.996,
   "id": "c27"
  },
  {
   "text": "下一集讲资金追踪与事后处置",
   "start": 62.968,
   "end": 65.673,
   "id": "c28"
  }
 ]
