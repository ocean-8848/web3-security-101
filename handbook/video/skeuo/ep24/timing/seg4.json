 "lines": [
  {
   "id": "seg4-00",
   "text": "数据之外，还有一种暴露，来自链本身。",
   "spoken": "数据之外，还有一种暴露，来自链本身。",
   "src": "/Users/k/Workon/Learning/web3/web3-security-101/handbook/video/skeuo/ep24/audio/lines/seg4-00.mp3",
   "start": 1.6,
   "dur": 4.08,
   "speechStart": 1.698,
   "speechEnd": 4.829
  },
  {
   "id": "seg4-01",
   "text": "去匿名化，就是把匿名的链上地址，关联到真实的身份。",
   "spoken": "去匿名化，就是把匿名的链上地址，关联到真实的身份。",
   "src": "/Users/k/Workon/Learning/web3/web3-security-101/handbook/video/skeuo/ep24/audio/lines/seg4-01.mp3",
   "start": 5.9,
   "dur": 5.28,
   "speechStart": 5.998,
   "speechEnd": 10.331
  },
  {
   "id": "seg4-02",
   "text": "链上分析先把地址聚成一个个实体，再把实体对上真人。",
   "spoken": "链上分析先把地址聚成一个个实体，再把实体对上真人。",
   "src": "/Users/k/Workon/Learning/web3/web3-security-101/handbook/video/skeuo/ep24/audio/lines/seg4-02.mp3",
   "start": 11.4,
   "dur": 5.376,
   "speechStart": 11.498,
   "speechEnd": 15.938
  },
  {
   "id": "seg4-03",
   "text": "第一种方法，共同输入。",
   "spoken": "第一种方法，共同输入。",
   "src": "/Users/k/Workon/Learning/web3/web3-security-101/handbook/video/skeuo/ep24/audio/lines/seg4-03.mp3",
   "start": 16.996,
   "dur": 2.832,
   "speechStart": 17.094,
   "speechEnd": 18.975
  },
  {
   "id": "seg4-04",
   "text": "一笔比特币交易的多个输入，大概率属于同一个所有者。",
   "spoken": "一笔比特币交易的多个输入，大概率属于同一个所有者。",
   "src": "/Users/k/Workon/Learning/web3/web3-security-101/handbook/video/skeuo/ep24/audio/lines/seg4-04.mp3",
   "start": 20.048,
   "dur": 4.656,
   "speechStart": 20.146,
   "speechEnd": 23.872
  },
  {
   "id": "seg4-05",
   "text": "第二种，找零地址，认出交易里找零给自己的那个输出。",
   "spoken": "第二种，找零地址，认出交易里找零给自己的那个输出。",
   "src": "/Users/k/Workon/Learning/web3/web3-security-101/handbook/video/skeuo/ep24/audio/lines/seg4-05.mp3",
   "start": 24.924,
   "dur": 5.304,
   "speechStart": 25.022,
   "speechEnd": 29.391
  },
  {
   "id": "seg4-06",
   "text": "第三种，交易所出入金。",
   "spoken": "第三种，交易所出入金。",
   "src": "/Users/k/Workon/Learning/web3/web3-security-101/handbook/video/skeuo/ep24/audio/lines/seg4-06.mp3",
   "start": 30.448,
   "dur": 2.88,
   "speechStart": 30.546,
   "speechEnd": 32.498
  },
  {
   "id": "seg4-07",
   "text": "地址跟交易所的充值地址有往来，而交易所掌握 KYC。",
   "spoken": "地址跟交易所的充值地址有往来，而交易所掌握 KYC。",
   "src": "/Users/k/Workon/Learning/web3/web3-security-101/handbook/video/skeuo/ep24/audio/lines/seg4-07.mp3",
   "start": 33.548,
   "dur": 5.592,
   "speechStart": 33.646,
   "speechEnd": 38.3
  },
  {
   "id": "seg4-08",
   "text": "第四种，跨链、跨混币器的时间和金额模式。",
   "spoken": "第四种，跨链、跨混币器的时间和金额模式。",
   "src": "/Users/k/Workon/Learning/web3/web3-security-101/handbook/video/skeuo/ep24/audio/lines/seg4-08.mp3",
   "start": 39.36,
   "dur": 4.824,
   "speechStart": 39.458,
   "speechEnd": 43.339
  },
  {
   "id": "seg4-09",
   "text": "第五种，链下关联，ENS 名称、社交媒体上贴出的地址、NFT 头像。",
   "spoken": "第五种，链下关联，ENS 名称、社交媒体上贴出的地址、NFT 头像。",
   "src": "/Users/k/Workon/Learning/web3/web3-security-101/handbook/video/skeuo/ep24/audio/lines/seg4-09.mp3",
   "start": 44.404,
   "dur": 7.248,
   "speechStart": 44.502,
   "speechEnd": 50.799
  },
  {
   "id": "seg4-10",
   "text": "这些都是启发式规则，会误判。",
   "spoken": "这些都是启发式规则，会误判。",
   "src": "/Users/k/Workon/Learning/web3/web3-security-101/handbook/video/skeuo/ep24/audio/lines/seg4-10.mp3",
   "start": 51.872,
   "dur": 3.768,
   "speechStart": 51.97,
   "speechEnd": 54.815
  },
  {
   "id": "seg4-11",
   "text": "比如一笔交易，有 4 个输入，4 个金额相等的输出。",
   "spoken": "比如一笔交易，有 4 个输入，4 个金额相等的输出。",
   "src": "/Users/k/Workon/Learning/web3/web3-security-101/handbook/video/skeuo/ep24/audio/lines/seg4-11.mp3",
   "start": 55.86,
   "dur": 4.704,
   "speechStart": 55.958,
   "speechEnd": 59.719
  },
  {
   "id": "seg4-12",
   "text": "共同输入规则，会把 4 个输入，归给同一个人。",
   "spoken": "共同输入规则，会把 4 个输入，归给同一个人。",
   "src": "/Users/k/Workon/Learning/web3/web3-security-101/handbook/video/skeuo/ep24/audio/lines/seg4-12.mp3",
   "start": 60.784,
   "dur": 4.368,
   "speechStart": 60.882,
   "speechEnd": 64.322
  },
  {
   "id": "seg4-13",
   "text": "可这是典型的 CoinJoin，可能是 4 个人各出一个输入。",
   "spoken": "可这是典型的 CoinJoin，可能是 4 个人各出一个输入。",
   "src": "/Users/k/Workon/Learning/web3/web3-security-101/handbook/video/skeuo/ep24/audio/lines/seg4-13.mp3",
   "start": 65.372,
   "dur": 4.68,
   "speechStart": 65.47,
   "speechEnd": 69.208
  },
  {
   "id": "seg4-14",
   "text": "聚到一起，一个人的 KYC 身份，就扩散到了另外 3 个人身上。",
   "spoken": "聚到一起，一个人的 KYC 身份，就扩散到了另外 3 个人身上。",
   "src": "/Users/k/Workon/Learning/web3/web3-security-101/handbook/video/skeuo/ep24/audio/lines/seg4-14.mp3",
   "start": 70.272,
   "dur": 5.328,
   "speechStart": 70.37,
   "speechEnd": 74.762
  },
  {
   "id": "seg4-15",
   "text": "这套方法，已经走进了法庭。",
   "spoken": "这套方法，已经走进了法庭。",
   "src": "/Users/k/Workon/Learning/web3/web3-security-101/handbook/video/skeuo/ep24/audio/lines/seg4-15.mp3",
   "start": 75.82,
   "dur": 3.168,
   "speechStart": 75.918,
   "speechEnd": 78.156
  },
  {
   "id": "seg4-16",
   "text": "Bitcoin Fog 是一个混币器，经手 120 万余枚比特币。",
   "spoken": "Bitcoin Fog 是一个混币器，经手 120 万余枚比特币。",
   "src": "/Users/k/Workon/Learning/web3/web3-security-101/handbook/video/skeuo/ep24/audio/lines/seg4-16.mp3",
   "start": 79.208,
   "dur": 4.944,
   "speechStart": 79.306,
   "speechEnd": 83.317
  },
  {
   "id": "seg4-17",
   "text": "2024 年 3 月，陪审团裁定，运营者 Roman Sterlingov 四项罪名成立。",
   "spoken": "2024 年 3 月，陪审团裁定，运营者 Roman Sterlingov 四项罪名成立。",
   "src": "/Users/k/Workon/Learning/web3/web3-security-101/handbook/video/skeuo/ep24/audio/lines/seg4-17.mp3",
   "start": 84.372,
   "dur": 6.0,
   "speechStart": 84.47,
   "speechEnd": 89.529
  },
  {
   "id": "seg4-18",
   "text": "法官经过专门听证，认定 Chainalysis Reactor 的分析可以作为证据。",
   "spoken": "法官经过专门听证，认定 Chainalysis Reactor 的分析可以作为证据。",
   "src": "/Users/k/Workon/Learning/web3/web3-security-101/handbook/video/skeuo/ep24/audio/lines/seg4-18.mp3",
   "start": 90.592,
   "dur": 5.784,
   "speechStart": 90.69,
   "speechEnd": 95.535
  },
  {
   "id": "seg4-19",
