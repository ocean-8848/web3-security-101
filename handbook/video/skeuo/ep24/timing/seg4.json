 "captions": [
  {
   "text": "数据之外",
   "start": 1.648,
   "end": 2.627,
   "id": "c0"
  },
  {
   "text": "还有一种暴露",
   "start": 2.802,
   "end": 3.818,
   "id": "c1"
  },
  {
   "text": "来自链本身",
   "start": 3.933,
   "end": 4.949,
   "id": "c2"
  },
  {
   "text": "去匿名化",
   "start": 5.948,
   "end": 7.034,
   "id": "c3"
  },
  {
   "text": "就是把匿名的链上地址",
   "start": 7.15,
   "end": 8.951,
   "id": "c4"
  },
  {
   "text": "关联到真实的身份",
   "start": 8.971,
   "end": 10.451,
   "id": "c5"
  },
  {
   "text": "链上分析先把地址聚成一个个实体",
   "start": 11.448,
   "end": 14.391,
   "id": "c6"
  },
  {
   "text": "再把实体对上真人",
   "start": 14.483,
   "end": 16.058,
   "id": "c7"
  },
  {
   "text": "第一种方法",
   "start": 17.044,
   "end": 18.059,
   "id": "c8"
  },
  {
   "text": "共同输入",
   "start": 18.163,
   "end": 19.095,
   "id": "c9"
  },
  {
   "text": "一笔比特币交易的多个输入",
   "start": 20.096,
   "end": 22.063,
   "id": "c10"
  },
  {
   "text": "大概率属于同一个所有者",
   "start": 22.179,
   "end": 23.992,
   "id": "c11"
  },
  {
   "text": "第二种 找零地址",
   "start": 24.972,
   "end": 26.773,
   "id": "c12"
  },
  {
   "text": "认出交易里找零给自己的那个输出",
   "start": 26.96,
   "end": 29.511,
   "id": "c13"
  },
  {
   "text": "第三种 交易所出入金",
   "start": 30.496,
   "end": 32.618,
   "id": "c14"
  },
  {
   "text": "地址跟交易所的充值地址有往来",
   "start": 33.596,
   "end": 36.266,
   "id": "c15"
  },
  {
   "text": "而交易所掌握 KYC",
   "start": 36.465,
   "end": 38.42,
   "id": "c16"
  },
  {
   "text": "第四种 跨链",
   "start": 39.408,
   "end": 40.875,
   "id": "c17"
  },
  {
   "text": "跨混币器的时间和金额模式",
   "start": 40.991,
   "end": 43.459,
   "id": "c18"
  },
  {
   "text": "第五种 链下关联",
   "start": 44.452,
   "end": 46.241,
   "id": "c19"
  },
  {
   "text": "ENS 名称",
   "start": 46.464,
   "end": 47.491,
   "id": "c20"
  },
  {
   "text": "社交媒体上贴出的地址",
   "start": 47.654,
   "end": 49.622,
   "id": "c21"
  },
  {
   "text": "NFT 头像",
   "start": 49.702,
   "end": 50.919,
   "id": "c22"
  },
  {
   "text": "这些都是启发式规则 会误判",
   "start": 51.92,
   "end": 54.935,
   "id": "c23"
  },
  {
   "text": "比如一笔交易",
   "start": 55.908,
   "end": 57.03,
   "id": "c24"
  },
  {
   "text": "有 4 个输入",
   "start": 57.098,
   "end": 58.137,
   "id": "c25"
  },
  {
   "text": "4 个金额相等的输出",
   "start": 58.217,
   "end": 59.839,
   "id": "c26"
  },
  {
   "text": "共同输入规则",
   "start": 60.832,
   "end": 62.157,
   "id": "c27"
  },
  {
   "text": "会把 4 个输入",
   "start": 62.177,
   "end": 63.299,
   "id": "c28"
  },
  {
   "text": "归给同一个人",
   "start": 63.344,
   "end": 64.442,
   "id": "c29"
  },
  {
   "text": "可这是典型的 CoinJoin",
   "start": 65.42,
   "end": 67.435,
   "id": "c30"
  },
  {
   "text": "可能是 4 个人各出一个输入",
   "start": 67.479,
   "end": 69.328,
   "id": "c31"
  },
  {
   "text": "聚到一起",
   "start": 70.32,
   "end": 71.168,
   "id": "c32"
  },
  {
   "text": "一个人的 KYC 身份",
   "start": 71.391,
   "end": 72.99,
   "id": "c33"
  },
  {
   "text": "就扩散到了另外 3 个人身上",
   "start": 73.01,
   "end": 74.882,
   "id": "c34"
  },
  {
   "text": "这套方法",
   "start": 75.868,
   "end": 76.93,
   "id": "c35"
  },
  {
   "text": "已经走进了法庭",
   "start": 77.022,
   "end": 78.276,
   "id": "c36"
  },
  {
   "text": "Bitcoin Fog 是一个混币器",
   "start": 79.256,
   "end": 81.39,
   "id": "c37"
  },
  {
   "text": "经手 120 万余枚比特币",
   "start": 81.577,
   "end": 83.437,
   "id": "c38"
  },
  {
