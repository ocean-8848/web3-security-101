 "captions": [
  {
   "text": "最后 按角色",
   "start": 1.648,
   "end": 3.365,
   "id": "c0"
  },
  {
   "text": "每个人今天就能做一件事",
   "start": 3.457,
   "end": 5.056,
   "id": "c1"
  },
  {
   "text": "签名工程师",
   "start": 6.044,
   "end": 7.237,
   "id": "c2"
  },
  {
   "text": "列出所有能到达签名节点的调用路径",
   "start": 7.282,
   "end": 10.035,
   "id": "c3"
  },
  {
   "text": "找出没经过策略引擎的那一条",
   "start": 10.198,
   "end": 12.428,
   "id": "c4"
  },
  {
   "text": "多签签名人",
   "start": 13.416,
   "end": 14.538,
   "id": "c5"
  },
  {
   "text": "换一台设备",
   "start": 14.558,
   "end": 15.562,
   "id": "c6"
  },
  {
   "text": "独立重新计算下一笔交易的哈希",
   "start": 15.713,
   "end": 18.014,
   "id": "c7"
  },
  {
   "text": "别和前端用同一个来源",
   "start": 18.118,
   "end": 19.824,
   "id": "c8"
  },
  {
   "text": "运维 扫描开发电脑上的生产令牌",
   "start": 20.812,
   "end": 24.029,
   "id": "c9"
  },
  {
   "text": "看看一台失陷的电脑",
   "start": 24.133,
   "end": 25.684,
   "id": "c10"
  },
  {
   "text": "能部署到哪里",
   "start": 25.752,
   "end": 26.886,
   "id": "c11"
  },
  {
   "text": "安全工程师",
   "start": 27.872,
   "end": 28.959,
   "id": "c12"
  },
  {
   "text": "在测试网发一笔 7702 授权请求",
   "start": 28.979,
   "end": 32.196,
   "id": "c13"
  },
  {
   "text": "看策略拒没拒",
   "start": 32.395,
   "end": 33.696,
   "id": "c14"
  },
  {
   "text": "告警响没响",
   "start": 33.717,
   "end": 34.792,
   "id": "c15"
  },
  {
   "text": "事故指挥官",
   "start": 35.772,
   "end": 36.954,
   "id": "c16"
  },
  {
   "text": "主持一次撤销演练",
   "start": 37.034,
   "end": 38.573,
   "id": "c17"
  },
  {
   "text": "暂停提现之后",
   "start": 38.936,
   "end": 40.213,
   "id": "c18"
  },
  {
   "text": "你怎么确认链上授权已经清掉",
   "start": 40.305,
   "end": 42.737,
   "id": "c19"
  },
  {
   "text": "回到开头的问题",
   "start": 44.0,
   "end": 45.384,
   "id": "c20"
  },
  {
   "text": "钥匙还在",
   "start": 45.759,
   "end": 46.882,
   "id": "c21"
  },
  {
   "text": "钱为什么没了",
   "start": 46.985,
   "end": 48.048,
   "id": "c22"
  },
  {
   "text": "因为攻击者控制的不是钥匙",
   "start": 49.3,
   "end": 51.232,
   "id": "c23"
  },
  {
   "text": "是钥匙要盖的那份文件",
   "start": 51.514,
   "end": 53.648,
   "id": "c24"
  },
  {
   "text": "守住签名路径",
   "start": 54.632,
   "end": 55.909,
   "id": "c25"
  },
  {
   "text": "靠的不是哪一关特别强",
   "start": 55.929,
   "end": 57.659,
   "id": "c26"
  },
  {
   "text": "而是每一关都重新检查",
   "start": 57.858,
   "end": 59.873,
   "id": "c27"
  },
  {
   "text": "六起事件",
   "start": 60.852,
   "end": 61.855,
   "id": "c28"
  },
  {
   "text": "一条路径",
   "start": 62.03,
   "end": 62.962,
   "id": "c29"
  },
  {
   "text": "每一关都要重新检查",
   "start": 63.006,
   "end": 64.903,
   "id": "c30"
  },
  {
   "text": "下一集讲企业链的安全",
   "start": 65.278,
