 "captions": [
  {
   "text": "先把这条路画出来",
   "start": 1.648,
   "end": 3.079,
   "id": "c0"
  },
  {
   "text": "假设一位用户",
   "start": 4.052,
   "end": 5.114,
   "id": "c1"
  },
  {
   "text": "要从交易所提走 2 万 USDT",
   "start": 5.135,
   "end": 7.543,
   "id": "c2"
  },
  {
   "text": "这是示例",
   "start": 7.918,
   "end": 8.862,
   "id": "c3"
  },
  {
   "text": "第一关 业务意图",
   "start": 9.864,
   "end": 11.617,
   "id": "c4"
  },
  {
   "text": "用户点下提现",
   "start": 11.992,
   "end": 13.365,
   "id": "c5"
  },
  {
   "text": "账本里多了一张提现单",
   "start": 13.576,
   "end": 15.412,
   "id": "c6"
  },
  {
   "text": "第二关 请求构造",
   "start": 16.396,
   "end": 18.209,
   "id": "c7"
  },
  {
   "text": "钱包后台把这张单子",
   "start": 18.584,
   "end": 20.242,
   "id": "c8"
  },
  {
   "text": "翻译成一笔待签名的交易",
   "start": 20.31,
   "end": 22.087,
   "id": "c9"
  },
  {
   "text": "第三关 风控与审批",
   "start": 23.072,
   "end": 25.254,
   "id": "c10"
  },
  {
   "text": "规则检查金额和地址",
   "start": 25.629,
   "end": 27.287,
   "id": "c11"
  },
  {
   "text": "大额还要有人批准",
   "start": 27.438,
   "end": 29.192,
   "id": "c12"
  },
  {
   "text": "第四关 显示与解码",
   "start": 30.18,
   "end": 32.326,
   "id": "c13"
  },
  {
   "text": "审批的人看不懂原始字节",
   "start": 32.701,
   "end": 34.764,
   "id": "c14"
  },
  {
   "text": "他看到的",
   "start": 35.011,
   "end": 35.978,
   "id": "c15"
  },
  {
   "text": "是翻译出来的文字",
   "start": 36.011,
   "end": 37.335,
   "id": "c16"
  },
  {
   "text": "第五关 签名",
   "start": 38.32,
   "end": 40.025,
   "id": "c17"
  },
  {
   "text": "可能是 MPC 节点",
   "start": 40.377,
   "end": 42.273,
   "id": "c18"
  },
  {
   "text": "可能是硬件加密机",
   "start": 42.293,
   "end": 43.749,
   "id": "c19"
  },
  {
   "text": "也可能是多签的签名人",
   "start": 43.817,
   "end": 45.535,
   "id": "c20"
  },
  {
   "text": "第六关 广播",
   "start": 46.508,
   "end": 48.059,
   "id": "c21"
  },
  {
   "text": "签好的交易",
   "start": 48.422,
   "end": 49.485,
   "id": "c22"
  },
  {
   "text": "发到链上",
   "start": 49.612,
   "end": 50.58,
   "id": "c23"
  },
  {
   "text": "第七关 链上状态",
   "start": 51.552,
   "end": 53.495,
   "id": "c24"
  },
  {
   "text": "余额变了",
   "start": 53.871,
   "end": 54.874,
   "id": "c25"
  },
  {
   "text": "有时候 账户的代码和权限",
   "start": 55.24,
   "end": 57.814,
   "id": "c26"
  },
  {
   "text": "也会跟着变",
   "start": 57.942,
   "end": 58.803,
   "id": "c27"
  },
  {
   "text": "还有一条支线",
   "start": 59.788,
   "end": 61.017,
   "id": "c28"
  },
  {
   "text": "有些系统要先读链上数据",
   "start": 61.392,
   "end": 63.515,
   "id": "c29"
  },
  {
   "text": "再决定签不签",
   "start": 63.583,
   "end": 64.908,
   "id": "c30"
  },
  {
   "text": "这些数据",
   "start": 65.273,
   "end": 66.241,
   "id": "c31"
  },
  {
   "text": "来自 RPC 节点",
   "start": 66.261,
   "end": 67.765,
   "id": "c32"
  },
  {
   "text": "注意每一个箭头",
   "start": 68.744,
   "end": 70.128,
   "id": "c33"
  },
  {
   "text": "下游都默认",
   "start": 70.503,
   "end": 71.566,
   "id": "c34"
  },
  {
   "text": "上游已经检查过了",
   "start": 71.694,
   "end": 73.173,
   "id": "c35"
  },
  {
   "text": "从意图到链上",
   "start": 74.148,
   "end": 75.437,
   "id": "c36"
  },
  {
   "text": "这整条链路",
   "start": 75.552,
   "end": 76.794,
   "id": "c37"
  },
  {
   "text": "叫做签名路径",
   "start": 76.85,
   "end": 78.187,
   "id": "c38"
  },
  {
   "text": "私钥 只待在第五关",
   "start": 79.168,
   "end": 81.278,
   "id": "c39"
  },
  {
   "text": "攻击者要的",
   "start": 81.641,
   "end": 82.835,
   "id": "c40"
  },
  {
   "text": "只是让第五关",
   "start": 82.868,
   "end": 84.061,
   "id": "c41"
  },
  {
   "text": "签出他想要的东西",
   "start": 84.177,
   "end": 85.526,
   "id": "c42"
  }
 ]
