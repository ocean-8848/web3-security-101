 "captions": [
  {
   "text": "六起事件",
   "start": 1.648,
   "end": 2.735,
   "id": "c0"
  },
  {
   "text": "打在六个不同的位置",
   "start": 2.755,
   "end": 4.353,
   "id": "c1"
  },
  {
   "text": "结果却一样",
   "start": 4.729,
   "end": 5.732,
   "id": "c2"
  },
  {
   "text": "签名系统正常运行",
   "start": 5.931,
   "end": 7.732,
   "id": "c3"
  },
  {
   "text": "签出了攻击者想要的东西",
   "start": 7.752,
   "end": 9.482,
   "id": "c4"
  },
  {
   "text": "把它们叠在一起",
   "start": 10.484,
   "end": 11.773,
   "id": "c5"
  },
  {
   "text": "能看到三个共同点",
   "start": 11.912,
   "end": 13.392,
   "id": "c6"
  },
  {
   "text": "第一 校验放错了位置",
   "start": 14.376,
   "end": 16.45,
   "id": "c7"
  },
  {
   "text": "下游只检查请求的格式",
   "start": 16.826,
   "end": 18.9,
   "id": "c8"
  },
  {
   "text": "不检查请求背后",
   "start": 18.992,
   "end": 20.377,
   "id": "c9"
  },
  {
   "text": "有没有真实的业务",
   "start": 20.421,
   "end": 21.722,
   "id": "c10"
  },
  {
   "text": "第二 关键输入只有一个来源",
   "start": 22.708,
   "end": 25.199,
   "id": "c11"
  },
  {
   "text": "一块屏幕",
   "start": 25.574,
   "end": 26.494,
   "id": "c12"
  },
  {
   "text": "一组 RPC",
   "start": 26.634,
   "end": 27.804,
   "id": "c13"
  },
  {
   "text": "一个发布包",
   "start": 27.824,
   "end": 28.709,
   "id": "c14"
  },
  {
   "text": "一条审批路径",
   "start": 28.729,
   "end": 29.911,
   "id": "c15"
  },
  {
   "text": "第三 响应只管链下",
   "start": 30.896,
   "end": 33.054,
   "id": "c16"
  },
  {
   "text": "关掉服务",
   "start": 33.417,
   "end": 34.385,
   "id": "c17"
  },
  {
   "text": "也无法改变已经写在链上的状态",
   "start": 34.488,
   "end": 36.789,
   "id": "c18"
  },
  {
   "text": "回到开头那句话",
   "start": 37.788,
   "end": 39.16,
   "id": "c19"
  },
  {
   "text": "私钥保护",
   "start": 39.523,
   "end": 40.515,
   "id": "c20"
  },
  {
   "text": "回答的是谁拿着钥匙",
   "start": 40.666,
   "end": 42.55,
   "id": "c21"
  },
  {
   "text": "签名路径",
   "start": 43.552,
   "end": 44.626,
   "id": "c22"
  },
  {
   "text": "回答的是谁决定",
   "start": 44.718,
   "end": 46.103,
   "id": "c23"
  },
  {
   "text": "钥匙盖在什么文件上",
   "start": 46.266,
   "end": 47.686,
   "id": "c24"
  },
  {
   "text": "所以防御也是三条",
   "start": 48.668,
   "end": 50.683,
   "id": "c25"
  },
  {
   "text": "第一 每一层都重新检查",
   "start": 51.046,
   "end": 53.407,
   "id": "c26"
  },
  {
   "text": "不继承上一层的结论",
   "start": 53.475,
   "end": 54.895,
   "id": "c27"
  },
  {
   "text": "第二 关键输入要有多个独立来源",
   "start": 55.896,
   "end": 58.78,
   "id": "c28"
  },
  {
   "text": "对不上就拒签",
