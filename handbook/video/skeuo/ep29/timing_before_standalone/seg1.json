 "captions": [
  {
   "text": "2025 年 2 月 21 日",
   "start": 0.653,
   "end": 2.941,
   "id": "c0"
  },
  {
   "text": "Bybit 的以太坊冷钱包",
   "start": 3.179,
   "end": 5.261,
   "id": "c1"
  },
  {
   "text": "被转走了大约 15 亿美元",
   "start": 5.409,
   "end": 7.662,
   "id": "c2"
  },
  {
   "text": "私钥 没有泄露",
   "start": 7.89,
   "end": 9.364,
   "id": "c3"
  },
  {
   "text": "签名人按照流程",
   "start": 9.627,
   "end": 11.155,
   "id": "c4"
  },
  {
   "text": "一个一个",
   "start": 11.299,
   "end": 12.11,
   "id": "c5"
  },
  {
   "text": "按下了确认",
   "start": 12.275,
   "end": 13.229,
   "id": "c6"
  },
  {
   "text": "屏幕上显示的",
   "start": 13.47,
   "end": 14.611,
   "id": "c7"
  },
  {
   "text": "是一笔普通的转账",
   "start": 14.71,
   "end": 16.195,
   "id": "c8"
  },
  {
   "text": "而真正签下去的交易",
   "start": 16.49,
   "end": 18.262,
   "id": "c9"
  },
  {
   "text": "多了一个参数",
   "start": 18.463,
   "end": 19.452,
   "id": "c10"
  },
  {
   "text": "operation 等于 1",
   "start": 19.843,
   "end": 21.751,
   "id": "c11"
  },
  {
   "text": "就这一个数字",
   "start": 21.99,
   "end": 23.124,
   "id": "c12"
  },
  {
   "text": "让钱包去执行了攻击者的代码",
   "start": 23.382,
   "end": 25.985,
   "id": "c13"
  },
  {
   "text": "把自己的实现合约",
   "start": 26.328,
   "end": 27.843,
   "id": "c14"
  },
  {
   "text": "换成了攻击者的",
   "start": 28.005,
   "end": 29.624,
   "id": "c15"
  },
  {
   "text": "钥匙 一直锁得好好的",
   "start": 29.89,
   "end": 32.031,
   "id": "c16"
  },
  {
   "text": "攻击者控制的",
   "start": 32.233,
   "end": 33.953,
   "id": "c17"
  },
  {
   "text": "是钥匙盖在什么文件上",
   "start": 34.054,
   "end": 35.834,
   "id": "c18"
  },
  {
   "text": "这一集 我们跟着一笔交易",
   "start": 36.128,
   "end": 38.539,
   "id": "c19"
  },
  {
   "text": "走完它从提出",
   "start": 38.755,
   "end": 40.201,
   "id": "c20"
  },
  {
   "text": "到上链的七道关",
   "start": 40.221,
   "end": 41.832,
   "id": "c21"
  }
 ]
