 "captions": [
  {
   "text": "最后 按角色",
   "start": 1.55,
   "end": 3.038,
   "id": "c0"
  },
  {
   "text": "每个人今天就能做一件事",
   "start": 3.251,
   "end": 5.163,
   "id": "c1"
  },
  {
   "text": "签名工程师",
   "start": 5.45,
   "end": 6.568,
   "id": "c2"
  },
  {
   "text": "列出所有能到达签名节点的调用路径",
   "start": 6.652,
   "end": 10.026,
   "id": "c3"
  },
  {
   "text": "找出没经过策略引擎的那一条",
   "start": 10.23,
   "end": 12.844,
   "id": "c4"
  },
  {
   "text": "多签签名人",
   "start": 13.213,
   "end": 14.22,
   "id": "c5"
  },
  {
   "text": "换一台设备",
   "start": 14.42,
   "end": 15.346,
   "id": "c6"
  },
  {
   "text": "独立重新计算下一笔交易的哈希",
   "start": 15.672,
   "end": 18.413,
   "id": "c7"
  },
  {
   "text": "别和前端用同一个来源",
   "start": 18.629,
   "end": 20.484,
   "id": "c8"
  },
  {
   "text": "运维 扫描开发电脑上的生产令牌",
   "start": 20.77,
   "end": 24.197,
   "id": "c9"
  },
  {
   "text": "看看一台失陷的电脑",
   "start": 24.662,
   "end": 26.299,
   "id": "c10"
  },
  {
   "text": "能部署到哪里",
   "start": 26.422,
   "end": 27.523,
   "id": "c11"
  },
  {
   "text": "安全工程师",
   "start": 27.888,
   "end": 29.005,
   "id": "c12"
  },
  {
   "text": "在测试网发一笔 7702 授权请求",
   "start": 29.151,
   "end": 32.949,
   "id": "c13"
  },
  {
   "text": "看策略拒没拒",
   "start": 33.297,
   "end": 34.59,
   "id": "c14"
  },
  {
   "text": "告警响没响",
   "start": 34.718,
   "end": 35.829,
   "id": "c15"
  },
  {
   "text": "事故指挥官",
   "start": 36.09,
   "end": 37.245,
   "id": "c16"
  },
  {
   "text": "主持一次撤销演练",
   "start": 37.265,
   "end": 38.85,
   "id": "c17"
  },
  {
   "text": "暂停提现之后",
   "start": 39.104,
   "end": 40.211,
   "id": "c18"
  },
  {
   "text": "你怎么确认链上授权已经清掉",
   "start": 40.343,
   "end": 42.746,
   "id": "c19"
  },
  {
   "text": "回到开头的问题",
   "start": 43.31,
   "end": 44.733,
   "id": "c20"
  },
  {
   "text": "钥匙还在",
   "start": 44.975,
   "end": 45.815,
   "id": "c21"
  },
  {
   "text": "钱为什么没了",
   "start": 46.031,
   "end": 47.251,
   "id": "c22"
  },
  {
   "text": "因为攻击者控制的不是钥匙",
   "start": 47.73,
   "end": 50.12,
   "id": "c23"
  },
  {
   "text": "是钥匙要盖的那份文件",
   "start": 50.424,
   "end": 52.595,
   "id": "c24"
  },
  {
   "text": "守住签名路径",
   "start": 52.923,
   "end": 54.271,
   "id": "c25"
  },
  {
   "text": "靠的不是哪一关特别强",
   "start": 54.55,
   "end": 56.387,
   "id": "c26"
  },
  {
   "text": "而是每一关都重新检查",
   "start": 56.588,
   "end": 58.826,
   "id": "c27"
  },
  {
   "text": "六起事件",
   "start": 59.143,
   "end": 60.07,
   "id": "c28"
  },
  {
   "text": "一条路径",
   "start": 60.09,
   "end": 60.898,
   "id": "c29"
  },
  {
   "text": "每一关都要重新检查",
   "start": 61.08,
   "end": 63.09,
   "id": "c30"
  },
  {
   "text": "下一集讲企业链的安全",
   "start": 63.328,
   "end": 65.399,
   "id": "c31"
  }
 ]
