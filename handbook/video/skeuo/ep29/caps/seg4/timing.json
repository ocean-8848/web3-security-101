 "captions": [
  {
   "text": "六起事件",
   "start": 1.641,
   "end": 2.655,
   "id": "c0"
  },
  {
   "text": "打在六个不同的位置",
   "start": 2.746,
   "end": 4.459,
   "id": "c1"
  },
  {
   "text": "结果却一样",
   "start": 4.651,
   "end": 5.871,
   "id": "c2"
  },
  {
   "text": "签名系统正常运行",
   "start": 6.204,
   "end": 8.119,
   "id": "c3"
  },
  {
   "text": "签出了攻击者想要的东西",
   "start": 8.258,
   "end": 10.646,
   "id": "c4"
  },
  {
   "text": "把它们叠在一起",
   "start": 10.982,
   "end": 12.426,
   "id": "c5"
  },
  {
   "text": "能看到三个共同点",
   "start": 12.532,
   "end": 14.14,
   "id": "c6"
  },
  {
   "text": "第一 校验放错了位置",
   "start": 14.486,
   "end": 16.663,
   "id": "c7"
  },
  {
   "text": "下游只检查请求的格式",
   "start": 16.84,
   "end": 19.155,
   "id": "c8"
  },
  {
   "text": "不检查请求背后",
   "start": 19.395,
   "end": 21.098,
   "id": "c9"
  },
  {
   "text": "有没有真实的业务",
   "start": 21.18,
   "end": 22.638,
   "id": "c10"
  },
  {
   "text": "第二 关键输入只有一个来源",
   "start": 22.93,
   "end": 25.778,
   "id": "c11"
  },
  {
   "text": "一块屏幕",
   "start": 26.356,
   "end": 27.111,
   "id": "c12"
  },
  {
   "text": "一组 RPC",
   "start": 27.252,
   "end": 28.142,
   "id": "c13"
  },
  {
   "text": "一个发布包",
   "start": 28.229,
   "end": 29.044,
   "id": "c14"
  },
  {
   "text": "一条审批路径",
   "start": 29.219,
   "end": 30.418,
   "id": "c15"
  },
  {
   "text": "第三 响应只管链下",
   "start": 30.67,
   "end": 32.821,
   "id": "c16"
  },
  {
   "text": "关掉服务",
   "start": 33.077,
   "end": 33.907,
   "id": "c17"
  },
  {
   "text": "也无法改变已经写在链上的状态",
   "start": 33.982,
   "end": 36.78,
   "id": "c18"
  },
  {
   "text": "回到开头那句话",
   "start": 37.144,
   "end": 38.244,
   "id": "c19"
  },
  {
   "text": "私钥保护",
   "start": 38.381,
   "end": 39.442,
   "id": "c20"
  },
  {
   "text": "回答的是谁拿着钥匙",
   "start": 39.676,
   "end": 41.71,
   "id": "c21"
  },
  {
   "text": "签名路径",
   "start": 42.084,
   "end": 42.996,
   "id": "c22"
  },
  {
   "text": "回答的是谁决定",
   "start": 43.152,
   "end": 44.829,
   "id": "c23"
  },
  {
   "text": "钥匙盖在什么文件上",
   "start": 45.068,
   "end": 46.856,
   "id": "c24"
  },
  {
   "text": "所以防御也是三条",
   "start": 47.09,
   "end": 49.214,
   "id": "c25"
  },
  {
   "text": "第一 每一层都重新检查",
   "start": 49.341,
   "end": 51.703,
   "id": "c26"
  },
  {
   "text": "不继承上一层的结论",
   "start": 51.837,
   "end": 53.419,
   "id": "c27"
  },
  {
   "text": "第二 关键输入要有多个独立来源",
   "start": 53.63,
   "end": 56.517,
   "id": "c28"
  },
  {
   "text": "对不上就拒签",
   "start": 56.617,
   "end": 57.875,
   "id": "c29"
  },
  {
   "text": "不自动切换",
   "start": 57.966,
   "end": 58.897,
   "id": "c30"
  },
  {
   "text": "第三 响应要覆盖链上状态",
   "start": 59.13,
   "end": 62.263,
   "id": "c31"
  },
  {
   "text": "暂停提现",
   "start": 62.529,
   "end": 63.519,
   "id": "c32"
  },
  {
   "text": "不等于撤销权限",
   "start": 63.686,
   "end": 65.235,
   "id": "c33"
  }
 ]
}