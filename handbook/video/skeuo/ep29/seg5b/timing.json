 "captions": [
  {
   "text": "最后按角色",
   "start": 1.647,
   "end": 3.356,
   "id": "c0"
  },
  {
   "text": "每个人今天就能做一件事",
   "start": 3.446,
   "end": 5.037,
   "id": "c1"
  },
  {
   "text": "签名工程师",
   "start": 6.02,
   "end": 7.213,
   "id": "c2"
  },
  {
   "text": "列出所有能到达签名节点的调用路径",
   "start": 7.258,
   "end": 10.011,
   "id": "c3"
  },
  {
   "text": "找出没经过策略引擎的那一条",
   "start": 10.174,
   "end": 12.404,
   "id": "c4"
  },
  {
   "text": "多签签名人",
   "start": 13.387,
   "end": 14.461,
   "id": "c5"
  },
  {
   "text": "换一台设备",
   "start": 14.481,
   "end": 15.448,
   "id": "c6"
  },
  {
   "text": "独立重新计算下一笔交易的哈希",
   "start": 15.585,
   "end": 17.793,
   "id": "c7"
  },
  {
   "text": "别和前端用同一个来源",
   "start": 17.885,
   "end": 19.524,
   "id": "c8"
  },
  {
   "text": "运维扫描开发电脑上的生产令牌",
   "start": 20.476,
   "end": 23.693,
   "id": "c9"
  },
  {
   "text": "看看一台失陷的电脑",
   "start": 23.797,
   "end": 25.348,
   "id": "c10"
  },
  {
   "text": "能部署到哪里",
   "start": 25.416,
   "end": 26.55,
   "id": "c11"
  },
  {
   "text": "安全工程师",
   "start": 27.536,
   "end": 28.623,
   "id": "c12"
  },
  {
   "text": "在测试网发一笔 7702 授权请求",
   "start": 28.643,
   "end": 31.86,
   "id": "c13"
  },
  {
   "text": "看策略拒没拒",
   "start": 32.059,
   "end": 33.36,
   "id": "c14"
  },
  {
   "text": "告警响没响",
   "start": 33.381,
   "end": 34.456,
   "id": "c15"
  },
  {
   "text": "事故指挥官",
   "start": 35.436,
   "end": 36.618,
   "id": "c16"
  },
  {
   "text": "主持一次撤销演练",
   "start": 36.698,
   "end": 38.237,
   "id": "c17"
  },
  {
   "text": "暂停提现之后",
   "start": 38.6,
   "end": 39.877,
   "id": "c18"
  },
  {
   "text": "你怎么确认链上授权已经清掉",
   "start": 39.969,
   "end": 42.401,
   "id": "c19"
  },
  {
   "text": "回到开头的问题",
   "start": 43.664,
   "end": 45.048,
   "id": "c20"
  },
  {
   "text": "钥匙还在",
   "start": 45.423,
   "end": 46.546,
   "id": "c21"
  },
  {
   "text": "钱为什么没了",
   "start": 46.649,
   "end": 47.712,
   "id": "c22"
  },
  {
   "text": "因为攻击者控制的不是钥匙",
   "start": 48.964,
   "end": 50.896,
   "id": "c23"
  },
  {
   "text": "是钥匙要盖的那份文件",
   "start": 51.178,
   "end": 53.312,
   "id": "c24"
  },
  {
   "text": "守住签名路径",
   "start": 54.296,
   "end": 55.573,
   "id": "c25"
  },
  {
   "text": "靠的不是哪一关特别强",
   "start": 55.593,
   "end": 57.323,
   "id": "c26"
  },
  {
   "text": "而是每一关都重新检查",
   "start": 57.522,
   "end": 59.537,
   "id": "c27"
  },
  {
   "text": "六起事件的来源和细节",
   "start": 60.516,
   "end": 62.507,
   "id": "c28"
  },
  {
   "text": "都在手册第 29 章",
   "start": 62.575,
   "end": 64.209,
   "id": "c29"
  },
  {
   "text": "我们下一集见",
   "start": 64.561,
   "end": 65.743,
   "id": "c30"
  }
 ]
