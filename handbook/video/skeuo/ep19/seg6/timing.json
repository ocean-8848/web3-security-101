 "captions": [
  {
   "text": "如果你是普通用户",
   "start": 1.642,
   "end": 3.21,
   "id": "c0"
  },
  {
   "text": "先记住几条",
   "start": 3.312,
   "end": 4.303,
   "id": "c1"
  },
  {
   "text": "官方从不要求你签名领取空投",
   "start": 4.665,
   "end": 7.204,
   "id": "c2"
  },
  {
   "text": "或者签名验证钱包",
   "start": 7.379,
   "end": 8.956,
   "id": "c3"
  },
  {
   "text": "签名前看三样",
   "start": 9.19,
   "end": 10.681,
   "id": "c4"
  },
  {
   "text": "授权给谁",
   "start": 10.872,
   "end": 11.922,
   "id": "c5"
  },
  {
   "text": "授权多少",
   "start": 12.072,
   "end": 13.114,
   "id": "c6"
  },
  {
   "text": "到什么时候",
   "start": 13.296,
   "end": 14.291,
   "id": "c7"
  },
  {
   "text": "看不懂就不签",
   "start": 14.625,
   "end": 16.052,
   "id": "c8"
  },
  {
   "text": "不花 Gas",
   "start": 16.159,
   "end": 16.959,
   "id": "c9"
  },
  {
   "text": "不等于没有风险",
   "start": 17.028,
   "end": 18.493,
   "id": "c10"
  },
  {
   "text": "大额资产和日常交互",
   "start": 18.85,
   "end": 20.972,
   "id": "c11"
  },
  {
   "text": "用不同的钱包",
   "start": 20.998,
   "end": 22.244,
   "id": "c12"
  },
  {
   "text": "每个月撤销不用的授权",
   "start": 22.49,
   "end": 24.471,
   "id": "c13"
  },
  {
   "text": "买新币前",
   "start": 24.687,
   "end": 25.638,
   "id": "c14"
  },
  {
   "text": "先确认它能卖出去",
   "start": 25.658,
   "end": 27.287,
   "id": "c15"
  },
  {
   "text": "已经签下钓鱼签名",
   "start": 27.685,
   "end": 29.338,
   "id": "c16"
  },
  {
   "text": "就立刻撤销授权",
   "start": 29.483,
   "end": 31.145,
   "id": "c17"
  },
  {
   "text": "把剩余资产转到新地址",
   "start": 31.353,
   "end": 33.289,
   "id": "c18"
  },
  {
   "text": "如果你做钱包产品",
   "start": 33.583,
   "end": 35.069,
   "id": "c19"
  },
  {
   "text": "今天就查一件事",
   "start": 35.138,
   "end": 36.431,
   "id": "c20"
  },
  {
   "text": "签名请求能不能解码成可读字段",
   "start": 36.845,
   "end": 39.534,
   "id": "c21"
  },
  {
   "text": "如果你在交易所",
   "start": 39.886,
   "end": 41.183,
   "id": "c22"
  },
  {
   "text": "查一查提币时有没有比对首尾相同的历史地址",
   "start": 41.59,
   "end": 45.557,
   "id": "c23"
  },
  {
   "text": "回到开头的问题",
   "start": 45.77,
   "end": 47.121,
   "id": "c24"
  },
  {
   "text": "测试转账已经到账",
   "start": 47.35,
   "end": 49.185,
   "id": "c25"
  },
  {
   "text": "从记录里复制地址",
   "start": 49.508,
   "end": 50.94,
   "id": "c26"
  },
  {
   "text": "并不安全",
   "start": 50.96,
   "end": 51.668,
   "id": "c27"
  },
  {
   "text": "测试只证明那一刻的地址是对的",
   "start": 52.069,
   "end": 54.625,
   "id": "c28"
  },
  {
   "text": "证明不了你之后复制的是同一个",
   "start": 54.96,
   "end": 57.459,
   "id": "c29"
  },
  {
   "text": "地址要从地址簿",
   "start": 57.806,
   "end": 59.369,
   "id": "c30"
  },
  {
   "text": "或者收款方的安全渠道取",
   "start": 59.45,
   "end": 61.736,
   "id": "c31"
  },
  {
   "text": "再核对完整地址",
   "start": 62.018,
   "end": 63.491,
   "id": "c32"
  },
  {
   "text": "不只看首尾",
   "start": 63.71,
   "end": 64.808,
   "id": "c33"
  },
  {
   "text": "私钥完好无损",
   "start": 65.05,
   "end": 66.436,
   "id": "c34"
  },
  {
   "text": "资产也可能没了",
   "start": 66.478,
   "end": 67.919,
   "id": "c35"
  },
  {
   "text": "每次确认之前",
   "start": 68.355,
   "end": 69.528,
   "id": "c36"
  },
  {
   "text": "先看清你在签什么",
   "start": 69.589,
   "end": 71.267,
   "id": "c37"
  },
  {
   "text": "下一集讲前端",
   "start": 71.608,
   "end": 73.11,
   "id": "c38"
  },
  {
   "text": "DNS 与供应链安全",
   "start": 73.258,
   "end": 75.369,
   "id": "c39"
  }
 ]
