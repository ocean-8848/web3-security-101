   "id": "c10"
  },
  {
   "text": "假空投和私信里",
   "start": 24.251,
   "end": 25.826,
   "id": "c11"
  },
  {
   "text": "受害者一签名",
   "start": 26.796,
   "end": 28.145,
   "id": "c12"
  },
  {
   "text": "转走的资产自动分账",
   "start": 28.165,
   "end": 29.93,
   "id": "c13"
  },
  {
   "text": "公开分析显示",
   "start": 30.928,
   "end": 32.121,
   "id": "c14"
  },
  {
   "text": "开发者抽成约 20%",
   "start": 32.213,
   "end": 34.217,
   "id": "c15"
  },
  {
   "text": "分发者拿约 80%",
   "start": 34.332,
   "end": 36.014,
   "id": "c16"
  },
  {
   "text": "各家套件的比例不同 也会变",
   "start": 37.004,
   "end": 39.531,
   "id": "c17"
  },
  {
   "text": "套件会先读你钱包里的余额",
   "start": 40.512,
   "end": 42.634,
   "id": "c18"
  },
  {
   "text": "按价值排序",
   "start": 42.75,
   "end": 43.932,
   "id": "c19"
  },
  {
   "text": "先请求最值钱的那个授权",
   "start": 44.071,
   "end": 46.122,
   "id": "c20"
  },
  {
   "text": "所以同一个钓鱼站",
   "start": 47.116,
   "end": 48.976,
   "id": "c21"
  },
  {
   "text": "对不同的人",
   "start": 49.139,
   "end": 50.191,
   "id": "c22"
  },
  {
   "text": "弹出的签名请求不一样",
   "start": 50.211,
   "end": 51.988,
   "id": "c23"
  },
  {
   "text": "Inferno Drainer",
   "start": 52.976,
   "end": 54.015,
   "id": "c24"
  },
  {
   "text": "在 2023 年 11 月宣布关停",
   "start": 54.035,
   "end": 56.479,
   "id": "c25"
  },
  {
   "text": "此前约 7000 万美元",
   "start": 56.547,
   "end": 58.348,
   "id": "c26"
  },
  {
   "text": "2025 年 5 月",
   "start": 59.34,
   "end": 60.546,
   "id": "c27"
  },
  {
   "text": "Check Point 发现它仍在运行",
   "start": 60.566,
   "end": 62.867,
   "id": "c28"
  },
  {
   "text": "半年内盗走约 900 万美元以上",
   "start": 63.042,
   "end": 65.343,
   "id": "c29"
  },
  {
   "text": "这次它在 Discord 冒充",
   "start": 66.328,
   "end": 68.07,
   "id": "c30"
  },
  {
   "text": "Collab.Land 引流",
   "start": 68.09,
   "end": 69.367,
   "id": "c31"
  },
  {
   "text": "受害者有 3 万多名",
   "start": 69.459,
   "end": 71.093,
   "id": "c32"
  },
  {
   "text": "Pink Drainer 在",
   "start": 72.068,
   "end": 73.024,
   "id": "c33"
  },
  {
   "text": "2024 年 5 月宣布退休",
   "start": 73.044,
   "end": 74.869,
   "id": "c34"
  },
  {
   "text": "约 2.1 万名受害者",
   "start": 74.996,
   "end": 76.559,
   "id": "c35"
  },
  {
   "text": "约 8500 万美元",
   "start": 76.627,
   "end": 78.119,
   "id": "c36"
  },
  {
   "text": "Angel Drainer 到 2024 年 2 月",
   "start": 79.104,
   "end": 81.476,
   "id": "c37"
  },
  {
   "text": "约 2500 万美元",
   "start": 81.627,
   "end": 83.143,
   "id": "c38"
  },
  {
   "text": "同年 7 月停止服务",
   "start": 83.175,
   "end": 84.821,
   "id": "c39"
  },
  {
   "text": "关停不等于消失",
   "start": 85.804,
   "end": 87.188,
   "id": "c40"
  },
  {
   "text": "套件代码和分发网络",
   "start": 87.327,
   "end": 88.986,
   "id": "c41"
  },
  {
   "text": "会换个名字回来",
   "start": 89.018,
   "end": 90.152,
   "id": "c42"
  },
  {
   "text": "整体看 2024 年的钓鱼损失约 4.94 亿美元",
   "start": 91.136,
   "end": 95.71,
   "id": "c43"
  },
  {
   "text": "其中百万美元以上的大案里",
   "start": 96.708,
   "end": 98.854,
   "id": "c44"
  },
  {
   "text": "permit 类占损失的 56.7%",
   "start": 99.029,
   "end": 101.854,
   "id": "c45"
  },
  {
   "text": "2025 年降到约 8385 万美元",
   "start": 102.856,
   "end": 105.907,
   "id": "c46"
  },
  {
   "text": "下降约 83%",
   "start": 105.987,
   "end": 107.609,
   "id": "c47"
  },
  {
   "text": "报告说 攻击转向小额和高频",
   "start": 108.596,
   "end": 111.516,
   "id": "c48"
  },
  {
   "text": "这个统计只算 EVM 链上的 Drainer 钓鱼",
   "start": 112.512,
   "end": 115.491,
   "id": "c49"
  },
  {
   "text": "不含私钥泄露和交易所被盗",
   "start": 115.559,
   "end": 117.789,
   "id": "c50"
  }
 ]
}