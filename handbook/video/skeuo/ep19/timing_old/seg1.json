 "lines": [
  {
   "id": "seg1-00",
   "text": "2025 年 12 月，一名用户要转出一大笔 USDT。",
   "spoken": "2025 年 12 月，一名用户要转出一大笔 USDT。",
   "src": "/Users/k/Workon/Learning/web3/web3-security-101/handbook/video/skeuo/ep19/audio/lines/seg1-00.wav",
   "start": 1.6,
   "dur": 4.8,
   "speechStart": 1.706,
   "speechEnd": 6.17
  },
  {
   "id": "seg1-01",
   "text": "他很谨慎，先转 50 USDT，测试收款地址。",
   "spoken": "他很谨慎，先转 50 USDT，测试收款地址。",
   "src": "/Users/k/Workon/Learning/web3/web3-security-101/handbook/video/skeuo/ep19/audio/lines/seg1-01.wav",
   "start": 6.62,
   "dur": 4.8,
   "speechStart": 6.62,
   "speechEnd": 11.246
  },
  {
   "id": "seg1-02",
   "text": "测试到账，地址没错。",
   "spoken": "测试到账，地址没错。",
   "src": "/Users/k/Workon/Learning/web3/web3-security-101/handbook/video/skeuo/ep19/audio/lines/seg1-02.wav",
   "start": 11.64,
   "dur": 2.08,
   "speechStart": 11.64,
   "speechEnd": 13.469
  },
  {
   "id": "seg1-03",
   "text": "几分钟后，他的交易记录里，多出一笔 0.005 USDT 的转账。",
   "spoken": "几分钟后，他的交易记录里，多出一笔 0.005 USDT 的转账。",
   "src": "/Users/k/Workon/Learning/web3/web3-security-101/handbook/video/skeuo/ep19/audio/lines/seg1-03.wav",
   "start": 13.94,
   "dur": 5.68,
   "speechStart": 13.94,
   "speechEnd": 19.378
  },
  {
   "id": "seg1-04",
   "text": "约 26 分钟后，他从记录里复制地址，转出约 5000 万美元。",
   "spoken": "约 26 分钟后，他从记录里复制地址，转出约 5000 万美元。",
   "src": "/Users/k/Workon/Learning/web3/web3-security-101/handbook/video/skeuo/ep19/audio/lines/seg1-04.wav",
   "start": 19.84,
   "dur": 5.76,
   "speechStart": 19.84,
   "speechEnd": 25.379
  },
  {
   "id": "seg1-05",
   "text": "这一笔，到了攻击者的地址。",
   "spoken": "这一笔，到了攻击者的地址。",
   "src": "/Users/k/Workon/Learning/web3/web3-security-101/handbook/video/skeuo/ep19/audio/lines/seg1-05.wav",
   "start": 25.82,
   "dur": 2.24,
   "speechStart": 25.915,
   "speechEnd": 27.868
  },
  {
   "id": "seg1-06",
   "text": "私钥没被偷，钱包也没被攻破。",
   "spoken": "私钥没被偷，钱包也没被攻破。",
   "src": "/Users/k/Workon/Learning/web3/web3-security-101/handbook/video/skeuo/ep19/audio/lines/seg1-06.wav",
   "start": 28.28,
   "dur": 3.12,
   "speechStart": 28.28,
   "speechEnd": 31.237
  },
  {
   "id": "seg1-07",
   "text": "每一步，都是他自己点的确认。",
   "spoken": "每一步，都是他自己点的确认。",
   "src": "/Users/k/Workon/Learning/web3/web3-security-101/handbook/video/skeuo/ep19/audio/lines/seg1-07.wav",
   "start": 31.62,
   "dur": 2.64,
   "speechStart": 31.71,
   "speechEnd": 34.029
  },
  {
   "id": "seg1-08",
   "text": "这类骗局不偷钥匙，它骗你自己动手。",
   "spoken": "这类骗局不偷钥匙，它骗你自己动手。",
   "src": "/Users/k/Workon/Learning/web3/web3-security-101/handbook/video/skeuo/ep19/audio/lines/seg1-08.wav",
   "start": 34.48,
   "dur": 3.92,
   "speechStart": 34.577,
   "speechEnd": 38.224
  },
  {
   "id": "seg1-09",
   "text": "先猜一道题。",
   "spoken": "先猜一道题。",
   "src": "/Users/k/Workon/Learning/web3/web3-security-101/handbook/video/skeuo/ep19/audio/lines/seg1-09.wav",
