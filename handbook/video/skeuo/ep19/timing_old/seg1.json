   "id": "c0"
  },
  {
   "text": "一名用户要转出一大笔 USDT",
   "start": 3.441,
   "end": 6.29,
   "id": "c1"
  },
  {
   "text": "他很谨慎",
   "start": 6.57,
   "end": 7.486,
   "id": "c2"
  },
  {
   "text": "先转 50 USDT",
   "start": 8.052,
   "end": 9.817,
   "id": "c3"
  },
  {
   "text": "测试收款地址",
