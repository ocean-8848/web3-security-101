  {
   "text": "它是一个放大器",
   "start": 6.113,
   "end": 7.271,
   "id": "c2"
  },
  {
   "text": "它让攻击者写钓鱼更快",
   "start": 8.256,
   "end": 10.033,
   "id": "c3"
  },
  {
   "text": "伪造视频更像",
   "start": 10.184,
   "end": 11.426,
   "id": "c4"
  },
  {
   "text": "找合约漏洞更便宜",
   "start": 11.458,
   "end": 12.997,
   "id": "c5"
  },
  {
   "text": "它也让防御者审计得更广",
   "start": 13.972,
   "end": 16.213,
   "id": "c6"
  },
  {
   "text": "监控得更快",
   "start": 16.281,
   "end": 17.344,
   "id": "c7"
  },
  {
   "text": "真正新的部分",
   "start": 18.32,
   "end": 19.692,
   "id": "c8"
  },
  {
   "text": "只有一个",
   "start": 19.784,
   "end": 20.597,
   "id": "c9"
  },
  {
   "text": "当 AI 智能体自己拿着钱包 说服它",
   "start": 21.588,
   "end": 25.413,
   "id": "c10"
  },
  {
   "text": "就成了转走资产的方法",
   "start": 25.433,
   "end": 27.103,
   "id": "c11"
  },
  {
   "text": "AI 智能体",
   "start": 28.096,
   "end": 29.338,
   "id": "c12"
  },
  {
   "text": "是能调用工具",
   "start": 29.358,
   "end": 30.587,
   "id": "c13"
  },
  {
   "text": "执行操作的大语言模型程序",
   "start": 30.655,
   "end": 32.861,
   "id": "c14"
  },
  {
   "text": "比如自动交易的机器人",
   "start": 33.86,
   "end": 35.601,
   "id": "c15"
  },
  {
   "text": "或者自动回复并打赏的机器人",
   "start": 35.633,
   "end": 37.934,
   "id": "c16"
  },
  {
   "text": "攻击它最直接的办法",
   "start": 38.928,
   "end": 40.598,
   "id": "c17"
  },
  {
   "text": "叫提示注入",
   "start": 40.618,
   "end": 41.848,
   "id": "c18"
  },
  {
   "text": "把指令藏在模型会读到的内容里",
   "start": 42.844,
   "end": 45.24,
   "id": "c19"
  },
  {
   "text": "让模型去执行攻击者的意图",
   "start": 45.379,
   "end": 47.668,
   "id": "c20"
  },
  {
   "text": "打个比方",
   "start": 48.656,
   "end": 49.564,
   "id": "c21"
  },
  {
   "text": "你雇了一个能干",
   "start": 49.703,
   "end": 50.778,
   "id": "c22"
  },
  {
   "text": "但极其听话的新助理",
   "start": 50.87,
   "end": 52.409,
   "id": "c23"
  },
  {
   "text": "还把公司的支付卡交给了他",
   "start": 52.56,
   "end": 54.457,
   "id": "c24"
  },
  {
   "text": "任何人走进办公室",
   "start": 55.428,
   "end": 56.907,
   "id": "c25"
  },
  {
   "text": "塞给他一张纸条",
   "start": 56.928,
   "end": 58.193,
   "id": "c26"
  },
  {
   "text": "写着老板说把钱转给我",
   "start": 58.38,
   "end": 60.431,
   "id": "c27"
  },
  {
   "text": "他都可能照做",
   "start": 60.666,
   "end": 61.752,
   "id": "c28"
  },
  {
   "text": "问题不在助理不够聪明",
   "start": 62.728,
   "end": 64.719,
   "id": "c29"
  },
  {
   "text": "而在你把支付卡",
   "start": 64.835,
   "end": 66.481,
   "id": "c30"
  },
  {
   "text": "交给了一个会被纸条说服的人",
   "start": 66.632,
   "end": 68.921,
   "id": "c31"
  },
  {
   "text": "这个比方有一处不成立",
   "start": 69.884,
   "end": 71.839,
   "id": "c32"
  },
  {
   "text": "真实的助理",
   "start": 72.816,
   "end": 74.069,
   "id": "c33"
  },
  {
   "text": "会记得谁是老板",
   "start": 74.161,
   "end": 75.414,
   "id": "c34"
  },
  {
   "text": "智能体的记忆",
   "start": 76.396,
   "end": 77.613,
   "id": "c35"
  },
  {
   "text": "本身也可能被人写进假内容",
   "start": 77.741,
   "end": 79.697,
   "id": "c36"
  },
  {
   "text": "按 AI 站在哪一边",
   "start": 80.696,
   "end": 82.306,
   "id": "c37"
  },
  {
   "text": "可以分成五个方向",
   "start": 82.35,
   "end": 83.651,
   "id": "c38"
  },
  {
   "text": "AI 是目标",
   "start": 84.636,
   "end": 85.758,
   "id": "c39"
  },
  {
   "text": "比如持有钱包的智能体",
   "start": 85.778,
   "end": 87.496,
   "id": "c40"
  },
  {
   "text": "AI 是攻击工具",
   "start": 88.48,
   "end": 89.971,
   "id": "c41"
  },
  {
   "text": "一边对着人",
   "start": 90.146,
   "end": 91.138,
   "id": "c42"
  },
  {
   "text": "一边对着代码",
   "start": 91.158,
   "end": 92.185,
   "id": "c43"
  },
  {
   "text": "AI 是开发工具 写合约 写配置 装插件",
   "start": 93.188,
   "end": 97.322,
   "id": "c44"
  },
  {
   "text": "AI 也是防御工具",
   "start": 98.304,
   "end": 100.033,
   "id": "c45"
  },
  {
   "text": "做审计初筛和监控告警",
   "start": 100.066,
   "end": 102.319,
   "id": "c46"
  },
  {
   "text": "先看最新的那一个",
   "start": 103.3,
   "end": 104.839,
   "id": "c47"
  },
  {
   "text": "持有钱包的智能体",
   "start": 104.859,
   "end": 106.41,
   "id": "c48"
  }
 ]
}