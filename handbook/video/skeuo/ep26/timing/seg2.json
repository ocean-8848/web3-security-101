 "lines": [
  {
   "id": "seg2-00",
   "text": "先给一句准确的说法。",
   "spoken": "先给一句准确的说法。",
   "src": "/Users/k/Workon/Learning/web3/web3-security-101/handbook/video/skeuo/ep26/audio/lines/seg2-00.mp3",
   "start": 1.6,
   "dur": 2.376,
   "speechStart": 1.698,
   "speechEnd": 3.126
  },
  {
   "id": "seg2-01",
   "text": "AI 不是一类新漏洞，它是一个放大器。",
   "spoken": "AI 不是一类新漏洞，它是一个放大器。",
   "src": "/Users/k/Workon/Learning/web3/web3-security-101/handbook/video/skeuo/ep26/audio/lines/seg2-01.mp3",
   "start": 4.196,
   "dur": 3.792,
   "speechStart": 4.294,
   "speechEnd": 7.151
  },
  {
   "id": "seg2-02",
   "text": "它让攻击者写钓鱼更快，伪造视频更像，找合约漏洞更便宜。",
   "spoken": "它让攻击者写钓鱼更快，伪造视频更像，找合约漏洞更便宜。",
   "src": "/Users/k/Workon/Learning/web3/web3-security-101/handbook/video/skeuo/ep26/audio/lines/seg2-02.mp3",
   "start": 8.208,
   "dur": 5.496,
   "speechStart": 8.306,
   "speechEnd": 12.877
  },
  {
   "id": "seg2-03",
   "text": "它也让防御者审计得更广，监控得更快。",
   "spoken": "它也让防御者审计得更广，监控得更快。",
   "src": "/Users/k/Workon/Learning/web3/web3-security-101/handbook/video/skeuo/ep26/audio/lines/seg2-03.mp3",
   "start": 13.924,
   "dur": 4.128,
   "speechStart": 14.022,
   "speechEnd": 17.224
  },
  {
   "id": "seg2-04",
   "text": "真正新的部分，只有一个。",
   "spoken": "真正新的部分，只有一个。",
   "src": "/Users/k/Workon/Learning/web3/web3-security-101/handbook/video/skeuo/ep26/audio/lines/seg2-04.mp3",
   "start": 18.272,
   "dur": 3.048,
   "speechStart": 18.37,
   "speechEnd": 20.477
  },
  {
   "id": "seg2-05",
   "text": "当 AI 智能体自己拿着钱包，说服它，就成了转走资产的方法。",
   "spoken": "当 AI 智能体自己拿着钱包，说服它，就成了转走资产的方法。",
   "src": "/Users/k/Workon/Learning/web3/web3-security-101/handbook/video/skeuo/ep26/audio/lines/seg2-05.mp3",
   "start": 21.54,
   "dur": 6.288,
   "speechStart": 21.638,
   "speechEnd": 26.983
  },
  {
   "id": "seg2-06",
   "text": "AI 智能体，是能调用工具、执行操作的大语言模型程序。",
   "spoken": "AI 智能体，是能掉用工具、执行操作的大语言模型程序。",
   "src": "/Users/k/Workon/Learning/web3/web3-security-101/handbook/video/skeuo/ep26/audio/lines/seg2-06.mp3",
   "start": 28.048,
   "dur": 5.544,
   "speechStart": 28.146,
   "speechEnd": 32.741
  },
  {
   "id": "seg2-07",
   "text": "比如自动交易的机器人，或者自动回复并打赏的机器人。",
   "spoken": "比如自动交易的机器人，或者自动回复并打赏的机器人。",
   "src": "/Users/k/Workon/Learning/web3/web3-security-101/handbook/video/skeuo/ep26/audio/lines/seg2-07.mp3",
   "start": 33.812,
   "dur": 4.848,
   "speechStart": 33.91,
   "speechEnd": 37.814
  },
  {
   "id": "seg2-08",
   "text": "攻击它最直接的办法，叫提示注入。",
   "spoken": "攻击它最直接的办法，叫提示注入。",
   "src": "/Users/k/Workon/Learning/web3/web3-security-101/handbook/video/skeuo/ep26/audio/lines/seg2-08.mp3",
   "start": 38.88,
   "dur": 3.696,
   "speechStart": 38.978,
   "speechEnd": 41.728
  },
  {
   "id": "seg2-09",
   "text": "把指令藏在模型会读到的内容里，让模型去执行攻击者的意图。",
   "spoken": "把指令藏在模型会读到的内容里，让模型去执行攻击者的意图。",
   "src": "/Users/k/Workon/Learning/web3/web3-security-101/handbook/video/skeuo/ep26/audio/lines/seg2-09.mp3",
   "start": 42.796,
   "dur": 5.592,
   "speechStart": 42.894,
   "speechEnd": 47.548
  },
  {
   "id": "seg2-10",
   "text": "打个比方，你雇了一个能干、但极其听话的新助理，还把公司的支付卡交给了他。",
   "spoken": "打个比方，你雇了一个能干、但极其听话的新助理，还把公司的支付卡交给了他。",
   "src": "/Users/k/Workon/Learning/web3/web3-security-101/handbook/video/skeuo/ep26/audio/lines/seg2-10.mp3",
   "start": 48.608,
   "dur": 6.552,
   "speechStart": 48.706,
   "speechEnd": 54.337
  },
  {
   "id": "seg2-11",
   "text": "任何人走进办公室，塞给他一张纸条，写着老板说把钱转给我，他都可能照做。",
   "spoken": "任何人走进办公室，塞给他一张纸条，写着老板说把钱转给我，他都可能照做。",
   "src": "/Users/k/Workon/Learning/web3/web3-security-101/handbook/video/skeuo/ep26/audio/lines/seg2-11.mp3",
   "start": 55.38,
   "dur": 7.08,
   "speechStart": 55.478,
   "speechEnd": 61.632
  },
  {
   "id": "seg2-12",
   "text": "问题不在助理不够聪明，而在你把支付卡，交给了一个会被纸条说服的人。",
   "spoken": "问题不在助理不够聪明，而在你把支付卡，交给了一个会被纸条说服的人。",
   "src": "/Users/k/Workon/Learning/web3/web3-security-101/handbook/video/skeuo/ep26/audio/lines/seg2-12.mp3",
   "start": 62.68,
   "dur": 6.936,
   "speechStart": 62.778,
   "speechEnd": 68.801
  },
  {
   "id": "seg2-13",
   "text": "这个比方有一处不成立。",
   "spoken": "这个比方有一处不成立。",
   "src": "/Users/k/Workon/Learning/web3/web3-security-101/handbook/video/skeuo/ep26/audio/lines/seg2-13.mp3",
   "start": 69.836,
   "dur": 2.712,
   "speechStart": 69.934,
   "speechEnd": 71.719
  },
  {
   "id": "seg2-14",
   "text": "真实的助理，会记得谁是老板。",
   "spoken": "真实的助理，会记得谁是老板。",
   "src": "/Users/k/Workon/Learning/web3/web3-security-101/handbook/video/skeuo/ep26/audio/lines/seg2-14.mp3",
   "start": 72.768,
   "dur": 3.36,
   "speechStart": 72.866,
   "speechEnd": 75.294
  },
  {
   "id": "seg2-15",
   "text": "智能体的记忆，本身也可能被人写进假内容。",
   "spoken": "智能体的记忆，本身也可能被人写进假内容。",
   "src": "/Users/k/Workon/Learning/web3/web3-security-101/handbook/video/skeuo/ep26/audio/lines/seg2-15.mp3",
   "start": 76.348,
   "dur": 4.08,
   "speechStart": 76.446,
   "speechEnd": 79.577
  },
  {
   "id": "seg2-16",
   "text": "按 AI 站在哪一边，可以分成五个方向。",
   "spoken": "按 AI 站在哪一边，可以分成五个方向。",
   "src": "/Users/k/Workon/Learning/web3/web3-security-101/handbook/video/skeuo/ep26/audio/lines/seg2-16.mp3",
   "start": 80.648,
   "dur": 3.72,
   "speechStart": 80.746,
   "speechEnd": 83.531
  },
  {
   "id": "seg2-17",
   "text": "AI 是目标，比如持有钱包的智能体。",
   "spoken": "AI 是目标，比如持有钱包的智能体。",
   "src": "/Users/k/Workon/Learning/web3/web3-security-101/handbook/video/skeuo/ep26/audio/lines/seg2-17.mp3",
   "start": 84.588,
   "dur": 3.624,
   "speechStart": 84.686,
   "speechEnd": 87.376
  },
  {
   "id": "seg2-18",
   "text": "AI 是攻击工具，一边对着人，一边对着代码。",
   "spoken": "AI 是攻击工具，一边对着人，一边对着代码。",
   "src": "/Users/k/Workon/Learning/web3/web3-security-101/handbook/video/skeuo/ep26/audio/lines/seg2-18.mp3",
   "start": 88.432,
   "dur": 4.488,
   "speechStart": 88.53,
   "speechEnd": 92.065
  },
  {
   "id": "seg2-19",
   "text": "AI 是开发工具，写合约，写配置，装插件。",
   "spoken": "AI 是开发工具，写合约，写配置，装插件。",
   "src": "/Users/k/Workon/Learning/web3/web3-security-101/handbook/video/skeuo/ep26/audio/lines/seg2-19.mp3",
   "start": 93.14,
   "dur": 4.896,
   "speechStart": 93.238,
   "speechEnd": 97.202
  },
  {
   "id": "seg2-20",
   "text": "AI 也是防御工具，做审计初筛和监控告警。",
   "spoken": "AI 也是防御工具，做审计初筛和监控告警。",
   "src": "/Users/k/Workon/Learning/web3/web3-security-101/handbook/video/skeuo/ep26/audio/lines/seg2-20.mp3",
   "start": 98.256,
   "dur": 4.776,
   "speechStart": 98.354,
   "speechEnd": 102.199
  },
  {
   "id": "seg2-21",
   "text": "先看最新的那一个，持有钱包的智能体。",
