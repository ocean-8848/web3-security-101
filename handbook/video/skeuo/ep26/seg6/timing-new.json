 "captions": [
  {
   "text": "回到持有钱包的智能体",
   "start": 1.648,
   "end": 3.52,
   "id": "c0"
  },
  {
   "text": "防线不能放在模型里",
   "start": 4.508,
   "end": 6.225,
   "id": "c1"
  },
  {
   "text": "模型理解指令的方式不可靠",
   "start": 6.293,
   "end": 8.38,
   "id": "c2"
  },
  {
   "text": "要在钱包这一层",
   "start": 9.36,
   "end": 10.744,
   "id": "c3"
  },
  {
   "text": "用代码限制它",
   "start": 10.788,
   "end": 12.101,
   "id": "c4"
  },
  {
   "text": "第一 额度",
   "start": 13.084,
   "end": 14.408,
   "id": "c5"
  },
  {
   "text": "单笔和单日上限写在钱包工具或合约里",
   "start": 14.476,
   "end": 17.695,
   "id": "c6"
  },
  {
   "text": "超额要人工确认",
   "start": 17.715,
   "end": 19.051,
   "id": "c7"
  },
  {
   "text": "第二 白名单",
   "start": 20.048,
   "end": 21.515,
   "id": "c8"
  },
  {
   "text": "只允许向预设的地址和合约转账或授权",
   "start": 21.619,
   "end": 24.991,
   "id": "c9"
  },
  {
   "text": "第三 权限隔离",
   "start": 25.98,
   "end": 27.935,
   "id": "c10"
  },
  {
   "text": "智能体用独立的低额度钱包",
   "start": 28.039,
   "end": 30.257,
   "id": "c11"
  },
  {
   "text": "主资产不交给它",
   "start": 30.289,
   "end": 31.769,
   "id": "c12"
  },
  {
   "text": "第四 人工确认 新地址 授权",
   "start": 32.752,
   "end": 36.184,
   "id": "c13"
  },
  {
   "text": "大额操作走人工审批",
   "start": 36.359,
   "end": 38.457,
   "id": "c14"
  },
  {
   "text": "界面显示解码后的交易",
   "start": 38.644,
   "end": 40.279,
   "id": "c15"
  },
  {
   "text": "第五 输入隔离",
   "start": 41.276,
   "end": 42.946,
   "id": "c16"
  },
  {
   "text": "一个模型的输出",
   "start": 43.18,
   "end": 44.446,
   "id": "c17"
  },
  {
   "text": "不能直接成为另一个智能体的指令",
   "start": 44.514,
   "end": 46.588,
   "id": "c18"
  },
  {
   "text": "记忆写入要校验来源",
   "start": 47.568,
   "end": 49.261,
   "id": "c19"
  },
  {
   "text": "转账前从链上读取余额",
   "start": 49.425,
   "end": 51.595,
   "id": "c20"
  },
  {
   "text": "运维面板按特权系统加固",
   "start": 51.639,
   "end": 53.69,
   "id": "c21"
  },
  {
   "text": "给外部内容打上不可信标记 有用 但不够",
   "start": 54.676,
   "end": 58.786,
   "id": "c22"
  },
  {
   "text": "模型仍可能照做",
   "start": 58.83,
   "end": 60.322,
   "id": "c23"
  },
  {
   "text": "团队里 AI 写的代码和配置",
   "start": 61.304,
   "end": 64.034,
   "id": "c24"
  },
  {
   "text": "和人写的一样 走审查",
   "start": 64.054,
   "end": 66.105,
   "id": "c25"
  },
  {
   "text": "测试和审计",
   "start": 66.125,
   "end": 67.367,
   "id": "c26"
  },
  {
   "text": "作为用户",
   "start": 68.364,
   "end": 69.236,
   "id": "c27"
  },
  {
   "text": "不要把主钱包交给任何 AI 机器人 要用",
   "start": 69.423,
   "end": 73.188,
   "id": "c28"
  },
  {
   "text": "就给它一个只放少量资金的独立钱包",
   "start": 73.411,
   "end": 76.593,
   "id": "c29"
  },
  {
   "text": "回到开头的问题",
   "start": 77.584,
   "end": 78.968,
   "id": "c30"
  },
  {
   "text": "写在提示词里的规则",
   "start": 79.964,
   "end": 81.681,
   "id": "c31"
  },
  {
   "text": "会被说服绕过",
   "start": 81.702,
   "end": 82.907,
   "id": "c32"
  },
  {
   "text": "写在合约里的规则不会",
   "start": 83.88,
   "end": 85.502,
   "id": "c33"
  },
  {
   "text": "合约按代码拒绝这笔转账",
   "start": 85.713,
   "end": 87.859,
   "id": "c34"
  },
  {
   "text": "模型说什么都没用",
   "start": 87.987,
   "end": 89.276,
   "id": "c35"
  },
  {
   "text": "安全边界",
   "start": 90.244,
   "end": 91.271,
   "id": "c36"
  },
  {
   "text": "要放在模型之外",
   "start": 91.291,
   "end": 92.664,
   "id": "c37"
  },
  {
