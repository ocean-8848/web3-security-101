   "dur": 2.24,
   "speechStart": 81.14,
   "speechEnd": 83.166
  },
  {
   "id": "seg4-16",
   "text": "视频里看到真人脸，不能证明对方是真人。",
   "spoken": "视频里看到真人脸，不能证明对方是真人。",
   "src": "/Users/k/Workon/Learning/web3/web3-security-101/handbook/video/skeuo/ep26/audio/lines/seg4-16.wav",
