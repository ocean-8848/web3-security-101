 "captions": [
  {
   "text": "AI 也被用来骗人",
   "start": 1.65,
   "end": 3.271,
   "id": "c0"
  },
  {
   "text": "深度伪造",
   "start": 3.53,
   "end": 4.832,
   "id": "c1"
  },
  {
   "text": "是用 AI 生成的伪造视频",
   "start": 5.057,
   "end": 7.568,
   "id": "c2"
  },
  {
   "text": "图像或语音",
   "start": 7.588,
   "end": 8.984,
   "id": "c3"
  },
  {
   "text": "2024 年 10 月",
   "start": 9.296,
   "end": 10.604,
   "id": "c4"
  },
  {
   "text": "香港警方拘捕了一个诈骗集团的 27 人",
   "start": 10.791,
   "end": 14.271,
   "id": "c5"
  },
  {
   "text": "他们在视频通话里用换脸技术假扮女性",
   "start": 14.53,
   "end": 18.277,
   "id": "c6"
  },
  {
   "text": "引导受害者在假平台上投资",
   "start": 18.639,
   "end": 21.107,
   "id": "c7"
  },
  {
   "text": "涉案超过 3.6 亿港元",
   "start": 21.47,
   "end": 23.773,
   "id": "c8"
  },
  {
   "text": "2025 年 6 月",
   "start": 24.134,
   "end": 25.453,
   "id": "c9"
  },
  {
   "text": "一家加密基金会的员工",
   "start": 25.636,
   "end": 27.706,
   "id": "c10"
  },
  {
   "text": "在假 Zoom 会议里",
   "start": 27.899,
   "end": 29.548,
   "id": "c11"
  },
  {
   "text": "看到了公司高管的伪造形象",
   "start": 29.683,
   "end": 32.333,
   "id": "c12"
  },
  {
   "text": "对方说麦克风有问题",
   "start": 32.663,
   "end": 34.289,
   "id": "c13"
  },
  {
   "text": "让他安装一个扩展",
   "start": 34.489,
   "end": 35.851,
   "id": "c14"
  },
  {
   "text": "实际是恶意脚本",
   "start": 35.97,
   "end": 37.649,
   "id": "c15"
  },
  {
   "text": "Huntress 高置信度归因于朝鲜相关组织",
   "start": 37.91,
   "end": 41.627,
   "id": "c16"
  },
  {
   "text": "开户审核也被盯上了",
   "start": 41.985,
   "end": 43.855,
   "id": "c17"
  },
  {
   "text": "虚拟摄像头注入和换脸",
   "start": 44.11,
   "end": 46.285,
   "id": "c18"
  },
  {
   "text": "被用来绕过 KYC 的活体检测",
   "start": 46.358,
   "end": 49.014,
   "id": "c19"
  },
  {
   "text": "iProov 和 Sumsub 的厂商报告都显示",
   "start": 49.306,
   "end": 51.811,
   "id": "c20"
  },
  {
   "text": "这类欺诈在增长",
   "start": 51.923,
   "end": 53.722,
   "id": "c21"
  },
  {
   "text": "钓鱼文案也变了 更自然",
   "start": 54.087,
   "end": 56.336,
   "id": "c22"
  },
  {
   "text": "语言更多",
   "start": 56.447,
   "end": 57.296,
   "id": "c23"
  },
  {
   "text": "迭代更快",
   "start": 57.341,
   "end": 58.124,
   "id": "c24"
  },
  {
   "text": "靠读文案判断真假",
   "start": 58.37,
   "end": 60.523,
   "id": "c25"
  },
  {
   "text": "已经不可靠",
   "start": 60.663,
   "end": 61.496,
   "id": "c26"
  },
  {
   "text": "Chainalysis 统计",
   "start": 61.79,
   "end": 63.228,
   "id": "c27"
  },
  {
   "text": "2025 年诈骗损失已确认约 140 亿美元",
   "start": 63.426,
   "end": 67.395,
   "id": "c28"
  },
  {
   "text": "估算约 170 亿美元",
   "start": 67.546,
   "end": 69.491,
   "id": "c29"
  },
  {
   "text": "和 AI 服务供应商有链上关联的诈骗团伙",
   "start": 69.77,
   "end": 73.61,
   "id": "c30"
  },
  {
   "text": "平均获利约是无关联团伙的 4.5 倍",
   "start": 73.918,
   "end": 77.508,
   "id": "c31"
  },
  {
   "text": "AI 抬高的",
   "start": 77.856,
   "end": 78.857,
   "id": "c32"
  },
  {
   "text": "是单起诈骗的获利能力",
   "start": 78.899,
   "end": 80.83,
   "id": "c33"
  },
  {
   "text": "所以防御要回到流程",
   "start": 81.09,
   "end": 83.286,
   "id": "c34"
  },
  {
   "text": "视频里看到真人脸",
   "start": 83.55,
   "end": 85.338,
   "id": "c35"
  },
  {
   "text": "不能证明对方是真人",
   "start": 85.496,
   "end": 87.264,
   "id": "c36"
  },
  {
   "text": "会议里要求安装任何东西",
   "start": 87.53,
   "end": 89.439,
   "id": "c37"
  },
  {
   "text": "一律拒绝",
   "start": 89.459,
   "end": 90.256,
   "id": "c38"
  },
  {
   "text": "大额指令换一个渠道确认",
   "start": 90.468,
   "end": 92.163,
   "id": "c39"
  },
  {
   "text": "FBI 的公告还建议",
   "start": 92.568,
   "end": 94.113,
   "id": "c40"
  },
  {
   "text": "家人之间约定一个暗语",
   "start": 94.288,
   "end": 96.364,
   "id": "c41"
  }
 ]
}