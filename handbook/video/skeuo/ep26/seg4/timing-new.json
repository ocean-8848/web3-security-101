 "captions": [
  {
   "text": "AI 也被用来骗人",
   "start": 1.648,
   "end": 3.508,
   "id": "c0"
  },
  {
   "text": "深度伪造",
   "start": 4.508,
   "end": 5.535,
   "id": "c1"
  },
  {
   "text": "是用 AI 生成的伪造视频",
   "start": 5.555,
   "end": 7.916,
   "id": "c2"
  },
  {
   "text": "图像或语音",
   "start": 7.936,
   "end": 9.178,
   "id": "c3"
  },
  {
   "text": "2024 年 10 月",
   "start": 10.176,
   "end": 11.56,
   "id": "c4"
  },
  {
   "text": "香港警方拘捕了一个诈骗集团的 27 人",
   "start": 11.628,
   "end": 14.738,
   "id": "c5"
  },
  {
   "text": "他们在视频通话里用换脸技术假扮女性",
   "start": 15.724,
   "end": 18.941,
   "id": "c6"
  },
  {
   "text": "引导受害者在假平台上投资",
   "start": 19.128,
   "end": 21.322,
   "id": "c7"
  },
  {
   "text": "涉案超过 3.6 亿港元",
   "start": 21.355,
   "end": 23.251,
   "id": "c8"
  },
  {
   "text": "2025 年 6 月",
   "start": 24.248,
   "end": 25.513,
   "id": "c9"
  },
  {
   "text": "一家加密基金会的员工",
   "start": 25.7,
   "end": 27.311,
   "id": "c10"
  },
  {
   "text": "在假 Zoom 会议里",
   "start": 27.331,
   "end": 28.656,
   "id": "c11"
  },
  {
   "text": "看到了公司高管的伪造形象",
   "start": 28.676,
   "end": 30.846,
   "id": "c12"
  },
  {
   "text": "对方说麦克风有问题",
   "start": 31.836,
   "end": 33.91,
   "id": "c13"
  },
  {
   "text": "让他安装一个扩展",
   "start": 34.121,
   "end": 35.506,
   "id": "c14"
  },
  {
   "text": "实际是恶意脚本",
   "start": 35.645,
   "end": 36.994,
   "id": "c15"
  },
  {
   "text": "Huntress 高置信度归因于朝鲜相关组织",
   "start": 37.984,
   "end": 41.189,
   "id": "c16"
  },
  {
   "text": "开户审核也被盯上了",
   "start": 42.188,
   "end": 44.096,
   "id": "c17"
  },
  {
   "text": "虚拟摄像头注入和换脸",
   "start": 45.072,
   "end": 46.992,
   "id": "c18"
  },
  {
   "text": "被用来绕过 KYC 的活体检测",
   "start": 47.036,
   "end": 49.325,
   "id": "c19"
  },
  {
   "text": "iProov 和 Sumsub 的厂商报告都显示",
   "start": 50.308,
   "end": 53.394,
   "id": "c20"
  },
  {
   "text": "这类欺诈在增长",
   "start": 53.486,
   "end": 54.882,
   "id": "c21"
  },
  {
   "text": "钓鱼文案也变了 更自然",
   "start": 55.88,
   "end": 58.085,
   "id": "c22"
  },
  {
   "text": "语言更多",
   "start": 58.272,
   "end": 59.169,
   "id": "c23"
  },
  {
   "text": "迭代更快",
   "start": 59.272,
   "end": 60.145,
   "id": "c24"
  },
  {
   "text": "靠读文案判断真假",
   "start": 61.116,
   "end": 62.833,
   "id": "c25"
  },
  {
   "text": "已经不可靠",
   "start": 62.925,
   "end": 63.881,
   "id": "c26"
  },
  {
   "text": "Chainalysis 统计",
   "start": 64.864,
   "end": 66.093,
   "id": "c27"
  },
  {
   "text": "2025 年诈骗损失已确认约 140 亿美元",
   "start": 66.28,
   "end": 69.926,
   "id": "c28"
  },
  {
   "text": "估算约 170 亿美元",
   "start": 69.947,
   "end": 71.653,
   "id": "c29"
  },
  {
   "text": "和 AI 服务供应商有链上关联的诈骗团伙",
   "start": 72.644,
   "end": 76.445,
   "id": "c30"
  },
  {
   "text": "平均获利约是无关联团伙的 4.5 倍",
   "start": 76.679,
   "end": 79.492,
   "id": "c31"
  },
  {
   "text": "AI 抬高的",
   "start": 80.472,
   "end": 81.749,
   "id": "c32"
  },
  {
   "text": "是单起诈骗的获利能力",
   "start": 81.769,
   "end": 83.558,
   "id": "c33"
  },
  {
   "text": "所以防御要回到流程",
   "start": 84.556,
   "end": 86.595,
   "id": "c34"
  },
  {
   "text": "视频里看到真人脸",
   "start": 87.584,
   "end": 89.277,
   "id": "c35"
  },
  {
   "text": "不能证明对方是真人",
   "start": 89.429,
   "end": 91.325,
   "id": "c36"
  },
  {
   "text": "会议里要求安装任何东西",
   "start": 92.316,
   "end": 94.355,
   "id": "c37"
  },
  {
   "text": "一律拒绝",
   "start": 94.399,
   "end": 95.355,
   "id": "c38"
  },
  {
   "text": "大额指令换一个渠道确认",
   "start": 95.47,
   "end": 97.271,
   "id": "c39"
  },
