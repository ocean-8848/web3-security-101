 "captions": [
  {
   "text": "先看第一处 熵不足",
   "start": 1.55,
   "end": 3.603,
   "id": "c0"
  },
  {
   "text": "攻击路径有四步",
   "start": 3.844,
   "end": 5.289,
   "id": "c1"
  },
  {
   "text": "第一 生成器用了状态很小的伪随机数生成器",
   "start": 5.625,
   "end": 9.787,
   "id": "c2"
  },
  {
   "text": "比如只用 32 位种子初始化的 mt19937",
   "start": 9.962,
   "end": 14.311,
   "id": "c3"
  },
  {
   "text": "第二 种子只有约 43 亿种",
   "start": 14.649,
   "end": 17.482,
   "id": "c4"
  },
  {
   "text": "私钥也就只有约 43 亿种",
   "start": 17.64,
   "end": 20.169,
   "id": "c5"
  },
  {
   "text": "第三 攻击者在 GPU 上枚举全部种子",
   "start": 20.37,
   "end": 24.311,
   "id": "c6"
  },
  {
   "text": "算出对应的地址",
   "start": 24.388,
   "end": 25.849,
   "id": "c7"
  },
  {
   "text": "第四 和链上有余额的地址比对",
   "start": 26.203,
   "end": 29.233,
   "id": "c8"
  },
  {
   "text": "命中 就转走资产",
   "start": 29.451,
   "end": 31.383,
   "id": "c9"
  },
  {
   "text": "看起来随机",
   "start": 31.708,
   "end": 32.864,
   "id": "c10"
  },
  {
   "text": "不等于安全",
   "start": 32.98,
   "end": 33.931,
   "id": "c11"
  },
  {
   "text": "私钥必须来自 CSPRNG",
   "start": 34.172,
   "end": 36.229,
   "id": "c12"
  },
  {
   "text": "也就是密码学安全随机数生成器",
   "start": 36.249,
   "end": 40.136,
   "id": "c13"
  },
  {
   "text": "满 256 位熵",
   "start": 40.313,
   "end": 41.759,
   "id": "c14"
  },
  {
   "text": "三个案例",
   "start": 41.99,
   "end": 42.907,
   "id": "c15"
  },
  {
   "text": "走的都是这条路",
   "start": 42.973,
   "end": 44.402,
   "id": "c16"
  },
  {
   "text": "第一个是 Profanity",
   "start": 44.69,
   "end": 46.352,
   "id": "c17"
  },
  {
   "text": "1.60 及以前的版本只用 32 位种子",
   "start": 46.606,
   "end": 49.905,
   "id": "c18"
  },
  {
   "text": "2022 年 9 月 15 日",
   "start": 50.292,
   "end": 52.208,
   "id": "c19"
  },
  {
   "text": "1inch 公开披露",
   "start": 52.508,
   "end": 53.876,
   "id": "c20"
  },
  {
   "text": "5 天后 Wintermute 被盗",
   "start": 54.24,
   "end": 56.172,
   "id": "c21"
  },
  {
   "text": "同期还有多个受害者",
   "start": 56.432,
   "end": 58.089,
   "id": "c22"
  },
  {
   "text": "第二个 Trust Wallet 浏览器扩展",
   "start": 58.422,
   "end": 61.355,
   "id": "c23"
  },
  {
   "text": "Wallet Core 的 WASM 版本生成助记词",
   "start": 62.051,
   "end": 65.517,
   "id": "c24"
  },
  {
   "text": "用的是 mt19937",
   "start": 65.537,
   "end": 67.636,
   "id": "c25"
  },
  {
   "text": "熵从 256 位降到 32 位",
   "start": 68.012,
   "end": 70.643,
   "id": "c26"
  },
  {
   "text": "受影响的",
   "start": 70.95,
   "end": 72.155,
   "id": "c27"
  },
  {
   "text": "是 2022 年 11 月 14 日",
   "start": 72.287,
   "end": 74.242,
   "id": "c28"
  },
  {
   "text": "到 23 日新建的扩展钱包",
   "start": 74.262,
   "end": 76.198,
   "id": "c29"
  },
  {
   "text": "Ledger 的安全团队报告后",
   "start": 76.218,
   "end": 78.98,
   "id": "c30"
  },
  {
   "text": "几天内就修复了",
   "start": 79.132,
   "end": 80.481,
   "id": "c31"
  },
  {
   "text": "但部分弱钱包后来还是被盗",
   "start": 80.69,
   "end": 83.235,
   "id": "c32"
  },
  {
   "text": "损失约 17 万美元",
   "start": 83.457,
   "end": 85.171,
   "id": "c33"
  },
  {
   "text": "Trust Wallet 承诺补偿",
   "start": 85.408,
   "end": 87.269,
   "id": "c34"
  },
  {
   "text": "第三个",
   "start": 87.55,
   "end": 88.229,
   "id": "c35"
  },
  {
   "text": "Libbitcoin Explorer",
   "start": 88.377,
   "end": 89.754,
   "id": "c36"
  },
  {
   "text": "的 Milk Sad 漏洞",
   "start": 89.774,
   "end": 91.042,
   "id": "c37"
  },
  {
   "text": "它生成种子的命令",
   "start": 91.217,
   "end": 92.725,
   "id": "c38"
  },
  {
   "text": "用的是一个 32 位的时间值",
   "start": 92.816,
   "end": 95.068,
   "id": "c39"
  },
  {
   "text": "2023 年 7 月 12 日发生集中盗取",
   "start": 95.37,
   "end": 98.774,
   "id": "c40"
  },
  {
   "text": "损失至少约 90 万美元",
   "start": 99.182,
   "end": 101.351,
   "id": "c41"
  },
  {
   "text": "厂商认为",
   "start": 101.687,
   "end": 102.487,
   "id": "c42"
  },
  {
   "text": "文档早有警告",
   "start": 102.507,
   "end": 103.79,
   "id": "c43"
  },
  {
   "text": "教训有三条",
   "start": 104.05,
   "end": 105.926,
   "id": "c44"
  },
  {
   "text": "在 WASM 或 JS 里替换随机源",
   "start": 105.992,
   "end": 109.577,
   "id": "c45"
  },
  {
   "text": "要单独审计",
   "start": 109.78,
   "end": 110.839,
   "id": "c46"
  },
  {
   "text": "文档里的警告挡不住误用",
   "start": 111.243,
   "end": 113.183,
   "id": "c47"
  },
  {
   "text": "生成密钥的接口必须默认安全",
   "start": 113.268,
   "end": 115.701,
   "id": "c48"
  },
  {
   "text": "最容易漏掉的一条是",
   "start": 115.93,
   "end": 117.632,
   "id": "c49"
  },
  {
   "text": "修好代码",
   "start": 117.835,
   "end": 118.886,
   "id": "c50"
  },
  {
   "text": "修不好已经生成的弱私钥",
   "start": 119.088,
   "end": 121.329,
   "id": "c51"
  },
  {
   "text": "用户必须迁移到新地址",
   "start": 121.515,
   "end": 123.588,
   "id": "c52"
  }
 ]
}