 "captions": [
  {
   "text": "这一集的核心",
   "start": 1.648,
   "end": 2.913,
   "id": "c0"
  },
  {
   "text": "是一句话",
   "start": 3.088,
   "end": 4.044,
   "id": "c1"
  },
  {
   "text": "密码学算法几乎从不被破解",
   "start": 4.419,
   "end": 7.089,
   "id": "c2"
  },
  {
   "text": "被攻破的 是实现",
   "start": 7.264,
   "end": 9.029,
   "id": "c3"
  },
  {
   "text": "随机数不够随机",
   "start": 10.028,
   "end": 11.4,
   "id": "c4"
  },
  {
   "text": "nonce 能被算出",
   "start": 11.551,
   "end": 13.114,
   "id": "c5"
  },
  {
   "text": "门限签名的库省掉一步证明",
   "start": 13.147,
   "end": 15.186,
   "id": "c6"
  },
  {
   "text": "私钥的安全上限",
   "start": 16.176,
   "end": 17.56,
   "id": "c7"
  },
  {
   "text": "由它的生成和使用过程决定",
   "start": 17.699,
   "end": 19.965,
   "id": "c8"
  },
  {
   "text": "先给准确的定义",
   "start": 20.956,
   "end": 22.459,
   "id": "c9"
  },
  {
   "text": "熵 是随机性的度量",
   "start": 22.834,
   "end": 25.123,
   "id": "c10"
  },
  {
   "text": "单位是位",
   "start": 25.298,
   "end": 26.195,
   "id": "c11"
  },
  {
   "text": "256 位熵",
   "start": 27.176,
   "end": 28.488,
   "id": "c12"
  },
  {
   "text": "攻击者要试大约 2 的 256 次方次",
   "start": 28.676,
   "end": 31.31,
   "id": "c13"
  },
  {
   "text": "只有 32 位熵",
   "start": 31.685,
   "end": 33.069,
   "id": "c14"
  },
  {
   "text": "约 43 亿次就够了",
   "start": 33.221,
   "end": 34.712,
   "id": "c15"
  },
  {
   "text": "打个比方",
   "start": 35.7,
   "end": 36.655,
   "id": "c16"
  },
  {
   "text": "保险柜的密码有 77 位数字",
   "start": 37.019,
   "end": 39.355,
   "id": "c17"
  },
  {
   "text": "理论上没人猜得出",
   "start": 39.507,
   "end": 41.022,
   "id": "c18"
  },
  {
   "text": "但如果设密码的人",
   "start": 41.992,
   "end": 43.423,
   "id": "c19"
  },
  {
   "text": "总用自己的生日加一串固定数字",
   "start": 43.444,
   "end": 46.15,
   "id": "c20"
  },
  {
   "text": "小偷只要试几万个生日",
   "start": 46.289,
   "end": 48.304,
   "id": "c21"
  },
  {
   "text": "这个比方有一处不成立",
   "start": 49.292,
   "end": 51.247,
   "id": "c22"
  },
  {
   "text": "小偷试生日",
   "start": 51.611,
   "end": 52.721,
   "id": "c23"
  },
  {
   "text": "必须站在保险柜前面",
   "start": 52.742,
   "end": 54.328,
   "id": "c24"
  },
  {
   "text": "链上的公钥和地址全部公开",
   "start": 55.32,
   "end": 57.954,
   "id": "c25"
  },
  {
   "text": "攻击者可以离线 并行",
   "start": 58.329,
   "end": 60.451,
   "id": "c26"
  },
  {
   "text": "无限次地试",
   "start": 60.662,
   "end": 61.713,
   "id": "c27"
  },
  {
   "text": "不会触发任何告警",
   "start": 61.758,
   "end": 63.261,
   "id": "c28"
  },
  {
   "text": "再看几种原语",
   "start": 64.252,
   "end": 65.469,
   "id": "c29"
  },
  {
   "text": "各自保护什么",
   "start": 65.633,
   "end": 66.779,
   "id": "c30"
  },
  {
   "text": "不保护什么",
   "start": 66.883,
   "end": 67.731,
   "id": "c31"
  },
  {
   "text": "ECDSA 和 EdDSA 用来签名",
   "start": 68.72,
   "end": 71.128,
   "id": "c32"
  },
  {
   "text": "它们保证",
   "start": 71.491,
   "end": 72.363,
   "id": "c33"
  },
  {
   "text": "没有私钥的人无法伪造签名",
   "start": 72.574,
   "end": 74.971,
   "id": "c34"
  },
  {
   "text": "但它们不管私钥和 nonce 的质量",
   "start": 75.972,
   "end": 78.189,
   "id": "c35"
  },
  {
   "text": "也不管用户看没看懂签的内容",
   "start": 78.305,
   "end": 80.463,
   "id": "c36"
  },
  {
   "text": "哈希保证数据没被改动",
   "start": 81.448,
   "end": 83.499,
   "id": "c37"
  },
  {
   "text": "但不保证数据本身是对的",
   "start": 83.721,
   "end": 85.879,
   "id": "c38"
  },
  {
   "text": "助记词让人能抄写和恢复钱包",
   "start": 86.852,
   "end": 89.629,
   "id": "c39"
  },
  {
   "text": "但不管生成它时熵够不够",
   "start": 89.875,
   "end": 91.748,
   "id": "c40"
  },
  {
   "text": "分层派生",
   "start": 92.712,
   "end": 93.751,
   "id": "c41"
  },
  {
   "text": "从一个种子派生出一组地址",
   "start": 93.819,
   "end": 96.108,
   "id": "c42"
  },
  {
   "text": "一份备份恢复全部",
   "start": 96.483,
   "end": 98.129,
   "id": "c43"
  },
  {
   "text": "一个种子泄露",
   "start": 98.269,
   "end": 99.403,
   "id": "c44"
  },
  {
   "text": "也全部泄露",
   "start": 99.424,
   "end": 100.451,
   "id": "c45"
  },
  {
   "text": "整条链路是这样的",
   "start": 101.452,
   "end": 103.086,
   "id": "c46"
  },
  {
   "text": "随机数源",
   "start": 103.449,
   "end": 104.548,
   "id": "c47"
  },
  {
   "text": "到助记词 到种子",
   "start": 104.568,
   "end": 106.263,
   "id": "c48"
  },
  {
   "text": "再派生出私钥和地址",
   "start": 106.283,
   "end": 108.143,
   "id": "c49"
  },
  {
   "text": "签名时 私钥 消息",
   "start": 109.136,
   "end": 111.353,
   "id": "c50"
  },
  {
   "text": "再加一个 nonce",
   "start": 111.481,
   "end": 112.556,
   "id": "c51"
  },
  {
   "text": "一起算出签名",
   "start": 112.576,
   "end": 113.829,
   "id": "c52"
  },
  {
   "text": "这条链路上",
   "start": 114.828,
   "end": 115.974,
   "id": "c53"
  },
  {
   "text": "有两处需要随机性",
   "start": 115.994,
   "end": 117.474,
   "id": "c54"
  },
  {
   "text": "生成私钥时的熵",
   "start": 117.849,
   "end": 119.353,
   "id": "c55"
  },
  {
   "text": "签名时的 nonce",
   "start": 119.373,
   "end": 120.674,
   "id": "c56"
  },
  {
   "text": "任何一处出错",
   "start": 121.028,
   "end": 122.329,
   "id": "c57"
  },
  {
   "text": "私钥都能被算出来",
   "start": 122.444,
   "end": 123.888,
   "id": "c58"
  },
  {
   "text": "图上没画的",
   "start": 124.864,
   "end": 126.129,
   "id": "c59"
  },
  {
   "text": "是签名的内容",
   "start": 126.197,
   "end": 127.343,
   "id": "c60"
  },
  {
   "text": "算法完全正确",
   "start": 127.718,
   "end": 129.198,
   "id": "c61"
  },
  {
   "text": "用户也可能签下攻击者的交易",
   "start": 129.385,
   "end": 131.626,
   "id": "c62"
  },
  {
   "text": "所以签之前",
   "start": 132.004,
   "end": 133.15,
   "id": "c63"
  },
  {
   "text": "要看清签的是什么",
   "start": 133.206,
   "end": 134.531,
   "id": "c64"
  }
 ]
