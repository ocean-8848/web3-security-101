   "start": 54.804,
   "dur": 5.184,
   "speechStart": 54.902,
   "speechEnd": 59.14
  },
  {
   "id": "seg5-12",
   "text": "约 40 万枚 ETH 类资产被转走，约 2 分钟后，脚本被换回干净版本。",
   "spoken": "约 40 万枚 ETH 类资产被转走，约 2 分钟后，脚本被换回干净版本。",
   "src": "/Users/k/Workon/Learning/web3/web3-security-101/handbook/video/skeuo/ep20/audio/lines/seg5-12.mp3",
   "start": 60.208,
   "dur": 6.36,
   "speechStart": 60.306,
   "speechEnd": 65.734
  },
  {
   "id": "seg5-13",
