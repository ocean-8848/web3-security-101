 "captions": [
  {
   "text": "最难发现的篡改",
   "start": 1.648,
   "end": 3.175,
   "id": "c0"
  },
  {
   "text": "只对一个目标生效",
   "start": 3.279,
   "end": 4.639,
   "id": "c1"
  },
  {
   "text": "2025 年 2 月",
   "start": 5.636,
   "end": 6.901,
   "id": "c2"
  },
  {
   "text": "Bybit 的冷钱包多签被盗",
   "start": 6.969,
   "end": 8.996,
   "id": "c3"
  },
  {
   "text": "损失约 15 亿美元",
   "start": 9.064,
   "end": 10.901,
   "id": "c4"
  },
  {
   "text": "FBI 公告把它归因于朝鲜",
   "start": 11.88,
   "end": 14.228,
   "id": "c5"
  },
  {
   "text": "Safe 的初步报告称",
   "start": 15.22,
   "end": 16.794,
   "id": "c6"
  },
  {
   "text": "2 月 4 日",
   "start": 16.982,
   "end": 17.902,
   "id": "c7"
  },
  {
   "text": "一名开发者的电脑失陷",
   "start": 17.922,
   "end": 19.425,
   "id": "c8"
  },
  {
   "text": "起因是运行了一个受污染的 Docker 项目",
   "start": 20.408,
   "end": 23.256,
   "id": "c9"
  },
  {
   "text": "攻击者没能注册自己的验证设备",
   "start": 24.252,
   "end": 26.601,
   "id": "c10"
  },
  {
   "text": "就劫持了活跃的 AWS 会话令牌",
   "start": 26.621,
   "end": 29.826,
   "id": "c11"
  },
  {
   "text": "然后 篡改了 S3 上 Safe 网页前端的脚本",
   "start": 30.808,
   "end": 34.359,
   "id": "c12"
  },
  {
   "text": "脚本先判断",
   "start": 35.348,
   "end": 36.47,
   "id": "c13"
  },
  {
   "text": "发起交易的是不是 Bybit 的多签地址",
   "start": 36.502,
   "end": 39.184,
   "id": "c14"
  },
  {
   "text": "不是 就一切正常",
   "start": 40.176,
   "end": 41.988,
   "id": "c15"
  },
  {
   "text": "是 界面照样显示一笔正常转账",
   "start": 42.964,
   "end": 46.503,
   "id": "c16"
  },
  {
   "text": "实际构造的是一次 DELEGATECALL",
   "start": 46.606,
   "end": 49.05,
   "id": "c17"
  },
  {
   "text": "签名人在硬件钱包上签名",
   "start": 50.048,
   "end": 52.349,
   "id": "c18"
  },
  {
   "text": "只看到一串哈希",
   "start": 52.452,
   "end": 53.86,
   "id": "c19"
  },
  {
   "text": "签名凑够门槛",
   "start": 54.852,
   "end": 56.248,
   "id": "c20"
  },
  {
   "text": "交易执行",
   "start": 56.268,
   "end": 57.26,
   "id": "c21"
  },
  {
   "text": "多签的实现合约被替换",
   "start": 57.423,
   "end": 59.26,
   "id": "c22"
  },
  {
   "text": "约 40 万枚 ETH 类资产被转走",
   "start": 60.256,
   "end": 62.83,
   "id": "c23"
  },
  {
   "text": "约 2 分钟后",
   "start": 63.053,
   "end": 64.104,
   "id": "c24"
  },
  {
   "text": "脚本被换回干净版本",
   "start": 64.16,
   "end": 65.854,
   "id": "c25"
  },
  {
   "text": "外部研究者打开页面",
   "start": 66.836,
   "end": 68.577,
   "id": "c26"
  },
  {
   "text": "看到的一切正常",
   "start": 68.598,
   "end": 70.16,
   "id": "c27"
  },
  {
   "text": "Verichains 称",
   "start": 71.16,
   "end": 72.318,
   "id": "c28"
  },
  {
   "text": "恶意代码只在特定条件下激活",
   "start": 72.398,
   "end": 74.841,
   "id": "c29"
  },
  {
   "text": "Sygnia 认为",
   "start": 75.82,
   "end": 76.847,
   "id": "c30"
  },
  {
   "text": "Safe 的云存储账号或密钥很可能泄露",
   "start": 76.974,
   "end": 79.954,
   "id": "c31"
  },
  {
   "text": "在 Bybit 自己的系统里",
   "start": 80.936,
   "end": 82.713,
   "id": "c32"
  },
  {
   "text": "没有发现入侵证据",
   "start": 82.876,
   "end": 84.404,
   "id": "c33"
  },
  {
   "text": "Safe 称合约不受影响",
   "start": 84.424,
   "end": 86.522,
   "id": "c34"
  },
  {
   "text": "关键在这里",
   "start": 87.516,
   "end": 88.614,
   "id": "c35"
  },
  {
   "text": "所有签名人都用同一个网页前端",
   "start": 89.608,
   "end": 92.301,
   "id": "c36"
  },
  {
   "text": "前端就是这个多签的单点",
   "start": 92.512,
   "end": 94.242,
   "id": "c37"
  },
  {
   "text": "增加签名人",
   "start": 95.228,
   "end": 96.469,
   "id": "c38"
  },
  {
   "text": "无法解决这个问题",
   "start": 96.513,
   "end": 97.862,
   "id": "c39"
  },
  {
   "text": "防线在签名这一步",
   "start": 98.856,
   "end": 100.311,
   "id": "c40"
  },
  {
   "text": "签名人用独立工具",
   "start": 100.368,
   "end": 101.99,
   "id": "c41"
  },
  {
   "text": "重新计算交易哈希",
   "start": 102.034,
   "end": 103.621,
   "id": "c42"
  },
  {
   "text": "在硬件钱包上核对",
   "start": 103.641,
   "end": 105.061,
   "id": "c43"
  },
  {
   "text": "例行转账只允许普通调用",
   "start": 106.06,
   "end": 108.515,
   "id": "c44"
  },
  {
   "text": "委托调用进单独的审批流程",
   "start": 108.726,
   "end": 111.325,
   "id": "c45"
  },
  {
   "text": "发布方用独立系统",
   "start": 112.304,
   "end": 113.914,
   "id": "c46"
  },
  {
   "text": "比对线上文件和构建产物的哈希",
   "start": 114.054,
   "end": 116.759,
   "id": "c47"
  },
  {
   "text": "但比对只覆盖那一刻",
   "start": 117.756,
   "end": 119.533,
   "id": "c48"
  },
  {
   "text": "那个位置",
   "start": 119.72,
   "end": 120.652,
   "id": "c49"
  },
  {
   "text": "要在多个位置反复比对",
   "start": 120.744,
   "end": 122.604,
   "id": "c50"
  },
  {
   "text": "并保留每个版本的哈希和访问日志",
   "start": 122.672,
   "end": 125.366,
   "id": "c51"
  }
 ]
}