 "captions": [
  {
   "text": "往里一环",
   "start": 1.648,
   "end": 2.746,
   "id": "c0"
  },
  {
   "text": "是依赖包",
   "start": 2.91,
   "end": 3.818,
   "id": "c1"
  },
  {
   "text": "一个前端会引用很多别人写的代码包",
   "start": 4.796,
   "end": 7.406,
   "id": "c2"
  },
  {
   "text": "大多来自 npm 仓库",
   "start": 7.522,
   "end": 9.275,
   "id": "c3"
  },
  {
   "text": "攻击者先钓鱼包的维护者",
   "start": 10.272,
   "end": 12.227,
   "id": "c4"
  },
  {
   "text": "拿到账号或者会话",
   "start": 12.379,
   "end": 13.977,
   "id": "c5"
  },
  {
   "text": "再发布一个带恶意代码的新版本",
   "start": 14.956,
   "end": 17.411,
   "id": "c6"
  },
  {
   "text": "如果 DApp 不锁版本",
   "start": 18.392,
   "end": 20.312,
   "id": "c7"
  },
  {
   "text": "下次构建就会拉进这个新版本",
   "start": 20.475,
   "end": 22.871,
   "id": "c8"
  },
  {
   "text": "恶意代码挂到钱包接口上",
   "start": 23.844,
   "end": 25.966,
   "id": "c9"
  },
  {
   "text": "替换收款地址",
   "start": 26.117,
   "end": 27.514,
   "id": "c10"
  },
  {
   "text": "或者弹出授权",
   "start": 27.558,
   "end": 28.811,
   "id": "c11"
  },
  {
   "text": "2023 年 12 月",
   "start": 29.8,
   "end": 31.291,
   "id": "c12"
  },
  {
   "text": "Ledger 的一名前员工被钓鱼",
   "start": 31.407,
   "end": 33.958,
   "id": "c13"
  },
  {
   "text": "Ledger 回收了他的其他权限",
   "start": 34.94,
   "end": 37.348,
   "id": "c14"
  },
  {
   "text": "唯独漏了 npm",
   "start": 37.475,
   "end": 39.05,
   "id": "c15"
  },
  {
   "text": "攻击者用他的会话",
   "start": 40.032,
   "end": 41.547,
   "id": "c16"
  },
  {
   "text": "先后发布 3 个恶意版本的 Connect Kit",
   "start": 41.734,
   "end": 44.868,
   "id": "c17"
  },
  {
   "text": "很多 DApp 直接从 CDN 加载最新版",
   "start": 45.868,
   "end": 49.05,
   "id": "c18"
  },
  {
   "text": "恶意代码直接进了它们的页面",
   "start": 49.141,
   "end": 51.097,
   "id": "c19"
  },
  {
   "text": "Ledger 约 40 分钟内发布了修复版本",
   "start": 52.088,
   "end": 55.186,
   "id": "c20"
  },
  {
   "text": "但 CDN 的缓存",
   "start": 56.172,
   "end": 57.615,
   "id": "c21"
  },
  {
   "text": "让恶意文件约 5 小时后才完全清除",
   "start": 57.791,
   "end": 60.58,
   "id": "c22"
  },
  {
   "text": "损失约 60 万美元",
   "start": 60.731,
   "end": 62.544,
   "id": "c23"
  },
  {
   "text": "2025 年 9 月",
   "start": 63.544,
   "end": 64.869,
   "id": "c24"
  },
  {
   "text": "chalk 和 debug 等 18 个包被投毒",
   "start": 64.889,
   "end": 67.606,
   "id": "c25"
  },
  {
   "text": "周下载量合计超过 20 亿",
   "start": 67.746,
   "end": 70.035,
   "id": "c26"
  },
  {
   "text": "已确认的加密损失很小",
   "start": 71.012,
   "end": 72.801,
   "id": "c27"
  },
  {
   "text": "但一个包能进入的页面",
   "start": 73.059,
   "end": 74.932,
   "id": "c28"
  },
  {
   "text": "多到无法统计",
   "start": 74.964,
   "end": 76.015,
   "id": "c29"
  },
  {
   "text": "再往里 是 CDN",
   "start": 76.992,
   "end": 79.233,
   "id": "c30"
  },
  {
   "text": "CDN 把文件缓存到各地的边缘节点",
   "start": 80.212,
   "end": 83.358,
   "id": "c31"
  },
  {
   "text": "就近发给用户",
   "start": 83.378,
   "end": 84.56,
   "id": "c32"
  },
  {
   "text": "边缘节点上也能运行脚本",
   "start": 85.544,
   "end": 87.809,
   "id": "c33"
  },
  {
   "text": "改写发出去的页面",
   "start": 87.984,
   "end": 89.321,
   "id": "c34"
  },
  {
   "text": "2021 年",
   "start": 90.3,
   "end": 91.196,
   "id": "c35"
  },
  {
   "text": "攻击者利用 Cloudflare",
   "start": 91.216,
   "end": 92.851,
   "id": "c36"
  },
  {
   "text": "注册流程的一个漏洞",
   "start": 92.871,
   "end": 94.339,
   "id": "c37"
  },
  {
   "text": "拿到 BadgerDAO 账号下",
   "start": 95.32,
   "end": 97.144,
   "id": "c38"
  },
  {
   "text": "一把未经授权的 API Key",
   "start": 97.212,
   "end": 99.371,
   "id": "c39"
  },
  {
   "text": "从 11 月起",
   "start": 100.364,
   "end": 101.546,
   "id": "c40"
  },
  {
   "text": "他通过边缘脚本",
   "start": 101.626,
   "end": 102.986,
   "id": "c41"
  },
  {
   "text": "定期往页面里注入代码",
   "start": 103.066,
   "end": 104.974,
   "id": "c42"
  },
  {
   "text": "只对部分用户弹出授权",
   "start": 105.054,
   "end": 107.057,
   "id": "c43"
  },
  {
   "text": "12 月 2 日",
   "start": 108.048,
   "end": 109.134,
   "id": "c44"
  },
  {
   "text": "攻击者用这些授权",
   "start": 109.321,
   "end": 110.849,
   "id": "c45"
  },
  {
   "text": "转走约 1 亿 2000 万美元",
   "start": 110.869,
   "end": 112.968,
   "id": "c46"
  },
  {
   "text": "这两环的防线",
   "start": 113.956,
   "end": 115.138,
   "id": "c47"
  },
  {
   "text": "先锁定全部依赖版本",
   "start": 115.253,
   "end": 117.018,
   "id": "c48"
  },
  {
   "text": "不从 CDN 加载最新版的库",
   "start": 117.098,
   "end": 119.518,
   "id": "c49"
  },
  {
   "text": "外部脚本加上子资源完整性校验",
   "start": 120.512,
   "end": 123.348,
   "id": "c50"
  },
  {
   "text": "哈希不对就不执行",
   "start": 123.619,
   "end": 125.122,
   "id": "c51"
  },
  {
   "text": "发布凭证用短期的",
   "start": 126.108,
   "end": 127.73,
   "id": "c52"
  },
  {
   "text": "有人离职",
   "start": 127.881,
   "end": 128.801,
   "id": "c53"
  },
  {
   "text": "当天回收所有发布渠道",
   "start": 128.881,
   "end": 130.694,
   "id": "c54"
  },
  {
   "text": "CDN 的密钥最小权限",
   "start": 131.68,
   "end": 133.504,
   "id": "c55"
  },
  {
   "text": "定期轮换",
   "start": 133.549,
   "end": 134.528,
   "id": "c56"
  },
  {
   "text": "一有变更就告警",
   "start": 134.608,
   "end": 135.981,
   "id": "c57"
  }
 ]
}