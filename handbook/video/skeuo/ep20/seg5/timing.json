 "captions": [
  {
   "text": "最难发现的篡改",
   "start": 1.55,
   "end": 3.064,
   "id": "c0"
  },
  {
   "text": "只对一个目标生效",
   "start": 3.179,
   "end": 4.699,
   "id": "c1"
  },
  {
   "text": "2025 年 2 月",
   "start": 4.97,
   "end": 6.293,
   "id": "c2"
  },
  {
   "text": "Bybit 的冷钱包多签被盗",
   "start": 6.438,
   "end": 8.434,
   "id": "c3"
  },
  {
   "text": "损失约 15 亿美元",
   "start": 8.579,
   "end": 10.414,
   "id": "c4"
  },
  {
   "text": "FBI 公告把它归因于朝鲜",
   "start": 10.727,
   "end": 13.25,
   "id": "c5"
  },
  {
   "text": "Safe 的初步报告称",
   "start": 13.49,
   "end": 14.975,
   "id": "c6"
  },
  {
   "text": "2 月 4 日",
   "start": 15.229,
   "end": 16.016,
   "id": "c7"
  },
  {
   "text": "一名开发者的电脑失陷",
   "start": 16.262,
   "end": 18.083,
   "id": "c8"
  },
  {
   "text": "起因是运行了一个受污染的 Docker 项目",
   "start": 18.446,
   "end": 21.599,
   "id": "c9"
  },
  {
   "text": "攻击者没能注册自己的验证设备",
   "start": 21.941,
   "end": 25.18,
   "id": "c10"
  },
  {
   "text": "就劫持了活跃的 AWS 会话令牌",
   "start": 25.2,
   "end": 27.577,
   "id": "c11"
  },
  {
   "text": "然后 篡改了 S3 上 Safe 网页前端的脚本",
   "start": 27.927,
   "end": 31.314,
   "id": "c12"
  },
  {
   "text": "脚本先判断",
   "start": 31.57,
   "end": 32.742,
   "id": "c13"
  },
  {
   "text": "发起交易的是不是 Bybit 的多签地址",
   "start": 32.762,
   "end": 35.705,
   "id": "c14"
  },
  {
   "text": "不是 就一切正常",
   "start": 35.965,
   "end": 37.669,
   "id": "c15"
  },
  {
   "text": "是 界面照样显示一笔正常转账",
   "start": 37.93,
   "end": 40.818,
   "id": "c16"
  },
  {
   "text": "实际构造的是一次 DELEGATECALL",
   "start": 40.89,
   "end": 43.213,
   "id": "c17"
  },
  {
   "text": "签名人在硬件钱包上签名",
   "start": 43.51,
   "end": 45.803,
   "id": "c18"
  },
  {
   "text": "只看到一串哈希",
   "start": 45.85,
   "end": 47.43,
   "id": "c19"
  },
  {
   "text": "签名凑够门槛",
   "start": 47.752,
   "end": 49.461,
   "id": "c20"
  },
  {
   "text": "交易执行",
   "start": 49.752,
   "end": 50.351,
   "id": "c21"
  },
  {
   "text": "多签的实现合约被替换",
   "start": 50.454,
   "end": 53.754,
   "id": "c22"
  },
  {
   "text": "约 40 万枚 ETH 类资产被转走",
   "start": 54.123,
   "end": 56.653,
   "id": "c23"
  },
  {
   "text": "约 2 分钟后",
   "start": 56.893,
   "end": 57.754,
   "id": "c24"
  },
  {
   "text": "脚本被换回干净版本",
   "start": 57.907,
   "end": 59.582,
   "id": "c25"
  },
  {
   "text": "外部研究者打开页面",
   "start": 59.85,
   "end": 61.649,
   "id": "c26"
  },
  {
   "text": "看到的一切正常",
   "start": 61.715,
   "end": 63.232,
   "id": "c27"
  },
  {
   "text": "Verichains 称",
   "start": 63.607,
   "end": 64.652,
   "id": "c28"
  },
  {
   "text": "恶意代码只在特定条件下激活",
   "start": 64.882,
   "end": 67.492,
   "id": "c29"
  },
  {
   "text": "Sygnia 认为",
   "start": 67.822,
   "end": 68.779,
   "id": "c30"
  },
  {
   "text": "Safe 的云存储账号或密钥很可能泄露",
   "start": 68.981,
   "end": 72.04,
   "id": "c31"
  },
  {
   "text": "在 Bybit 自己的系统里",
   "start": 72.27,
   "end": 74.197,
   "id": "c32"
  },
  {
   "text": "没有发现入侵证据",
   "start": 74.291,
   "end": 75.654,
   "id": "c33"
  },
  {
   "text": "Safe 称合约不受影响",
   "start": 75.905,
   "end": 77.838,
   "id": "c34"
  },
  {
   "text": "关键在这里",
   "start": 78.18,
   "end": 79.585,
   "id": "c35"
  },
  {
   "text": "所有签名人都用同一个网页前端",
   "start": 79.83,
   "end": 82.714,
   "id": "c36"
  },
  {
   "text": "前端就是这个多签的单点",
   "start": 83.04,
   "end": 85.051,
   "id": "c37"
  },
  {
   "text": "增加签名人",
   "start": 85.33,
   "end": 86.587,
   "id": "c38"
  },
  {
   "text": "无法解决这个问题",
   "start": 86.699,
   "end": 88.282,
   "id": "c39"
  },
  {
   "text": "防线在签名这一步",
   "start": 88.51,
   "end": 90.256,
   "id": "c40"
  },
  {
   "text": "签名人用独立工具",
   "start": 90.444,
   "end": 92.274,
   "id": "c41"
  },
  {
   "text": "重新计算交易哈希",
   "start": 92.294,
   "end": 94.103,
   "id": "c42"
  },
  {
   "text": "在硬件钱包上核对",
   "start": 94.282,
   "end": 95.99,
   "id": "c43"
  },
  {
   "text": "例行转账只允许普通调用",
   "start": 96.347,
   "end": 98.564,
   "id": "c44"
  },
  {
   "text": "委托调用进单独的审批流程",
   "start": 98.809,
   "end": 101.19,
   "id": "c45"
  },
  {
   "text": "发布方用独立系统",
   "start": 101.52,
   "end": 103.486,
   "id": "c46"
  },
  {
   "text": "比对线上文件和构建产物的哈希",
   "start": 103.694,
   "end": 106.84,
   "id": "c47"
  },
  {
   "text": "但比对只覆盖那一刻",
   "start": 107.185,
   "end": 109.19,
   "id": "c48"
  },
  {
   "text": "那个位置",
   "start": 109.233,
   "end": 110.082,
   "id": "c49"
  },
  {
   "text": "要在多个位置反复比对",
   "start": 110.451,
   "end": 112.691,
   "id": "c50"
  },
  {
   "text": "并保留每个版本的哈希和访问日志",
   "start": 112.878,
   "end": 116.146,
   "id": "c51"
  }
 ]
}