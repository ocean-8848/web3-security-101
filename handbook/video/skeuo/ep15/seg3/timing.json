 "captions": [
  {
   "text": "第一个边界",
   "start": 1.644,
   "end": 2.508,
   "id": "c0"
  },
  {
   "text": "是用户的签名",
   "start": 2.629,
   "end": 4.007,
   "id": "c1"
  },
  {
   "text": "用户签的",
   "start": 4.25,
   "end": 5.231,
   "id": "c2"
  },
  {
   "text": "是用户操作的哈希",
   "start": 5.33,
   "end": 6.874,
   "id": "c3"
  },
  {
   "text": "哈希怎么编码",
   "start": 7.11,
   "end": 8.734,
   "id": "c4"
  },
  {
   "text": "决定了哪些字段受签名保护",
   "start": 8.885,
   "end": 11.624,
   "id": "c5"
  },
  {
   "text": "2023 年 3 月",
   "start": 11.89,
   "end": 13.3,
   "id": "c6"
  },
  {
   "text": "Alchemy 披露过一个打包漏洞",
   "start": 13.502,
   "end": 15.787,
   "id": "c7"
  },
  {
   "text": "EntryPoint 的打包函数",
   "start": 16.127,
   "end": 17.896,
   "id": "c8"
  },
  {
   "text": "直接读取动态字段的偏移量",
   "start": 18.057,
   "end": 20.357,
   "id": "c9"
  },
  {
   "text": "没有检查",
   "start": 20.494,
   "end": 21.193,
   "id": "c10"
  },
  {
   "text": "结果 同一个用户操作",
   "start": 21.45,
   "end": 23.409,
   "id": "c11"
  },
  {
   "text": "能算出不同的哈希",
   "start": 23.544,
   "end": 25.178,
   "id": "c12"
  },
  {
   "text": "不同的用户操作",
   "start": 25.526,
   "end": 26.735,
   "id": "c13"
  },
  {
   "text": "也能算出同一个哈希",
   "start": 26.785,
   "end": 28.478,
   "id": "c14"
  },
  {
   "text": "示例 Paymaster 的签名",
   "start": 28.864,
   "end": 31.031,
   "id": "c15"
  },
  {
   "text": "签完以后",
   "start": 31.148,
   "end": 31.939,
   "id": "c16"
  },
  {
   "text": "内容仍能被改",
   "start": 32.053,
   "end": 33.454,
   "id": "c17"
  },
  {
   "text": "EntryPoint 已经修复",
   "start": 33.807,
   "end": 35.314,
   "id": "c18"
  },
  {
   "text": "没有已知损失",
   "start": 35.456,
   "end": 36.51,
   "id": "c19"
  },
  {
   "text": "第二个边界",
   "start": 36.823,
   "end": 37.749,
   "id": "c20"
  },
  {
   "text": "是 Paymaster 自己的签名",
   "start": 37.845,
   "end": 39.712,
   "id": "c21"
  },
  {
   "text": "这是另一套签名",
   "start": 40.087,
   "end": 41.401,
   "id": "c22"
  },
  {
   "text": "也要覆盖链 ID",
   "start": 41.525,
   "end": 43.013,
   "id": "c23"
  },
  {
   "text": "nonce 和有效期",
   "start": 43.146,
   "end": 44.514,
   "id": "c24"
  },
  {
   "text": "少了任何一项",
   "start": 44.77,
   "end": 45.989,
   "id": "c25"
  },
  {
   "text": "就可能被重放或抢跑",
   "start": 46.164,
   "end": 47.947,
   "id": "c26"
  },
  {
   "text": "第三个边界",
   "start": 48.19,
   "end": 49.288,
   "id": "c27"
  },
  {
   "text": "是账户自己的验证逻辑",
   "start": 49.479,
   "end": 51.588,
   "id": "c28"
  },
  {
   "text": "验证只检查签名",
   "start": 51.85,
   "end": 53.558,
   "id": "c29"
  },
  {
   "text": "验证写错了",
   "start": 53.83,
   "end": 54.886,
   "id": "c30"
  },
  {
   "text": "执行的就是攻击者的调用",
   "start": 55.032,
   "end": 56.819,
   "id": "c31"
  },
  {
   "text": "2024 年 3 月",
   "start": 57.197,
   "end": 58.388,
   "id": "c32"
  },
  {
   "text": "Code4rena 审计了 Coinbase",
   "start": 58.429,
   "end": 60.7,
   "id": "c33"
  },
  {
   "text": "SmartWallet",
   "start": 60.72,
   "end": 61.934,
   "id": "c34"
  },
  {
   "text": "删除 owner 的操作",
   "start": 62.19,
   "end": 63.748,
   "id": "c35"
  },
  {
   "text": "可以跨链重放",
   "start": 63.768,
   "end": 64.968,
   "id": "c36"
  },
  {
   "text": "各条链上",
   "start": 65.21,
   "end": 66.084,
   "id": "c37"
  },
  {
   "text": "同一个位置的 owner 可能不同",
   "start": 66.202,
   "end": 68.22,
   "id": "c38"
  },
  {
   "text": "重放过去",
   "start": 68.47,
   "end": 69.588,
   "id": "c39"
  },
  {
   "text": "可能删错人",
   "start": 69.633,
   "end": 70.633,
   "id": "c40"
  },
  {
   "text": "甚至把账户永久锁死",
   "start": 70.972,
   "end": 73.07,
   "id": "c41"
  },
  {
   "text": "修复后 改成传入 owner 地址 再核对",
   "start": 73.33,
   "end": 76.337,
   "id": "c42"
  },
  {
   "text": "Biconomy 的审计里",
   "start": 76.694,
   "end": 77.948,
   "id": "c43"
  },
  {
   "text": "智能账户的实现合约可以被销毁",
   "start": 78.102,
   "end": 81.242,
   "id": "c44"
  },
  {
   "text": "它的会话密钥模块",
   "start": 81.53,
   "end": 83.046,
   "id": "c45"
  },
  {
   "text": "只限制单笔额度",
   "start": 83.164,
   "end": 84.599,
   "id": "c46"
  },
  {
   "text": "不限制累计",
   "start": 84.661,
   "end": 85.545,
   "id": "c47"
  },
  {
   "text": "所以 哈希和签名要覆盖规范的编码和链 ID",
   "start": 85.83,
   "end": 90.608,
   "id": "c48"
  },
  {
   "text": "多链账户的管理操作",
   "start": 90.95,
   "end": 92.63,
   "id": "c49"
  },
  {
   "text": "要防重放",
   "start": 92.719,
   "end": 93.676,
   "id": "c50"
  }
 ]
}