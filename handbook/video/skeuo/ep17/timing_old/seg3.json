 "captions": [
  {
   "text": "前面是你问节点",
   "start": 1.55,
   "end": 3.141,
   "id": "c0"
  },
  {
   "text": "节点答错",
   "start": 3.361,
   "end": 4.382,
   "id": "c1"
  },
  {
   "text": "另一种情况",
   "start": 4.743,
   "end": 5.677,
   "id": "c2"
  },
  {
   "text": "是节点自己看到的网络",
   "start": 5.925,
   "end": 7.879,
   "id": "c3"
  },
  {
   "text": "被人操纵",
   "start": 7.954,
   "end": 8.75,
   "id": "c4"
  },
  {
   "text": "节点之间直接交换区块和交易",
   "start": 9.03,
   "end": 11.76,
   "id": "c5"
  },
  {
   "text": "这叫 P2P 网络",
   "start": 11.829,
   "end": 13.153,
   "id": "c6"
  },
  {
   "text": "日蚀攻击",
   "start": 13.505,
   "end": 14.503,
   "id": "c7"
  },
  {
   "text": "是攻击者占满受害节点的全部对等连接",
   "start": 14.692,
   "end": 18.151,
   "id": "c8"
  },
  {
   "text": "节点只看到攻击者给的区块和交易",
   "start": 18.43,
   "end": 21.378,
   "id": "c9"
  },
  {
   "text": "最关键的一步",
   "start": 21.69,
   "end": 22.814,
   "id": "c10"
  },
  {
   "text": "在节点重启",
   "start": 22.911,
   "end": 24.364,
   "id": "c11"
  },
  {
   "text": "重启时 节点会从地址表里挑选对等节点",
   "start": 24.63,
   "end": 29.117,
   "id": "c12"
  },
  {
   "text": "地址表如果已经被攻击者填满",
   "start": 29.41,
   "end": 31.987,
   "id": "c13"
  },
  {
   "text": "它连上的就全是攻击者",
   "start": 32.123,
   "end": 34.366,
   "id": "c14"
  },
  {
   "text": "2018 年的一篇论文显示",
   "start": 34.697,
   "end": 36.701,
   "id": "c15"
  },
  {
   "text": "两台主机",
   "start": 37.125,
   "end": 38.07,
   "id": "c16"
  },
  {
   "text": "各一个 IP",
   "start": 38.184,
   "end": 39.101,
   "id": "c17"
  },
  {
   "text": "就能日蚀一个以太坊节点",
   "start": 39.245,
   "end": 41.376,
   "id": "c18"
  },
  {
   "text": "Geth 1.8.0 随后限制了同一网段的节点数",
   "start": 41.705,
   "end": 45.938,
   "id": "c19"
  },
  {
   "text": "比特币加了锚点连接",
   "start": 46.25,
   "end": 48.087,
   "id": "c20"
  },
  {
   "text": "重启时优先恢复上次的出站连接",
   "start": 48.45,
   "end": 51.507,
   "id": "c21"
  },
  {
   "text": "被日蚀的节点",
   "start": 51.838,
   "end": 53.222,
   "id": "c22"
  },
  {
   "text": "同步状态看起来正常",
   "start": 53.405,
   "end": 55.207,
   "id": "c23"
  },
  {
   "text": "它有连接",
   "start": 55.47,
   "end": 56.519,
   "id": "c24"
  },
  {
   "text": "也有新块",
   "start": 56.579,
   "end": 57.44,
   "id": "c25"
  },
  {
   "text": "只是落后",
   "start": 57.538,
   "end": 58.389,
   "id": "c26"
  },
  {
   "text": "或者在错误的分支上",
   "start": 58.522,
   "end": 60.039,
   "id": "c27"
  },
  {
   "text": "对等节点数只说明有连接",
   "start": 60.354,
   "end": 62.671,
   "id": "c28"
  },
  {
   "text": "不说明连接来自独立的运营方",
   "start": 62.814,
   "end": 65.25,
   "id": "c29"
  },
  {
   "text": "节点崩溃",
   "start": 65.605,
   "end": 66.58,
   "id": "c30"
  },
  {
   "text": "也可能是攻击的第一步",
   "start": 66.718,
   "end": 68.39,
   "id": "c31"
  },
  {
   "text": "切换逻辑如果把流量转到不可信的备用节点",
   "start": 68.61,
   "end": 72.638,
   "id": "c32"
  },
  {
   "text": "DoS 就成了数据污染的前置步骤",
   "start": 72.848,
   "end": 76.194,
   "id": "c33"
  },
  {
   "text": "开头的事件正是这样",
   "start": 76.527,
   "end": 78.092,
   "id": "c34"
  },
  {
   "text": "另一类事故",
   "start": 78.423,
   "end": 79.392,
   "id": "c35"
  },
  {
   "text": "来自节点自己的配置",
   "start": 79.544,
   "end": 81.338,
   "id": "c36"
  },
  {
   "text": "2018 年",
   "start": 81.684,
   "end": 82.495,
   "id": "c37"
  },
  {
   "text": "一个团伙扫描暴露 JSON-RPC 的以太坊节点",
   "start": 82.722,
   "end": 86.504,
   "id": "c38"
  },
  {
   "text": "盗走约 3.8 万个 ETH",
   "start": 86.628,
   "end": 88.861,
   "id": "c39"
  },
  {
   "text": "Geth 默认只监听本机",
   "start": 89.09,
   "end": 91.155,
   "id": "c40"
  },
  {
   "text": "接口是运营者自己打开的",
   "start": 91.415,
   "end": 93.488,
   "id": "c41"
  },
  {
   "text": "RPC 接口只绑内网或本机",
   "start": 93.801,
   "end": 96.193,
   "id": "c42"
  },
  {
   "text": "对外必须经过认证网关",
   "start": 96.357,
   "end": 98.336,
   "id": "c43"
  },
  {
   "text": "给执行客户端下指令的 Engine API",
   "start": 98.663,
   "end": 102.306,
   "id": "c44"
  },
  {
   "text": "只对共识客户端开放",
   "start": 102.326,
   "end": 104.328,
   "id": "c45"
  },
  {
   "text": "并用 JWT 认证",
   "start": 104.348,
   "end": 105.473,
   "id": "c46"
  }
 ]
}