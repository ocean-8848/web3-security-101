 "captions": [
  {
   "text": "按角色 各做一件事",
   "start": 1.645,
   "end": 3.575,
   "id": "c0"
  },
  {
   "text": "交易所和跨链桥",
   "start": 3.85,
   "end": 5.569,
   "id": "c1"
  },
  {
   "text": "列出每个资金决策读取的数据源",
   "start": 5.817,
   "end": 8.622,
   "id": "c2"
  },
  {
   "text": "去掉重复的运营方",
   "start": 8.813,
   "end": 10.602,
   "id": "c3"
  },
  {
   "text": "看剩下几个",
   "start": 10.805,
   "end": 11.875,
   "id": "c4"
  },
  {
   "text": "节点运维",
   "start": 12.15,
   "end": 13.06,
   "id": "c5"
  },
  {
   "text": "确认 RPC 和 Engine API 没有暴露在公网",
   "start": 13.272,
   "end": 16.553,
   "id": "c6"
  },
  {
   "text": "验证者团队",
   "start": 16.861,
   "end": 17.847,
   "id": "c7"
  },
  {
   "text": "把故障切换改成人工确认",
   "start": 17.973,
   "end": 20.172,
   "id": "c8"
  },
  {
   "text": "原实例停止之后",
   "start": 20.33,
   "end": 21.633,
   "id": "c9"
  },
  {
   "text": "才启动备用",
   "start": 21.715,
   "end": 22.688,
   "id": "c10"
  },
  {
   "text": "普通用户",
   "start": 22.91,
   "end": 23.774,
   "id": "c11"
  },
  {
   "text": "余额显示异常时",
   "start": 24.206,
   "end": 25.645,
   "id": "c12"
  },
  {
   "text": "换一个 RPC 或区块浏览器交叉确认",
   "start": 25.833,
   "end": 28.67,
   "id": "c13"
  },
  {
   "text": "自定义 RPC",
   "start": 28.97,
   "end": 30.191,
   "id": "c14"
  },
  {
   "text": "只添加官方文档列出的地址",
   "start": 30.3,
   "end": 32.683,
   "id": "c15"
  },
  {
   "text": "回到开头的问题",
   "start": 32.95,
   "end": 34.301,
   "id": "c16"
  },
  {
   "text": "监控查询的是同一个节点",
   "start": 34.53,
   "end": 36.562,
   "id": "c17"
  },
  {
   "text": "看到的是真实数据",
   "start": 36.687,
   "end": 38.322,
   "id": "c18"
  },
  {
   "text": "它无法发现这次攻击",
   "start": 38.499,
   "end": 40.097,
   "id": "c19"
  },
  {
   "text": "要发现它",
   "start": 40.35,
   "end": 41.3,
   "id": "c20"
  },
  {
   "text": "需要拿验证者实际收到的结果",
   "start": 41.327,
   "end": 44.026,
   "id": "c21"
  },
  {
   "text": "和不同运营方的数据源比对",
   "start": 44.125,
   "end": 46.404,
   "id": "c22"
  },
  {
   "text": "这只在来源真正独立时成立",
   "start": 46.748,
   "end": 49.277,
   "id": "c23"
  },
  {
   "text": "你读到的链",
   "start": 49.51,
   "end": 50.492,
   "id": "c24"
  },
  {
   "text": "只是某个节点告诉你的链",
   "start": 50.522,
   "end": 52.284,
   "id": "c25"
  },
  {
   "text": "先问几家独立的节点 再签名 再入账",
   "start": 52.472,
   "end": 55.643,
   "id": "c26"
  },
  {
   "text": "下一集讲钱包与密钥管理的安全",
   "start": 55.89,
   "end": 59.04,
   "id": "c27"
  }
 ]
}