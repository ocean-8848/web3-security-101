 "captions": [
  {
   "text": "先看充值这一头",
   "start": 1.648,
   "end": 3.246,
   "id": "c0"
  },
  {
   "text": "假充值 是交易所把一笔不该算数的转账",
   "start": 4.22,
   "end": 7.735,
   "id": "c1"
  },
  {
   "text": "记成了用户的充值",
   "start": 7.851,
   "end": 9.282,
   "id": "c2"
  },
  {
   "text": "失败的 伪造的",
   "start": 10.272,
   "end": 12.084,
   "id": "c3"
  },
  {
   "text": "到账金额不对的 都算",
   "start": 12.284,
   "end": 14.132,
   "id": "c4"
  },
  {
   "text": "第一种 交易失败了",
   "start": 15.1,
   "end": 16.924,
   "id": "c5"
  },
  {
   "text": "却已经上链",
   "start": 17.016,
   "end": 17.912,
   "id": "c6"
  },
  {
   "text": "扫描服务只看交易存不存在",
   "start": 18.896,
   "end": 21.435,
   "id": "c7"
  },
  {
   "text": "不看执行状态",
