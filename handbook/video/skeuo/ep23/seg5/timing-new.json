   "end": 53.261,
   "id": "c25"
  },
  {
   "text": "要传递发起人和受益人的信息",
   "start": 53.281,
   "end": 55.463,
   "id": "c26"
  },
  {
   "text": "第四道 反洗钱交易监控",
   "start": 56.456,
   "end": 58.804,
   "id": "c27"
  },
  {
   "text": "盯住拆分和快进快出",
