   "end": 34.699,
   "id": "c17"
  },
  {
   "text": "第一道 制裁筛查",
   "start": 35.684,
   "end": 37.675,
   "id": "c18"
  },
  {
   "text": "比如美国财政部 OFAC 的名单",
   "start": 37.743,
   "end": 40.532,
   "id": "c19"
  },
  {
   "text": "命中就拦",
   "start": 40.576,
   "end": 41.52,
   "id": "c20"
  },
  {
   "text": "第二道 链上风险评分",
   "start": 42.504,
   "end": 44.805,
   "id": "c21"
  },
  {
   "text": "看资金在几跳以内",
