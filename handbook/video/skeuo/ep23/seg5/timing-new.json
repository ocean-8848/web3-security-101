 "captions": [
  {
   "text": "再看交易所的另一张面孔 检查站",
   "start": 1.648,
   "end": 4.484,
   "id": "c0"
  },
  {
   "text": "这里的攻击者",
   "start": 5.468,
   "end": 6.542,
   "id": "c1"
  },
  {
   "text": "不需要攻破交易所的系统",
   "start": 6.599,
   "end": 8.304,
   "id": "c2"
  },
  {
   "text": "只需要规则有漏洞",
   "start": 8.384,
   "end": 9.757,
   "id": "c3"
  },
  {
   "text": "盗来的资金",
   "start": 10.728,
   "end": 11.743,
   "id": "c4"
  },
  {
   "text": "想充进交易所",
   "start": 11.835,
   "end": 13.148,
   "id": "c5"
  },
  {
   "text": "再提走或者换掉",
