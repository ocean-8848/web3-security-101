   "dur": 2.088,
   "speechStart": 47.81,
   "speechEnd": 48.964
  },
  {
   "id": "seg1-11",
   "text": "提现已经暂停，热钱包服务也关掉了。",
   "spoken": "提现已经暂停，热钱包服务也关掉了。",
   "src": "/Users/k/Workon/Learning/web3/web3-security-101/handbook/video/skeuo/ep23/audio/lines/seg1-11.mp3",
