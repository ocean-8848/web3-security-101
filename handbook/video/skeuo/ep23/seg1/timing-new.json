   "start": 54.224,
   "dur": 5.64,
   "speechStart": 54.322,
   "speechEnd": 59.024
  },
  {
   "id": "seg1-13",
   "text": "这时候，新转进这个地址的钱，安全吗？",
   "spoken": "这时候，新转进这个地址的钱，安全吗？",
