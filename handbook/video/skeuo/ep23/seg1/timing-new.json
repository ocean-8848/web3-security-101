 "captions": [
  {
   "text": "2026 年 10 月 29 日",
   "start": 1.648,
   "end": 3.401,
   "id": "c0"
  },
  {
   "text": "Binance 的热钱包",
   "start": 3.433,
   "end": 4.687,
   "id": "c1"
  },
  {
   "text": "开始大额转出",
   "start": 4.707,
   "end": 6.008,
   "id": "c2"
  },
  {
   "text": "先是 XRP",
   "start": 6.98,
   "end": 8.317,
   "id": "c3"
  },
  {
   "text": "再是比特币",
   "start": 8.337,
   "end": 9.281,
   "id": "c4"
  },
  {
   "text": "然后是以太坊",
   "start": 9.384,
   "end": 10.566,
   "id": "c5"
  },
  {
   "text": "一条链接着一条链",
   "start": 11.544,
   "end": 12.952,
   "id": "c6"
  },
  {
   "text": "资产往外流",
   "start": 13.139,
   "end": 14.404,
   "id": "c7"
  },
  {
   "text": "交易所发现之后",
   "start": 15.364,
   "end": 16.76,
   "id": "c8"
  },
  {
   "text": "暂停了提现",
   "start": 16.852,
   "end": 17.891,
   "id": "c9"
  },
  {
   "text": "可按项目方的初步报告",
   "start": 18.872,
   "end": 20.696,
   "id": "c10"
  },
  {
   "text": "暂停提现",
   "start": 20.753,
   "end": 21.78,
   "id": "c11"
  },
  {
   "text": "没有挡住全部的未授权转账",
   "start": 21.872,
   "end": 24.22,
   "id": "c12"
  },
  {
   "text": "最后一笔",
   "start": 25.212,
   "end": 26.024,
   "id": "c13"
  },
  {
   "text": "到世界协调时 23 点 56 分 才转完",
   "start": 26.188,
   "end": 29.667,
   "id": "c14"
  },
  {
   "text": "项目方的口径是",
