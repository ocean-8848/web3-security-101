 "captions": [
  {
   "text": "2022 年 2 月",
   "start": 1.653,
   "end": 3.149,
   "id": "c0"
  },
  {
   "text": "Wormhole 跨链桥在 Solana 一侧",
   "start": 3.52,
   "end": 7.258,
   "id": "c1"
  },
  {
   "text": "被铸出约 12 万枚 wETH",
   "start": 7.278,
   "end": 10.072,
   "id": "c2"
  },
  {
   "text": "按事发时的价格",
   "start": 10.426,
   "end": 12.74,
   "id": "c3"
  },
  {
   "text": "约 3.2 亿美元",
   "start": 12.952,
   "end": 14.899,
   "id": "c4"
  },
  {
   "text": "攻击者往程序里",
   "start": 15.205,
   "end": 16.81,
   "id": "c5"
  },
  {
   "text": "传了一个伪造的系统账户",
   "start": 16.87,
   "end": 18.864,
   "id": "c6"
  },
  {
   "text": "程序读了这个账户",
   "start": 19.266,
   "end": 20.899,
   "id": "c7"
  },
  {
   "text": "没有核对它是不是真的",
   "start": 21.145,
   "end": 22.704,
   "id": "c8"
  },
  {
   "text": "守护者的签名验证",
   "start": 22.99,
   "end": 24.782,
   "id": "c9"
  },
  {
   "text": "就这样被绕开",
   "start": 24.915,
   "end": 26.057,
   "id": "c10"
  },
  {
   "text": "先猜一道题",
   "start": 26.33,
   "end": 27.33,
   "id": "c11"
  },
  {
   "text": "在以太坊上",
   "start": 27.59,
   "end": 28.811,
   "id": "c12"
  },
  {
   "text": "合约要读另一个合约",
   "start": 28.89,
   "end": 30.795,
   "id": "c13"
  },
  {
   "text": "地址写在代码或存储里",
   "start": 31.133,
   "end": 33.335,
   "id": "c14"
  },
  {
   "text": "在 Solana 上",
   "start": 33.57,
   "end": 34.765,
   "id": "c15"
  },
  {
   "text": "程序要读的账户",
   "start": 34.919,
   "end": 36.386,
   "id": "c16"
  },
  {
   "text": "由谁提供",
   "start": 36.446,
   "end": 37.319,
   "id": "c17"
  },
  {
   "text": "先记住这个问题",
   "start": 37.83,
   "end": 38.991,
   "id": "c18"
  },
  {
   "text": "按 Kudelski 和 Halborn 的分析",
   "start": 39.25,
   "end": 41.69,
   "id": "c19"
  },
  {
   "text": "问题出在一个已经弃用的读取函数",
   "start": 41.902,
   "end": 44.771,
   "id": "c20"
  },
  {
   "text": "它不检查传进来的系统账户",
   "start": 45.081,
   "end": 47.474,
   "id": "c21"
  },
  {
   "text": "是不是真的系统账户",
   "start": 47.496,
   "end": 49.155,
   "id": "c22"
  },
  {
   "text": "修复的办法",
   "start": 49.45,
   "end": 50.606,
   "id": "c23"
  },
  {
   "text": "是改用带校验的函数",
   "start": 50.859,
   "end": 52.838,
   "id": "c24"
  },
  {
   "text": "Jump Crypto 补足了全部 ETH",
   "start": 52.976,
   "end": 55.633,
   "id": "c25"
  },
  {
   "text": "同样的错误",
   "start": 55.91,
   "end": 57.16,
   "id": "c26"
  },
  {
   "text": "换一条链",
   "start": 57.271,
   "end": 58.152,
   "id": "c27"
  },
  {
   "text": "就换了一副样子",
   "start": 58.217,
   "end": 59.423,
   "id": "c28"
  },
  {
   "text": "每种链上的程序",
   "start": 59.748,
   "end": 61.139,
   "id": "c29"
  },
  {
   "text": "到底在相信什么",
   "start": 61.347,
   "end": 62.7,
   "id": "c30"
  }
 ]
}