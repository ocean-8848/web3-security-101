 "captions": [
  {
   "text": "放到一个具体场景里",
   "start": 1.648,
   "end": 3.234,
   "id": "c0"
  },
  {
   "text": "交易所要接入一条新链",
   "start": 3.598,
   "end": 5.375,
   "id": "c1"
  },
  {
   "text": "照搬以太坊的接入逻辑",
   "start": 6.356,
   "end": 8.312,
   "id": "c2"
  },
  {
   "text": "是假充值",
   "start": 8.332,
   "end": 9.609,
   "id": "c3"
  },
  {
   "text": "错账和资金丢失的主要来源",
   "start": 9.665,
   "end": 12.168,
   "id": "c4"
  },
  {
   "text": "接入的人",
   "start": 13.152,
   "end": 14.107,
   "id": "c5"
  },
  {
   "text": "先问这几件事",
   "start": 14.175,
   "end": 15.322,
   "id": "c6"
  },
  {
   "text": "失败的交易会不会上链",
   "start": 16.3,
   "end": 18.303,
   "id": "c7"
  },
  {
   "text": "实际到账金额怎么读",
   "start": 18.454,
   "end": 20.136,
   "id": "c8"
  },
  {
   "text": "代币由什么唯一标识",
   "start": 21.104,
   "end": 22.834,
   "id": "c9"
  },
  {
   "text": "合约地址",
   "start": 22.854,
   "end": 23.774,
   "id": "c10"
  },
  {
   "text": "mint 地址",
   "start": 23.866,
   "end": 24.916,
   "id": "c11"
  },
  {
   "text": "对象类型",
   "start": 24.937,
   "end": 25.881,
   "id": "c12"
  },
  {
   "text": "还是 denom",
   "start": 25.901,
   "end": 26.893,
   "id": "c13"
  },
  {
   "text": "有没有同名假币",
   "start": 27.268,
   "end": 28.628,
   "id": "c14"
  },
  {
   "text": "多少个区块之后不可回滚",
   "start": 29.628,
   "end": 31.798,
   "id": "c15"
  },
  {
   "text": "历史上有没有停链",
   "start": 31.937,
   "end": 33.31,
   "id": "c16"
  },
  {
   "text": "有没有两个独立运营的节点",
   "start": 34.288,
   "end": 36.112,
   "id": "c17"
  },
  {
   "text": "现有的 HSM 和 MPC",
   "start": 36.488,
   "end": 38.8,
   "id": "c18"
  },
  {
   "text": "支不支持这条链的签名算法",
   "start": 38.916,
   "end": 40.931,
   "id": "c19"
  },
  {
   "text": "资产是否依赖链下索引器",
   "start": 41.924,
   "end": 43.987,
   "id": "c20"
  },
  {
   "text": "用哪个版本",
   "start": 44.007,
   "end": 44.986,
   "id": "c21"
  },
  {
   "text": "多个索引器的结果是否一致",
   "start": 45.126,
   "end": 47.117,
   "id": "c22"
  },
  {
   "text": "链官方的 SDK 也是供应链",
   "start": 48.12,
   "end": 50.742,
   "id": "c23"
  },
  {
   "text": "签名服务不要和业务代码共用依赖",
   "start": 51.117,
   "end": 53.871,
   "id": "c24"
  },
  {
   "text": "普通用户",
   "start": 54.868,
   "end": 55.811,
   "id": "c25"
  },
  {
   "text": "跨链前确认代币的唯一标识",
   "start": 56.07,
   "end": 58.204,
   "id": "c26"
  },
  {
   "text": "不只看名称",
   "start": 58.249,
   "end": 59.347,
   "id": "c27"
  },
  {
   "text": "在 Solana 上签名时",
   "start": 59.71,
   "end": 61.488,
   "id": "c28"
  },
  {
   "text": "看到陌生程序 不签",
   "start": 61.52,
   "end": 63.488,
   "id": "c29"
  },
  {
   "text": "回到开头的问题",
   "start": 64.472,
   "end": 65.856,
   "id": "c30"
  },
  {
   "text": "Solana 程序要读的账户",
   "start": 66.231,
   "end": 67.949,
   "id": "c31"
  },
  {
   "text": "由谁提供",
   "start": 67.981,
   "end": 68.913,
   "id": "c32"
  },
  {
   "text": "由调用者在交易里传进来",
   "start": 70.18,
   "end": 72.278,
   "id": "c33"
  },
  {
   "text": "所以程序必须自己核对每个账户的 owner",
   "start": 72.642,
   "end": 75.942,
   "id": "c34"
  },
  {
   "text": "类型和地址",
   "start": 75.975,
   "end": 77.312,
   "id": "c35"
  },
  {
   "text": "这个答案只对 Solana 成立",
   "start": 78.296,
   "end": 80.442,
   "id": "c36"
  },
  {
   "text": "换一条链",
   "start": 80.817,
   "end": 81.808,
   "id": "c37"
  },
  {
   "text": "输入换了样子",
   "start": 81.912,
   "end": 83.011,
   "id": "c38"
  },
  {
   "text": "要问的仍是同一个问题",
   "start": 84.012,
   "end": 85.741,
   "id": "c39"
  },
  {
   "text": "谁决定这个输入可信",
   "start": 85.869,
   "end": 87.384,
   "id": "c40"
  },
  {
   "text": "换一种账户模型",
   "start": 88.384,
   "end": 89.827,
   "id": "c41"
  },
  {
   "text": "就换一组漏洞",
   "start": 89.991,
   "end": 91.042,
   "id": "c42"
  },
  {
   "text": "下一集讲 ZK 与证明系统的安全",
   "start": 92.036,
   "end": 94.789,
   "id": "c43"
  }
