 "captions": [
  {
   "text": "先给准确的说法",
   "start": 1.648,
   "end": 3.103,
   "id": "c0"
  },
  {
   "text": "执行模型",
   "start": 4.1,
   "end": 5.222,
   "id": "c1"
  },
  {
   "text": "是一条链怎么存状态",
   "start": 5.266,
   "end": 6.853,
   "id": "c2"
  },
  {
   "text": "怎么调用程序",
   "start": 7.076,
   "end": 8.222,
   "id": "c3"
  },
  {
   "text": "怎么决定谁能改什么",
   "start": 8.385,
   "end": 9.817,
   "id": "c4"
  },
  {
   "text": "漏洞的本质",
   "start": 10.776,
   "end": 11.91,
   "id": "c5"
  },
  {
   "text": "在哪条链上都一样",
   "start": 11.966,
   "end": 13.35,
   "id": "c6"
  },
  {
   "text": "程序相信了一个不该相信的输入",
   "start": 14.332,
   "end": 16.597,
   "id": "c7"
  },
  {
   "text": "变的 是输入的样子",
   "start": 17.576,
   "end": 19.507,
   "id": "c8"
  },
  {
   "text": "在 EVM 上",
   "start": 20.508,
   "end": 21.618,
   "id": "c9"
  },
  {
   "text": "合约拥有自己的存储",
   "start": 21.781,
   "end": 23.392,
   "id": "c10"
  },
  {
   "text": "攻击者换不掉它",
   "start": 23.412,
   "end": 24.725,
   "id": "c11"
  },
  {
   "text": "输入是参数和外部调用",
   "start": 25.089,
   "end": 27.175,
   "id": "c12"
  },
  {
   "text": "在 Solana 上",
   "start": 28.168,
   "end": 29.207,
   "id": "c13"
  },
  {
   "text": "程序本身不存状态",
   "start": 29.227,
   "end": 30.802,
   "id": "c14"
  },
  {
   "text": "账户全部由调用者传进来",
   "start": 31.177,
   "end": 33.383,
   "id": "c15"
  },
  {
   "text": "在 Move 上",
   "start": 34.364,
   "end": 35.343,
   "id": "c16"
  },
  {
   "text": "状态是带类型的对象",
   "start": 35.447,
   "end": 37.319,
   "id": "c17"
  },
  {
   "text": "输入是对象",
   "start": 37.695,
   "end": 38.769,
   "id": "c18"
  },
  {
   "text": "风险常在数学库和权限",
   "start": 38.861,
   "end": 41.031,
   "id": "c19"
  },
  {
   "text": "在 Bitcoin 上",
   "start": 42.024,
   "end": 43.194,
   "id": "c20"
  },
  {
   "text": "链只记录交易",
   "start": 43.226,
   "end": 44.396,
   "id": "c21"
  },
  {
   "text": "铭文这类资产的余额",
   "start": 44.771,
   "end": 46.429,
   "id": "c22"
  },
  {
   "text": "由链下的索引器解释",
   "start": 46.45,
   "end": 48.048,
   "id": "c23"
  },
  {
   "text": "在 Cosmos 上",
   "start": 49.036,
   "end": 50.229,
   "id": "c24"
  },
  {
   "text": "各条应用链用 IBC",
   "start": 50.428,
   "end": 52.194,
   "id": "c25"
  },
  {
   "text": "验证对方链上的状态",
   "start": 52.214,
   "end": 53.658,
   "id": "c26"
  },
  {
   "text": "打个比方",
   "start": 54.656,
   "end": 55.611,
   "id": "c27"
  },
  {
   "text": "五个国家的海关",
   "start": 56.748,
   "end": 58.001,
   "id": "c28"
  },
  {
   "text": "都要防走私",
   "start": 58.152,
   "end": 59.12,
   "id": "c29"
  },
  {
   "text": "EVM 查行李",
   "start": 60.088,
   "end": 61.281,
   "id": "c30"
  },
  {
   "text": "Solana 查护照",
   "start": 61.397,
   "end": 62.746,
   "id": "c31"
  },
  {
   "text": "Move 给每件货物贴防伪芯片",
   "start": 62.814,
   "end": 65.127,
   "id": "c32"
  },
  {
   "text": "Bitcoin 只查集装箱的封条",
   "start": 66.116,
   "end": 68.202,
   "id": "c33"
  },
  {
   "text": "不管里面装什么",
   "start": 68.223,
   "end": 69.345,
   "id": "c34"
  },
  {
   "text": "Cosmos 和邻国互认海关章",
   "start": 69.708,
   "end": 72.212,
   "id": "c35"
  },
  {
   "text": "走私者在每个国家",
   "start": 73.2,
   "end": 74.846,
   "id": "c36"
  },
  {
   "text": "都找最薄弱的那一环",
   "start": 74.926,
   "end": 76.56,
   "id": "c37"
  },
  {
   "text": "比喻不成立的地方是",
   "start": 77.548,
   "end": 79.122,
   "id": "c38"
  },
  {
   "text": "真实的跨生态集成里",
   "start": 79.262,
   "end": 81.075,
   "id": "c39"
  },
  {
   "text": "同一笔资产会经过好几个国家",
   "start": 81.179,
   "end": 83.73,
   "id": "c40"
  },
  {
   "text": "每多一种模型",
   "start": 84.728,
   "end": 85.993,
   "id": "c41"
  },
  {
   "text": "就多一组需要专门知识的检查项",
   "start": 86.013,
   "end": 88.29,
   "id": "c42"
  },
  {
   "text": "先看护照这一关",
   "start": 89.268,
   "end": 90.7,
   "id": "c43"
  },
  {
   "text": "Solana",
   "start": 90.768,
   "end": 91.557,
   "id": "c44"
  }
 ]
