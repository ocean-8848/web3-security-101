 "captions": [
  {
   "text": "2026 年 2 月 15 日",
   "start": 1.652,
   "end": 3.57,
   "id": "c0"
  },
  {
   "text": "Base 链上的借贷协议 Moonwell",
   "start": 3.779,
   "end": 6.155,
   "id": "c1"
  },
  {
   "text": "执行了一份治理提案",
   "start": 6.175,
   "end": 7.659,
   "id": "c2"
  },
  {
   "text": "提案生效后",
   "start": 7.93,
   "end": 9.739,
   "id": "c3"
  },
  {
   "text": "cbETH 的美元价格",
   "start": 9.939,
   "end": 12.668,
   "id": "c4"
  },
  {
   "text": "只用了 cbETH 对 ETH 的汇率",
   "start": 12.86,
   "end": 17.428,
   "id": "c5"
  },
  {
   "text": "它把一个汇率",
   "start": 17.67,
   "end": 18.993,
   "id": "c6"
  },
  {
   "text": "当成了美元价格",
   "start": 19.041,
   "end": 20.443,
   "id": "c7"
  },
  {
   "text": "一枚约 2200 美元的 cbETH",
   "start": 20.783,
   "end": 25.039,
   "id": "c8"
  },
  {
   "text": "在合约眼里",
   "start": 25.294,
   "end": 26.472,
   "id": "c9"
  },
  {
   "text": "只值约 1.12 美元",
   "start": 26.604,
   "end": 28.938,
   "id": "c10"
  },
  {
   "text": "清算机器人立刻动手",
   "start": 29.23,
   "end": 31.42,
   "id": "c11"
  },
  {
   "text": "清算了约 1096 枚 cbETH",
   "start": 31.625,
   "end": 34.691,
   "id": "c12"
  },
  {
   "text": "按 The Block 的报道",
   "start": 34.991,
   "end": 36.29,
   "id": "c13"
  },
  {
   "text": "协议留下约 178 万美元坏账",
   "start": 36.66,
   "end": 39.644,
   "id": "c14"
  },
  {
   "text": "先猜一道题",
   "start": 39.91,
   "end": 40.881,
   "id": "c15"
  },
  {
   "text": "这个价格大于 0",
   "start": 41.266,
   "end": 42.835,
   "id": "c16"
  },
  {
   "text": "而且刚刚更新过",
   "start": 42.864,
   "end": 44.516,
   "id": "c17"
  },
  {
   "text": "只检查正值和时效",
   "start": 44.75,
   "end": 46.709,
   "id": "c18"
  },
  {
   "text": "能拦住它吗",
   "start": 46.86,
   "end": 47.704,
   "id": "c19"
  },
  {
   "text": "不能",
   "start": 48.386,
   "end": 48.931,
   "id": "c20"
  },
  {
   "text": "两项检查",
   "start": 49.249,
   "end": 50.167,
   "id": "c21"
  },
  {
   "text": "都会通过",
   "start": 50.23,
   "end": 51.015,
   "id": "c22"
  },
  {
   "text": "价格是新的",
   "start": 51.31,
   "end": 52.711,
   "id": "c23"
  },
  {
   "text": "也是错的",
   "start": 52.932,
   "end": 53.704,
   "id": "c24"
  },
  {
   "text": "合约读到的价格",
   "start": 53.93,
   "end": 55.64,
   "id": "c25"
  },
  {
   "text": "可能被推高",
   "start": 55.802,
   "end": 56.941,
   "id": "c26"
  },
  {
   "text": "可能停住",
   "start": 57.142,
   "end": 58.166,
   "id": "c27"
  },
  {
   "text": "也可能配错",
   "start": 58.445,
   "end": 59.692,
   "id": "c28"
  },
  {
   "text": "问题是 错的时候",
   "start": 59.91,
   "end": 61.809,
   "id": "c29"
  },
  {
   "text": "哪一行代码来拦住它",
   "start": 61.974,
   "end": 63.611,
   "id": "c30"
  }
 ]
