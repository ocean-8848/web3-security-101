 "captions": [
  {
   "text": "换掉现货价",
   "start": 1.55,
   "end": 2.789,
   "id": "c0"
  },
  {
   "text": "有三类选择",
   "start": 2.887,
   "end": 3.893,
   "id": "c1"
  },
  {
   "text": "第一类 AMM 的时间加权平均价",
   "start": 4.17,
   "end": 8.254,
   "id": "c2"
  },
  {
   "text": "简称 TWAP",
   "start": 8.352,
   "end": 9.53,
   "id": "c3"
  },
  {
   "text": "它把一段时间里的价格",
   "start": 9.92,
   "end": 11.846,
   "id": "c4"
  },
  {
   "text": "按时间加权求平均",
   "start": 11.935,
   "end": 13.869,
   "id": "c5"
  },
  {
   "text": "一笔交易推高的价格",
   "start": 14.224,
   "end": 16.083,
   "id": "c6"
  },
  {
   "text": "在平均里只占一小段",
   "start": 16.119,
   "end": 18.049,
   "id": "c7"
  },
  {
   "text": "几乎不起作用",
   "start": 18.295,
   "end": 19.53,
   "id": "c8"
  },
  {
   "text": "代价是 窗口越长",
   "start": 19.881,
   "end": 22.049,
   "id": "c9"
  },
  {
   "text": "价格越滞后",
   "start": 22.069,
   "end": 23.258,
   "id": "c10"
  },
  {
   "text": "而低流动性的池子",
   "start": 23.622,
   "end": 25.129,
   "id": "c11"
  },
  {
   "text": "仍然可以被连续多个区块持续操纵",
   "start": 25.291,
   "end": 28.226,
   "id": "c12"
  },
  {
   "text": "在 PoS 下",
   "start": 28.566,
   "end": 29.689,
   "id": "c13"
  },
  {
   "text": "同一个提议者连续出块时",
   "start": 29.96,
   "end": 31.953,
   "id": "c14"
  },
  {
   "text": "这种操纵会更便宜",
   "start": 32.022,
   "end": 33.592,
   "id": "c15"
  },
  {
   "text": "2022 年 4 月的 Inverse Finance",
   "start": 33.995,
   "end": 36.675,
   "id": "c16"
  },
  {
   "text": "就是这样",
   "start": 36.695,
   "end": 37.356,
   "id": "c17"
  },
  {
   "text": "攻击者没有用闪电贷",
   "start": 37.63,
   "end": 39.357,
   "id": "c18"
  },
  {
   "text": "他投入自有资金",
   "start": 39.486,
   "end": 40.815,
   "id": "c19"
  },
  {
   "text": "持续推高浅池里的 INV 价格",
   "start": 40.941,
   "end": 43.628,
   "id": "c20"
  },
  {
   "text": "同时用垃圾交易抑制套利",
   "start": 43.85,
   "end": 46.473,
   "id": "c21"
  },
  {
   "text": "让 TWAP 输出虚高的价格",
   "start": 46.599,
   "end": 49.351,
   "id": "c22"
  },
  {
   "text": "按公开报道",
   "start": 49.689,
   "end": 50.724,
   "id": "c23"
  },
  {
   "text": "借走约 1560 万美元",
   "start": 50.964,
   "end": 53.665,
   "id": "c24"
  },
  {
   "text": "TWAP 挡得住一笔交易",
   "start": 53.89,
   "end": 55.754,
   "id": "c25"
  },
  {
   "text": "挡不住有资本的多区块操纵",
   "start": 55.867,
   "end": 58.222,
   "id": "c26"
  },
  {
   "text": "第二类 链下聚合预言机",
   "start": 58.604,
   "end": 61.163,
   "id": "c27"
  },
  {
   "text": "比如 Chainlink",
   "start": 61.357,
   "end": 62.452,
   "id": "c28"
  },
  {
   "text": "价格在链下聚合",
   "start": 62.73,
   "end": 64.478,
   "id": "c29"
  },
  {
   "text": "再写上链",
   "start": 64.565,
   "end": 65.413,
   "id": "c30"
  },
  {
   "text": "一笔交易改不动它",
   "start": 65.654,
   "end": 67.151,
   "id": "c31"
  },
  {
   "text": "它按心跳和偏离阈值更新",
   "start": 67.43,
   "end": 70.063,
   "id": "c32"
  },
  {
   "text": "心跳 是价格不变时",
   "start": 70.29,
   "end": 72.709,
   "id": "c33"
  },
  {
   "text": "也必须更新的最长间隔",
   "start": 72.822,
   "end": 74.991,
   "id": "c34"
  },
  {
   "text": "它的风险换了方向",
   "start": 75.23,
   "end": 76.891,
   "id": "c35"
  },
  {
   "text": "价格可能过时",
   "start": 77.407,
   "end": 79.047,
   "id": "c36"
  },
  {
   "text": "可能撞上上下限",
   "start": 79.126,
   "end": 80.647,
   "id": "c37"
  },
  {
   "text": "节点和喂价方也可能失效",
   "start": 80.998,
   "end": 83.405,
   "id": "c38"
  },
  {
   "text": "第三类 多源组合",
   "start": 83.61,
   "end": 85.487,
   "id": "c39"
  },
  {
   "text": "几个价格源互相比较",
   "start": 85.608,
   "end": 87.434,
   "id": "c40"
  },
  {
   "text": "偏离超过阈值就暂停",
   "start": 87.551,
   "end": 89.474,
   "id": "c41"
  },
  {
   "text": "它更稳 但实现复杂",
   "start": 89.842,
   "end": 91.869,
   "id": "c42"
  },
  {
   "text": "几个源意见不一时听谁的",
   "start": 91.979,
   "end": 94.443,
   "id": "c43"
  },
  {
   "text": "要提前想好",
   "start": 94.618,
   "end": 95.691,
   "id": "c44"
  },
  {
   "text": "顺带一句",
   "start": 95.97,
   "end": 96.797,
   "id": "c45"
  },
  {
   "text": "LP 代币也不能按储备乘现货价来定价",
   "start": 97.004,
   "end": 100.69,
   "id": "c46"
  },
  {
   "text": "要用外部预言机的价格和不变量",
   "start": 100.91,
   "end": 103.628,
   "id": "c47"
  },
  {
   "text": "反推出公平储备",
   "start": 103.768,
   "end": 105.172,
   "id": "c48"
  },
  {
   "text": "再算 LP 的价值",
   "start": 105.459,
   "end": 106.89,
   "id": "c49"
  },
  {
   "text": "没有完美的预言机",
   "start": 107.225,
   "end": 108.907,
   "id": "c50"
  },
  {
   "text": "工程上要回答两个问题",
   "start": 109.287,
   "end": 111.674,
   "id": "c51"
  },
  {
   "text": "价格错了 会怎样",
   "start": 111.97,
   "end": 113.943,
   "id": "c52"
  },
  {
   "text": "价格停了 会怎样",
   "start": 114.247,
   "end": 116.148,
   "id": "c53"
  }
 ]
}