 "captions": [
  {
   "text": "2022 年 8 月 1 日",
   "start": 1.55,
   "end": 3.465,
   "id": "c0"
  },
  {
   "text": "跨链桥 Nomad 被提走约 1.9 亿美元",
   "start": 3.683,
   "end": 7.25,
   "id": "c1"
  },
  {
   "text": "按事发时估值",
   "start": 7.44,
   "end": 8.747,
   "id": "c2"
  },
  {
   "text": "起因 是此前的一次升级",
   "start": 9.061,
   "end": 11.331,
   "id": "c3"
  },
  {
   "text": "这次升级调用了初始化函数",
   "start": 11.685,
   "end": 13.964,
   "id": "c4"
  },
  {
   "text": "把可信的消息根",
   "start": 14.337,
   "end": 15.65,
   "id": "c5"
  },
  {
   "text": "设成了全零",
   "start": 15.759,
   "end": 16.953,
   "id": "c6"
  },
  {
   "text": "桥合约收到一条消息",
   "start": 17.26,
   "end": 18.92,
   "id": "c7"
  },
  {
   "text": "先查它对应的根",
   "start": 19.112,
   "end": 20.545,
   "id": "c8"
  },
  {
   "text": "再看这个根是否可信",
   "start": 20.709,
   "end": 22.445,
   "id": "c9"
  },
  {
   "text": "先猜一道题",
   "start": 22.67,
   "end": 23.641,
   "id": "c10"
  },
  {
   "text": "一条从没被证明过的消息",
   "start": 23.93,
   "end": 26.352,
   "id": "c11"
  },
  {
   "text": "查到的根是什么",
   "start": 26.636,
   "end": 28.339,
   "id": "c12"
  },
  {
   "text": "它能通过吗",
   "start": 28.642,
   "end": 29.578,
   "id": "c13"
  },
  {
   "text": "它查到的是默认值 全零",
   "start": 30.203,
   "end": 33.056,
   "id": "c14"
  },
  {
   "text": "而全零 刚刚被这次升级",
   "start": 33.464,
   "end": 35.78,
   "id": "c15"
  },
  {
   "text": "标记成了可信",
   "start": 35.859,
   "end": 37.057,
   "id": "c16"
  },
  {
   "text": "所以 任何消息都被视为已经证明",
   "start": 37.35,
   "end": 40.715,
   "id": "c17"
  },
  {
   "text": "按 Immunefi 的复盘",
   "start": 40.93,
   "end": 42.274,
   "id": "c18"
  },
  {
   "text": "和 The Block 的报道",
   "start": 42.294,
   "end": 43.828,
   "id": "c19"
  },
  {
   "text": "第一笔提款成功后",
   "start": 44.047,
   "end": 45.511,
   "id": "c20"
  },
  {
   "text": "数百个地址复制了这笔交易",
   "start": 45.71,
   "end": 47.989,
   "id": "c21"
  },
  {
   "text": "只换掉收款地址",
   "start": 48.215,
   "end": 49.769,
   "id": "c22"
  },
  {
   "text": "升级的代码",
   "start": 50.03,
   "end": 51.705,
   "id": "c23"
  },
  {
   "text": "可以没有错",
   "start": 51.904,
   "end": 53.104,
   "id": "c24"
  },
  {
   "text": "错的 是升级时传进去的参数",
   "start": 53.46,
   "end": 56.124,
   "id": "c25"
  },
  {
   "text": "能升级的合约",
   "start": 56.49,
   "end": 57.748,
   "id": "c26"
  },
  {
   "text": "是怎么搭起来的",
   "start": 57.912,
   "end": 59.21,
   "id": "c27"
  },
  {
   "text": "谁能换掉它的代码",
   "start": 59.627,
   "end": 61.145,
   "id": "c28"
  }
 ]
}