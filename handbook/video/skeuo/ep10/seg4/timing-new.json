 ],
 "captions": [
  {
   "text": "普通合约用构造函数设置主人",
   "start": 1.648,
   "end": 4.377,
   "id": "c0"
  },
  {
   "text": "代理合约不行",
   "start": 4.752,
   "end": 5.887,
   "id": "c1"
  },
  {
   "text": "构造函数只在实现合约自己的存储里运行",
   "start": 6.884,
   "end": 10.446,
   "id": "c2"
  },
  {
   "text": "写不进代理",
   "start": 10.467,
   "end": 11.482,
   "id": "c3"
  },
  {
   "text": "所以可升级合约用一个初始化函数代替",
   "start": 12.48,
   "end": 15.995,
   "id": "c4"
  },
  {
   "text": "部署以后再调用一次",
   "start": 16.23,
   "end": 18.054,
   "id": "c5"
  },
  {
   "text": "这一次调用",
   "start": 19.036,
   "end": 20.063,
   "id": "c6"
  },
  {
   "text": "就是风险所在",
   "start": 20.083,
   "end": 21.301,
   "id": "c7"
  },
  {
   "text": "第一种情况",
   "start": 22.28,
   "end": 23.319,
   "id": "c8"
  },
  {
   "text": "部署代理和初始化",
   "start": 23.565,
   "end": 25.081,
   "id": "c9"
  },
  {
   "text": "分成了两笔交易",
   "start": 25.113,
   "end": 26.343,
   "id": "c10"
  },
  {
   "text": "中间有空隙",
   "start": 27.324,
   "end": 28.541,
   "id": "c11"
  },
  {
   "text": "别人可以抢先初始化",
   "start": 28.728,
   "end": 30.255,
   "id": "c12"
  },
  {
   "text": "成为主人",
   "start": 30.288,
   "end": 31.303,
   "id": "c13"
  },
  {
   "text": "修复是在同一笔交易里完成",
   "start": 31.678,
   "end": 33.872,
   "id": "c14"
  },
  {
   "text": "第二种 初始化函数可以重复调用",
   "start": 34.864,
   "end": 38.129,
   "id": "c15"
  },
  {
   "text": "任何人都能重置主人",
   "start": 38.28,
   "end": 40.081,
   "id": "c16"
  },
  {
   "text": "修复是加上只能调用一次的修饰器",
   "start": 40.456,
   "end": 42.995,
   "id": "c17"
  },
  {
   "text": "第三种 代理初始化了",
   "start": 43.988,
   "end": 46.063,
   "id": "c18"
  },
  {
   "text": "实现合约本身没有",
   "start": 46.083,
   "end": 47.729,
   "id": "c19"
  },
  {
   "text": "代理的初始化",
   "start": 48.72,
   "end": 49.937,
   "id": "c20"
  },
  {
   "text": "写在代理的存储里",
   "start": 49.97,
   "end": 51.425,
   "id": "c21"
  },
  {
   "text": "实现合约自己的存储",
   "start": 51.789,
   "end": 53.554,
   "id": "c22"
  },
  {
   "text": "还是空的",
   "start": 53.717,
   "end": 54.613,
   "id": "c23"
  },
  {
   "text": "先猜一道题",
   "start": 55.588,
   "end": 56.912,
   "id": "c24"
  },
  {
   "text": "别人能直接调用实现合约的初始化函数吗",
   "start": 57.276,
   "end": 60.696,
   "id": "c25"
  },
  {
   "text": "能",
   "start": 61.944,
   "end": 62.637,
   "id": "c26"
  },
  {
   "text": "他会成为实现合约的主人",
   "start": 62.989,
   "end": 64.98,
   "id": "c27"
  },
  {
   "text": "如果实现合约里有 delegatecall",
   "start": 65.98,
   "end": 68.305,
   "id": "c28"
  },
  {
   "text": "或者自毁的路径",
   "start": 68.325,
   "end": 69.59,
   "id": "c29"
  },
  {
   "text": "所有指向它的代理",
   "start": 69.718,
   "end": 70.995,
   "id": "c30"
  },
  {
   "text": "都可能失效",
   "start": 71.015,
   "end": 71.983,
   "id": "c31"
  },
  {
   "text": "2021 年 9 月",
   "start": 72.968,
   "end": 74.209,
   "id": "c32"
  },
  {
   "text": "OpenZeppelin 发布安全公告",
   "start": 74.301,
   "end": 76.304,
   "id": "c33"
  },
  {
   "text": "它的 UUPS 实现",
   "start": 76.432,
   "end": 77.9,
   "id": "c34"
  },
  {
   "text": "有几个版本存在这个问题",
   "start": 77.944,
   "end": 79.698,
   "id": "c35"
  },
  {
   "text": "随后发布了修复版本",
   "start": 79.718,
   "end": 81.233,
   "id": "c36"
  },
  {
   "text": "修复是在实现合约的构造函数里",
   "start": 82.212,
   "end": 84.775,
   "id": "c37"
  },
  {
   "text": "禁用初始化",
   "start": 84.795,
   "end": 85.87,
   "id": "c38"
  },
  {
   "text": "这样谁都不能再初始化它",
   "start": 86.245,
   "end": 88.582,
   "id": "c39"
  },
  {
   "text": "回到开头的 Nomad",
   "start": 89.56,
   "end": 91.313,
   "id": "c40"
  },
  {
   "text": "它的问题",
   "start": 91.688,
   "end": 92.609,
   "id": "c41"
  },
  {
   "text": "出在升级时的初始化参数",
   "start": 92.629,
   "end": 94.763,
   "id": "c42"
  },
  {
   "text": "合约用一张表",
   "start": 95.756,
   "end": 96.997,
   "id": "c43"
  },
  {
   "text": "记录每个根什么时候被确认",
   "start": 97.125,
   "end": 99.211,
   "id": "c44"
  },
  {
   "text": "升级把全零这个根",
   "start": 99.575,
   "end": 101.233,
   "id": "c45"
  },
  {
   "text": "标记成了已确认",
   "start": 101.277,
   "end": 102.542,
   "id": "c46"
  },
  {
   "text": "而没被证明过的消息",
   "start": 103.536,
   "end": 105.134,
   "id": "c47"
  },
  {
   "text": "查到的根",
   "start": 105.238,
   "end": 106.122,
   "id": "c48"
  },
  {
   "text": "默认也是全零",
   "start": 106.202,
   "end": 107.467,
   "id": "c49"
  },
  {
   "text": "默认值和合法值",
   "start": 108.436,
   "end": 109.915,
   "id": "c50"
  },
  {
   "text": "撞在了一起",
   "start": 109.936,
   "end": 110.891,
   "id": "c51"
  },
  {
   "text": "教训有三条",
   "start": 111.872,
   "end": 113.149,
   "id": "c52"
  },
  {
   "text": "初始化参数",
   "start": 113.512,
   "end": 114.683,
   "id": "c53"
  },
  {
   "text": "和代码一样需要审计",
   "start": 114.703,
   "end": 116.456,
   "id": "c54"
  },
  {
   "text": "零值不能带有业务含义",
   "start": 117.444,
   "end": 119.364,
   "id": "c55"
  },
  {
   "text": "默认值必须和合法值区分开",
   "start": 119.503,
   "end": 121.84,
   "id": "c56"
  },
  {
   "text": "升级以后要跑回归测试",
   "start": 122.824,
   "end": 125.089,
   "id": "c57"
  },
  {
   "text": "覆盖这一条",
   "start": 125.252,
   "end": 126.279,
   "id": "c58"
  },
  {
   "text": "未授权的消息必须被拒绝",
   "start": 126.419,
   "end": 128.672,
   "id": "c59"
  }
 ]
}