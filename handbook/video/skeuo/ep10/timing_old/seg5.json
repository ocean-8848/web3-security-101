 "captions": [
  {
   "text": "谁能换实现",
   "start": 1.55,
   "end": 2.719,
   "id": "c0"
  },
  {
   "text": "谁就拥有全部资金",
   "start": 2.739,
   "end": 4.486,
   "id": "c1"
  },
  {
   "text": "所以升级权限",
   "start": 4.824,
   "end": 6.316,
   "id": "c2"
  },
  {
   "text": "要按最高等级来保护",
   "start": 6.404,
   "end": 8.17,
   "id": "c3"
  },
  {
   "text": "透明代理的权限",
   "start": 8.39,
   "end": 9.865,
   "id": "c4"
  },
  {
   "text": "在代理的管理员槽位",
   "start": 9.965,
   "end": 11.734,
   "id": "c5"
  },
  {
   "text": "UUPS 在实现合约的授权函数里",
   "start": 11.944,
   "end": 14.964,
   "id": "c6"
  },
  {
   "text": "信标在信标的拥有者手里",
   "start": 15.184,
   "end": 17.547,
   "id": "c7"
  },
  {
   "text": "无论在哪",
   "start": 17.903,
   "end": 18.718,
   "id": "c8"
  },
  {
   "text": "都应该经过多签和时间锁",
   "start": 18.975,
   "end": 21.35,
   "id": "c9"
  },
  {
   "text": "时间锁让升级先排队 再公开",
   "start": 21.63,
   "end": 24.954,
   "id": "c10"
  },
  {
   "text": "给社区留出复核的时间",
   "start": 25.485,
   "end": 27.472,
   "id": "c11"
  },
  {
   "text": "但时间锁有另一面",
   "start": 27.866,
   "end": 29.544,
   "id": "c12"
  },
  {
   "text": "2021 年 9 月",
   "start": 29.937,
   "end": 31.288,
   "id": "c13"
  },
  {
   "text": "Compound 第 62 号提案升级了奖励逻辑",
   "start": 31.552,
   "end": 35.162,
   "id": "c14"
  },
  {
   "text": "里面有错误",
   "start": 35.417,
   "end": 36.686,
   "id": "c15"
  },
  {
   "text": "部分用户可以超额领取 COMP",
   "start": 36.876,
   "end": 38.887,
   "id": "c16"
  },
  {
   "text": "按 The Block 报道",
   "start": 39.187,
   "end": 40.405,
   "id": "c17"
  },
  {
   "text": "最坏情况约 28 万枚",
   "start": 40.6,
   "end": 42.909,
   "id": "c18"
  },
  {
   "text": "约 8000 万美元",
   "start": 43.179,
   "end": 44.514,
   "id": "c19"
  },
  {
   "text": "协议没有能停止分发的紧急开关",
   "start": 44.75,
   "end": 47.584,
   "id": "c20"
  },
  {
   "text": "任何修复",
   "start": 47.842,
   "end": 48.668,
   "id": "c21"
  },
  {
   "text": "都要走约 7 天的治理流程",
   "start": 48.777,
   "end": 50.896,
   "id": "c22"
  },
  {
   "text": "时间锁挡住了恶意升级",
   "start": 51.13,
   "end": 53.415,
   "id": "c23"
  },
  {
   "text": "也挡住了紧急修复",
   "start": 53.482,
   "end": 54.994,
   "id": "c24"
  },
  {
   "text": "所以暂停权和升级权要分开设计",
   "start": 55.366,
   "end": 59.081,
   "id": "c25"
  },
  {
   "text": "暂停可以快",
   "start": 59.297,
   "end": 60.623,
   "id": "c26"
  },
  {
   "text": "升级必须慢",
   "start": 60.858,
   "end": 62.549,
   "id": "c27"
  },
  {
   "text": "再往下一层",
   "start": 62.866,
   "end": 63.849,
   "id": "c28"
  },
  {
   "text": "链本身也可能被升级",
   "start": 64.07,
   "end": 66.005,
   "id": "c29"
  },
  {
   "text": "比如 Mantle",
   "start": 66.37,
   "end": 67.381,
   "id": "c30"
  },
  {
   "text": "按 L2BEAT 的页面",
   "start": 67.638,
   "end": 69.113,
   "id": "c31"
  },
  {
   "text": "一个 14 人里 6 人签名的多签",
   "start": 69.344,
   "end": 72.085,
   "id": "c32"
  },
  {
   "text": "无需延迟就能升级 L1 上的桥和门户合约",
   "start": 72.181,
   "end": 76.449,
   "id": "c33"
  },
  {
   "text": "部署在 L2 上的协议",
   "start": 76.824,
   "end": 78.424,
   "id": "c34"
  },
  {
   "text": "安全上限就是这条 L2 的升级权限",
   "start": 78.444,
   "end": 81.795,
   "id": "c35"
  },
  {
   "text": "合约写得再好",
   "start": 82.07,
   "end": 83.647,
   "id": "c36"
  },
  {
   "text": "资产也可能在 L1 那一端被转走",
   "start": 83.792,
   "end": 86.874,
   "id": "c37"
  },
  {
   "text": "一次安全的升级",
   "start": 87.09,
   "end": 88.546,
   "id": "c38"
  },
  {
   "text": "按这个顺序走",
   "start": 88.614,
   "end": 89.519,
   "id": "c39"
  },
  {
   "text": "写新实现",
   "start": 89.71,
   "end": 90.808,
   "id": "c40"
  },
  {
   "text": "只追加变量",
   "start": 90.93,
   "end": 92.027,
   "id": "c41"
  },
  {
   "text": "用工具比对存储布局",
   "start": 92.208,
   "end": 94.382,
   "id": "c42"
  },
  {
   "text": "在主网分叉环境里执行升级",
   "start": 94.65,
   "end": 97.002,
   "id": "c43"
  },
  {
   "text": "跑全部回归测试",
   "start": 97.058,
   "end": 98.359,
   "id": "c44"
  },
  {
   "text": "审计新实现",
   "start": 98.63,
   "end": 99.902,
   "id": "c45"
  },
  {
   "text": "也审计升级交易本身",
   "start": 100.051,
   "end": 102.065,
   "id": "c46"
  },
  {
   "text": "包括初始化参数",
   "start": 102.151,
   "end": 103.612,
   "id": "c47"
  },
  {
   "text": "通过时间锁排队",
   "start": 103.81,
   "end": 105.283,
   "id": "c48"
  },
  {
   "text": "公开升级内容",
   "start": 105.509,
   "end": 106.732,
   "id": "c49"
  },
  {
   "text": "执行以后",
   "start": 107.342,
   "end": 108.022,
   "id": "c50"
  },
  {
   "text": "立刻跑部署后验证",
   "start": 108.091,
   "end": 109.693,
   "id": "c51"
  },
  {
   "text": "最后 留好回滚方案",
   "start": 109.95,
   "end": 111.666,
   "id": "c52"
  },
  {
   "text": "新实现有问题时",
   "start": 111.841,
   "end": 113.268,
   "id": "c53"
  },
  {
   "text": "能不能升级回旧实现",
   "start": 113.414,
   "end": 115.142,
   "id": "c54"
  }
 ]
}