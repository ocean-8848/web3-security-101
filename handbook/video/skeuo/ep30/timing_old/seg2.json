 "captions": [
  {
   "text": "先给一句准确的说法",
   "start": 1.55,
   "end": 3.268,
   "id": "c0"
  },
  {
   "text": "许可链 只让获得授权的参与者",
   "start": 3.53,
   "end": 6.451,
   "id": "c1"
  },
  {
   "text": "读写或出块",
   "start": 6.591,
   "end": 7.923,
   "id": "c2"
  },
  {
   "text": "由多家组织共同治理的许可链",
   "start": 8.15,
   "end": 11.257,
   "id": "c3"
  },
  {
   "text": "叫联盟链",
   "start": 11.277,
   "end": 12.089,
   "id": "c4"
  },
  {
   "text": "它把谁能参与",
   "start": 12.37,
   "end": 13.868,
   "id": "c5"
  },
  {
   "text": "从密码学和经济的问题",
   "start": 13.888,
   "end": 15.919,
   "id": "c6"
  },
  {
   "text": "变成了身份和治理的问题",
   "start": 16.058,
   "end": 18.46,
   "id": "c7"
  },
  {
   "text": "攻击者不再需要多数算力",
   "start": 18.67,
   "end": 20.93,
   "id": "c8"
  },
  {
   "text": "一张有效证书",
   "start": 21.3,
   "end": 22.603,
   "id": "c9"
  },
  {
   "text": "一把管理员密钥",
   "start": 22.743,
   "end": 24.104,
   "id": "c10"
  },
  {
   "text": "或者几家成员共谋 就够了",
   "start": 24.374,
   "end": 26.814,
   "id": "c11"
  },
  {
   "text": "打个比方",
   "start": 27.126,
   "end": 27.819,
   "id": "c12"
  },
  {
   "text": "公链像公共广场",
   "start": 27.955,
   "end": 29.653,
   "id": "c13"
  },
  {
   "text": "谁都能进",
   "start": 29.789,
   "end": 30.631,
   "id": "c14"
  },
  {
   "text": "靠规则和押金维持秩序",
   "start": 30.865,
   "end": 33.117,
   "id": "c15"
  },
  {
   "text": "许可链像一栋写字楼",
   "start": 33.33,
   "end": 35.326,
   "id": "c16"
  },
  {
   "text": "进门要刷工牌",
   "start": 35.524,
   "end": 36.945,
   "id": "c17"
  },
  {
   "text": "陌生人大多进不来",
   "start": 37.244,
   "end": 38.852,
   "id": "c18"
  },
  {
   "text": "可发工牌的前台",
   "start": 39.024,
   "end": 40.794,
   "id": "c19"
  },
  {
   "text": "拿着万能钥匙的物业",
   "start": 40.986,
   "end": 42.666,
   "id": "c20"
  },
  {
   "text": "成了最值得攻击的人",
   "start": 42.851,
   "end": 44.566,
   "id": "c21"
  },
  {
   "text": "这个比方有一处不成立",
   "start": 44.903,
   "end": 46.689,
   "id": "c22"
  },
  {
   "text": "写字楼失窃",
   "start": 46.95,
   "end": 48.516,
   "id": "c23"
  },
  {
   "text": "可以调监控",
   "start": 48.633,
   "end": 49.646,
   "id": "c24"
  },
  {
   "text": "可以报警",
   "start": 49.761,
   "end": 50.598,
   "id": "c25"
  },
  {
   "text": "联盟链里",
   "start": 50.949,
   "end": 51.803,
   "id": "c26"
  },
  {
   "text": "多数成员可以合法地重写业务状态",
   "start": 51.923,
   "end": 55.013,
   "id": "c27"
  },
  {
   "text": "账本本身",
   "start": 55.328,
   "end": 56.34,
   "id": "c28"
  },
  {
   "text": "看不出这是作恶",
   "start": 56.391,
   "end": 57.635,
   "id": "c29"
  },
  {
   "text": "按攻击者控制的资源",
   "start": 57.93,
   "end": 59.487,
   "id": "c30"
  },
  {
   "text": "排一排入口",
   "start": 59.507,
   "end": 60.552,
   "id": "c31"
  },
  {
   "text": "一张普通成员证书",
   "start": 60.882,
   "end": 62.456,
   "id": "c32"
  },
  {
   "text": "能读通道数据",
   "start": 62.646,
   "end": 63.876,
   "id": "c33"
  },
  {
   "text": "发送畸形请求",
   "start": 64.055,
   "end": 65.404,
   "id": "c34"
  },
  {
   "text": "组织管理员的证书",
   "start": 65.743,
   "end": 67.064,
   "id": "c35"
  },
  {
   "text": "能改本组织的配置",
   "start": 67.324,
   "end": 68.863,
   "id": "c36"
  },
  {
   "text": "批准链码",
   "start": 68.983,
   "end": 69.855,
   "id": "c37"
  },
  {
   "text": "根 CA 的私钥",
   "start": 70.209,
   "end": 71.961,
   "id": "c38"
  },
  {
   "text": "能签发任意身份",
   "start": 72.074,
   "end": 73.525,
   "id": "c39"
  },
  {
   "text": "足够多的背书组织",
   "start": 73.77,
   "end": 75.578,
   "id": "c40"
  },
  {
   "text": "能写入符合策略的任意状态",
   "start": 75.903,
   "end": 78.623,
   "id": "c41"
  },
  {
   "text": "所以不要把成员都是持牌机构",
   "start": 78.961,
   "end": 81.632,
   "id": "c42"
  },
  {
   "text": "当成安全假设",
   "start": 81.679,
   "end": 83.036,
   "id": "c43"
  },
  {
   "text": "Ronin 桥有 9 个验证者",
   "start": 83.426,
   "end": 85.281,
   "id": "c44"
  },
  {
   "text": "5 个签名就能放行",
   "start": 85.407,
   "end": 86.949,
   "id": "c45"
  },
  {
   "text": "攻击者控制了验证者",
   "start": 87.204,
   "end": 88.887,
   "id": "c46"
  },
  {
   "text": "提走了资金",
   "start": 88.939,
   "end": 89.899,
   "id": "c47"
  },
  {
   "text": "许可的集合小",
   "start": 90.19,
   "end": 91.675,
   "id": "c48"
  },
  {
   "text": "攻破的门槛也低",
   "start": 91.92,
   "end": 93.373,
   "id": "c49"
  }
 ]
}