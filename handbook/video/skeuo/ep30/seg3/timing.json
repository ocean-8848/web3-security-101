 "captions": [
  {
   "text": "先看 Hyperledger Fabric",
   "start": 1.55,
   "end": 3.394,
   "id": "c0"
  },
  {
   "text": "它的一笔交易",
   "start": 3.702,
   "end": 4.802,
   "id": "c1"
  },
  {
   "text": "要过三道关 执行 排序 验证",
   "start": 4.9,
   "end": 8.305,
   "id": "c2"
  },
  {
   "text": "第一关 几家组织的背书节点",
   "start": 8.47,
   "end": 11.088,
   "id": "c3"
  },
  {
   "text": "模拟执行链码",
   "start": 11.288,
   "end": 12.503,
   "id": "c4"
  },
  {
   "text": "签下读写集",
   "start": 12.523,
   "end": 13.605,
   "id": "c5"
  },
  {
   "text": "第二关 排序服务只决定顺序",
   "start": 13.984,
   "end": 16.579,
   "id": "c6"
  },
  {
   "text": "不判断业务对不对",
   "start": 16.669,
   "end": 17.981,
   "id": "c7"
  },
  {
   "text": "第三关 记账节点不重新执行",
   "start": 18.362,
   "end": 21.045,
   "id": "c8"
  },
  {
   "text": "只核对背书策略和读集的版本",
   "start": 21.222,
   "end": 23.769,
   "id": "c9"
  },
  {
   "text": "被拒绝的交易仍然留在区块里",
   "start": 24.106,
   "end": 26.774,
   "id": "c10"
  },
  {
   "text": "只是标成无效",
   "start": 26.898,
   "end": 28.338,
   "id": "c11"
  },
  {
   "text": "背书策略规定",
   "start": 28.65,
   "end": 30.076,
   "id": "c12"
  },
  {
   "text": "一笔交易需要哪些组织签名",
   "start": 30.2,
   "end": 32.628,
   "id": "c13"
  },
  {
   "text": "默认要求通道成员的多数",
   "start": 33.025,
   "end": 35.233,
   "id": "c14"
  },
  {
   "text": "要是写成任一组织都行",
   "start": 35.47,
   "end": 37.736,
   "id": "c15"
  },
  {
   "text": "就等于让一家成员单独决定写入",
   "start": 37.929,
   "end": 40.892,
   "id": "c16"
  },
  {
   "text": "排序服务也要按威胁来选",
   "start": 41.13,
   "end": 43.548,
   "id": "c17"
  },
  {
   "text": "Raft 是崩溃容错",
   "start": 43.927,
   "end": 45.784,
   "id": "c18"
  },
  {
   "text": "5 个节点能容忍 2 个宕机",
   "start": 46.002,
   "end": 48.235,
   "id": "c19"
  },
  {
   "text": "却不防恶意节点",
   "start": 48.345,
   "end": 49.723,
   "id": "c20"
  },
  {
   "text": "一家运营方的排序节点被攻破",
   "start": 50.067,
   "end": 52.351,
   "id": "c21"
  },
  {
   "text": "它伪造不了背书",
   "start": 52.565,
   "end": 53.871,
   "id": "c22"
  },
  {
   "text": "却能决定顺序",
   "start": 54.052,
   "end": 55.286,
   "id": "c23"
  },
  {
   "text": "延迟或丢弃交易",
   "start": 55.491,
   "end": 57.057,
   "id": "c24"
  },
  {
   "text": "成员之间互不信任",
   "start": 57.408,
   "end": 58.928,
   "id": "c25"
  },
  {
   "text": "就选 BFT",
   "start": 58.948,
   "end": 59.923,
   "id": "c26"
  },
  {
   "text": "并把节点分给不同的运营方",
   "start": 60.297,
   "end": 62.641,
   "id": "c27"
  },
  {
   "text": "再看隐私",
   "start": 62.89,
   "end": 63.81,
   "id": "c28"
  },
  {
   "text": "私有数据集合",
   "start": 64.07,
   "end": 65.418,
   "id": "c29"
  },
  {
   "text": "只把原文发给部分组织",
   "start": 65.557,
   "end": 67.538,
   "id": "c30"
  },
  {
   "text": "账本上只留哈希",
   "start": 67.68,
   "end": 69.208,
   "id": "c31"
  },
  {
   "text": "假设集合里存着客户等级",
   "start": 69.49,
   "end": 72.611,
   "id": "c32"
  },
  {
   "text": "一共只有三档",
   "start": 72.726,
   "end": 74.013,
   "id": "c33"
  },
  {
   "text": "圈外的组织",
   "start": 74.27,
   "end": 75.572,
   "id": "c34"
  },
  {
   "text": "算出三个哈希一比",
   "start": 75.712,
   "end": 77.496,
   "id": "c35"
  },
  {
   "text": "就知道了",
   "start": 77.749,
   "end": 78.432,
   "id": "c36"
  },
  {
   "text": "所以低熵的数据要加随机盐",
   "start": 78.821,
   "end": 81.213,
   "id": "c37"
  },
  {
   "text": "输入走 transient 字段",
   "start": 81.359,
   "end": 83.029,
   "id": "c38"
  },
  {
   "text": "不放进普通参数",
   "start": 83.207,
   "end": 84.453,
   "id": "c39"
  },
  {
   "text": "链码本身也必须确定",
   "start": 84.71,
   "end": 86.663,
   "id": "c40"
  },
  {
   "text": "读本地时间或随机数",
   "start": 87.032,
   "end": 89.149,
   "id": "c41"
  },
  {
   "text": "各个节点算出的结果不同",
   "start": 89.412,
   "end": 91.443,
   "id": "c42"
  },
  {
   "text": "交易就过不了背书",
   "start": 91.58,
   "end": 93.17,
   "id": "c43"
  }
 ]
}