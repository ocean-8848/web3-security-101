 "captions": [
  {
   "text": "一个联盟链网络",
   "start": 1.55,
   "end": 3.157,
   "id": "c0"
  },
  {
   "text": "所有节点都由成员机构运营",
   "start": 3.425,
   "end": 5.968,
   "id": "c1"
  },
  {
   "text": "每个参与者",
   "start": 6.346,
   "end": 7.364,
   "id": "c2"
  },
  {
   "text": "都持有一张有效的证书",
   "start": 7.547,
   "end": 9.58,
   "id": "c3"
  },
  {
   "text": "没有匿名的陌生人",
   "start": 9.927,
   "end": 11.614,
   "id": "c4"
  },
  {
   "text": "也没有人能靠算力闯进来",
   "start": 11.909,
   "end": 14.433,
   "id": "c5"
  },
  {
   "text": "可就在这样的网络里",
   "start": 14.69,
   "end": 16.652,
   "id": "c6"
  },
  {
   "text": "账本分叉了",
   "start": 16.842,
   "end": 18.324,
   "id": "c7"
  },
  {
   "text": "Hyperledger Fabric",
   "start": 18.59,
   "end": 19.698,
   "id": "c8"
  },
  {
   "text": "公布过这样一个漏洞",
   "start": 19.718,
   "end": 21.311,
   "id": "c9"
  },
  {
   "text": "攻击者能把一个区块里的交易",
   "start": 21.626,
   "end": 23.966,
   "id": "c10"
  },
  {
   "text": "重新组合",
   "start": 23.986,
   "end": 24.882,
   "id": "c11"
  },
  {
   "text": "区块哈希没有变",
   "start": 25.11,
   "end": 26.701,
   "id": "c12"
  },
  {
   "text": "可是不同的节点",
   "start": 26.93,
   "end": 28.868,
   "id": "c13"
  },
  {
   "text": "从同一个区块里",
   "start": 28.888,
   "end": 30.237,
   "id": "c14"
  },
  {
   "text": "解析出了不同的交易",
   "start": 30.344,
   "end": 32.019,
   "id": "c15"
  },
  {
   "text": "收到不同版本的节点",
   "start": 32.27,
   "end": 34.154,
   "id": "c16"
  },
  {
   "text": "各自写入世界状态",
   "start": 34.286,
   "end": 35.85,
   "id": "c17"
  },
  {
   "text": "两份账本从此对不上",
   "start": 36.018,
   "end": 38.09,
   "id": "c18"
  },
  {
   "text": "修复的方向是",
   "start": 38.33,
   "end": 39.796,
   "id": "c19"
  },
  {
   "text": "让哈希的编码没有歧义",
   "start": 39.984,
   "end": 42.054,
   "id": "c20"
  },
  {
   "text": "同一串字节",
   "start": 42.258,
   "end": 43.272,
   "id": "c21"
  },
  {
   "text": "只能读出同一组交易",
   "start": 43.313,
   "end": 45.011,
   "id": "c22"
  },
  {
   "text": "这里没有人偷到私钥",
   "start": 45.362,
   "end": 47.637,
   "id": "c23"
  },
  {
   "text": "也没有人攻破共识",
   "start": 48.022,
   "end": 50.184,
   "id": "c24"
  },
  {
   "text": "门禁再严",
   "start": 50.545,
   "end": 51.634,
   "id": "c25"
  },
  {
   "text": "挡住的也只是外人",
   "start": 51.821,
   "end": 53.576,
   "id": "c26"
  },
  {
   "text": "那么 一个只让熟人进门的区块链",
   "start": 53.962,
   "end": 57.211,
   "id": "c27"
  },
  {
   "text": "风险到底在哪里",
   "start": 57.404,
   "end": 59.332,
   "id": "c28"
  },
  {
   "text": "谁能写 谁能看",
   "start": 59.89,
   "end": 62.435,
   "id": "c29"
  },
  {
   "text": "谁能改规则",
   "start": 62.673,
   "end": 64.016,
   "id": "c30"
  },
  {
   "text": "我们从一栋刷卡进门的写字楼说起",
   "start": 64.57,
   "end": 67.378,
   "id": "c31"
  }
 ]
}