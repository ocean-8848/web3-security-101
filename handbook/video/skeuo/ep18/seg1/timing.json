 "captions": [
  {
   "text": "2024 年 7 月",
   "start": 1.55,
   "end": 2.999,
   "id": "c0"
  },
  {
   "text": "交易所 WazirX 的多签冷钱包",
   "start": 3.204,
   "end": 5.963,
   "id": "c1"
  },
  {
   "text": "损失约 2.3 亿美元",
   "start": 5.983,
   "end": 8.134,
   "id": "c2"
  },
  {
   "text": "冷钱包放的是大部分资产",
   "start": 8.508,
   "end": 10.535,
   "id": "c3"
  },
  {
   "text": "多签就是为了不让一把钥匙说了算",
   "start": 10.814,
   "end": 13.64,
   "id": "c4"
  },
  {
   "text": "这个钱包有六把钥匙",
   "start": 14.005,
   "end": 15.628,
   "id": "c5"
  },
  {
   "text": "转账要其中四把签名",
   "start": 15.775,
   "end": 17.58,
   "id": "c6"
  },
  {
   "text": "公开材料没有说",
   "start": 17.81,
   "end": 19.129,
   "id": "c7"
  },
  {
   "text": "任何一把私钥被导出",
   "start": 19.149,
   "end": 20.736,
   "id": "c8"
  },
  {
   "text": "签名人按流程",
   "start": 21.08,
   "end": 22.563,
   "id": "c9"
  },
  {
   "text": "一个一个签了名",
   "start": 22.742,
   "end": 24.171,
   "id": "c10"
  },
  {
   "text": "攻击者没有偷走钥匙",
   "start": 24.41,
   "end": 26.444,
   "id": "c11"
  },
  {
   "text": "却让这些钥匙替他签了字",
   "start": 26.54,
   "end": 28.855,
   "id": "c12"
  },
  {
   "text": "钥匙都在 钱没了",
   "start": 29.11,
   "end": 31.31,
   "id": "c13"
  },
  {
   "text": "多数大额事故",
   "start": 31.668,
   "end": 32.915,
   "id": "c14"
  },
  {
   "text": "都不是私钥被数学破解",
   "start": 32.971,
   "end": 35.075,
   "id": "c15"
  },
  {
   "text": "先猜一道题",
   "start": 35.31,
   "end": 36.281,
   "id": "c16"
  },
  {
   "text": "六把私钥都存在硬件钱包里",
   "start": 36.57,
   "end": 39.133,
   "id": "c17"
  },
  {
   "text": "一把也没有泄露",
   "start": 39.279,
   "end": 40.42,
   "id": "c18"
  },
  {
   "text": "攻击者能转走多签里的资金吗",
   "start": 40.809,
   "end": 43.501,
   "id": "c19"
  },
  {
   "text": "先记住这个问题",
   "start": 44.09,
   "end": 45.251,
   "id": "c20"
  }
 ]
}