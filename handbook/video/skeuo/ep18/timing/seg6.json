 "captions": [
  {
   "text": "按角色 各做一件事",
   "start": 1.648,
   "end": 3.591,
   "id": "c0"
  },
  {
   "text": "项目方和交易所",
   "start": 4.58,
   "end": 5.964,
   "id": "c1"
  },
  {
   "text": "列出每个签名人的设备和云账户",
   "start": 6.008,
   "end": 8.321,
   "id": "c2"
  },
  {
   "text": "看有没有两个人共用",
   "start": 8.449,
   "end": 9.809,
   "id": "c3"
  },
  {
   "text": "钱包开发者",
   "start": 10.8,
   "end": 11.898,
   "id": "c4"
  },
  {
   "text": "确认日志和崩溃上报屏蔽密钥材料",
   "start": 11.978,
   "end": 15.089,
   "id": "c5"
  },
  {
   "text": "发布凭证开启多因素认证",
   "start": 15.169,
   "end": 17.41,
   "id": "c6"
  },
  {
   "text": "运维负责人",
   "start": 18.388,
   "end": 19.391,
   "id": "c7"
  },
  {
   "text": "人员离职或漏洞披露后",
   "start": 19.53,
   "end": 21.653,
   "id": "c8"
  },
  {
   "text": "轮换密钥",
   "start": 21.673,
   "end": 22.653,
   "id": "c9"
  },
  {
   "text": "并撤销链上权限",
   "start": 22.733,
   "end": 24.177,
   "id": "c10"
  },
  {
   "text": "备份要和主密钥分开放",
   "start": 25.136,
   "end": 27.234,
   "id": "c11"
  },
  {
   "text": "每年至少演练一次恢复",
   "start": 27.421,
   "end": 29.603,
   "id": "c12"
  },
  {
   "text": "恢复要多人参与",
   "start": 29.648,
   "end": 30.948,
   "id": "c13"
  },
  {
   "text": "普通用户",
   "start": 31.932,
   "end": 32.804,
   "id": "c14"
  },
  {
   "text": "大额放硬件钱包",
   "start": 33.003,
   "end": 34.435,
   "id": "c15"
  },
  {
   "text": "小额放另一个钱包",
   "start": 34.491,
   "end": 35.828,
   "id": "c16"
  },
  {
   "text": "两个钱包用不同的助记词",
   "start": 35.955,
   "end": 37.852,
   "id": "c17"
  },
  {
   "text": "助记词只写在纸或金属板上 不拍照",
   "start": 38.824,
   "end": 42.482,
   "id": "c18"
  },
  {
   "text": "不存云笔记",
   "start": 42.574,
   "end": 43.553,
   "id": "c19"
  },
  {
   "text": "任何客服 网站",
   "start": 44.54,
   "end": 46.424,
   "id": "c20"
  },
  {
   "text": "表单让你输入助记词",
   "start": 46.694,
   "end": 48.674,
   "id": "c21"
  },
  {
   "text": "都是诈骗",
   "start": 48.778,
   "end": 49.579,
   "id": "c22"
  },
  {
   "text": "硬件钱包屏幕只显示哈希",
   "start": 50.568,
   "end": 53.0,
   "id": "c23"
  },
  {
   "text": "或者无法解析 就不签",
   "start": 53.175,
   "end": 55.13,
   "id": "c24"
  },
  {
   "text": "回到开头的问题",
   "start": 56.092,
   "end": 57.476,
   "id": "c25"
  },
  {
   "text": "六把私钥都没泄露",
   "start": 58.472,
   "end": 59.939,
   "id": "c26"
  },
  {
   "text": "攻击者也能转走资金",
   "start": 60.15,
   "end": 61.701,
   "id": "c27"
  },
  {
   "text": "只要签名人看到的和实际签下的不一样",
   "start": 62.7,
   "end": 65.703,
   "id": "c28"
  },
  {
   "text": "每把钥匙都会照常签名",
   "start": 65.973,
   "end": 68.227,
   "id": "c29"
  },
  {
   "text": "能挡住它的",
   "start": 69.208,
   "end": 70.354,
   "id": "c30"
  },
  {
   "text": "是每个签名人在自己的设备上独立解码",
   "start": 70.386,
   "end": 73.651,
   "id": "c31"
  },
  {
   "text": "核对屏幕上的字段",
   "start": 73.803,
   "end": 75.27,
   "id": "c32"
  },
  {
   "text": "这只在签名人真正独立时成立",
   "start": 76.268,
   "end": 78.783,
   "id": "c33"
  },
  {
   "text": "钥匙放在哪里很重要",
   "start": 79.776,
   "end": 81.362,
   "id": "c34"
  },
  {
   "text": "签下的是什么",
   "start": 81.502,
   "end": 82.612,
   "id": "c35"
  },
  {
   "text": "同样重要",
   "start": 82.68,
   "end": 83.684,
   "id": "c36"
  },
  {
   "text": "下一集讲用户侧诈骗",
   "start": 84.676,
   "end": 86.655,
   "id": "c37"
  }
 ]
