 "captions": [
  {
   "text": "交易所每天都要给用户提币",
   "start": 1.648,
   "end": 3.579,
   "id": "c0"
  },
  {
   "text": "不能每一笔都等人工签名",
   "start": 3.826,
   "end": 5.889,
   "id": "c1"
  },
  {
   "text": "常见做法",
   "start": 6.884,
   "end": 7.971,
   "id": "c2"
  },
  {
   "text": "是分成热 温",
   "start": 7.991,
   "end": 9.851,
   "id": "c3"
  },
  {
   "text": "冷三层钱包",
   "start": 9.907,
   "end": 11.244,
   "id": "c4"
  },
  {
   "text": "冷钱包放大部分资产",
   "start": 12.24,
   "end": 13.981,
   "id": "c5"
  },
  {
   "text": "用多签或 MPC",
   "start": 14.061,
   "end": 15.779,
   "id": "c6"
  },
  {
   "text": "每个签名人用硬件钱包",
   "start": 15.835,
   "end": 17.814,
   "id": "c7"
  },
  {
   "text": "温钱包负责中转",
   "start": 18.796,
   "end": 20.216,
   "id": "c8"
  },
  {
   "text": "靠审批加时间窗口",
   "start": 20.272,
   "end": 22.12,
   "id": "c9"
  },
  {
   "text": "热钱包自动给用户提币",
   "start": 23.12,
   "end": 25.04,
   "id": "c10"
  },
  {
   "text": "用 HSM 或 MPC",
   "start": 25.06,
   "end": 27.373,
   "id": "c11"
  },
  {
   "text": "热钱包只放一小部分",
   "start": 28.356,
   "end": 30.073,
   "id": "c12"
  },
  {
   "text": "按每天的提币需求设水位",
   "start": 30.213,
   "end": 32.276,
   "id": "c13"
  },
  {
   "text": "热钱包失守",
   "start": 33.256,
   "end": 34.449,
   "id": "c14"
  },
  {
   "text": "损失有上限",
   "start": 34.47,
   "end": 35.818,
   "id": "c15"
  },
  {
   "text": "冷到温 温到热",
   "start": 36.812,
   "end": 38.541,
   "id": "c16"
  },
  {
   "text": "每一跳都要限额和审批",
   "start": 38.728,
   "end": 40.732,
   "id": "c17"
  },
  {
   "text": "再猜一道题",
   "start": 41.712,
   "end": 42.989,
   "id": "c18"
  },
  {
   "text": "HSM 的私钥不能导出",
   "start": 43.972,
   "end": 45.951,
   "id": "c19"
  },
  {
   "text": "攻击者控制了能给 HSM 发指令的服务器",
   "start": 46.952,
   "end": 50.419,
   "id": "c20"
  },
  {
   "text": "HSM 会拒绝吗",
   "start": 50.571,
   "end": 52.205,
   "id": "c21"
  },
  {
   "text": "不会",
   "start": 53.452,
   "end": 54.11,
   "id": "c22"
  },
  {
   "text": "HSM 只保证私钥不出设备",
   "start": 55.544,
   "end": 57.809,
   "id": "c23"
  },
  {
   "text": "它按收到的指令签名",
   "start": 57.865,
   "end": 59.523,
   "id": "c24"
  },
  {
   "text": "所以热钱包的安全",
   "start": 60.516,
   "end": 62.353,
   "id": "c25"
  },
  {
   "text": "在签名请求进入 HSM 之前",
   "start": 62.373,
   "end": 65.376,
   "id": "c26"
  },
  {
   "text": "那里要有一个独立的风控引擎",
   "start": 66.376,
   "end": 68.427,
   "id": "c27"
  },
  {
   "text": "检查白名单 限额",
   "start": 68.602,
   "end": 70.677,
   "id": "c28"
  },
  {
   "text": "速率和异常",
   "start": 70.697,
   "end": 71.891,
   "id": "c29"
  },
  {
   "text": "检查要按待签的原始字节判断",
   "start": 72.884,
   "end": 75.22,
   "id": "c30"
  },
  {
   "text": "不看界面怎么写",
   "start": 75.431,
   "end": 76.708,
   "id": "c31"
  },
  {
   "text": "一笔大额转出",
   "start": 77.688,
   "end": 78.977,
   "id": "c32"
  },
  {
   "text": "审批也要按顺序走",
   "start": 79.033,
   "end": 80.619,
   "id": "c33"
  },
  {
   "text": "发起人提交交易",
   "start": 81.604,
   "end": 83.059,
   "id": "c34"
  },
  {
   "text": "写明用途",
   "start": 83.139,
   "end": 84.262,
   "id": "c35"
  },
  {
   "text": "系统自动检查白名单 限额",
   "start": 85.256,
   "end": 88.009,
   "id": "c36"
  },
  {
   "text": "以及操作类型是不是 CALL",
   "start": 88.101,
   "end": 90.307,
   "id": "c37"
  },
  {
   "text": "签名人各自解码核对",
   "start": 91.284,
   "end": 93.001,
   "id": "c38"
  },
  {
   "text": "大额再用电话或当面确认",
   "start": 93.176,
   "end": 95.382,
   "id": "c39"
  },
  {
   "text": "执行之后",
   "start": 96.376,
   "end": 97.331,
   "id": "c40"
  },
  {
   "text": "监控系统把链上结果和审批记录比对",
   "start": 97.518,
   "end": 100.605,
   "id": "c41"
  }
 ]
