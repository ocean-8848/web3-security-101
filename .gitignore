# 本仓库只收录 Web3 安全手册和学习站；工作区里的其他目录不进仓库
/*
!/.gitignore
!/README.md
!/handbook/
!/learning-site/
!/practice-example-code/

# 系统与编辑器
.DS_Store
.claude/

# 依赖与构建缓存
node_modules/
**/practice-example-code/**/lib/
!**/practice-example-code/ops/lib/
**/practice-example-code/**/out/
**/practice-example-code/**/out-*/
**/practice-example-code/**/cache/
**/practice-example-code/**/broadcast/

# 视频成品与媒体（只保留脚本、幻灯片和工具源码）
handbook/video/output/
*.mp4
*.mov
*.webm
*.wav
*.mp3

# 构建产物（本仓库能重建：node handbook/tools/build.mjs、python3 learning-site/build.py security）
handbook/dist/
handbook/preview.html
learning-site/security/
