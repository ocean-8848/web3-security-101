# 本仓库只收录 Web3 安全手册和学习站；工作区里的其他目录不进仓库
/*
!/.gitignore
!/README.md
!/handbook/
!/learning-site/
!/code/
!/media/

# 系统与编辑器
.DS_Store
.claude/

# 依赖与构建缓存
node_modules/
**/code/**/lib/
!**/code/offchain-ops/lib/
**/code/**/out/
**/code/**/out-*/
**/code/**/cache/
**/code/**/broadcast/

# 视频成品与媒体（只保留脚本、幻灯片和工具源码）
media/video/output/
# 拟物化 / 3b1b 视频工程：成片、字体、配乐只放本地（主 checkout），不入库
media/video/skeuo/ep*/out
media/video/skeuo/**/fonts/
media/video/skeuo/**/*.woff2
media/video/skeuo/**/*.ttf
media/video/skeuo/**/*.mp3
media/video/skeuo/**/.hyperframes/
media/video/skeuo/**/renders/
media/video/skeuo/**/review/
media/video/3b1b/output
# hyperframes init 在每集生成的 CLAUDE.md / AGENTS.md 内容相同，只保留 media/video/ 下一份
media/video/*/**/CLAUDE.md
media/video/*/**/AGENTS.md
*.mp4
*.mov
*.webm
*.wav
*.mp3

# 构建产物（本仓库能重建：node handbook/tools/build.mjs、python3 learning-site/build.py）
handbook/dist/
handbook/preview.html
learning-site/security/

# Python 缓存
__pycache__/
